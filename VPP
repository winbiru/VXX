#!/usr/bin/env sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
build=${VPP_BUILD_DIR:-$root/build-pure-vpp}
if [ ! -x "$build/bin/vpp" ]; then
  echo 'VPP: hãy build bằng make build hoặc cmake -S . -B build-pure-vpp && cmake --build build-pure-vpp' >&2
  exit 1
fi
exec "$build/bin/vpp" "$@"
