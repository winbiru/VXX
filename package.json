{
  "name": "vpp-language",
  "displayName": "V++ Language",
  "description": "Syntax highlighting for V++",
  "version": "0.0.1",
  "publisher": "vpp",
  "license": "UNLICENSED",
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "vpp",
    "viet",
    "vietnamese",
    "syntax"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "vpp": {
    "manifest": "./vpp-language.json",
    "installer": "./scripts/vietvm-lang",
    "packageFormat": "vlang"
  },
  "contributes": {
    "languages": [
      {
        "id": "vpp",
        "aliases": ["V++", "vpp", "vietvm"],
        "extensions": [".vvm", ".vi"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "vpp",
        "scopeName": "source.vietvm",
        "path": "./syntaxes/vietvm.tmLanguage.json"
      }
    ]
  }
}
