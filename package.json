{
  "name": "vpp-language",
  "displayName": "V++ Language",
  "description": "IDE-grade Vietnamese-first language support for V++: diagnostics, completion, navigation, outline, references, signatures, rename and formatting",
  "version": "0.2.0",
  "publisher": "vpp",
  "main": "./extension.js",
  "icon": "assets/icons/vpp-file.png",
  "license": "UNLICENSED",
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "vpp",
    "viet",
    "vietnamese",
    "syntax",
    "highlighting",
    "intellisense",
    "lsp",
    "navigation"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:vpp",
    "onCommand:vpp.installVm",
    "onCommand:vpp.showVmInfo",
    "onCommand:vpp.openReleases",
    "onCommand:vpp.restartLanguageServer"
  ],
  "vpp": {
    "manifest": "./vpp-language.json",
    "installer": "./scripts/vpp-lang",
    "packageFormat": "vlang"
  },
  "contributes": {
    "commands": [
      {
        "command": "vpp.installVm",
        "title": "V++: Cài đặt/Cập nhật VM từ GitHub"
      },
      {
        "command": "vpp.showVmInfo",
        "title": "V++: Hiển thị thông tin VM"
      },
      {
        "command": "vpp.openReleases",
        "title": "V++: Mở GitHub Releases"
      },
      {
        "command": "vpp.restartLanguageServer",
        "title": "V++: Khởi động lại máy chủ ngôn ngữ"
      }
    ],
    "configuration": {
      "title": "V++",
      "properties": {
        "vpp.vm.autoPromptInstall": {
          "type": "boolean",
          "default": true,
          "description": "Đề nghị cài V++ VM từ GitHub Releases khi extension chưa quản lý VM nào."
        },
        "vpp.lsp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Bật máy chủ ngôn ngữ V++ cho diagnostic, completion, go-to-definition, hover, rename và format."
        },
        "vpp.lsp.executable": {
          "type": "string",
          "default": "",
          "description": "Đường dẫn tùy chọn tới executable V++ dùng cho LSP. Để trống để ưu tiên VM do extension quản lý rồi tới lệnh vpp trong PATH."
        }
      }
    },
    "languages": [
      {
        "id": "vpp",
        "aliases": ["V++", "vpp", "vietvm"],
        "extensions": [".vvm", ".vi"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./assets/icons/vpp-file.png",
          "dark": "./assets/icons/vpp-file.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "vpp",
        "scopeName": "source.vietvm",
        "path": "./syntaxes/vpp.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": [
              "comment.line.double-slash.vietvm",
              "comment.block.vietvm",
              "comment.block.documentation.vietvm"
            ],
            "settings": {
              "foreground": "#808080",
              "fontStyle": "italic"
            }
          },
          {
            "scope": [
              "keyword.control.vietvm",
              "keyword.control.import.vietvm",
              "storage.type.class.vietvm",
              "storage.type.interface.vietvm",
              "storage.type.function.vietvm",
              "storage.type.variable.vietvm",
              "storage.modifier.access.vietvm",
              "keyword.other.inheritance.vietvm",
              "constant.language.boolean.vietvm",
              "constant.language.null.vietvm"
            ],
            "settings": {
              "foreground": "#CC7832"
            }
          },
          {
            "scope": [
              "entity.name.function.vietvm",
              "entity.name.function.member.vietvm",
              "support.function.builtin.output.vietvm",
              "support.function.builtin.collection.vietvm",
              "support.function.builtin.string.vietvm",
              "support.function.builtin.network.vietvm"
            ],
            "settings": {
              "foreground": "#FFC66D"
            }
          },
          {
            "scope": [
              "string.quoted.double.vietvm",
              "string.quoted.single.vietvm",
              "string.unquoted.import-path.vietvm"
            ],
            "settings": {
              "foreground": "#6A8759"
            }
          },
          {
            "scope": "constant.numeric.vietvm",
            "settings": {
              "foreground": "#6897BB"
            }
          },
          {
            "scope": [
              "entity.name.type.class.vietvm",
              "entity.name.type.vietvm"
            ],
            "settings": {
              "foreground": "#A9B7C6"
            }
          },
          {
            "scope": "variable.parameter.vietvm",
            "settings": {
              "foreground": "#9876AA"
            }
          },
          {
            "scope": [
              "variable.other.vietvm",
              "variable.other.object.vietvm",
              "variable.other.property.vietvm",
              "variable.language.receiver.vietvm",
              "keyword.operator.vietvm"
            ],
            "settings": {
              "foreground": "#A9B7C6"
            }
          },
          {
            "scope": "constant.character.escape.vietvm",
            "settings": {
              "foreground": "#CC7832",
              "fontStyle": "bold"
            }
          },
          {
            "scope": "invalid.illegal.escape.vietvm",
            "settings": {
              "foreground": "#BC3F3C"
            }
          }
        ]
      }
    }
  }
}
