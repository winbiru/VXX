nhập gói/thời gian/giao diện đo;
nhập gói/thời gian/đơn điệu;

lớp công khai Bộ Bấm Giờ triển khai Đo Thời Gian {
    hàm công khai khởi tạo() {
        mình.đang chạy = sai;
        mình.đã đo = 0.0;
        mình.mốc = 0.0;
    };

    hàm công khai bắt đầu() {
        nếu (mình.đang chạy) { trả về sai; };
        mình.mốc = thời gian đơn điệu mili giây();
        mình.đang chạy = đúng;
        trả về đúng;
    };

    hàm công khai dừng() {
        nếu (!mình.đang chạy) { trả về sai; };
        mình.đã đo = mình.đã đo + thời gian đơn điệu mili giây() - mình.mốc;
        mình.đang chạy = sai;
        trả về đúng;
    };

    hàm công khai đọc mili giây() {
        nếu (mình.đang chạy) {
            trả về mình.đã đo + thời gian đơn điệu mili giây() - mình.mốc;
        };
        trả về mình.đã đo;
    };

    hàm công khai đang chạy() { trả về mình.đang chạy; };

    hàm công khai đặt lại() {
        mình.đã đo = 0.0;
        nếu (mình.đang chạy) { mình.mốc = thời gian đơn điệu mili giây(); };
        trả về đúng;
    };
};
