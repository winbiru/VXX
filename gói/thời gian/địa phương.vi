// Đọc lịch địa phương qua machine ABI; V++ giải mã và định dạng.
nhập gói/thời gian/giờ quốc tế;
nhập gói/lõi/chuyển kiểu;

// Lớp sở hữu toàn bộ thuật toán của mô-đun; các hàm bên dưới chỉ giữ API cũ.
lớp công khai Đồng Hồ Địa Phương {
    hàm công khai khởi tạo() {};

    // int32 có dấu từ bốn byte little-endian, kể cả tm_year âm.
    hàm riêng tư thời gian địa phương đọc i32(đệm, đầu) {
        số = 0.0;
        bội = 1.0;
        lặp(i = 0; i < 4; i++) {
            số = số + đệm[đầu + i] * bội;
            bội = bội * 256.0;
        };
        nếu (số >= 2147483648.0) { số = số - 4294967296.0; };
        trả về thành số nguyên(số);
    };

    // Gregorian proleptic: số ngày từ 1970-01-01. Dùng để tính offset Windows
    // từ snapshot local và UTC của đúng cùng một epoch, kể cả tại biên DST.
    hàm riêng tư thời gian địa phương ngày từ lịch(năm, tháng, ngày) {
        nếu (tháng <= 2) { năm = năm - 1; };
        kỷ = thời gian giờ quốc tế chia sàn(năm, 400);
        năm kỷ = năm - kỷ * 400;
        tháng lịch = tháng - 3;
        nếu (tháng <= 2) { tháng lịch = tháng + 9; };
        ngày năm = thời gian giờ quốc tế chia sàn(153 * tháng lịch + 2, 5) + ngày - 1;
        ngày kỷ = năm kỷ * 365 + thời gian giờ quốc tế chia sàn(năm kỷ, 4) -
            thời gian giờ quốc tế chia sàn(năm kỷ, 100) + ngày năm;
        trả về kỷ * 146097 + ngày kỷ - 719468;
    };

    // Nhận time_t 8 byte từ clock_gettime; hàm này cũng cho phép test mốc DST
    // mà không thay đổi đồng hồ hệ thống.
    hàm công khai thời gian địa phương từ mốc thời gian byte ffi(giây byte) {
        kết quả = máy đồng hồ địa phương(giây byte);
        giây = mình.thời gian địa phương đọc i32(kết quả, 0);
        phút = mình.thời gian địa phương đọc i32(kết quả, 4);
        giờ = mình.thời gian địa phương đọc i32(kết quả, 8);
        ngày = mình.thời gian địa phương đọc i32(kết quả, 12);
        tháng = mình.thời gian địa phương đọc i32(kết quả, 16) + 1;
        năm = mình.thời gian địa phương đọc i32(kết quả, 20) + 1900;
        lệch giây = 0.0;
        nếu (ten nền tảng máy ảo() == "windows") {
            // CRT không có tm_gmtoff. Lấy epoch của lịch local giả định là UTC,
            // rồi trừ epoch ban đầu; không đo offset bằng hai lần đọc clock.
            giây mốc thời gian = thời gian giờ quốc tế đọc i64(giây byte, 0);
            lệch giây = mình.thời gian địa phương ngày từ lịch(năm, tháng, ngày) * 86400.0 +
                giờ * 3600 + phút * 60 + giây - giây mốc thời gian;
        } hoặc {
            lệch giây = thời gian giờ quốc tế đọc i64(kết quả, 40);
        };
        nếu (năm < 0 || năm > 9999 || tháng < 1 || tháng > 12 ||
            ngày < 1 || ngày > 31 || giờ < 0 || giờ > 23 ||
            phút < 0 || phút > 59 || giây < 0 || giây > 60 ||
            lệch giây < -86400 || lệch giây > 86400) {
            ném "giờ địa phương: struct tm không hợp lệ";
        };
        // Giữ contract hiện hành: phút offset làm tròn về 0, kể cả offset âm.
        lệch phút = thành số nguyên(lệch giây / 60.0);
        trả về [năm, tháng, ngày, giờ, phút, giây, lệch phút];
    };

    hàm công khai thời gian đọc địa phương posix() {
        trả về mình.thời gian địa phương từ mốc thời gian byte ffi(thời gian giờ quốc tế đọc mốc thời gian byte ffi());
    };

    // Alias cho fixture lịch sử; cùng một implementation thực thi trên POSIX.
    hàm công khai thời gian địa phương từ mốc thời gian byte posix(giây byte) {
        trả về mình.thời gian địa phương từ mốc thời gian byte ffi(giây byte);
    };
};


hàm công khai thời gian địa phương từ mốc thời gian byte ffi(giây byte) {
    bộ chuyển tiếp = Đồng Hồ Địa Phương();
    trả về bộ chuyển tiếp.thời gian địa phương từ mốc thời gian byte ffi(giây byte);
};

hàm công khai thời gian đọc địa phương posix() {
    bộ chuyển tiếp = Đồng Hồ Địa Phương();
    trả về bộ chuyển tiếp.thời gian đọc địa phương posix();
};

hàm công khai thời gian địa phương từ mốc thời gian byte posix(giây byte) {
    bộ chuyển tiếp = Đồng Hồ Địa Phương();
    trả về bộ chuyển tiếp.thời gian địa phương từ mốc thời gian byte posix(giây byte);
};
