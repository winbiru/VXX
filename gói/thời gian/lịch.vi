// vi.time — giá trị lịch ISO/Gregorian thuần V++.
// Wall clock, epoch/tzdb và monotonic clock vẫn là primitive/runtime boundary.

nhập gói/văn bản/chuỗi;
nhập gói/bộ sưu tập/từ điển;

// Lớp sở hữu toàn bộ thuật toán của mô-đun; các hàm bên dưới chỉ giữ API cũ.
lớp công khai Lịch {
    hàm công khai khởi tạo() {};

    hàm công khai thời gian là năm nhuận(năm) {
        nếu (loại của(năm) != "số nguyên") {
            ném "TIME_RANGE";
        };
        nếu (năm % 400 == 0) {
            trả về đúng;
        };
        nếu (năm % 100 == 0) {
            trả về sai;
        };
        trả về năm % 4 == 0;
    };

    hàm công khai thời gian số ngày trong tháng(năm, tháng) {
        nếu (loại của(năm) != "số nguyên" || loại của(tháng) != "số nguyên") {
            ném "TIME_RANGE";
        };
        nếu (năm < 0 || năm > 9999 || tháng < 1 || tháng > 12) {
            ném "TIME_RANGE";
        };
        nếu (tháng == 2) {
            nếu (mình.thời gian là năm nhuận(năm)) {
                trả về 29;
            };
            trả về 28;
        };
        nếu (tháng == 4 || tháng == 6 || tháng == 9 || tháng == 11) {
            trả về 30;
        };
        trả về 31;
    };

    hàm công khai tạo ngày(năm, tháng, ngày) {
        nếu (loại của(năm) != "số nguyên") { ném "TIME_RANGE"; };
        nếu (loại của(tháng) != "số nguyên") { ném "TIME_RANGE"; };
        nếu (loại của(ngày) != "số nguyên") { ném "TIME_RANGE"; };
        nếu (năm < 0 || năm > 9999 || tháng < 1 || tháng > 12) {
            ném "TIME_RANGE";
        };
        tối_đa = mình.thời gian số ngày trong tháng(năm, tháng);
        nếu (ngày < 1 || ngày > tối_đa) {
            ném "TIME_RANGE";
        };
        trả về {
            "__vpp_date__": 1,
            "năm": năm,
            "tháng": tháng,
            "ngày": ngày
        };
    };

    hàm công khai tạo giờ(giờ, phút, giây = 0, nano = 0) {
        nếu (loại của(giờ) != "số nguyên") { ném "TIME_RANGE"; };
        nếu (loại của(phút) != "số nguyên") { ném "TIME_RANGE"; };
        nếu (loại của(giây) != "số nguyên") { ném "TIME_RANGE"; };
        nếu (loại của(nano) != "số nguyên") { ném "TIME_RANGE"; };
        nếu (giờ < 0 || giờ > 23 || phút < 0 || phút > 59 ||
            giây < 0 || giây > 59 || nano < 0 || nano > 999999999) {
            ném "TIME_RANGE";
        };
        trả về {
            "__vpp_time__": 1,
            "giờ": giờ,
            "phút": phút,
            "giây": giây,
            "nano": nano
        };
    };

    hàm riêng tư thời gian yêu cầu ngày(giá_trị) {
        nếu (loại của(giá_trị) != "từ điển") {
            ném "TIME_RANGE";
        };
        nếu (lấy map(giá_trị, "__vpp_date__", 0) != 1) {
            ném "TIME_RANGE";
        };
        trả về giá_trị;
    };

    hàm riêng tư thời gian yêu cầu giờ(giá_trị) {
        nếu (loại của(giá_trị) != "từ điển") {
            ném "TIME_RANGE";
        };
        nếu (lấy map(giá_trị, "__vpp_time__", 0) != 1) {
            ném "TIME_RANGE";
        };
        trả về giá_trị;
    };

    hàm công khai tạo ngày giờ(ngày, giờ) {
        mình.thời gian yêu cầu ngày(ngày);
        mình.thời gian yêu cầu giờ(giờ);
        trả về {
            "__vpp_datetime__": 1,
            "ngày": ngày,
            "giờ": giờ
        };
    };

    hàm riêng tư thời gian yêu cầu ngày giờ(giá_trị) {
        nếu (loại của(giá_trị) != "từ điển") {
            ném "TIME_RANGE";
        };
        nếu (lấy map(giá_trị, "__vpp_datetime__", 0) != 1) {
            ném "TIME_RANGE";
        };
        mình.thời gian yêu cầu ngày(lấy map(giá_trị, "ngày", rỗng));
        mình.thời gian yêu cầu giờ(lấy map(giá_trị, "giờ", rỗng));
        trả về giá_trị;
    };

    hàm riêng tư thời gian là chữ số(c) {
        trả về c >= "0" && c <= "9";
    };

    hàm riêng tư thời gian đọc số cố định(văn_bản, bắt_đầu, số_lượng) {
        giá_trị = 0;
        lặp(i = 0; i < số_lượng; i++) {
            c = văn_bản[bắt_đầu + i];
            nếu (!mình.thời gian là chữ số(c)) {
                ném "TIME_PARSE";
            };
            giá_trị = giá_trị * 10 + thành số nguyên(c);
        };
        trả về giá_trị;
    };

    hàm công khai parse ngày(văn_bản) {
        nếu (loại của(văn_bản) != "chuỗi") {
            ném "TIME_PARSE";
        };
        nếu (do_dai(văn_bản) != 10) {
            ném "TIME_PARSE";
        };
        nếu (văn_bản[4] != "-" || văn_bản[7] != "-") {
            ném "TIME_PARSE";
        };
        năm = mình.thời gian đọc số cố định(văn_bản, 0, 4);
        tháng = mình.thời gian đọc số cố định(văn_bản, 5, 2);
        ngày = mình.thời gian đọc số cố định(văn_bản, 8, 2);
        trả về mình.tạo ngày(năm, tháng, ngày);
    };

    hàm công khai parse ngày giờ(văn_bản) {
        nếu (loại của(văn_bản) != "chuỗi") {
            ném "TIME_PARSE";
        };
        n = do_dai(văn_bản);
        nếu (n < 19 || n > 29) {
            ném "TIME_PARSE";
        };
        nếu (văn_bản[4] != "-" || văn_bản[7] != "-" || văn_bản[10] != "T" ||
            văn_bản[13] != ":" || văn_bản[16] != ":") {
            ném "TIME_PARSE";
        };

        ngày = mình.parse ngày(cắt chuỗi(văn_bản, 0, 10));
        giờ_số = mình.thời gian đọc số cố định(văn_bản, 11, 2);
        phút = mình.thời gian đọc số cố định(văn_bản, 14, 2);
        giây = mình.thời gian đọc số cố định(văn_bản, 17, 2);
        nano = 0;

        nếu (n > 19) {
            nếu (văn_bản[19] != ".") {
                ném "TIME_PARSE";
            };
            chữ_số = n - 20;
            nếu (chữ_số < 1 || chữ_số > 9) {
                ném "TIME_PARSE";
            };
            nano = mình.thời gian đọc số cố định(văn_bản, 20, chữ_số);
            lặp(i = chữ_số; i < 9; i++) {
                nano = nano * 10;
            };
        };

        giờ = mình.tạo giờ(giờ_số, phút, giây, nano);
        trả về mình.tạo ngày giờ(ngày, giờ);
    };

    hàm công khai thời gian đệm số(giá_trị, rộng) {
        văn_bản = thành chuỗi(giá_trị);
        kết_quả = "";
        lặp(i = do_dai(văn_bản); i < rộng; i++) {
            kết_quả = kết_quả + "0";
        };
        trả về kết_quả + văn_bản;
    };

    hàm công khai định dạng ngày(ngày) {
        mình.thời gian yêu cầu ngày(ngày);
        trả về mình.thời gian đệm số(lấy map(ngày, "năm", 0), 4) + "-" +
            mình.thời gian đệm số(lấy map(ngày, "tháng", 0), 2) + "-" +
            mình.thời gian đệm số(lấy map(ngày, "ngày", 0), 2);
    };

    hàm công khai định dạng giờ(giờ) {
        mình.thời gian yêu cầu giờ(giờ);
        kết_quả = mình.thời gian đệm số(lấy map(giờ, "giờ", 0), 2) + ":" +
            mình.thời gian đệm số(lấy map(giờ, "phút", 0), 2) + ":" +
            mình.thời gian đệm số(lấy map(giờ, "giây", 0), 2);
        nano = lấy map(giờ, "nano", 0);
        nếu (nano == 0) {
            trả về kết_quả;
        };

        phần = mình.thời gian đệm số(nano, 9);
        cuối = do_dai(phần);
        đang_bỏ = đúng;
        lặp(vòng = 0; cuối > 1 && đang_bỏ; vòng++) {
            nếu (phần[cuối - 1] == "0") {
                cuối = cuối - 1;
            } hoặc {
                đang_bỏ = sai;
            };
        };
        trả về kết_quả + "." + cắt chuỗi(phần, 0, cuối);
    };

    hàm công khai định dạng ngày giờ(ngày_giờ) {
        mình.thời gian yêu cầu ngày giờ(ngày_giờ);
        trả về mình.định dạng ngày(lấy map(ngày_giờ, "ngày", rỗng)) + "T" +
            mình.định dạng giờ(lấy map(ngày_giờ, "giờ", rỗng));
    };
};


hàm công khai thời gian là năm nhuận(năm) {
    __vpp_adapter = Lịch();
    trả về __vpp_adapter.thời gian là năm nhuận(năm);
};

hàm công khai thời gian số ngày trong tháng(năm, tháng) {
    __vpp_adapter = Lịch();
    trả về __vpp_adapter.thời gian số ngày trong tháng(năm, tháng);
};

hàm công khai tạo ngày(năm, tháng, ngày) {
    __vpp_adapter = Lịch();
    trả về __vpp_adapter.tạo ngày(năm, tháng, ngày);
};

hàm công khai tạo giờ(giờ, phút, giây = 0, nano = 0) {
    __vpp_adapter = Lịch();
    trả về __vpp_adapter.tạo giờ(giờ, phút, giây, nano);
};

hàm công khai tạo ngày giờ(ngày, giờ) {
    __vpp_adapter = Lịch();
    trả về __vpp_adapter.tạo ngày giờ(ngày, giờ);
};

hàm công khai parse ngày(văn_bản) {
    __vpp_adapter = Lịch();
    trả về __vpp_adapter.parse ngày(văn_bản);
};

hàm công khai parse ngày giờ(văn_bản) {
    __vpp_adapter = Lịch();
    trả về __vpp_adapter.parse ngày giờ(văn_bản);
};

hàm công khai thời gian đệm số(giá_trị, rộng) {
    __vpp_adapter = Lịch();
    trả về __vpp_adapter.thời gian đệm số(giá_trị, rộng);
};

hàm công khai định dạng ngày(ngày) {
    __vpp_adapter = Lịch();
    trả về __vpp_adapter.định dạng ngày(ngày);
};

hàm công khai định dạng giờ(giờ) {
    __vpp_adapter = Lịch();
    trả về __vpp_adapter.định dạng giờ(giờ);
};

hàm công khai định dạng ngày giờ(ngày_giờ) {
    __vpp_adapter = Lịch();
    trả về __vpp_adapter.định dạng ngày giờ(ngày_giờ);
};
nhập gói/lõi/chuyển kiểu;
