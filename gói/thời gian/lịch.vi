// vi.time — giá trị lịch ISO/Gregorian thuần V++.
// Wall clock, epoch/tzdb và monotonic clock vẫn là primitive/runtime boundary.

nhập gói.văn bản.chuỗi.độ dài;
nhập gói.văn bản.chuỗi.cắt chuỗi;
nhập gói.bộ sưu tập.từ điển.lấy từ điển;
nhập gói.lõi.chuyển kiểu.thành chuỗi;
nhập gói.lõi.chuyển kiểu.thành số nguyên;

// Lớp sở hữu toàn bộ thuật toán của mô-đun; các hàm bên dưới chỉ giữ API cũ.
lớp công khai Lịch {
    hàm công khai khởi tạo() {};

    hàm công khai thời gian là năm nhuận(năm) {
        nếu (loại của(năm) != "số nguyên") {
            ném "TIME_RANGE";
        };
        nếu (năm % 400 == 0) {
            trả về đúng;
        };
        nếu (năm % 100 == 0) {
            trả về sai;
        };
        trả về năm % 4 == 0;
    };

    hàm công khai thời gian số ngày trong tháng(năm, tháng) {
        nếu (loại của(năm) != "số nguyên" || loại của(tháng) != "số nguyên") {
            ném "TIME_RANGE";
        };
        nếu (năm < 0 || năm > 9999 || tháng < 1 || tháng > 12) {
            ném "TIME_RANGE";
        };
        nếu (tháng == 2) {
            nếu (mình.thời gian là năm nhuận(năm)) {
                trả về 29;
            };
            trả về 28;
        };
        nếu (tháng == 4 || tháng == 6 || tháng == 9 || tháng == 11) {
            trả về 30;
        };
        trả về 31;
    };

    hàm công khai tạo ngày(năm, tháng, ngày) {
        nếu (loại của(năm) != "số nguyên") { ném "TIME_RANGE"; };
        nếu (loại của(tháng) != "số nguyên") { ném "TIME_RANGE"; };
        nếu (loại của(ngày) != "số nguyên") { ném "TIME_RANGE"; };
        nếu (năm < 0 || năm > 9999 || tháng < 1 || tháng > 12) {
            ném "TIME_RANGE";
        };
        tối đa = mình.thời gian số ngày trong tháng(năm, tháng);
        nếu (ngày < 1 || ngày > tối đa) {
            ném "TIME_RANGE";
        };
        trả về {
            "__vpp_date__": 1,
            "năm": năm,
            "tháng": tháng,
            "ngày": ngày
        };
    };

    hàm công khai tạo giờ(giờ, phút, giây = 0, nano = 0) {
        nếu (loại của(giờ) != "số nguyên") { ném "TIME_RANGE"; };
        nếu (loại của(phút) != "số nguyên") { ném "TIME_RANGE"; };
        nếu (loại của(giây) != "số nguyên") { ném "TIME_RANGE"; };
        nếu (loại của(nano) != "số nguyên") { ném "TIME_RANGE"; };
        nếu (giờ < 0 || giờ > 23 || phút < 0 || phút > 59 ||
            giây < 0 || giây > 59 || nano < 0 || nano > 999999999) {
            ném "TIME_RANGE";
        };
        trả về {
            "__vpp_time__": 1,
            "giờ": giờ,
            "phút": phút,
            "giây": giây,
            "nano": nano
        };
    };

    hàm riêng tư thời gian yêu cầu ngày(giá trị) {
        nếu (loại của(giá trị) != "từ điển") {
            ném "TIME_RANGE";
        };
        nếu (lấy từ điển(giá trị, "__vpp_date__", 0) != 1) {
            ném "TIME_RANGE";
        };
        trả về giá trị;
    };

    hàm riêng tư thời gian yêu cầu giờ(giá trị) {
        nếu (loại của(giá trị) != "từ điển") {
            ném "TIME_RANGE";
        };
        nếu (lấy từ điển(giá trị, "__vpp_time__", 0) != 1) {
            ném "TIME_RANGE";
        };
        trả về giá trị;
    };

    hàm công khai tạo ngày giờ(ngày, giờ) {
        mình.thời gian yêu cầu ngày(ngày);
        mình.thời gian yêu cầu giờ(giờ);
        trả về {
            "__vpp_datetime__": 1,
            "ngày": ngày,
            "giờ": giờ
        };
    };

    hàm riêng tư thời gian yêu cầu ngày giờ(giá trị) {
        nếu (loại của(giá trị) != "từ điển") {
            ném "TIME_RANGE";
        };
        nếu (lấy từ điển(giá trị, "__vpp_datetime__", 0) != 1) {
            ném "TIME_RANGE";
        };
        mình.thời gian yêu cầu ngày(lấy từ điển(giá trị, "ngày", rỗng));
        mình.thời gian yêu cầu giờ(lấy từ điển(giá trị, "giờ", rỗng));
        trả về giá trị;
    };

    hàm riêng tư thời gian là chữ số(c) {
        trả về c >= "0" && c <= "9";
    };

    hàm riêng tư thời gian đọc số cố định(văn bản, bắt đầu, số lượng) {
        giá trị = 0;
        lặp(i = 0; i < số lượng; i++) {
            c = văn bản[bắt đầu + i];
            nếu (!mình.thời gian là chữ số(c)) {
                ném "TIME_PARSE";
            };
            giá trị = giá trị * 10 + thành số nguyên(c);
        };
        trả về giá trị;
    };

    hàm công khai phân tích ngày(văn bản) {
        nếu (loại của(văn bản) != "chuỗi") {
            ném "TIME_PARSE";
        };
        nếu (máy ảo lấy độ dài(văn bản) != 10) {
            ném "TIME_PARSE";
        };
        nếu (văn bản[4] != "-" || văn bản[7] != "-") {
            ném "TIME_PARSE";
        };
        năm = mình.thời gian đọc số cố định(văn bản, 0, 4);
        tháng = mình.thời gian đọc số cố định(văn bản, 5, 2);
        ngày = mình.thời gian đọc số cố định(văn bản, 8, 2);
        trả về mình.tạo ngày(năm, tháng, ngày);
    };

    hàm công khai phân tích ngày giờ(văn bản) {
        nếu (loại của(văn bản) != "chuỗi") {
            ném "TIME_PARSE";
        };
        n = máy ảo lấy độ dài(văn bản);
        nếu (n < 19 || n > 29) {
            ném "TIME_PARSE";
        };
        nếu (văn bản[4] != "-" || văn bản[7] != "-" || văn bản[10] != "T" ||
            văn bản[13] != ":" || văn bản[16] != ":") {
            ném "TIME_PARSE";
        };

        ngày = mình.phân tích ngày(cắt chuỗi(văn bản, 0, 10));
        giờ số = mình.thời gian đọc số cố định(văn bản, 11, 2);
        phút = mình.thời gian đọc số cố định(văn bản, 14, 2);
        giây = mình.thời gian đọc số cố định(văn bản, 17, 2);
        nano = 0;

        nếu (n > 19) {
            nếu (văn bản[19] != ".") {
                ném "TIME_PARSE";
            };
            chữ số = n - 20;
            nếu (chữ số < 1 || chữ số > 9) {
                ném "TIME_PARSE";
            };
            nano = mình.thời gian đọc số cố định(văn bản, 20, chữ số);
            lặp(i = chữ số; i < 9; i++) {
                nano = nano * 10;
            };
        };

        giờ = mình.tạo giờ(giờ số, phút, giây, nano);
        trả về mình.tạo ngày giờ(ngày, giờ);
    };

    hàm công khai thời gian đệm số(giá trị, rộng) {
        văn bản = thành chuỗi(giá trị);
        kết quả = "";
        lặp(i = máy ảo lấy độ dài(văn bản); i < rộng; i++) {
            kết quả = kết quả + "0";
        };
        trả về kết quả + văn bản;
    };

    hàm công khai định dạng ngày(ngày) {
        mình.thời gian yêu cầu ngày(ngày);
        trả về mình.thời gian đệm số(lấy từ điển(ngày, "năm", 0), 4) + "-" +
            mình.thời gian đệm số(lấy từ điển(ngày, "tháng", 0), 2) + "-" +
            mình.thời gian đệm số(lấy từ điển(ngày, "ngày", 0), 2);
    };

    hàm công khai định dạng giờ(giờ) {
        mình.thời gian yêu cầu giờ(giờ);
        kết quả = mình.thời gian đệm số(lấy từ điển(giờ, "giờ", 0), 2) + ":" +
            mình.thời gian đệm số(lấy từ điển(giờ, "phút", 0), 2) + ":" +
            mình.thời gian đệm số(lấy từ điển(giờ, "giây", 0), 2);
        nano = lấy từ điển(giờ, "nano", 0);
        nếu (nano == 0) {
            trả về kết quả;
        };

        phần = mình.thời gian đệm số(nano, 9);
        cuối = máy ảo lấy độ dài(phần);
        đang bỏ = đúng;
        khi (cuối > 1 && đang bỏ) {
            nếu (phần[cuối - 1] == "0") {
                cuối = cuối - 1;
            } hoặc {
                đang bỏ = sai;
            };
        };
        trả về kết quả + "." + cắt chuỗi(phần, 0, cuối);
    };

    hàm công khai định dạng ngày giờ(ngày giờ) {
        mình.thời gian yêu cầu ngày giờ(ngày giờ);
        trả về mình.định dạng ngày(lấy từ điển(ngày giờ, "ngày", rỗng)) + "T" +
            mình.định dạng giờ(lấy từ điển(ngày giờ, "giờ", rỗng));
    };
};


hàm công khai thời gian là năm nhuận(năm) {
    bộ chuyển tiếp = Lịch();
    trả về bộ chuyển tiếp.thời gian là năm nhuận(năm);
};

hàm công khai thời gian số ngày trong tháng(năm, tháng) {
    bộ chuyển tiếp = Lịch();
    trả về bộ chuyển tiếp.thời gian số ngày trong tháng(năm, tháng);
};

hàm công khai tạo ngày(năm, tháng, ngày) {
    bộ chuyển tiếp = Lịch();
    trả về bộ chuyển tiếp.tạo ngày(năm, tháng, ngày);
};

hàm công khai tạo giờ(giờ, phút, giây = 0, nano = 0) {
    bộ chuyển tiếp = Lịch();
    trả về bộ chuyển tiếp.tạo giờ(giờ, phút, giây, nano);
};

hàm công khai tạo ngày giờ(ngày, giờ) {
    bộ chuyển tiếp = Lịch();
    trả về bộ chuyển tiếp.tạo ngày giờ(ngày, giờ);
};

hàm công khai phân tích ngày(văn bản) {
    bộ chuyển tiếp = Lịch();
    trả về bộ chuyển tiếp.phân tích ngày(văn bản);
};

hàm công khai phân tích ngày giờ(văn bản) {
    bộ chuyển tiếp = Lịch();
    trả về bộ chuyển tiếp.phân tích ngày giờ(văn bản);
};

hàm công khai thời gian đệm số(giá trị, rộng) {
    bộ chuyển tiếp = Lịch();
    trả về bộ chuyển tiếp.thời gian đệm số(giá trị, rộng);
};

hàm công khai định dạng ngày(ngày) {
    bộ chuyển tiếp = Lịch();
    trả về bộ chuyển tiếp.định dạng ngày(ngày);
};

hàm công khai định dạng giờ(giờ) {
    bộ chuyển tiếp = Lịch();
    trả về bộ chuyển tiếp.định dạng giờ(giờ);
};

hàm công khai định dạng ngày giờ(ngày giờ) {
    bộ chuyển tiếp = Lịch();
    trả về bộ chuyển tiếp.định dạng ngày giờ(ngày giờ);
};
nhập gói.lõi.chuyển kiểu.thành chuỗi;
nhập gói.lõi.chuyển kiểu.thành số nguyên;
nhập gói.lõi.chuyển kiểu.loại của;
