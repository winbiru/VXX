

// Lớp sở hữu toàn bộ thuật toán của mô-đun; các hàm bên dưới chỉ giữ API cũ.
lớp công khai Thời Lượng {
    hàm công khai khởi tạo() {};

    // vi.time — phép toán thời lượng cơ bản, không phụ thuộc múi giờ.
    hàm công khai thời lượng mili giây(bắt đầu, kết thúc) {
        nếu (kết thúc < bắt đầu) {
            ném "thời gian: mốc kết thúc nhỏ hơn mốc bắt đầu";
        };
        trả về kết thúc - bắt đầu;
    };

    hàm công khai mili giây thành giây(mili giây) {
        trả về mili giây / 1000.0;
    };

    hàm công khai giây thành mili giây(giây) {
        trả về giây * 1000.0;
    };
};


hàm công khai thời lượng mili giây(bắt đầu, kết thúc) {
    bộ chuyển tiếp = Thời Lượng();
    trả về bộ chuyển tiếp.thời lượng mili giây(bắt đầu, kết thúc);
};

hàm công khai mili giây thành giây(mili giây) {
    bộ chuyển tiếp = Thời Lượng();
    trả về bộ chuyển tiếp.mili giây thành giây(mili giây);
};

hàm công khai giây thành mili giây(giây) {
    bộ chuyển tiếp = Thời Lượng();
    trả về bộ chuyển tiếp.giây thành mili giây(giây);
};
