// vi.time — đồng hồ đơn điệu để đo khoảng thời gian.
// Giá trị là số mili giây dạng số thực kể từ một mốc không xác định.
// Chỉ hiệu giữa hai lần đọc có ý nghĩa; không dùng làm thời gian lịch.

// Lớp sở hữu toàn bộ thuật toán của mô-đun; các hàm bên dưới chỉ giữ API cũ.
lớp công khai Đồng Hồ Đơn Điệu {
    hàm công khai khởi tạo() {};

    // Đệm 16 byte, giây/nanosecond little-endian từ machine intrinsic.
    hàm riêng tư đơn điệu đọc u64(đệm, bắt_đầu) {
        số = 0.0;
        bội = 1.0;
        lặp(i = 0; i < 8; i++) {
            số = số + đệm[bắt_đầu + i] * bội;
            bội = bội * 256.0;
        };
        trả về số;
    };

    hàm công khai thời gian đơn điệu mili giây() {
        đệm = máy_đồng_hồ_đơn_điệu();
        giây = mình.đơn điệu đọc u64(đệm, 0);
        nano = mình.đơn điệu đọc u64(đệm, 8);
        nếu (giây > 9007199254.0 || nano >= 1000000000.0) {
            ném "thời gian đơn điệu: timespec không hợp lệ";
        };
        trả về giây * 1000.0 + nano / 1000000.0;
    };

    hàm công khai bắt đầu đo thời gian() {
        trả về mình.thời gian đơn điệu mili giây();
    };

    hàm công khai kết thúc đo thời gian(bắt đầu) {
        trả về mình.thời gian đơn điệu mili giây() - bắt đầu;
    };
};


hàm công khai thời gian đơn điệu mili giây() {
    __vpp_adapter = Đồng Hồ Đơn Điệu();
    trả về __vpp_adapter.thời gian đơn điệu mili giây();
};

hàm công khai bắt đầu đo thời gian() {
    __vpp_adapter = Đồng Hồ Đơn Điệu();
    trả về __vpp_adapter.bắt đầu đo thời gian();
};

hàm công khai kết thúc đo thời gian(bắt đầu) {
    __vpp_adapter = Đồng Hồ Đơn Điệu();
    trả về __vpp_adapter.kết thúc đo thời gian(bắt đầu);
};
