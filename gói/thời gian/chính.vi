// Module: thời gian
// Mục đích: cung cấp API thời gian hiện tại cho ứng dụng.
// Clock/zone là primitive OS; định dạng ISO-8601 nằm hoàn toàn ở V++.

nhập gói/thời gian/lịch;
nhập gói/thời gian/giờ quốc tế;
nhập gói/thời gian/địa phương;
nhập gói/lõi/chuyển kiểu;

// Lớp sở hữu toàn bộ thuật toán của mô-đun; các hàm bên dưới chỉ giữ API cũ.
lớp công khai Đồng Hồ {
    hàm công khai khởi tạo() {};

    // Snapshot native: [năm, tháng, ngày, giờ, phút, giây, offset phút].
    // Các trường và offset được lấy từ cùng một lần đọc clock, tránh lệch ngày/DST.
    // Đệm trực tiếp giây để giữ được giây nhuận 60 nếu OS trả về giá trị đó.
    hàm công khai thời gian định dạng đồng hồ(các phần, giờ quốc tế) {
        kết quả = thời gian đệm số(các phần[0], 4) + "-" +
            thời gian đệm số(các phần[1], 2) + "-" +
            thời gian đệm số(các phần[2], 2) + "T" +
            thời gian đệm số(các phần[3], 2) + ":" +
            thời gian đệm số(các phần[4], 2) + ":" +
            thời gian đệm số(các phần[5], 2);
        nếu (giờ quốc tế) {
            trả về kết quả + "Z";
        };
        lệch = các phần[6];
        dấu = "+";
        nếu (lệch < 0) {
            dấu = "-";
            lệch = 0 - lệch;
        };
        giờ lệch = thành số nguyên(lệch / 60);
        trả về kết quả + dấu + thời gian đệm số(giờ lệch, 2) + ":" +
            thời gian đệm số(lệch % 60, 2);
    };

    // Trả thời gian local dạng ISO-8601 có offset, ví dụ 2026-09-15T16:10:20+07:00.
    hàm công khai lấy thời gian hiện tại() {
        trả về mình.thời gian định dạng đồng hồ(thời gian đọc địa phương posix(), sai);
    };

    // Trả thời gian UTC dạng ISO-8601, ví dụ 2026-09-15T09:10:20Z.
    hàm công khai lấy thời gian giờ quốc tế() {
        trả về mình.thời gian định dạng đồng hồ(thời gian đọc giờ quốc tế ffi(), đúng);
    };

    // Trả độ lệch local so với UTC theo phút, ví dụ UTC+07:00 là 420.
    hàm công khai độ lệch múi giờ() {
        các phần = thời gian đọc địa phương posix();
        trả về các phần[6];
    };

    // Alias tương thích cũng đi qua thân hàm V++.

    hàm công khai lấy giờ quốc tế() {
        trả về mình.lấy thời gian giờ quốc tế();
    };


    // Ghi chú hàm: giờ hiện tại.
    hàm công khai giờ hiện tại() {
        trả về mình.lấy thời gian hiện tại();
    };
};


hàm công khai thời gian định dạng đồng hồ(các phần, giờ quốc tế) {
    bộ chuyển tiếp = Đồng Hồ();
    trả về bộ chuyển tiếp.thời gian định dạng đồng hồ(các phần, giờ quốc tế);
};

hàm công khai lấy thời gian hiện tại() {
    bộ chuyển tiếp = Đồng Hồ();
    trả về bộ chuyển tiếp.lấy thời gian hiện tại();
};

hàm công khai lấy thời gian giờ quốc tế() {
    bộ chuyển tiếp = Đồng Hồ();
    trả về bộ chuyển tiếp.lấy thời gian giờ quốc tế();
};

hàm công khai độ lệch múi giờ() {
    bộ chuyển tiếp = Đồng Hồ();
    trả về bộ chuyển tiếp.độ lệch múi giờ();
};


hàm công khai lấy giờ quốc tế() {
    bộ chuyển tiếp = Đồng Hồ();
    trả về bộ chuyển tiếp.lấy giờ quốc tế();
};


hàm công khai giờ hiện tại() {
    bộ chuyển tiếp = Đồng Hồ();
    trả về bộ chuyển tiếp.giờ hiện tại();
};

nhập gói/thời gian/đơn điệu;
nhập gói/thời gian/thời lượng;
nhập gói/thời gian/giao diện đo;
nhập gói/thời gian/bộ bấm giờ;
