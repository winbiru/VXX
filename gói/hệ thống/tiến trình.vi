// Chạy executable bằng argv riêng và môi trường riêng cho tiến trình con.
// Validation/defaults thuộc V++; VM chỉ spawn, đọc pipe và chờ exit status.
nhập gói.lõi.chuyển kiểu.loại của;
nhập gói.lõi.bảng mã.ký tự unicode;
nhập gói.lõi.toán học.làm tròn lên;
nhập gói.lõi.toán học.làm tròn;
nhập gói.bộ sưu tập.từ điển.khóa từ điển;
nhập gói.thời gian.đơn điệu.thời gian đơn điệu mili giây;

// Định danh đi qua machine opcode, syscall trực tiếp bằng ASM trên POSIX
// được hỗ trợ. Không cần foreign descriptor / libffi cho sáu hàm này.

// Machine ABI uses VM-owned process tokens on POSIX and Windows.
// V++ controls argv, environment, draining, deadlines and result assembly.

// Lớp sở hữu toàn bộ thuật toán của mô-đun; các hàm bên dưới chỉ giữ API cũ.
lớp công khai Bộ Chạy Tiến Trình {
    hàm công khai khởi tạo() {};

    // PID của chính tiến trình đang chạy VM.
    hàm công khai mã tiến trình() {
        trả về máy tiến trình mã tiến trình();
    };

    // PID của tiến trình cha tại thời điểm gọi; có thể thay đổi nếu cha kết thúc.
    hàm công khai mã tiến trình cha() {
        trả về máy tiến trình mã tiến trình cha();
    };

    // POSIX real/effective IDs. UID/GID lớn hơn INT32_MAX chưa biểu diễn được
    // dưới dạng số nguyên i32 nên machine primitive trả AbiInteger u32.
    hàm công khai mã người dùng() {
        nếu (ten nền tảng máy ảo() == "windows") {
            ném "mã người dùng: Windows chưa được hỗ trợ";
        };
        trả về máy tiến trình mã người dùng();
    };

    hàm công khai mã người dùng hiệu lực() {
        nếu (ten nền tảng máy ảo() == "windows") {
            ném "mã người dùng hiệu lực: Windows chưa được hỗ trợ";
        };
        trả về máy tiến trình mã người dùng hiệu lực();
    };

    hàm công khai mã nhóm() {
        nếu (ten nền tảng máy ảo() == "windows") {
            ném "mã nhóm: Windows chưa được hỗ trợ";
        };
        trả về máy tiến trình mã nhóm();
    };

    hàm công khai mã nhóm hiệu lực() {
        nếu (ten nền tảng máy ảo() == "windows") {
            ném "mã nhóm hiệu lực: Windows chưa được hỗ trợ";
        };
        trả về máy tiến trình mã nhóm hiệu lực();
    };

    hàm công khai tiến trình yêu cầu chuỗi(giá trị, nhãn) {
        nếu (loại của(giá trị) != "chuỗi") {
            ném "chạy tiến trình: " + nhãn + " phải là chuỗi";
        };
        ký tự không = ký tự unicode(0);
        lặp(i = 0; i < máy ảo lấy độ dài(giá trị); i++) {
            nếu (giá trị[i] == ký tự không) {
                ném "chạy tiến trình: " + nhãn + " không được chứa NUL";
            };
        };
        trả về giá trị;
    };

    // Quy tắc quote đối số CreateProcessW / argv của C runtime trên Windows:
    // backslash đứng trước quote phải gấp đôi và thêm một; cuối chuỗi có quote
    // thì các backslash cuối cũng phải gấp đôi. Unicode được giữ nguyên.
    hàm công khai tiến trình nháy windows(đối số) {
        cần nháy = đối số == "";
        lặp(i = 0; i < máy ảo lấy độ dài(đối số); i++) {
            c = đối số[i];
            nếu (c == " " || c == "\t" || c == "\n" ||
                c == ký tự unicode(11) || c == "\"") { cần nháy = đúng; };
        };
        nếu (!cần nháy) { trả về đối số; };
        kết quả = "\"";
        dấu gạch = 0;
        lặp(i = 0; i < máy ảo lấy độ dài(đối số); i++) {
            c = đối số[i];
            nếu (c == "\\") {
                dấu gạch = dấu gạch + 1;
            } hoặc {
                số gạch = dấu gạch;
                nếu (c == "\"") { số gạch = dấu gạch * 2 + 1; };
                lặp(j = 0; j < số gạch; j++) { kết quả = kết quả + "\\"; };
                kết quả = kết quả + c;
                dấu gạch = 0;
            };
        };
        lặp(j = 0; j < dấu gạch * 2; j++) { kết quả = kết quả + "\\"; };
        trả về kết quả + "\"";
    };

    hàm công khai tiến trình dựng lệnh windows(chương trình, đối số) {
        dòng lệnh = mình.tiến trình nháy windows(chương trình);
        lặp(i = 0; i < máy ảo lấy độ dài(đối số); i++) {
            dòng lệnh = dòng lệnh + " " + mình.tiến trình nháy windows(đối số[i]);
        };
        trả về dòng lệnh;
    };

    // Kết quả công khai được V++ dựng thống nhất cho mọi backend.
    hàm công khai tiến trình kết quả(khởi chạy, mã thoát, đầu ra, lỗi) {
        trả về {
            "khởi chạy": khởi chạy, "mã thoát": mã thoát,
            "đầu ra": đầu ra, "lỗi": lỗi
        };
    };

    // Đọc đúng một khối đã sẵn sàng. Machine chỉ sao chép byte vào đệm do V++ cấp;
    // việc dựng chuỗi, kể cả dữ liệu chứa NUL, do gói này thực hiện.
    hàm công khai tiến trình đọc khối(mã, kênh, đệm) {
        n = máy tiến trình đọc(mã, kênh, đệm, 4096);
        byte đọc = [];
        lặp(i = 0; i < n; i++) { máy ảo thêm cuối danh sách(byte đọc, đệm[i]); };
        trả về chuỗi từ byte máy ảo(byte đọc);
    };

    hàm công khai chạy tiến trình(chương trình, đối số = rỗng, môi trường = rỗng, mức trần mili giây = rỗng) {
        chương trình = mình.tiến trình yêu cầu chuỗi(chương trình, "chương trình");
        nếu (chương trình == "") { ném "chạy tiến trình: chương trình không được rỗng"; };
        nếu (đối số == rỗng) { đối số = []; };
        nếu (môi trường == rỗng) { môi trường = {}; };
        nếu (loại của(đối số) != "danh sách") {
            ném "chạy tiến trình: đối số phải là danh sách";
        };
        nếu (loại của(môi trường) != "từ điển") {
            ném "chạy tiến trình: môi trường phải là từ điển";
        };
        nếu (mức trần mili giây != rỗng) {
            nếu (loại của(mức trần mili giây) != "số nguyên" ||
                mức trần mili giây < 1) {
                ném "chạy tiến trình: giới hạn mili giây phải là số nguyên dương";
            };
        };
        lặp(i = 0; i < máy ảo lấy độ dài(đối số); i++) {
            mình.tiến trình yêu cầu chuỗi(đối số[i], "đối số");
        };
        tên = khóa từ điển(môi trường);
        lặp(i = 0; i < máy ảo lấy độ dài(tên); i++) {
            khóa tra cứu = mình.tiến trình yêu cầu chuỗi(tên[i], "tên biến môi trường");
            nếu (khóa tra cứu == "") { ném "chạy tiến trình: tên biến môi trường không được rỗng"; };
            lặp(j = 0; j < máy ảo lấy độ dài(khóa tra cứu); j++) {
                nếu (khóa tra cứu[j] == "=") { ném "chạy tiến trình: tên biến môi trường không được chứa ="; };
            };
            mình.tiến trình yêu cầu chuỗi(môi trường[khóa tra cứu], "giá trị biến môi trường");
        };
        // POSIX và Windows dùng cùng thuật toán V++ với vòng đời child do VM quản lý.
        mã = máy tiến trình tạo(chương trình);
        thử {
            nếu (ten nền tảng máy ảo() == "windows") {
                máy tiến trình lệnh windows(mã, mình.tiến trình dựng lệnh windows(chương trình, đối số));
            } hoặc {
                lặp(i = 0; i < máy ảo lấy độ dài(đối số); i++) {
                    máy tiến trình đối số(mã, đối số[i]);
                };
            };
            lặp(i = 0; i < máy ảo lấy độ dài(tên); i++) {
                máy tiến trình môi trường(mã, tên[i], môi trường[tên[i]]);
            };
            nếu (máy tiến trình bắt đầu(mã) == 0) {
                lỗi = máy tiến trình lỗi(mã);
                máy tiến trình đóng(mã);
                trả về mình.tiến trình kết quả(sai, -1, "", lỗi);
            };
            đầu ra = "";
            lỗi ra = "";
            hết hạn = 0.0;
            nếu (mức trần mili giây != rỗng) {
                hết hạn = thời gian đơn điệu mili giây() + mức trần mili giây;
            };
            // Cấp đệm một lần cho cả hai pipe; adapter chỉ ghi các byte đầu n.
            đệm = [];
            lặp(j = 0; j < 4096; j++) { máy ảo thêm cuối danh sách(đệm, 0); };
            // poll đồng thời hai pipe để child không bị kẹt vì một pipe đầy.
            lặp(vòng = 0; vòng < 2147483647; vòng++) {
                chờ = 1000;
                nếu (mức trần mili giây != rỗng) {
                    còn = hết hạn - thời gian đơn điệu mili giây();
                    nếu (còn <= 0.0) {
                        máy tiến trình đóng(mã);
                        trả về mình.tiến trình kết quả(đúng, -1, đầu ra,
                            lỗi ra + "chạy tiến trình: quá thời hạn");
                    };
                    // Chỉ chờ phần thời gian còn lại; làm tròn lên để số thực
                    // có phần lẻ không bị chuyển sang số nguyên sai contract.
                    nếu (còn < 1000.0) { chờ = làm tròn lên(còn); };
                };
                sẵn sàng = máy tiến trình thăm dò(mã, chờ);
                nếu (sẵn sàng == 4) { thoát; };
                lặp(kênh = 1; kênh <= 2; kênh++) {
                    đọc kênh = sai;
                    nếu (kênh == 1 && (sẵn sàng % 2) == 1) { đọc kênh = đúng; };
                    nếu (kênh == 2 && sẵn sàng >= 2) { đọc kênh = đúng; };
                    nếu (đọc kênh) {
                        khối = mình.tiến trình đọc khối(mã, kênh, đệm);
                        nếu (kênh == 1) {
                            đầu ra = đầu ra + khối;
                        } hoặc {
                            lỗi ra = lỗi ra + khối;
                        };
                    };
                };
            };
            nếu (vòng == 2147483647) { ném "chạy tiến trình: vượt giới hạn vòng đọc"; };
            mã thoát = máy tiến trình đợi(mã);
            máy tiến trình đóng(mã);
            trả về mình.tiến trình kết quả(đúng, mã thoát, đầu ra, lỗi ra);
        } bắt lỗi(e) {
            thử { máy tiến trình đóng(mã); } bắt lỗi(số mục bỏ qua) {};
            ném e;
        };
    };
};


hàm công khai mã tiến trình() {
    bộ chuyển tiếp = Bộ Chạy Tiến Trình();
    trả về bộ chuyển tiếp.mã tiến trình();
};

hàm công khai mã tiến trình cha() {
    bộ chuyển tiếp = Bộ Chạy Tiến Trình();
    trả về bộ chuyển tiếp.mã tiến trình cha();
};

hàm công khai mã người dùng() {
    bộ chuyển tiếp = Bộ Chạy Tiến Trình();
    trả về bộ chuyển tiếp.mã người dùng();
};

hàm công khai mã người dùng hiệu lực() {
    bộ chuyển tiếp = Bộ Chạy Tiến Trình();
    trả về bộ chuyển tiếp.mã người dùng hiệu lực();
};

hàm công khai mã nhóm() {
    bộ chuyển tiếp = Bộ Chạy Tiến Trình();
    trả về bộ chuyển tiếp.mã nhóm();
};

hàm công khai mã nhóm hiệu lực() {
    bộ chuyển tiếp = Bộ Chạy Tiến Trình();
    trả về bộ chuyển tiếp.mã nhóm hiệu lực();
};

hàm công khai tiến trình yêu cầu chuỗi(giá trị, nhãn) {
    bộ chuyển tiếp = Bộ Chạy Tiến Trình();
    trả về bộ chuyển tiếp.tiến trình yêu cầu chuỗi(giá trị, nhãn);
};

hàm công khai tiến trình nháy windows(đối số) {
    bộ chuyển tiếp = Bộ Chạy Tiến Trình();
    trả về bộ chuyển tiếp.tiến trình nháy windows(đối số);
};

hàm công khai tiến trình dựng lệnh windows(chương trình, đối số) {
    bộ chuyển tiếp = Bộ Chạy Tiến Trình();
    trả về bộ chuyển tiếp.tiến trình dựng lệnh windows(chương trình, đối số);
};

hàm công khai tiến trình kết quả(khởi chạy, mã thoát, đầu ra, lỗi) {
    bộ chuyển tiếp = Bộ Chạy Tiến Trình();
    trả về bộ chuyển tiếp.tiến trình kết quả(khởi chạy, mã thoát, đầu ra, lỗi);
};

hàm công khai tiến trình đọc khối(mã, kênh, đệm) {
    bộ chuyển tiếp = Bộ Chạy Tiến Trình();
    trả về bộ chuyển tiếp.tiến trình đọc khối(mã, kênh, đệm);
};

hàm công khai chạy tiến trình(chương trình, đối số = rỗng, môi trường = rỗng, mức trần mili giây = rỗng) {
    bộ chuyển tiếp = Bộ Chạy Tiến Trình();
    trả về bộ chuyển tiếp.chạy tiến trình(chương trình, đối số, môi trường, mức trần mili giây);
};
