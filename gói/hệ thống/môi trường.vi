// Module: hệ thống.môi trường
// Chính sách tên và giá trị mặc định thuộc V++; VM chỉ đọc môi trường OS.

nhập gói/lõi/chuyển kiểu;

// Lớp sở hữu toàn bộ thuật toán của mô-đun; các hàm bên dưới chỉ giữ API cũ.
lớp công khai Môi Trường {
    hàm công khai khởi tạo() {};

    hàm công khai môi trường chuẩn hóa tên(tên) {
        tên = thành chuỗi(tên);
        nếu (tên == "") {
            ném "doc_bien_moi_truong_vm: tên biến môi trường không hợp lệ";
        };
        nul = chuoi_tu_bytes_vm([0]);
        lặp(i = 0; i < do_dai(tên); i++) {
            nếu (tên[i] == "=" || tên[i] == nul) {
                ném "doc_bien_moi_truong_vm: tên biến môi trường không hợp lệ";
            };
        };
        trả về tên;
    };

    hàm công khai đọc biến môi trường(tên, giá_trị_mặc_định) {
        tên = mình.môi trường chuẩn hóa tên(tên);
        giá_trị = máy_môi_trường_đọc(tên);
        nếu (giá_trị == rỗng) {
            trả về giá_trị_mặc_định;
        };
        trả về giá_trị;
    };
};


hàm công khai môi trường chuẩn hóa tên(tên) {
    __vpp_adapter = Môi Trường();
    trả về __vpp_adapter.môi trường chuẩn hóa tên(tên);
};

hàm công khai đọc biến môi trường(tên, giá_trị_mặc_định) {
    __vpp_adapter = Môi Trường();
    trả về __vpp_adapter.đọc biến môi trường(tên, giá_trị_mặc_định);
};
