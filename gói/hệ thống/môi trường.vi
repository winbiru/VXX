// Module: hệ thống.môi trường
// Chính sách tên và giá trị mặc định thuộc V++; VM chỉ đọc môi trường OS.

nhập gói.lõi.chuyển kiểu.thành chuỗi;

// Lớp sở hữu toàn bộ thuật toán của mô-đun; các hàm bên dưới chỉ giữ API cũ.
lớp công khai Môi Trường {
    hàm công khai khởi tạo() {};

    hàm công khai môi trường chuẩn hóa tên(tên) {
        tên = thành chuỗi(tên);
        nếu (tên == "") {
            ném "đọc biến moi truong máy ảo: tên biến môi trường không hợp lệ";
        };
        ký tự không = chuỗi từ byte máy ảo([0]);
        lặp(i = 0; i < máy ảo lấy độ dài(tên); i++) {
            nếu (tên[i] == "=" || tên[i] == ký tự không) {
                ném "đọc biến moi truong máy ảo: tên biến môi trường không hợp lệ";
            };
        };
        trả về tên;
    };

    hàm công khai đọc biến môi trường(tên, giá trị mặc định) {
        tên = mình.môi trường chuẩn hóa tên(tên);
        giá trị = máy môi trường đọc(tên);
        nếu (giá trị == rỗng) {
            trả về giá trị mặc định;
        };
        trả về giá trị;
    };
};


hàm công khai môi trường chuẩn hóa tên(tên) {
    bộ chuyển tiếp = Môi Trường();
    trả về bộ chuyển tiếp.môi trường chuẩn hóa tên(tên);
};

hàm công khai đọc biến môi trường(tên, giá trị mặc định) {
    bộ chuyển tiếp = Môi Trường();
    trả về bộ chuyển tiếp.đọc biến môi trường(tên, giá trị mặc định);
};
