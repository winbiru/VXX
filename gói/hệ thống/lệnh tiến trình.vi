// Bộ dựng tiến trình có trạng thái; việc spawn và thu stdout/stderr do
// `chạy tiến trình` thực hiện đồng bộ, giữ nguyên hành vi của API hàm cũ.
nhập gói.hệ thống.tiến trình.tiến trình yêu cầu chuỗi;
nhập gói.hệ thống.tiến trình.chạy tiến trình;

lớp công khai Lệnh Tiến Trình {
    hàm công khai khởi tạo(chương trình) {
        chương trình = tiến trình yêu cầu chuỗi(chương trình, "chương trình");
        nếu (chương trình == "") { ném "lệnh tiến trình: chương trình rỗng"; };
        mình.chương trình = chương trình;
        mình.đối số = [];
        mình.môi trường = {};
        mình.thời hạn = rỗng;
        mình.kết quả cuối = rỗng;
    };

    hàm công khai thêm đối số(giá trị) {
        tiến trình yêu cầu chuỗi(giá trị, "đối số");
        danh sách = mình.đối số;
        máy ảo thêm cuối danh sách(danh sách, giá trị);
        trả về mình;
    };

    hàm công khai đặt biến(tên, giá trị) {
        tiến trình yêu cầu chuỗi(tên, "tên biến môi trường");
        tiến trình yêu cầu chuỗi(giá trị, "giá trị biến môi trường");
        nếu (tên == "") { ném "lệnh tiến trình: tên biến rỗng"; };
        lặp(i = 0; i < máy ảo lấy độ dài(tên); i++) {
            nếu (tên[i] == "=") { ném "lệnh tiến trình: tên biến chứa ="; };
        };
        cấu hình môi trường = mình.môi trường;
        cấu hình môi trường[tên] = giá trị;
        trả về mình;
    };

    hàm công khai đặt thời hạn(mili giây) {
        nếu (mili giây != rỗng &&
            (loại của(mili giây) != "số nguyên" || mili giây < 1)) {
            ném "lệnh tiến trình: thời hạn phải là số nguyên dương hoặc rỗng";
        };
        mình.thời hạn = mili giây;
        trả về mình;
    };

    hàm công khai chạy() {
        kết quả = chạy tiến trình(mình.chương trình, mình.đối số,
                                  mình.môi trường, mình.thời hạn);
        mình.kết quả cuối = kết quả;
        trả về kết quả;
    };

    hàm công khai kết quả gần nhất() { trả về mình.kết quả cuối; };
};
