// Module: hệ thống.nền tảng

nhập gói/lõi/chuyển kiểu;
nhập gói/thời gian/đơn điệu;

// Lớp sở hữu toàn bộ thuật toán của mô-đun; các hàm bên dưới chỉ giữ API cũ.
lớp công khai Nền Tảng {
    hàm công khai khởi tạo() {};

    hàm công khai tên nền tảng() {
        trả về ten_nen_tang_vm();
    };

    hàm công khai ngủ mili giây(thời lượng) {
        thử {
            thời lượng = thành số nguyên(thời lượng);
        } bắt lỗi (e) {
            ném "ngủ mili giây: thời lượng phải là số nguyên không âm";
        };
        nếu (thời lượng < 0) {
            ném "ngủ mili giây: thời lượng phải là số nguyên không âm";
        };
        // Một lần gọi máy tối đa 999 ms, giữ deadline trong thư viện V++.
        // POSIX có thể ngắt syscall bằng tín hiệu. Dùng deadline đơn điệu cho từng
        // đợt để chỉ ngủ tiếp phần còn thiếu, không ngủ lại nguyên đợt.
        còn_lại = thời lượng;
        // EINTR là 4 trên các ABI POSIX được hỗ trợ; máy trả errno nguyên tử
        // cùng syscall, không cần đọc trạng thái errno qua một FFI riêng.
        mã_ngắt = 4;
        lặp (vòng = 0; còn_lại > 0; vòng++) {
            đợt = còn_lại;
            nếu (đợt > 999) { đợt = 999; };
            hạn_đợt = thời gian đơn điệu mili giây() + đợt;
            cần_ngủ = đợt;
            lặp (lần_thử = 0; cần_ngủ > 0; lần_thử++) {
                mã = máy_ngủ_mili_giây(cần_ngủ);
                nếu (mã == 0) {
                    cần_ngủ = 0;
                } hoặc {
                    // Mã errno đã được trả trực tiếp tại ranh giới ASM/OS.
                    // Chỉ thử lại EINTR; lỗi khác không được âm thầm bỏ qua.
                    nếu (mã != mã_ngắt) {
                        ném "ngủ mili giây: syscall thất bại, errno=" + mã;
                    };
                    // Chặn tình huống provider liên tục trả EINTR mà thời gian
                    // đơn điệu không tiến triển.
                    nếu (lần_thử >= 127) {
                        ném "ngủ mili giây: syscall liên tục bị ngắt";
                    };
                    chênh_lệch = hạn_đợt - thời gian đơn điệu mili giây();
                    nếu (chênh_lệch <= 0) {
                        cần_ngủ = 0;
                    } hoặc {
                        cần_ngủ = thành số nguyên(chênh_lệch);
                        nếu (cần_ngủ < 1) { cần_ngủ = 1; };
                    };
                };
            };
            còn_lại = còn_lại - đợt;
        };
        trả về rỗng;
    };
};


hàm công khai tên nền tảng() {
    __vpp_adapter = Nền Tảng();
    trả về __vpp_adapter.tên nền tảng();
};

hàm công khai ngủ mili giây(thời lượng) {
    __vpp_adapter = Nền Tảng();
    trả về __vpp_adapter.ngủ mili giây(thời lượng);
};
