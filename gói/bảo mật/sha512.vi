// SHA-512 FIPS 180-4 entirely in V++ using radix-256 64-bit words.
// Byte arithmetic avoids platform-specific integer width and signed shifts.
nhập gói.lõi.toán học.làm tròn xuống;

lớp công khai SHA512 VPP {
    hàm công khai khởi tạo() {};

    hàm riêng tư cộng(a, b) {
        result = []; lặp(i = 0; i < 8; i++) { thêm(result, 0); };
        carry = 0;
        lặp(i = 7; i >= 0; i--) {
            sum = a[i] + b[i] + carry;
            result[i] = sum % 256;
            carry = làm tròn xuống(sum / 256);
        };
        trả về result;
    };

    hàm riêng tư xor(a, b) {
        result = [];
        lặp(i = 0; i < 8; i++) { thêm(result, a[i] ^ b[i]); };
        trả về result;
    };

    hàm riêng tư xo3(a, b, c) {
        trả về mình.xor(mình.xor(a, b), c);
    };

    hàm riêng tư quay(a, n) {
        result = []; byte_offset = làm tròn xuống(n / 8); shift = n % 8;
        lặp(i = 0; i < 8; i++) {
            source = (i - byte_offset + 8) % 8;
            value = a[source];
            nếu (shift != 0) {
                previous = (source + 7) % 8;
                value = (value >> shift) | ((a[previous] << (8 - shift)) & 255);
            };
            thêm(result, value);
        };
        trả về result;
    };

    hàm riêng tư dịch(a, n) {
        result = []; byte_offset = làm tròn xuống(n / 8); shift = n % 8;
        lặp(i = 0; i < 8; i++) {
            source = i - byte_offset; value = 0;
            nếu (source >= 0) {
                value = a[source] >> shift;
                nếu (shift != 0 && source > 0) {
                    value = value | ((a[source - 1] << (8 - shift)) & 255);
                };
            };
            thêm(result, value);
        };
        trả về result;
    };

    hàm riêng tư chọn(e, f, g) {
        result = [];
        lặp(i = 0; i < 8; i++) {
            thêm(result, (e[i] & f[i]) ^ ((e[i] ^ 255) & g[i]));
        };
        trả về result;
    };

    hàm riêng tư đa số(a, b, c) {
        result = [];
        lặp(i = 0; i < 8; i++) {
            thêm(result, (a[i] & b[i]) ^ (a[i] & c[i]) ^ (b[i] & c[i]));
        };
        trả về result;
    };

    hàm riêng tư k() {
        // First 80 primes, fractional cube-root bits from FIPS 180-4.
        trả về [
            [66,138,47,152,215,40,174,34],
            [113,55,68,145,35,239,101,205],
            [181,192,251,207,236,77,59,47],
            [233,181,219,165,129,137,219,188],
            [57,86,194,91,243,72,181,56],
            [89,241,17,241,182,5,208,25],
            [146,63,130,164,175,25,79,155],
            [171,28,94,213,218,109,129,24],
            [216,7,170,152,163,3,2,66],
            [18,131,91,1,69,112,111,190],
            [36,49,133,190,78,228,178,140],
            [85,12,125,195,213,255,180,226],
            [114,190,93,116,242,123,137,111],
            [128,222,177,254,59,22,150,177],
            [155,220,6,167,37,199,18,53],
            [193,155,241,116,207,105,38,148],
            [228,155,105,193,158,241,74,210],
            [239,190,71,134,56,79,37,227],
            [15,193,157,198,139,140,213,181],
            [36,12,161,204,119,172,156,101],
            [45,233,44,111,89,43,2,117],
            [74,116,132,170,110,166,228,131],
            [92,176,169,220,189,65,251,212],
            [118,249,136,218,131,17,83,181],
            [152,62,81,82,238,102,223,171],
            [168,49,198,109,45,180,50,16],
            [176,3,39,200,152,251,33,63],
            [191,89,127,199,190,239,14,228],
            [198,224,11,243,61,168,143,194],
            [213,167,145,71,147,10,167,37],
            [6,202,99,81,224,3,130,111],
            [20,41,41,103,10,14,110,112],
            [39,183,10,133,70,210,47,252],
            [46,27,33,56,92,38,201,38],
            [77,44,109,252,90,196,42,237],
            [83,56,13,19,157,149,179,223],
            [101,10,115,84,139,175,99,222],
            [118,106,10,187,60,119,178,168],
            [129,194,201,46,71,237,174,230],
            [146,114,44,133,20,130,53,59],
            [162,191,232,161,76,241,3,100],
            [168,26,102,75,188,66,48,1],
            [194,75,139,112,208,248,151,145],
            [199,108,81,163,6,84,190,48],
            [209,146,232,25,214,239,82,24],
            [214,153,6,36,85,101,169,16],
            [244,14,53,133,87,113,32,42],
            [16,106,160,112,50,187,209,184],
            [25,164,193,22,184,210,208,200],
            [30,55,108,8,81,65,171,83],
            [39,72,119,76,223,142,235,153],
            [52,176,188,181,225,155,72,168],
            [57,28,12,179,197,201,90,99],
            [78,216,170,74,227,65,138,203],
            [91,156,202,79,119,99,227,115],
            [104,46,111,243,214,178,184,163],
            [116,143,130,238,93,239,178,252],
            [120,165,99,111,67,23,47,96],
            [132,200,120,20,161,240,171,114],
            [140,199,2,8,26,100,57,236],
            [144,190,255,250,35,99,30,40],
            [164,80,108,235,222,130,189,233],
            [190,249,163,247,178,198,121,21],
            [198,113,120,242,227,114,83,43],
            [202,39,62,206,234,38,97,156],
            [209,134,184,199,33,192,194,7],
            [234,218,125,214,205,224,235,30],
            [245,125,79,127,238,110,209,120],
            [6,240,103,170,114,23,111,186],
            [10,99,125,197,162,200,152,166],
            [17,63,152,4,190,249,13,174],
            [27,113,11,53,19,28,71,27],
            [40,219,119,245,35,4,125,132],
            [50,202,171,123,64,199,36,147],
            [60,158,190,10,21,201,190,188],
            [67,29,103,196,156,16,13,76],
            [76,197,212,190,203,62,66,182],
            [89,127,41,156,252,101,126,42],
            [95,203,111,171,58,214,250,236],
            [108,68,25,140,74,71,88,23]
        ];
    };

    hàm công khai băm(data) {
        nếu (loại của(data) != "danh sách" || độ dài(data) > 1048576) {
            ném "SHA512: invalid message length";
        };
        lặp(i = 0; i < độ dài(data); i++) {
            nếu (loại của(data[i]) != "số nguyên" || data[i] < 0 || data[i] > 255) {
                ném "SHA512: invalid byte";
            };
        };
        length = độ dài(data);
        full = length - length % 128;
        tail = [];
        lặp(i = full; i < length; i++) { thêm(tail, data[i]); };
        thêm(tail, 128);
        khi (độ dài(tail) % 128 != 112) { thêm(tail, 0); };
        bits = length * 8;
        size = [];
        lặp(i = 0; i < 16; i++) { thêm(size, 0); };
        lặp(i = 15; i >= 0; i--) {
            size[i] = bits % 256;
            bits = làm tròn xuống(bits / 256);
        };
        lặp(i = 0; i < 16; i++) { thêm(tail, size[i]); };

        // Initial SHA-512 state from fractional square roots of primes.
        h = [
            [106,9,230,103,243,188,201,8],
            [187,103,174,133,132,202,167,59],
            [60,110,243,114,254,148,248,43],
            [165,79,245,58,95,29,54,241],
            [81,14,82,127,173,230,130,209],
            [155,5,104,140,43,62,108,31],
            [31,131,217,171,251,65,189,107],
            [91,224,205,25,19,126,33,121]
        ];
        constants = mình.k();
        w = [];
        lặp(i = 0; i < 80; i++) { thêm(w, []); };
        total = full + độ dài(tail);
        lặp(start = 0; start < total; start = start + 128) {
            block = data; pos = start;
            nếu (start >= full) { block = tail; pos = start - full; };
            lặp(i = 0; i < 16; i++) {
                word = [];
                lặp(j = 0; j < 8; j++) { thêm(word, block[pos + i * 8 + j]); };
                w[i] = word;
            };
            lặp(i = 16; i < 80; i++) {
                x = w[i - 15]; y = w[i - 2];
                s0 = mình.xo3(mình.quay(x, 1), mình.quay(x, 8), mình.dịch(x, 7));
                s1 = mình.xo3(mình.quay(y, 19), mình.quay(y, 61), mình.dịch(y, 6));
                w[i] = mình.cộng(mình.cộng(mình.cộng(w[i - 16], s0), w[i - 7]), s1);
            };
            a = h[0]; b = h[1]; c = h[2]; d = h[3];
            e = h[4]; f = h[5]; g = h[6]; hh = h[7];
            lặp(i = 0; i < 80; i++) {
                s1 = mình.xo3(mình.quay(e, 14), mình.quay(e, 18), mình.quay(e, 41));
                t1 = mình.cộng(mình.cộng(mình.cộng(mình.cộng(hh, s1), mình.chọn(e, f, g)), constants[i]), w[i]);
                s0 = mình.xo3(mình.quay(a, 28), mình.quay(a, 34), mình.quay(a, 39));
                t2 = mình.cộng(s0, mình.đa số(a, b, c));
                hh = g; g = f; f = e; e = mình.cộng(d, t1);
                d = c; c = b; b = a; a = mình.cộng(t1, t2);
            };
            h[0] = mình.cộng(h[0], a); h[1] = mình.cộng(h[1], b);
            h[2] = mình.cộng(h[2], c); h[3] = mình.cộng(h[3], d);
            h[4] = mình.cộng(h[4], e); h[5] = mình.cộng(h[5], f);
            h[6] = mình.cộng(h[6], g); h[7] = mình.cộng(h[7], hh);
        };
        digest = [];
        lặp(i = 0; i < 8; i++) {
            lặp(j = 0; j < 8; j++) { thêm(digest, h[i][j]); };
        };
        trả về digest;
    };
};
