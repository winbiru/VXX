hàm mật mã độ dài bit bytes(số_byte) {
    kết_quả = [0, 0, 0, 0, 0, 0, 0, 0];
    còn_lại = số_byte;
    lặp(i = 7; i >= 0; i--) {
        kết_quả[i] = còn_lại % 256;
        còn_lại = lam_tron_xuong(còn_lại / 256);
    };
    nhớ = 0;
    lặp(i = 7; i >= 0; i--) {
        giá_trị = kết_quả[i] * 8 + nhớ;
        kết_quả[i] = giá_trị % 256;
        nhớ = lam_tron_xuong(giá_trị / 256);
    };
    trả về kết_quả;
};

hàm mật mã sha256 bytes(bytes) {
    thông_điệp = [];
    lặp(i = 0; i < do_dai(bytes); i++) {
        byte = bytes[i];
        nếu (loai_cua(byte) != "số nguyên" || byte < 0 || byte > 255) {
            ném "băm sha256: dữ liệu byte không hợp lệ";
        };
        them(thông_điệp, byte);
    };
    độ_dài_gốc = do_dai(thông_điệp);
    them(thông_điệp, 128);
    lặp(vòng = 0; do_dai(thông_điệp) % 64 != 56; vòng++) {
        them(thông_điệp, 0);
    };
    dài_bit = mật mã độ dài bit bytes(độ_dài_gốc);
    lặp(i = 0; i < 8; i++) {
        them(thông_điệp, dài_bit[i]);
    };

    h = [
        [106,9,230,103], [187,103,174,133], [60,110,243,114], [165,79,245,58],
        [81,14,82,127], [155,5,104,140], [31,131,217,171], [91,224,205,25]
    ];
    k = mật mã hằng số sha256();

    lặp(bắt_đầu = 0; bắt_đầu < do_dai(thông_điệp); bắt_đầu += 64) {
        w = [];
        lặp(t = 0; t < 16; t++) {
            p = bắt_đầu + t * 4;
            them(w, [thông_điệp[p], thông_điệp[p + 1], thông_điệp[p + 2], thông_điệp[p + 3]]);
        };
        lặp(t_mở_rộng = 16; t_mở_rộng < 64; t_mở_rộng++) {
            giá_trị = mật mã cộng word(
                mật mã sigma nhỏ một(w[t_mở_rộng - 2]),
                w[t_mở_rộng - 7]
            );
            giá_trị = mật mã cộng word(
                giá_trị,
                mật mã sigma nhỏ không(w[t_mở_rộng - 15])
            );
            giá_trị = mật mã cộng word(giá_trị, w[t_mở_rộng - 16]);
            them(w, giá_trị);
        };

        a = h[0];
        b = h[1];
        c = h[2];
        d = h[3];
        e = h[4];
        f = h[5];
        g = h[6];
        hh = h[7];

        lặp(t_vòng = 0; t_vòng < 64; t_vòng++) {
            t1 = mật mã cộng word(hh, mật mã sigma lớn một(e));
            t1 = mật mã cộng word(t1, mật mã lựa chọn(e, f, g));
            t1 = mật mã cộng word(t1, k[t_vòng]);
            t1 = mật mã cộng word(t1, w[t_vòng]);
            t2 = mật mã cộng word(mật mã sigma lớn không(a), mật mã đa số(a, b, c));

            hh = g;
            g = f;
            f = e;
            e = mật mã cộng word(d, t1);
            d = c;
            c = b;
            b = a;
            a = mật mã cộng word(t1, t2);
        };

        h[0] = mật mã cộng word(h[0], a);
        h[1] = mật mã cộng word(h[1], b);
        h[2] = mật mã cộng word(h[2], c);
        h[3] = mật mã cộng word(h[3], d);
        h[4] = mật mã cộng word(h[4], e);
        h[5] = mật mã cộng word(h[5], f);
        h[6] = mật mã cộng word(h[6], g);
        h[7] = mật mã cộng word(h[7], hh);
    };

    kết_quả = [];
    lặp(i = 0; i < 8; i++) {
        lặp(j = 0; j < 4; j++) {
            them(kết_quả, h[i][j]);
        };
    };
    trả về kết_quả;
};

hàm mật mã hex(bytes) {
    alphabet = "0123456789abcdef";
    kết_quả = "";
    lặp(i = 0; i < do_dai(bytes); i++) {
        byte = bytes[i];
        kết_quả = kết_quả + alphabet[lam_tron_xuong(byte / 16)] + alphabet[byte % 16];
    };
    trả về kết_quả;
};

hàm mật mã utf8 bytes(văn_bản, tên_hàm) {
    nếu (loai_cua(văn_bản) != "chuỗi") {
        ném tên_hàm + ": văn bản phải là chuỗi";
    };
    trả về mã hóa bảng mã(văn_bản, "UTF-8");
};

hàm ngẫu nhiên bảo mật(số byte) {
    // Entropy hệ điều hành là VM primitive boundary thực sự và được giữ lại.
    thử {
        số byte = thành số nguyên(số byte);
    } bắt lỗi (e) {
        ném "ngẫu nhiên bảo mật: số byte phải là số nguyên từ 1 đến 4096";
    };
    nếu (số byte < 1 || số byte > 4096) {
        ném "ngẫu nhiên bảo mật: số byte phải là số nguyên từ 1 đến 4096";
    };
    trả về mật mã hex(ngau_nhien_bao_mat_bytes_vm(số byte));
};

hàm băm sha256(văn bản) {
    bytes = mật mã utf8 bytes(văn bản, "băm sha256");
    trả về mật mã hex(mật mã sha256 bytes(bytes));
};

hàm hmac sha256(khóa, văn bản) {
    nếu (loai_cua(khóa) != "chuỗi") {
        ném "hmac sha256: khóa phải là chuỗi";
    };
    nếu (loai_cua(văn bản) != "chuỗi") {
        ném "hmac sha256: văn bản phải là chuỗi";
    };
    khóa_bytes = mã hóa bảng mã(khóa, "UTF-8");
    nếu (do_dai(khóa_bytes) > 64) {
        khóa_bytes = mật mã sha256 bytes(khóa_bytes);
    };
    lặp(i = do_dai(khóa_bytes); i < 64; i++) {
        them(khóa_bytes, 0);
    };

    trong = [];
    ngoài = [];
    lặp(i = 0; i < 64; i++) {
        them(trong, mật mã xor byte(khóa_bytes[i], 54));
        them(ngoài, mật mã xor byte(khóa_bytes[i], 92));
    };
    dữ_liệu = mã hóa bảng mã(văn bản, "UTF-8");
    lặp(i = 0; i < do_dai(dữ_liệu); i++) {
        them(trong, dữ_liệu[i]);
    };
    băm_trong = mật mã sha256 bytes(trong);
    lặp(i = 0; i < do_dai(băm_trong); i++) {
        them(ngoài, băm_trong[i]);
    };
    trả về mật mã hex(mật mã sha256 bytes(ngoài));
};
