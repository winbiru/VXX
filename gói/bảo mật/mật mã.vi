// Module: bảo mật.mật mã
//
// Contract 1.0:
// - Chuỗi đầu vào được băm theo đúng byte UTF-8.
// - SHA-256 và HMAC-SHA256 được triển khai bằng V++.
// - VM chỉ giữ entropy bảo mật của hệ điều hành/OpenSSL.
// - Digest và random bảo mật trả hex chữ thường.

nhập gói.lõi.chuyển kiểu.thành số nguyên;
nhập gói.lõi.chuyển kiểu.loại của;
nhập gói.lõi.toán học.cộng;
nhập gói.lõi.toán học.lũy thừa;
nhập gói.lõi.toán học.làm tròn xuống;
nhập gói.lõi.toán học.làm tròn;
nhập gói.lõi.bảng mã.mã hóa bảng mã;
nhập gói.lõi.nguồn ngẫu nhiên.*;

// Lớp sở hữu toàn bộ thuật toán của mô-đun; các hàm bên dưới chỉ giữ API cũ.
lớp công khai Bộ Mật Mã {
    hàm công khai khởi tạo() {};

    hàm công khai mật mã lũy thừa hai(n) {
        kết quả = 1;
        lặp(i = 0; i < n; i++) {
            kết quả = kết quả * 2;
        };
        trả về kết quả;
    };

    hàm công khai mật mã xor byte(a, b) {
        // Toán tử bit có cùng ABI i32 trong VM và AOT. Chỉ giữ tám bit
        // thấp như thuật toán từng bit, không chuyển phép băm về host.
        trả về (a ^ b) & 255;
    };

    hàm công khai mật mã và byte(a, b) {
        trả về (a & b) & 255;
    };

    hàm công khai mật mã xor từ máy(a, b) {
        trả về [
            mình.mật mã xor byte(a[0], b[0]),
            mình.mật mã xor byte(a[1], b[1]),
            mình.mật mã xor byte(a[2], b[2]),
            mình.mật mã xor byte(a[3], b[3])
        ];
    };

    hàm công khai mật mã xor ba từ máy(a, b, c) {
        trả về mình.mật mã xor từ máy(mình.mật mã xor từ máy(a, b), c);
    };

    hàm công khai mật mã và từ máy(a, b) {
        trả về [
            mình.mật mã và byte(a[0], b[0]),
            mình.mật mã và byte(a[1], b[1]),
            mình.mật mã và byte(a[2], b[2]),
            mình.mật mã và byte(a[3], b[3])
        ];
    };

    hàm công khai mật mã cộng từ máy(a, b) {
        kết quả = [0, 0, 0, 0];
        nhớ = 0;
        lặp(i = 3; i >= 0; i--) {
            tổng = a[i] + b[i] + nhớ;
            kết quả[i] = tổng % 256;
            nhớ = làm tròn xuống(tổng / 256);
        };
        trả về kết quả;
    };

    hàm công khai mật mã quay phải(từ máy, số bit) {
        dịch byte = làm tròn xuống(số bit / 8);
        dịch bit = số bit % 8;
        kết quả = [0, 0, 0, 0];
        lặp(i = 0; i < 4; i++) {
            nguồn = i - dịch byte;
            khi (nguồn < 0) {
                nguồn = nguồn + 4;
            };
            nguồn = nguồn % 4;
            nếu (dịch bit == 0) {
                kết quả[i] = từ máy[nguồn];
            } hoặc {
                trước = nguồn - 1;
                nếu (trước < 0) {
                    trước = trước + 4;
                };
                mẫu = mình.mật mã lũy thừa hai(dịch bit);
                kết quả[i] = làm tròn xuống(từ máy[nguồn] / mẫu) +
                             (từ máy[trước] % mẫu) * mình.mật mã lũy thừa hai(8 - dịch bit);
            };
        };
        trả về kết quả;
    };

    hàm công khai mật mã dịch phải(từ máy, số bit) {
        dịch byte = làm tròn xuống(số bit / 8);
        dịch bit = số bit % 8;
        kết quả = [0, 0, 0, 0];
        lặp(i = 0; i < 4; i++) {
            nguồn = i - dịch byte;
            nếu (nguồn >= 0) {
                nếu (dịch bit == 0) {
                    kết quả[i] = từ máy[nguồn];
                } hoặc {
                    mẫu = mình.mật mã lũy thừa hai(dịch bit);
                    giá trị = làm tròn xuống(từ máy[nguồn] / mẫu);
                    nếu (nguồn - 1 >= 0) {
                        giá trị = giá trị +
                                  (từ máy[nguồn - 1] % mẫu) * mình.mật mã lũy thừa hai(8 - dịch bit);
                    };
                    kết quả[i] = giá trị;
                };
            };
        };
        trả về kết quả;
    };

    hàm công khai mật mã lựa chọn(e, f, g) {
        // Ch(e,f,g) = g xor (e and (f xor g)).
        trả về mình.mật mã xor từ máy(g, mình.mật mã và từ máy(e, mình.mật mã xor từ máy(f, g)));
    };

    hàm công khai mật mã đa số(a, b, c) {
        trả về mình.mật mã xor ba từ máy(
            mình.mật mã và từ máy(a, b),
            mình.mật mã và từ máy(a, c),
            mình.mật mã và từ máy(b, c)
        );
    };

    hàm công khai mật mã sigma lớn không(a) {
        trả về mình.mật mã xor ba từ máy(
            mình.mật mã quay phải(a, 2),
            mình.mật mã quay phải(a, 13),
            mình.mật mã quay phải(a, 22)
        );
    };

    hàm công khai mật mã sigma lớn một(e) {
        trả về mình.mật mã xor ba từ máy(
            mình.mật mã quay phải(e, 6),
            mình.mật mã quay phải(e, 11),
            mình.mật mã quay phải(e, 25)
        );
    };

    hàm công khai mật mã sigma nhỏ không(x) {
        trả về mình.mật mã xor ba từ máy(
            mình.mật mã quay phải(x, 7),
            mình.mật mã quay phải(x, 18),
            mình.mật mã dịch phải(x, 3)
        );
    };

    hàm công khai mật mã sigma nhỏ một(x) {
        trả về mình.mật mã xor ba từ máy(
            mình.mật mã quay phải(x, 17),
            mình.mật mã quay phải(x, 19),
            mình.mật mã dịch phải(x, 10)
        );
    };

    hàm công khai mật mã hằng số sha256() {
        trả về [
            [66,138,47,152], [113,55,68,145], [181,192,251,207], [233,181,219,165],
            [57,86,194,91], [89,241,17,241], [146,63,130,164], [171,28,94,213],
            [216,7,170,152], [18,131,91,1], [36,49,133,190], [85,12,125,195],
            [114,190,93,116], [128,222,177,254], [155,220,6,167], [193,155,241,116],
            [228,155,105,193], [239,190,71,134], [15,193,157,198], [36,12,161,204],
            [45,233,44,111], [74,116,132,170], [92,176,169,220], [118,249,136,218],
            [152,62,81,82], [168,49,198,109], [176,3,39,200], [191,89,127,199],
            [198,224,11,243], [213,167,145,71], [6,202,99,81], [20,41,41,103],
            [39,183,10,133], [46,27,33,56], [77,44,109,252], [83,56,13,19],
            [101,10,115,84], [118,106,10,187], [129,194,201,46], [146,114,44,133],
            [162,191,232,161], [168,26,102,75], [194,75,139,112], [199,108,81,163],
            [209,146,232,25], [214,153,6,36], [244,14,53,133], [16,106,160,112],
            [25,164,193,22], [30,55,108,8], [39,72,119,76], [52,176,188,181],
            [57,28,12,179], [78,216,170,74], [91,156,202,79], [104,46,111,243],
            [116,143,130,238], [120,165,99,111], [132,200,120,20], [140,199,2,8],
            [144,190,255,250], [164,80,108,235], [190,249,163,247], [198,113,120,242]
        ];
    };

    hàm công khai mật mã độ dài bit các byte(số byte) {
        kết quả = [0, 0, 0, 0, 0, 0, 0, 0];
        còn lại = số byte;
        lặp(i = 7; i >= 0; i--) {
            kết quả[i] = còn lại % 256;
            còn lại = làm tròn xuống(còn lại / 256);
        };
        nhớ = 0;
        lặp(i = 7; i >= 0; i--) {
            giá trị = kết quả[i] * 8 + nhớ;
            kết quả[i] = giá trị % 256;
            nhớ = làm tròn xuống(giá trị / 256);
        };
        trả về kết quả;
    };

    hàm công khai mật mã sha256 các byte(các byte) {
        độ dài gốc = máy ảo lấy độ dài(các byte);
        lặp(i = 0; i < độ dài gốc; i++) {
            byte = các byte[i];
            // Guard the type before ordering comparisons; native logical
            // operators may evaluate both operands.
            nếu (loại của(byte) != "số nguyên") {
                ném "băm sha256: dữ liệu byte không hợp lệ";
            };
            nếu (byte < 0 || byte > 255) {
                ném "băm sha256: dữ liệu byte không hợp lệ";
            };
        };
        trả về mình.mật mã sha256 lõi(các byte);
    };

    // The runtime creates the byte list from a string; arbitrary callers
    // cannot supply an invalid element through this entrypoint.
    hàm công khai mật mã băm chuỗi máy ảo(văn bản) {
        nếu (loại của(văn bản) != "chuỗi") { ném "băm sha256: văn bản phải là chuỗi"; };
        trả về mình.mật mã thập lục phân(mình.mật mã sha256 lõi(chuỗi thành byte máy ảo(văn bản)));
    };

    hàm riêng tư mật mã sha256 lõi(các byte) {
        độ dài gốc = máy ảo lấy độ dài(các byte);
        // Full blocks are read directly from the caller's immutable input.
        // Only the final 64/128 padding bytes need a separate allocation.
        // Copying multi-megabyte assembly into a second boxed byte list made
        // concurrent compiler workers consume gigabytes for cache hashing.
        cuối khối đầy = độ dài gốc - độ dài gốc % 64;
        đuôi = [];
        lặp(i = cuối khối đầy; i < độ dài gốc; i++) {
            máy ảo thêm cuối danh sách(đuôi, các byte[i]);
        };
        máy ảo thêm cuối danh sách(đuôi, 128);
        khi (máy ảo lấy độ dài(đuôi) % 64 != 56) {
            máy ảo thêm cuối danh sách(đuôi, 0);
        };
        dài bit = mình.mật mã độ dài bit các byte(độ dài gốc);
        lặp(i = 0; i < 8; i++) {
            máy ảo thêm cuối danh sách(đuôi, dài bit[i]);
        };

        // SHA-256 word arithmetic uses wrapping i32 operators shared by VM
        // and AOT. Mask signed right shifts to obtain logical shifts. The
        // public byte API and digest stay identical; no native hash callback.
        h = [1779033703, -1150833019, 1013904242, -1521486534,
             1359893119, -1694144372, 528734635, 1541459225];
        byte k = mình.mật mã hằng số sha256();
        k = [];
        lặp(i = 0; i < 64; i++) {
            q = byte k[i];
            máy ảo thêm cuối danh sách(k, (q[0] << 24) | (q[1] << 16) | (q[2] << 8) | q[3]);
        };
        tổng byte = cuối khối đầy + máy ảo lấy độ dài(đuôi);
        // Reuse the fixed-size message schedule for every block. All 64
        // words are overwritten before use, including the padded blocks.
        w = [];
        lặp(t = 0; t < 64; t++) { máy ảo thêm cuối danh sách(w, 0); };
        lặp(bắt đầu = 0; bắt đầu < tổng byte; bắt đầu += 64) {
            thông điệp = các byte;
            vị trí khối = bắt đầu;
            nếu (bắt đầu >= cuối khối đầy) {
                thông điệp = đuôi;
                vị trí khối = bắt đầu - cuối khối đầy;
            };
            lặp(t = 0; t < 16; t++) {
                p = vị trí khối + t * 4;
                w[t] = (thông điệp[p] << 24) |
                    (thông điệp[p + 1] << 16) | (thông điệp[p + 2] << 8) | thông điệp[p + 3];
            };
            lặp(t = 16; t < 64; t++) {
                x = w[t - 15]; y = w[t - 2];
                s0 = (((x >> 7) & 33554431) | (x << 25)) ^
                     (((x >> 18) & 16383) | (x << 14)) ^ ((x >> 3) & 536870911);
                s1 = (((y >> 17) & 32767) | (y << 15)) ^
                     (((y >> 19) & 8191) | (y << 13)) ^ ((y >> 10) & 4194303);
                w[t] = w[t - 16] + s0 + w[t - 7] + s1;
            };
            a = h[0]; b = h[1]; c = h[2]; d = h[3];
            e = h[4]; f = h[5]; g = h[6]; hh = h[7];
            // Eight rounds restore the original register ordering. Rotate names
            // at compile time rather than copying all eight boxed values per round.
            lặp(t = 0; t < 64; t += 8) {
                // Round 1
                s1 = (((e >> 6) & 67108863) | (e << 26)) ^
                     (((e >> 11) & 2097151) | (e << 21)) ^
                     (((e >> 25) & 127) | (e << 7));
                lựa = g ^ (e & (f ^ g));
                t1 = hh + s1 + lựa + k[t] + w[t];
                s0 = (((a >> 2) & 1073741823) | (a << 30)) ^
                     (((a >> 13) & 524287) | (a << 19)) ^
                     (((a >> 22) & 1023) | (a << 10));
                đa số = (a & b) | (c & (a | b));
                d = d + t1; hh = s0 + đa số + t1;
                // Round 2
                s1 = (((d >> 6) & 67108863) | (d << 26)) ^
                     (((d >> 11) & 2097151) | (d << 21)) ^
                     (((d >> 25) & 127) | (d << 7));
                lựa = f ^ (d & (e ^ f));
                t1 = g + s1 + lựa + k[t + 1] + w[t + 1];
                s0 = (((hh >> 2) & 1073741823) | (hh << 30)) ^
                     (((hh >> 13) & 524287) | (hh << 19)) ^
                     (((hh >> 22) & 1023) | (hh << 10));
                đa số = (hh & a) | (b & (hh | a));
                c = c + t1; g = s0 + đa số + t1;
                // Round 3
                s1 = (((c >> 6) & 67108863) | (c << 26)) ^
                     (((c >> 11) & 2097151) | (c << 21)) ^
                     (((c >> 25) & 127) | (c << 7));
                lựa = e ^ (c & (d ^ e));
                t1 = f + s1 + lựa + k[t + 2] + w[t + 2];
                s0 = (((g >> 2) & 1073741823) | (g << 30)) ^
                     (((g >> 13) & 524287) | (g << 19)) ^
                     (((g >> 22) & 1023) | (g << 10));
                đa số = (g & hh) | (a & (g | hh));
                b = b + t1; f = s0 + đa số + t1;
                // Round 4
                s1 = (((b >> 6) & 67108863) | (b << 26)) ^
                     (((b >> 11) & 2097151) | (b << 21)) ^
                     (((b >> 25) & 127) | (b << 7));
                lựa = d ^ (b & (c ^ d));
                t1 = e + s1 + lựa + k[t + 3] + w[t + 3];
                s0 = (((f >> 2) & 1073741823) | (f << 30)) ^
                     (((f >> 13) & 524287) | (f << 19)) ^
                     (((f >> 22) & 1023) | (f << 10));
                đa số = (f & g) | (hh & (f | g));
                a = a + t1; e = s0 + đa số + t1;
                // Round 5
                s1 = (((a >> 6) & 67108863) | (a << 26)) ^
                     (((a >> 11) & 2097151) | (a << 21)) ^
                     (((a >> 25) & 127) | (a << 7));
                lựa = c ^ (a & (b ^ c));
                t1 = d + s1 + lựa + k[t + 4] + w[t + 4];
                s0 = (((e >> 2) & 1073741823) | (e << 30)) ^
                     (((e >> 13) & 524287) | (e << 19)) ^
                     (((e >> 22) & 1023) | (e << 10));
                đa số = (e & f) | (g & (e | f));
                hh = hh + t1; d = s0 + đa số + t1;
                // Round 6
                s1 = (((hh >> 6) & 67108863) | (hh << 26)) ^
                     (((hh >> 11) & 2097151) | (hh << 21)) ^
                     (((hh >> 25) & 127) | (hh << 7));
                lựa = b ^ (hh & (a ^ b));
                t1 = c + s1 + lựa + k[t + 5] + w[t + 5];
                s0 = (((d >> 2) & 1073741823) | (d << 30)) ^
                     (((d >> 13) & 524287) | (d << 19)) ^
                     (((d >> 22) & 1023) | (d << 10));
                đa số = (d & e) | (f & (d | e));
                g = g + t1; c = s0 + đa số + t1;
                // Round 7
                s1 = (((g >> 6) & 67108863) | (g << 26)) ^
                     (((g >> 11) & 2097151) | (g << 21)) ^
                     (((g >> 25) & 127) | (g << 7));
                lựa = a ^ (g & (hh ^ a));
                t1 = b + s1 + lựa + k[t + 6] + w[t + 6];
                s0 = (((c >> 2) & 1073741823) | (c << 30)) ^
                     (((c >> 13) & 524287) | (c << 19)) ^
                     (((c >> 22) & 1023) | (c << 10));
                đa số = (c & d) | (e & (c | d));
                f = f + t1; b = s0 + đa số + t1;
                // Round 8
                s1 = (((f >> 6) & 67108863) | (f << 26)) ^
                     (((f >> 11) & 2097151) | (f << 21)) ^
                     (((f >> 25) & 127) | (f << 7));
                lựa = hh ^ (f & (g ^ hh));
                t1 = a + s1 + lựa + k[t + 7] + w[t + 7];
                s0 = (((b >> 2) & 1073741823) | (b << 30)) ^
                     (((b >> 13) & 524287) | (b << 19)) ^
                     (((b >> 22) & 1023) | (b << 10));
                đa số = (b & c) | (d & (b | c));
                e = e + t1; a = s0 + đa số + t1;
            };
            h[0] = h[0] + a; h[1] = h[1] + b; h[2] = h[2] + c; h[3] = h[3] + d;
            h[4] = h[4] + e; h[5] = h[5] + f; h[6] = h[6] + g; h[7] = h[7] + hh;
        };
        kết quả = [];
        lặp(i = 0; i < 8; i++) {
            máy ảo thêm cuối danh sách(kết quả, (h[i] >> 24) & 255);
            máy ảo thêm cuối danh sách(kết quả, (h[i] >> 16) & 255);
            máy ảo thêm cuối danh sách(kết quả, (h[i] >> 8) & 255);
            máy ảo thêm cuối danh sách(kết quả, h[i] & 255);
        };
        trả về kết quả;
    };

    hàm công khai mật mã thập lục phân(các byte) {
        bảng chữ cái = "0123456789abcdef";
        kết quả = "";
        lặp(i = 0; i < máy ảo lấy độ dài(các byte); i++) {
            byte = các byte[i];
            kết quả = kết quả + bảng chữ cái[làm tròn xuống(byte / 16)] + bảng chữ cái[byte % 16];
        };
        trả về kết quả;
    };

    hàm công khai mật mã unicode tám bit các byte(văn bản, tên hàm) {
        nếu (loại của(văn bản) != "chuỗi") {
            ném tên hàm + ": văn bản phải là chuỗi";
        };
        trả về mã hóa bảng mã(văn bản, "UTF-8");
    };

    hàm công khai ngẫu nhiên bảo mật(số byte) {
        // POSIX lấy entropy bằng getentropy qua FFI, chia khối tại thư viện V++.
        thử {
            số byte = thành số nguyên(số byte);
        } bắt lỗi (e) {
            ném "ngẫu nhiên bảo mật: số byte phải là số nguyên từ 1 đến 4096";
        };
        nếu (số byte < 1 || số byte > 4096) {
            ném "ngẫu nhiên bảo mật: số byte phải là số nguyên từ 1 đến 4096";
        };
        trả về mình.mật mã thập lục phân(nguồn ngẫu nhiên bảo mật các byte(số byte));
    };

    hàm công khai băm sha256(văn bản) {
        các byte = mình.mật mã unicode tám bit các byte(văn bản, "băm sha256");
        trả về mình.mật mã thập lục phân(mình.mật mã sha256 các byte(các byte));
    };

    hàm công khai hmac sha256(khóa, văn bản) {
        nếu (loại của(khóa) != "chuỗi") {
            ném "hmac sha256: khóa phải là chuỗi";
        };
        nếu (loại của(văn bản) != "chuỗi") {
            ném "hmac sha256: văn bản phải là chuỗi";
        };
        khóa các byte = mã hóa bảng mã(khóa, "UTF-8");
        nếu (máy ảo lấy độ dài(khóa các byte) > 64) {
            khóa các byte = mình.mật mã sha256 các byte(khóa các byte);
        };
        lặp(i = máy ảo lấy độ dài(khóa các byte); i < 64; i++) {
            máy ảo thêm cuối danh sách(khóa các byte, 0);
        };

        trong = [];
        ngoài = [];
        lặp(i = 0; i < 64; i++) {
            máy ảo thêm cuối danh sách(trong, mình.mật mã xor byte(khóa các byte[i], 54));
            máy ảo thêm cuối danh sách(ngoài, mình.mật mã xor byte(khóa các byte[i], 92));
        };
        dữ liệu = mã hóa bảng mã(văn bản, "UTF-8");
        lặp(i = 0; i < máy ảo lấy độ dài(dữ liệu); i++) {
            máy ảo thêm cuối danh sách(trong, dữ liệu[i]);
        };
        băm trong = mình.mật mã sha256 các byte(trong);
        lặp(i = 0; i < máy ảo lấy độ dài(băm trong); i++) {
            máy ảo thêm cuối danh sách(ngoài, băm trong[i]);
        };
        trả về mình.mật mã thập lục phân(mình.mật mã sha256 các byte(ngoài));
    };
};


