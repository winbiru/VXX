// Module: bảo mật.mật mã
//
// Contract 1.0:
// - Chuỗi đầu vào được băm theo đúng byte UTF-8.
// - SHA-256 và HMAC-SHA256 được triển khai bằng V++.
// - VM chỉ giữ entropy bảo mật của hệ điều hành/OpenSSL.
// - Digest và random bảo mật trả hex chữ thường.

nhập gói/lõi/chuyển kiểu;
nhập gói/lõi/toán học;
nhập gói/lõi/bảng mã;

hàm mật mã lũy thừa hai(n) {
    kết_quả = 1;
    lặp(i = 0; i < n; i++) {
        kết_quả = kết_quả * 2;
    };
    trả về kết_quả;
};

hàm mật mã xor byte(a, b) {
    x = a;
    y = b;
    trọng_số = 1;
    kết_quả = 0;
    lặp(i = 0; i < 8; i++) {
        nếu ((x % 2) != (y % 2)) {
            kết_quả = kết_quả + trọng_số;
        };
        x = lam_tron_xuong(x / 2);
        y = lam_tron_xuong(y / 2);
        trọng_số = trọng_số * 2;
    };
    trả về kết_quả;
};

hàm mật mã và byte(a, b) {
    x = a;
    y = b;
    trọng_số = 1;
    kết_quả = 0;
    lặp(i = 0; i < 8; i++) {
        nếu ((x % 2) == 1 && (y % 2) == 1) {
            kết_quả = kết_quả + trọng_số;
        };
        x = lam_tron_xuong(x / 2);
        y = lam_tron_xuong(y / 2);
        trọng_số = trọng_số * 2;
    };
    trả về kết_quả;
};

hàm mật mã xor word(a, b) {
    trả về [
        mật mã xor byte(a[0], b[0]),
        mật mã xor byte(a[1], b[1]),
        mật mã xor byte(a[2], b[2]),
        mật mã xor byte(a[3], b[3])
    ];
};

hàm mật mã xor ba word(a, b, c) {
    trả về mật mã xor word(mật mã xor word(a, b), c);
};

hàm mật mã và word(a, b) {
    trả về [
        mật mã và byte(a[0], b[0]),
        mật mã và byte(a[1], b[1]),
        mật mã và byte(a[2], b[2]),
        mật mã và byte(a[3], b[3])
    ];
};

hàm mật mã cộng word(a, b) {
    kết_quả = [0, 0, 0, 0];
    nhớ = 0;
    lặp(i = 3; i >= 0; i--) {
        tổng = a[i] + b[i] + nhớ;
        kết_quả[i] = tổng % 256;
        nhớ = lam_tron_xuong(tổng / 256);
    };
    trả về kết_quả;
};

hàm mật mã quay phải(word, số_bit) {
    dịch_byte = lam_tron_xuong(số_bit / 8);
    dịch_bit = số_bit % 8;
    kết_quả = [0, 0, 0, 0];
    lặp(i = 0; i < 4; i++) {
        nguồn = i - dịch_byte;
        lặp(v = 0; nguồn < 0; v++) {
            nguồn = nguồn + 4;
        };
        nguồn = nguồn % 4;
        nếu (dịch_bit == 0) {
            kết_quả[i] = word[nguồn];
        } nếu không {
            trước = nguồn - 1;
            nếu (trước < 0) {
                trước = trước + 4;
            };
            mẫu = mật mã lũy thừa hai(dịch_bit);
            kết_quả[i] = lam_tron_xuong(word[nguồn] / mẫu) +
                         (word[trước] % mẫu) * mật mã lũy thừa hai(8 - dịch_bit);
        };
    };
    trả về kết_quả;
};

hàm mật mã dịch phải(word, số_bit) {
    dịch_byte = lam_tron_xuong(số_bit / 8);
    dịch_bit = số_bit % 8;
    kết_quả = [0, 0, 0, 0];
    lặp(i = 0; i < 4; i++) {
        nguồn = i - dịch_byte;
        nếu (nguồn >= 0) {
            nếu (dịch_bit == 0) {
                kết_quả[i] = word[nguồn];
            } nếu không {
                mẫu = mật mã lũy thừa hai(dịch_bit);
                giá_trị = lam_tron_xuong(word[nguồn] / mẫu);
                nếu (nguồn - 1 >= 0) {
                    giá_trị = giá_trị +
                              (word[nguồn - 1] % mẫu) * mật mã lũy thừa hai(8 - dịch_bit);
                };
                kết_quả[i] = giá_trị;
            };
        };
    };
    trả về kết_quả;
};

hàm mật mã lựa chọn(e, f, g) {
    // Ch(e,f,g) = g xor (e and (f xor g)).
    trả về mật mã xor word(g, mật mã và word(e, mật mã xor word(f, g)));
};

hàm mật mã đa số(a, b, c) {
    trả về mật mã xor ba word(
        mật mã và word(a, b),
        mật mã và word(a, c),
        mật mã và word(b, c)
    );
};

hàm mật mã sigma lớn không(a) {
    trả về mật mã xor ba word(
        mật mã quay phải(a, 2),
        mật mã quay phải(a, 13),
        mật mã quay phải(a, 22)
    );
};

hàm mật mã sigma lớn một(e) {
    trả về mật mã xor ba word(
        mật mã quay phải(e, 6),
        mật mã quay phải(e, 11),
        mật mã quay phải(e, 25)
    );
};

hàm mật mã sigma nhỏ không(x) {
    trả về mật mã xor ba word(
        mật mã quay phải(x, 7),
        mật mã quay phải(x, 18),
        mật mã dịch phải(x, 3)
    );
};

hàm mật mã sigma nhỏ một(x) {
    trả về mật mã xor ba word(
        mật mã quay phải(x, 17),
        mật mã quay phải(x, 19),
        mật mã dịch phải(x, 10)
    );
};

