

// Lớp sở hữu toàn bộ thuật toán của mô-đun; các hàm bên dưới chỉ giữ API cũ.
lớp công khai Bộ Nối Chuỗi {
    hàm công khai khởi tạo() {};

    // Module: lõi.bộ nối chuỗi
    // ABI hiện tại biểu diễn BộNốiChuỗi bằng map nội bộ để package chuẩn không
    // phụ thuộc class-lowering. Public semantics giữ encounter order.
    hàm công khai bộ nối chuỗi(phân cách, tiền tố = "", hậu tố = "", giá trị rỗng = rỗng) {
        nếu (loại của(phân cách) != "chuỗi") {
            ném "JOIN_ARGUMENT";
        };
        nếu (loại của(tiền tố) != "chuỗi") {
            ném "JOIN_ARGUMENT";
        };
        nếu (loại của(hậu tố) != "chuỗi") {
            ném "JOIN_ARGUMENT";
        };
        nếu (giá trị rỗng != rỗng && loại của(giá trị rỗng) != "chuỗi") {
            ném "JOIN_ARGUMENT";
        };
        trả về {
            "__vpp_string_joiner__": 1,
            "phân cách": phân cách,
            "tiền tố": tiền tố,
            "hậu tố": hậu tố,
            "giá trị rỗng": giá trị rỗng,
            "các phần": []
        };
    };

    hàm công khai bộ nối yêu cầu(bộ) {
        nếu (loại của(bộ) != "từ điển") {
            ném "JOIN_ARGUMENT";
        };
        nếu (lấy từ điển(bộ, "__vpp_string_joiner__", 0) != 1) {
            ném "JOIN_ARGUMENT";
        };
        các phần = lấy từ điển(bộ, "các phần", rỗng);
        nếu (loại của(các phần) != "danh sách") {
            ném "JOIN_ARGUMENT";
        };
        trả về các phần;
    };

    hàm công khai bộ nối thêm(bộ, giá trị) {
        các phần = mình.bộ nối yêu cầu(bộ);
        máy ảo thêm cuối danh sách(các phần, thành chuỗi(giá trị));
        trả về bộ;
    };

    hàm công khai bộ nối số phần(bộ) {
        các phần = mình.bộ nối yêu cầu(bộ);
        trả về máy ảo lấy độ dài(các phần);
    };

    hàm công khai bộ nối kết quả(bộ) {
        các phần = mình.bộ nối yêu cầu(bộ);

        phân cách = lấy từ điển(bộ, "phân cách", "");
        tiền tố = lấy từ điển(bộ, "tiền tố", "");
        hậu tố = lấy từ điển(bộ, "hậu tố", "");
        giá trị rỗng = lấy từ điển(bộ, "giá trị rỗng", rỗng);
        n = máy ảo lấy độ dài(các phần);
        nếu (n == 0) {
            nếu (giá trị rỗng != rỗng) {
                trả về giá trị rỗng;
            };
            trả về tiền tố + hậu tố;
        };

        kết quả = tiền tố;
        lặp(i = 0; i < n; i++) {
            nếu (i > 0) {
                kết quả = kết quả + phân cách;
            };
            kết quả = kết quả + các phần[i];
        };
        trả về kết quả + hậu tố;
    };

    // Tương đương StringJoiner.merge: nội dung nguồn được nối thành đúng một phần
    // theo delimiter của nguồn, không mang prefix/suffix và không dùng emptyValue.
    hàm công khai bộ nối gộp(đích, nguồn) {
        đích phần = mình.bộ nối yêu cầu(đích);
        nguồn phần = mình.bộ nối yêu cầu(nguồn);
        nếu (máy ảo lấy độ dài(nguồn phần) == 0) {
            trả về đích;
        };

        phân cách nguồn = lấy từ điển(nguồn, "phân cách", "");
        nội dung = "";
        lặp(i = 0; i < máy ảo lấy độ dài(nguồn phần); i++) {
            nếu (i > 0) {
                nội dung = nội dung + phân cách nguồn;
            };
            nội dung = nội dung + nguồn phần[i];
        };
        máy ảo thêm cuối danh sách(đích phần, nội dung);
        trả về đích;
    };

    // Độ dài observable của chuỗi kết quả theo Unicode code point.
    hàm công khai bộ nối độ dài(bộ) {
        trả về máy ảo lấy độ dài(mình.bộ nối kết quả(bộ));
    };
};


hàm công khai bộ nối chuỗi(phân cách, tiền tố = "", hậu tố = "", giá trị rỗng = rỗng) {
    bộ chuyển tiếp = Bộ Nối Chuỗi();
    trả về bộ chuyển tiếp.bộ nối chuỗi(phân cách, tiền tố, hậu tố, giá trị rỗng);
};

hàm công khai bộ nối yêu cầu(bộ) {
    bộ chuyển tiếp = Bộ Nối Chuỗi();
    trả về bộ chuyển tiếp.bộ nối yêu cầu(bộ);
};

hàm công khai bộ nối thêm(bộ, giá trị) {
    bộ chuyển tiếp = Bộ Nối Chuỗi();
    trả về bộ chuyển tiếp.bộ nối thêm(bộ, giá trị);
};

hàm công khai bộ nối số phần(bộ) {
    bộ chuyển tiếp = Bộ Nối Chuỗi();
    trả về bộ chuyển tiếp.bộ nối số phần(bộ);
};

hàm công khai bộ nối kết quả(bộ) {
    bộ chuyển tiếp = Bộ Nối Chuỗi();
    trả về bộ chuyển tiếp.bộ nối kết quả(bộ);
};

hàm công khai bộ nối gộp(đích, nguồn) {
    bộ chuyển tiếp = Bộ Nối Chuỗi();
    trả về bộ chuyển tiếp.bộ nối gộp(đích, nguồn);
};

hàm công khai bộ nối độ dài(bộ) {
    bộ chuyển tiếp = Bộ Nối Chuỗi();
    trả về bộ chuyển tiếp.bộ nối độ dài(bộ);
};
nhập gói/lõi/chuyển kiểu;
