    trả về bộ nội bộ.bộ quét bỏ biểu thức chính quy(s, mẫu);
};


hàm công khai đóng bộ quét(s) {
    bộ nội bộ = Máy Quét Nội Bộ();
    trả về bộ nội bộ.đóng bộ quét(s);
};

// Cursor và trạng thái đóng thuộc từng instance; xem không tiêu thụ token.
lớp công khai Bộ Quét triển khai Đóng Được {
    hàm công khai khởi tạo(nguồn, phân cách = rỗng, dùng biểu thức chính quy = sai, mức trần từ tố = 1048576) {
        nếu (dùng biểu thức chính quy) {
            mình.bộ = bộ quét biểu thức chính quy(nguồn, phân cách, mức trần từ tố);
        } hoặc {
            mình.bộ = bộ quét(nguồn, phân cách, mức trần từ tố);
        };
    };
    hàm công khai còn từ tố() { trả về có từ tố(mình.bộ); };
    hàm công khai đọc từ tố() { trả về từ tố(mình.bộ); };
    hàm công khai xem số nguyên(cơ số = 10) { trả về xem i32(mình.bộ, cơ số); };
    hàm công khai đọc số nguyên(cơ số = 10) { trả về i32(mình.bộ, cơ số); };
    hàm công khai xem số thực() { trả về xem f64(mình.bộ); };
    hàm công khai đọc số thực() { trả về f64(mình.bộ); };
    hàm công khai bỏ hằng văn bản(mẫu) { bộ quét bỏ hằng văn bản(mình.bộ, mẫu); trả về mình; };
    hàm công khai bỏ biểu thức chính quy(mẫu) { bộ quét bỏ biểu thức chính quy(mình.bộ, mẫu); trả về mình; };
    hàm công khai vị trí() {
        nếu (lấy từ điển(mình.bộ, "trạng thái", "") == "đóng") { ném "SCAN_CLOSED"; };
        trả về lấy từ điển(mình.bộ, "vị trí", 0);
    };
    hàm công khai đóng() {
        nếu (lấy từ điển(mình.bộ, "trạng thái", "") == "đóng") { trả về sai; };
        đóng bộ quét(mình.bộ);
        trả về đúng;
    };
};


hàm công khai tách từ tố(văn bản, phân cách = rỗng, giữ phân cách = sai) {
    bộ nội bộ = Máy Quét Nội Bộ();
    trả về bộ nội bộ.tách từ tố(văn bản, phân cách, giữ phân cách);
};


hàm công khai tách từ tố biểu thức chính quy(văn bản, mẫu phân cách, giữ phân cách = sai) {
    bộ nội bộ = Máy Quét Nội Bộ();
    trả về bộ nội bộ.tách từ tố biểu thức chính quy(văn bản, mẫu phân cách, giữ phân cách);
};
