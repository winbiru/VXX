    trả về bộ_nội_bộ.xem f64(s);
};


hàm công khai f64(s) {
    bộ_nội_bộ = Máy Quét Nội Bộ();
    trả về bộ_nội_bộ.f64(s);
};


hàm công khai scanner bỏ literal(s, mẫu) {
    bộ_nội_bộ = Máy Quét Nội Bộ();
    trả về bộ_nội_bộ.scanner bỏ literal(s, mẫu);
};


hàm công khai scanner bỏ regex(s, mẫu) {
    bộ_nội_bộ = Máy Quét Nội Bộ();
    trả về bộ_nội_bộ.scanner bỏ regex(s, mẫu);
};


hàm công khai đóng scanner(s) {
    bộ_nội_bộ = Máy Quét Nội Bộ();
    trả về bộ_nội_bộ.đóng scanner(s);
};

// Cursor và trạng thái đóng thuộc từng instance; xem không tiêu thụ token.
lớp công khai Bộ Quét triển khai Đóng Được {
    hàm công khai khởi tạo(nguồn, phân_cách = rỗng, dùng_regex = sai, giới_hạn_token = 1048576) {
        nếu (dùng_regex) {
            mình.bộ = scanner regex(nguồn, phân_cách, giới_hạn_token);
        } hoặc {
            mình.bộ = scanner(nguồn, phân_cách, giới_hạn_token);
        };
    };
    hàm công khai còn token() { trả về có token(mình.bộ); };
    hàm công khai đọc token() { trả về token(mình.bộ); };
    hàm công khai xem số nguyên(cơ_số = 10) { trả về xem i32(mình.bộ, cơ_số); };
    hàm công khai đọc số nguyên(cơ_số = 10) { trả về i32(mình.bộ, cơ_số); };
    hàm công khai xem số thực() { trả về xem f64(mình.bộ); };
    hàm công khai đọc số thực() { trả về f64(mình.bộ); };
    hàm công khai bỏ literal(mẫu) { scanner bỏ literal(mình.bộ, mẫu); trả về mình; };
    hàm công khai bỏ regex(mẫu) { scanner bỏ regex(mình.bộ, mẫu); trả về mình; };
    hàm công khai vị trí() {
        nếu (lấy map(mình.bộ, "trạng thái", "") == "đóng") { ném "SCAN_CLOSED"; };
        trả về lấy map(mình.bộ, "vị trí", 0);
    };
    hàm công khai đóng() {
        nếu (lấy map(mình.bộ, "trạng thái", "") == "đóng") { trả về sai; };
        đóng scanner(mình.bộ);
        trả về đúng;
    };
};


hàm công khai tách token(văn_bản, phân_cách = rỗng, giữ_phân_cách = sai) {
    bộ_nội_bộ = Máy Quét Nội Bộ();
    trả về bộ_nội_bộ.tách token(văn_bản, phân_cách, giữ_phân_cách);
};


hàm công khai tách token regex(văn_bản, mẫu_phân_cách, giữ_phân_cách = sai) {
    bộ_nội_bộ = Máy Quét Nội Bộ();
    trả về bộ_nội_bộ.tách token regex(văn_bản, mẫu_phân_cách, giữ_phân_cách);
};
