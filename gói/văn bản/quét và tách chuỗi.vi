// Module: lõi.quét và tách chuỗi
// Scanner/tokenizer thuần V++ trên nguồn chuỗi bất biến.
// Regex chỉ dùng engine primitive; cursor, delimiter policy và tokenization
// đều được điều phối ở lớp V++.

nhập gói/lõi/biểu thức chính quy;
nhập gói/lõi/giao diện tài nguyên;
nhập gói/bộ sưu tập/từ điển;
nhập gói/văn bản/chuỗi;
nhập gói/lõi/chuyển kiểu;


// Các thuật toán và trợ giúp nằm trong lớp nội bộ, không được xuất qua import.
lớp riêng tư Máy Quét Nội Bộ {
    hàm công khai khởi tạo() {};

    hàm riêng tư bộ quét yêu cầu hình dạng(s) {
        nếu (loại của(s) != "từ điển") {
            ném "SCAN_ARGUMENT";
        };
        nếu (lấy từ điển(s, "__vpp_scanner__", 0) != 1) {
            ném "SCAN_ARGUMENT";
        };
        trả về đúng;
    };

    hàm riêng tư bộ quét yêu cầu mở(s) {
        mình.bộ quét yêu cầu hình dạng(s);
        nếu (lấy từ điển(s, "trạng thái", "") == "đóng") {
            ném "SCAN_CLOSED";
        };
        trả về đúng;
    };

    hàm riêng tư bộ quét ký tự trắng(ký tự) {
        nếu (ký tự == " ") { trả về đúng; };
        nếu (ký tự == "\t") { trả về đúng; };
        nếu (ký tự == "\n") { trả về đúng; };
        nếu (ký tự == "\r") { trả về đúng; };
        trả về sai;
    };

    // `phân_cách = rỗng` nghĩa là bộ whitespace tương thích StringTokenizer.
    // Chuỗi phân cách khác được hiểu là tập ký tự, không phải regex.
    hàm riêng tư bộ quét là phân cách(phân cách, ký tự) {
        nếu (phân cách == rỗng) {
            trả về mình.bộ quét ký tự trắng(ký tự);
        };
        nếu (loại của(phân cách) != "chuỗi") {
            ném "SCAN_ARGUMENT";
        };

        tìm thấy = sai;
        lặp(i = 0; i < máy ảo lấy độ dài(phân cách) && !tìm thấy; i++) {
            nếu (cắt chuỗi(phân cách, i, 1) == ký tự) {
                tìm thấy = đúng;
            };
        };
        trả về tìm thấy;
    };

    hàm riêng tư bộ quét biểu thức chính quy dấu nhận diện(văn bản) {
        dấu nhận diện = "__VPP_SCAN_REGEX_MARKER__";
        lặp(vòng = 0; biểu thức chính quy tìm(văn bản, dấu nhận diện) != ""; vòng++) {
            dấu nhận diện = dấu nhận diện + "_";
        };
        trả về dấu nhận diện;
    };

    hàm riêng tư bộ quét biểu thức chính quy tại(nguồn, vị trí, mẫu) {
        nếu (loại của(mẫu) != "chuỗi" || mẫu == "") {
            ném "SCAN_ARGUMENT";
        };
        hậu tố = cắt chuỗi(nguồn, vị trí, máy ảo lấy độ dài(nguồn) - vị trí);
        dấu nhận diện = mình.bộ quét biểu thức chính quy dấu nhận diện(hậu tố);
        neo đầu = "^(?:" + mẫu + ")";
        thay = biểu thức chính quy thay(hậu tố, neo đầu, dấu nhận diện);
        nếu (thay == hậu tố) {
            trả về {"có": 0, "độ dài": 0};
        };
        đã khớp = máy ảo lấy độ dài(hậu tố) + máy ảo lấy độ dài(dấu nhận diện) - máy ảo lấy độ dài(thay);
        nếu (đã khớp < 0) {
            ném "SCAN_ARGUMENT";
        };
        trả về {"có": 1, "độ dài": đã khớp};
    };

    hàm riêng tư bộ quét phân cách tại(nguồn, vị trí, phân cách, kiểu) {
        nếu (vị trí >= máy ảo lấy độ dài(nguồn)) {
            trả về {"có": 0, "độ dài": 0};
        };
        nếu (kiểu == "regex") {
            trả về mình.bộ quét biểu thức chính quy tại(nguồn, vị trí, phân cách);
        };
        ký tự = cắt chuỗi(nguồn, vị trí, 1);
        nếu (mình.bộ quét là phân cách(phân cách, ký tự)) {
            trả về {"có": 1, "độ dài": 1};
        };
        trả về {"có": 0, "độ dài": 0};
    };

    hàm công khai bộ quét(nguồn, phân cách = rỗng, mức trần từ tố = 1048576) {
        nếu (loại của(nguồn) != "chuỗi") {
            ném "SCAN_ARGUMENT";
        };
        nếu (phân cách != rỗng) {
            nếu (loại của(phân cách) != "chuỗi") {
                ném "SCAN_ARGUMENT";
            };
        };
        nếu (loại của(mức trần từ tố) != "số nguyên") {
            ném "SCAN_ARGUMENT";
        };
        nếu (mức trần từ tố <= 0) {
            ném "SCAN_ARGUMENT";
        };

        trả về {
            "__vpp_scanner__": 1,
            "nguồn": nguồn,
            "phân cách": phân cách,
            "kiểu phân cách": "ký tự",
            "vị trí": 0,
            "giới hạn token": mức trần từ tố,
            "trạng thái": "mở"
        };
    };

    hàm công khai bộ quét biểu thức chính quy(nguồn, mẫu phân cách, mức trần từ tố = 1048576) {
        nếu (loại của(nguồn) != "chuỗi" || loại của(mẫu phân cách) != "chuỗi" ||
            mẫu phân cách == "") {
            ném "SCAN_ARGUMENT";
        };
        nếu (loại của(mức trần từ tố) != "số nguyên" || mức trần từ tố <= 0) {
            ném "SCAN_ARGUMENT";
        };
        nếu (biểu thức chính quy khớp("", mẫu phân cách)) {
            ném "SCAN_REGEX_ZERO_LENGTH";
        };
        biểu thức chính quy tìm("", mẫu phân cách);
        trả về {
            "__vpp_scanner__": 1,
            "nguồn": nguồn,
            "phân cách": mẫu phân cách,
            "kiểu phân cách": "regex",
            "vị trí": 0,
            "giới hạn token": mức trần từ tố,
            "trạng thái": "mở"
        };
    };

    // Trả snapshot token kế tiếp nhưng không thay đổi cursor.
    hàm riêng tư bộ quét tìm từ tố(s) {
        mình.bộ quét yêu cầu mở(s);
        nguồn = lấy từ điển(s, "nguồn", "");
        phân cách = lấy từ điển(s, "phân cách", rỗng);
        kiểu phân cách = lấy từ điển(s, "kiểu phân cách", "ký tự");
        vị trí = lấy từ điển(s, "vị trí", 0);
        mức trần = lấy từ điển(s, "giới hạn token", 1048576);
        n = máy ảo lấy độ dài(nguồn);

        // Không dùng điều kiện `i < n && cắt...`: runtime hiện chưa khóa
        // short-circuit cho mọi backend, nên truy cập chuỗi phải được bảo vệ riêng.
        đang bỏ phân cách = đúng;
        lặp(k = 0; đang bỏ phân cách; k++) {
            nếu (vị trí >= n) {
                đang bỏ phân cách = sai;
            } hoặc {
                khớp = mình.bộ quét phân cách tại(nguồn, vị trí, phân cách, kiểu phân cách);
                nếu (lấy từ điển(khớp, "có", 0) == 1) {
                    bước = lấy từ điển(khớp, "độ dài", 0);
                    nếu (bước <= 0) { ném "SCAN_REGEX_ZERO_LENGTH"; };
                    vị trí += bước;
                } hoặc {
                    đang bỏ phân cách = sai;
                };
            };
        };

        nếu (vị trí >= n) {
            trả về {"có": 0, "bắt đầu": n, "kết thúc": n, "giá trị": ""};
        };

        bắt đầu = vị trí;
        đang đọc = đúng;
        lặp(k = 0; đang đọc; k++) {
            nếu (vị trí >= n) {
                đang đọc = sai;
            } hoặc {
                khớp = mình.bộ quét phân cách tại(nguồn, vị trí, phân cách, kiểu phân cách);
                nếu (lấy từ điển(khớp, "có", 0) == 1) {
                    nếu (lấy từ điển(khớp, "độ dài", 0) <= 0) { ném "SCAN_REGEX_ZERO_LENGTH"; };
                    đang đọc = sai;
                } hoặc {
                    nếu (vị trí - bắt đầu >= mức trần) {
                        ném "SCAN_TOKEN_LIMIT";
                    };
                    vị trí += 1;
                };
            };
        };

        trả về {
            "có": 1,
            "bắt đầu": bắt đầu,
            "kết thúc": vị trí,
            "giá trị": cắt chuỗi(nguồn, bắt đầu, vị trí - bắt đầu)
        };
    };

    hàm công khai có từ tố(s) {
        thông tin = mình.bộ quét tìm từ tố(s);
        trả về lấy từ điển(thông tin, "có", 0) == 1;
    };

    hàm công khai từ tố(s) {
        thông tin = mình.bộ quét tìm từ tố(s);
        nếu (lấy từ điển(thông tin, "có", 0) != 1) {
            ném "SCAN_END";
        };
        đặt từ điển(s, "vị trí", lấy từ điển(thông tin, "kết thúc", 0));
        trả về lấy từ điển(thông tin, "giá trị", "");
    };

    hàm riêng tư bộ quét giá trị chữ số(ký tự) {
        chữ = chuỗi thường(ký tự);
        bảng = "0123456789abcdefghijklmnopqrstuvwxyz";
        kết quả = -1;
        lặp(i = 0; i < 36 && kết quả < 0; i++) {
            nếu (cắt chuỗi(bảng, i, 1) == chữ) {
                kết quả = i;
            };
        };
        trả về kết quả;
    };

    hàm riêng tư bộ quét yêu cầu cơ số(cơ số) {
        nếu (loại của(cơ số) != "số nguyên") {
            ném "SCAN_RADIX";
        };
        nếu (cơ số < 2 || cơ số > 36) {
            ném "SCAN_RADIX";
        };
        trả về cơ số;
    };

    // Parser i32 dùng tích lũy âm để chấp nhận chính xác -2147483648 mà không
    // tạo giá trị dương 2147483648 trung gian. Đây là miền integer ABI hiện tại.
    hàm riêng tư bộ quét phân tích i32(văn bản, cơ số) {
        cơ số = mình.bộ quét yêu cầu cơ số(cơ số);
        n = máy ảo lấy độ dài(văn bản);
        nếu (n == 0) {
            trả về {"hợp lệ": 0};
        };

        i = 0;
        âm = sai;
        đầu = cắt chuỗi(văn bản, 0, 1);
        nếu (đầu == "-" || đầu == "+") {
            nếu (đầu == "-") { âm = đúng; };
            i = 1;
        };
        nếu (i >= n) {
            trả về {"hợp lệ": 0};
        };

        mức trần = 0 - 2147483647;
        nếu (âm) {
            mức trần = 0 - 2147483647 - 1;
        };
        ngưỡng nhân = mức trần / cơ số;
        kết quả = 0;

        lặp(k = i; k < n; k++) {
            chữ số = mình.bộ quét giá trị chữ số(cắt chuỗi(văn bản, k, 1));
            nếu (chữ số < 0 || chữ số >= cơ số) {
                trả về {"hợp lệ": 0};
            };
            nếu (kết quả < ngưỡng nhân) {
                trả về {"hợp lệ": 0};
            };
            kết quả = kết quả * cơ số;
            nếu (kết quả < mức trần + chữ số) {
                trả về {"hợp lệ": 0};
            };
            kết quả = kết quả - chữ số;
        };

        nếu (âm) {
            trả về {"hợp lệ": 1, "giá trị": kết quả};
        };
        trả về {"hợp lệ": 1, "giá trị": 0 - kết quả};
    };

    // Tương đương hasNextInt: không consume; mismatch/EOF trả rỗng.
    hàm công khai xem i32(s, cơ số = 10) {
        mình.bộ quét yêu cầu cơ số(cơ số);
        thông tin = mình.bộ quét tìm từ tố(s);
        nếu (lấy từ điển(thông tin, "có", 0) != 1) {
            trả về rỗng;
        };
        phân tích = mình.bộ quét phân tích i32(lấy từ điển(thông tin, "giá trị", ""), cơ số);
        nếu (lấy từ điển(phân tích, "hợp lệ", 0) != 1) {
            trả về rỗng;
        };
        trả về lấy từ điển(phân tích, "giá trị", rỗng);
    };

    hàm công khai i32(s, cơ số = 10) {
        mình.bộ quét yêu cầu cơ số(cơ số);
        thông tin = mình.bộ quét tìm từ tố(s);
        nếu (lấy từ điển(thông tin, "có", 0) != 1) {
            ném "SCAN_END";
        };
        phân tích = mình.bộ quét phân tích i32(lấy từ điển(thông tin, "giá trị", ""), cơ số);
        nếu (lấy từ điển(phân tích, "hợp lệ", 0) != 1) {
            ném "SCAN_MISMATCH";
        };
        đặt từ điển(s, "vị trí", lấy từ điển(thông tin, "kết thúc", 0));
        trả về lấy từ điển(phân tích, "giá trị", 0);
    };

    // V1 cố ý giới hạn float token ở 64 code point và |exponent| <= 240 trước
    // khi gọi native conversion. Miền này tránh lỗi range không bắt được ở ABI
    // conversion hiện tại nhưng vẫn bao phủ dữ liệu cấu hình/CLI thông dụng.
    hàm riêng tư bộ quét f64 hợp lệ(văn bản) {
        n = máy ảo lấy độ dài(văn bản);
        nếu (n == 0 || n > 64) {
            trả về sai;
        };

        i = 0;
        đầu = cắt chuỗi(văn bản, 0, 1);
        nếu (đầu == "-" || đầu == "+") {
            i = 1;
        };
        nếu (i >= n) {
            trả về sai;
        };

        số chữ số = 0;
        đã chấm = sai;
        hết định trị = sai;
        lặp(k = 0; !hết định trị; k++) {
            nếu (i >= n) {
                hết định trị = đúng;
            } hoặc {
                c = cắt chuỗi(văn bản, i, 1);
                nếu (c == "e" || c == "E") {
                    hết định trị = đúng;
                } hoặc {
                    chữ số = mình.bộ quét giá trị chữ số(c);
                    nếu (chữ số >= 0 && chữ số <= 9) {
                        số chữ số += 1;
                        i += 1;
                    } hoặc {
                        nếu (c == "." && !đã chấm) {
                            đã chấm = đúng;
                            i += 1;
                        } hoặc {
                            trả về sai;
                        };
                    };
                };
            };
        };

        nếu (số chữ số == 0) {
            trả về sai;
        };
        nếu (i >= n) {
            trả về đúng;
        };

        e = cắt chuỗi(văn bản, i, 1);
        nếu (e != "e" && e != "E") {
            trả về sai;
        };
        i += 1;
        nếu (i >= n) {
            trả về sai;
        };

        dấu mũ = cắt chuỗi(văn bản, i, 1);
        nếu (dấu mũ == "+" || dấu mũ == "-") {
            i += 1;
        };
        nếu (i >= n) {
            trả về sai;
        };

        mũ = 0;
        số chữ số mũ = 0;
        lặp(k = i; k < n; k++) {
            chữ số = mình.bộ quét giá trị chữ số(cắt chuỗi(văn bản, k, 1));
            nếu (chữ số < 0 || chữ số > 9) {
                trả về sai;
            };
            số chữ số mũ += 1;
            mũ = mũ * 10 + chữ số;
            nếu (mũ > 240) {
                trả về sai;
            };
        };
        trả về số chữ số mũ > 0;
    };

    hàm công khai xem f64(s) {
        thông tin = mình.bộ quét tìm từ tố(s);
        nếu (lấy từ điển(thông tin, "có", 0) != 1) {
            trả về rỗng;
        };
        văn bản = lấy từ điển(thông tin, "giá trị", "");
        nếu (!mình.bộ quét f64 hợp lệ(văn bản)) {
            trả về rỗng;
        };
        trả về thành số thực(văn bản);
    };

    hàm công khai f64(s) {
        thông tin = mình.bộ quét tìm từ tố(s);
        nếu (lấy từ điển(thông tin, "có", 0) != 1) {
            ném "SCAN_END";
        };
        văn bản = lấy từ điển(thông tin, "giá trị", "");
        nếu (!mình.bộ quét f64 hợp lệ(văn bản)) {
            ném "SCAN_MISMATCH";
        };
        giá trị = thành số thực(văn bản);
        đặt từ điển(s, "vị trí", lấy từ điển(thông tin, "kết thúc", 0));
        trả về giá trị;
    };

    hàm công khai bộ quét bỏ hằng văn bản(s, mẫu) {
        mình.bộ quét yêu cầu mở(s);
        nếu (loại của(mẫu) != "chuỗi") {
            ném "SCAN_ARGUMENT";
        };
        nếu (máy ảo lấy độ dài(mẫu) == 0) {
            ném "SCAN_ARGUMENT";
        };

        nguồn = lấy từ điển(s, "nguồn", "");
        vị trí = lấy từ điển(s, "vị trí", 0);
        n = máy ảo lấy độ dài(nguồn);
        m = máy ảo lấy độ dài(mẫu);
        nếu (vị trí + m > n) {
            ném "SCAN_MISMATCH";
        };
        nếu (cắt chuỗi(nguồn, vị trí, m) != mẫu) {
            ném "SCAN_MISMATCH";
        };
        đặt từ điển(s, "vị trí", vị trí + m);
        trả về s;
    };

    hàm công khai bộ quét bỏ biểu thức chính quy(s, mẫu) {
        mình.bộ quét yêu cầu mở(s);
        nếu (loại của(mẫu) != "chuỗi" || mẫu == "") {
            ném "SCAN_ARGUMENT";
        };
        nguồn = lấy từ điển(s, "nguồn", "");
        vị trí = lấy từ điển(s, "vị trí", 0);
        khớp = mình.bộ quét biểu thức chính quy tại(nguồn, vị trí, mẫu);
        nếu (lấy từ điển(khớp, "có", 0) != 1) {
            ném "SCAN_MISMATCH";
        };
        đặt từ điển(s, "vị trí", vị trí + lấy từ điển(khớp, "độ dài", 0));
        trả về s;
    };

    hàm công khai đóng bộ quét(s) {
        mình.bộ quét yêu cầu hình dạng(s);
        đặt từ điển(s, "trạng thái", "đóng");
        trả về rỗng;
    };

    // StringTokenizer compatibility: delimiter là tập ký tự. Empty token giữa
    // hai delimiter liên tiếp bị bỏ; khi giữ_phân_cách=true mỗi delimiter là một token.
    hàm công khai tách từ tố(văn bản, phân cách = rỗng, giữ phân cách = sai) {
        nếu (loại của(văn bản) != "chuỗi") {
            ném "SCAN_ARGUMENT";
        };
        nếu (phân cách != rỗng) {
            nếu (loại của(phân cách) != "chuỗi") {
                ném "SCAN_ARGUMENT";
            };
        };

        kết quả = [];
        n = máy ảo lấy độ dài(văn bản);
        bắt đầu = 0;
        lặp(i = 0; i < n; i++) {
            c = cắt chuỗi(văn bản, i, 1);
            nếu (mình.bộ quét là phân cách(phân cách, c)) {
                nếu (i > bắt đầu) {
                    máy ảo thêm cuối danh sách(kết quả, cắt chuỗi(văn bản, bắt đầu, i - bắt đầu));
                };
                nếu (giữ phân cách) {
                    máy ảo thêm cuối danh sách(kết quả, c);
                };
                bắt đầu = i + 1;
            };
        };
        nếu (bắt đầu < n) {
            máy ảo thêm cuối danh sách(kết quả, cắt chuỗi(văn bản, bắt đầu, n - bắt đầu));
        };
        trả về kết quả;
    };

    hàm công khai tách từ tố biểu thức chính quy(văn bản, mẫu phân cách, giữ phân cách = sai) {
        nếu (loại của(văn bản) != "chuỗi" || loại của(mẫu phân cách) != "chuỗi" ||
            mẫu phân cách == "") {
            ném "SCAN_ARGUMENT";
        };

        kiểm tra = mình.bộ quét biểu thức chính quy(văn bản, mẫu phân cách);
        kết quả = [];
        n = máy ảo lấy độ dài(văn bản);
        bắt đầu = 0;
        vị trí = 0;
        lặp(vòng = 0; vị trí < n; vòng++) {
            khớp = mình.bộ quét biểu thức chính quy tại(văn bản, vị trí, mẫu phân cách);
            nếu (lấy từ điển(khớp, "có", 0) == 1) {
                bước = lấy từ điển(khớp, "độ dài", 0);
                nếu (bước <= 0) { ném "SCAN_REGEX_ZERO_LENGTH"; };
                nếu (vị trí > bắt đầu) {
                    máy ảo thêm cuối danh sách(kết quả, cắt chuỗi(văn bản, bắt đầu, vị trí - bắt đầu));
                };
                nếu (giữ phân cách) {
                    máy ảo thêm cuối danh sách(kết quả, cắt chuỗi(văn bản, vị trí, bước));
                };
                vị trí += bước;
                bắt đầu = vị trí;
            } hoặc {
                vị trí += 1;
            };
        };
        nếu (bắt đầu < n) {
            máy ảo thêm cuối danh sách(kết quả, cắt chuỗi(văn bản, bắt đầu, n - bắt đầu));
        };
        trả về kết quả;
    };
};


hàm công khai bộ quét(nguồn, phân cách = rỗng, mức trần từ tố = 1048576) {
    bộ nội bộ = Máy Quét Nội Bộ();
    trả về bộ nội bộ.bộ quét(nguồn, phân cách, mức trần từ tố);
};


hàm công khai bộ quét biểu thức chính quy(nguồn, mẫu phân cách, mức trần từ tố = 1048576) {
    bộ nội bộ = Máy Quét Nội Bộ();
    trả về bộ nội bộ.bộ quét biểu thức chính quy(nguồn, mẫu phân cách, mức trần từ tố);
};


hàm công khai có từ tố(s) {
    bộ nội bộ = Máy Quét Nội Bộ();
    trả về bộ nội bộ.có từ tố(s);
};


hàm công khai từ tố(s) {
    bộ nội bộ = Máy Quét Nội Bộ();
    trả về bộ nội bộ.từ tố(s);
};


