    bộ_nội_bộ = Máy Quét Nội Bộ();
    trả về bộ_nội_bộ.xem i32(s, cơ_số);
};


hàm công khai i32(s, cơ_số = 10) {
    bộ_nội_bộ = Máy Quét Nội Bộ();
    trả về bộ_nội_bộ.i32(s, cơ_số);
};


