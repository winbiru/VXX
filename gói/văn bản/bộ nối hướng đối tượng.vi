// Đối tượng nối chuỗi có trạng thái; dùng lại cùng logic với API hàm.
nhập gói/văn bản/bộ nối chuỗi;

lớp công khai Bộ Nối Văn Bản {
    hàm công khai khởi tạo(phân cách, tiền tố = "", hậu tố = "", giá trị rỗng = rỗng) {
        mình.bộ = bộ nối chuỗi(phân cách, tiền tố, hậu tố, giá trị rỗng);
    };

    hàm công khai thêm(giá trị) {
        bộ nối thêm(mình.bộ, giá trị);
        trả về mình;
    };

    hàm công khai số phần() { trả về bộ nối số phần(mình.bộ); };
    hàm công khai kết quả() { trả về bộ nối kết quả(mình.bộ); };
    hàm công khai độ dài() { trả về bộ nối độ dài(mình.bộ); };

    hàm công khai gộp(nguồn) {
        bộ nối gộp(mình.bộ, nguồn.bộ gốc());
        trả về mình;
    };

    // Bản sao dữ liệu; không để caller sửa trạng thái nội bộ.
    hàm công khai bộ gốc() {
        gốc dữ liệu = mình.bộ;
        bản sao = bộ nối chuỗi(lấy từ điển(gốc dữ liệu, "phân cách", ""),
            lấy từ điển(gốc dữ liệu, "tiền tố", ""), lấy từ điển(gốc dữ liệu, "hậu tố", ""),
            lấy từ điển(gốc dữ liệu, "giá trị rỗng", rỗng));
        các phần = bộ nối yêu cầu(gốc dữ liệu);
        lặp(i = 0; i < bộ nối số phần(gốc dữ liệu); i++) { bộ nối thêm(bản sao, các phần[i]); };
        trả về bản sao;
    };
};
