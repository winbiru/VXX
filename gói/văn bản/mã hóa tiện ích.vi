// Module: lõi.mã hóa tiện ích
// Bytes ở ABI V++ hiện tại được biểu diễn bằng list số nguyên 0..255.

hàm codec kiểm tra giới hạn(n) {
    // 16 MiB payload logical là trần v1 cho helper in-memory.
    nếu (n > 16777216) {
        ném "CODEC_RESOURCE_LIMIT";
    };
    trả về đúng;
};

hàm codec byte hợp lệ(x) {
    nếu (loại của(x) != "số nguyên") {
        trả về sai;
    };
    nếu (x < 0) {
        trả về sai;
    };
    trả về x <= 255;
};

hàm codec kiểm tra bytes(bytes) {
    kiểu = loại của(bytes);
    nếu (kiểu != "danh sách") {
        nếu (kiểu != "tuple") {
            ném "CODEC_INVALID";
        };
    };
    codec kiểm tra giới hạn(độ dài(bytes));
    lặp(i = 0; i < độ dài(bytes); i++) {
        nếu (!codec byte hợp lệ(bytes[i])) {
            ném "CODEC_INVALID";
        };
    };
    trả về đúng;
};

hàm codec yêu cầu chuỗi(văn_bản) {
    nếu (loại của(văn_bản) != "chuỗi") {
        ném "CODEC_INVALID";
    };
    trả về đúng;
};

hàm base64 alphabet(biến_thể) {
    nếu (biến_thể == "CHUẨN" || biến_thể == "MIME") {
        trả về "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
    };
    nếu (biến_thể == "URL_AN_TOÀN") {
        trả về "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";
    };
    ném "CODEC_INVALID";
};

hàm base64 chỉ số(alphabet, ký_tự) {
    vị_trí = -1;
    lặp(i = 0; i < độ dài(alphabet) && vị_trí < 0; i++) {
        nếu (alphabet[i] == ký_tự) {
            vị_trí = i;
        };
    };
    trả về vị_trí;
};

hàm base64 bọc mime(văn_bản) {
    nếu (độ dài(văn_bản) <= 76) {
        trả về văn_bản;
    };
    kết_quả = "";
    lặp(i = 0; i < độ dài(văn_bản); i += 76) {
        nếu (i > 0) {
            kết_quả = kết_quả + "\r\n";
        };
        kết_quả = kết_quả + cắt chuỗi(văn_bản, i, 76);
    };
    trả về kết_quả;
};

hàm base64 mã(bytes, biến_thể = "CHUẨN", padding = đúng) {
    codec kiểm tra bytes(bytes);
    alphabet = base64 alphabet(biến_thể);
    kết_quả = "";
    n = độ dài(bytes);

    lặp(i = 0; i < n; i += 3) {
        b0 = bytes[i];
        có_b1 = i + 1 < n;
        có_b2 = i + 2 < n;
        b1 = 0;
        b2 = 0;
        nếu (có_b1) {
            b1 = bytes[i + 1];
        };
        nếu (có_b2) {
            b2 = bytes[i + 2];
        };

        s0 = thành số nguyên(b0 / 4);
        s1 = (b0 % 4) * 16 + thành số nguyên(b1 / 16);
        s2 = (b1 % 16) * 4 + thành số nguyên(b2 / 64);
        s3 = b2 % 64;

        kết_quả = kết_quả + alphabet[s0] + alphabet[s1];
        nếu (có_b1) {
            kết_quả = kết_quả + alphabet[s2];
        } nếu không {
            nếu (padding) {
                kết_quả = kết_quả + "=";
            };
        };
        nếu (có_b2) {
            kết_quả = kết_quả + alphabet[s3];
        } nếu không {
            nếu (padding) {
                kết_quả = kết_quả + "=";
            };
        };
    };

    nếu (biến_thể == "MIME") {
        trả về base64 bọc mime(kết_quả);
    };
    trả về kết_quả;
};

hàm base64 là khoảng trắng(c) {
    trả về c == " " || c == "\t" || c == "\r" || c == "\n";
};

hàm base64 làm sạch(văn_bản, alphabet, biến_thể, bỏ_qua_khoảng_trắng) {
    sạch = "";
    lặp(i = 0; i < độ dài(văn_bản); i++) {
        c = văn_bản[i];
        hợp_lệ = c == "=" || base64 chỉ số(alphabet, c) >= 0;
        nếu (hợp_lệ) {
            sạch = sạch + c;
        } nếu không {
            nếu (biến_thể == "MIME") {
                // MIME decoder bỏ ký tự ngoài alphabet/padding.
            } nếu không {
                nếu (bỏ_qua_khoảng_trắng && base64 là khoảng trắng(c)) {
                    // Bỏ whitespace explicit.
                } nếu không {
                    ném "CODEC_INVALID";
                };
            };
        };
    };
    trả về sạch;
};

hàm base64 giải(văn_bản, biến_thể = "CHUẨN", bỏ_qua_khoảng_trắng = sai) {
    codec yêu cầu chuỗi(văn_bản);
    codec kiểm tra giới hạn(độ dài(văn_bản));
    alphabet = base64 alphabet(biến_thể);
    sạch = base64 làm sạch(văn_bản, alphabet, biến_thể, bỏ_qua_khoảng_trắng);
    n = độ dài(sạch);
    nếu (n == 0) {
        trả về [];
    };
    nếu (n % 4 == 1) {
        ném "CODEC_INVALID";
    };
    nếu (chứa chuỗi(sạch, "=")) {
        nếu (n % 4 != 0) {
            ném "CODEC_INVALID";
        };
    };

    kết_quả = [];
    nhóm = thành số nguyên((n + 3) / 4);
    lặp(g = 0; g < nhóm; g++) {
        p = g * 4;
        còn = n - p;
        nếu (còn < 2) {
            ném "CODEC_INVALID";
        };

        c0 = sạch[p];
        c1 = sạch[p + 1];
        c2 = "=";
        c3 = "=";
        nếu (còn >= 3) {
            c2 = sạch[p + 2];
        };
        nếu (còn >= 4) {
            c3 = sạch[p + 3];
        };

        nếu (c0 == "=" || c1 == "=") {
            ném "CODEC_INVALID";
        };
        nếu (c2 == "=" && c3 != "=") {
            ném "CODEC_INVALID";
        };
        nếu ((c2 == "=" || c3 == "=") && g + 1 < nhóm) {
            ném "CODEC_INVALID";
        };

        s0 = base64 chỉ số(alphabet, c0);
        s1 = base64 chỉ số(alphabet, c1);
        nếu (s0 < 0 || s1 < 0) {
            ném "CODEC_INVALID";
        };

        thêm(kết_quả, s0 * 4 + thành số nguyên(s1 / 16));

        nếu (c2 == "=") {
            nếu (s1 % 16 != 0) {
                ném "CODEC_INVALID";
            };
        } nếu không {
            s2 = base64 chỉ số(alphabet, c2);
            nếu (s2 < 0) {
                ném "CODEC_INVALID";
            };
            thêm(kết_quả, (s1 % 16) * 16 + thành số nguyên(s2 / 4));

            nếu (c3 == "=") {
                nếu (s2 % 4 != 0) {
                    ném "CODEC_INVALID";
                };
            } nếu không {
                s3 = base64 chỉ số(alphabet, c3);
                nếu (s3 < 0) {
                    ném "CODEC_INVALID";
                };
                thêm(kết_quả, (s2 % 4) * 64 + s3);
            };
        };
    };
    trả về kết_quả;
};

hàm hex chỉ số(c) {
    chữ = chuỗi thường(c);
    alphabet = "0123456789abcdef";
    vị_trí = -1;
    lặp(i = 0; i < 16 && vị_trí < 0; i++) {
        nếu (alphabet[i] == chữ) {
            vị_trí = i;
        };
    };
    trả về vị_trí;
};

hàm hex mã(bytes, hoa = sai, phân_cách = "") {
    codec kiểm tra bytes(bytes);
    alphabet = "0123456789abcdef";
    nếu (hoa) {
        alphabet = "0123456789ABCDEF";
    };
    kết_quả = "";
    lặp(i = 0; i < độ dài(bytes); i++) {
        nếu (i > 0) {
            kết_quả = kết_quả + phân_cách;
        };
        byte = bytes[i];
        cao = thành số nguyên(byte / 16);
        thấp = byte % 16;
        kết_quả = kết_quả + alphabet[cao] + alphabet[thấp];
    };
    trả về kết_quả;
};

hàm hex giải(văn_bản, phân_cách = "") {
    codec yêu cầu chuỗi(văn_bản);
    codec yêu cầu chuỗi(phân_cách);
    codec kiểm tra giới hạn(độ dài(văn_bản));
    n = độ dài(văn_bản);
    nếu (n == 0) {
        trả về [];
    };
    sep_len = độ dài(phân_cách);
    nếu (sep_len == 0) {
        nếu (n % 2 != 0) {
            ném "CODEC_INVALID";
        };
        số_byte = thành số nguyên(n / 2);
    } nếu không {
        tử = n + sep_len;
        mẫu = 2 + sep_len;
        nếu (tử % mẫu != 0) {
            ném "CODEC_INVALID";
        };
        số_byte = thành số nguyên(tử / mẫu);
    };

    kết_quả = [];
    lặp(i = 0; i < số_byte; i++) {
        vị_trí = i * (2 + sep_len);
        nếu (i > 0 && sep_len > 0) {
            sep_pos = vị_trí - sep_len;
            nếu (cắt chuỗi(văn_bản, sep_pos, sep_len) != phân_cách) {
                ném "CODEC_INVALID";
            };
        };
        cao = hex chỉ số(văn_bản[vị_trí]);
        thấp = hex chỉ số(văn_bản[vị_trí + 1]);
        nếu (cao < 0 || thấp < 0) {
            ném "CODEC_INVALID";
        };
        thêm(kết_quả, cao * 16 + thấp);
    };
    trả về kết_quả;
};

hàm uuid nibble biến thể(c) {
    c = chuỗi thường(c);
    nếu (c == "0" || c == "4" || c == "8" || c == "c") {
        trả về "8";
    };
    nếu (c == "1" || c == "5" || c == "9" || c == "d") {
        trả về "9";
    };
    nếu (c == "2" || c == "6" || c == "a" || c == "e") {
        trả về "a";
    };
    trả về "b";
};

hàm uuid ngẫu nhiên() {
    raw = ngẫu nhiên bảo mật(16);
    trả về cắt chuỗi(raw, 0, 8)
        + "-"
        + cắt chuỗi(raw, 8, 4)
        + "-4"
        + cắt chuỗi(raw, 13, 3)
        + "-"
        + uuid nibble biến thể(raw[16])
        + cắt chuỗi(raw, 17, 3)
        + "-"
        + cắt chuỗi(raw, 20, 12);
};

hàm uuid parse(văn_bản) {
    nếu (loại của(văn_bản) != "chuỗi") {
        ném "UUID_INVALID";
    };
    nếu (độ dài(văn_bản) != 36) {
        ném "UUID_INVALID";
    };
    lặp(i = 0; i < 36; i++) {
        c = văn_bản[i];
        là_gạch = i == 8 || i == 13 || i == 18 || i == 23;
        nếu (là_gạch) {
            nếu (c != "-") {
                ném "UUID_INVALID";
            };
        } nếu không {
            nếu (hex chỉ số(c) < 0) {
                ném "UUID_INVALID";
            };
        };
    };
    trả về chuỗi thường(văn_bản);
};

hàm uuid text(id) {
    trả về uuid parse(id);
};

hàm tập bit() {
    trả về {"__vpp_bitset__": 1, "bits": []};
};

hàm bit yêu cầu tập(tập) {
    nếu (loại của(tập) != "từ điển") {
        ném "BITSET_INDEX";
    };
    nếu (lấy map(tập, "__vpp_bitset__", 0) != 1) {
        ném "BITSET_INDEX";
    };
    trả về lấy map(tập, "bits", []);
};

hàm bit yêu cầu chỉ số(index) {
    nếu (loại của(index) != "số nguyên") {
        ném "BITSET_INDEX";
    };
    nếu (index < 0) {
        ném "BITSET_INDEX";
    };
    nếu (index > 1000000000) {
        ném "BITSET_RESOURCE_LIMIT";
    };
    trả về index;
};

hàm bit đặt(tập, index) {
    bit yêu cầu chỉ số(index);
    bits = bit yêu cầu tập(tập);
    nếu (tìm chỉ số(bits, index) < 0) {
        nếu (độ dài(bits) >= 1000000) {
            ném "BITSET_RESOURCE_LIMIT";
        };
        thêm(bits, index);
        sắp xếp(bits);
    };
    trả về tập;
};

hàm bit xóa(tập, index) {
    bit yêu cầu chỉ số(index);
    bits = bit yêu cầu tập(tập);
    vị_trí = tìm chỉ số(bits, index);
    nếu (vị_trí >= 0) {
        xóa tại(bits, vị_trí);
    };
    trả về tập;
};

hàm bit lật(tập, index) {
    nếu (bit có(tập, index)) {
        trả về bit xóa(tập, index);
    };
    trả về bit đặt(tập, index);
};

hàm bit có(tập, index) {
    bit yêu cầu chỉ số(index);
    bits = bit yêu cầu tập(tập);
    trả về tìm chỉ số(bits, index) >= 0;
};

hàm bit tiếp đặt(tập, từ_index) {
    bit yêu cầu chỉ số(từ_index);
    bits = bit yêu cầu tập(tập);
    kết_quả = -1;
    lặp(i = 0; i < độ dài(bits) && kết_quả < 0; i++) {
        nếu (bits[i] >= từ_index) {
            kết_quả = bits[i];
        };
    };
    trả về kết_quả;
};

hàm bit độ dài(tập) {
    bits = bit yêu cầu tập(tập);
    n = độ dài(bits);
    nếu (n == 0) {
        trả về 0;
    };
    trả về bits[n - 1] + 1;
};

hàm bit số bit(tập) {
    trả về độ dài(bit yêu cầu tập(tập));
};

hàm bit bằng(a, b) {
    bits_a = bit yêu cầu tập(a);
    bits_b = bit yêu cầu tập(b);
    nếu (độ dài(bits_a) != độ dài(bits_b)) {
        trả về sai;
    };
    lặp(i = 0; i < độ dài(bits_a); i++) {
        nếu (bits_a[i] != bits_b[i]) {
            trả về sai;
        };
    };
    trả về đúng;
};

hàm bit sao chép(tập) {
    nguồn = bit yêu cầu tập(tập);
    kết_quả = tập bit();
    lặp(i = 0; i < độ dài(nguồn); i++) {
        bit đặt(kết_quả, nguồn[i]);
    };
    trả về kết_quả;
};

hàm bit và(a, b) {
    kết_quả = tập bit();
    bits_a = bit yêu cầu tập(a);
    lặp(i = 0; i < độ dài(bits_a); i++) {
        nếu (bit có(b, bits_a[i])) {
            bit đặt(kết_quả, bits_a[i]);
        };
    };
    trả về kết_quả;
};

hàm bit hoặc(a, b) {
    kết_quả = tập bit();
    bits_a = bit yêu cầu tập(a);
    bits_b = bit yêu cầu tập(b);
    lặp(i = 0; i < độ dài(bits_a); i++) {
        bit đặt(kết_quả, bits_a[i]);
    };
    lặp(i = 0; i < độ dài(bits_b); i++) {
        bit đặt(kết_quả, bits_b[i]);
    };
    trả về kết_quả;
};

hàm bit xor(a, b) {
    kết_quả = tập bit();
    tất_cả = bit hoặc(a, b);
    bits = bit yêu cầu tập(tất_cả);
    lặp(i = 0; i < độ dài(bits); i++) {
        index = bits[i];
        nếu (bit có(a, index) != bit có(b, index)) {
            bit đặt(kết_quả, index);
        };
    };
    trả về kết_quả;
};
nhập gói/lõi/chuyển kiểu;
