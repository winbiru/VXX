

// Lớp sở hữu toàn bộ thuật toán của mô-đun; các hàm bên dưới chỉ giữ API cũ.
lớp công khai Bộ Mã Hóa Tiện Ích {
    hàm công khai khởi tạo() {};

    // Module: lõi.mã hóa tiện ích
    // Bytes ở ABI V++ hiện tại được biểu diễn bằng list số nguyên 0..255.
    hàm riêng tư bộ mã hóa kiểm tra giới hạn(n) {
        // 16 MiB payload logical là trần v1 cho helper in-memory.
        nếu (n > 16777216) {
            ném "CODEC_RESOURCE_LIMIT";
        };
        trả về đúng;
    };

    hàm riêng tư bộ mã hóa byte hợp lệ(x) {
        nếu (loại của(x) != "số nguyên") {
            trả về sai;
        };
        nếu (x < 0) {
            trả về sai;
        };
        trả về x <= 255;
    };

    hàm riêng tư bộ mã hóa kiểm tra các byte(các byte) {
        kiểu = loại của(các byte);
        nếu (kiểu != "danh sách") {
            nếu (kiểu != "tuple") {
                ném "CODEC_INVALID";
            };
        };
        mình.bộ mã hóa kiểm tra giới hạn(máy ảo lấy độ dài(các byte));
        lặp(i = 0; i < máy ảo lấy độ dài(các byte); i++) {
            nếu (!mình.bộ mã hóa byte hợp lệ(các byte[i])) {
                ném "CODEC_INVALID";
            };
        };
        trả về đúng;
    };

    hàm riêng tư bộ mã hóa yêu cầu chuỗi(văn bản) {
        nếu (loại của(văn bản) != "chuỗi") {
            ném "CODEC_INVALID";
        };
        trả về đúng;
    };

    hàm riêng tư base64 bảng chữ cái(dạng biến thể) {
        nếu (dạng biến thể == "CHUẨN" || dạng biến thể == "MIME") {
            trả về "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
        };
        nếu (dạng biến thể == "URL_AN_TOÀN") {
            trả về "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";
        };
        ném "CODEC_INVALID";
    };

    hàm riêng tư base64 chỉ số(bảng chữ cái, ký tự) {
        vị trí = -1;
        lặp(i = 0; i < máy ảo lấy độ dài(bảng chữ cái) && vị trí < 0; i++) {
            nếu (bảng chữ cái[i] == ký tự) {
                vị trí = i;
            };
        };
        trả về vị trí;
    };

    hàm riêng tư base64 bọc mime(văn bản) {
        nếu (máy ảo lấy độ dài(văn bản) <= 76) {
            trả về văn bản;
        };
        kết quả = "";
        lặp(i = 0; i < máy ảo lấy độ dài(văn bản); i += 76) {
            nếu (i > 0) {
                kết quả = kết quả + "\r\n";
            };
            kết quả = kết quả + cắt chuỗi(văn bản, i, 76);
        };
        trả về kết quả;
    };

    hàm công khai base64 mã(các byte, dạng biến thể = "CHUẨN", phần đệm = đúng) {
        mình.bộ mã hóa kiểm tra các byte(các byte);
        bảng chữ cái = mình.base64 bảng chữ cái(dạng biến thể);
        kết quả = "";
        n = máy ảo lấy độ dài(các byte);

        lặp(i = 0; i < n; i += 3) {
            b0 = các byte[i];
            có b1 = i + 1 < n;
            có b2 = i + 2 < n;
            b1 = 0;
            b2 = 0;
            nếu (có b1) {
                b1 = các byte[i + 1];
            };
            nếu (có b2) {
                b2 = các byte[i + 2];
            };

            s0 = thành số nguyên(b0 / 4);
            s1 = (b0 % 4) * 16 + thành số nguyên(b1 / 16);
            s2 = (b1 % 16) * 4 + thành số nguyên(b2 / 64);
            s3 = b2 % 64;

            kết quả = kết quả + bảng chữ cái[s0] + bảng chữ cái[s1];
            nếu (có b1) {
                kết quả = kết quả + bảng chữ cái[s2];
            } hoặc {
                nếu (phần đệm) {
                    kết quả = kết quả + "=";
                };
            };
            nếu (có b2) {
                kết quả = kết quả + bảng chữ cái[s3];
            } hoặc {
                nếu (phần đệm) {
                    kết quả = kết quả + "=";
                };
            };
        };

        nếu (dạng biến thể == "MIME") {
            trả về mình.base64 bọc mime(kết quả);
        };
        trả về kết quả;
    };

    hàm riêng tư base64 là khoảng trắng(c) {
        trả về c == " " || c == "\t" || c == "\r" || c == "\n";
    };

    hàm riêng tư base64 làm sạch(văn bản, bảng chữ cái, dạng biến thể, số mục bỏ qua khoảng trắng) {
        sạch = "";
        lặp(i = 0; i < máy ảo lấy độ dài(văn bản); i++) {
            c = văn bản[i];
            hợp lệ = c == "=" || mình.base64 chỉ số(bảng chữ cái, c) >= 0;
            nếu (hợp lệ) {
                sạch = sạch + c;
            } hoặc {
                nếu (dạng biến thể == "MIME") {
                    // MIME decoder bỏ ký tự ngoài alphabet/padding.
                } hoặc {
                    nếu (số mục bỏ qua khoảng trắng && mình.base64 là khoảng trắng(c)) {
                        // Bỏ whitespace explicit.
                    } hoặc {
                        ném "CODEC_INVALID";
                    };
                };
            };
        };
        trả về sạch;
    };

    hàm công khai base64 giải(văn bản, dạng biến thể = "CHUẨN", số mục bỏ qua khoảng trắng = sai) {
        mình.bộ mã hóa yêu cầu chuỗi(văn bản);
        mình.bộ mã hóa kiểm tra giới hạn(máy ảo lấy độ dài(văn bản));
        bảng chữ cái = mình.base64 bảng chữ cái(dạng biến thể);
        sạch = mình.base64 làm sạch(văn bản, bảng chữ cái, dạng biến thể, số mục bỏ qua khoảng trắng);
        n = máy ảo lấy độ dài(sạch);
        nếu (n == 0) {
            trả về [];
        };
        nếu (n % 4 == 1) {
            ném "CODEC_INVALID";
        };
        nếu (chứa chuỗi(sạch, "=")) {
            nếu (n % 4 != 0) {
                ném "CODEC_INVALID";
            };
        };

        kết quả = [];
        nhóm = thành số nguyên((n + 3) / 4);
        lặp(g = 0; g < nhóm; g++) {
            p = g * 4;
            còn = n - p;
            nếu (còn < 2) {
                ném "CODEC_INVALID";
            };

            c0 = sạch[p];
            c1 = sạch[p + 1];
            c2 = "=";
            c3 = "=";
            nếu (còn >= 3) {
                c2 = sạch[p + 2];
            };
            nếu (còn >= 4) {
                c3 = sạch[p + 3];
            };

            nếu (c0 == "=" || c1 == "=") {
                ném "CODEC_INVALID";
            };
            nếu (c2 == "=" && c3 != "=") {
                ném "CODEC_INVALID";
            };
            nếu ((c2 == "=" || c3 == "=") && g + 1 < nhóm) {
                ném "CODEC_INVALID";
            };

            s0 = mình.base64 chỉ số(bảng chữ cái, c0);
            s1 = mình.base64 chỉ số(bảng chữ cái, c1);
            nếu (s0 < 0 || s1 < 0) {
                ném "CODEC_INVALID";
            };

            máy ảo thêm cuối danh sách(kết quả, s0 * 4 + thành số nguyên(s1 / 16));

            nếu (c2 == "=") {
                nếu (s1 % 16 != 0) {
                    ném "CODEC_INVALID";
                };
            } hoặc {
                s2 = mình.base64 chỉ số(bảng chữ cái, c2);
                nếu (s2 < 0) {
                    ném "CODEC_INVALID";
                };
                máy ảo thêm cuối danh sách(kết quả, (s1 % 16) * 16 + thành số nguyên(s2 / 4));

                nếu (c3 == "=") {
                    nếu (s2 % 4 != 0) {
                        ném "CODEC_INVALID";
                    };
                } hoặc {
                    s3 = mình.base64 chỉ số(bảng chữ cái, c3);
                    nếu (s3 < 0) {
                        ném "CODEC_INVALID";
                    };
                    máy ảo thêm cuối danh sách(kết quả, (s2 % 4) * 64 + s3);
                };
            };
        };
        trả về kết quả;
    };

    hàm riêng tư thập lục phân chỉ số(c) {
        chữ = chuỗi thường(c);
        bảng chữ cái = "0123456789abcdef";
        vị trí = -1;
        lặp(i = 0; i < 16 && vị trí < 0; i++) {
            nếu (bảng chữ cái[i] == chữ) {
                vị trí = i;
            };
        };
        trả về vị trí;
    };

    hàm công khai thập lục phân mã(các byte, hoa = sai, phân cách = "") {
        mình.bộ mã hóa kiểm tra các byte(các byte);
        bảng chữ cái = "0123456789abcdef";
        nếu (hoa) {
            bảng chữ cái = "0123456789ABCDEF";
        };
        kết quả = "";
        lặp(i = 0; i < máy ảo lấy độ dài(các byte); i++) {
            nếu (i > 0) {
                kết quả = kết quả + phân cách;
            };
            byte = các byte[i];
            cao = thành số nguyên(byte / 16);
            thấp = byte % 16;
            kết quả = kết quả + bảng chữ cái[cao] + bảng chữ cái[thấp];
        };
        trả về kết quả;
    };

    hàm công khai thập lục phân giải(văn bản, phân cách = "") {
        mình.bộ mã hóa yêu cầu chuỗi(văn bản);
        mình.bộ mã hóa yêu cầu chuỗi(phân cách);
        mình.bộ mã hóa kiểm tra giới hạn(máy ảo lấy độ dài(văn bản));
        n = máy ảo lấy độ dài(văn bản);
        nếu (n == 0) {
            trả về [];
        };
        sep số ký tự = máy ảo lấy độ dài(phân cách);
        nếu (sep số ký tự == 0) {
            nếu (n % 2 != 0) {
                ném "CODEC_INVALID";
            };
            số byte = thành số nguyên(n / 2);
        } hoặc {
            tử = n + sep số ký tự;
            mẫu = 2 + sep số ký tự;
            nếu (tử % mẫu != 0) {
                ném "CODEC_INVALID";
            };
            số byte = thành số nguyên(tử / mẫu);
        };

        kết quả = [];
        lặp(i = 0; i < số byte; i++) {
            vị trí = i * (2 + sep số ký tự);
            nếu (i > 0 && sep số ký tự > 0) {
                sep vị trí hiện tại = vị trí - sep số ký tự;
                nếu (cắt chuỗi(văn bản, sep vị trí hiện tại, sep số ký tự) != phân cách) {
                    ném "CODEC_INVALID";
                };
            };
            cao = mình.thập lục phân chỉ số(văn bản[vị trí]);
            thấp = mình.thập lục phân chỉ số(văn bản[vị trí + 1]);
            nếu (cao < 0 || thấp < 0) {
                ném "CODEC_INVALID";
            };
            máy ảo thêm cuối danh sách(kết quả, cao * 16 + thấp);
        };
        trả về kết quả;
    };

    hàm riêng tư uuid nửa byte biến thể(c) {
        c = chuỗi thường(c);
        nếu (c == "0" || c == "4" || c == "8" || c == "c") {
            trả về "8";
        };
        nếu (c == "1" || c == "5" || c == "9" || c == "d") {
            trả về "9";
        };
        nếu (c == "2" || c == "6" || c == "a" || c == "e") {
            trả về "a";
        };
        trả về "b";
    };

    hàm công khai uuid ngẫu nhiên() {
        thô = ngẫu nhiên bảo mật(16);
        trả về cắt chuỗi(thô, 0, 8)
            + "-"
            + cắt chuỗi(thô, 8, 4)
            + "-4"
            + cắt chuỗi(thô, 13, 3)
            + "-"
            + mình.uuid nửa byte biến thể(thô[16])
            + cắt chuỗi(thô, 17, 3)
            + "-"
            + cắt chuỗi(thô, 20, 12);
    };

    hàm công khai uuid phân tích(văn bản) {
        nếu (loại của(văn bản) != "chuỗi") {
            ném "UUID_INVALID";
        };
        nếu (máy ảo lấy độ dài(văn bản) != 36) {
            ném "UUID_INVALID";
        };
        lặp(i = 0; i < 36; i++) {
            c = văn bản[i];
            là gạch = i == 8 || i == 13 || i == 18 || i == 23;
            nếu (là gạch) {
                nếu (c != "-") {
                    ném "UUID_INVALID";
                };
            } hoặc {
                nếu (mình.thập lục phân chỉ số(c) < 0) {
                    ném "UUID_INVALID";
                };
            };
        };
        trả về chuỗi thường(văn bản);
    };

    hàm công khai uuid văn bản(mã định danh) {
        trả về mình.uuid phân tích(mã định danh);
    };

    hàm công khai tập bit() {
        trả về {"__vpp_bitset__": 1, "bits": []};
    };

    hàm riêng tư bit yêu cầu tập(tập) {
        nếu (loại của(tập) != "từ điển") {
            ném "BITSET_INDEX";
        };
        nếu (lấy từ điển(tập, "__vpp_bitset__", 0) != 1) {
            ném "BITSET_INDEX";
        };
        trả về lấy từ điển(tập, "bits", []);
    };

    hàm riêng tư bit yêu cầu chỉ số(chỉ mục) {
        nếu (loại của(chỉ mục) != "số nguyên") {
            ném "BITSET_INDEX";
        };
        nếu (chỉ mục < 0) {
            ném "BITSET_INDEX";
        };
        nếu (chỉ mục > 1000000000) {
            ném "BITSET_RESOURCE_LIMIT";
        };
        trả về chỉ mục;
    };

    hàm công khai bit đặt(tập, chỉ mục) {
        mình.bit yêu cầu chỉ số(chỉ mục);
        các bit = mình.bit yêu cầu tập(tập);
        nếu (tìm chỉ số(các bit, chỉ mục) < 0) {
            nếu (máy ảo lấy độ dài(các bit) >= 1000000) {
                ném "BITSET_RESOURCE_LIMIT";
            };
            máy ảo thêm cuối danh sách(các bit, chỉ mục);
            sắp xếp(các bit);
        };
        trả về tập;
    };

    hàm công khai bit xóa(tập, chỉ mục) {
        mình.bit yêu cầu chỉ số(chỉ mục);
        các bit = mình.bit yêu cầu tập(tập);
        vị trí = tìm chỉ số(các bit, chỉ mục);
        nếu (vị trí >= 0) {
            máy ảo xóa vị trí danh sách(các bit, vị trí);
        };
        trả về tập;
    };

    hàm công khai bit lật(tập, chỉ mục) {
        nếu (mình.bit có(tập, chỉ mục)) {
            trả về mình.bit xóa(tập, chỉ mục);
        };
        trả về mình.bit đặt(tập, chỉ mục);
    };

    hàm công khai bit có(tập, chỉ mục) {
        mình.bit yêu cầu chỉ số(chỉ mục);
        các bit = mình.bit yêu cầu tập(tập);
        trả về tìm chỉ số(các bit, chỉ mục) >= 0;
    };

    hàm công khai bit tiếp đặt(tập, từ chỉ mục) {
        mình.bit yêu cầu chỉ số(từ chỉ mục);
        các bit = mình.bit yêu cầu tập(tập);
        kết quả = -1;
        lặp(i = 0; i < máy ảo lấy độ dài(các bit) && kết quả < 0; i++) {
            nếu (các bit[i] >= từ chỉ mục) {
                kết quả = các bit[i];
            };
        };
        trả về kết quả;
    };

    hàm công khai bit độ dài(tập) {
        các bit = mình.bit yêu cầu tập(tập);
        n = máy ảo lấy độ dài(các bit);
        nếu (n == 0) {
            trả về 0;
        };
        trả về các bit[n - 1] + 1;
    };

    hàm công khai bit số bit(tập) {
        trả về máy ảo lấy độ dài(mình.bit yêu cầu tập(tập));
    };

    hàm công khai bit bằng(a, b) {
        các bit thứ nhất = mình.bit yêu cầu tập(a);
        các bit thứ hai = mình.bit yêu cầu tập(b);
        nếu (máy ảo lấy độ dài(các bit thứ nhất) != máy ảo lấy độ dài(các bit thứ hai)) {
            trả về sai;
        };
        lặp(i = 0; i < máy ảo lấy độ dài(các bit thứ nhất); i++) {
            nếu (các bit thứ nhất[i] != các bit thứ hai[i]) {
                trả về sai;
            };
        };
        trả về đúng;
    };

    hàm công khai bit sao chép(tập) {
        nguồn = mình.bit yêu cầu tập(tập);
        kết quả = mình.tập bit();
        lặp(i = 0; i < máy ảo lấy độ dài(nguồn); i++) {
            mình.bit đặt(kết quả, nguồn[i]);
        };
        trả về kết quả;
    };

    hàm công khai bit và(a, b) {
        kết quả = mình.tập bit();
        các bit thứ nhất = mình.bit yêu cầu tập(a);
        lặp(i = 0; i < máy ảo lấy độ dài(các bit thứ nhất); i++) {
            nếu (mình.bit có(b, các bit thứ nhất[i])) {
                mình.bit đặt(kết quả, các bit thứ nhất[i]);
            };
        };
        trả về kết quả;
    };

    hàm công khai bit hoặc(a, b) {
        kết quả = mình.tập bit();
        các bit thứ nhất = mình.bit yêu cầu tập(a);
        các bit thứ hai = mình.bit yêu cầu tập(b);
        lặp(i = 0; i < máy ảo lấy độ dài(các bit thứ nhất); i++) {
            mình.bit đặt(kết quả, các bit thứ nhất[i]);
        };
        lặp(i = 0; i < máy ảo lấy độ dài(các bit thứ hai); i++) {
            mình.bit đặt(kết quả, các bit thứ hai[i]);
        };
        trả về kết quả;
    };

    hàm công khai bit xor(a, b) {
        kết quả = mình.tập bit();
        tất cả = mình.bit hoặc(a, b);
        các bit = mình.bit yêu cầu tập(tất cả);
        lặp(i = 0; i < máy ảo lấy độ dài(các bit); i++) {
            chỉ mục = các bit[i];
            nếu (mình.bit có(a, chỉ mục) != mình.bit có(b, chỉ mục)) {
                mình.bit đặt(kết quả, chỉ mục);
            };
        };
        trả về kết quả;
    };
};


