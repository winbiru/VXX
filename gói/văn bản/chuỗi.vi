// Module: lõi.chuỗi
// Mục đích: gom các phép xử lý chuỗi cơ bản.
// Nhóm hàm: nối chuỗi, so sánh chuỗi, kiểm tra rỗng.

nhập gói/lõi/trình tự;
nhập gói/lõi/bảng mã;
nhập gói/lõi/chuyển kiểu;
nhập gói/bộ sưu tập/từ điển;

// Lớp sở hữu toàn bộ thuật toán của mô-đun; các hàm bên dưới chỉ giữ API cũ.
lớp công khai Xử Lý Chuỗi {
    hàm công khai khởi tạo() {};

    // Ghi chú hàm: độ dài của chuỗi hoặc list. Native runtime cung cấp implementation.
    hàm công khai độ dài(giá trị) {
        trả về máy ảo lấy độ dài(giá trị);
    };

    // Ghi chú hàm: nối chuỗi.
    hàm công khai nối chuỗi(a, b) {
        trả về a + b;
    };

    // Ghi chú hàm: nối ba.
    hàm công khai nối ba(a, b, c) {
        trả về a + b + c;
    };

    // Ghi chú hàm: bằng nhau chuỗi.
    hàm công khai bằng nhau chuỗi(a, b) {
        trả về a == b;
    };

    // Ghi chú hàm: khác nhau chuỗi.
    hàm công khai khác nhau chuỗi(a, b) {
        trả về a != b;
    };

    // Ghi chú hàm: là chuỗi rỗng.
    hàm công khai là chuỗi rỗng(s) {
        trả về s == "";
    };

    // Chuỗi V++ dùng UTF-8. Các phép đếm/chứa/thay dưới đây chuẩn hóa NFC tiếng
    // Việt trước khi so khớp để chữ dựng sẵn và chữ tách dấu có cùng semantics.
    hàm công khai đếm ký tự(s, ký tự) {
        nguồn = mình.chuẩn hóa unicode(s);
        mẫu = mình.chuẩn hóa unicode(ký tự);
        m = máy ảo lấy độ dài(mẫu);
        nếu (m == 0) {
            ném "đếm ký tự: mẫu không được rỗng";
        };
        n = máy ảo lấy độ dài(nguồn);
        kết quả = 0;
        vị trí = 0;
        khi (vị trí + m <= n) {
            nếu (mình.cắt chuỗi(nguồn, vị trí, m) == mẫu) {
                kết quả = kết quả + 1;
                vị trí = vị trí + m;
            } hoặc {
                vị trí = vị trí + 1;
            };
        };
        trả về kết quả;
    };

    hàm công khai chứa chuỗi(s, chuỗi con) {
        nguồn = mình.chuẩn hóa unicode(s);
        mẫu = mình.chuẩn hóa unicode(chuỗi con);
        m = máy ảo lấy độ dài(mẫu);
        nếu (m == 0) {
            trả về đúng;
        };
        tìm thấy = sai;
        lặp(i = 0; i + m <= máy ảo lấy độ dài(nguồn) && !tìm thấy; i++) {
            nếu (mình.cắt chuỗi(nguồn, i, m) == mẫu) {
                tìm thấy = đúng;
            };
        };
        trả về tìm thấy;
    };

    hàm công khai thay thế(s, cũ, mới) {
        nguồn = mình.chuẩn hóa unicode(s);
        mẫu = mình.chuẩn hóa unicode(cũ);
        thay = mình.chuẩn hóa unicode(mới);
        m = máy ảo lấy độ dài(mẫu);
        nếu (m == 0) {
            ném "thay thế: mẫu không được rỗng";
        };

        kết quả = "";
        vị trí = 0;
        n = máy ảo lấy độ dài(nguồn);
        khi (vị trí < n) {
            nếu (vị trí + m <= n && mình.cắt chuỗi(nguồn, vị trí, m) == mẫu) {
                kết quả = kết quả + thay;
                vị trí = vị trí + m;
            } hoặc {
                kết quả = kết quả + nguồn[vị trí];
                vị trí = vị trí + 1;
            };
        };
        trả về kết quả;
    };

    // Ghi chú hàm: cắt `số_lượng` code point kể từ `bắt_đầu` (chỉ số bắt đầu từ 0).
    // Tham số nguyên chấp nhận cả dạng số thực tích phân như 1.0; giá trị có phần lẻ bị từ chối.
    // Nếu độ dài vượt phần còn lại, kết quả dừng ở cuối chuỗi.
    hàm công khai cắt chuỗi(s, bắt đầu, số lượng) {
        văn bản = thành chuỗi(s);
        thử {
            bắt đầu = thành số nguyên(bắt đầu);
            số lượng = thành số nguyên(số lượng);
        } bắt lỗi (e) {
            ném "cắt chuỗi: vị trí và độ dài phải là số nguyên";
        };
        nếu (bắt đầu < 0 || số lượng < 0) {
            ném "cắt chuỗi không nhận vị trí hoặc độ dài âm";
        };
        n = mình.độ dài(văn bản);
        nếu (bắt đầu >= n || số lượng == 0) {
            trả về "";
        };
        kết thúc = bắt đầu + số lượng;
        nếu (kết thúc > n) {
            kết thúc = n;
        };
        kết quả = "";
        lặp(i = bắt đầu; i < kết thúc; i++) {
            kết quả = kết quả + văn bản[i];
        };
        trả về kết quả;
    };

    // Bảng chữ cái public hiện giữ đúng contract runtime 1.0: ASCII và các
    // chữ dựng sẵn tiếng Việt. Ký tự ngoài bảng được giữ nguyên. Đây là logic
    // thư viện nên được thực hiện bằng V++, không cần native hook riêng.
    hàm riêng tư chuỗi đổi hoa thường(s, nguồn, đích) {
        văn bản = s;
        nếu (loại của(văn bản) != "chuỗi") {
            văn bản = thành chuỗi(văn bản);
        };

        kết quả = "";
        lặp(i = 0; i < máy ảo lấy độ dài(văn bản); i++) {
            c = văn bản[i];
            thay = c;
            tìm thấy = sai;
            lặp(j = 0; j < máy ảo lấy độ dài(nguồn) && !tìm thấy; j++) {
                nếu (nguồn[j] == c) {
                    thay = đích[j];
                    tìm thấy = đúng;
                };
            };
            kết quả = kết quả + thay;
        };
        trả về kết quả;
    };

    hàm công khai chuỗi thường(s) {
        nguồn = "ABCDEFGHIJKLMNOPQRSTUVWXYZ" +
                "ĂÂÊÔƠƯĐÀÁẢÃẠẰẮẲẴẶẦẤẨẪẬÈÉẺẼẸỀẾỂỄỆÌÍỈĨỊÒÓỎÕỌỒỐỔỖỘỜỚỞỠỢÙÚỦŨỤỪỨỬỮỰỲÝỶỸỴ";
        đích = "abcdefghijklmnopqrstuvwxyz" +
               "ăâêôơưđàáảãạằắẳẵặầấẩẫậèéẻẽẹềếểễệìíỉĩịòóỏõọồốổỗộờớởỡợùúủũụừứửữựỳýỷỹỵ";
        trả về mình.chuỗi đổi hoa thường(s, nguồn, đích);
    };

    hàm công khai chuỗi hoa(s) {
        nguồn = "abcdefghijklmnopqrstuvwxyz" +
                "ăâêôơưđàáảãạằắẳẵặầấẩẫậèéẻẽẹềếểễệìíỉĩịòóỏõọồốổỗộờớởỡợùúủũụừứửữựỳýỷỹỵ";
        đích = "ABCDEFGHIJKLMNOPQRSTUVWXYZ" +
               "ĂÂÊÔƠƯĐÀÁẢÃẠẰẮẲẴẶẦẤẨẪẬÈÉẺẼẸỀẾỂỄỆÌÍỈĨỊÒÓỎÕỌỒỐỔỖỘỜỚỞỠỢÙÚỦŨỤỪỨỬỮỰỲÝỶỸỴ";
        trả về mình.chuỗi đổi hoa thường(s, nguồn, đích);
    };

    // Canonical combining class tối thiểu mà contract NFC tiếng Việt 1.0 cần.
    hàm riêng tư chuỗi nfc hạng dấu(c) {
        nếu (c == "̛") { trả về 216; }; // horn
        nếu (c == "̣") { trả về 220; }; // dot below
        nếu (c == "̀" || c == "́" || c == "̂" || c == "̃" ||
            c == "̆" || c == "̉") {
            trả về 230;
        };
        trả về 0;
    };

    // Trả canonical decomposition của một nguyên âm dựng sẵn tiếng Việt.
    // `mục_tiêu` là chuỗi 144 code point; `phân_rã` là danh sách song song.
    hàm riêng tư chuỗi nfc phân rã ký tự(c, mục tiêu, phân rã) {
        vị trí = -1;
        lặp(i = 0; i < máy ảo lấy độ dài(mục tiêu) && vị trí < 0; i++) {
            nếu (mục tiêu[i] == c) {
                vị trí = i;
            };
        };
        nếu (vị trí < 0) {
            trả về c;
        };
        trả về phân rã[vị trí];
    };

    // Sắp dấu theo canonical combining class rồi ghép lại nếu tổ hợp có dạng
    // dựng sẵn trong bảng tiếng Việt. Dấu cùng class giữ encounter order.
    hàm riêng tư chuỗi nfc ghép đoạn(đoạn, mục tiêu, phân rã) {
        nếu (máy ảo lấy độ dài(đoạn) == 0) {
            trả về "";
        };

        dấu = [];
        lặp(i = 1; i < máy ảo lấy độ dài(đoạn); i++) {
            máy ảo thêm cuối danh sách(dấu, đoạn[i]);
        };
        n = máy ảo lấy độ dài(dấu);
        lặp(i = 0; i < n; i++) {
            lặp(j = 0; j + 1 < n - i; j++) {
                nếu (mình.chuỗi nfc hạng dấu(dấu[j]) > mình.chuỗi nfc hạng dấu(dấu[j + 1])) {
                    tạm = dấu[j];
                    dấu[j] = dấu[j + 1];
                    dấu[j + 1] = tạm;
                };
            };
        };

        khóa = đoạn[0];
        lặp(i = 0; i < máy ảo lấy độ dài(dấu); i++) {
            khóa = khóa + dấu[i];
        };

        vị trí = -1;
        lặp(i = 0; i < máy ảo lấy độ dài(phân rã) && vị trí < 0; i++) {
            nếu (phân rã[i] == khóa) {
                vị trí = i;
            };
        };
        nếu (vị trí >= 0) {
            trả về mục tiêu[vị trí];
        };
        trả về khóa;
    };

    // Chuẩn hóa NFC cho các tổ hợp chữ và dấu tiếng Việt trong contract V++ 1.0.
    // Đây là thuật toán thư viện thuần V++; code point thuộc script khác được giữ
    // nguyên. Bảng và thứ tự dấu tương đương implementation C++ trước đây.
    hàm công khai chuẩn hóa unicode(s) {
        văn bản = s;
        nếu (loại của(văn bản) != "chuỗi") {
            văn bản = thành chuỗi(văn bản);
        };

        mục tiêu = "aàáảãạăằắẳẵặâầấẩẫậeèéẻẽẹêềếểễệiìíỉĩị" +
                   "oòóỏõọôồốổỗộơờớởỡợuùúủũụưừứửữựyỳýỷỹỵ" +
                   "AÀÁẢÃẠĂẰẮẲẴẶÂẦẤẨẪẬEÈÉẺẼẸÊỀẾỂỄỆIÌÍỈĨỊ" +
                   "OÒÓỎÕỌÔỒỐỔỖỘƠỜỚỞỠỢUÙÚỦŨỤƯỪỨỬỮỰYỲÝỶỸỴ";
        phân rã = [
            "a", "à", "á", "ả", "ã", "ạ", "ă", "ằ", "ắ", "ẳ", "ẵ", "ặ",
            "â", "ầ", "ấ", "ẩ", "ẫ", "ậ", "e", "è", "é", "ẻ", "ẽ", "ẹ",
            "ê", "ề", "ế", "ể", "ễ", "ệ", "i", "ì", "í", "ỉ", "ĩ", "ị",
            "o", "ò", "ó", "ỏ", "õ", "ọ", "ô", "ồ", "ố", "ổ", "ỗ", "ộ",
            "ơ", "ờ", "ớ", "ở", "ỡ", "ợ", "u", "ù", "ú", "ủ", "ũ", "ụ",
            "ư", "ừ", "ứ", "ử", "ữ", "ự", "y", "ỳ", "ý", "ỷ", "ỹ", "ỵ",
            "A", "À", "Á", "Ả", "Ã", "Ạ", "Ă", "Ằ", "Ắ", "Ẳ", "Ẵ", "Ặ",
            "Â", "Ầ", "Ấ", "Ẩ", "Ẫ", "Ậ", "E", "È", "É", "Ẻ", "Ẽ", "Ẹ",
            "Ê", "Ề", "Ế", "Ể", "Ễ", "Ệ", "I", "Ì", "Í", "Ỉ", "Ĩ", "Ị",
            "O", "Ò", "Ó", "Ỏ", "Õ", "Ọ", "Ô", "Ồ", "Ố", "Ổ", "Ỗ", "Ộ",
            "Ơ", "Ờ", "Ớ", "Ở", "Ỡ", "Ợ", "U", "Ù", "Ú", "Ủ", "Ũ", "Ụ",
            "Ư", "Ừ", "Ứ", "Ử", "Ữ", "Ự", "Y", "Ỳ", "Ý", "Ỷ", "Ỹ", "Ỵ"
        ];

        kết quả = "";
        đoạn = [];
        lặp(i = 0; i < máy ảo lấy độ dài(văn bản); i++) {
            c = văn bản[i];
            hạng dấu = mình.chuỗi nfc hạng dấu(c);
            nếu (hạng dấu != 0) {
                nếu (máy ảo lấy độ dài(đoạn) == 0) {
                    // Giữ đúng hành vi cũ: combining mark đứng độc lập được phát ra ngay.
                    kết quả = kết quả + c;
                } hoặc {
                    máy ảo thêm cuối danh sách(đoạn, c);
                };
            } hoặc {
                kết quả = kết quả + mình.chuỗi nfc ghép đoạn(đoạn, mục tiêu, phân rã);
                đoạn = [];
                phân rã c = mình.chuỗi nfc phân rã ký tự(c, mục tiêu, phân rã);
                lặp(j = 0; j < máy ảo lấy độ dài(phân rã c); j++) {
                    máy ảo thêm cuối danh sách(đoạn, phân rã c[j]);
                };
            };
        };
        trả về kết quả + mình.chuỗi nfc ghép đoạn(đoạn, mục tiêu, phân rã);
    };

    // Phân loại theo Unicode White_Space. Việc xác định code point dùng opcode chuỗi
    // cơ bản của VM; policy whitespace nằm hoàn toàn ở V++.
    hàm công khai chuỗi mã điểm unicode(c) {
        nếu (loại của(c) != "chuỗi" || máy ảo lấy độ dài(c) != 1) {
            ném "STRING_TYPE";
        };
        trả về mã điểm unicode(c);
    };

    hàm công khai là khoảng trắng unicode(c) {
        mã = mình.chuỗi mã điểm unicode(c);
        trả về (mã >= 9 && mã <= 13) ||
               mã == 32 || mã == 133 || mã == 160 || mã == 5760 ||
               (mã >= 8192 && mã <= 8202) ||
               mã == 8232 || mã == 8233 || mã == 8239 ||
               mã == 8287 || mã == 12288;
    };

    hàm công khai chuẩn hóa khoảng trắng(s) {
        kết quả = "";
        đang trong từ = sai;
        lặp(i = 0; i < máy ảo lấy độ dài(s); i++) {
            c = s[i];
            trắng = mình.là khoảng trắng unicode(c);
            nếu (trắng) {
                nếu (đang trong từ) {
                    kết quả = kết quả + " ";
                    đang trong từ = sai;
                };
            } hoặc {
                kết quả = kết quả + c;
                đang trong từ = đúng;
            };
        };
        nếu (máy ảo lấy độ dài(kết quả) > 0 && kết quả[máy ảo lấy độ dài(kết quả) - 1] == " ") {
            kết quả = mình.cắt chuỗi(kết quả, 0, máy ảo lấy độ dài(kết quả) - 1);
        };
        trả về kết quả;
    };

    hàm công khai đếm từ(s) {
        đếm = 0;
        trong từ = sai;
        lặp(i = 0; i < máy ảo lấy độ dài(s); i++) {
            c = s[i];
            trắng = mình.là khoảng trắng unicode(c);
            nếu (trắng) {
                trong từ = sai;
            } hoặc {
                nếu (!trong từ) {
                    đếm = đếm + 1;
                    trong từ = đúng;
                };
            };
        };
        trả về đếm;
    };

    hàm công khai từ dài nhất(s) {
        dài nhất = "";
        hiện tại = "";
        lặp(i = 0; i <= máy ảo lấy độ dài(s); i++) {
            hết = i == máy ảo lấy độ dài(s);
            c = " ";
            nếu (!hết) {
                c = s[i];
            };
            trắng = hết || mình.là khoảng trắng unicode(c);
            nếu (trắng) {
                nếu (máy ảo lấy độ dài(hiện tại) > máy ảo lấy độ dài(dài nhất)) {
                    dài nhất = hiện tại;
                };
                hiện tại = "";
            } hoặc {
                hiện tại = hiện tại + c;
            };
        };
        trả về dài nhất;
    };

    hàm công khai viết hoa đầu từ(s) {
        nguồn = mình.chuẩn hóa khoảng trắng(s);
        nếu (nguồn == "") {
            trả về "";
        };
        nguồn = mình.chuỗi thường(nguồn);
        kết quả = "";
        đầu từ = đúng;
        lặp(i = 0; i < máy ảo lấy độ dài(nguồn); i++) {
            c = nguồn[i];
            nếu (c == " ") {
                kết quả = kết quả + " ";
                đầu từ = đúng;
            } hoặc {
                nếu (đầu từ) {
                    kết quả = kết quả + mình.chuỗi hoa(c);
                    đầu từ = sai;
                } hoặc {
                    kết quả = kết quả + c;
                };
            };
        };
        trả về kết quả;
    };

    // Không phân biệt hoa/thường tiếng Việt; giữ nguyên whitespace/dấu câu trong phép so sánh.
    hàm công khai là palindrome(s) {
        nguồn = mình.chuỗi thường(mình.chuẩn hóa unicode(s));
        trái = 0;
        phải = máy ảo lấy độ dài(nguồn) - 1;
        kết quả = đúng;
        khi (trái < phải && kết quả) {
            nếu (nguồn[trái] != nguồn[phải]) {
                kết quả = sai;
            };
            trái = trái + 1;
            phải = phải - 1;
        };
        trả về kết quả;
    };

    // So sánh theo code point sau chuẩn hóa NFC + chữ thường tiếng Việt; bỏ whitespace.
    hàm công khai là anagram(a, b) {
        trái = mình.chuỗi thường(mình.chuẩn hóa unicode(a));
        phải = mình.chuỗi thường(mình.chuẩn hóa unicode(b));
        a danh sách = [];
        b danh sách = [];
        lặp(i = 0; i < máy ảo lấy độ dài(trái); i++) {
            c = trái[i];
            nếu (!mình.là khoảng trắng unicode(c)) {
                máy ảo thêm cuối danh sách(a danh sách, c);
            };
        };
        lặp(i = 0; i < máy ảo lấy độ dài(phải); i++) {
            c = phải[i];
            nếu (!mình.là khoảng trắng unicode(c)) {
                máy ảo thêm cuối danh sách(b danh sách, c);
            };
        };
        nếu (máy ảo lấy độ dài(a danh sách) != máy ảo lấy độ dài(b danh sách)) {
            trả về sai;
        };
        lặp(i = 0; i < máy ảo lấy độ dài(a danh sách); i++) {
            vị trí = -1;
            lặp(j = 0; j < máy ảo lấy độ dài(b danh sách) && vị trí < 0; j++) {
                nếu (a danh sách[i] == b danh sách[j]) {
                    vị trí = j;
                };
            };
            nếu (vị trí < 0) {
                trả về sai;
            };
            máy ảo xóa vị trí danh sách(b danh sách, vị trí);
        };
        trả về đúng;
    };

    // Khóa phải biểu diễn số nguyên; số thực tích phân được chấp nhận, phần lẻ bị từ chối.
    hàm công khai mã hóa caesar(s, khóa) {
        chữ thường = "abcdefghijklmnopqrstuvwxyz";
        chữ hoa = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
        dịch = khóa % 26;
        nếu (dịch < 0) {
            dịch = dịch + 26;
        };
        kết quả = "";
        lặp(i = 0; i < máy ảo lấy độ dài(s); i++) {
            c = s[i];
            vị trí = -1;
            hoa = sai;
            lặp(j = 0; j < 26 && vị trí < 0; j++) {
                nếu (chữ thường[j] == c) {
                    vị trí = j;
                };
                nếu (chữ hoa[j] == c) {
                    vị trí = j;
                    hoa = đúng;
                };
            };
            nếu (vị trí < 0) {
                kết quả = kết quả + c;
            } hoặc {
                mới = (vị trí + dịch) % 26;
                nếu (hoa) {
                    kết quả = kết quả + chữ hoa[mới];
                } hoặc {
                    kết quả = kết quả + chữ thường[mới];
                };
            };
        };
        trả về kết quả;
    };

    // --- Chuỗi nền tảng theo VPP-CORE-STRING-001 ---
    // Các API dưới đây giữ equality/lookup exact theo code point. Chúng không
    // chuẩn hóa NFC ngầm như nhóm helper tiếng Việt lịch sử ở phía trên.
    hàm công khai chuỗi yêu cầu(văn bản) {
        nếu (loại của(văn bản) != "chuỗi") {
            ném "STRING_TYPE";
        };
        trả về văn bản;
    };

    hàm riêng tư chuỗi yêu cầu chỉ mục(chỉ số, nhỏ nhất, lớn nhất) {
        nếu (loại của(chỉ số) != "số nguyên" ||
            chỉ số < nhỏ nhất || chỉ số > lớn nhất) {
            ném "STRING_INDEX";
        };
        trả về chỉ số;
    };

    hàm công khai ký tự tại(văn bản, chỉ số) {
        mình.chuỗi yêu cầu(văn bản);
        n = mình.độ dài(văn bản);
        mình.chuỗi yêu cầu chỉ mục(chỉ số, 0, n - 1);
        trả về văn bản[chỉ số];
    };

    // Khoảng nửa kín [bắt_đầu, kết_thúc), chỉ số theo Unicode code point.
    hàm công khai con chuỗi(văn bản, bắt đầu, kết thúc) {
        mình.chuỗi yêu cầu(văn bản);
        n = mình.độ dài(văn bản);
        mình.chuỗi yêu cầu chỉ mục(bắt đầu, 0, n);
        mình.chuỗi yêu cầu chỉ mục(kết thúc, bắt đầu, n);
        trả về mình.cắt chuỗi(văn bản, bắt đầu, kết thúc - bắt đầu);
    };

    hàm công khai bỏ khoảng trắng đầu(văn bản) {
        mình.chuỗi yêu cầu(văn bản);
        n = mình.độ dài(văn bản);
        bắt đầu = 0;
        đang bỏ = đúng;
        khi (bắt đầu < n && đang bỏ) {
            nếu (mình.là khoảng trắng unicode(văn bản[bắt đầu])) {
                bắt đầu = bắt đầu + 1;
            } hoặc {
                đang bỏ = sai;
            };
        };
        trả về mình.con chuỗi(văn bản, bắt đầu, n);
    };

    hàm công khai bỏ khoảng trắng cuối(văn bản) {
        mình.chuỗi yêu cầu(văn bản);
        kết thúc = mình.độ dài(văn bản);
        đang bỏ = đúng;
        khi (kết thúc > 0 && đang bỏ) {
            nếu (mình.là khoảng trắng unicode(văn bản[kết thúc - 1])) {
                kết thúc = kết thúc - 1;
            } hoặc {
                đang bỏ = sai;
            };
        };
        trả về mình.con chuỗi(văn bản, 0, kết thúc);
    };

    hàm công khai bỏ khoảng trắng(văn bản) {
        mình.chuỗi yêu cầu(văn bản);
        n = mình.độ dài(văn bản);
        bắt đầu = 0;
        kết thúc = n;
        đang bỏ = đúng;
        khi (bắt đầu < kết thúc && đang bỏ) {
            nếu (mình.là khoảng trắng unicode(văn bản[bắt đầu])) {
                bắt đầu = bắt đầu + 1;
            } hoặc {
                đang bỏ = sai;
            };
        };
        đang bỏ = đúng;
        khi (kết thúc > bắt đầu && đang bỏ) {
            nếu (mình.là khoảng trắng unicode(văn bản[kết thúc - 1])) {
                kết thúc = kết thúc - 1;
            } hoặc {
                đang bỏ = sai;
            };
        };
        trả về mình.con chuỗi(văn bản, bắt đầu, kết thúc);
    };

    hàm công khai chuỗi thành các byte(văn bản, bảng mã = "UTF-8") {
        mình.chuỗi yêu cầu(văn bản);
        trả về mã hóa bảng mã(văn bản, bảng mã);
    };

    hàm công khai chuỗi từ các byte(các byte, bảng mã = "UTF-8", chế độ lỗi = "BÁO_LỖI") {
        trả về giải mã bảng mã(các byte, bảng mã, chế độ lỗi);
    };

    // Lập chỉ mục byte một lần. Một byte UTF-8 sai được xem là một đơn vị
    // riêng, giống utf8CodePointAt/utf8CodePointCount trong runtime.
    // [byte, chỉ số code point tại đầu đơn vị (-1 ở giữa), byte offset của mỗi đơn vị].
    hàm riêng tư chuỗi chỉ mục byte(văn bản) {
        các byte = chuỗi thành byte máy ảo(văn bản);
        biên = [];
        vị trí byte = [0];
        n = máy ảo lấy độ dài(các byte);
        i = 0;
        chỉ số = 0;
        khi (i < n) {
            độ rộng = 1;
            nếu (các byte[i] > 127) {
                độ rộng = bảng mã unicode tám bit độ dài đoạn(các byte, i);
                nếu (độ rộng < 1) { độ rộng = 1; };
            };
            máy ảo thêm cuối danh sách(biên, chỉ số);
            lặp(j = 1; j < độ rộng; j++) {
                máy ảo thêm cuối danh sách(biên, -1);
            };
            i = i + độ rộng;
            chỉ số = chỉ số + 1;
            máy ảo thêm cuối danh sách(vị trí byte, i);
        };
        máy ảo thêm cuối danh sách(biên, chỉ số);
        trả về [các byte, biên, vị trí byte];
    };

    // KMP trên byte để số lần so sánh tăng tuyến tính theo độ dài đầu vào.
    // Kết quả chỉ được chấp nhận tại biên code point ở cả hai đầu.
    hàm riêng tư chuỗi bảng tiền tố(các byte) {
        n = máy ảo lấy độ dài(các byte);
        tiền tố = [];
        lặp(i = 0; i < n; i++) {
            máy ảo thêm cuối danh sách(tiền tố, 0);
        };
        lặp(i = 1; i < n; i++) {
            j = tiền tố[i - 1];
            khi (j > 0 && các byte[i] != các byte[j]) {
                j = tiền tố[j - 1];
            };
            nếu (các byte[i] == các byte[j]) { j = j + 1; };
            tiền tố[i] = j;
        };
        trả về tiền tố;
    };

    // Tìm exact, trả về chỉ số code point đầu tiên hoặc rỗng.
    hàm công khai tìm chuỗi chính xác(văn bản, mẫu, từ = 0) {
        mình.chuỗi yêu cầu(văn bản);
        mình.chuỗi yêu cầu(mẫu);
        n = mình.độ dài(văn bản);
        m = mình.độ dài(mẫu);
        mình.chuỗi yêu cầu chỉ mục(từ, 0, n);

        nếu (m == 0) {
            trả về từ;
        };
        nếu (m > n - từ) {
            trả về rỗng;
        };

        nguồn = mình.chuỗi chỉ mục byte(văn bản);
        các byte = nguồn[0];
        biên = nguồn[1];
        vị trí byte = nguồn[2];
        mẫu byte = chuỗi thành byte máy ảo(mẫu);
        số byte mẫu = máy ảo lấy độ dài(mẫu byte);
        số byte nguồn = máy ảo lấy độ dài(các byte);
        tiền tố = mình.chuỗi bảng tiền tố(mẫu byte);
        khớp = 0;
        lặp(i = vị trí byte[từ]; i < số byte nguồn; i++) {
            khi (khớp > 0 && các byte[i] != mẫu byte[khớp]) {
                khớp = tiền tố[khớp - 1];
            };
            nếu (các byte[i] == mẫu byte[khớp]) { khớp = khớp + 1; };
            nếu (khớp == số byte mẫu) {
                bắt đầu = i + 1 - số byte mẫu;
                nếu (biên[bắt đầu] >= 0 && biên[i + 1] >= 0) {
                    trả về biên[bắt đầu];
                };
                khớp = tiền tố[khớp - 1];
            };
        };
        trả về rỗng;
    };

    hàm công khai bắt đầu bằng(văn bản, tiền tố) {
        vị trí = mình.tìm chuỗi chính xác(văn bản, tiền tố, 0);
        trả về vị trí == 0;
    };

    hàm công khai kết thúc bằng(văn bản, hậu tố) {
        mình.chuỗi yêu cầu(văn bản);
        mình.chuỗi yêu cầu(hậu tố);
        n = mình.độ dài(văn bản);
        m = mình.độ dài(hậu tố);
        nếu (m > n) {
            trả về sai;
        };
        trả về mình.con chuỗi(văn bản, n - m, n) == hậu tố;
    };

    hàm công khai chứa chính xác(văn bản, mẫu) {
        trả về mình.tìm chuỗi chính xác(văn bản, mẫu, 0) != rỗng;
    };

    // Thay tất cả match literal không chồng lấp. Mẫu rỗng chèn replacement tại
    // mọi biên code point, tương đương semantics String.replace CharSequence.
    hàm công khai thay chính xác(văn bản, cũ, mới) {
        mình.chuỗi yêu cầu(văn bản);
        mình.chuỗi yêu cầu(cũ);
        mình.chuỗi yêu cầu(mới);
        n = mình.độ dài(văn bản);
        m = mình.độ dài(cũ);

        nguồn = mình.chuỗi chỉ mục byte(văn bản);
        các byte = nguồn[0];
        biên = nguồn[1];
        vị trí byte = nguồn[2];
        thay byte = chuỗi thành byte máy ảo(mới);
        kết quả = [];
        số byte thay = máy ảo lấy độ dài(thay byte);
        nếu (m == 0) {
            lặp(i = 0; i <= n; i++) {
                lặp(j = 0; j < số byte thay; j++) {
                    máy ảo thêm cuối danh sách(kết quả, thay byte[j]);
                };
                nếu (i < n) {
                    lặp(j = vị trí byte[i]; j < vị trí byte[i + 1]; j++) {
                        máy ảo thêm cuối danh sách(kết quả, các byte[j]);
                    };
                };
            };
            trả về chuỗi từ byte máy ảo(kết quả);
        };

        mẫu byte = chuỗi thành byte máy ảo(cũ);
        số byte mẫu = máy ảo lấy độ dài(mẫu byte);
        số byte nguồn = máy ảo lấy độ dài(các byte);
        tiền tố = mình.chuỗi bảng tiền tố(mẫu byte);
        khớp = 0;
        con trỏ = 0;
        lặp(i = 0; i < số byte nguồn; i++) {
            khi (khớp > 0 && các byte[i] != mẫu byte[khớp]) {
                khớp = tiền tố[khớp - 1];
            };
            nếu (các byte[i] == mẫu byte[khớp]) { khớp = khớp + 1; };
            nếu (khớp == số byte mẫu) {
                bắt đầu = i + 1 - số byte mẫu;
                nếu (biên[bắt đầu] >= 0 && biên[i + 1] >= 0) {
                    lặp(j = con trỏ; j < bắt đầu; j++) {
                        máy ảo thêm cuối danh sách(kết quả, các byte[j]);
                    };
                    lặp(j = 0; j < số byte thay; j++) {
                        máy ảo thêm cuối danh sách(kết quả, thay byte[j]);
                    };
                    con trỏ = i + 1;
                    khớp = 0;
                } hoặc {
                    khớp = tiền tố[khớp - 1];
                };
            };
        };
        lặp(i = con trỏ; i < số byte nguồn; i++) {
            máy ảo thêm cuối danh sách(kết quả, các byte[i]);
        };
        trả về chuỗi từ byte máy ảo(kết quả);
    };

    // Split literal, không dùng regex. Separator rỗng tách theo code point.
    hàm công khai tách hằng văn bản(văn bản, phân cách) {
        mình.chuỗi yêu cầu(văn bản);
        mình.chuỗi yêu cầu(phân cách);
        kết quả = [];
        n = mình.độ dài(văn bản);
        m = mình.độ dài(phân cách);

        nếu (m == 0) {
            lặp(i = 0; i < n; i++) {
                máy ảo thêm cuối danh sách(kết quả, mình.ký tự tại(văn bản, i));
            };
            trả về kết quả;
        };

        con trỏ = 0;
        tiếp tục = đúng;
        khi (tiếp tục) {
            vị trí = mình.tìm chuỗi chính xác(văn bản, phân cách, con trỏ);
            nếu (vị trí == rỗng) {
                máy ảo thêm cuối danh sách(kết quả, mình.con chuỗi(văn bản, con trỏ, n));
                tiếp tục = sai;
            } hoặc {
                máy ảo thêm cuối danh sách(kết quả, mình.con chuỗi(văn bản, con trỏ, vị trí));
                con trỏ = vị trí + m;
                nếu (con trỏ == n) {
                    máy ảo thêm cuối danh sách(kết quả, "");
                    tiếp tục = sai;
                };
            };
        };
        trả về kết quả;
    };

    // --- BộDựngChuỗi ---
    // V1 dùng map nội bộ để tránh phụ thuộc class-lowering. Builder giữ đồng thời
    // budget code point và budget byte UTF-8; không cần native allocator riêng.
    hàm công khai bộ dựng chuỗi(mức trần = 1048576, mức trần byte = 4194304) {
        nếu (loại của(mức trần) != "số nguyên" || mức trần < 0) {
            ném "STRING_RESOURCE_LIMIT";
        };
        nếu (loại của(mức trần byte) != "số nguyên" || mức trần byte < 0) {
            ném "STRING_RESOURCE_LIMIT";
        };
        trả về {
            "loại": "BộDựngChuỗi",
            "giá trị": "",
            "giới hạn": mức trần,
            "giới hạn byte": mức trần byte
        };
    };

    hàm công khai bộ dựng yêu cầu(bộ dựng) {
        nếu (loại của(bộ dựng) != "từ điển") {
            ném "STRING_BUILDER_INVALID";
        };
        nếu (lấy từ điển(bộ dựng, "loại", "") != "BộDựngChuỗi") {
            ném "STRING_BUILDER_INVALID";
        };
        trả về bộ dựng;
    };

    hàm riêng tư bộ dựng đặt(bộ dựng, văn bản) {
        mình.bộ dựng yêu cầu(bộ dựng);
        mình.chuỗi yêu cầu(văn bản);
        mức trần = lấy từ điển(bộ dựng, "giới hạn", 0);
        nếu (mình.độ dài(văn bản) > mức trần) {
            ném "STRING_RESOURCE_LIMIT";
        };
        mức trần byte = lấy từ điển(bộ dựng, "giới hạn byte", 4194304);
        nếu (mình.độ dài(mình.chuỗi thành các byte(văn bản, "UTF-8")) > mức trần byte) {
            ném "STRING_RESOURCE_LIMIT";
        };
        đặt từ điển(bộ dựng, "giá trị", văn bản);
        trả về bộ dựng;
    };

    hàm công khai bộ dựng thêm(bộ dựng, giá trị) {
        mình.bộ dựng yêu cầu(bộ dựng);
        hiện tại = lấy từ điển(bộ dựng, "giá trị", "");
        trả về mình.bộ dựng đặt(bộ dựng, hiện tại + thành chuỗi(giá trị));
    };

    hàm công khai bộ dựng chèn(bộ dựng, chỉ số, giá trị) {
        mình.bộ dựng yêu cầu(bộ dựng);
        hiện tại = lấy từ điển(bộ dựng, "giá trị", "");
        n = mình.độ dài(hiện tại);
        mình.chuỗi yêu cầu chỉ mục(chỉ số, 0, n);
        mới = mình.con chuỗi(hiện tại, 0, chỉ số) + thành chuỗi(giá trị) +
              mình.con chuỗi(hiện tại, chỉ số, n);
        trả về mình.bộ dựng đặt(bộ dựng, mới);
    };

    hàm công khai bộ dựng xóa(bộ dựng, bắt đầu, kết thúc) {
        mình.bộ dựng yêu cầu(bộ dựng);
        hiện tại = lấy từ điển(bộ dựng, "giá trị", "");
        n = mình.độ dài(hiện tại);
        mình.chuỗi yêu cầu chỉ mục(bắt đầu, 0, n);
        mình.chuỗi yêu cầu chỉ mục(kết thúc, bắt đầu, n);
        mới = mình.con chuỗi(hiện tại, 0, bắt đầu) + mình.con chuỗi(hiện tại, kết thúc, n);
        trả về mình.bộ dựng đặt(bộ dựng, mới);
    };

    hàm công khai bộ dựng thay(bộ dựng, bắt đầu, kết thúc, giá trị) {
        mình.bộ dựng yêu cầu(bộ dựng);
        hiện tại = lấy từ điển(bộ dựng, "giá trị", "");
        n = mình.độ dài(hiện tại);
        mình.chuỗi yêu cầu chỉ mục(bắt đầu, 0, n);
        mình.chuỗi yêu cầu chỉ mục(kết thúc, bắt đầu, n);
        mới = mình.con chuỗi(hiện tại, 0, bắt đầu) + thành chuỗi(giá trị) +
              mình.con chuỗi(hiện tại, kết thúc, n);
        trả về mình.bộ dựng đặt(bộ dựng, mới);
    };

    hàm công khai bộ dựng đảo(bộ dựng) {
        mình.bộ dựng yêu cầu(bộ dựng);
        hiện tại = lấy từ điển(bộ dựng, "giá trị", "");
        trả về mình.bộ dựng đặt(bộ dựng, đảo ngược(hiện tại));
    };

    hàm công khai bộ dựng kết quả(bộ dựng) {
        mình.bộ dựng yêu cầu(bộ dựng);
        trả về lấy từ điển(bộ dựng, "giá trị", "");
    };

    hàm công khai bộ dựng số byte(bộ dựng) {
        mình.bộ dựng yêu cầu(bộ dựng);
        văn bản = lấy từ điển(bộ dựng, "giá trị", "");
        trả về mình.độ dài(mình.chuỗi thành các byte(văn bản, "UTF-8"));
    };

    // --- MẫuChuỗi ---
    // Snapshot hai list cấu trúc lúc tạo để mutation danh sách của caller không
    // đổi topology template sau đó.
    hàm công khai mẫu chuỗi(mảnh, giá trị) {
        nếu (loại của(mảnh) != "danh sách") {
            ném "STRING_TEMPLATE_INVALID";
        };
        nếu (loại của(giá trị) != "danh sách") {
            ném "STRING_TEMPLATE_INVALID";
        };
        nếu (mình.độ dài(mảnh) != mình.độ dài(giá trị) + 1) {
            ném "STRING_TEMPLATE_INVALID";
        };

        mảnh sao chép = [];
        giá trị sao chép = [];
        lặp(i = 0; i < mình.độ dài(mảnh); i++) {
            mình.chuỗi yêu cầu(mảnh[i]);
            máy ảo thêm cuối danh sách(mảnh sao chép, mảnh[i]);
        };
        lặp(i = 0; i < mình.độ dài(giá trị); i++) {
            máy ảo thêm cuối danh sách(giá trị sao chép, giá trị[i]);
        };

        trả về {
            "loại": "MẫuChuỗi",
            "mảnh": mảnh sao chép,
            "giá trị": giá trị sao chép
        };
    };

    hàm công khai mẫu chuỗi yêu cầu(template) {
        nếu (loại của(template) != "từ điển") {
            ném "STRING_TEMPLATE_INVALID";
        };
        nếu (lấy từ điển(template, "loại", "") != "MẫuChuỗi") {
            ném "STRING_TEMPLATE_INVALID";
        };
        trả về template;
    };

    hàm công khai nội suy mẫu(template) {
        mình.mẫu chuỗi yêu cầu(template);
        mảnh = lấy từ điển(template, "mảnh", []);
        giá trị = lấy từ điển(template, "giá trị", []);
        kết quả = "";
        lặp(i = 0; i < mình.độ dài(giá trị); i++) {
            kết quả = kết quả + mảnh[i] + thành chuỗi(giá trị[i]);
        };
        trả về kết quả + mảnh[mình.độ dài(mảnh) - 1];
    };

    hàm công khai xử lý mẫu(template, bộ xử lý) {
        mình.mẫu chuỗi yêu cầu(template);
        trả về bộ xử lý(template);
    };
};


