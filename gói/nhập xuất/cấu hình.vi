// Module: nhập xuất.cấu hình
// Mục đích: cung cấp API đọc cấu hình ở tầng gói.
// Ghi chú: hiện phụ thuộc native hook của VM.
// Đường dẫn phải là UTF-8 hợp lệ tại native boundary.

// Ghi chú hàm: đọc cấu hình.
hàm đọc cấu hình(đường dẫn) {
    ném "chuẩn: đọc cấu hình native hook không khả dụng";
};

// Ghi chú hàm: đọc một khóa cấu hình với giá trị mặc định.
hàm đọc cấu hình khóa(đường dẫn, khóa, giá trị mặc định) {
    ném "chuẩn: đọc cấu hình khóa native hook không khả dụng";
};
