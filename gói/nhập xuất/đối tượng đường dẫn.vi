// Value-object đường dẫn, không giữ handle hệ tệp.
nhập gói.nhập xuất.đường dẫn.* như đường giao diện lập trình;

lớp công khai Đường Dẫn {
    hàm công khai khởi tạo(đường) {
        nếu (loại của(đường) != "chuỗi") { ném "đường dẫn: cần chuỗi"; };
        mình.đường = đường;
    };

    hàm công khai giá trị() { trả về mình.đường; };
    hàm công khai tên() { trả về đường giao diện lập trình.đường dẫn tên(mình.đường); };
    hàm công khai cha() { trả về Đường Dẫn(đường giao diện lập trình.đường dẫn cha(mình.đường)); };
    hàm công khai nối(phần con) {
        nếu (loại của(phần con) != "chuỗi") { ném "đường dẫn: phần con phải là chuỗi"; };
        trả về Đường Dẫn(đường giao diện lập trình.đường dẫn nối(mình.đường, phần con));
    };
    hàm công khai tuyệt đối() { trả về đường giao diện lập trình.đường dẫn là tuyệt đối(mình.đường); };
    hàm công khai tồn tại() { trả về đường giao diện lập trình.đường dẫn tồn tại(mình.đường); };
    hàm công khai là tệp() { trả về đường giao diện lập trình.là tệp(mình.đường); };
    hàm công khai là thư mục() { trả về đường giao diện lập trình.là thư mục(mình.đường); };
};
