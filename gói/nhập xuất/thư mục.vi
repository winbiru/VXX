// Module: nhập xuất.thư mục
// Tạo, liệt kê và dọn cây thư mục bằng V++.
// VM chỉ tạo/xóa một mục hoặc đọc trạng thái/danh sách mục của hệ tệp.

nhập gói/bộ sưu tập/danh sách;
nhập gói/lõi/chuyển kiểu;
nhập gói/lõi/bảng mã;
nhập gói/nhập xuất/đường dẫn;
nhập gói/hệ thống/nền tảng;
nhập gói/văn bản/chuỗi;

// Machine ABI: mkdir/remove -> [rc, loại lỗi, mã OS].
// Loại lỗi: 0=thành công, 1=đã tồn tại, 2=không tồn tại, 3=lỗi khác.
// open -> [token, errno]; next -> [1,tên] / [0,""] EOF / [-errno,""] lỗi.
// close -> [rc, errno]. Token chỉ có hiệu lực trong VM đã mở.

// Lớp sở hữu toàn bộ thuật toán của mô-đun; các hàm bên dưới chỉ giữ API cũ.
lớp công khai Thư Mục {
    hàm công khai khởi tạo() {};

    // Kiểm tra trước khi tra cứu thư mục trên cả POSIX và Windows. Lỗi V++
    // cần bắt được bằng thử/bắt lỗi trước khi đi vào FFI c_chuỗi.
    hàm riêng tư thư mục kiểm tra đường(đường) {
        các byte = bảng mã unicode tám bit mã hóa(đường);
        lặp(i = 0; i < máy ảo lấy độ dài(các byte); i++) {
            nếu (các byte[i] == 0) {
                ném "đường dẫn không được chứa byte NUL";
            };
        };
        trả về đường;
    };

    hàm riêng tư thư mục tạo một mục(đường) {
        // V++ tự tạo các mục cha; machine ABI chỉ tạo một mục.
        kết quả = máy thư mục tạo(mình.thư mục kiểm tra đường(đường));
        nếu (kết quả[0] == 0) { trả về 1; };
        lỗi = kết quả[2];
        nếu (kết quả[1] == 1) {
            nếu (là thư mục(đường)) { trả về 0; };
        };
        ném "tạo thư mục: mkdir thất bại, errno=" + lỗi;
    };

    hàm riêng tư thư mục xóa một mục(đường) {
        // V++ quyết định thứ tự duyệt và xóa cây.
        kết quả = máy thư mục xóa(mình.thư mục kiểm tra đường(đường));
        nếu (kết quả[0] == 0) { trả về 1; };
        lỗi = kết quả[2];
        nếu (kết quả[1] == 2) { trả về 0; };
        ném "xóa đường dẫn: remove thất bại, errno=" + lỗi;
    };

    hàm riêng tư thư mục là thư mục không theo liên kết(đường) {
        nếu (ten nền tảng máy ảo() != "windows") {
            trả về đường dẫn loại posix(đường, sai) == 4;
        };
        trả về đường dẫn loại windows(đường, sai) == 2;
    };

    // Bỏ separator cuối trước lstat/unlink để symlink tới thư mục vẫn chỉ bị
    // xóa liên kết, kể cả khi caller truyền "link/". Giữ root POSIX/Windows.
    hàm riêng tư thư mục bỏ dấu cuối(đường) {
        n = máy ảo lấy độ dài(đường);
        gốc dữ liệu = 1;
        nếu (tên nền tảng() == "windows") {
            gốc dữ liệu = đường dẫn gốc windows dài(đường);
            nếu (gốc dữ liệu < 1) { gốc dữ liệu = 1; };
        };
        đang bỏ = đúng;
        khi (n > gốc dữ liệu && đang bỏ) {
            nếu (!đường dẫn là phân cách(đường[n - 1])) {
                đang bỏ = sai;
            } hoặc {
                n = n - 1;
            };
        };
        trả về cắt chuỗi(đường, 0, n);
    };

    hàm công khai tạo thư mục(đường dẫn) {
        đầu vào = thành chuỗi(đường dẫn);
        mình.thư mục kiểm tra đường(đầu vào);
        đường = mình.thư mục bỏ dấu cuối(đầu vào);
        cần tạo = [];
        hiện tại = đường;
        tìm cha = đúng;
        khi (tìm cha) {
            nếu (là thư mục(hiện tại)) {
                tìm cha = sai;
            } hoặc {
                nếu (đường dẫn tồn tại(hiện tại)) {
                    ném "tạo thư mục: đường dẫn đã tồn tại và không phải thư mục";
                };
                máy ảo thêm cuối danh sách(cần tạo, hiện tại);
                cha = đường dẫn cha(hiện tại);
                nếu (cha == "" || cha == hiện tại) {
                    tìm cha = sai;
                } hoặc {
                    hiện tại = cha;
                };
            };
        };
        lặp(i = máy ảo lấy độ dài(cần tạo) - 1; i >= 0; i--) {
            mình.thư mục tạo một mục(cần tạo[i]);
        };
        trả về 1;
    };

    hàm công khai liệt kê thư mục(đường dẫn) {
        đường = thành chuỗi(đường dẫn);
        mở = máy thư mục mở(mình.thư mục kiểm tra đường(đường));
        thư mục = mở[0];
        nếu (thư mục == 0) { ném "liệt kê thư mục: không thể mở thư mục, errno=" + mở[1]; };
        kết quả = [];
        thử {
            đang đọc = đúng;
            khi (đang đọc) {
                mục = máy thư mục kế(thư mục);
                nếu (mục[0] <= 0) {
                    nếu (mục[0] < 0) { ném "liệt kê thư mục: không thể đọc thư mục"; };
                    đang đọc = sai;
                } hoặc {
                    tên = mục[1];
                    nếu (tên != "." && tên != "..") { máy ảo thêm cuối danh sách(kết quả, tên); };
                };
            };
        } bắt lỗi(e) {
            máy thư mục đóng(thư mục);
            ném e;
        };
        nếu (máy thư mục đóng(thư mục)[0] != 0) {
            ném "liệt kê thư mục: không thể đóng thư mục";
        };
        sắp xếp(kết quả);
        trả về kết quả;
    };

    hàm công khai xóa đường dẫn(đường dẫn) {
        đầu vào = thành chuỗi(đường dẫn);
        mình.thư mục kiểm tra đường(đầu vào);
        đường = mình.thư mục bỏ dấu cuối(đầu vào);
        việc = [[đường, sai]];
        đã xóa = 0;
        // Stack tường minh thay cho lời gọi đệ quy: cây sâu không dùng call stack VM.
        khi (máy ảo lấy độ dài(việc) > 0) {
            mục = máy ảo xóa vị trí danh sách(việc, máy ảo lấy độ dài(việc) - 1);
            đường mục = mục[0];
            nếu (mục[1]) {
                đã xóa = đã xóa + mình.thư mục xóa một mục(đường mục);
            } hoặc {
                nếu (mình.thư mục là thư mục không theo liên kết(đường mục)) {
                    máy ảo thêm cuối danh sách(việc, [đường mục, đúng]);
                    con = mình.liệt kê thư mục(đường mục);
                    lặp(i = 0; i < máy ảo lấy độ dài(con); i++) {
                        máy ảo thêm cuối danh sách(việc, [đường dẫn nối(đường mục, con[i]), sai]);
                    };
                } hoặc {
                    đã xóa = đã xóa + mình.thư mục xóa một mục(đường mục);
                };
            };
        };
        trả về đã xóa;
    };
};


hàm công khai tạo thư mục(đường dẫn) {
    bộ chuyển tiếp = Thư Mục();
    trả về bộ chuyển tiếp.tạo thư mục(đường dẫn);
};

hàm công khai liệt kê thư mục(đường dẫn) {
    bộ chuyển tiếp = Thư Mục();
    trả về bộ chuyển tiếp.liệt kê thư mục(đường dẫn);
};

hàm công khai xóa đường dẫn(đường dẫn) {
    bộ chuyển tiếp = Thư Mục();
    trả về bộ chuyển tiếp.xóa đường dẫn(đường dẫn);
};
