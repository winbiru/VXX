// Module: nhập xuất.thư mục
// Tạo, liệt kê và dọn cây thư mục.

nhập gói/bộ sưu tập/danh sách;

hàm tạo thư mục(đường dẫn) {
    trả về tao_thu_muc(đường dẫn);
};

hàm liệt kê thư mục(đường dẫn) {
    kết_quả = liet_ke_thu_muc(đường dẫn);
    sắp xếp(kết_quả);
    trả về kết_quả;
};

hàm xóa đường dẫn(đường dẫn) {
    trả về xoa_duong_dan(đường dẫn);
};
