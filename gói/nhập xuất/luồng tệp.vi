// Luồng giữ handle stdio do VM quản lý; vị trí tính theo byte.
nhập gói/nhập xuất/tệp;
nhập gói/lõi/giao diện tài nguyên;
nhập gói/lõi/chuyển kiểu;

ngoại thư viện c_luồng = "system.c";
ngoại hàm luồng_mở_ffi(đường: c_chuỗi, chế_độ: c_chuỗi): c_tệp từ c_luồng
    ký hiệu "fopen" abi "c" khả năng "system.file.open";
ngoại hàm luồng_đọc_ffi(đệm: c_đệm_ra[đếm], cỡ: u64, đếm: u64, tệp: c_tệp): u64 từ c_luồng
    ký hiệu "fread" abi "c" khả năng "system.file.read";
ngoại hàm luồng_ghi_ffi(đệm: c_đệm_vào[đếm], cỡ: u64, đếm: u64, tệp: c_tệp): u64 từ c_luồng
    ký hiệu "fwrite" abi "c" khả năng "system.file.write";
ngoại hàm luồng_đóng_ffi(tệp: c_tệp): i32 từ c_luồng
    ký hiệu "fclose" abi "c" khả năng "system.file.close";
ngoại hàm luồng_lỗi_ffi(tệp: c_tệp): i32 từ c_luồng
    ký hiệu "ferror" abi "c" khả năng "system.file.error";

ngoại thư viện hệ_luồng_tệp = "system.file";
ngoại hàm luồng_dịch_ffi(tệp: c_tệp, lệch: i64, mốc: i32): i32 từ hệ_luồng_tệp
    ký hiệu "seek" abi "c" khả năng "system.file.seek";
ngoại hàm luồng_vị_trí_ffi(tệp: c_tệp): i64 từ hệ_luồng_tệp
    ký hiệu "tell" abi "c" khả năng "system.file.tell";
ngoại hàm luồng_đẩy_ffi(tệp: c_tệp): i32 từ hệ_luồng_tệp
    ký hiệu "flush" abi "c" khả năng "system.file.flush";

lớp công khai Luồng Tệp triển khai Đóng Được {
    hàm công khai khởi tạo(đường, chế_độ) {
        đường = tệp chuẩn hóa đường dẫn(đường);
        nếu (đường == "") { ném "luồng tệp: đường dẫn rỗng"; };
        mã = "";
        nếu (chế_độ == "đọc") { mã = "rb"; };
        nếu (chế_độ == "ghi") { mã = "wb"; };
        nếu (chế_độ == "nối") { mã = "ab"; };
        nếu (mã == "") { ném "luồng tệp: chế độ phải là đọc, ghi hoặc nối"; };
        handle = luồng_mở_ffi(đường, mã);
        nếu (handle == rỗng) { ném "luồng tệp: không thể mở tệp"; };
        mình.handle = handle;
        mình.chế_độ = chế_độ;
        mình.đã_đóng = sai;
    };

    hàm riêng tư yêu cầu mở() {
        nếu (mình.đã_đóng) { ném "luồng tệp: đã đóng"; };
    };

    hàm công khai đang mở() { trả về !mình.đã_đóng; };

    hàm công khai đọc bytes(đếm) {
        mình.yêu cầu mở();
        nếu (mình.chế_độ != "đọc") { ném "luồng tệp: không ở chế độ đọc"; };
        nếu (loai_cua(đếm) != "số nguyên") { ném "luồng tệp: số byte phải là số nguyên"; };
        nếu (đếm < 0 || đếm > 65536) { ném "luồng tệp: số byte phải trong 0..65536"; };
        nếu (đếm == 0) { trả về []; };
        đệm = [];
        lặp(i = 0; i < đếm; i++) { thêm(đệm, 0); };
        n = thành số nguyên(thành chuỗi(luồng_đọc_ffi(đệm, 1, đếm, mình.handle)));
        nếu (luồng_lỗi_ffi(mình.handle) != 0) { ném "luồng tệp: lỗi đọc"; };
        kết_quả = [];
        lặp(i = 0; i < n; i++) { thêm(kết_quả, đệm[i]); };
        trả về kết_quả;
    };

    hàm công khai đọc hết() {
        kết_quả = [];
        lặp(vòng = 0; đúng; vòng++) {
            khối = mình.đọc bytes(4096);
            nếu (do_dai(khối) == 0) { thoát; };
            lặp(i = 0; i < do_dai(khối); i++) { thêm(kết_quả, khối[i]); };
        };
        trả về chuoi_tu_bytes_vm(kết_quả);
    };

    hàm công khai ghi bytes(bytes) {
        mình.yêu cầu mở();
        nếu (mình.chế_độ == "đọc") { ném "luồng tệp: không ở chế độ ghi"; };
        tệp yêu cầu bytes(bytes);
        vị_trí = 0;
        lặp(vòng = 0; vị_trí < do_dai(bytes); vòng++) {
            đệm = [];
            hết = vị_trí + 4096;
            nếu (hết > do_dai(bytes)) { hết = do_dai(bytes); };
            lặp(i = vị_trí; i < hết; i++) { thêm(đệm, bytes[i]); };
            n = thành số nguyên(thành chuỗi(luồng_ghi_ffi(đệm, 1, do_dai(đệm), mình.handle)));
            nếu (n <= 0 || n > do_dai(đệm)) { ném "luồng tệp: lỗi ghi"; };
            vị_trí += n;
        };
        trả về 1;
    };

    hàm công khai ghi(nội_dung) {
        trả về mình.ghi bytes(chuoi_bytes_vm(thành chuỗi(nội_dung)));
    };

    hàm công khai vị trí() {
        mình.yêu cầu mở();
        n = luồng_vị_trí_ffi(mình.handle);
        nếu (n < 0) { ném "luồng tệp: không đọc được vị trí"; };
        trả về n;
    };

    hàm công khai dịch(lệch, mốc = 0) {
        mình.yêu cầu mở();
        nếu (luồng_dịch_ffi(mình.handle, lệch, mốc) != 0) { ném "luồng tệp: không thể dịch vị trí"; };
        trả về đúng;
    };

    hàm công khai đẩy đệm() {
        mình.yêu cầu mở();
        nếu (mình.chế_độ == "đọc") { ném "luồng tệp: không ở chế độ ghi"; };
        nếu (luồng_đẩy_ffi(mình.handle) != 0) { ném "luồng tệp: lỗi đẩy đệm"; };
        trả về đúng;
    };

    hàm công khai đóng() {
        nếu (mình.đã_đóng) { trả về đúng; };
        mình.đã_đóng = đúng;
        handle = mình.handle;
        mình.handle = rỗng;
        nếu (luồng_đóng_ffi(handle) != 0) { ném "luồng tệp: lỗi đóng"; };
        trả về đúng;
    };
};
