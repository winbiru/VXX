// Module: nhập xuất.tệp
// Mục đích: đọc/ghi tệp ở tầng gói.
// Đa nền tảng dùng FFI stdio: V++ quản lý chunk, EOF, partial write và cleanup.
// Đường dẫn phải là UTF-8 hợp lệ tại VM primitive boundary.

nhập gói/lõi/chuyển kiểu;
nhập gói/lõi/bảng mã;

ngoại thư viện c_tệp = "system.c";
ngoại hàm tệp_mở_ffi(đường: c_chuỗi, chế_độ: c_chuỗi): c_tệp từ c_tệp
    ký hiệu "fopen" abi "c" khả năng "system.file.open";
ngoại hàm tệp_đọc_ffi(đệm: c_đệm_ra[đếm], kích_thước: u64, đếm: u64, tệp: c_tệp): u64 từ c_tệp
    ký hiệu "fread" abi "c" khả năng "system.file.read";
ngoại hàm tệp_ghi_ffi(đệm: c_đệm_vào[đếm], kích_thước: u64, đếm: u64, tệp: c_tệp): u64 từ c_tệp
    ký hiệu "fwrite" abi "c" khả năng "system.file.write";
ngoại hàm tệp_đóng_ffi(tệp: c_tệp): i32 từ c_tệp
    ký hiệu "fclose" abi "c" khả năng "system.file.close";
ngoại hàm tệp_lỗi_ffi(tệp: c_tệp): i32 từ c_tệp
    ký hiệu "ferror" abi "c" khả năng "system.file.error";
ngoại thư viện c_lỗi_tệp = "system.ffi";
ngoại hàm mã_lỗi_tệp_ffi(): i32 từ c_lỗi_tệp
    ký hiệu "last_errno" abi "c" khả năng "system.ffi.error";

// Lớp sở hữu toàn bộ thuật toán của mô-đun; các hàm bên dưới chỉ giữ API cũ.
lớp công khai Hệ Tệp {
    hàm công khai khởi tạo() {};

    // Giá trị lỗi có cấu trúc: bắt lỗi(e) có thể đọc mã, đường dẫn, errno.
    // VM nhận diện theo giao thức dữ liệu, không đoán từ thông báo hay tên hàm.
    hàm tệp lỗi hệ thống(đường, thao_tác, mã, giai_đoạn, thông_báo, errno) {
        trả về {
            "loại": "lỗi hệ thống tệp",
            "mã": mã,
            "thao tác": thao_tác,
            "giai đoạn": giai_đoạn,
            "đường dẫn": đường,
            "errno": errno,
            "thông báo": thông_báo
        };
    };

    hàm công khai tệp chuẩn hóa đường dẫn(đường dẫn) {
        đường = thành chuỗi(đường dẫn);
        bytes = bảng mã utf8 mã hóa(đường);
        lặp(i = 0; i < do_dai(bytes); i++) {
            nếu (bytes[i] == 0) { ném "đường dẫn không được chứa byte NUL"; };
        };
        trả về đường;
    };

    // Mỗi thao tác giữ FILE* trong registry riêng của VM, V++ chỉ nhận một token.
    // Cleanup ở đây bao phủ cả lỗi I/O; VM còn đóng tài nguyên tồn tại khi hủy/reset.
    hàm công khai tệp đọc bytes posix(đường, thao_tác) {
        tệp = tệp_mở_ffi(đường, "rb");
        nếu (tệp == rỗng) {
            mã_lỗi = mã_lỗi_tệp_ffi();
            ném mình.tệp lỗi hệ thống(đường, thao_tác, "FILE_OPEN_FAILED", "mở",
                thao_tác + ": không thể mở tệp để đọc", mã_lỗi);
        };
        kết_quả = [];
        thử {
            // Dùng lại một đệm cho toàn bộ vòng đọc, tránh tạo 4096 phần tử
            // V++ cho mỗi khối khi xử lý tệp lớn.
            đệm = [];
            lặp(i = 0; i < 4096; i++) { them(đệm, 0); };
            đang_đọc = đúng;
            lặp(vòng = 0; đang_đọc; vòng++) {
                // fread returns exact size_t (boxed u64); count is bounded to 4096.
                n = thành số nguyên(thành chuỗi(tệp_đọc_ffi(đệm, 1, 4096, tệp)));
                nếu (n == 0) {
                    mã_lỗi = mã_lỗi_tệp_ffi();
                    nếu (tệp_lỗi_ffi(tệp) != 0) {
                        ném mình.tệp lỗi hệ thống(đường, thao_tác, "FILE_READ_FAILED", "đọc",
                            thao_tác + ": không thể đọc tệp", mã_lỗi);
                    };
                    đang_đọc = sai;
                } hoặc {
                    lặp(i = 0; i < n; i++) { them(kết_quả, đệm[i]); };
                };
            };
        } bắt lỗi(e) {
            tệp_đóng_ffi(tệp);
            ném e;
        };
        nếu (tệp_đóng_ffi(tệp) != 0) {
            mã_lỗi = mã_lỗi_tệp_ffi();
            ném mình.tệp lỗi hệ thống(đường, thao_tác, "FILE_CLOSE_FAILED", "đóng",
                thao_tác + ": không thể đóng tệp", mã_lỗi);
        };
        trả về kết_quả;
    };

    hàm công khai tệp ghi bytes posix(đường, bytes, nối, thao_tác) {
        chế_độ = "wb";
        nếu (nối) { chế_độ = "ab"; };
        tệp = tệp_mở_ffi(đường, chế_độ);
        nếu (tệp == rỗng) {
            mã_lỗi = mã_lỗi_tệp_ffi();
            ném mình.tệp lỗi hệ thống(đường, thao_tác, "FILE_OPEN_FAILED", "mở",
                thao_tác + ": không thể mở tệp để ghi", mã_lỗi);
        };
        thử {
            vị_trí = 0;
            lặp(vòng = 0; vị_trí < do_dai(bytes); vòng++) {
                đệm = [];
                hết = vị_trí + 4096;
                nếu (hết > do_dai(bytes)) { hết = do_dai(bytes); };
                lặp(i = vị_trí; i < hết; i++) { them(đệm, bytes[i]); };
                n = thành số nguyên(thành chuỗi(tệp_ghi_ffi(đệm, 1, do_dai(đệm), tệp)));
                mã_lỗi = mã_lỗi_tệp_ffi();
                nếu (n <= 0 || n > do_dai(đệm)) {
                    ném mình.tệp lỗi hệ thống(đường, thao_tác, "FILE_WRITE_FAILED", "ghi",
                        thao_tác + ": không thể ghi tệp", mã_lỗi);
                };
                vị_trí = vị_trí + n;
            };
        } bắt lỗi(e) {
            tệp_đóng_ffi(tệp);
            ném e;
        };
        nếu (tệp_đóng_ffi(tệp) != 0) {
            mã_lỗi = mã_lỗi_tệp_ffi();
            ném mình.tệp lỗi hệ thống(đường, thao_tác, "FILE_CLOSE_FAILED", "đóng",
                thao_tác + ": không thể ghi tệp", mã_lỗi);
        };
        trả về 1;
    };

    hàm công khai tệp yêu cầu bytes(bytes) {
        nếu (loai_cua(bytes) != "danh sách") {
            ném "ghi bytes tệp: cần danh sách bytes";
        };
        lặp(i = 0; i < do_dai(bytes); i++) {
            nếu (loai_cua(bytes[i]) != "số nguyên") {
                ném "ghi bytes tệp: mỗi byte phải là số nguyên";
            };
            nếu (bytes[i] < 0 || bytes[i] > 255) {
                ném "ghi bytes tệp: byte phải trong 0..255";
            };
        };
        trả về bytes;
    };

    // Ghi chú hàm: đọc tệp.
    hàm công khai đọc tệp(đường dẫn) {
        đường = mình.tệp chuẩn hóa đường dẫn(đường dẫn);
        trả về chuoi_tu_bytes_vm(mình.tệp đọc bytes posix(đường, "đọc tệp"));
    };

    // Ghi nguyên nội dung chuỗi runtime, không giải mã lại escape (kể cả JSON).
    hàm công khai ghi tệp(đường dẫn, nội dung) {
        đường = mình.tệp chuẩn hóa đường dẫn(đường dẫn);
        văn_bản = thành chuỗi(nội dung);
        trả về mình.tệp ghi bytes posix(đường, chuoi_bytes_vm(văn_bản), sai, "ghi tệp");
    };

    // Ghi nối tiếp nội dung vào cuối tệp. Append là primitive file I/O; thư viện
    // cấp cao như nhật ký chỉ chịu trách nhiệm dựng nội dung cần ghi.
    hàm công khai ghi nối tệp(đường dẫn, nội dung) {
        đường = mình.tệp chuẩn hóa đường dẫn(đường dẫn);
        văn_bản = thành chuỗi(nội dung);
        trả về mình.tệp ghi bytes posix(đường, chuoi_bytes_vm(văn_bản), đúng, "ghi nối tệp");
    };

    // Đọc/ghi dữ liệu nhị phân dưới dạng danh sách số nguyên 0..255. Đây là
    // primitive file I/O để các codec/archive triển khai format bằng V++ mà không
    // phải đẩy thuật toán định dạng xuống C++.
    hàm công khai đọc bytes tệp(đường dẫn) {
        đường = mình.tệp chuẩn hóa đường dẫn(đường dẫn);
        trả về mình.tệp đọc bytes posix(đường, "đọc bytes tệp");
    };

    hàm công khai ghi bytes tệp(đường dẫn, bytes) {
        đường = mình.tệp chuẩn hóa đường dẫn(đường dẫn);
        dữ_liệu = mình.tệp yêu cầu bytes(bytes);
        trả về mình.tệp ghi bytes posix(đường, dữ_liệu, sai, "ghi bytes tệp");
    };

    // Đếm dòng vật lý; tệp rỗng có 0 dòng.
    hàm công khai đếm dòng tệp(đường dẫn) {
        nội_dung = mình.đọc tệp(đường dẫn);
        n = do_dai(nội_dung);
        nếu (n == 0) {
            trả về 0;
        };

        số_dòng = 0;
        lặp(i = 0; i < n; i++) {
            nếu (nội_dung[i] == "\n") {
                số_dòng = số_dòng + 1;
            };
        };

        // std::getline không tạo thêm một dòng rỗng sau dấu xuống dòng cuối tệp.
        nếu (nội_dung[n - 1] != "\n") {
            số_dòng = số_dòng + 1;
        };
        trả về số_dòng;
    };

    // Đếm từ phân tách bởi ASCII whitespace.
    hàm công khai đếm từ tệp(đường dẫn) {
        nội_dung = mình.đọc tệp(đường dẫn);
        số_từ = 0;
        trong_từ = sai;
        lặp(i = 0; i < do_dai(nội_dung); i++) {
            c = nội_dung[i];
            trắng = c == " " || c == "\t" || c == "\n" || c == "\r";
            nếu (trắng) {
                trong_từ = sai;
            } hoặc {
                nếu (!trong_từ) {
                    số_từ = số_từ + 1;
                    trong_từ = đúng;
                };
            };
        };
        trả về số_từ;
    };
};


hàm công khai tệp chuẩn hóa đường dẫn(đường dẫn) {
    __vpp_adapter = Hệ Tệp();
    trả về __vpp_adapter.tệp chuẩn hóa đường dẫn(đường dẫn);
};

hàm công khai tệp đọc bytes posix(đường, thao_tác) {
    __vpp_adapter = Hệ Tệp();
    trả về __vpp_adapter.tệp đọc bytes posix(đường, thao_tác);
};

hàm công khai tệp ghi bytes posix(đường, bytes, nối, thao_tác) {
    __vpp_adapter = Hệ Tệp();
    trả về __vpp_adapter.tệp ghi bytes posix(đường, bytes, nối, thao_tác);
};

hàm công khai tệp yêu cầu bytes(bytes) {
    __vpp_adapter = Hệ Tệp();
    trả về __vpp_adapter.tệp yêu cầu bytes(bytes);
};

hàm công khai đọc tệp(đường dẫn) {
    __vpp_adapter = Hệ Tệp();
    trả về __vpp_adapter.đọc tệp(đường dẫn);
};

hàm công khai ghi tệp(đường dẫn, nội dung) {
    __vpp_adapter = Hệ Tệp();
    trả về __vpp_adapter.ghi tệp(đường dẫn, nội dung);
};

hàm công khai ghi nối tệp(đường dẫn, nội dung) {
    __vpp_adapter = Hệ Tệp();
    trả về __vpp_adapter.ghi nối tệp(đường dẫn, nội dung);
};

hàm công khai đọc bytes tệp(đường dẫn) {
    __vpp_adapter = Hệ Tệp();
    trả về __vpp_adapter.đọc bytes tệp(đường dẫn);
};

hàm công khai ghi bytes tệp(đường dẫn, bytes) {
    __vpp_adapter = Hệ Tệp();
    trả về __vpp_adapter.ghi bytes tệp(đường dẫn, bytes);
};

hàm công khai đếm dòng tệp(đường dẫn) {
    __vpp_adapter = Hệ Tệp();
    trả về __vpp_adapter.đếm dòng tệp(đường dẫn);
};

hàm công khai đếm từ tệp(đường dẫn) {
    __vpp_adapter = Hệ Tệp();
    trả về __vpp_adapter.đếm từ tệp(đường dẫn);
};
