// Các hàm V++ thay ngoại hàm tệp. máy_tệp_* là primitive opcode của ngôn ngữ:
// compiler phát trực tiếp, runtime nối biểu diễn giá trị với ABI ASM của OS.
nhập gói/lõi/chuyển kiểu;
nhập gói/lõi/bảng mã;

hàm riêng tư tệp thô kiểm tra đường(đường) {
    nếu (loại của(đường) != "chuỗi") { ném "tệp thô: đường dẫn phải là chuỗi"; };
    các byte = bảng mã unicode tám bit mã hóa(đường);
    lặp(i = 0; i < máy ảo lấy độ dài(các byte); i++) {
        nếu (các byte[i] == 0) { ném "đường dẫn không được chứa byte NUL"; };
    };
    trả về đường;
};

hàm riêng tư tệp thô kiểm tra đệm(đệm, đếm, ghi) {
    nếu (loại của(đệm) != "danh sách" || loại của(đếm) != "số nguyên") {
        ném "tệp thô: cần danh sách byte và số lượng nguyên";
    };
    nếu (đếm < 1 || đếm > 65536 || máy ảo lấy độ dài(đệm) != đếm) {
        ném "tệp thô: độ dài đệm phải khớp số byte trong 1..65536";
    };
    nếu (ghi) {
        lặp(i = 0; i < đếm; i++) {
            nếu (loại của(đệm[i]) != "số nguyên" || đệm[i] < 0 || đệm[i] > 255) {
                ném "tệp thô: byte phải là số nguyên trong 0..255";
            };
        };
    };
    trả về đệm;
};

hàm công khai tệp thô mở(đường, chế độ) {
    đường = tệp thô kiểm tra đường(đường);
    nếu (loại của(chế độ) != "số nguyên" || chế độ < 0 || chế độ > 2) {
        ném "tệp thô: chế độ phải là 0 (đọc), 1 (ghi) hoặc 2 (nối)";
    };
    trả về máy tệp mở(đường, chế độ);
};

hàm công khai tệp thô đọc(tệp, đệm, đếm) {
    tệp thô kiểm tra đệm(đệm, đếm, sai);
    trả về máy tệp đọc(tệp, đệm, đếm);
};

hàm công khai tệp thô ghi(tệp, đệm, đếm) {
    tệp thô kiểm tra đệm(đệm, đếm, đúng);
    trả về máy tệp ghi(tệp, đệm, đếm);
};

hàm công khai tệp thô đóng(tệp) {
    trả về máy tệp đóng(tệp);
};

hàm công khai tệp thô dịch(tệp, lệch, mốc) {
    nếu (loại của(mốc) != "số nguyên" || mốc < 0 || mốc > 2) {
        ném "tệp thô: gốc phải là 0, 1 hoặc 2";
    };
    trả về máy tệp dịch(tệp, lệch, mốc);
};

hàm công khai tệp thô vị trí(tệp) {
    trả về máy tệp vị trí(tệp);
};

hàm công khai tệp thô mã lỗi() { trả về máy tệp lỗi(0); };
hàm công khai tệp thô lỗi gián đoạn() { trả về máy tệp lỗi(1); };

hàm công khai tệp thô xóa(đường) {
    trả về máy tệp xóa(tệp thô kiểm tra đường(đường));
};
