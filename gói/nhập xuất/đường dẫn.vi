// Module: nhập xuất.đường dẫn
// Phân tích/nối đường dẫn là logic thuần V++. Chỉ các phép hỏi trạng thái hệ tệp
// ở cuối tệp này đi qua machine intrinsic, không khai báo FFI.

nhập gói.hệ thống.nền tảng.tên nền tảng;
nhập gói.văn bản.chuỗi.độ dài;
nhập gói.văn bản.chuỗi.cắt chuỗi;
nhập gói.văn bản.chuỗi.chuỗi thường;
nhập gói.lõi.chuyển kiểu.thành chuỗi;
nhập gói.lõi.bảng mã.bảng mã unicode tám bit mã hóa;

// Machine kind: POSIX S_IFMT >> 12 hoặc Windows 0=khác, 1=tệp, 2=thư mục.
// Trả -1 khi trạng thái đường dẫn không thể đọc; V++ tự chọn theo liên kết.

// Lớp sở hữu toàn bộ thuật toán của mô-đun; các hàm bên dưới chỉ giữ API cũ.
lớp công khai Tiện Ích Đường Dẫn {
    hàm công khai khởi tạo() {};

    hàm riêng tư đường dẫn kiểm tra byte(đường) {
        các byte = bảng mã unicode tám bit mã hóa(đường);
        lặp(i = 0; i < máy ảo lấy độ dài(các byte); i++) {
            nếu (các byte[i] == 0) { ném "đường dẫn không được chứa byte NUL"; };
        };
        trả về đường;
    };

    hàm công khai đường dẫn loại windows(đường, theo liên kết) {
        mình.đường dẫn kiểm tra byte(đường);
        nếu (theo liên kết) { trả về máy đường loại(đường, 1); };
        trả về máy đường loại(đường, 0);
    };

    hàm riêng tư đường dẫn dấu phân cách() {
        nếu (tên nền tảng() == "windows") {
            trả về "\\";
        };
        trả về "/";
    };

    hàm công khai đường dẫn là phân cách(c) {
        nếu (c == "/") {
            trả về đúng;
        };
        nếu (tên nền tảng() == "windows" && c == "\\") {
            trả về đúng;
        };
        trả về sai;
    };

    // Thuần V++: dùng được trong kiểm thử trên POSIX mà không cần giả lập Win32.
    // Windows có gốc ổ đĩa, UNC và UNC mở rộng (\\?\UNC\máy\share\).
    hàm riêng tư đường dẫn là phân cách windows(c) {
        trả về c == "/" || c == "\\";
    };

    hàm riêng tư đường dẫn gốc windows unc(đường, bắt đầu) {
        n = máy ảo lấy độ dài(đường);
        i = bắt đầu;
        tìm tên máy = đúng;
        khi (i < n && tìm tên máy) {
            nếu (mình.đường dẫn là phân cách windows(đường[i])) {
                tìm tên máy = sai;
            } hoặc {
                i = i + 1;
            };
        };
        nếu (i == bắt đầu || i == n) { trả về bắt đầu; };
        i = i + 1;
        bắt đầu chia sẻ = i;
        tìm chia sẻ = đúng;
        khi (i < n && tìm chia sẻ) {
            nếu (mình.đường dẫn là phân cách windows(đường[i])) {
                tìm chia sẻ = sai;
            } hoặc {
                i = i + 1;
            };
        };
        nếu (i == bắt đầu chia sẻ) { trả về bắt đầu; };
        nếu (i < n) { trả về i + 1; };
        trả về n;
    };

    hàm công khai đường dẫn gốc windows dài(đường) {
        n = máy ảo lấy độ dài(đường);
        nếu (n >= 3) {
            nếu (đường[1] == ":" && mình.đường dẫn là phân cách windows(đường[2])) {
                trả về 3;
            };
        };
        nếu (n >= 2) {
            nếu (mình.đường dẫn là phân cách windows(đường[0]) &&
                mình.đường dẫn là phân cách windows(đường[1])) {
                // \\?\UNC\server\share\ dùng cấu trúc UNC sau tiền tố 8 ký tự.
                nếu (n >= 8) {
                    nếu (đường[2] == "?" &&
                        mình.đường dẫn là phân cách windows(đường[3]) &&
                        chuỗi thường(cắt chuỗi(đường, 4, 3)) == "unc" &&
                        mình.đường dẫn là phân cách windows(đường[7])) {
                        trả về mình.đường dẫn gốc windows unc(đường, 8);
                    };
                };
                trả về mình.đường dẫn gốc windows unc(đường, 2);
            };
        };
        nếu (n > 0) {
            nếu (mình.đường dẫn là phân cách windows(đường[0])) { trả về 1; };
        };
        trả về 0;
    };

    hàm công khai đường dẫn là tuyệt đối(đường dẫn) {
        nếu (máy ảo lấy độ dài(đường dẫn) == 0) {
            trả về sai;
        };
        nếu (mình.đường dẫn là phân cách(đường dẫn[0])) {
            trả về đúng;
        };
        nếu (tên nền tảng() == "windows") {
            nếu (máy ảo lấy độ dài(đường dẫn) >= 3) {
                nếu (đường dẫn[1] == ":") {
                    nếu (mình.đường dẫn là phân cách(đường dẫn[2])) {
                        trả về đúng;
                    };
                };
            };
        };
        trả về sai;
    };

    hàm công khai đường dẫn nối(gốc dữ liệu, phần con) {
        nếu (gốc dữ liệu == "") {
            trả về phần con;
        };
        nếu (mình.đường dẫn là tuyệt đối(phần con)) {
            trả về phần con;
        };

        phân cách = mình.đường dẫn dấu phân cách();
        // Trên Windows cả '/' và '\\' đều hợp lệ. Nối thêm vào đường dẫn
        // đã có dấu phân cách thì giữ nguyên kiểu dấu của phần cha.
        nếu (tên nền tảng() == "windows") {
            lặp(i = máy ảo lấy độ dài(gốc dữ liệu) - 1; i >= 0; i--) {
                nếu (mình.đường dẫn là phân cách(gốc dữ liệu[i])) {
                    phân cách = gốc dữ liệu[i];
                    i = -1;
                };
            };
        };
        nếu (phần con == "") {
            nếu (mình.đường dẫn là phân cách(gốc dữ liệu[máy ảo lấy độ dài(gốc dữ liệu) - 1])) {
                trả về gốc dữ liệu;
            };
            trả về gốc dữ liệu + phân cách;
        };

        nếu (mình.đường dẫn là phân cách(gốc dữ liệu[máy ảo lấy độ dài(gốc dữ liệu) - 1])) {
            trả về gốc dữ liệu + phần con;
        };
        trả về gốc dữ liệu + phân cách + phần con;
    };

    hàm công khai đường dẫn tên(đường dẫn) {
        n = máy ảo lấy độ dài(đường dẫn);
        nếu (n == 0 || mình.đường dẫn là phân cách(đường dẫn[n - 1])) {
            trả về "";
        };

        bắt đầu = 0;
        lặp(i = n - 1; i >= 0; i--) {
            nếu (mình.đường dẫn là phân cách(đường dẫn[i])) {
                bắt đầu = i + 1;
                i = -1;
            };
        };
        trả về cắt chuỗi(đường dẫn, bắt đầu, n - bắt đầu);
    };

    hàm riêng tư đường dẫn cha nội bộ(đường dẫn, độ dài gốc) {
        n = máy ảo lấy độ dài(đường dẫn);
        nếu (n == 0) {
            trả về "";
        };

        kết thúc = n;
        mức tối thiểu = 1;
        nếu (độ dài gốc > mức tối thiểu) { mức tối thiểu = độ dài gốc; };
        khi (kết thúc > mức tối thiểu && mình.đường dẫn là phân cách(đường dẫn[kết thúc - 1])) {
            kết thúc = kết thúc - 1;
        };

        nếu (kết thúc < n) {
            trả về cắt chuỗi(đường dẫn, 0, kết thúc);
        };

        nếu (độ dài gốc > 0 && kết thúc <= độ dài gốc) {
            trả về cắt chuỗi(đường dẫn, 0, độ dài gốc);
        };

        vị trí = -1;
        lặp(i = kết thúc - 1; i >= 0; i--) {
            nếu (mình.đường dẫn là phân cách(đường dẫn[i])) {
                vị trí = i;
                i = -1;
            };
        };

        nếu (vị trí < 0) {
            trả về "";
        };
        nếu (độ dài gốc > 0 && vị trí < độ dài gốc) {
            trả về cắt chuỗi(đường dẫn, 0, độ dài gốc);
        };
        nếu (vị trí == 0) {
            trả về mình.đường dẫn dấu phân cách();
        };
        trả về cắt chuỗi(đường dẫn, 0, vị trí);
    };

    hàm công khai đường dẫn cha windows(đường) {
        // Không dựa vào OS hiện tại: phép toán lexical này kiểm thử được trên macOS.
        gốc dữ liệu = mình.đường dẫn gốc windows dài(đường);
        n = máy ảo lấy độ dài(đường);
        nếu (n == 0) { trả về ""; };
        kết thúc = n;
        tối thiểu = 1;
        nếu (gốc dữ liệu > tối thiểu) { tối thiểu = gốc dữ liệu; };
        khi (kết thúc > tối thiểu && mình.đường dẫn là phân cách windows(đường[kết thúc - 1])) {
            kết thúc = kết thúc - 1;
        };
        nếu (kết thúc < n) { trả về cắt chuỗi(đường, 0, kết thúc); };
        nếu (gốc dữ liệu > 0 && kết thúc <= gốc dữ liệu) { trả về cắt chuỗi(đường, 0, gốc dữ liệu); };
        vị trí = -1;
        lặp(i = kết thúc - 1; i >= 0; i--) {
            nếu (mình.đường dẫn là phân cách windows(đường[i])) {
                vị trí = i;
                i = -1;
            };
        };
        nếu (vị trí < 0) { trả về ""; };
        nếu (gốc dữ liệu > 0 && vị trí < gốc dữ liệu) { trả về cắt chuỗi(đường, 0, gốc dữ liệu); };
        nếu (vị trí == 0) { trả về cắt chuỗi(đường, 0, 1); };
        trả về cắt chuỗi(đường, 0, vị trí);
    };

    hàm công khai đường dẫn cha(đường dẫn) {
        nếu (tên nền tảng() == "windows") { trả về mình.đường dẫn cha windows(đường dẫn); };
        gốc dữ liệu = 0;
        nếu (máy ảo lấy độ dài(đường dẫn) > 0 && đường dẫn[0] == "/") { gốc dữ liệu = 1; };
        trả về mình.đường dẫn cha nội bộ(đường dẫn, gốc dữ liệu);
    };

    hàm công khai đường dẫn tồn tại(đường dẫn) {
        đường = thành chuỗi(đường dẫn);
        nếu (tên nền tảng() == "windows") {
            trả về mình.đường dẫn loại windows(đường, đúng) >= 0;
        };
        mình.đường dẫn kiểm tra byte(đường);
        trả về máy đường loại(đường, 1) >= 0;
    };

    // POSIX kernel/host trả struct stat phụ thuộc ABI; machine adapter đọc
    // st_mode và trả mã loại chuẩn 0..15 cho V++.
    hàm công khai đường dẫn loại posix(đường, theo liên kết) {
        mình.đường dẫn kiểm tra byte(đường);
        nếu (theo liên kết) {
            trả về máy đường loại(đường, 1);
        };
        trả về máy đường loại(đường, 0);
    };

    hàm công khai là tệp(đường dẫn) {
        đường = thành chuỗi(đường dẫn);
        nếu (tên nền tảng() == "windows") {
            trả về mình.đường dẫn loại windows(đường, đúng) == 1;
        };
        trả về mình.đường dẫn loại posix(đường, đúng) == 8;
    };

    hàm công khai là thư mục(đường dẫn) {
        đường = thành chuỗi(đường dẫn);
        nếu (tên nền tảng() == "windows") {
            trả về mình.đường dẫn loại windows(đường, đúng) == 2;
        };
        trả về mình.đường dẫn loại posix(đường, đúng) == 4;
    };
};


hàm công khai đường dẫn loại windows(đường, theo liên kết) {
    bộ chuyển tiếp = Tiện Ích Đường Dẫn();
    trả về bộ chuyển tiếp.đường dẫn loại windows(đường, theo liên kết);
};

hàm công khai đường dẫn là phân cách(c) {
    bộ chuyển tiếp = Tiện Ích Đường Dẫn();
    trả về bộ chuyển tiếp.đường dẫn là phân cách(c);
};

hàm công khai đường dẫn gốc windows dài(đường) {
    bộ chuyển tiếp = Tiện Ích Đường Dẫn();
    trả về bộ chuyển tiếp.đường dẫn gốc windows dài(đường);
};

hàm công khai đường dẫn là tuyệt đối(đường dẫn) {
    bộ chuyển tiếp = Tiện Ích Đường Dẫn();
    trả về bộ chuyển tiếp.đường dẫn là tuyệt đối(đường dẫn);
};

hàm công khai đường dẫn nối(gốc, phần con) {
    bộ chuyển tiếp = Tiện Ích Đường Dẫn();
    trả về bộ chuyển tiếp.đường dẫn nối(gốc, phần con);
};

hàm công khai đường dẫn tên(đường dẫn) {
    bộ chuyển tiếp = Tiện Ích Đường Dẫn();
    trả về bộ chuyển tiếp.đường dẫn tên(đường dẫn);
};

hàm công khai đường dẫn cha windows(đường) {
    bộ chuyển tiếp = Tiện Ích Đường Dẫn();
    trả về bộ chuyển tiếp.đường dẫn cha windows(đường);
};

hàm công khai đường dẫn cha(đường dẫn) {
    bộ chuyển tiếp = Tiện Ích Đường Dẫn();
    trả về bộ chuyển tiếp.đường dẫn cha(đường dẫn);
};

hàm công khai đường dẫn tồn tại(đường dẫn) {
    bộ chuyển tiếp = Tiện Ích Đường Dẫn();
    trả về bộ chuyển tiếp.đường dẫn tồn tại(đường dẫn);
};

hàm công khai đường dẫn loại posix(đường, theo liên kết) {
    bộ chuyển tiếp = Tiện Ích Đường Dẫn();
    trả về bộ chuyển tiếp.đường dẫn loại posix(đường, theo liên kết);
};

hàm công khai là tệp(đường dẫn) {
    bộ chuyển tiếp = Tiện Ích Đường Dẫn();
    trả về bộ chuyển tiếp.là tệp(đường dẫn);
};

hàm công khai là thư mục(đường dẫn) {
    bộ chuyển tiếp = Tiện Ích Đường Dẫn();
    trả về bộ chuyển tiếp.là thư mục(đường dẫn);
};
