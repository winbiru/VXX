// Module: nhập xuất.đường dẫn
// Phân tích/nối đường dẫn là logic thuần V++. Chỉ các phép hỏi trạng thái hệ tệp
// ở cuối tệp này đi qua machine intrinsic, không khai báo FFI.

nhập gói/hệ thống/nền tảng;
nhập gói/văn bản/chuỗi;
nhập gói/lõi/chuyển kiểu;
nhập gói/lõi/bảng mã;

// Machine kind: POSIX S_IFMT >> 12 hoặc Windows 0=khác, 1=tệp, 2=thư mục.
// Trả -1 khi trạng thái đường dẫn không thể đọc; V++ tự chọn theo liên kết.

// Lớp sở hữu toàn bộ thuật toán của mô-đun; các hàm bên dưới chỉ giữ API cũ.
lớp công khai Tiện Ích Đường Dẫn {
    hàm công khai khởi tạo() {};

    hàm riêng tư đường dẫn kiểm tra byte(đường) {
        bytes = bảng mã utf8 mã hóa(đường);
        lặp(i = 0; i < do_dai(bytes); i++) {
            nếu (bytes[i] == 0) { ném "đường dẫn không được chứa byte NUL"; };
        };
        trả về đường;
    };

    hàm công khai đường dẫn loại windows(đường, theo_liên_kết) {
        mình.đường dẫn kiểm tra byte(đường);
        nếu (theo_liên_kết) { trả về máy_đường_loại(đường, 1); };
        trả về máy_đường_loại(đường, 0);
    };

    hàm riêng tư đường dẫn dấu phân cách() {
        nếu (tên nền tảng() == "windows") {
            trả về "\\";
        };
        trả về "/";
    };

    hàm công khai đường dẫn là phân cách(c) {
        nếu (c == "/") {
            trả về đúng;
        };
        nếu (tên nền tảng() == "windows" && c == "\\") {
            trả về đúng;
        };
        trả về sai;
    };

    // Thuần V++: dùng được trong kiểm thử trên POSIX mà không cần giả lập Win32.
    // Windows có gốc ổ đĩa, UNC và UNC mở rộng (\\?\UNC\máy\share\).
    hàm riêng tư đường dẫn là phân cách windows(c) {
        trả về c == "/" || c == "\\";
    };

    hàm riêng tư đường dẫn gốc windows unc(đường, bắt_đầu) {
        n = do_dai(đường);
        i = bắt_đầu;
        tìm_tên_máy = đúng;
        lặp(vòng = 0; i < n && tìm_tên_máy; vòng++) {
            nếu (mình.đường dẫn là phân cách windows(đường[i])) {
                tìm_tên_máy = sai;
            } hoặc {
                i = i + 1;
            };
        };
        nếu (i == bắt_đầu || i == n) { trả về bắt_đầu; };
        i = i + 1;
        bắt_đầu_share = i;
        tìm_share = đúng;
        lặp(vòng = 0; i < n && tìm_share; vòng++) {
            nếu (mình.đường dẫn là phân cách windows(đường[i])) {
                tìm_share = sai;
            } hoặc {
                i = i + 1;
            };
        };
        nếu (i == bắt_đầu_share) { trả về bắt_đầu; };
        nếu (i < n) { trả về i + 1; };
        trả về n;
    };

    hàm công khai đường dẫn gốc windows dài(đường) {
        n = do_dai(đường);
        nếu (n >= 3) {
            nếu (đường[1] == ":" && mình.đường dẫn là phân cách windows(đường[2])) {
                trả về 3;
            };
        };
        nếu (n >= 2) {
            nếu (mình.đường dẫn là phân cách windows(đường[0]) &&
                mình.đường dẫn là phân cách windows(đường[1])) {
                // \\?\UNC\server\share\ dùng cấu trúc UNC sau tiền tố 8 ký tự.
                nếu (n >= 8) {
                    nếu (đường[2] == "?" &&
                        mình.đường dẫn là phân cách windows(đường[3]) &&
                        chuỗi thường(cắt chuỗi(đường, 4, 3)) == "unc" &&
                        mình.đường dẫn là phân cách windows(đường[7])) {
                        trả về mình.đường dẫn gốc windows unc(đường, 8);
                    };
                };
                trả về mình.đường dẫn gốc windows unc(đường, 2);
            };
        };
        nếu (n > 0) {
            nếu (mình.đường dẫn là phân cách windows(đường[0])) { trả về 1; };
        };
        trả về 0;
    };

    hàm công khai đường dẫn là tuyệt đối(đường dẫn) {
        nếu (do_dai(đường dẫn) == 0) {
            trả về sai;
        };
        nếu (mình.đường dẫn là phân cách(đường dẫn[0])) {
            trả về đúng;
        };
        nếu (tên nền tảng() == "windows") {
            nếu (do_dai(đường dẫn) >= 3) {
                nếu (đường dẫn[1] == ":") {
                    nếu (mình.đường dẫn là phân cách(đường dẫn[2])) {
                        trả về đúng;
                    };
                };
            };
        };
        trả về sai;
    };

    hàm công khai đường dẫn nối(gốc_dữ_liệu, phần con) {
        nếu (gốc_dữ_liệu == "") {
            trả về phần con;
        };
        nếu (mình.đường dẫn là tuyệt đối(phần con)) {
            trả về phần con;
        };

        phân_cách = mình.đường dẫn dấu phân cách();
        // Trên Windows cả '/' và '\\' đều hợp lệ. Nối thêm vào đường dẫn
        // đã có dấu phân cách thì giữ nguyên kiểu dấu của phần cha.
        nếu (tên nền tảng() == "windows") {
            lặp(i = do_dai(gốc_dữ_liệu) - 1; i >= 0; i--) {
                nếu (mình.đường dẫn là phân cách(gốc_dữ_liệu[i])) {
                    phân_cách = gốc_dữ_liệu[i];
                    i = -1;
                };
            };
        };
        nếu (phần con == "") {
            nếu (mình.đường dẫn là phân cách(gốc_dữ_liệu[do_dai(gốc_dữ_liệu) - 1])) {
                trả về gốc_dữ_liệu;
            };
            trả về gốc_dữ_liệu + phân_cách;
        };

        nếu (mình.đường dẫn là phân cách(gốc_dữ_liệu[do_dai(gốc_dữ_liệu) - 1])) {
            trả về gốc_dữ_liệu + phần con;
        };
        trả về gốc_dữ_liệu + phân_cách + phần con;
    };

    hàm công khai đường dẫn tên(đường dẫn) {
        n = do_dai(đường dẫn);
        nếu (n == 0 || mình.đường dẫn là phân cách(đường dẫn[n - 1])) {
            trả về "";
        };

        bắt_đầu = 0;
        lặp(i = n - 1; i >= 0; i--) {
            nếu (mình.đường dẫn là phân cách(đường dẫn[i])) {
                bắt_đầu = i + 1;
                i = -1;
            };
        };
        trả về cắt chuỗi(đường dẫn, bắt_đầu, n - bắt_đầu);
    };

    hàm riêng tư đường dẫn cha nội bộ(đường dẫn, độ_dài_gốc) {
        n = do_dai(đường dẫn);
        nếu (n == 0) {
            trả về "";
        };

        kết_thúc = n;
        mức_tối_thiểu = 1;
        nếu (độ_dài_gốc > mức_tối_thiểu) { mức_tối_thiểu = độ_dài_gốc; };
        lặp(vòng = 0; kết_thúc > mức_tối_thiểu && mình.đường dẫn là phân cách(đường dẫn[kết_thúc - 1]); vòng++) {
            kết_thúc = kết_thúc - 1;
        };

        nếu (kết_thúc < n) {
            trả về cắt chuỗi(đường dẫn, 0, kết_thúc);
        };

        nếu (độ_dài_gốc > 0 && kết_thúc <= độ_dài_gốc) {
            trả về cắt chuỗi(đường dẫn, 0, độ_dài_gốc);
        };

        vị_trí = -1;
        lặp(i = kết_thúc - 1; i >= 0; i--) {
            nếu (mình.đường dẫn là phân cách(đường dẫn[i])) {
                vị_trí = i;
                i = -1;
            };
        };

        nếu (vị_trí < 0) {
            trả về "";
        };
        nếu (độ_dài_gốc > 0 && vị_trí < độ_dài_gốc) {
            trả về cắt chuỗi(đường dẫn, 0, độ_dài_gốc);
        };
        nếu (vị_trí == 0) {
            trả về mình.đường dẫn dấu phân cách();
        };
        trả về cắt chuỗi(đường dẫn, 0, vị_trí);
    };

    hàm công khai đường dẫn cha windows(đường) {
        // Không dựa vào OS hiện tại: phép toán lexical này kiểm thử được trên macOS.
        gốc_dữ_liệu = mình.đường dẫn gốc windows dài(đường);
        n = do_dai(đường);
        nếu (n == 0) { trả về ""; };
        kết_thúc = n;
        tối_thiểu = 1;
        nếu (gốc_dữ_liệu > tối_thiểu) { tối_thiểu = gốc_dữ_liệu; };
        lặp(vòng = 0; kết_thúc > tối_thiểu && mình.đường dẫn là phân cách windows(đường[kết_thúc - 1]); vòng++) {
            kết_thúc = kết_thúc - 1;
        };
        nếu (kết_thúc < n) { trả về cắt chuỗi(đường, 0, kết_thúc); };
        nếu (gốc_dữ_liệu > 0 && kết_thúc <= gốc_dữ_liệu) { trả về cắt chuỗi(đường, 0, gốc_dữ_liệu); };
        vị_trí = -1;
        lặp(i = kết_thúc - 1; i >= 0; i--) {
            nếu (mình.đường dẫn là phân cách windows(đường[i])) {
                vị_trí = i;
                i = -1;
            };
        };
        nếu (vị_trí < 0) { trả về ""; };
        nếu (gốc_dữ_liệu > 0 && vị_trí < gốc_dữ_liệu) { trả về cắt chuỗi(đường, 0, gốc_dữ_liệu); };
        nếu (vị_trí == 0) { trả về cắt chuỗi(đường, 0, 1); };
        trả về cắt chuỗi(đường, 0, vị_trí);
    };

    hàm công khai đường dẫn cha(đường dẫn) {
        nếu (tên nền tảng() == "windows") { trả về mình.đường dẫn cha windows(đường dẫn); };
        gốc_dữ_liệu = 0;
        nếu (do_dai(đường dẫn) > 0 && đường dẫn[0] == "/") { gốc_dữ_liệu = 1; };
        trả về mình.đường dẫn cha nội bộ(đường dẫn, gốc_dữ_liệu);
    };

    hàm công khai đường dẫn tồn tại(đường dẫn) {
        đường = thành chuỗi(đường dẫn);
        nếu (tên nền tảng() == "windows") {
            trả về mình.đường dẫn loại windows(đường, đúng) >= 0;
        };
        mình.đường dẫn kiểm tra byte(đường);
        trả về máy_đường_loại(đường, 1) >= 0;
    };

    // POSIX kernel/host trả struct stat phụ thuộc ABI; machine adapter đọc
    // st_mode và trả mã loại chuẩn 0..15 cho V++.
    hàm công khai đường dẫn loại posix(đường, theo_liên_kết) {
        mình.đường dẫn kiểm tra byte(đường);
        nếu (theo_liên_kết) {
            trả về máy_đường_loại(đường, 1);
        };
        trả về máy_đường_loại(đường, 0);
    };

    hàm công khai là tệp(đường dẫn) {
        đường = thành chuỗi(đường dẫn);
        nếu (tên nền tảng() == "windows") {
            trả về mình.đường dẫn loại windows(đường, đúng) == 1;
        };
        trả về mình.đường dẫn loại posix(đường, đúng) == 8;
    };

    hàm công khai là thư mục(đường dẫn) {
        đường = thành chuỗi(đường dẫn);
        nếu (tên nền tảng() == "windows") {
            trả về mình.đường dẫn loại windows(đường, đúng) == 2;
        };
        trả về mình.đường dẫn loại posix(đường, đúng) == 4;
    };
};


hàm công khai đường dẫn loại windows(đường, theo_liên_kết) {
    __vpp_adapter = Tiện Ích Đường Dẫn();
    trả về __vpp_adapter.đường dẫn loại windows(đường, theo_liên_kết);
};

hàm công khai đường dẫn là phân cách(c) {
    __vpp_adapter = Tiện Ích Đường Dẫn();
    trả về __vpp_adapter.đường dẫn là phân cách(c);
};

hàm công khai đường dẫn gốc windows dài(đường) {
    __vpp_adapter = Tiện Ích Đường Dẫn();
    trả về __vpp_adapter.đường dẫn gốc windows dài(đường);
};

hàm công khai đường dẫn là tuyệt đối(đường dẫn) {
    __vpp_adapter = Tiện Ích Đường Dẫn();
    trả về __vpp_adapter.đường dẫn là tuyệt đối(đường dẫn);
};

hàm công khai đường dẫn nối(gốc, phần con) {
    __vpp_adapter = Tiện Ích Đường Dẫn();
    trả về __vpp_adapter.đường dẫn nối(gốc, phần con);
};

hàm công khai đường dẫn tên(đường dẫn) {
    __vpp_adapter = Tiện Ích Đường Dẫn();
    trả về __vpp_adapter.đường dẫn tên(đường dẫn);
};

hàm công khai đường dẫn cha windows(đường) {
    __vpp_adapter = Tiện Ích Đường Dẫn();
    trả về __vpp_adapter.đường dẫn cha windows(đường);
};

hàm công khai đường dẫn cha(đường dẫn) {
    __vpp_adapter = Tiện Ích Đường Dẫn();
    trả về __vpp_adapter.đường dẫn cha(đường dẫn);
};

hàm công khai đường dẫn tồn tại(đường dẫn) {
    __vpp_adapter = Tiện Ích Đường Dẫn();
    trả về __vpp_adapter.đường dẫn tồn tại(đường dẫn);
};

hàm công khai đường dẫn loại posix(đường, theo_liên_kết) {
    __vpp_adapter = Tiện Ích Đường Dẫn();
    trả về __vpp_adapter.đường dẫn loại posix(đường, theo_liên_kết);
};

hàm công khai là tệp(đường dẫn) {
    __vpp_adapter = Tiện Ích Đường Dẫn();
    trả về __vpp_adapter.là tệp(đường dẫn);
};

hàm công khai là thư mục(đường dẫn) {
    __vpp_adapter = Tiện Ích Đường Dẫn();
    trả về __vpp_adapter.là thư mục(đường dẫn);
};
