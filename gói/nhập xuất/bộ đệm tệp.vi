// Thay stdio của libc bằng V++: đệm, EOF, partial I/O và cursor logic.
// Native chỉ giữ open/read/write/seek/tell/close của OS và token thuộc VM.
nhập gói/lõi/chuyển kiểu;
nhập gói/lõi/bảng mã;
nhập gói/lõi/giao diện tài nguyên;

nhập gói/nhập xuất/tệp thô;

lớp công khai Bộ Đệm Tệp triển khai Đóng Được {
    hàm công khai khởi tạo(đường, chế độ, kích thước = 4096, thao tác = "luồng tệp") {
        đường = thành chuỗi(đường);
        đường các byte = bảng mã unicode tám bit mã hóa(đường);
        lặp(i = 0; i < máy ảo lấy độ dài(đường các byte); i++) {
            nếu (đường các byte[i] == 0) { ném "đường dẫn không được chứa byte NUL"; };
        };
        nếu (loại của(kích thước) != "số nguyên" || kích thước < 1 || kích thước > 65536) {
            ném "luồng tệp: kích thước đệm phải trong 1..65536";
        };
        mã = -1;
        nếu (chế độ == "đọc") { mã = 0; };
        nếu (chế độ == "ghi") { mã = 1; };
        nếu (chế độ == "nối") { mã = 2; };
        nếu (mã < 0) { ném "luồng tệp: chế độ phải là đọc, ghi hoặc nối"; };
        mình.đường = đường;
        mình.thao tác = thao tác;
        mình.chế độ = chế độ;
        mình.kích thước = kích thước;
        mình.đệm đọc = [];
        mình.số đọc = 0;
        mình.vị trí đọc = 0;
        mình.hết tệp = sai;
        mình.đệm ghi = [];
        mình.đã ghi = 0;
        mình.đã đóng = đúng;
        mình.lỗi gián đoạn = tệp thô lỗi gián đoạn();
        mã tài nguyên = rỗng;
        khi (đúng) {
            mã tài nguyên = tệp thô mở(đường, mã);
            nếu (mã tài nguyên != rỗng) { thoát; };
            nếu (tệp thô mã lỗi() != mình.lỗi gián đoạn) {
                thông báo mở = "không thể mở tệp để ghi";
                nếu (mã == 0) { thông báo mở = "không thể mở tệp để đọc"; };
                mình.báo lỗi("mở", "FILE_OPEN_FAILED", thông báo mở);
            };
        };
        mình.mã tài nguyên = mã tài nguyên;
        mình.đã đóng = sai;
    };

    hàm riêng tư báo lỗi(giải đoạn, mã, thông báo) {
        mã lỗi = tệp thô mã lỗi();
        lỗi = {"loại": "lỗi hệ thống tệp", "mã": mã,
            "thao tác": mình.thao tác, "giai đoạn": giải đoạn,
            "đường dẫn": mình.đường, "errno": mã lỗi,
            "thông báo": mình.thao tác + ": " + thông báo};
        ném lỗi;
    };

    hàm riêng tư yêu cầu mở() {
        nếu (mình.đã đóng) { ném "luồng tệp: đã đóng"; };
    };

    hàm công khai đang mở() { trả về !mình.đã đóng; };

    hàm công khai đọc các byte(đếm) {
        mình.yêu cầu mở();
        nếu (mình.chế độ != "đọc") { ném "luồng tệp: không ở chế độ đọc"; };
        nếu (loại của(đếm) != "số nguyên" || đếm < 0 || đếm > 65536) {
            ném "luồng tệp: số byte phải trong 0..65536";
        };
        kết quả = [];
        khi (máy ảo lấy độ dài(kết quả) < đếm) {
            nếu (mình.vị trí đọc == mình.số đọc) {
                nếu (mình.hết tệp) { thoát; };
                nếu (máy ảo lấy độ dài(mình.đệm đọc) == 0) {
                    lặp(i = 0; i < mình.kích thước; i++) { máy ảo thêm cuối danh sách(mình.đệm đọc, 0); };
                };
                n = tệp thô đọc(mình.mã tài nguyên, mình.đệm đọc, mình.kích thước);
                nếu (n < 0) {
                    nếu (tệp thô mã lỗi() == mình.lỗi gián đoạn) { bỏ qua; };
                    mình.báo lỗi("đọc", "FILE_READ_FAILED", "không thể đọc tệp");
                };
                mình.vị trí đọc = 0;
                mình.số đọc = n;
                nếu (n == 0) { mình.hết tệp = đúng; thoát; };
            };
            còn = đếm - máy ảo lấy độ dài(kết quả);
            sẵn = mình.số đọc - mình.vị trí đọc;
            nếu (còn > sẵn) { còn = sẵn; };
            lặp(i = 0; i < còn; i++) {
                máy ảo thêm cuối danh sách(kết quả, mình.đệm đọc[mình.vị trí đọc + i]);
            };
            mình.vị trí đọc = mình.vị trí đọc + còn;
        };
        trả về kết quả;
    };

    hàm công khai đọc hết() {
        kết quả = [];
        khi (đúng) {
            khối = mình.đọc các byte(4096);
            nếu (máy ảo lấy độ dài(khối) == 0) { thoát; };
            lặp(i = 0; i < máy ảo lấy độ dài(khối); i++) { máy ảo thêm cuối danh sách(kết quả, khối[i]); };
        };
        trả về chuỗi từ byte máy ảo(kết quả);
    };

    hàm công khai ghi các byte(các byte) {
        mình.yêu cầu mở();
        nếu (mình.chế độ == "đọc") { ném "luồng tệp: không ở chế độ ghi"; };
        nếu (loại của(các byte) != "danh sách") { ném "ghi bytes tệp: cần danh sách bytes"; };
        // Validate the whole input before accepting any bytes.
        lặp(i = 0; i < máy ảo lấy độ dài(các byte); i++) {
            nếu (loại của(các byte[i]) != "số nguyên" || các byte[i] < 0 || các byte[i] > 255) {
                ném "ghi bytes tệp: byte phải là số nguyên trong 0..255";
            };
        };
        lặp(i = 0; i < máy ảo lấy độ dài(các byte); i++) {
            nếu (máy ảo lấy độ dài(mình.đệm ghi) == mình.kích thước) { mình.đẩy đệm(); };
            máy ảo thêm cuối danh sách(mình.đệm ghi, các byte[i]);
            nếu (máy ảo lấy độ dài(mình.đệm ghi) == mình.kích thước) { mình.đẩy đệm(); };
        };
        trả về 1;
    };

    hàm công khai ghi(nội dung) {
        trả về mình.ghi các byte(chuỗi thành byte máy ảo(thành chuỗi(nội dung)));
    };

    hàm công khai đẩy đệm() {
        mình.yêu cầu mở();
        nếu (mình.chế độ == "đọc") { ném "luồng tệp: không ở chế độ ghi"; };
        // Preserve the accepted prefix across errors to avoid duplicate writes.
        khi (mình.đã ghi < máy ảo lấy độ dài(mình.đệm ghi)) {
            đệm = mình.đệm ghi;
            nếu (mình.đã ghi > 0) {
                đệm = [];
                lặp(i = mình.đã ghi; i < máy ảo lấy độ dài(mình.đệm ghi); i++) { máy ảo thêm cuối danh sách(đệm, mình.đệm ghi[i]); };
            };
            n = tệp thô ghi(mình.mã tài nguyên, đệm, máy ảo lấy độ dài(đệm));
            nếu (n < 0 && tệp thô mã lỗi() == mình.lỗi gián đoạn) { bỏ qua; };
            nếu (n <= 0 || n > máy ảo lấy độ dài(đệm)) {
                mình.báo lỗi("ghi", "FILE_WRITE_FAILED", "không thể ghi tệp");
            };
            mình.đã ghi = mình.đã ghi + n;
        };
        mình.đệm ghi = [];
        mình.đã ghi = 0;
        trả về đúng;
    };

    hàm công khai vị trí() {
        mình.yêu cầu mở();
        nếu (mình.chế độ == "nối") { mình.đẩy đệm(); };
        n = tệp thô vị trí(mình.mã tài nguyên);
        nếu (n < 0) { mình.báo lỗi("vị trí", "FILE_TELL_FAILED", "không đọc được vị trí"); };
        nếu (mình.chế độ == "đọc") { trả về n - (mình.số đọc - mình.vị trí đọc); };
        trả về n + (máy ảo lấy độ dài(mình.đệm ghi) - mình.đã ghi);
    };

    hàm công khai dịch(lệch, mốc = 0) {
        mình.yêu cầu mở();
        nếu (loại của(mốc) != "số nguyên" || mốc < 0 || mốc > 2) {
            ném "luồng tệp: gốc phải là 0, 1 hoặc 2";
        };
        nếu (mình.chế độ != "đọc") { mình.đẩy đệm(); };
        chưa đọc = mình.số đọc - mình.vị trí đọc;
        nếu (chưa đọc > 0) {
            nếu (tệp thô dịch(mình.mã tài nguyên, 0 - chưa đọc, 1) < 0) {
                mình.báo lỗi("dịch", "FILE_SEEK_FAILED", "không thể dịch vị trí");
            };
        };
        mình.vị trí đọc = 0;
        mình.số đọc = 0;
        mình.hết tệp = sai;
        nếu (tệp thô dịch(mình.mã tài nguyên, lệch, mốc) < 0) {
            mình.báo lỗi("dịch", "FILE_SEEK_FAILED", "không thể dịch vị trí");
        };
        trả về đúng;
    };

    hàm công khai đóng() {
        nếu (mình.đã đóng) { trả về đúng; };
        thử {
            nếu (mình.chế độ != "đọc") { mình.đẩy đệm(); };
        } bắt lỗi(e) {
            // Flush failure still releases the resource and keeps the original error.
            mình.đã đóng = đúng;
            mã tài nguyên = mình.mã tài nguyên;
            mình.mã tài nguyên = rỗng;
            tệp thô đóng(mã tài nguyên);
            ném e;
        };
        mình.đã đóng = đúng;
        mã tài nguyên = mình.mã tài nguyên;
        mình.mã tài nguyên = rỗng;
        nếu (tệp thô đóng(mã tài nguyên) != 0) {
            mình.báo lỗi("đóng", "FILE_CLOSE_FAILED", "không thể đóng tệp");
        };
        trả về đúng;
    };
};
