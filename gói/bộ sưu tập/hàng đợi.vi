nhập gói/bộ sưu tập/bộ đệm danh sách;

// FIFO: đầu đọc độc lập cho từng instance; nén sau khi dùng nửa bộ đệm.
lớp công khai Hàng Đợi kế thừa Bộ Đệm Danh Sách {
    hàm công khai khởi tạo() { gốc.khởi tạo(); mình.đầu = 0; };
    hàm công khai số lượng() { trả về máy ảo lấy độ dài(mình.phần tử) - mình.đầu; };
    hàm công khai thêm(giá trị) {
        máy ảo thêm cuối danh sách(mình.phần tử, giá trị);
        trả về mình.số lượng();
    };
    hàm công khai đầu() {
        nếu (mình.trống()) { ném "hàng đợi: không có phần tử"; };
        danh sách đầu vào = mình.phần tử;
        trả về danh sách đầu vào[mình.đầu];
    };
    hàm công khai lấy() {
        kết quả = mình.đầu();
        mình.đầu = mình.đầu + 1;
        nếu (mình.đầu * 2 >= máy ảo lấy độ dài(mình.phần tử)) {
            mới = [];
            danh sách đầu vào = mình.phần tử;
            lặp(i = mình.đầu; i < máy ảo lấy độ dài(danh sách đầu vào); i++) { máy ảo thêm cuối danh sách(mới, danh sách đầu vào[i]); };
            mình.phần tử = mới;
            mình.đầu = 0;
        };
        trả về kết quả;
    };
};
