nhập gói.bộ sưu tập.giao diện.*;
nhập gói.bộ sưu tập.từ điển.*;

lớp công khai Từ Điển triển khai Bộ Chứa {
    hàm công khai khởi tạo() { mình.bảng = {}; };
    hàm công khai số lượng() { trả về máy ảo lấy độ dài(khóa từ điển(mình.bảng)); };
    hàm công khai trống() { trả về mình.số lượng() == 0; };
    hàm công khai đặt(khóa, giá trị) { đặt từ điển(mình.bảng, khóa, giá trị); };
    hàm công khai lấy(khóa, mặc định = rỗng) { trả về lấy từ điển(mình.bảng, khóa, mặc định); };
    hàm công khai chứa(khóa) { trả về máy ảo có khóa từ điển(mình.bảng, khóa); };
    hàm công khai xóa(khóa) { trả về máy ảo xóa khóa từ điển(mình.bảng, khóa); };
    hàm công khai các khóa() { trả về khóa từ điển(mình.bảng); };
};
