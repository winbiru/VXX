// Module: lõi.danh sách
// List MVP: literal, length, read/write index và append/xóa vật lý là primitive runtime.
// Các thuật toán collection còn lại được triển khai trực tiếp bằng V++.

nhập gói.lõi.trình tự.*;
nhập gói.lõi.chuyển kiểu.loại của;

// Chỉ dùng merge sort khi mọi phép so sánh đều có thứ tự toàn phần.
// Các kiểu hỗn hợp / số thực giữ thuật toán cũ và thứ tự phát sinh lỗi.
hàm riêng tư danh sách có thứ tự toàn phần(ds, n) {
    nếu (loại của(ds) != "danh sách") { trả về sai; };
    kiểu = loại của(ds[0]);
    nếu (kiểu != "số nguyên" && kiểu != "chuỗi") { trả về sai; };
    lặp(k = 1; k < n; k++) {
        nếu (loại của(ds[k]) != kiểu) { trả về sai; };
    };
    trả về đúng;
};

// Merge ổn định: chọn bên trái khi bằng nhau; luôn sửa chính list ban đầu.
hàm riêng tư danh sách trộn ổn định(ds, n) {
    đệm = [];
    lặp(k = 0; k < n; k++) { máy ảo thêm cuối danh sách(đệm, rỗng); };
    nguồn = ds; đích = đệm; rộng = 1; ở đệm = sai;
    khi (rộng < n) {
        đầu = 0;
        khi (đầu < n) {
            giữa = n;
            nếu (rộng < n - đầu) { giữa = đầu + rộng; };
            cuối = n;
            nếu (rộng < n - giữa) { cuối = giữa + rộng; };
            trái = đầu; phải = giữa; k = đầu;
            khi (trái < giữa && phải < cuối) {
                a = nguồn[trái]; b = nguồn[phải];
                nếu (a > b) { đích[k] = b; phải = phải + 1; }
                hoặc { đích[k] = a; trái = trái + 1; };
                k = k + 1;
            };
            khi (trái < giữa) { đích[k] = nguồn[trái]; trái = trái + 1; k = k + 1; };
            khi (phải < cuối) { đích[k] = nguồn[phải]; phải = phải + 1; k = k + 1; };
            đầu = cuối;
        };
        tạm = nguồn; nguồn = đích; đích = tạm; ở đệm = !ở đệm;
        nếu (rộng >= n - rộng) { rộng = n; }
        hoặc { rộng = rộng + rộng; };
    };
    nếu (ở đệm) {
        lặp(k = 0; k < n; k++) { ds[k] = nguồn[k]; };
    };
    trả về rỗng;
};

// Lớp sở hữu toàn bộ thuật toán của mô-đun; các hàm bên dưới chỉ giữ API cũ.
lớp công khai Tiện Ích Danh Sách {
    hàm công khai khởi tạo() {};

    // Thêm giá trị vào cuối list; trả về rỗng.
    hàm công khai thêm(danh sách đầu vào, giá trị) {
        trả về máy ảo thêm cuối danh sách(danh sách đầu vào, giá trị);
    };

    // Xóa phần tử tại chỉ số, trả về phần tử vừa xóa.
    hàm công khai xóa tại(danh sách đầu vào, chỉ số) {
        trả về máy ảo xóa vị trí danh sách(danh sách đầu vào, chỉ số);
    };

    // Tìm chỉ số đầu tiên của giá trị; trả về -1 nếu không có.
    hàm công khai tìm chỉ số(danh sách đầu vào, giá trị) {
        vị trí = -1;
        lặp(i = 0; i < máy ảo lấy độ dài(danh sách đầu vào) && vị trí < 0; i++) {
            nếu (danh sách đầu vào[i] == giá trị) {
                vị trí = i;
            };
        };
        trả về vị trí;
    };

    // Loại bỏ phần tử trùng lặp, giữ thứ tự xuất hiện đầu tiên.
    hàm công khai xóa trùng(danh sách đầu vào) {
        i = 0;
        khi (i < máy ảo lấy độ dài(danh sách đầu vào)) {
            j = i + 1;
            khi (j < máy ảo lấy độ dài(danh sách đầu vào)) {
                nếu (danh sách đầu vào[j] == danh sách đầu vào[i]) {
                    máy ảo xóa vị trí danh sách(danh sách đầu vào, j);
                } hoặc {
                    j = j + 1;
                };
            };
            i = i + 1;
        };
        trả về rỗng;
    };

    // Sắp xếp list số hoặc list chuỗi tại chỗ.
    hàm công khai sắp xếp(danh sách đầu vào) {
        n = máy ảo lấy độ dài(danh sách đầu vào);
        lặp(i = 0; i < n; i++) {
            // Nếu một lượt không đổi chỗ, mọi lượt sau cũng không đổi.
            // Danh sách đã sắp xếp chỉ cần một lượt duyệt.
            đổi chỗ = sai;
            lặp(j = 0; j + 1 < n - i; j++) {
                nếu (danh sách đầu vào[j] > danh sách đầu vào[j + 1]) {
                    tạm = danh sách đầu vào[j];
                    danh sách đầu vào[j] = danh sách đầu vào[j + 1];
                    danh sách đầu vào[j + 1] = tạm;
                    đổi chỗ = đúng;
                };
            };
            nếu (!đổi chỗ) { thoát; };
            nếu (i == 1 && n >= 32) {
                nếu (danh sách có thứ tự toàn phần(danh sách đầu vào, n)) {
                    trả về danh sách trộn ổn định(danh sách đầu vào, n);
                };
            };
        };
        trả về rỗng;
    };

    // Tổng phần tử số trong list.
    hàm công khai tổng danh sách(danh sách đầu vào) {
        tổng = 0;
        lặp(i = 0; i < máy ảo lấy độ dài(danh sách đầu vào); i++) {
            tổng = tổng + danh sách đầu vào[i];
        };
        trả về tổng;
    };

    // Giá trị nhỏ nhất/lớn nhất trong list số hoặc list chuỗi.
    hàm công khai nhỏ nhất danh sách(danh sách đầu vào) {
        nếu (máy ảo lấy độ dài(danh sách đầu vào) == 0) {
            ném "nhỏ nhất list: danh sách rỗng";
        };
        kết quả = danh sách đầu vào[0];
        lặp(i = 1; i < máy ảo lấy độ dài(danh sách đầu vào); i++) {
            nếu (danh sách đầu vào[i] < kết quả) {
                kết quả = danh sách đầu vào[i];
            };
        };
        trả về kết quả;
    };

    hàm công khai lớn nhất danh sách(danh sách đầu vào) {
        nếu (máy ảo lấy độ dài(danh sách đầu vào) == 0) {
            ném "lớn nhất list: danh sách rỗng";
        };
        kết quả = danh sách đầu vào[0];
        lặp(i = 1; i < máy ảo lấy độ dài(danh sách đầu vào); i++) {
            nếu (danh sách đầu vào[i] > kết quả) {
                kết quả = danh sách đầu vào[i];
            };
        };
        trả về kết quả;
    };
};


hàm công khai thêm(danh sách đầu vào, giá trị) {
    bộ chuyển tiếp = Tiện Ích Danh Sách();
    trả về bộ chuyển tiếp.thêm(danh sách đầu vào, giá trị);
};

hàm công khai xóa tại(danh sách đầu vào, chỉ số) {
    bộ chuyển tiếp = Tiện Ích Danh Sách();
    trả về bộ chuyển tiếp.xóa tại(danh sách đầu vào, chỉ số);
};

hàm công khai tìm chỉ số(danh sách đầu vào, giá trị) {
    bộ chuyển tiếp = Tiện Ích Danh Sách();
    trả về bộ chuyển tiếp.tìm chỉ số(danh sách đầu vào, giá trị);
};

hàm công khai xóa trùng(danh sách đầu vào) {
    bộ chuyển tiếp = Tiện Ích Danh Sách();
    trả về bộ chuyển tiếp.xóa trùng(danh sách đầu vào);
};

hàm công khai sắp xếp(danh sách đầu vào) {
    bộ chuyển tiếp = Tiện Ích Danh Sách();
    trả về bộ chuyển tiếp.sắp xếp(danh sách đầu vào);
};

hàm công khai tổng danh sách(danh sách đầu vào) {
    bộ chuyển tiếp = Tiện Ích Danh Sách();
    trả về bộ chuyển tiếp.tổng danh sách(danh sách đầu vào);
};

hàm công khai nhỏ nhất danh sách(danh sách đầu vào) {
    bộ chuyển tiếp = Tiện Ích Danh Sách();
    trả về bộ chuyển tiếp.nhỏ nhất danh sách(danh sách đầu vào);
};

hàm công khai lớn nhất danh sách(danh sách đầu vào) {
    bộ chuyển tiếp = Tiện Ích Danh Sách();
    trả về bộ chuyển tiếp.lớn nhất danh sách(danh sách đầu vào);
};
