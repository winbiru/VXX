nhập gói/bộ sưu tập/bộ đệm danh sách;

lớp công khai Danh Sách kế thừa Bộ Đệm Danh Sách {
    hàm công khai khởi tạo(nguồn = rỗng) {
        gốc.khởi tạo();
        nếu (nguồn != rỗng) {
            nếu (loại của(nguồn) != "danh sách") { ném "danh sách: nguồn phải là danh sách"; };
            lặp(i = 0; i < máy ảo lấy độ dài(nguồn); i++) { máy ảo thêm cuối danh sách(mình.phần tử, nguồn[i]); };
        };
    };
    hàm riêng tư yêu cầu chỉ số(chỉ số) {
        nếu (loại của(chỉ số) != "số nguyên" || chỉ số < 0 || chỉ số >= mình.số lượng()) {
            ném "danh sách: chỉ số ngoài phạm vi";
        };
    };
    hàm công khai thêm(giá trị) { máy ảo thêm cuối danh sách(mình.phần tử, giá trị); trả về mình; };
    hàm công khai tại(chỉ số) {
        mình.yêu cầu chỉ số(chỉ số);
        các mục = mình.phần tử;
        trả về các mục[chỉ số];
    };
    hàm công khai đặt(chỉ số, giá trị) {
        mình.yêu cầu chỉ số(chỉ số);
        các mục = mình.phần tử;
        các mục[chỉ số] = giá trị;
        trả về mình;
    };
    hàm công khai xóa(chỉ số) {
        mình.yêu cầu chỉ số(chỉ số);
        trả về máy ảo xóa vị trí danh sách(mình.phần tử, chỉ số);
    };
    hàm công khai danh sách() {
        kết quả = [];
        lặp(i = 0; i < mình.số lượng(); i++) { máy ảo thêm cuối danh sách(kết quả, mình.tại(i)); };
        trả về kết quả;
    };
};
