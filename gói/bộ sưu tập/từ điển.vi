// Module: lõi.từ điển
// Map MVP: literal và indexing là primitive VM; policy mặc định/thứ tự key
// được triển khai bằng V++. Chỉ xóa key và liệt kê key còn cần native mutation.

nhập gói/bộ sưu tập/danh sách;

// Lấy value theo key; trả về mặc định khi key không tồn tại.
hàm lấy map(bảng, khóa, mặc định) {
    nếu (!co_khoa(bảng, khóa)) {
        trả về mặc định;
    };
    trả về bảng[khóa];
};

// Đặt value theo key; list/map cũng được giữ theo tham chiếu. Trả về rỗng.
hàm đặt map(bảng, khóa, giá trị) {
    bảng[khóa] = giá trị;
    trả về rỗng;
};

// Kiểm tra key tồn tại, trả về đúng/sai theo quy ước số 1/0.
hàm có khóa(bảng, khóa) {
    trả về co_khoa(bảng, khóa);
};

// Xóa key, trả về value cũ hoặc rỗng.
hàm xóa khóa(bảng, khóa) {
    trả về xoa_khoa(bảng, khóa);
};

// Trả về list key đã sắp theo thứ tự từ điển.
hàm khóa map(bảng) {
    khóa = khoa_map(bảng);
    sắp xếp(khóa);
    trả về khóa;
};
