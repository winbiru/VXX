// Mỗi Ngăn Xếp sở hữu danh sách riêng và triển khai giao diện Bộ Chứa.
// API hàm tự do của các module bộ sưu tập hiện tại vẫn tương thích.
// Dùng trực tiếp từ module hoặc qua `gói/bộ sưu tập/chính`.

nhập gói/bộ sưu tập/bộ đệm danh sách;

lớp công khai Ngăn Xếp kế thừa Bộ Đệm Danh Sách {
    hàm công khai khởi tạo() {
        gốc.khởi tạo();
    };

    // Thêm một phần tử và trả về kích thước mới.
    hàm công khai đẩy(giá_trị) {
        them(mình.phần_tử, giá_trị);
        trả về do_dai(mình.phần_tử);
    };

    // Lấy phần tử cuối (LIFO), báo lỗi rõ ràng khi rỗng.
    hàm công khai rút() {
        n = do_dai(mình.phần_tử);
        nếu (n == 0) { ném "ngăn xếp: không có phần tử để rút"; };
        trả về xoa_tai(mình.phần_tử, n - 1);
    };

    hàm công khai đỉnh() {
        n = do_dai(mình.phần_tử);
        nếu (n == 0) { ném "ngăn xếp: không có phần tử ở đỉnh"; };
        ds = mình.phần_tử;
        trả về ds[n - 1];
    };

};
