

nhập gói.lõi.chuyển kiểu.loại của;

// Lớp sở hữu toàn bộ thuật toán của mô-đun; các hàm bên dưới chỉ giữ API cũ.
lớp công khai Tiện Ích Tập Hợp {
    hàm công khai khởi tạo() {};

    // Module: lõi.tập hợp
    // Set MVP được biểu diễn bởi list không trùng lặp, giữ thứ tự xuất hiện.
    hàm công khai tập yêu cầu danh sách(danh sách đầu vào) {
        nếu (loại của(danh sách đầu vào) != "danh sách") {
            ném "COLLECTION_ARGUMENT";
        };
        trả về danh sách đầu vào;
    };

    hàm công khai tập chứa(danh sách đầu vào, giá trị) {
        mình.tập yêu cầu danh sách(danh sách đầu vào);
        lặp(i = 0; i < máy ảo lấy độ dài(danh sách đầu vào); i++) {
            nếu (danh sách đầu vào[i] == giá trị) {
                trả về đúng;
            };
        };
        trả về sai;
    };

    hàm công khai tập hợp(danh sách đầu vào) {
        mình.tập yêu cầu danh sách(danh sách đầu vào);
        kết quả = [];
        lặp(i = 0; i < máy ảo lấy độ dài(danh sách đầu vào); i++) {
            nếu (!mình.tập chứa(kết quả, danh sách đầu vào[i])) {
                máy ảo thêm cuối danh sách(kết quả, danh sách đầu vào[i]);
            };
        };
        trả về kết quả;
    };

    hàm công khai hợp tập(a, b) {
        mình.tập yêu cầu danh sách(a);
        mình.tập yêu cầu danh sách(b);
        kết quả = mình.tập hợp(a);
        lặp(i = 0; i < máy ảo lấy độ dài(b); i++) {
            nếu (!mình.tập chứa(kết quả, b[i])) {
                máy ảo thêm cuối danh sách(kết quả, b[i]);
            };
        };
        trả về kết quả;
    };

    hàm công khai giao tập(a, b) {
        mình.tập yêu cầu danh sách(a);
        mình.tập yêu cầu danh sách(b);
        kết quả = [];
        duyệt = mình.tập hợp(a);
        lặp(i = 0; i < máy ảo lấy độ dài(duyệt); i++) {
            nếu (mình.tập chứa(b, duyệt[i])) {
                máy ảo thêm cuối danh sách(kết quả, duyệt[i]);
            };
        };
        trả về kết quả;
    };

    hàm công khai rời nhau(a, b) {
        mình.tập yêu cầu danh sách(a);
        mình.tập yêu cầu danh sách(b);
        lặp(i = 0; i < máy ảo lấy độ dài(a); i++) {
            nếu (mình.tập chứa(b, a[i])) {
                trả về sai;
            };
        };
        trả về đúng;
    };

    hàm công khai hiệu tập(a, b) {
        mình.tập yêu cầu danh sách(a);
        mình.tập yêu cầu danh sách(b);
        kết quả = [];
        duyệt = mình.tập hợp(a);
        lặp(i = 0; i < máy ảo lấy độ dài(duyệt); i++) {
            nếu (!mình.tập chứa(b, duyệt[i])) {
                máy ảo thêm cuối danh sách(kết quả, duyệt[i]);
            };
        };
        trả về kết quả;
    };

    hàm công khai hiệu đối xứng tập(a, b) {
        trái = mình.hiệu tập(a, b);
        phải = mình.hiệu tập(b, a);
        trả về mình.hợp tập(trái, phải);
    };

    hàm công khai tập con(a, b) {
        mình.tập yêu cầu danh sách(a);
        mình.tập yêu cầu danh sách(b);
        duyệt = mình.tập hợp(a);
        lặp(i = 0; i < máy ảo lấy độ dài(duyệt); i++) {
            nếu (!mình.tập chứa(b, duyệt[i])) {
                trả về sai;
            };
        };
        trả về đúng;
    };

    hàm công khai tập con thực sự(a, b) {
        nếu (!mình.tập con(a, b)) {
            trả về sai;
        };
        trả về máy ảo lấy độ dài(mình.tập hợp(a)) < máy ảo lấy độ dài(mình.tập hợp(b));
    };

    hàm công khai tập cha(a, b) {
        trả về mình.tập con(b, a);
    };

    hàm công khai tập bằng(a, b) {
        mình.tập yêu cầu danh sách(a);
        mình.tập yêu cầu danh sách(b);
        aa = mình.tập hợp(a);
        bb = mình.tập hợp(b);
        nếu (máy ảo lấy độ dài(aa) != máy ảo lấy độ dài(bb)) {
            trả về sai;
        };
        trả về mình.tập con(aa, bb);
    };

    hàm công khai tập thêm(danh sách đầu vào, giá trị) {
        mình.tập yêu cầu danh sách(danh sách đầu vào);
        nếu (mình.tập chứa(danh sách đầu vào, giá trị)) {
            trả về sai;
        };
        máy ảo thêm cuối danh sách(danh sách đầu vào, giá trị);
        trả về đúng;
    };

    hàm công khai tập xóa(danh sách đầu vào, giá trị) {
        mình.tập yêu cầu danh sách(danh sách đầu vào);
        lặp(i = 0; i < máy ảo lấy độ dài(danh sách đầu vào); i++) {
            nếu (danh sách đầu vào[i] == giá trị) {
                máy ảo xóa vị trí danh sách(danh sách đầu vào, i);
                trả về đúng;
            };
        };
        trả về sai;
    };
};


hàm công khai tập yêu cầu danh sách(danh sách đầu vào) {
    trả về Tiện Ích Tập Hợp().tập yêu cầu danh sách(danh sách đầu vào);
};

hàm công khai tập chứa(danh sách đầu vào, giá trị) {
    trả về Tiện Ích Tập Hợp().tập chứa(danh sách đầu vào, giá trị);
};

hàm công khai tập hợp(danh sách đầu vào) {
    trả về Tiện Ích Tập Hợp().tập hợp(danh sách đầu vào);
};

hàm công khai hợp tập(a, b) {
    trả về Tiện Ích Tập Hợp().hợp tập(a, b);
};

hàm công khai giao tập(a, b) {
    trả về Tiện Ích Tập Hợp().giao tập(a, b);
};

hàm công khai rời nhau(a, b) {
    trả về Tiện Ích Tập Hợp().rời nhau(a, b);
};

hàm công khai hiệu tập(a, b) {
    trả về Tiện Ích Tập Hợp().hiệu tập(a, b);
};

hàm công khai hiệu đối xứng tập(a, b) {
    trả về Tiện Ích Tập Hợp().hiệu đối xứng tập(a, b);
};

hàm công khai tập con(a, b) {
    trả về Tiện Ích Tập Hợp().tập con(a, b);
};

hàm công khai tập con thực sự(a, b) {
    trả về Tiện Ích Tập Hợp().tập con thực sự(a, b);
};

hàm công khai tập cha(a, b) {
    trả về Tiện Ích Tập Hợp().tập cha(a, b);
};

hàm công khai tập bằng(a, b) {
    trả về Tiện Ích Tập Hợp().tập bằng(a, b);
};

hàm công khai tập thêm(danh sách đầu vào, giá trị) {
    trả về Tiện Ích Tập Hợp().tập thêm(danh sách đầu vào, giá trị);
};

hàm công khai tập xóa(danh sách đầu vào, giá trị) {
    trả về Tiện Ích Tập Hợp().tập xóa(danh sách đầu vào, giá trị);
};
nhập gói.lõi.chuyển kiểu.loại của;
