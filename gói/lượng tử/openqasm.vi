nhập gói . lượng tử . mạch.*;
hàm công khai xuất openqasm(mạch) {
    qasm = "OPENQASM 3.0;\ninclude \"stdgates.inc\";\n";
    qasm = qasm + "qubit[" + mạch.số qubit() + "] q;\n";
    qasm = qasm + "bit[" + mạch.số bit() + "] c;\n";
    lệnh = mạch.các lệnh();
    lặp (i = 0; i < máy ảo lấy độ dài(lệnh); i++) {
        mục = lệnh[i];
        tên = mục[0];
        q = mục[1];
        nếu (tên == "measure") {
            qasm = qasm + "c[" + mục[2] + "] = measure q[" + q + "];\n";
        } hoặc nếu (tên == "cx") {
            qasm = qasm + "cx q[" + q + "], q[" + mục[2] + "];\n";
        } hoặc {
            qasm = qasm + tên + " q[" + q + "];\n";
        }
        ;
    }
    ;
    trả về qasm;
}
;
