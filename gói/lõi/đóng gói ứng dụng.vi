// vpp.packaging — đóng gói cơ bản thành thư mục phân phối.
// M3 chỉ mang entry + tài nguyên + manifest; bundle runtime tùy biến thuộc M4.
nhập nhập xuất.*;
nhập bộ sưu tập.*;
nhập công cụ lưu trữ.*;

hàm công khai đóng gói ứng dụng(thư mục đích, tên, tệp chính, tài nguyên) {
    tạo thư mục(thư mục đích);

    tên chính = đường dẫn tên(tệp chính);
    đích chính = đường dẫn nối(thư mục đích, tên chính);
    ghi tệp(đích chính, đọc tệp(tệp chính));

    lặp(i = 0; i < máy ảo lấy độ dài(tài nguyên); i++) {
        nguồn = tài nguyên[i];
        tên tệp = đường dẫn tên(nguồn);
        đích = đường dẫn nối(thư mục đích, tên tệp);
        ghi tệp(đích, đọc tệp(nguồn));
    };

    bản kê = "name=" + tên + "\nentry=" + tên chính +
        "\nresources=" + máy ảo lấy độ dài(tài nguyên) + "\n";
    đường bản kê = đường dẫn nối(thư mục đích, "vpp-package.txt");
    ghi tệp(đường bản kê, bản kê);

    trả về {
        "thư mục": thư mục đích,
        "tệp chính": tên chính,
        "tài nguyên": máy ảo lấy độ dài(tài nguyên),
        "bản kê": đường bản kê
    };
};

hàm công khai đóng gói ứng dụng zip(đường zip, thư mục đích, tên, tệp chính, tài nguyên) {
    kết quả = đóng gói ứng dụng(thư mục đích, tên, tệp chính, tài nguyên);
    các tệp = [];
    máy ảo thêm cuối danh sách(các tệp, đường dẫn nối(thư mục đích, đường dẫn tên(tệp chính)));
    lặp(i = 0; i < máy ảo lấy độ dài(tài nguyên); i++) {
        máy ảo thêm cuối danh sách(các tệp, đường dẫn nối(thư mục đích, đường dẫn tên(tài nguyên[i])));
    };
    máy ảo thêm cuối danh sách(các tệp, lấy từ điển(kết quả, "bản kê", ""));
    trả về gói tài nguyên tạo(đường zip, các tệp);
};
