// Module: nhập xuất.nhật ký
// Mục đích: chuẩn hóa định dạng log theo mức thông tin/cảnh báo/lỗi.
// Giữ lớp NhậtKý và các hàm cấp mô-đun tương thích.

nhập gói.nhập xuất.tệp.ghi tệp;
nhập gói.nhập xuất.tệp.ghi nối tệp;

lớp công khai Nhật ký {
    // Ghi chú hàm: công khai ghi thông tin.
    hàm công khai ghi thông tin(tin nhắn) {
        in "[THÔNG TIN] " + tin nhắn;
        trả về 0;
    };

    // Ghi chú hàm: công khai ghi cảnh báo.
    hàm công khai ghi cảnh báo(tin nhắn) {
        in "[CẢNH BÁO] " + tin nhắn;
        trả về 0;
    };

    // Ghi chú hàm: công khai ghi lỗi.
    hàm công khai ghi lỗi(tin nhắn) {
        in "[LỖI] " + tin nhắn;
        trả về 0;
    };
};

hàm công khai ghi thông tin(tin nhắn) { trả về Nhật ký.ghi thông tin(tin nhắn); };

hàm công khai ghi cảnh báo(tin nhắn) { trả về Nhật ký.ghi cảnh báo(tin nhắn); };

hàm công khai ghi lỗi(tin nhắn) { trả về Nhật ký.ghi lỗi(tin nhắn); };

// Logging chỉ dựng nội dung; append OS nằm sau wrapper file V++.
hàm công khai nhật ký ghi tệp(đường dẫn, nội dung) {
    trả về ghi nối tệp(đường dẫn, nội dung);
};

hàm công khai ghi thông tin tệp(đường dẫn, tin nhắn) {
    trả về nhật ký ghi tệp(đường dẫn, "[THÔNG TIN] " + tin nhắn + "\n");
};

hàm công khai ghi cảnh báo tệp(đường dẫn, tin nhắn) {
    trả về nhật ký ghi tệp(đường dẫn, "[CẢNH BÁO] " + tin nhắn + "\n");
};

hàm công khai ghi lỗi tệp(đường dẫn, tin nhắn) {
    trả về nhật ký ghi tệp(đường dẫn, "[LỖI] " + tin nhắn + "\n");
};

hàm công khai ghi theo cấu hình(đích, đường dẫn, mức, tin nhắn) {
    nếu (đích == "bảng điều khiển") {
        nếu (mức == "thông tin") { trả về ghi thông tin(tin nhắn); };
        nếu (mức == "cảnh báo") { trả về ghi cảnh báo(tin nhắn); };
        nếu (mức == "lỗi") { trả về ghi lỗi(tin nhắn); };
        ném "nhật ký: mức không hợp lệ";
    };
    nếu (đích == "tệp") {
        nếu (đường dẫn == "") { ném "nhật ký: đường dẫn tệp rỗng"; };
        nếu (mức == "thông tin") { trả về ghi thông tin tệp(đường dẫn, tin nhắn); };
        nếu (mức == "cảnh báo") { trả về ghi cảnh báo tệp(đường dẫn, tin nhắn); };
        nếu (mức == "lỗi") { trả về ghi lỗi tệp(đường dẫn, tin nhắn); };
        ném "nhật ký: mức không hợp lệ";
    };
    ném "nhật ký: đích ghi không hợp lệ";
};
