// Module: lõi.quốc tế hóa
// Locale/resource/properties semantics thuần V++.
// Không đọc process-global locale và không phụ thuộc native i18n APIs.

nhập gói/lõi/bảng mã;
nhập gói/lõi/chuyển kiểu;
nhập gói/bộ sưu tập/từ điển;
nhập gói/văn bản/chuỗi;

// Các thuật toán không giữ trạng thái là hàm cấp mô-đun; lớp tài nguyên quản lý trạng thái.
hàm riêng tư quốc tế là chữ mã ký tự cơ bản(c) {
    thấp = chuỗi thường(c);
    trả về thấp >= "a" && thấp <= "z";
};

hàm riêng tư quốc tế là số mã ký tự cơ bản(c) {
    trả về c >= "0" && c <= "9";
};

hàm riêng tư quốc tế là chữ số mã ký tự cơ bản(c) {
    trả về quốc tế là chữ mã ký tự cơ bản(c) || quốc tế là số mã ký tự cơ bản(c);
};

hàm riêng tư quốc tế toàn bộ chữ(s) {
    nếu (loại của(s) != "chuỗi") { trả về sai; };
    nếu (máy ảo lấy độ dài(s) == 0) { trả về sai; };
    hợp lệ = đúng;
    lặp(i = 0; i < máy ảo lấy độ dài(s) && hợp lệ; i++) {
        nếu (!quốc tế là chữ mã ký tự cơ bản(s[i])) { hợp lệ = sai; };
    };
    trả về hợp lệ;
};

hàm riêng tư quốc tế toàn bộ số(s) {
    nếu (loại của(s) != "chuỗi") { trả về sai; };
    nếu (máy ảo lấy độ dài(s) == 0) { trả về sai; };
    hợp lệ = đúng;
    lặp(i = 0; i < máy ảo lấy độ dài(s) && hợp lệ; i++) {
        nếu (!quốc tế là số mã ký tự cơ bản(s[i])) { hợp lệ = sai; };
    };
    trả về hợp lệ;
};

hàm riêng tư quốc tế toàn bộ chữ số(s) {
    nếu (loại của(s) != "chuỗi") { trả về sai; };
    nếu (máy ảo lấy độ dài(s) == 0) { trả về sai; };
    hợp lệ = đúng;
    lặp(i = 0; i < máy ảo lấy độ dài(s) && hợp lệ; i++) {
        nếu (!quốc tế là chữ số mã ký tự cơ bản(s[i])) { hợp lệ = sai; };
    };
    trả về hợp lệ;
};

hàm riêng tư quốc tế tiêu đề mã ký tự cơ bản(s) {
    nếu (máy ảo lấy độ dài(s) == 0) { trả về s; };
    trả về chuỗi hoa(cắt chuỗi(s, 0, 1)) +
        chuỗi thường(cắt chuỗi(s, 1, máy ảo lấy độ dài(s) - 1));
};

hàm riêng tư quốc tế tách nhãn(thô) {
    nếu (loại của(thô) != "chuỗi" || thô == "") {
        ném "LOCALE_INVALID";
    };
    phần = [];
    hiện tại = "";
    lặp(i = 0; i <= máy ảo lấy độ dài(thô); i++) {
        hết = i == máy ảo lấy độ dài(thô);
        c = "-";
        nếu (!hết) { c = thô[i]; };
        nếu (c == "-") {
            nếu (hiện tại == "") { ném "LOCALE_INVALID"; };
            máy ảo thêm cuối danh sách(phần, hiện tại);
            hiện tại = "";
        } hoặc {
            nếu (!quốc tế là chữ số mã ký tự cơ bản(c)) { ném "LOCALE_INVALID"; };
            hiện tại = hiện tại + c;
        };
    };
    trả về phần;
};

// BCP47 structural profile cho thư viện 0.1:
// language [script] [region] [variant/extension subtags...].
hàm công khai vùng ngôn ngữ(thô) {
    phần = quốc tế tách nhãn(thô);
    ngôn ngữ thô = phần[0];
    nếu (máy ảo lấy độ dài(ngôn ngữ thô) < 2 || máy ảo lấy độ dài(ngôn ngữ thô) > 8 ||
        !quốc tế toàn bộ chữ(ngôn ngữ thô)) {
        ném "LOCALE_INVALID";
    };

    ngôn ngữ = chuỗi thường(ngôn ngữ thô);
    chữ viết = "";
    vùng = "";
    phụ = [];
    i = 1;

    nếu (i < máy ảo lấy độ dài(phần)) {
        p = phần[i];
        nếu (máy ảo lấy độ dài(p) == 4 && quốc tế toàn bộ chữ(p)) {
            chữ viết = quốc tế tiêu đề mã ký tự cơ bản(p);
            i += 1;
        };
    };

    nếu (i < máy ảo lấy độ dài(phần)) {
        p = phần[i];
        nếu ((máy ảo lấy độ dài(p) == 2 && quốc tế toàn bộ chữ(p)) ||
            (máy ảo lấy độ dài(p) == 3 && quốc tế toàn bộ số(p))) {
            vùng = chuỗi hoa(p);
            i += 1;
        };
    };

    lặp(k = i; k < máy ảo lấy độ dài(phần); k++) {
        p = phần[k];
        nếu (máy ảo lấy độ dài(p) < 1 || máy ảo lấy độ dài(p) > 8 ||
            !quốc tế toàn bộ chữ số(p)) {
            ném "LOCALE_INVALID";
        };
        máy ảo thêm cuối danh sách(phụ, chuỗi thường(p));
    };

    chuẩn = ngôn ngữ;
    nếu (chữ viết != "") { chuẩn = chuẩn + "-" + chữ viết; };
    nếu (vùng != "") { chuẩn = chuẩn + "-" + vùng; };
    lặp(k = 0; k < máy ảo lấy độ dài(phụ); k++) {
        chuẩn = chuẩn + "-" + phụ[k];
    };

    trả về {
        "__vpp_locale__": 1,
        "tag": chuẩn,
        "ngôn ngữ": ngôn ngữ,
        "chữ viết": chữ viết,
        "vùng": vùng,
        "phụ": phụ
    };
};

hàm công khai nhãn vùng ngôn ngữ(vùng vùng ngôn ngữ) {
    nếu (loại của(vùng vùng ngôn ngữ) != "từ điển") {
        ném "LOCALE_INVALID";
    };
    nếu (lấy từ điển(vùng vùng ngôn ngữ, "__vpp_locale__", 0) != 1) {
        ném "LOCALE_INVALID";
    };
    trả về lấy từ điển(vùng vùng ngôn ngữ, "tag", "");
};

hàm riêng tư quốc tế thêm duy nhất(danh sách đầu vào, giá trị) {
    nếu (tìm chỉ số(danh sách đầu vào, giá trị) < 0) {
        máy ảo thêm cuối danh sách(danh sách đầu vào, giá trị);
    };
};

// Fallback deterministic: exact -> bỏ variant/extensions ->
// language-script-region -> language-region -> language-script -> language -> root.
hàm công khai dự phòng vùng ngôn ngữ(vùng vùng ngôn ngữ) {
    nếu (loại của(vùng vùng ngôn ngữ) == "chuỗi") {
        vùng vùng ngôn ngữ = vùng ngôn ngữ(vùng vùng ngôn ngữ);
    };
    nhãn chuẩn = nhãn vùng ngôn ngữ(vùng vùng ngôn ngữ);
    ngôn ngữ = lấy từ điển(vùng vùng ngôn ngữ, "ngôn ngữ", "");
    chữ viết = lấy từ điển(vùng vùng ngôn ngữ, "chữ viết", "");
    vùng = lấy từ điển(vùng vùng ngôn ngữ, "vùng", "");

    kết quả = [];
    quốc tế thêm duy nhất(kết quả, nhãn chuẩn);

    cơ sở = ngôn ngữ;
    nếu (chữ viết != "") { cơ sở = cơ sở + "-" + chữ viết; };
    nếu (vùng != "") { cơ sở = cơ sở + "-" + vùng; };
    quốc tế thêm duy nhất(kết quả, cơ sở);

    nếu (vùng != "") {
        quốc tế thêm duy nhất(kết quả, ngôn ngữ + "-" + vùng);
    };
    nếu (chữ viết != "") {
        quốc tế thêm duy nhất(kết quả, ngôn ngữ + "-" + chữ viết);
    };
    quốc tế thêm duy nhất(kết quả, ngôn ngữ);
    quốc tế thêm duy nhất(kết quả, "");
    trả về kết quả;
};

hàm công khai gói tài nguyên(tên cơ sở, vùng vùng ngôn ngữ, nguồn) {
    nếu (loại của(tên cơ sở) != "chuỗi" || tên cơ sở == "" ||
        loại của(nguồn) != "từ điển") {
        ném "RESOURCE_INVALID";
    };
    nếu (loại của(vùng vùng ngôn ngữ) == "chuỗi") {
        vùng vùng ngôn ngữ = vùng ngôn ngữ(vùng vùng ngôn ngữ);
    };

    ứng viên = dự phòng vùng ngôn ngữ(vùng vùng ngôn ngữ);
    dữ liệu = rỗng;
    đã chọn = "";
    tìm thấy = sai;
    lặp(i = 0; i < máy ảo lấy độ dài(ứng viên) && !tìm thấy; i++) {
        khóa tra cứu = ứng viên[i];
        nếu (máy ảo có khóa từ điển(nguồn, khóa tra cứu)) {
            dữ liệu = lấy từ điển(nguồn, khóa tra cứu, rỗng);
            nếu (loại của(dữ liệu) != "từ điển") {
                ném "RESOURCE_INVALID";
            };
            đã chọn = khóa tra cứu;
            tìm thấy = đúng;
        };
    };
    nếu (!tìm thấy) { ném "RESOURCE_MISSING"; };

    trả về {
        "__vpp_resource_bundle__": 1,
        "tên": tên cơ sở,
        "locale yêu cầu": nhãn vùng ngôn ngữ(vùng vùng ngôn ngữ),
        "locale đã chọn": đã chọn,
        "dữ liệu": dữ liệu
    };
};

hàm công khai lấy tài nguyên(gói tài nguyên, khóa) {
    nếu (loại của(gói tài nguyên) != "từ điển") {
        ném "RESOURCE_INVALID";
    };
    nếu (lấy từ điển(gói tài nguyên, "__vpp_resource_bundle__", 0) != 1) {
        ném "RESOURCE_INVALID";
    };
    nếu (loại của(khóa) != "chuỗi") {
        ném "RESOURCE_INVALID";
    };
    dữ liệu = lấy từ điển(gói tài nguyên, "dữ liệu", {});
    nếu (!máy ảo có khóa từ điển(dữ liệu, khóa)) { ném "RESOURCE_MISSING"; };
    trả về lấy từ điển(dữ liệu, khóa, rỗng);
};

hàm riêng tư quốc tế là khoảng trắng các thuộc tính(c) {
    trả về c == " " || c == "\t" || c == "\f";
};

hàm riêng tư quốc tế thập lục phân nửa byte(c) {
    bảng = "0123456789abcdef";
    chữ = chuỗi thường(c);
    kết quả = -1;
    lặp(i = 0; i < 16 && kết quả < 0; i++) {
        nếu (bảng[i] == chữ) { kết quả = i; };
    };
    trả về kết quả;
};

hàm riêng tư quốc tế ký tự mã(mã) {
    nếu (mã < 0 || mã > 1114111 || (mã >= 55296 && mã <= 57343)) {
        ném "PROPERTIES_INVALID";
    };
    các byte = [];
    nếu (mã <= 127) {
        máy ảo thêm cuối danh sách(các byte, mã);
    } hoặc {
        nếu (mã <= 2047) {
            máy ảo thêm cuối danh sách(các byte, 192 + thành số nguyên(mã / 64));
            máy ảo thêm cuối danh sách(các byte, 128 + mã % 64);
        } hoặc {
            nếu (mã <= 65535) {
                máy ảo thêm cuối danh sách(các byte, 224 + thành số nguyên(mã / 4096));
                máy ảo thêm cuối danh sách(các byte, 128 + (thành số nguyên(mã / 64) % 64));
                máy ảo thêm cuối danh sách(các byte, 128 + mã % 64);
            } hoặc {
                máy ảo thêm cuối danh sách(các byte, 240 + thành số nguyên(mã / 262144));
                máy ảo thêm cuối danh sách(các byte, 128 + (thành số nguyên(mã / 4096) % 64));
                máy ảo thêm cuối danh sách(các byte, 128 + (thành số nguyên(mã / 64) % 64));
                máy ảo thêm cuối danh sách(các byte, 128 + mã % 64);
            };
        };
    };
    trả về giải mã bảng mã(các byte, "UTF-8");
};

hàm riêng tư quốc tế giải ký tự thoát các thuộc tính(s) {
    kết quả = "";
    i = 0;
    khi (i < máy ảo lấy độ dài(s)) {
        c = s[i];
        nếu (c != "\\") {
            kết quả = kết quả + c;
            i += 1;
        } hoặc {
            i += 1;
            nếu (i >= máy ảo lấy độ dài(s)) { ném "PROPERTIES_INVALID"; };
            e = s[i];
            nếu (e == "t") { kết quả = kết quả + "\t"; i += 1; }
            hoặc {
                nếu (e == "n") { kết quả = kết quả + "\n"; i += 1; }
                hoặc {
                    nếu (e == "r") { kết quả = kết quả + "\r"; i += 1; }
                    hoặc {
                        nếu (e == "f") { kết quả = kết quả + "\f"; i += 1; }
                        hoặc {
                            nếu (e == "u") {
                                nếu (i + 4 >= máy ảo lấy độ dài(s)) { ném "PROPERTIES_INVALID"; };
                                mã = 0;
                                lặp(k = 1; k <= 4; k++) {
                                    nửa byte = quốc tế thập lục phân nửa byte(s[i + k]);
                                    nếu (nửa byte < 0) { ném "PROPERTIES_INVALID"; };
                                    mã = mã * 16 + nửa byte;
                                };
                                kết quả = kết quả + quốc tế ký tự mã(mã);
                                i += 5;
                            } hoặc {
                                // Java Properties giữ ký tự sau backslash cho escape không đặc biệt.
                                kết quả = kết quả + e;
                                i += 1;
                            };
                        };
                    };
                };
            };
        };
    };
    trả về kết quả;
};

hàm riêng tư quốc tế dòng tiếp diễn(s) {
    đếm = 0;
    i = máy ảo lấy độ dài(s) - 1;
    đang đếm = đúng;
    khi (đang đếm) {
        nếu (i < 0) {
            đang đếm = sai;
        } hoặc {
            nếu (s[i] == "\\") {
                đếm += 1;
                i -= 1;
            } hoặc {
                đang đếm = sai;
            };
        };
    };
    trả về đếm % 2 == 1;
};

hàm riêng tư quốc tế bỏ trắng đầu các thuộc tính(s) {
    i = 0;
    đang bỏ = đúng;
    khi (đang bỏ) {
        nếu (i >= máy ảo lấy độ dài(s)) {
            đang bỏ = sai;
        } hoặc {
            nếu (quốc tế là khoảng trắng các thuộc tính(s[i])) {
                i += 1;
            } hoặc {
                đang bỏ = sai;
            };
        };
    };
    trả về cắt chuỗi(s, i, máy ảo lấy độ dài(s) - i);
};

hàm riêng tư quốc tế phân tích dòng các thuộc tính(dòng) {
    s = quốc tế bỏ trắng đầu các thuộc tính(dòng);
    nếu (s == "") { trả về rỗng; };
    nếu (s[0] == "#" || s[0] == "!") { trả về rỗng; };

    vị trí = -1;
    kiểu = "";
    ký tự thoát = sai;
    lặp(i = 0; i < máy ảo lấy độ dài(s) && vị trí < 0; i++) {
        c = s[i];
        nếu (ký tự thoát) {
            ký tự thoát = sai;
        } hoặc {
            nếu (c == "\\") {
                ký tự thoát = đúng;
            } hoặc {
                nếu (c == "=" || c == ":") {
                    vị trí = i;
                    kiểu = "sep";
                } hoặc {
                    nếu (quốc tế là khoảng trắng các thuộc tính(c)) {
                        vị trí = i;
                        kiểu = "space";
                    };
                };
            };
        };
    };

    nếu (vị trí < 0) {
        trả về {"khóa": quốc tế giải ký tự thoát các thuộc tính(s), "giá trị": ""};
    };

    khóa thô = cắt chuỗi(s, 0, vị trí);
    i = vị trí;
    nếu (kiểu == "space") {
        đang bỏ = đúng;
        khi (đang bỏ) {
            nếu (i >= máy ảo lấy độ dài(s)) {
                đang bỏ = sai;
            } hoặc {
                nếu (quốc tế là khoảng trắng các thuộc tính(s[i])) {
                    i += 1;
                } hoặc {
                    đang bỏ = sai;
                };
            };
        };
        nếu (i < máy ảo lấy độ dài(s)) {
            nếu (s[i] == "=" || s[i] == ":") { i += 1; };
        };
    } hoặc {
        i += 1;
    };
    đang bỏ = đúng;
    khi (đang bỏ) {
        nếu (i >= máy ảo lấy độ dài(s)) {
            đang bỏ = sai;
        } hoặc {
            nếu (quốc tế là khoảng trắng các thuộc tính(s[i])) {
                i += 1;
            } hoặc {
                đang bỏ = sai;
            };
        };
    };
    giá trị thô = cắt chuỗi(s, i, máy ảo lấy độ dài(s) - i);
    trả về {
        "khóa": quốc tế giải ký tự thoát các thuộc tính(khóa thô),
        "giá trị": quốc tế giải ký tự thoát các thuộc tính(giá trị thô)
    };
};

hàm công khai các thuộc tính(văn bản, mặc định = rỗng,
               mức trần mục = 4096, mức trần ký tự = 1048576) {
    nếu (loại của(văn bản) != "chuỗi" ||
        loại của(mức trần mục) != "số nguyên" || mức trần mục <= 0 ||
        loại của(mức trần ký tự) != "số nguyên" || mức trần ký tự <= 0) {
        ném "PROPERTIES_INVALID";
    };
    nếu (máy ảo lấy độ dài(văn bản) > mức trần ký tự) { ném "I18N_RESOURCE_LIMIT"; };
    nếu (mặc định != rỗng) {
        nếu (loại của(mặc định) != "từ điển") {
            ném "PROPERTIES_INVALID";
        };
        nếu (lấy từ điển(mặc định, "__vpp_properties__", 0) != 1) {
            ném "PROPERTIES_INVALID";
        };
    };

    dữ liệu = {};
    dòng vật lý = "";
    dòng logic = "";
    tiếp diễn = sai;
    số mục = 0;
    n = máy ảo lấy độ dài(văn bản);

    lặp(vị trí hiện tại = 0; vị trí hiện tại <= n; vị trí hiện tại++) {
        hết = vị trí hiện tại == n;
        c = "\n";
        nếu (!hết) { c = văn bản[vị trí hiện tại]; };
        nếu (c == "\r") {
            // CRLF: CR được bỏ, LF kết thúc dòng; CR đơn cũng được chấp nhận ở cuối.
        } hoặc {
            nếu (c == "\n") {
                phần = dòng vật lý;
                nếu (tiếp diễn) { phần = quốc tế bỏ trắng đầu các thuộc tính(phần); };
                nối tiếp = quốc tế dòng tiếp diễn(phần);
                nếu (nối tiếp) {
                    phần = cắt chuỗi(phần, 0, máy ảo lấy độ dài(phần) - 1);
                };
                dòng logic = dòng logic + phần;
                dòng vật lý = "";
                tiếp diễn = nối tiếp;

                nếu (!nối tiếp) {
                    mục = quốc tế phân tích dòng các thuộc tính(dòng logic);
                    nếu (mục != rỗng) {
                        khóa = lấy từ điển(mục, "khóa", "");
                        nếu (!máy ảo có khóa từ điển(dữ liệu, khóa)) {
                            số mục += 1;
                            nếu (số mục > mức trần mục) { ném "I18N_RESOURCE_LIMIT"; };
                        };
                        đặt từ điển(dữ liệu, khóa, lấy từ điển(mục, "giá trị", ""));
                    };
                    dòng logic = "";
                };
            } hoặc {
                dòng vật lý = dòng vật lý + c;
            };
        };
    };
    nếu (tiếp diễn) { ném "PROPERTIES_INVALID"; };

    trả về {
        "__vpp_properties__": 1,
        "dữ liệu": dữ liệu,
        "mặc định": mặc định
    };
};

hàm công khai lấy thuộc tính(cấu hình, khóa, dự phòng = rỗng) {
    nếu (loại của(cấu hình) != "từ điển") {
        ném "PROPERTIES_INVALID";
    };
    nếu (lấy từ điển(cấu hình, "__vpp_properties__", 0) != 1) {
        ném "PROPERTIES_INVALID";
    };
    nếu (loại của(khóa) != "chuỗi") {
        ném "PROPERTIES_INVALID";
    };
    dữ liệu = lấy từ điển(cấu hình, "dữ liệu", {});
    nếu (máy ảo có khóa từ điển(dữ liệu, khóa)) {
        trả về lấy từ điển(dữ liệu, khóa, rỗng);
    };
    mặc định = lấy từ điển(cấu hình, "mặc định", rỗng);
    nếu (mặc định != rỗng) {
        trả về lấy thuộc tính(mặc định, khóa, dự phòng);
    };
    trả về dự phòng;
};

// Lựa chọn locale được giữ lại; chọn lại chỉ thay trạng thái sau khi thành công.
lớp công khai Gói Tài Nguyên {
    hàm công khai khởi tạo(tên, vùng, nguồn) {
        mình.gói tài nguyên = gói tài nguyên(tên, vùng, nguồn);
        mình.nguồn = nguồn;
        mình.tên = tên;
    };
    hàm công khai lấy(khóa) { trả về lấy tài nguyên(mình.gói tài nguyên, khóa); };
    hàm công khai vùng đã chọn() { trả về lấy từ điển(mình.gói tài nguyên, "locale đã chọn", ""); };
    hàm công khai chọn vùng(vùng) {
        mới = gói tài nguyên(mình.tên, vùng, mình.nguồn);
        mình.gói tài nguyên = mới;
        trả về mình;
    };
};
