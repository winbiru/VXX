// Module: lõi.chuyển kiểu
// Chuyển kiểu mức thư viện được viết bằng V++.
//
// VM chỉ còn hai primitive mà ngôn ngữ không thể tự suy ra:
// - loai_cua(value): đọc tag kiểu runtime.
// - so_thuc_tu_bits_vm(bytes): diễn giải 8 byte IEEE-754 little-endian.
// Thư viện tự dựng biểu diễn NaN/+Inf/-Inf.
hàm riêng tư chuyển kiểu lỗi số nguyên() {
    ném "thành số nguyên: giá trị không thể chuyển đổi";
};

hàm riêng tư chuyển kiểu lỗi số thực() {
    ném "thành số thực: giá trị không thể chuyển đổi";
};

hàm riêng tư chuyển kiểu số thực đặc biệt(mã) {
    nếu (mã != -1 && mã != 0 && mã != 1) {
        chuyển kiểu lỗi số thực();
    };
    nếu (mã == 0) { trả về số thực từ bit máy ảo([0, 0, 0, 0, 0, 0, 248, 127]); };
    nếu (mã == 1) { trả về số thực từ bit máy ảo([0, 0, 0, 0, 0, 0, 240, 127]); };
    trả về số thực từ bit máy ảo([0, 0, 0, 0, 0, 0, 240, 255]);
};

hàm riêng tư chuyển kiểu là khoảng trắng đầu(c) {
    trả về c == " " || c == "\t" || c == "\n" || c == "\r";
};

hàm riêng tư chuyển kiểu chữ số(c) {
    nếu (c == "0") { trả về 0; };
    nếu (c == "1") { trả về 1; };
    nếu (c == "2") { trả về 2; };
    nếu (c == "3") { trả về 3; };
    nếu (c == "4") { trả về 4; };
    nếu (c == "5") { trả về 5; };
    nếu (c == "6") { trả về 6; };
    nếu (c == "7") { trả về 7; };
    nếu (c == "8") { trả về 8; };
    nếu (c == "9") { trả về 9; };
    trả về -1;
};

hàm riêng tư chuyển kiểu bỏ khoảng trắng đầu(văn bản) {
    i = 0;
    n = máy ảo lấy độ dài(văn bản);
    đang bỏ = đúng;
    lặp(vòng = 0; i < n && đang bỏ; vòng++) {
        nếu (chuyển kiểu là khoảng trắng đầu(văn bản[i])) {
            i = i + 1;
        } hoặc {
            đang bỏ = sai;
        };
    };
    trả về i;
};

// Parse số nguyên 32-bit theo contract cũ của std::stoi:
// cho phép khoảng trắng ở đầu, dấu +/- và yêu cầu phần còn lại toàn chữ số.
hàm riêng tư chuyển kiểu phân tích số nguyên(văn bản) {
    n = máy ảo lấy độ dài(văn bản);
    i = chuyển kiểu bỏ khoảng trắng đầu(văn bản);
    nếu (i >= n) { chuyển kiểu lỗi số nguyên(); };

    âm = sai;
    nếu (văn bản[i] == "+" || văn bản[i] == "-") {
        âm = văn bản[i] == "-";
        i = i + 1;
    };
    nếu (i >= n) { chuyển kiểu lỗi số nguyên(); };

    kết quả = 0;
    có chữ số = sai;
    lặp(vòng = 0; i < n; vòng++) {
        chữ số = chuyển kiểu chữ số(văn bản[i]);
        nếu (chữ số < 0) { chuyển kiểu lỗi số nguyên(); };
        có chữ số = đúng;

        nếu (âm) {
            nếu (kết quả < -214748364 ||
                (kết quả == -214748364 && chữ số > 8)) {
                chuyển kiểu lỗi số nguyên();
            };
            kết quả = kết quả * 10 - chữ số;
        } hoặc {
            nếu (kết quả > 214748364 ||
                (kết quả == 214748364 && chữ số > 7)) {
                chuyển kiểu lỗi số nguyên();
            };
            kết quả = kết quả * 10 + chữ số;
        };
        i = i + 1;
    };
    nếu (!có chữ số) { chuyển kiểu lỗi số nguyên(); };
    trả về kết quả;
};

hàm công khai thành chuỗi(giá trị) {
    // OP_CONG là ngữ nghĩa lõi của V++. Nối với chuỗi rỗng giữ nguyên cách
    // runtime hiển thị scalar, collection, object và closure.
    trả về "" + giá trị;
};

hàm công khai thành số nguyên(giá trị) {
    kiểu = loại của(giá trị);
    nếu (kiểu == "số nguyên") {
        trả về giá trị;
    };
    nếu (kiểu == "chuỗi") {
        trả về chuyển kiểu phân tích số nguyên(giá trị);
    };
    nếu (kiểu == "số thực") {
        nếu (!(giá trị >= -2147483648.0 && giá trị <= 2147483647.0)) {
            chuyển kiểu lỗi số nguyên();
        };
        văn bản = thành chuỗi(giá trị);
        n = máy ảo lấy độ dài(văn bản);
        nếu (n < 3 || văn bản[n - 2] != "." || văn bản[n - 1] != "0") {
            chuyển kiểu lỗi số nguyên();
        };
        nguyên = "";
        lặp(i = 0; i < n - 2; i++) {
            nguyên = nguyên + văn bản[i];
        };
        trả về chuyển kiểu phân tích số nguyên(nguyên);
    };
    chuyển kiểu lỗi số nguyên();
};

hàm riêng tư chuyển kiểu lũy thừa mười(số mũ) {
    kết quả = 1.0;
    nếu (số mũ >= 0) {
        lặp(i = 0; i < số mũ; i++) {
            kết quả = kết quả * 10.0;
        };
    } hoặc {
        lặp(i = 0; i > số mũ; i--) {
            kết quả = kết quả / 10.0;
        };
    };
    trả về kết quả;
};

// Parser thập phân/scientific notation thuần V++.
// Native không còn dùng std::stod cho conversion thông thường.
hàm riêng tư chuyển kiểu phân tích số thực(văn bản) {
    n = máy ảo lấy độ dài(văn bản);
    i = chuyển kiểu bỏ khoảng trắng đầu(văn bản);
    nếu (i >= n) { chuyển kiểu lỗi số thực(); };

    âm = sai;
    nếu (văn bản[i] == "+" || văn bản[i] == "-") {
        âm = văn bản[i] == "-";
        i = i + 1;
    };
    nếu (i >= n) { chuyển kiểu lỗi số thực(); };

    // NaN/Infinity không thể tự tạo bằng toán tử V++ vì phép chia cho 0
    // chủ động ném lỗi, nên chỉ ba giá trị IEEE này đi qua primitive runtime.
    còn lại = "";
    lặp(j = i; j < n; j++) {
        còn lại = còn lại + văn bản[j];
    };
    nếu (còn lại == "nan" || còn lại == "NaN" || còn lại == "NAN") {
        trả về chuyển kiểu số thực đặc biệt(0);
    };
    nếu (còn lại == "inf" || còn lại == "Inf" || còn lại == "INF" ||
        còn lại == "infinity" || còn lại == "Infinity" || còn lại == "INFINITY") {
        nếu (âm) { trả về chuyển kiểu số thực đặc biệt(-1); };
        trả về chuyển kiểu số thực đặc biệt(1);
    };

    giá trị = 0.0;
    có chữ số = sai;
    đang đọc = đúng;
    lặp(vòng = 0; i < n && đang đọc; vòng++) {
        chữ số = chuyển kiểu chữ số(văn bản[i]);
        nếu (chữ số < 0) {
            đang đọc = sai;
        } hoặc {
            có chữ số = đúng;
            giá trị = giá trị * 10.0 + chữ số;
            i = i + 1;
        };
    };

    nếu (i < n) {
        nếu (văn bản[i] == ".") {
            i = i + 1;
            hệ số = 0.1;
            đang đọc = đúng;
            lặp(vòng = 0; i < n && đang đọc; vòng++) {
                chữ số = chuyển kiểu chữ số(văn bản[i]);
                nếu (chữ số < 0) {
                    đang đọc = sai;
                } hoặc {
                    có chữ số = đúng;
                    giá trị = giá trị + chữ số * hệ số;
                    hệ số = hệ số / 10.0;
                    i = i + 1;
                };
            };
        };
    };
    nếu (!có chữ số) { chuyển kiểu lỗi số thực(); };

    số mũ = 0;
    có số mũ = sai;
    nếu (i < n) {
        nếu (văn bản[i] == "e" || văn bản[i] == "E") {
            i = i + 1;
            âm mũ = sai;
            nếu (i < n) {
                nếu (văn bản[i] == "+" || văn bản[i] == "-") {
                    âm mũ = văn bản[i] == "-";
                    i = i + 1;
                };
            };
            đang đọc = đúng;
            lặp(vòng = 0; i < n && đang đọc; vòng++) {
                chữ số = chuyển kiểu chữ số(văn bản[i]);
                nếu (chữ số < 0) {
                    đang đọc = sai;
                } hoặc {
                    có số mũ = đúng;
                    nếu (số mũ > 10000) { chuyển kiểu lỗi số thực(); };
                    số mũ = số mũ * 10 + chữ số;
                    i = i + 1;
                };
            };
            nếu (!có số mũ) { chuyển kiểu lỗi số thực(); };
            nếu (âm mũ) { số mũ = 0 - số mũ; };
        };
    };

    nếu (i != n) { chuyển kiểu lỗi số thực(); };
    nếu (số mũ > 400 || số mũ < -400) {
        chuyển kiểu lỗi số thực();
    };
    nếu (số mũ != 0) {
        giá trị = giá trị * chuyển kiểu lũy thừa mười(số mũ);
    };
    nếu (âm) {
        // 0.0 - 0.0 tạo +0 theo IEEE-754. Parse dấu âm của zero bằng
        // primitive bit-pattern để không làm mất bit dấu.
        nếu (giá trị == 0.0) {
            giá trị = số thực từ bit máy ảo([0, 0, 0, 0, 0, 0, 0, 128]);
        } hoặc {
            giá trị = 0.0 - giá trị;
        };
    };

    vô cực dương = chuyển kiểu số thực đặc biệt(1);
    vô cực âm = chuyển kiểu số thực đặc biệt(-1);
    nếu (giá trị == vô cực dương || giá trị == vô cực âm) {
        chuyển kiểu lỗi số thực();
    };
    trả về giá trị;
};

hàm công khai thành số thực(giá trị) {
    kiểu = loại của(giá trị);
    nếu (kiểu == "số thực") { trả về giá trị; };
    nếu (kiểu == "số nguyên") { trả về giá trị * 1.0; };
    nếu (kiểu == "chuỗi") { trả về chuyển kiểu phân tích số thực(giá trị); };
    chuyển kiểu lỗi số thực();
};

hàm công khai loại của(giá trị) {
    // Type tag là metadata của VM nên primitive này vẫn thuộc runtime.
    trả về máy ảo lấy loại(giá trị);
};
