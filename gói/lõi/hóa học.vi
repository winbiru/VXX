// Thư viện vi.chemistry — công thức hóa học nền tảng cho V++.
// Khối lượng mặc định tính bằng gram, thể tích dung dịch bằng lít.
nhập gói.lõi.toán học.phần trăm;

hàm công khai số mol từ khối lượng(m, m mol) {
    nếu (m mol == 0 || m mol == 0.0) {
        ném "hóa học: khối lượng mol phải khác 0";
    };
    trả về m / m mol;
};

hàm công khai khối lượng từ số mol(n, m mol) {
    trả về n * m mol;
};

hàm công khai nồng độ mol(n, v lit) {
    nếu (v lit == 0 || v lit == 0.0) {
        ném "hóa học: thể tích dung dịch phải khác 0";
    };
    trả về n / v lit;
};

hàm công khai số mol từ nồng độ(c, v lit) {
    trả về c * v lit;
};

hàm công khai nồng độ phần trăm(m chat tan, m dung dịch) {
    nếu (m dung dịch == 0 || m dung dịch == 0.0) {
        ném "hóa học: khối lượng dung dịch phải khác 0";
    };
    trả về (m chat tan * 100) / m dung dịch;
};

hàm công khai khối lượng chất tan(c phân tram, m dung dịch) {
    trả về (c phân tram * m dung dịch) / 100;
};

// Thể tích mol khí lý tưởng tại 0 °C và 1 atm, đơn vị lít/mol.
hàm công khai thể tích khí ở điều kiện tiêu chuẩn(n) {
    trả về n * 22.414;
};

hàm công khai số mol khí ở điều kiện tiêu chuẩn(v lit) {
    trả về v lit / 22.414;
};

// C2 = C1 * V1 / V2.
hàm công khai nồng độ sau pha loãng(c ban dau, v ban dau, v sau) {
    nếu (v sau == 0 || v sau == 0.0) {
        ném "hóa học: thể tích sau pha loãng phải khác 0";
    };
    trả về (c ban dau * v ban dau) / (v sau + 0.0);
};

hàm công khai hằng số avogadro() {
    trả về 602214076000000000000000.0;
};

hàm công khai số hạt từ số mol(n) {
    trả về n * hằng số avogadro();
};
