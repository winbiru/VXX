// Thư viện vi.math — điểm sở hữu duy nhất cho API toán học của V++.
// Các primitive collection/thống kê vẫn dùng lại từ vi.base.
nhập gói/lõi/thống kê;
nhập gói/bộ sưu tập/danh sách;
nhập gói/lõi/chuyển kiểu;

// Số học cơ bản.
hàm cộng(a, b) {
    trả về a + b;
};

hàm trừ(a, b) {
    trả về a - b;
};

hàm nhân(a, b) {
    trả về a * b;
};

hàm chia(a, b) {
    trả về a / b;
};

// Hai toán hạng phải biểu diễn số nguyên; số thực có phần lẻ bị runtime từ chối.
hàm chia dư(a, b) {
    trả về a % b;
};

hàm chia lấy dư(a, b) {
    trả về chia dư(a, b);
};

hàm chia an toàn(a, b, mặc định = 0) {
    nếu (b == 0 || b == 0.0) {
        trả về mặc định;
    };
    trả về a / b;
};

hàm lũy thừa(cơ sở, số mũ) {
    nếu (số mũ < 0) {
        ném "lũy thừa: số mũ phải là số nguyên không âm";
    };

    kết quả = 1;
    còn lại = số mũ;
    lặp (i = 0; còn lại > 0; i = i + 1) {
        nếu (còn lại < 1) {
            ném "lũy thừa: số mũ phải là số nguyên không âm";
        };
        kết quả = kết quả * cơ sở;
        còn lại = còn lại - 1;
    };
    trả về kết quả;
};

hàm giai thừa(n) {
    nếu (n < 0) {
        ném "giai thừa: đối số phải là số nguyên không âm";
    };

    kết quả = 1;
    còn lại = n;
    lặp (i = 0; còn lại > 0; i = i + 1) {
        nếu (còn lại < 1) {
            ném "giai thừa: đối số phải là số nguyên không âm";
        };
        kết quả = kết quả * còn lại;
        còn lại = còn lại - 1;
    };
    trả về kết quả;
};

hàm trị tuyệt đối(x) {
    nếu (x < 0) {
        trả về 0 - x;
    };
    trả về x;
};

hàm lớn nhất hai(a, b) {
    nếu (a > b) {
        trả về a;
    };
    trả về b;
};

hàm nhỏ nhất hai(a, b) {
    nếu (a < b) {
        trả về a;
    };
    trả về b;
};

hàm giới hạn(x, nhỏ nhất, lớn nhất) {
    nếu (nhỏ nhất > lớn nhất) {
        ném "giới hạn: cận nhỏ nhất không được lớn hơn cận lớn nhất";
    };
    nếu (x < nhỏ nhất) {
        trả về nhỏ nhất;
    };
    nếu (x > lớn nhất) {
        trả về lớn nhất;
    };
    trả về x;
};

hàm trung bình(a, b) {
    trả về (a + b) / 2;
};

hàm phần trăm(giá trị, tổng) {
    nếu (tổng == 0 || tổng == 0.0) {
        trả về 0;
    };
    trả về (giá trị * 100) / tổng;
};

hàm là chẵn(n) {
    trả về n % 2 == 0;
};

hàm là lẻ(n) {
    trả về n % 2 != 0;
};

hàm bình phương(x) {
    trả về nhân(x, x);
};

hàm tổng hai(a, b) {
    trả về cộng(a, b);
};

// Làm tròn số hữu hạn bằng phép toán IEEE-754 của VM.
// Từ 2^52 trở lên mọi double hữu hạn đều đã là số nguyên.
hàm số học làm tròn nội bộ(x, lên, tên) {
    kiểu = loai_cua(x);
    nếu (kiểu == "số nguyên") { trả về x; };
    nếu (kiểu != "số thực") {
        ném tên + ": đối số phải là số hữu hạn";
    };
    nếu (x - x != 0.0) {
        ném tên + ": đối số phải là số hữu hạn";
    };

    âm = x < 0.0;
    độ_lớn = x;
    nếu (âm) { độ_lớn = 0.0 - x; };
    nếu (độ_lớn >= 4503599627370496.0) { trả về x; };

    gần = độ_lớn + 4503599627370496.0;
    nguyên = gần - 4503599627370496.0;
    nếu (nguyên > độ_lớn) { nguyên = nguyên - 1.0; };
    nếu (nguyên < độ_lớn) {
        nếu ((âm && !lên) || (!âm && lên)) {
            nguyên = nguyên + 1.0;
        };
    };
    nếu (âm) { nguyên = 0.0 - nguyên; };

    nếu (nguyên >= -2147483648.0 && nguyên <= 2147483647.0) {
        trả về thành số nguyên(nguyên);
    };
    trả về nguyên;
};

hàm lam_tron_xuong(x) {
    trả về số học làm tròn nội bộ(x, sai, "lam_tron_xuong");
};

hàm lam_tron_len(x) {
    trả về số học làm tròn nội bộ(x, đúng, "lam_tron_len");
};

// Làm tròn về số nguyên gần nhất theo quy tắc nửa đơn vị ra xa 0.
hàm làm tròn(x) {
    nếu (x >= 0) {
        trả về lam_tron_xuong(x + 0.5);
    };
    trả về lam_tron_len(x - 0.5);
};

// Làm tròn về phía âm vô cùng.
hàm làm tròn xuống(x) {
    trả về lam_tron_xuong(x);
};

// Làm tròn về phía dương vô cùng.
hàm làm tròn lên(x) {
    trả về lam_tron_len(x);
};

// Giá trị nhỏ nhất trong danh sách số. Danh sách rỗng giữ lỗi chuẩn của lõi.
hàm nhỏ nhất danh sách(ds) {
    trả về nhỏ nhất list(ds);
};

// Giá trị lớn nhất trong danh sách số. Danh sách rỗng giữ lỗi chuẩn của lõi.
hàm lớn nhất danh sách(ds) {
    trả về lớn nhất list(ds);
};

// Tổng các phần tử số trong danh sách.
hàm tổng danh sách(ds) {
    trả về tổng list(ds);
};

// Trung bình cộng của danh sách số; từ chối danh sách rỗng để tránh kết quả không xác định.
hàm trung bình danh sách(ds) {
    n = độ dài(ds);
    nếu (n == 0) {
        ném "toán học: không thể tính trung bình danh sách rỗng";
    };
    trả về tổng list(ds) / (n + 0.0);
};
