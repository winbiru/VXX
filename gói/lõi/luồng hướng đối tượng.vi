// Pipeline hướng đối tượng trên implementation luồng lazy, single-use.
nhập gói/lõi/giao diện tài nguyên;
nhập gói/lõi/luồng dữ liệu như luồng giao diện lập trình;

lớp công khai Luồng Truy Vấn triển khai Đóng Được {
    hàm công khai khởi tạo(nguồn) {
        mình.ống = luồng giao diện lập trình.luồng(nguồn);
    };

    hàm công khai ánh xạ(chương trình con hiện tại) {
        mình.ống = luồng giao diện lập trình.ánh xạ(mình.ống, chương trình con hiện tại);
        trả về mình;
    };

    hàm công khai lọc(biểu thức lọc) {
        mình.ống = luồng giao diện lập trình.lọc(mình.ống, biểu thức lọc);
        trả về mình;
    };

    hàm công khai ánh xạ phẳng(chương trình con hiện tại) {
        mình.ống = luồng giao diện lập trình.ánh xạ phẳng(mình.ống, chương trình con hiện tại);
        trả về mình;
    };

    hàm công khai bỏ(n) {
        mình.ống = luồng giao diện lập trình.bỏ(mình.ống, n);
        trả về mình;
    };

    hàm công khai giới hạn(n) {
        mình.ống = luồng giao diện lập trình.giới hạn luồng(mình.ống, n);
        trả về mình;
    };

    hàm công khai phân biệt() {
        mình.ống = luồng giao diện lập trình.phân biệt(mình.ống);
        trả về mình;
    };

    hàm công khai sắp xếp(số sánh = rỗng) {
        mình.ống = luồng giao diện lập trình.sắp xếp luồng(mình.ống, số sánh);
        trả về mình;
    };

    hàm công khai khi đóng(dọn dẹp) {
        luồng giao diện lập trình.khi đóng luồng(mình.ống, dọn dẹp);
        trả về mình;
    };

    hàm công khai gom danh sách() { trả về luồng giao diện lập trình.gom danh sách(mình.ống); };
    hàm công khai duyệt(bộ tiêu thụ) { trả về luồng giao diện lập trình.duyệt(mình.ống, bộ tiêu thụ); };
    hàm công khai đếm() { trả về luồng giao diện lập trình.đếm luồng(mình.ống); };
    hàm công khai bất kỳ(biểu thức lọc) { trả về luồng giao diện lập trình.bất kỳ(mình.ống, biểu thức lọc); };
    hàm công khai tất cả(biểu thức lọc) { trả về luồng giao diện lập trình.tất cả luồng(mình.ống, biểu thức lọc); };
    hàm công khai đầu tiên() { trả về luồng giao diện lập trình.đầu tiên(mình.ống); };
    hàm công khai rút gọn(giá trị đầu, bộ thu gọn) {
        trả về luồng giao diện lập trình.rút gọn(mình.ống, giá trị đầu, bộ thu gọn);
    };
    hàm công khai đóng() { trả về luồng giao diện lập trình.đóng luồng(mình.ống); };
};
