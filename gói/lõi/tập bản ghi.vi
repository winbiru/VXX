// vi.sql.rowset — tập kết quả độc lập kết nối dùng list<map> của runtime.
nhập gói.bộ sưu tập.chính.*;

hàm công khai tập bản ghi(danh sách hàng) {
    trả về danh sách hàng;
};

hàm công khai số hàng tập bản ghi(bản ghi) {
    trả về máy ảo lấy độ dài(bản ghi);
};

hàm công khai hàng tập bản ghi(bản ghi, chỉ số) {
    trả về bản ghi[chỉ số];
};

hàm công khai lọc tập bản ghi bằng(bản ghi, cột, giá trị) {
    kết quả = [];
    lặp (i = 0; i < máy ảo lấy độ dài(bản ghi); i = i + 1) {
        hàng = bản ghi[i];
        nếu (lấy từ điển(hàng, cột, rỗng) == giá trị) {
            máy ảo thêm cuối danh sách(kết quả, hàng);
        };
    };
    trả về kết quả;
};

hàm công khai cột tập bản ghi(bản ghi, cột, mặc định = rỗng) {
    kết quả = [];
    lặp (i = 0; i < máy ảo lấy độ dài(bản ghi); i = i + 1) {
        máy ảo thêm cuối danh sách(kết quả, lấy từ điển(bản ghi[i], cột, mặc định));
    };
    trả về kết quả;
};

// Sao chép danh sách ngoài để cursor/kích thước không phụ thuộc nguồn gọi.
// Map của mỗi hàng vẫn được chia sẻ như API tập bản ghi hiện có.
lớp công khai Tập Bản Ghi triển khai Bộ Chứa {
    hàm công khai khởi tạo(các hàng) {
        nếu (loại của(các hàng) != "danh sách") { ném "tập bản ghi: cần danh sách hàng"; };
        mình.hàng = [];
        lặp(i = 0; i < máy ảo lấy độ dài(các hàng); i++) {
            nếu (loại của(các hàng[i]) != "từ điển") { ném "tập bản ghi: hàng phải là từ điển"; };
            máy ảo thêm cuối danh sách(mình.hàng, các hàng[i]);
        };
    };
    hàm công khai số lượng() { trả về máy ảo lấy độ dài(mình.hàng); };
    hàm công khai trống() { trả về mình.số lượng() == 0; };
    hàm công khai tại(chỉ số) {
        nếu (loại của(chỉ số) != "số nguyên" || chỉ số < 0 || chỉ số >= mình.số lượng()) {
            ném "tập bản ghi: chỉ số ngoài phạm vi";
        };
        hàng = mình.hàng;
        trả về hàng[chỉ số];
    };
    hàm công khai lọc bằng(cột, giá trị) {
        trả về Tập Bản Ghi(lọc tập bản ghi bằng(mình.hàng, cột, giá trị));
    };
    hàm công khai cột(tên, mặc định = rỗng) { trả về cột tập bản ghi(mình.hàng, tên, mặc định); };
    hàm công khai danh sách() {
        kết quả = [];
        lặp(i = 0; i < mình.số lượng(); i++) { máy ảo thêm cuối danh sách(kết quả, mình.tại(i)); };
        trả về kết quả;
    };
};
