// Module: lõi.thống kê
// Summary statistics cho list số.

// Khai báo dependency tại module sở hữu; không dựa vào thư viện mà importer
// tình cờ nạp sau đó vào namespace chung của bootstrap C++.
nhập gói/bộ sưu tập/từ điển;
nhập gói/bộ sưu tập/danh sách;

hàm công khai thống kê là không phải số(giá trị) {
    nếu (loại của(giá trị) != "số thực") {
        trả về sai;
    };
    trả về giá trị != giá trị;
};

hàm công khai thống kê yêu cầu(bản) {
    nếu (loại của(bản) != "từ điển") {
        ném "VALUE_STATS_INVALID";
    };
    loại = lấy từ điển(bản, "__vpp_stats__", "");
    nếu (loại != "integer" && loại != "float") {
        ném "VALUE_STATS_INVALID";
    };
    đếm = lấy từ điển(bản, "đếm", -1);
    nếu (loại của(đếm) != "số nguyên" || đếm < 0) {
        ném "VALUE_STATS_INVALID";
    };
    trả về loại;
};

hàm công khai thống kê số nguyên(danh sách đầu vào) {
    n = máy ảo lấy độ dài(danh sách đầu vào);
    nếu (n == 0) {
        trả về {
            "__vpp_stats__": "integer",
            "đếm": 0,
            "tổng": 0,
            "nhỏ nhất": rỗng,
            "lớn nhất": rỗng,
            "trung bình": rỗng
        };
    };

    lặp(i = 0; i < n; i++) {
        nếu (loại của(danh sách đầu vào[i]) != "số nguyên") {
            ném "VALUE_STATS_INTEGER_REQUIRED";
        };
    };

    tổng = tổng danh sách(danh sách đầu vào);
    nhỏ = nhỏ nhất danh sách(danh sách đầu vào);
    lớn = lớn nhất danh sách(danh sách đầu vào);
    trung bình = tổng / (n + 0.0);
    trả về {
        "__vpp_stats__": "integer",
        "đếm": n,
        "tổng": tổng,
        "nhỏ nhất": nhỏ,
        "lớn nhất": lớn,
        "trung bình": trung bình
    };
};

hàm công khai thống kê số thực(danh sách đầu vào) {
    n = máy ảo lấy độ dài(danh sách đầu vào);
    nếu (n == 0) {
        trả về {
            "__vpp_stats__": "float",
            "đếm": 0,
            "tổng": 0.0,
            "nhỏ nhất": rỗng,
            "lớn nhất": rỗng,
            "trung bình": rỗng
        };
    };

    lặp(i = 0; i < n; i++) {
        kiểu = loại của(danh sách đầu vào[i]);
        nếu (kiểu != "số nguyên" && kiểu != "số thực") {
            ném "VALUE_STATS_NUMBER_REQUIRED";
        };
    };

    tổng = 0.0;
    nhỏ = danh sách đầu vào[0] + 0.0;
    lớn = danh sách đầu vào[0] + 0.0;
    có không phải số = sai;
    lặp(i = 0; i < n; i++) {
        giá trị = danh sách đầu vào[i] + 0.0;
        tổng = tổng + giá trị;
        nếu (thống kê là không phải số(giá trị)) {
            có không phải số = đúng;
        } hoặc {
            nếu (!có không phải số) {
                nếu (giá trị < nhỏ) {
                    nhỏ = giá trị;
                };
                nếu (giá trị > lớn) {
                    lớn = giá trị;
                };
            };
        };
    };

    nếu (có không phải số) {
        không phải số = thành số thực("nan");
        nhỏ = không phải số;
        lớn = không phải số;
    };

    trả về {
        "__vpp_stats__": "float",
        "đếm": n,
        "tổng": tổng,
        "nhỏ nhất": nhỏ,
        "lớn nhất": lớn,
        "trung bình": tổng / n
    };
};

hàm công khai gộp thống kê(a, b) {
    loại a = thống kê yêu cầu(a);
    loại b = thống kê yêu cầu(b);
    nếu (loại a != loại b) {
        ném "VALUE_STATS_INVALID";
    };

    đếm a = lấy từ điển(a, "đếm", 0);
    đếm b = lấy từ điển(b, "đếm", 0);
    nếu (đếm a == 0) {
        trả về b;
    };
    nếu (đếm b == 0) {
        trả về a;
    };

    tổng a = lấy từ điển(a, "tổng", 0);
    tổng b = lấy từ điển(b, "tổng", 0);
    nhỏ a = lấy từ điển(a, "nhỏ nhất", rỗng);
    nhỏ b = lấy từ điển(b, "nhỏ nhất", rỗng);
    lớn a = lấy từ điển(a, "lớn nhất", rỗng);
    lớn b = lấy từ điển(b, "lớn nhất", rỗng);
    đếm = đếm a + đếm b;
    tổng = tổng a + tổng b;

    nếu (loại a == "float") {
        nếu (thống kê là không phải số(tổng a) || thống kê là không phải số(tổng b) ||
            thống kê là không phải số(nhỏ a) || thống kê là không phải số(nhỏ b) ||
            thống kê là không phải số(lớn a) || thống kê là không phải số(lớn b)) {
            không phải số = thành số thực("nan");
            trả về {
                "__vpp_stats__": "float",
                "đếm": đếm,
                "tổng": không phải số,
                "nhỏ nhất": không phải số,
                "lớn nhất": không phải số,
                "trung bình": không phải số
            };
        };
    };

    nhỏ = nhỏ a;
    lớn = lớn a;
    nếu (nhỏ b < nhỏ) {
        nhỏ = nhỏ b;
    };
    nếu (lớn b > lớn) {
        lớn = lớn b;
    };

    trả về {
        "__vpp_stats__": loại a,
        "đếm": đếm,
        "tổng": tổng,
        "nhỏ nhất": nhỏ,
        "lớn nhất": lớn,
        "trung bình": tổng / (đếm + 0.0)
    };
};
nhập gói/lõi/chuyển kiểu;
