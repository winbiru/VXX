// vpp.scripting — ABI nhúng chung: VM legacy dùng VM, native AOT gọi
// compiler V++ và thực thi mã máy; tên intrinsic cũ vẫn tương thích ABI.
nhập gói.nhập xuất.tệp.đọc tệp;
nhập gói.nhập xuất.đường dẫn.đường dẫn cha;

hàm công khai kịch bản chạy nội bộ(mã nguồn, gốc) {
    nếu (loại của(mã nguồn) != "chuỗi") {
        ném "kịch bản chạy: mã nguồn phải là chuỗi";
    };
    nếu (loại của(gốc) != "chuỗi") {
        ném "kịch bản chạy: gốc phải là chuỗi";
    };
    nếu (gốc == "") {
        gốc = ".";
    };
    thử {
        trả về chạy kịch bản máy ảo(mã nguồn, gốc);
    } bắt lỗi (e) {
        ném "kịch bản chạy: " + e;
    };
};

hàm công khai kịch bản chạy(mã nguồn) {
    trả về kịch bản chạy nội bộ(mã nguồn, ".");
};

hàm công khai kịch bản chạy tệp(đường dẫn) {
    mã nguồn = đọc tệp(đường dẫn);
    trả về kịch bản chạy nội bộ(mã nguồn, đường dẫn cha(đường dẫn));
};
