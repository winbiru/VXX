// vi.archive — ZIP32 STORE triển khai bằng V++.
// VM chỉ còn primitive file I/O nhị phân; format ZIP, CRC32, kiểm tra tên
// mục và giới hạn giải nén đều thuộc tầng thư viện V++.

nhập gói.nhập xuất.tệp.đọc các byte tệp;
nhập gói.nhập xuất.tệp.ghi các byte tệp;
nhập gói.nhập xuất.đường dẫn.đường dẫn nối;
nhập gói.nhập xuất.đường dẫn.đường dẫn tên;
nhập gói.nhập xuất.đường dẫn.đường dẫn cha;
nhập gói.nhập xuất.đường dẫn.là tệp;
nhập gói.nhập xuất.thư mục.tạo thư mục;
nhập gói.lõi.bảng mã.mã hóa bảng mã;
nhập gói.lõi.bảng mã.giải mã bảng mã;
nhập gói.lõi.toán học.giới hạn;
nhập gói.lõi.toán học.làm tròn xuống;
nhập gói.lõi.toán học.làm tròn;
nhập gói.bộ sưu tập.từ điển.lấy từ điển;
nhập gói.bộ sưu tập.từ điển.đặt từ điển;
nhập gói.bộ sưu tập.từ điển.có khóa;
nhập gói.bộ sưu tập.từ điển.khóa từ điển;

// Lớp sở hữu toàn bộ thuật toán của mô-đun; các hàm bên dưới chỉ giữ API cũ.
lớp công khai Bộ Lưu Trữ ZIP {
    hàm công khai khởi tạo() {};

    hàm riêng tư lưu trữ yêu cầu khoảng(các byte, vị trí, số lượng, thông báo) {
        nếu (vị trí < 0 || số lượng < 0 || vị trí + số lượng > máy ảo lấy độ dài(các byte)) {
            ném thông báo;
        };
        trả về đúng;
    };

    hàm riêng tư lưu trữ thêm các byte(đích, nguồn) {
        lặp(i = 0; i < máy ảo lấy độ dài(nguồn); i++) {
            máy ảo thêm cuối danh sách(đích, nguồn[i]);
        };
        trả về đích;
    };

    hàm riêng tư lưu trữ lấy các byte(các byte, vị trí, số lượng) {
        mình.lưu trữ yêu cầu khoảng(các byte, vị trí, số lượng, "lưu trữ: dữ liệu ZIP bị cắt ngắn");
        kết quả = [];
        lặp(i = 0; i < số lượng; i++) {
            máy ảo thêm cuối danh sách(kết quả, các byte[vị trí + i]);
        };
        trả về kết quả;
    };

    hàm riêng tư lưu trữ thêm u16(đích, giá trị) {
        nếu (giá trị < 0 || giá trị > 65535) {
            ném "lưu trữ: giá trị vượt giới hạn ZIP16";
        };
        thấp = giá trị % 256;
        cao = làm tròn xuống(giá trị / 256) % 256;
        máy ảo thêm cuối danh sách(đích, thấp);
        máy ảo thêm cuối danh sách(đích, cao);
        trả về đích;
    };

    hàm riêng tư lưu trữ thêm u32(đích, giá trị) {
        nếu (giá trị < 0 || giá trị > 2147483647) {
            ném "lưu trữ: ZIP vượt giới hạn 2 GiB của runtime hiện tại";
        };
        còn lại = giá trị;
        lặp(i = 0; i < 4; i++) {
            máy ảo thêm cuối danh sách(đích, còn lại % 256);
            còn lại = làm tròn xuống(còn lại / 256);
        };
        trả về đích;
    };

    hàm riêng tư lưu trữ đọc u16(các byte, vị trí) {
        mình.lưu trữ yêu cầu khoảng(các byte, vị trí, 2, "lưu trữ: header ZIP bị cắt ngắn");
        trả về các byte[vị trí] + các byte[vị trí + 1] * 256;
    };

    hàm riêng tư lưu trữ đọc u32 giới hạn(các byte, vị trí) {
        mình.lưu trữ yêu cầu khoảng(các byte, vị trí, 4, "lưu trữ: header ZIP bị cắt ngắn");
        nếu (các byte[vị trí + 3] >= 128) {
            ném "lưu trữ: ZIP vượt giới hạn 2 GiB của runtime hiện tại";
        };
        trả về các byte[vị trí] +
               các byte[vị trí + 1] * 256 +
               các byte[vị trí + 2] * 65536 +
               các byte[vị trí + 3] * 16777216;
    };

    hàm riêng tư lưu trữ xor byte(a, b) {
        nếu (a < 0 || a > 255 || b < 0 || b > 255) {
            ném "lưu trữ: CRC32 nhận byte ngoài 0..255";
        };
        x = a;
        y = b;
        trọng số = 1;
        kết quả = 0;
        lặp(i = 0; i < 8; i++) {
            bit thứ nhất = x % 2;
            bit thứ hai = y % 2;
            nếu (bit thứ nhất != bit thứ hai) {
                kết quả = kết quả + trọng số;
            };
            x = làm tròn xuống(x / 2);
            y = làm tròn xuống(y / 2);
            trọng số = trọng số * 2;
        };
        trả về kết quả;
    };

    // CRC32 IEEE ở dạng bốn byte little-endian để tránh phụ thuộc integer unsigned
    // 32-bit/bitwise native của VM.
    hàm riêng tư lưu trữ crc32(các byte) {
        crc = [255, 255, 255, 255];
        lặp(i = 0; i < máy ảo lấy độ dài(các byte); i++) {
            byte = các byte[i];
            nếu (loại của(byte) != "số nguyên" || byte < 0 || byte > 255) {
                ném "lưu trữ: dữ liệu phải là danh sách byte 0..255";
            };
            crc[0] = mình.lưu trữ xor byte(crc[0], byte);
            lặp(bit = 0; bit < 8; bit++) {
                thấp = crc[0] % 2;
                b0 = làm tròn xuống(crc[0] / 2) + (crc[1] % 2) * 128;
                b1 = làm tròn xuống(crc[1] / 2) + (crc[2] % 2) * 128;
                b2 = làm tròn xuống(crc[2] / 2) + (crc[3] % 2) * 128;
                b3 = làm tròn xuống(crc[3] / 2);
                crc[0] = b0;
                crc[1] = b1;
                crc[2] = b2;
                crc[3] = b3;
                nếu (thấp == 1) {
                    crc[0] = mình.lưu trữ xor byte(crc[0], 32);
                    crc[1] = mình.lưu trữ xor byte(crc[1], 131);
                    crc[2] = mình.lưu trữ xor byte(crc[2], 184);
                    crc[3] = mình.lưu trữ xor byte(crc[3], 237);
                };
            };
        };
        lặp(i = 0; i < 4; i++) {
            crc[i] = mình.lưu trữ xor byte(crc[i], 255);
        };
        trả về crc;
    };

    hàm riêng tư lưu trữ các byte bằng(a, b) {
        nếu (máy ảo lấy độ dài(a) != máy ảo lấy độ dài(b)) {
            trả về sai;
        };
        lặp(i = 0; i < máy ảo lấy độ dài(a); i++) {
            nếu (a[i] != b[i]) {
                trả về sai;
            };
        };
        trả về đúng;
    };

    hàm riêng tư lưu trữ tên an toàn(tên) {
        nếu (loại của(tên) != "chuỗi" || máy ảo lấy độ dài(tên) == 0) {
            ném "lưu trữ: tên mục ZIP không an toàn";
        };
        nếu (tên[0] == "/" || tên[0] == "\\") {
            ném "lưu trữ: tên mục ZIP không an toàn";
        };

        kết quả = "";
        đoạn = "";
        lặp(i = 0; i <= máy ảo lấy độ dài(tên); i++) {
            phân cách = i == máy ảo lấy độ dài(tên);
            nếu (!phân cách) {
                phân cách = tên[i] == "/" || tên[i] == "\\";
            };
            nếu (phân cách) {
                nếu (đoạn == "..") {
                    ném "lưu trữ: tên mục ZIP không an toàn";
                };
                nếu (đoạn != "" && đoạn != ".") {
                    lặp(j = 0; j < máy ảo lấy độ dài(đoạn); j++) {
                        nếu (đoạn[j] == ":") {
                            ném "lưu trữ: tên mục ZIP không an toàn";
                        };
                    };
                    kết quả = đường dẫn nối(kết quả, đoạn);
                };
                đoạn = "";
            } hoặc {
                đoạn = đoạn + tên[i];
            };
        };
        nếu (kết quả == "") {
            ném "lưu trữ: tên mục ZIP không an toàn";
        };
        trả về kết quả;
    };

    hàm riêng tư lưu trữ đọc local điểm vào(các byte, vị trí) {
        mình.lưu trữ yêu cầu khoảng(các byte, vị trí, 4, "lưu trữ: ZIP bị cắt ngắn");
        chữ ký = mình.lưu trữ đọc u32 giới hạn(các byte, vị trí);
        nếu (chữ ký == 33639248 || chữ ký == 101010256) {
            trả về {"xong": đúng, "vị trí": vị trí};
        };
        nếu (chữ ký != 67324752) {
            ném "lưu trữ: chữ ký ZIP không hợp lệ";
        };
        mình.lưu trữ yêu cầu khoảng(các byte, vị trí, 30, "lưu trữ: header ZIP bị cắt ngắn");
        cờ = mình.lưu trữ đọc u16(các byte, vị trí + 6);
        nếu (làm tròn xuống(cờ / 8) % 2 == 1) {
            ném "lưu trữ: ZIP dùng data descriptor chưa được hỗ trợ";
        };
        phương thức = mình.lưu trữ đọc u16(các byte, vị trí + 8);
        crc = mình.lưu trữ lấy các byte(các byte, vị trí + 14, 4);
        kích thước nén = mình.lưu trữ đọc u32 giới hạn(các byte, vị trí + 18);
        kích thước gốc = mình.lưu trữ đọc u32 giới hạn(các byte, vị trí + 22);
        dài tên = mình.lưu trữ đọc u16(các byte, vị trí + 26);
        dài phần bổ sung = mình.lưu trữ đọc u16(các byte, vị trí + 28);
        đầu tên = vị trí + 30;
        đầu dữ liệu = đầu tên + dài tên + dài phần bổ sung;
        mình.lưu trữ yêu cầu khoảng(các byte, đầu tên, dài tên + dài phần bổ sung + kích thước nén,
                               "lưu trữ: dữ liệu mục ZIP bị cắt ngắn");
        tên các byte = mình.lưu trữ lấy các byte(các byte, đầu tên, dài tên);
        tên = giải mã bảng mã(tên các byte, "UTF-8");
        trả về {
            "xong": sai,
            "vị trí": vị trí,
            "vị trí dữ liệu": đầu dữ liệu,
            "vị trí kế": đầu dữ liệu + kích thước nén,
            "tên": tên,
            "phương thức": phương thức,
            "crc": crc,
            "kích thước nén": kích thước nén,
            "kích thước gốc": kích thước gốc
        };
    };

    hàm công khai lưu trữ tạo zip(đường zip, danh sách tệp) {
        nếu (loại của(danh sách tệp) != "danh sách") {
            ném "lưu trữ tạo zip: danh sách tệp phải là danh sách";
        };
        zip = [];
        mục = [];
        đã dùng = {};

        lặp(i = 0; i < máy ảo lấy độ dài(danh sách tệp); i++) {
            nguồn = danh sách tệp[i];
            nếu (loại của(nguồn) != "chuỗi") {
                ném "lưu trữ tạo zip: danh sách chỉ được chứa đường dẫn chuỗi";
            };
            nếu (!là tệp(nguồn)) {
                ném "lưu trữ tạo zip: nguồn phải là tệp thường";
            };
            tên = đường dẫn tên(nguồn);
            mình.lưu trữ tên an toàn(tên);
            nếu (máy ảo có khóa từ điển(đã dùng, tên)) {
                ném "lưu trữ tạo zip: tên mục không hợp lệ hoặc bị trùng";
            };
            đặt từ điển(đã dùng, tên, đúng);
            tên các byte = mã hóa bảng mã(tên, "UTF-8");
            nếu (máy ảo lấy độ dài(tên các byte) > 65535) {
                ném "lưu trữ: tên mục ZIP quá dài";
            };
            dữ liệu = đọc các byte tệp(nguồn);
            kích thước = máy ảo lấy độ dài(dữ liệu);
            vị trí = máy ảo lấy độ dài(zip);
            crc = mình.lưu trữ crc32(dữ liệu);

            mình.lưu trữ thêm u32(zip, 67324752);
            mình.lưu trữ thêm u16(zip, 20);
            mình.lưu trữ thêm u16(zip, 2048);
            mình.lưu trữ thêm u16(zip, 0);
            mình.lưu trữ thêm u16(zip, 0);
            mình.lưu trữ thêm u16(zip, 0);
            mình.lưu trữ thêm các byte(zip, crc);
            mình.lưu trữ thêm u32(zip, kích thước);
            mình.lưu trữ thêm u32(zip, kích thước);
            mình.lưu trữ thêm u16(zip, máy ảo lấy độ dài(tên các byte));
            mình.lưu trữ thêm u16(zip, 0);
            mình.lưu trữ thêm các byte(zip, tên các byte);
            mình.lưu trữ thêm các byte(zip, dữ liệu);

            máy ảo thêm cuối danh sách(mục, {
                "tên": tên,
                "tên bytes": tên các byte,
                "crc": crc,
                "kích thước": kích thước,
                "vị trí": vị trí
            });
        };

        vị trí trung tâm = máy ảo lấy độ dài(zip);
        lặp(i = 0; i < máy ảo lấy độ dài(mục); i++) {
            điểm vào = mục[i];
            tên các byte = lấy từ điển(điểm vào, "tên bytes", []);
            crc = lấy từ điển(điểm vào, "crc", []);
            kích thước = lấy từ điển(điểm vào, "kích thước", 0);
            vị trí = lấy từ điển(điểm vào, "vị trí", 0);
            mình.lưu trữ thêm u32(zip, 33639248);
            mình.lưu trữ thêm u16(zip, 20);
            mình.lưu trữ thêm u16(zip, 20);
            mình.lưu trữ thêm u16(zip, 2048);
            mình.lưu trữ thêm u16(zip, 0);
            mình.lưu trữ thêm u16(zip, 0);
            mình.lưu trữ thêm u16(zip, 0);
            mình.lưu trữ thêm các byte(zip, crc);
            mình.lưu trữ thêm u32(zip, kích thước);
            mình.lưu trữ thêm u32(zip, kích thước);
            mình.lưu trữ thêm u16(zip, máy ảo lấy độ dài(tên các byte));
            mình.lưu trữ thêm u16(zip, 0);
            mình.lưu trữ thêm u16(zip, 0);
            mình.lưu trữ thêm u16(zip, 0);
            mình.lưu trữ thêm u16(zip, 0);
            mình.lưu trữ thêm u32(zip, 0);
            mình.lưu trữ thêm u32(zip, vị trí);
            mình.lưu trữ thêm các byte(zip, tên các byte);
        };
        kích thước trung tâm = máy ảo lấy độ dài(zip) - vị trí trung tâm;
        nếu (máy ảo lấy độ dài(mục) > 65535) {
            ném "lưu trữ: ZIP vượt giới hạn ZIP32";
        };
        mình.lưu trữ thêm u32(zip, 101010256);
        mình.lưu trữ thêm u16(zip, 0);
        mình.lưu trữ thêm u16(zip, 0);
        mình.lưu trữ thêm u16(zip, máy ảo lấy độ dài(mục));
        mình.lưu trữ thêm u16(zip, máy ảo lấy độ dài(mục));
        mình.lưu trữ thêm u32(zip, kích thước trung tâm);
        mình.lưu trữ thêm u32(zip, vị trí trung tâm);
        mình.lưu trữ thêm u16(zip, 0);
        ghi các byte tệp(đường zip, zip);
        trả về máy ảo lấy độ dài(mục);
    };

    hàm công khai lưu trữ liệt kê zip(đường zip) {
        các byte = đọc các byte tệp(đường zip);
        kết quả = [];
        vị trí = 0;
        khi (vị trí < máy ảo lấy độ dài(các byte)) {
            điểm vào = mình.lưu trữ đọc local điểm vào(các byte, vị trí);
            nếu (lấy từ điển(điểm vào, "xong", sai)) {
                trả về kết quả;
            };
            máy ảo thêm cuối danh sách(kết quả, lấy từ điển(điểm vào, "tên", ""));
            vị trí = lấy từ điển(điểm vào, "vị trí kế", vị trí);
        };
        ném "lưu trữ: ZIP bị cắt ngắn";
    };

    hàm công khai lưu trữ giải nén zip(đường zip, thư mục đích, mức trần byte = 67108864) {
        nếu (loại của(mức trần byte) != "số nguyên" || mức trần byte < 0) {
            ném "lưu trữ giải nén zip: giới hạn byte phải không âm";
        };
        các byte = đọc các byte tệp(đường zip);
        tạo thư mục(thư mục đích);
        vị trí = 0;
        tổng = 0;
        số mục = 0;
        khi (vị trí < máy ảo lấy độ dài(các byte)) {
            điểm vào = mình.lưu trữ đọc local điểm vào(các byte, vị trí);
            nếu (lấy từ điển(điểm vào, "xong", sai)) {
                trả về số mục;
            };
            phương thức = lấy từ điển(điểm vào, "phương thức", -1);
            kích thước nén = lấy từ điển(điểm vào, "kích thước nén", -1);
            kích thước gốc = lấy từ điển(điểm vào, "kích thước gốc", -1);
            nếu (phương thức != 0 || kích thước nén != kích thước gốc) {
                ném "lưu trữ: chỉ giải nén ZIP phương thức STORE (không nén)";
            };
            tổng = tổng + kích thước gốc;
            nếu (tổng > mức trần byte) {
                ném "lưu trữ: vượt giới hạn dung lượng giải nén";
            };
            tên = lấy từ điển(điểm vào, "tên", "");
            tương đối = mình.lưu trữ tên an toàn(tên);
            đầu = lấy từ điển(điểm vào, "vị trí dữ liệu", -1);
            dữ liệu = mình.lưu trữ lấy các byte(các byte, đầu, kích thước gốc);
            crc mong đợi = lấy từ điển(điểm vào, "crc", []);
            nếu (!mình.lưu trữ các byte bằng(mình.lưu trữ crc32(dữ liệu), crc mong đợi)) {
                ném "lưu trữ: CRC32 không khớp";
            };
            đích = đường dẫn nối(thư mục đích, tương đối);
            cha = đường dẫn cha(đích);
            nếu (cha != "") {
                tạo thư mục(cha);
            };
            ghi các byte tệp(đích, dữ liệu);
            số mục = số mục + 1;
            vị trí = lấy từ điển(điểm vào, "vị trí kế", vị trí);
        };
        ném "lưu trữ: ZIP bị cắt ngắn";
    };
};


hàm công khai lưu trữ tạo zip(đường zip, danh sách tệp) {
    bộ chuyển tiếp = Bộ Lưu Trữ ZIP();
    trả về bộ chuyển tiếp.lưu trữ tạo zip(đường zip, danh sách tệp);
};

hàm công khai lưu trữ liệt kê zip(đường zip) {
    bộ chuyển tiếp = Bộ Lưu Trữ ZIP();
    trả về bộ chuyển tiếp.lưu trữ liệt kê zip(đường zip);
};

hàm công khai lưu trữ giải nén zip(đường zip, thư mục đích, mức trần byte = 67108864) {
    bộ chuyển tiếp = Bộ Lưu Trữ ZIP();
    trả về bộ chuyển tiếp.lưu trữ giải nén zip(đường zip, thư mục đích, mức trần byte);
};
