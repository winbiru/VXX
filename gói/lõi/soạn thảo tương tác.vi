// vpp.editpad — bộ đệm nhiều dòng cho REPL/công cụ tương tác.
nhập bộ sưu tập;
nhập văn bản;
nhập kịch bản;

hàm soạn thảo tạo() {
    trả về {"dòng": []};
};

hàm soạn thảo thêm(bộ, dòng) {
    ds = lấy map(bộ, "dòng", []);
    thêm(ds, dòng);
    trả về độ dài(ds);
};

hàm soạn thảo thay(bộ, chỉ số, dòng) {
    ds = lấy map(bộ, "dòng", []);
    ds[chỉ số] = dòng;
    trả về 1;
};

hàm soạn thảo xóa dòng(bộ, chỉ số) {
    ds = lấy map(bộ, "dòng", []);
    trả về xóa tại(ds, chỉ số);
};

hàm soạn thảo nội dung(bộ) {
    ds = lấy map(bộ, "dòng", []);
    nối = bộ nối chuỗi("\n");
    lặp(i = 0; i < độ dài(ds); i++) {
        bộ nối thêm(nối, ds[i]);
    };
    trả về bộ nối kết quả(nối);
};

hàm soạn thảo chạy(bộ) {
    trả về kịch bản chạy(soạn thảo nội dung(bộ));
};
