// vi.charsets — chuyển đổi chuỗi UTF-8 với các bảng mã nền tảng ổn định.
// Toàn bộ thuật toán UTF-8/ASCII/Latin-1 nằm ở V++. VM chỉ có hai opcode
// biểu diễn: sao chép byte chuỗi <-> danh sách, không giải mã Unicode.

nhập gói/lõi/toán học;
nhập gói/lõi/chuyển kiểu;

hàm công khai mã điểm unicode(c) {
    nếu (loại của(c) != "chuỗi" || máy ảo lấy độ dài(c) != 1) {
        ném "bảng mã: cần đúng một ký tự Unicode";
    };
    các byte = chuỗi thành byte máy ảo(c);
    n = máy ảo lấy độ dài(các byte);
    nếu (bảng mã unicode tám bit độ dài đoạn(các byte, 0) != n) {
        ném "bảng mã: cần đúng một ký tự Unicode";
    };
    mã = các byte[0];
    nếu (n == 2) { mã = mã % 32; };
    nếu (n == 3) { mã = mã % 16; };
    nếu (n == 4) { mã = mã % 8; };
    lặp(i = 1; i < n; i++) {
        mã = mã * 64 + các byte[i] % 64;
    };
    trả về mã;
};

hàm công khai ký tự unicode(mã) {
    nếu (loại của(mã) != "số nguyên" || mã < 0 || mã > 1114111 ||
        (mã >= 55296 && mã <= 57343)) {
        ném "bảng mã: mã Unicode không hợp lệ";
    };
    nếu (mã <= 127) { trả về chuỗi từ byte máy ảo([mã]); };
    nếu (mã <= 2047) {
        trả về chuỗi từ byte máy ảo([
            192 + làm tròn xuống(mã / 64), 128 + mã % 64
        ]);
    };
    nếu (mã <= 65535) {
        trả về chuỗi từ byte máy ảo([
            224 + làm tròn xuống(mã / 4096),
            128 + làm tròn xuống(mã / 64) % 64, 128 + mã % 64
        ]);
    };
    trả về chuỗi từ byte máy ảo([
        240 + làm tròn xuống(mã / 262144),
        128 + làm tròn xuống(mã / 4096) % 64,
        128 + làm tròn xuống(mã / 64) % 64, 128 + mã % 64
    ]);
};

hàm công khai bảng mã unicode tám bit mã hóa(văn bản) {
    các byte = chuỗi thành byte máy ảo(văn bản);
    vị trí = 0;
    lặp(vòng = 0; vị trí < máy ảo lấy độ dài(các byte); vòng++) {
        n = bảng mã unicode tám bit độ dài đoạn(các byte, vị trí);
        nếu (n < 1) { ném "bảng mã: cần đúng một ký tự Unicode"; };
        vị trí = vị trí + n;
    };
    trả về các byte;
};

// Hạ chữ ngay trong V++ để module bảng mã không cần primitive đổi
// hoa/thường của runtime. Chế độ lỗi có cả từ khóa tiếng Việt như BÁO_LỖI,
// vì vậy bảng giữ cùng contract ASCII + chữ dựng sẵn tiếng Việt của vi.text.
hàm riêng tư bảng mã thường nội bộ(văn bản) {
    hoa = "ABCDEFGHIJKLMNOPQRSTUVWXYZ" +
          "ĂÂÊÔƠƯĐÀÁẢÃẠẰẮẲẴẶẦẤẨẪẬÈÉẺẼẸỀẾỂỄỆÌÍỈĨỊÒÓỎÕỌỒỐỔỖỘỜỚỞỠỢÙÚỦŨỤỪỨỬỮỰỲÝỶỸỴ";
    thường = "abcdefghijklmnopqrstuvwxyz" +
             "ăâêôơưđàáảãạằắẳẵặầấẩẫậèéẻẽẹềếểễệìíỉĩịòóỏõọồốổỗộờớởỡợùúủũụừứửữựỳýỷỹỵ";
    kết quả = "";
    lặp(i = 0; i < máy ảo lấy độ dài(văn bản); i++) {
        c = văn bản[i];
        thay = c;
        tìm thấy = sai;
        lặp(j = 0; j < máy ảo lấy độ dài(hoa) && !tìm thấy; j++) {
            nếu (hoa[j] == c) {
                thay = thường[j];
                tìm thấy = đúng;
            };
        };
        kết quả = kết quả + thay;
    };
    trả về kết quả;
};

hàm riêng tư bảng mã chuẩn hóa tên(tên bảng mã) {
    nếu (loại của(tên bảng mã) != "chuỗi") {
        ném "bảng mã: tên bảng mã phải là chuỗi";
    };

    tên = bảng mã thường nội bộ(tên bảng mã);
    gọn = "";
    lặp(i = 0; i < máy ảo lấy độ dài(tên); i++) {
        c = tên[i];
        nếu (c != "-" && c != "_" && c != " ") {
            gọn = gọn + c;
        };
    };
    nếu (gọn == "utf8") { trả về "utf8"; };
    nếu (gọn == "ascii" || gọn == "usascii") { trả về "ascii"; };
    nếu (gọn == "latin1" || gọn == "iso88591") { trả về "latin1"; };
    trả về "";
};

hàm riêng tư bảng mã kiểm tra các byte(các byte) {
    nếu (loại của(các byte) != "danh sách") {
        ném "bảng mã: dữ liệu byte phải là danh sách";
    };
    lặp(i = 0; i < máy ảo lấy độ dài(các byte); i++) {
        nếu (loại của(các byte[i]) != "số nguyên") {
            ném "bảng mã: mỗi byte phải là số nguyên";
        };
        nếu (các byte[i] < 0 || các byte[i] > 255) {
            ném "bảng mã: byte phải trong 0..255";
        };
    };
    trả về đúng;
};

hàm riêng tư bảng mã chuẩn hóa chế độ lỗi(chế độ) {
    nếu (loại của(chế độ) != "chuỗi") {
        ném "bảng mã: chế độ lỗi phải là chuỗi";
    };
    tên = bảng mã thường nội bộ(chế độ);
    nếu (tên == "báo_lỗi" || tên == "báo lỗi" || tên == "nghiêm" || tên == "strict") {
        trả về "nghiêm";
    };
    nếu (tên == "thay_thế" || tên == "thay thế" || tên == "replace") {
        trả về "thay thế";
    };
    ném "bảng mã: chế độ lỗi không được hỗ trợ";
};

hàm riêng tư bảng mã unicode tám bit là byte tiếp(byte) {
    trả về byte >= 128 && byte <= 191;
};

// Số dương: sequence hợp lệ. Số âm: số byte của maximal valid prefix cần
// tiêu thụ khi thay malformed UTF-8 bằng U+FFFD.
hàm công khai bảng mã unicode tám bit độ dài đoạn(các byte, vị trí) {
    n = máy ảo lấy độ dài(các byte);
    b0 = các byte[vị trí];
    nếu (b0 <= 127) {
        trả về 1;
    };

    nếu (b0 >= 194 && b0 <= 223) {
        nếu (vị trí + 1 >= n) {
            trả về -1;
        };
        nếu (bảng mã unicode tám bit là byte tiếp(các byte[vị trí + 1])) {
            trả về 2;
        };
        trả về -1;
    };

    nếu (b0 >= 224 && b0 <= 239) {
        nếu (vị trí + 1 >= n) {
            trả về -1;
        };
        b1 = các byte[vị trí + 1];
        hợp lệ b1 = bảng mã unicode tám bit là byte tiếp(b1);
        nếu (b0 == 224 && b1 < 160) {
            hợp lệ b1 = sai;
        };
        nếu (b0 == 237 && b1 > 159) {
            hợp lệ b1 = sai;
        };
        nếu (!hợp lệ b1) {
            trả về -1;
        };
        nếu (vị trí + 2 >= n) {
            trả về -2;
        };
        nếu (bảng mã unicode tám bit là byte tiếp(các byte[vị trí + 2])) {
            trả về 3;
        };
        trả về -2;
    };

    nếu (b0 >= 240 && b0 <= 244) {
        nếu (vị trí + 1 >= n) {
            trả về -1;
        };
        b1 = các byte[vị trí + 1];
        hợp lệ b1 = bảng mã unicode tám bit là byte tiếp(b1);
        nếu (b0 == 240 && b1 < 144) {
            hợp lệ b1 = sai;
        };
        nếu (b0 == 244 && b1 > 143) {
            hợp lệ b1 = sai;
        };
        nếu (!hợp lệ b1) {
            trả về -1;
        };
        nếu (vị trí + 2 >= n) {
            trả về -2;
        };
        nếu (!bảng mã unicode tám bit là byte tiếp(các byte[vị trí + 2])) {
            trả về -2;
        };
        nếu (vị trí + 3 >= n) {
            trả về -3;
        };
        nếu (bảng mã unicode tám bit là byte tiếp(các byte[vị trí + 3])) {
            trả về 4;
        };
        trả về -3;
    };

    trả về -1;
};

hàm riêng tư bảng mã unicode tám bit giải mã(các byte, chế độ) {
    kết quả = "";
    ký tự thay = ký tự unicode(65533);
    vị trí = 0;
    n = máy ảo lấy độ dài(các byte);
    lặp(vòng = 0; vị trí < n; vòng++) {
        độ dài = bảng mã unicode tám bit độ dài đoạn(các byte, vị trí);
        nếu (độ dài > 0) {
            b0 = các byte[vị trí];
            mã = b0;
            nếu (độ dài == 2) {
                mã = (b0 % 32) * 64 + (các byte[vị trí + 1] % 64);
            } hoặc {
                nếu (độ dài == 3) {
                    mã = (b0 % 16) * 4096 +
                        (các byte[vị trí + 1] % 64) * 64 +
                        (các byte[vị trí + 2] % 64);
                } hoặc {
                    nếu (độ dài == 4) {
                        mã = (b0 % 8) * 262144 +
                            (các byte[vị trí + 1] % 64) * 4096 +
                            (các byte[vị trí + 2] % 64) * 64 +
                            (các byte[vị trí + 3] % 64);
                    };
                };
            };
            kết quả = kết quả + ký tự unicode(mã);
            vị trí = vị trí + độ dài;
        } hoặc {
            nếu (chế độ == "nghiêm") {
                ném "TEXT_DECODE_INVALID";
            };
            kết quả = kết quả + ký tự thay;
            vị trí = vị trí - độ dài;
        };
    };
    trả về kết quả;
};

hàm công khai bảng mã hỗ trợ(tên bảng mã) {
    trả về bảng mã chuẩn hóa tên(tên bảng mã) != "";
};

hàm công khai mã hóa bảng mã(văn bản, tên bảng mã) {
    nếu (loại của(văn bản) != "chuỗi") {
        ném "mã hóa bảng mã: văn bản phải là chuỗi";
    };
    bảng = bảng mã chuẩn hóa tên(tên bảng mã);
    nếu (bảng == "") {
        ném "mã hóa bảng mã: bảng mã không được hỗ trợ";
    };
    nếu (bảng == "utf8") {
        trả về bảng mã unicode tám bit mã hóa(văn bản);
    };

    kết quả = [];
    lặp(i = 0; i < máy ảo lấy độ dài(văn bản); i++) {
        mã = mã điểm unicode(văn bản[i]);
        nếu (bảng == "ascii" && mã > 127) {
            ném "mã hóa bảng mã: ký tự không biểu diễn được trong bảng mã đích";
        };
        nếu (mã > 255) {
            ném "mã hóa bảng mã: ký tự không biểu diễn được trong bảng mã đích";
        };
        máy ảo thêm cuối danh sách(kết quả, mã);
    };
    trả về kết quả;
};

hàm công khai giải mã bảng mã(các byte, tên bảng mã, chế độ lỗi = "BÁO_LỖI") {
    bảng mã kiểm tra các byte(các byte);
    bảng = bảng mã chuẩn hóa tên(tên bảng mã);
    nếu (bảng == "") {
        ném "giải mã bảng mã: bảng mã không được hỗ trợ";
    };
    chế độ = bảng mã chuẩn hóa chế độ lỗi(chế độ lỗi);
    nếu (bảng == "utf8") {
        trả về bảng mã unicode tám bit giải mã(các byte, chế độ);
    };

    kết quả = "";
    lặp(i = 0; i < máy ảo lấy độ dài(các byte); i++) {
        byte = các byte[i];
        nếu (bảng == "ascii") {
            nếu (byte > 127) {
                nếu (chế độ == "nghiêm") {
                    ném "TEXT_DECODE_INVALID";
                };
                kết quả = kết quả + ký tự unicode(65533);
            } hoặc {
                kết quả = kết quả + ký tự unicode(byte);
            };
        } hoặc {
            kết quả = kết quả + ký tự unicode(byte);
        };
    };
    trả về kết quả;
};
