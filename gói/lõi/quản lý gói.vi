// vpp.packages — thao tác manifest package ở tầng V++.
//
// Module này cố ý chỉ giữ policy/dữ liệu vpp.json. Git, registry, cache và
// materialization vẫn là ranh giới toolchain/OS; parse, validation và mutation
// manifest không cần nằm trong C++.

nhập gói/dữ liệu/json/chính;
nhập gói/nhập xuất/tệp;
nhập gói/bộ sưu tập/danh sách;
nhập gói/bộ sưu tập/từ điển;
nhập gói/văn bản/chuỗi;

hàm quản lý gói tên hợp lệ(tên) {
    nếu (loại của(tên) != "chuỗi" || tên == "" || tên == "." || tên == "..") {
        trả về sai;
    };
    cấm = "/\\:*?\"<>|";
    lặp(i = 0; i < độ dài(tên); i++) {
        mã = chuỗi mã điểm unicode(tên[i]);
        nếu (mã < 32 || mã == 127 || chứa chính xác(cấm, tên[i])) {
            trả về sai;
        };
    };
    trả về đúng;
};

hàm quản lý gói đoạn semver hợp lệ(đoạn) {
    nếu (đoạn == "") { trả về sai; };
    nếu (độ dài(đoạn) > 1 && đoạn[0] == "0") { trả về sai; };
    nếu (độ dài(đoạn) > 10) { trả về sai; };
    nếu (độ dài(đoạn) == 10 && đoạn > "2147483647") { trả về sai; };
    lặp(i = 0; i < độ dài(đoạn); i++) {
        nếu (đoạn[i] < "0" || đoạn[i] > "9") {
            trả về sai;
        };
    };
    trả về đúng;
};

// SemVer ở package layer phải tương thích implementation C++ hiện hành:
// core là i32 không dấu, prerelease cấm numeric identifier có số 0 đầu,
// build metadata không tham gia precedence.
hàm quản lý gói định danh semver hợp lệ(định_danh, cấm_số_0_đầu) {
    nếu (định_danh == "") { trả về sai; };
    toàn_số = đúng;
    lặp(i = 0; i < độ dài(định_danh); i++) {
        c = định_danh[i];
        chữ = (c >= "a" && c <= "z") || (c >= "A" && c <= "Z");
        số = c >= "0" && c <= "9";
        nếu (!chữ && !số && c != "-") { trả về sai; };
        nếu (!số) { toàn_số = sai; };
    };
    nếu (cấm_số_0_đầu && toàn_số && độ dài(định_danh) > 1 && định_danh[0] == "0") {
        trả về sai;
    };
    trả về đúng;
};

hàm quản lý gói danh sách định danh semver(văn_bản, cấm_số_0_đầu) {
    nếu (văn_bản == "") { ném "SEMVER_IDENTIFIER_INVALID"; };
    ds = tách literal(văn_bản, ".");
    lặp(i = 0; i < độ dài(ds); i++) {
        nếu (!quản lý gói định danh semver hợp lệ(ds[i], cấm_số_0_đầu)) {
            ném "SEMVER_IDENTIFIER_INVALID";
        };
    };
    trả về ds;
};

hàm quản lý gói phân tích semver(phiên_bản) {
    nếu (loại của(phiên_bản) != "chuỗi" || phiên_bản == "") {
        ném "SEMVER_INVALID";
    };

    dấu_cộng = tìm chuỗi chính xác(phiên_bản, "+", 0);
    dấu_trừ_tìm = tìm chuỗi chính xác(phiên_bản, "-", 0);
    dấu_trừ = rỗng;
    nếu (dấu_trừ_tìm != rỗng) {
        nếu (dấu_cộng == rỗng) {
            dấu_trừ = dấu_trừ_tìm;
        } nếu không {
            nếu (dấu_trừ_tìm < dấu_cộng) { dấu_trừ = dấu_trừ_tìm; };
        };
    };

    kết_core = độ dài(phiên_bản);
    nếu (dấu_trừ != rỗng) { kết_core = dấu_trừ; };
    nếu (dấu_trừ == rỗng && dấu_cộng != rỗng) { kết_core = dấu_cộng; };
    core = con chuỗi(phiên_bản, 0, kết_core);
    phần = tách literal(core, ".");
    nếu (độ dài(phần) != 3) { ném "SEMVER_CORE_INVALID"; };
    lặp(i = 0; i < 3; i++) {
        nếu (!quản lý gói đoạn semver hợp lệ(phần[i])) {
            ném "SEMVER_CORE_INVALID";
        };
    };

    prerelease = [];
    nếu (dấu_trừ != rỗng) {
        kết_prerelease = độ dài(phiên_bản);
        nếu (dấu_cộng != rỗng) { kết_prerelease = dấu_cộng; };
        chữ_prerelease = con chuỗi(phiên_bản, dấu_trừ + 1, kết_prerelease);
        prerelease = quản lý gói danh sách định danh semver(chữ_prerelease, đúng);
    };

    build = [];
    nếu (dấu_cộng != rỗng) {
        chữ_build = con chuỗi(phiên_bản, dấu_cộng + 1, độ dài(phiên_bản));
        build = quản lý gói danh sách định danh semver(chữ_build, sai);
    };

    trả về {
        "major": thành số nguyên(phần[0]),
        "minor": thành số nguyên(phần[1]),
        "patch": thành số nguyên(phần[2]),
        "prerelease": prerelease,
        "build": build,
        "text": phiên_bản
    };
};

hàm quản lý gói semver hợp lệ(phiên_bản) {
    thử {
        quản lý gói phân tích semver(phiên_bản);
        trả về đúng;
    } bắt lỗi (e) {
        trả về sai;
    };
};

hàm quản lý gói định danh semver là số(định_danh) {
    nếu (định_danh == "") { trả về sai; };
    lặp(i = 0; i < độ dài(định_danh); i++) {
        nếu (định_danh[i] < "0" || định_danh[i] > "9") { trả về sai; };
    };
    trả về đúng;
};

hàm quản lý gói so sánh định danh semver(a, b) {
    a_số = quản lý gói định danh semver là số(a);
    b_số = quản lý gói định danh semver là số(b);
    nếu (a_số && b_số) {
        nếu (độ dài(a) < độ dài(b)) { trả về -1; };
        nếu (độ dài(a) > độ dài(b)) { trả về 1; };
        nếu (a < b) { trả về -1; };
        nếu (a > b) { trả về 1; };
        trả về 0;
    };
    nếu (a_số && !b_số) { trả về -1; };
    nếu (!a_số && b_số) { trả về 1; };
    nếu (a < b) { trả về -1; };
    nếu (a > b) { trả về 1; };
    trả về 0;
};

hàm quản lý gói so sánh semver(a, b) {
    trái = a;
    phải = b;
    nếu (loại của(trái) == "chuỗi") { trái = quản lý gói phân tích semver(trái); };
    nếu (loại của(phải) == "chuỗi") { phải = quản lý gói phân tích semver(phải); };

    khóa = ["major", "minor", "patch"];
    lặp(i = 0; i < độ dài(khóa); i++) {
        x = lấy map(trái, khóa[i], 0);
        y = lấy map(phải, khóa[i], 0);
        nếu (x < y) { trả về -1; };
        nếu (x > y) { trả về 1; };
    };

    pre_trái = lấy map(trái, "prerelease", []);
    pre_phải = lấy map(phải, "prerelease", []);
    nếu (độ dài(pre_trái) == 0 && độ dài(pre_phải) > 0) { trả về 1; };
    nếu (độ dài(pre_trái) > 0 && độ dài(pre_phải) == 0) { trả về -1; };
    chung = độ dài(pre_trái);
    nếu (độ dài(pre_phải) < chung) { chung = độ dài(pre_phải); };
    lặp(i = 0; i < chung; i++) {
        cmp = quản lý gói so sánh định danh semver(pre_trái[i], pre_phải[i]);
        nếu (cmp != 0) { trả về cmp; };
    };
    nếu (độ dài(pre_trái) < độ dài(pre_phải)) { trả về -1; };
    nếu (độ dài(pre_trái) > độ dài(pre_phải)) { trả về 1; };
    trả về 0;
};

hàm quản lý gói tách khoảng trắng(văn_bản) {
    token = [];
    hiện_tại = "";
    lặp(i = 0; i < độ dài(văn_bản); i++) {
        c = văn_bản[i];
        trắng = c == " " || c == "\t" || c == "\r" || c == "\n";
        nếu (trắng) {
            nếu (hiện_tại != "") { thêm(token, hiện_tại); hiện_tại = ""; };
        } nếu không {
            hiện_tại = hiện_tại + c;
        };
    };
    nếu (hiện_tại != "") { thêm(token, hiện_tại); };
    trả về token;
};

hàm quản lý gói comparator(op, phiên_bản) {
    trả về {"op": op, "version": phiên_bản};
};

hàm quản lý gói upper caret(phiên_bản) {
    major = lấy map(phiên_bản, "major", 0);
    minor = lấy map(phiên_bản, "minor", 0);
    patch = lấy map(phiên_bản, "patch", 0);
    nếu (major > 0) { trả về {"major": major + 1, "minor": 0, "patch": 0, "prerelease": [], "build": []}; };
    nếu (minor > 0) { trả về {"major": 0, "minor": minor + 1, "patch": 0, "prerelease": [], "build": []}; };
    trả về {"major": 0, "minor": 0, "patch": patch + 1, "prerelease": [], "build": []};
};

hàm quản lý gói upper tilde(phiên_bản) {
    trả về {
        "major": lấy map(phiên_bản, "major", 0),
        "minor": lấy map(phiên_bản, "minor", 0) + 1,
        "patch": 0,
        "prerelease": [],
        "build": []
    };
};

hàm quản lý gói phân tích range(range) {
    nếu (loại của(range) != "chuỗi") { ném "SEMVER_RANGE_INVALID"; };
    token = quản lý gói tách khoảng trắng(range);
    nếu (độ dài(token) == 0) { trả về {"bất kỳ": 1, "comparators": []}; };
    nếu (độ dài(token) == 1 && token[0] == "*") {
        trả về {"bất kỳ": 1, "comparators": []};
    };

    comparators = [];
    lặp(i = 0; i < độ dài(token); i++) {
        t = token[i];
        nếu (t == "*") { ném "SEMVER_WILDCARD_MUST_STAND_ALONE"; };
        nếu (tìm chuỗi chính xác(t, "||", 0) != rỗng) { ném "SEMVER_OR_UNSUPPORTED"; };
        nếu (t == "") { ném "SEMVER_RANGE_INVALID"; };

        đầu = t[0];
        nếu (đầu == "^" || đầu == "~") {
            nếu (độ dài(t) == 1) { ném "SEMVER_COMPARATOR_MISSING_VERSION"; };
            v = quản lý gói phân tích semver(con chuỗi(t, 1, độ dài(t)));
            thêm(comparators, quản lý gói comparator(">=", v));
            nếu (đầu == "^") {
                thêm(comparators, quản lý gói comparator("<", quản lý gói upper caret(v)));
            } nếu không {
                thêm(comparators, quản lý gói comparator("<", quản lý gói upper tilde(v)));
            };
        } nếu không {
            op = "=";
            offset = 0;
            nếu (độ dài(t) >= 2 && con chuỗi(t, 0, 2) == ">=") { op = ">="; offset = 2; }
            nếu (độ dài(t) >= 2 && con chuỗi(t, 0, 2) == "<=") { op = "<="; offset = 2; }
            nếu (offset == 0 && đầu == ">") { op = ">"; offset = 1; };
            nếu (offset == 0 && đầu == "<") { op = "<"; offset = 1; };
            nếu (offset == 0 && đầu == "=") { offset = 1; };
            nếu (offset >= độ dài(t)) { ném "SEMVER_COMPARATOR_MISSING_VERSION"; };
            v = quản lý gói phân tích semver(con chuỗi(t, offset, độ dài(t)));
            thêm(comparators, quản lý gói comparator(op, v));
        };
    };
    trả về {"bất kỳ": 0, "comparators": comparators};
};

hàm quản lý gói range hợp lệ(range) {
    thử {
        quản lý gói phân tích range(range);
        trả về đúng;
    } bắt lỗi (e) {
        trả về sai;
    };
};

hàm quản lý gói khớp range(phiên_bản, range) {
    v = phiên_bản;
    nếu (loại của(v) == "chuỗi") { v = quản lý gói phân tích semver(v); };
    r = range;
    nếu (loại của(r) == "chuỗi") { r = quản lý gói phân tích range(r); };
    nếu (lấy map(r, "bất kỳ", 0) == 1) { trả về đúng; };
    comparators = lấy map(r, "comparators", []);
    lặp(i = 0; i < độ dài(comparators); i++) {
        c = comparators[i];
        cmp = quản lý gói so sánh semver(v, lấy map(c, "version", {}));
        op = lấy map(c, "op", "=");
        hợp = sai;
        nếu (op == "=" && cmp == 0) { hợp = đúng; };
        nếu (op == ">" && cmp > 0) { hợp = đúng; };
        nếu (op == ">=" && cmp >= 0) { hợp = đúng; };
        nếu (op == "<" && cmp < 0) { hợp = đúng; };
        nếu (op == "<=" && cmp <= 0) { hợp = đúng; };
        nếu (!hợp) { trả về sai; };
    };
    trả về đúng;
};

hàm quản lý gói xác minh phụ thuộc(phụ_thuộc, tên_đã_gặp) {
    nếu (loại của(phụ_thuộc) != "từ điển") {
        ném "vpp.json: mỗi dependency phải là object";
    };
    tên = lấy map(phụ_thuộc, "name", "");
    nếu (!quản lý gói tên hợp lệ(tên)) {
        ném "vpp.json: dependency name không hợp lệ";
    };
    nếu (tìm chỉ số(tên_đã_gặp, tên) >= 0) {
        ném "vpp.json: dependency bị khai báo trùng: " + tên;
    };
    thêm(tên_đã_gặp, tên);

    phiên_bản = lấy map(phụ_thuộc, "version", "");
    nếu (loại của(phiên_bản) != "chuỗi" || phiên_bản == "") {
        ném "vpp.json: version range của dependency không hợp lệ: " + tên;
    };
    nếu (!quản lý gói range hợp lệ(phiên_bản)) {
        ném "vpp.json: version range của dependency không hợp lệ: " + tên + " = " + phiên_bản;
    };

    nguồn = lấy map(phụ_thuộc, "source", "path");
    nếu (nguồn != "path" && nguồn != "git" && nguồn != "registry") {
        ném "vpp.json: source dependency không hợp lệ: " + thành chuỗi(nguồn);
    };
    vị_trí = lấy map(phụ_thuộc, "location", "");
    nếu ((nguồn == "path" || nguồn == "git") &&
        (loại của(vị_trí) != "chuỗi" || vị_trí == "")) {
        ném "vpp.json: dependency '" + tên + "' thiếu location";
    };
    trả về đúng;
};

hàm quản lý gói xác minh manifest(manifest) {
    nếu (loại của(manifest) != "từ điển") {
        ném "vpp.json: root phải là object";
    };
    schema = lấy map(manifest, "schema", 1);
    nếu (loại của(schema) != "số nguyên" || schema != 1) {
        ném "vpp.json: schema không được hỗ trợ: " + thành chuỗi(schema);
    };
    tên = lấy map(manifest, "name", "");
    nếu (!quản lý gói tên hợp lệ(tên)) {
        ném "vpp.json: name không hợp lệ: " + thành chuỗi(tên);
    };
    phiên_bản = lấy map(manifest, "version", "");
    nếu (!quản lý gói semver hợp lệ(phiên_bản)) {
        ném "vpp.json: version không hợp lệ: " + thành chuỗi(phiên_bản);
    };

    phụ_thuộc = lấy map(manifest, "dependencies", []);
    nếu (loại của(phụ_thuộc) != "danh sách") {
        ném "vpp.json: dependencies phải là array";
    };
    tên_đã_gặp = [];
    lặp(i = 0; i < độ dài(phụ_thuộc); i++) {
        quản lý gói xác minh phụ thuộc(phụ_thuộc[i], tên_đã_gặp);
    };
    trả về đúng;
};

hàm quản lý gói kiểm tra manifest(manifest) {
    thử {
        quản lý gói xác minh manifest(manifest);
        trả về {"hợp lệ": 1, "lỗi": ""};
    } bắt lỗi (e) {
        trả về {"hợp lệ": 0, "lỗi": thành chuỗi(e)};
    };
};

hàm quản lý gói đọc manifest(đường_dẫn = "vpp.json") {
    manifest = json phân tích(đọc tệp(đường_dẫn));
    quản lý gói xác minh manifest(manifest);
    trả về manifest;
};

hàm quản lý gói ghi manifest(đường_dẫn, manifest) {
    quản lý gói xác minh manifest(manifest);
    ghi tệp(đường_dẫn, json tạo(manifest) + "\n");
    trả về manifest;
};

hàm quản lý gói phụ thuộc(manifest, tên) {
    phụ_thuộc = lấy map(manifest, "dependencies", []);
    lặp(i = 0; i < độ dài(phụ_thuộc); i++) {
        nếu (lấy map(phụ_thuộc[i], "name", "") == tên) {
            trả về phụ_thuộc[i];
        };
    };
    trả về rỗng;
};

hàm quản lý gói có phụ thuộc(manifest, tên) {
    trả về quản lý gói phụ thuộc(manifest, tên) != rỗng;
};

hàm quản lý gói danh sách phụ thuộc(manifest) {
    quản lý gói xác minh manifest(manifest);
    phụ_thuộc = lấy map(manifest, "dependencies", []);
    tên = [];
    lặp(i = 0; i < độ dài(phụ_thuộc); i++) {
        thêm(tên, lấy map(phụ_thuộc[i], "name", ""));
    };
    sắp xếp(tên);
    trả về tên;
};

hàm quản lý gói phụ thuộc đứng trước(a, b) {
    tên_a = lấy map(a, "name", "");
    tên_b = lấy map(b, "name", "");
    nếu (tên_a < tên_b) { trả về đúng; };
    nếu (tên_a > tên_b) { trả về sai; };
    range_a = lấy map(a, "version", "");
    range_b = lấy map(b, "version", "");
    nếu (range_a < range_b) { trả về đúng; };
    nếu (range_a > range_b) { trả về sai; };
    trả về lấy map(a, "location", "") < lấy map(b, "location", "");
};

hàm quản lý gói sắp xếp phụ thuộc(phụ_thuộc) {
    kết_quả = [];
    lặp(i = 0; i < độ dài(phụ_thuộc); i++) { thêm(kết_quả, phụ_thuộc[i]); };
    n = độ dài(kết_quả);
    lặp(i = 0; i < n; i++) {
        lặp(j = 0; j + 1 < n - i; j++) {
            nếu (quản lý gói phụ thuộc đứng trước(kết_quả[j + 1], kết_quả[j])) {
                tạm = kết_quả[j];
                kết_quả[j] = kết_quả[j + 1];
                kết_quả[j + 1] = tạm;
            };
        };
    };
    trả về kết_quả;
};

hàm quản lý gói đường vòng lặp(ngăn_xếp, tên) {
    bắt_đầu = tìm chỉ số(ngăn_xếp, tên);
    nếu (bắt_đầu < 0) { bắt_đầu = 0; };
    kết_quả = "";
    lặp(i = bắt_đầu; i < độ dài(ngăn_xếp); i++) {
        nếu (kết_quả != "") { kết_quả = kết_quả + " -> "; };
        kết_quả = kết_quả + ngăn_xếp[i];
    };
    nếu (kết_quả != "") { kết_quả = kết_quả + " -> "; };
    trả về kết_quả + tên;
};

hàm quản lý gói thêm range yêu cầu(mục, range) {
    ds = lấy map(mục, "requestedRanges", []);
    nếu (tìm chỉ số(ds, range) < 0) {
        thêm(ds, range);
        sắp xếp(ds);
        đặt map(mục, "requestedRanges", ds);
    };
};

// Solver policy thuần V++. `bảng_gói` là snapshot metadata đã materialize:
// key = package name, value = {version, dependencies}. Filesystem/Git/registry
// vẫn cấp snapshot này ở boundary toolchain.
hàm quản lý gói giải phụ thuộc(
    phụ_thuộc,
    bảng_gói,
    đã_giải,
    đang_thăm,
    ngăn_xếp,
    kết_quả,
    người_yêu_cầu
) {
    tên = lấy map(phụ_thuộc, "name", "");
    range = lấy map(phụ_thuộc, "version", "");
    nếu (!có khóa(bảng_gói, tên)) {
        ném "package source metadata không tồn tại: " + tên;
    };
    metadata = lấy map(bảng_gói, tên, {});
    phiên_bản = lấy map(metadata, "version", "");
    nếu (!quản lý gói semver hợp lệ(phiên_bản)) {
        ném "package source version không hợp lệ: " + tên + " = " + phiên_bản;
    };
    nếu (!quản lý gói khớp range(phiên_bản, range)) {
        ném "xung đột version dependency: " + tên + " " + phiên_bản + " không khớp " + range + " từ " + người_yêu_cầu;
    };

    nếu (có khóa(đã_giải, tên)) {
        quản lý gói thêm range yêu cầu(lấy map(đã_giải, tên, {}), range);
        trả về rỗng;
    };
    nếu (tìm chỉ số(đang_thăm, tên) >= 0) {
        ném "phát hiện vòng lặp dependency: " + quản lý gói đường vòng lặp(ngăn_xếp, tên);
    };

    thêm(đang_thăm, tên);
    thêm(ngăn_xếp, tên);
    con = lấy map(metadata, "dependencies", []);
    nếu (loại của(con) != "danh sách") {
        ném "package dependencies phải là array: " + tên;
    };
    con = quản lý gói sắp xếp phụ thuộc(con);
    lặp(i = 0; i < độ dài(con); i++) {
        quản lý gói xác minh phụ thuộc(con[i], []);
        quản lý gói giải phụ thuộc(
            con[i], bảng_gói, đã_giải, đang_thăm, ngăn_xếp, kết_quả, tên
        );
    };
    xóa tại(ngăn_xếp, độ dài(ngăn_xếp) - 1);
    vị_trí_thăm = tìm chỉ số(đang_thăm, tên);
    nếu (vị_trí_thăm >= 0) { xóa tại(đang_thăm, vị_trí_thăm); };

    mục = {
        "name": tên,
        "version": phiên_bản,
        "requestedRanges": [range]
    };
    đặt map(đã_giải, tên, mục);
    thêm(kết_quả, mục);
    trả về rỗng;
};

hàm quản lý gói giải đồ thị(manifest, bảng_gói) {
    quản lý gói xác minh manifest(manifest);
    nếu (loại của(bảng_gói) != "từ điển") {
        ném "package metadata table phải là object";
    };
    gốc = quản lý gói sắp xếp phụ thuộc(lấy map(manifest, "dependencies", []));
    đã_giải = {};
    đang_thăm = [];
    ngăn_xếp = [];
    kết_quả = [];
    lặp(i = 0; i < độ dài(gốc); i++) {
        quản lý gói giải phụ thuộc(
            gốc[i], bảng_gói, đã_giải, đang_thăm, ngăn_xếp, kết_quả,
            lấy map(manifest, "name", "root")
        );
    };
    trả về kết_quả;
};

// Dạng cầu nối ổn định cho host/toolchain: mỗi dòng là
// name|version|range1|range2... theo đúng thứ tự dependency-first.
hàm quản lý gói giải đồ thị dòng(manifest, bảng_gói) {
    graph = quản lý gói giải đồ thị(manifest, bảng_gói);
    dòng = [];
    lặp(i = 0; i < độ dài(graph); i++) {
        mục = graph[i];
        văn_bản = lấy map(mục, "name", "") + "|" +
            lấy map(mục, "version", "");
        ranges = lấy map(mục, "requestedRanges", []);
        lặp(j = 0; j < độ dài(ranges); j++) {
            văn_bản = văn_bản + "|" + ranges[j];
        };
        thêm(dòng, văn_bản);
    };
    trả về dòng;
};

hàm quản lý gói thêm phụ thuộc(
    manifest,
    tên,
    phiên_bản = "*",
    nguồn = "path",
    vị_trí = "",
    ref = ""
) {
    quản lý gói xác minh manifest(manifest);
    nếu (!quản lý gói tên hợp lệ(tên)) {
        ném "vpp.json: dependency name không hợp lệ: " + thành chuỗi(tên);
    };
    nếu (quản lý gói có phụ thuộc(manifest, tên)) {
        ném "vpp.json: dependency bị khai báo trùng: " + tên;
    };
    nếu (nguồn != "path" && nguồn != "git" && nguồn != "registry") {
        ném "vpp.json: source dependency không hợp lệ: " + thành chuỗi(nguồn);
    };
    nếu ((nguồn == "path" || nguồn == "git") && vị_trí == "") {
        ném "vpp.json: dependency '" + tên + "' thiếu location";
    };

    mục = {
        "name": tên,
        "version": phiên_bản,
        "source": nguồn,
        "location": vị_trí
    };
    nếu (nguồn == "git") {
        nếu (ref == "") { ref = "HEAD"; };
        đặt map(mục, "ref", ref);
    };

    phụ_thuộc = lấy map(manifest, "dependencies", []);
    thêm(phụ_thuộc, mục);
    đặt map(manifest, "dependencies", phụ_thuộc);
    quản lý gói xác minh manifest(manifest);
    trả về mục;
};

hàm quản lý gói xóa phụ thuộc(manifest, tên) {
    quản lý gói xác minh manifest(manifest);
    phụ_thuộc = lấy map(manifest, "dependencies", []);
    lặp(i = 0; i < độ dài(phụ_thuộc); i++) {
        nếu (lấy map(phụ_thuộc[i], "name", "") == tên) {
            trả về xóa tại(phụ_thuộc, i);
        };
    };
    trả về rỗng;
};

hàm quản lý gói thêm phụ thuộc tệp(
    đường_dẫn,
    tên,
    phiên_bản = "*",
    nguồn = "path",
    vị_trí = "",
    ref = ""
) {
    manifest = quản lý gói đọc manifest(đường_dẫn);
    quản lý gói thêm phụ thuộc(manifest, tên, phiên_bản, nguồn, vị_trí, ref);
    quản lý gói ghi manifest(đường_dẫn, manifest);
    trả về manifest;
};

hàm quản lý gói xóa phụ thuộc tệp(đường_dẫn, tên) {
    manifest = quản lý gói đọc manifest(đường_dẫn);
    đã_xóa = quản lý gói xóa phụ thuộc(manifest, tên);
    nếu (đã_xóa != rỗng) {
        quản lý gói ghi manifest(đường_dẫn, manifest);
    };
    trả về đã_xóa;
};
