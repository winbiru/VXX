// vpp.packages — thao tác manifest package ở tầng V++.
//
// Module này cố ý chỉ giữ policy/dữ liệu vpp.json. Git, registry, cache và
// materialization vẫn là ranh giới toolchain/OS; parse, validation và mutation
// manifest không cần nằm trong C++.

nhập gói.dữ liệu.json.chính.*;
nhập gói.nhập xuất.tệp.đọc tệp;
nhập gói.nhập xuất.tệp.ghi tệp;
nhập gói.bộ sưu tập.danh sách.thêm;
nhập gói.bộ sưu tập.danh sách.tìm chỉ số;
nhập gói.bộ sưu tập.danh sách.sắp xếp;
nhập gói.bộ sưu tập.từ điển.lấy từ điển;
nhập gói.bộ sưu tập.từ điển.đặt từ điển;
nhập gói.bộ sưu tập.từ điển.có khóa;
nhập gói.bộ sưu tập.từ điển.khóa từ điển;
nhập gói.văn bản.chuỗi.*;

// Hàm cấp mô-đun xử lý manifest và giải dependency; Dự Án Gói giữ trạng thái chỉnh sửa.
hàm công khai quản lý gói tên hợp lệ(tên) {
    nếu (loại của(tên) != "chuỗi" || tên == "" || tên == "." || tên == "..") {
        trả về sai;
    };
    cấm = "/\\:*?\"<>|";
    lặp(i = 0; i < máy ảo lấy độ dài(tên); i++) {
        mã = chuỗi mã điểm unicode(tên[i]);
        nếu (mã < 32 || mã == 127 || chứa chính xác(cấm, tên[i])) {
            trả về sai;
        };
    };
    trả về đúng;
};

hàm riêng tư quản lý gói đoạn phiên bản ngữ nghĩa hợp lệ(đoạn) {
    nếu (đoạn == "") { trả về sai; };
    nếu (máy ảo lấy độ dài(đoạn) > 1 && đoạn[0] == "0") { trả về sai; };
    nếu (máy ảo lấy độ dài(đoạn) > 10) { trả về sai; };
    nếu (máy ảo lấy độ dài(đoạn) == 10 && đoạn > "2147483647") { trả về sai; };
    lặp(i = 0; i < máy ảo lấy độ dài(đoạn); i++) {
        nếu (đoạn[i] < "0" || đoạn[i] > "9") {
            trả về sai;
        };
    };
    trả về đúng;
};

// SemVer ở package layer phải tương thích implementation C++ hiện hành:
// core là i32 không dấu, prerelease cấm numeric identifier có số 0 đầu,
// build metadata không tham gia precedence.
hàm riêng tư quản lý gói định danh phiên bản ngữ nghĩa hợp lệ(định danh, cấm số không đầu) {
    nếu (định danh == "") { trả về sai; };
    toàn số = đúng;
    lặp(i = 0; i < máy ảo lấy độ dài(định danh); i++) {
        c = định danh[i];
        chữ = (c >= "a" && c <= "z") || (c >= "A" && c <= "Z");
        số = c >= "0" && c <= "9";
        nếu (!chữ && !số && c != "-") { trả về sai; };
        nếu (!số) { toàn số = sai; };
    };
    nếu (cấm số không đầu && toàn số && máy ảo lấy độ dài(định danh) > 1 && định danh[0] == "0") {
        trả về sai;
    };
    trả về đúng;
};

hàm riêng tư quản lý gói danh sách định danh phiên bản ngữ nghĩa(văn bản, cấm số không đầu) {
    nếu (văn bản == "") { ném "SEMVER_IDENTIFIER_INVALID"; };
    danh sách đầu vào = tách hằng văn bản(văn bản, ".");
    lặp(i = 0; i < máy ảo lấy độ dài(danh sách đầu vào); i++) {
        nếu (!quản lý gói định danh phiên bản ngữ nghĩa hợp lệ(danh sách đầu vào[i], cấm số không đầu)) {
            ném "SEMVER_IDENTIFIER_INVALID";
        };
    };
    trả về danh sách đầu vào;
};

hàm riêng tư quản lý gói phân tích phiên bản ngữ nghĩa(phiên bản) {
    nếu (loại của(phiên bản) != "chuỗi" || phiên bản == "") {
        ném "SEMVER_INVALID";
    };

    dấu cộng = tìm chuỗi chính xác(phiên bản, "+", 0);
    dấu trừ tìm = tìm chuỗi chính xác(phiên bản, "-", 0);
    dấu trừ = rỗng;
    nếu (dấu trừ tìm != rỗng) {
        nếu (dấu cộng == rỗng) {
            dấu trừ = dấu trừ tìm;
        } hoặc {
            nếu (dấu trừ tìm < dấu cộng) { dấu trừ = dấu trừ tìm; };
        };
    };

    kết lõi = máy ảo lấy độ dài(phiên bản);
    nếu (dấu trừ != rỗng) { kết lõi = dấu trừ; };
    nếu (dấu trừ == rỗng && dấu cộng != rỗng) { kết lõi = dấu cộng; };
    lõi = con chuỗi(phiên bản, 0, kết lõi);
    phần = tách hằng văn bản(lõi, ".");
    nếu (máy ảo lấy độ dài(phần) != 3) { ném "SEMVER_CORE_INVALID"; };
    lặp(i = 0; i < 3; i++) {
        nếu (!quản lý gói đoạn phiên bản ngữ nghĩa hợp lệ(phần[i])) {
            ném "SEMVER_CORE_INVALID";
        };
    };

    tiền phát hành = [];
    nếu (dấu trừ != rỗng) {
        kết tiền phát hành = máy ảo lấy độ dài(phiên bản);
        nếu (dấu cộng != rỗng) { kết tiền phát hành = dấu cộng; };
        chữ tiền phát hành = con chuỗi(phiên bản, dấu trừ + 1, kết tiền phát hành);
        tiền phát hành = quản lý gói danh sách định danh phiên bản ngữ nghĩa(chữ tiền phát hành, đúng);
    };

    bản dựng = [];
    nếu (dấu cộng != rỗng) {
        chữ bản dựng = con chuỗi(phiên bản, dấu cộng + 1, máy ảo lấy độ dài(phiên bản));
        bản dựng = quản lý gói danh sách định danh phiên bản ngữ nghĩa(chữ bản dựng, sai);
    };

    trả về {
        "major": thành số nguyên(phần[0]),
        "minor": thành số nguyên(phần[1]),
        "patch": thành số nguyên(phần[2]),
        "prerelease": tiền phát hành,
        "build": bản dựng,
        "text": phiên bản
    };
};

hàm công khai quản lý gói phiên bản ngữ nghĩa hợp lệ(phiên bản) {
    thử {
        quản lý gói phân tích phiên bản ngữ nghĩa(phiên bản);
        trả về đúng;
    } bắt lỗi (e) {
        trả về sai;
    };
};

hàm riêng tư quản lý gói định danh phiên bản ngữ nghĩa là số(định danh) {
    nếu (định danh == "") { trả về sai; };
    lặp(i = 0; i < máy ảo lấy độ dài(định danh); i++) {
        nếu (định danh[i] < "0" || định danh[i] > "9") { trả về sai; };
    };
    trả về đúng;
};

hàm riêng tư quản lý gói số sánh định danh phiên bản ngữ nghĩa(a, b) {
    số thứ nhất = quản lý gói định danh phiên bản ngữ nghĩa là số(a);
    số thứ hai = quản lý gói định danh phiên bản ngữ nghĩa là số(b);
    nếu (số thứ nhất && số thứ hai) {
        nếu (máy ảo lấy độ dài(a) < máy ảo lấy độ dài(b)) { trả về -1; };
        nếu (máy ảo lấy độ dài(a) > máy ảo lấy độ dài(b)) { trả về 1; };
        nếu (a < b) { trả về -1; };
        nếu (a > b) { trả về 1; };
        trả về 0;
    };
    nếu (số thứ nhất && !số thứ hai) { trả về -1; };
    nếu (!số thứ nhất && số thứ hai) { trả về 1; };
    nếu (a < b) { trả về -1; };
    nếu (a > b) { trả về 1; };
    trả về 0;
};

hàm công khai quản lý gói số sánh phiên bản ngữ nghĩa(a, b) {
    trái = a;
    phải = b;
    nếu (loại của(trái) == "chuỗi") { trái = quản lý gói phân tích phiên bản ngữ nghĩa(trái); };
    nếu (loại của(phải) == "chuỗi") { phải = quản lý gói phân tích phiên bản ngữ nghĩa(phải); };

    khóa = ["major", "minor", "patch"];
    lặp(i = 0; i < máy ảo lấy độ dài(khóa); i++) {
        x = lấy từ điển(trái, khóa[i], 0);
        y = lấy từ điển(phải, khóa[i], 0);
        nếu (x < y) { trả về -1; };
        nếu (x > y) { trả về 1; };
    };

    trước trái = lấy từ điển(trái, "prerelease", []);
    trước phải = lấy từ điển(phải, "prerelease", []);
    nếu (máy ảo lấy độ dài(trước trái) == 0 && máy ảo lấy độ dài(trước phải) > 0) { trả về 1; };
    nếu (máy ảo lấy độ dài(trước trái) > 0 && máy ảo lấy độ dài(trước phải) == 0) { trả về -1; };
    chung = máy ảo lấy độ dài(trước trái);
    nếu (máy ảo lấy độ dài(trước phải) < chung) { chung = máy ảo lấy độ dài(trước phải); };
    lặp(i = 0; i < chung; i++) {
        cmp = quản lý gói số sánh định danh phiên bản ngữ nghĩa(trước trái[i], trước phải[i]);
        nếu (cmp != 0) { trả về cmp; };
    };
    nếu (máy ảo lấy độ dài(trước trái) < máy ảo lấy độ dài(trước phải)) { trả về -1; };
    nếu (máy ảo lấy độ dài(trước trái) > máy ảo lấy độ dài(trước phải)) { trả về 1; };
    trả về 0;
};

hàm riêng tư quản lý gói tách khoảng trắng(văn bản) {
    từ tố = [];
    hiện tại = "";
    lặp(i = 0; i < máy ảo lấy độ dài(văn bản); i++) {
        c = văn bản[i];
        trắng = c == " " || c == "\t" || c == "\r" || c == "\n";
        nếu (trắng) {
            nếu (hiện tại != "") { máy ảo thêm cuối danh sách(từ tố, hiện tại); hiện tại = ""; };
        } hoặc {
            hiện tại = hiện tại + c;
        };
    };
    nếu (hiện tại != "") { máy ảo thêm cuối danh sách(từ tố, hiện tại); };
    trả về từ tố;
};

hàm riêng tư quản lý gói bộ so sánh(mã phép toán, phiên bản) {
    trả về {"op": mã phép toán, "version": phiên bản};
};

hàm riêng tư quản lý gói hoa dấu mũ(phiên bản) {
    chính = lấy từ điển(phiên bản, "major", 0);
    phụ = lấy từ điển(phiên bản, "minor", 0);
    vá = lấy từ điển(phiên bản, "patch", 0);
    nếu (chính > 0) { trả về {"major": chính + 1, "minor": 0, "patch": 0, "prerelease": [], "build": []}; };
    nếu (phụ > 0) { trả về {"major": 0, "minor": phụ + 1, "patch": 0, "prerelease": [], "build": []}; };
    trả về {"major": 0, "minor": 0, "patch": vá + 1, "prerelease": [], "build": []};
};

hàm riêng tư quản lý gói hoa dấu ngã(phiên bản) {
    trả về {
        "major": lấy từ điển(phiên bản, "major", 0),
        "minor": lấy từ điển(phiên bản, "minor", 0) + 1,
        "patch": 0,
        "prerelease": [],
        "build": []
    };
};

hàm riêng tư quản lý gói phân tích khoảng(khoảng) {
    nếu (loại của(khoảng) != "chuỗi") { ném "SEMVER_RANGE_INVALID"; };
    từ tố = quản lý gói tách khoảng trắng(khoảng);
    nếu (máy ảo lấy độ dài(từ tố) == 0) { trả về {"bất kỳ": 1, "comparators": []}; };
    nếu (máy ảo lấy độ dài(từ tố) == 1 && từ tố[0] == "*") {
        trả về {"bất kỳ": 1, "comparators": []};
    };

    các bộ so sánh = [];
    lặp(i = 0; i < máy ảo lấy độ dài(từ tố); i++) {
        t = từ tố[i];
        nếu (t == "*") { ném "SEMVER_WILDCARD_MUST_STAND_ALONE"; };
        nếu (tìm chuỗi chính xác(t, "||", 0) != rỗng) { ném "SEMVER_OR_UNSUPPORTED"; };
        nếu (t == "") { ném "SEMVER_RANGE_INVALID"; };

        đầu = t[0];
        nếu (đầu == "^" || đầu == "~") {
            nếu (máy ảo lấy độ dài(t) == 1) { ném "SEMVER_COMPARATOR_MISSING_VERSION"; };
            v = quản lý gói phân tích phiên bản ngữ nghĩa(con chuỗi(t, 1, máy ảo lấy độ dài(t)));
            máy ảo thêm cuối danh sách(các bộ so sánh, quản lý gói bộ so sánh(">=", v));
            nếu (đầu == "^") {
                máy ảo thêm cuối danh sách(các bộ so sánh, quản lý gói bộ so sánh("<", quản lý gói hoa dấu mũ(v)));
            } hoặc {
                máy ảo thêm cuối danh sách(các bộ so sánh, quản lý gói bộ so sánh("<", quản lý gói hoa dấu ngã(v)));
            };
        } hoặc {
            mã phép toán = "=";
            độ lệch = 0;
            nếu (máy ảo lấy độ dài(t) >= 2 && con chuỗi(t, 0, 2) == ">=") { mã phép toán = ">="; độ lệch = 2; }
            nếu (máy ảo lấy độ dài(t) >= 2 && con chuỗi(t, 0, 2) == "<=") { mã phép toán = "<="; độ lệch = 2; }
            nếu (độ lệch == 0 && đầu == ">") { mã phép toán = ">"; độ lệch = 1; };
            nếu (độ lệch == 0 && đầu == "<") { mã phép toán = "<"; độ lệch = 1; };
            nếu (độ lệch == 0 && đầu == "=") { độ lệch = 1; };
            nếu (độ lệch >= máy ảo lấy độ dài(t)) { ném "SEMVER_COMPARATOR_MISSING_VERSION"; };
            v = quản lý gói phân tích phiên bản ngữ nghĩa(con chuỗi(t, độ lệch, máy ảo lấy độ dài(t)));
            máy ảo thêm cuối danh sách(các bộ so sánh, quản lý gói bộ so sánh(mã phép toán, v));
        };
    };
    trả về {"bất kỳ": 0, "comparators": các bộ so sánh};
};

hàm công khai quản lý gói khoảng hợp lệ(khoảng) {
    thử {
        quản lý gói phân tích khoảng(khoảng);
        trả về đúng;
    } bắt lỗi (e) {
        trả về sai;
    };
};

hàm công khai quản lý gói khớp khoảng(phiên bản, khoảng) {
    v = phiên bản;
    nếu (loại của(v) == "chuỗi") { v = quản lý gói phân tích phiên bản ngữ nghĩa(v); };
    r = khoảng;
    nếu (loại của(r) == "chuỗi") { r = quản lý gói phân tích khoảng(r); };
    nếu (lấy từ điển(r, "bất kỳ", 0) == 1) { trả về đúng; };
    các bộ so sánh = lấy từ điển(r, "comparators", []);
    lặp(i = 0; i < máy ảo lấy độ dài(các bộ so sánh); i++) {
        c = các bộ so sánh[i];
        cmp = quản lý gói số sánh phiên bản ngữ nghĩa(v, lấy từ điển(c, "version", {}));
        mã phép toán = lấy từ điển(c, "op", "=");
        hợp = sai;
        nếu (mã phép toán == "=" && cmp == 0) { hợp = đúng; };
        nếu (mã phép toán == ">" && cmp > 0) { hợp = đúng; };
        nếu (mã phép toán == ">=" && cmp >= 0) { hợp = đúng; };
        nếu (mã phép toán == "<" && cmp < 0) { hợp = đúng; };
        nếu (mã phép toán == "<=" && cmp <= 0) { hợp = đúng; };
        nếu (!hợp) { trả về sai; };
    };
    trả về đúng;
};

hàm riêng tư quản lý gói xác mình phụ thuộc(phụ thuộc, tên đã gặp) {
    nếu (loại của(phụ thuộc) != "từ điển") {
        ném "vpp.json: mỗi dependency phải là object";
    };
    tên = lấy từ điển(phụ thuộc, "name", "");
    nếu (!quản lý gói tên hợp lệ(tên)) {
        ném "vpp.json: dependency name không hợp lệ";
    };
    nếu (tìm chỉ số(tên đã gặp, tên) >= 0) {
        ném "vpp.json: dependency bị khai báo trùng: " + tên;
    };
    máy ảo thêm cuối danh sách(tên đã gặp, tên);

    phiên bản = lấy từ điển(phụ thuộc, "version", "");
    nếu (loại của(phiên bản) != "chuỗi" || phiên bản == "") {
        ném "vpp.json: version range của dependency không hợp lệ: " + tên;
    };
    nếu (!quản lý gói khoảng hợp lệ(phiên bản)) {
        ném "vpp.json: version range của dependency không hợp lệ: " + tên + " = " + phiên bản;
    };

    nguồn = lấy từ điển(phụ thuộc, "source", "path");
    nếu (nguồn != "path" && nguồn != "git" && nguồn != "registry") {
        ném "vpp.json: source dependency không hợp lệ: " + thành chuỗi(nguồn);
    };
    vị trí = lấy từ điển(phụ thuộc, "location", "");
    nếu ((nguồn == "path" || nguồn == "git") &&
        (loại của(vị trí) != "chuỗi" || vị trí == "")) {
        ném "vpp.json: dependency '" + tên + "' thiếu location";
    };
    trả về đúng;
};

hàm riêng tư quản lý gói xác mình bản kê(bản kê) {
    nếu (loại của(bản kê) != "từ điển") {
        ném "vpp.json: root phải là object";
    };
    lược đồ dữ liệu = lấy từ điển(bản kê, "schema", 1);
    nếu (loại của(lược đồ dữ liệu) != "số nguyên" || lược đồ dữ liệu != 1) {
        ném "vpp.json: schema không được hỗ trợ: " + thành chuỗi(lược đồ dữ liệu);
    };
    tên = lấy từ điển(bản kê, "name", "");
    nếu (!quản lý gói tên hợp lệ(tên)) {
        ném "vpp.json: name không hợp lệ: " + thành chuỗi(tên);
    };
    phiên bản = lấy từ điển(bản kê, "version", "");
    nếu (!quản lý gói phiên bản ngữ nghĩa hợp lệ(phiên bản)) {
        ném "vpp.json: version không hợp lệ: " + thành chuỗi(phiên bản);
    };

    phụ thuộc = lấy từ điển(bản kê, "dependencies", []);
    nếu (loại của(phụ thuộc) != "danh sách") {
        ném "vpp.json: dependencies phải là array";
    };
    tên đã gặp = [];
    lặp(i = 0; i < máy ảo lấy độ dài(phụ thuộc); i++) {
        quản lý gói xác mình phụ thuộc(phụ thuộc[i], tên đã gặp);
    };
    trả về đúng;
};

hàm công khai quản lý gói kiểm tra bản kê(bản kê) {
    thử {
        quản lý gói xác mình bản kê(bản kê);
        trả về {"hợp lệ": 1, "lỗi": ""};
    } bắt lỗi (e) {
        trả về {"hợp lệ": 0, "lỗi": thành chuỗi(e)};
    };
};

hàm công khai quản lý gói đọc bản kê(đường dẫn = "vpp.json") {
    bản kê = json phân tích(đọc tệp(đường dẫn));
    quản lý gói xác mình bản kê(bản kê);
    trả về bản kê;
};

hàm công khai quản lý gói ghi bản kê(đường dẫn, bản kê) {
    quản lý gói xác mình bản kê(bản kê);
    ghi tệp(đường dẫn, json tạo(bản kê) + "\n");
    trả về bản kê;
};

hàm công khai quản lý gói phụ thuộc(bản kê, tên) {
    phụ thuộc = lấy từ điển(bản kê, "dependencies", []);
    lặp(i = 0; i < máy ảo lấy độ dài(phụ thuộc); i++) {
        nếu (lấy từ điển(phụ thuộc[i], "name", "") == tên) {
            trả về phụ thuộc[i];
        };
    };
    trả về rỗng;
};

hàm công khai quản lý gói có phụ thuộc(bản kê, tên) {
    trả về quản lý gói phụ thuộc(bản kê, tên) != rỗng;
};

hàm công khai quản lý gói danh sách phụ thuộc(bản kê) {
    quản lý gói xác mình bản kê(bản kê);
    phụ thuộc = lấy từ điển(bản kê, "dependencies", []);
    tên = [];
    lặp(i = 0; i < máy ảo lấy độ dài(phụ thuộc); i++) {
        máy ảo thêm cuối danh sách(tên, lấy từ điển(phụ thuộc[i], "name", ""));
    };
    sắp xếp(tên);
    trả về tên;
};

hàm riêng tư quản lý gói phụ thuộc đứng trước(a, b) {
    tên a = lấy từ điển(a, "name", "");
    tên b = lấy từ điển(b, "name", "");
    nếu (tên a < tên b) { trả về đúng; };
    nếu (tên a > tên b) { trả về sai; };
    khoảng a = lấy từ điển(a, "version", "");
    khoảng b = lấy từ điển(b, "version", "");
    nếu (khoảng a < khoảng b) { trả về đúng; };
    nếu (khoảng a > khoảng b) { trả về sai; };
    trả về lấy từ điển(a, "location", "") < lấy từ điển(b, "location", "");
};

hàm riêng tư quản lý gói sắp xếp phụ thuộc(phụ thuộc) {
    kết quả = [];
    lặp(i = 0; i < máy ảo lấy độ dài(phụ thuộc); i++) { máy ảo thêm cuối danh sách(kết quả, phụ thuộc[i]); };
    n = máy ảo lấy độ dài(kết quả);
    lặp(i = 0; i < n; i++) {
        lặp(j = 0; j + 1 < n - i; j++) {
            nếu (quản lý gói phụ thuộc đứng trước(kết quả[j + 1], kết quả[j])) {
                tạm = kết quả[j];
                kết quả[j] = kết quả[j + 1];
                kết quả[j + 1] = tạm;
            };
        };
    };
    trả về kết quả;
};

hàm riêng tư quản lý gói đường vòng lặp(ngăn xếp, tên) {
    bắt đầu = tìm chỉ số(ngăn xếp, tên);
    nếu (bắt đầu < 0) { bắt đầu = 0; };
    kết quả = "";
    lặp(i = bắt đầu; i < máy ảo lấy độ dài(ngăn xếp); i++) {
        nếu (kết quả != "") { kết quả = kết quả + " -> "; };
        kết quả = kết quả + ngăn xếp[i];
    };
    nếu (kết quả != "") { kết quả = kết quả + " -> "; };
    trả về kết quả + tên;
};

hàm riêng tư quản lý gói thêm khoảng yêu cầu(mục, khoảng) {
    danh sách đầu vào = lấy từ điển(mục, "requestedRanges", []);
    nếu (tìm chỉ số(danh sách đầu vào, khoảng) < 0) {
        máy ảo thêm cuối danh sách(danh sách đầu vào, khoảng);
        sắp xếp(danh sách đầu vào);
        đặt từ điển(mục, "requestedRanges", danh sách đầu vào);
    };
};

// Solver policy thuần V++. `bảng_gói` là snapshot metadata đã materialize:
// key = package name, value = {version, dependencies}. Filesystem/Git/registry
// vẫn cấp snapshot này ở boundary toolchain.
hàm riêng tư quản lý gói giải phụ thuộc(
    phụ thuộc,
    bảng gói,
    đã giải,
    đang thăm,
    ngăn xếp,
    kết quả,
    người yêu cầu
) {
    tên = lấy từ điển(phụ thuộc, "name", "");
    khoảng = lấy từ điển(phụ thuộc, "version", "");
    nếu (!máy ảo có khóa từ điển(bảng gói, tên)) {
        ném "package source metadata không tồn tại: " + tên;
    };
    siêu dữ liệu = lấy từ điển(bảng gói, tên, {});
    phiên bản = lấy từ điển(siêu dữ liệu, "version", "");
    nếu (!quản lý gói phiên bản ngữ nghĩa hợp lệ(phiên bản)) {
        ném "package source version không hợp lệ: " + tên + " = " + phiên bản;
    };
    nếu (!quản lý gói khớp khoảng(phiên bản, khoảng)) {
        ném "xung đột version dependency: " + tên + " " + phiên bản + " không khớp " + khoảng + " từ " + người yêu cầu;
    };

    nếu (máy ảo có khóa từ điển(đã giải, tên)) {
        quản lý gói thêm khoảng yêu cầu(lấy từ điển(đã giải, tên, {}), khoảng);
        trả về rỗng;
    };
    nếu (tìm chỉ số(đang thăm, tên) >= 0) {
        ném "phát hiện vòng lặp dependency: " + quản lý gói đường vòng lặp(ngăn xếp, tên);
    };

    máy ảo thêm cuối danh sách(đang thăm, tên);
    máy ảo thêm cuối danh sách(ngăn xếp, tên);
    con = lấy từ điển(siêu dữ liệu, "dependencies", []);
    nếu (loại của(con) != "danh sách") {
        ném "package dependencies phải là array: " + tên;
    };
    con = quản lý gói sắp xếp phụ thuộc(con);
    lặp(i = 0; i < máy ảo lấy độ dài(con); i++) {
        quản lý gói xác mình phụ thuộc(con[i], []);
        quản lý gói giải phụ thuộc(
            con[i], bảng gói, đã giải, đang thăm, ngăn xếp, kết quả, tên
        );
    };
    máy ảo xóa vị trí danh sách(ngăn xếp, máy ảo lấy độ dài(ngăn xếp) - 1);
    vị trí thăm = tìm chỉ số(đang thăm, tên);
    nếu (vị trí thăm >= 0) { máy ảo xóa vị trí danh sách(đang thăm, vị trí thăm); };

    mục = {
        "name": tên,
        "version": phiên bản,
        "requestedRanges": [khoảng]
    };
    đặt từ điển(đã giải, tên, mục);
    máy ảo thêm cuối danh sách(kết quả, mục);
    trả về rỗng;
};

hàm công khai quản lý gói giải đồ thị(bản kê, bảng gói) {
    quản lý gói xác mình bản kê(bản kê);
    nếu (loại của(bảng gói) != "từ điển") {
        ném "package metadata table phải là object";
    };
    gốc dữ liệu = quản lý gói sắp xếp phụ thuộc(lấy từ điển(bản kê, "dependencies", []));
    đã giải = {};
    đang thăm = [];
    ngăn xếp = [];
    kết quả = [];
    lặp(i = 0; i < máy ảo lấy độ dài(gốc dữ liệu); i++) {
        quản lý gói giải phụ thuộc(
            gốc dữ liệu[i], bảng gói, đã giải, đang thăm, ngăn xếp, kết quả,
            lấy từ điển(bản kê, "name", "root")
        );
    };
    trả về kết quả;
};

// Dạng cầu nối ổn định cho host/toolchain: mỗi dòng là
// name|version|range1|range2... theo đúng thứ tự dependency-first.
hàm công khai quản lý gói giải đồ thị dòng(bản kê, bảng gói) {
    graph = quản lý gói giải đồ thị(bản kê, bảng gói);
    dòng = [];
    lặp(i = 0; i < máy ảo lấy độ dài(graph); i++) {
        mục = graph[i];
        văn bản = lấy từ điển(mục, "name", "") + "|" +
            lấy từ điển(mục, "version", "");
        các khoảng = lấy từ điển(mục, "requestedRanges", []);
        lặp(j = 0; j < máy ảo lấy độ dài(các khoảng); j++) {
            văn bản = văn bản + "|" + các khoảng[j];
        };
        máy ảo thêm cuối danh sách(dòng, văn bản);
    };
    trả về dòng;
};

hàm công khai quản lý gói thêm phụ thuộc(
    bản kê,
    tên,
    phiên bản = "*",
    nguồn = "path",
    vị trí = "",
    tham chiếu = ""
) {
    quản lý gói xác mình bản kê(bản kê);
    nếu (!quản lý gói tên hợp lệ(tên)) {
        ném "vpp.json: dependency name không hợp lệ: " + thành chuỗi(tên);
    };
    nếu (quản lý gói có phụ thuộc(bản kê, tên)) {
        ném "vpp.json: dependency bị khai báo trùng: " + tên;
    };
    nếu (nguồn != "path" && nguồn != "git" && nguồn != "registry") {
        ném "vpp.json: source dependency không hợp lệ: " + thành chuỗi(nguồn);
    };
    nếu ((nguồn == "path" || nguồn == "git") && vị trí == "") {
        ném "vpp.json: dependency '" + tên + "' thiếu location";
    };

    mục = {
        "name": tên,
        "version": phiên bản,
        "source": nguồn,
        "location": vị trí
    };
    nếu (nguồn == "git") {
        nếu (tham chiếu == "") { tham chiếu = "HEAD"; };
        đặt từ điển(mục, "ref", tham chiếu);
    };

    phụ thuộc = lấy từ điển(bản kê, "dependencies", []);
    máy ảo thêm cuối danh sách(phụ thuộc, mục);
    đặt từ điển(bản kê, "dependencies", phụ thuộc);
    quản lý gói xác mình bản kê(bản kê);
    trả về mục;
};

hàm công khai quản lý gói xóa phụ thuộc(bản kê, tên) {
    quản lý gói xác mình bản kê(bản kê);
    phụ thuộc = lấy từ điển(bản kê, "dependencies", []);
    lặp(i = 0; i < máy ảo lấy độ dài(phụ thuộc); i++) {
        nếu (lấy từ điển(phụ thuộc[i], "name", "") == tên) {
            trả về máy ảo xóa vị trí danh sách(phụ thuộc, i);
        };
    };
    trả về rỗng;
};

hàm công khai quản lý gói thêm phụ thuộc tệp(
    đường dẫn,
    tên,
    phiên bản = "*",
    nguồn = "path",
    vị trí = "",
    tham chiếu = ""
) {
    bản kê = quản lý gói đọc bản kê(đường dẫn);
    quản lý gói thêm phụ thuộc(bản kê, tên, phiên bản, nguồn, vị trí, tham chiếu);
    quản lý gói ghi bản kê(đường dẫn, bản kê);
    trả về bản kê;
};

hàm công khai quản lý gói xóa phụ thuộc tệp(đường dẫn, tên) {
    bản kê = quản lý gói đọc bản kê(đường dẫn);
    đã xóa = quản lý gói xóa phụ thuộc(bản kê, tên);
    nếu (đã xóa != rỗng) {
        quản lý gói ghi bản kê(đường dẫn, bản kê);
    };
    trả về đã xóa;
};

// Phiên chỉnh manifest: mọi cập nhật được xác thực trên bản sao trước khi ghi nhận.
lớp công khai Dự Án Gói {
    hàm công khai khởi tạo(bản kê) {
        quản lý gói xác mình bản kê(bản kê);
        mình.cấu hình = json phân tích(json tạo(bản kê));
    };
    hàm công khai bản kê() { trả về json phân tích(json tạo(mình.cấu hình)); };
    hàm công khai thêm(tên, phiên bản = "*", nguồn = "path", vị trí = "", tham chiếu = "") {
        mới = mình.bản kê();
        mục = quản lý gói thêm phụ thuộc(mới, tên, phiên bản, nguồn, vị trí, tham chiếu);
        mình.cấu hình = mới;
        trả về json phân tích(json tạo(mục));
    };
    hàm công khai xóa(tên) {
        mới = mình.bản kê();
        mục = quản lý gói xóa phụ thuộc(mới, tên);
        mình.cấu hình = mới;
        trả về mục;
    };
    hàm công khai phụ thuộc(tên) { trả về quản lý gói phụ thuộc(mình.bản kê(), tên); };
    hàm công khai giải đồ thị(bảng gói) { trả về quản lý gói giải đồ thị(mình.cấu hình, bảng gói); };
    hàm công khai lưu(đường dẫn = "vpp.json") {
        quản lý gói ghi bản kê(đường dẫn, mình.cấu hình);
        trả về mình.bản kê();
    };
    hàm công khai tải lại(đường dẫn = "vpp.json") {
        mới = quản lý gói đọc bản kê(đường dẫn);
        mình.cấu hình = mới;
        trả về mình;
    };
};
