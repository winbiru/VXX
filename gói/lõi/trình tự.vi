// Thuật toán chung cho các giá trị có thứ tự như chuỗi và danh sách.
// Chỉ dùng primitive runtime tối thiểu: loại, độ dài và truy cập chỉ số.

// Chuỗi: trả về chuỗi mới theo thứ tự ngược.
// Danh sách: đảo tại chỗ và trả về rỗng để giữ API hiện có.
hàm công khai đảo ngược(giá trị) {
    nếu (loại của(giá trị) == "chuỗi") {
        kết quả = "";
        lặp(i = máy ảo lấy độ dài(giá trị) - 1; i >= 0; i--) {
            kết quả = kết quả + giá trị[i];
        };
        trả về kết quả;
    };

    n = máy ảo lấy độ dài(giá trị);
    lặp(i = 0; i < n - 1 - i; i++) {
        j = n - 1 - i;
        tạm = giá trị[i];
        giá trị[i] = giá trị[j];
        giá trị[j] = tạm;
    };
    trả về rỗng;
};
