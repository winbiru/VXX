// Module: lõi.ngẫu nhiên
// Sinh số nguyên trong đoạn đóng [tối thiểu, tối đa]. VM chỉ cung cấp
// entropy bảo mật dạng byte; việc ánh xạ vào khoảng số nguyên nằm hoàn toàn ở V++.
nhập gói/lõi/chuyển kiểu;
nhập gói/lõi/toán học;
nhập gói/bộ sưu tập/từ điển;
nhập gói/lõi/nguồn ngẫu nhiên;
nhập gói/lõi/giao diện tài nguyên;


// Các thuật toán và trợ giúp nằm trong lớp nội bộ, không được xuất qua import.
lớp riêng tư Máy Ngẫu Nhiên Nội Bộ {
    hàm công khai khởi tạo() {};

    hàm riêng tư ngẫu nhiên nguyên yêu cầu giới hạn(giá trị) {
        kiểu = loại của(giá trị);
        nếu (kiểu == "số nguyên") {
            trả về giá trị;
        };

        nếu (kiểu == "số thực") {
            thử {
                n = thành số nguyên(giá trị);
                nếu (thành số thực(n) == giá trị) {
                    trả về n;
                };
            } bắt lỗi (e) {
            };
        };

        nếu (kiểu == "chuỗi") {
            thử {
                trả về thành số nguyên(giá trị);
            } bắt lỗi (e) {
            };
        };

        ném "ngẫu nhiên nguyên: giới hạn phải là số nguyên";
    };

    hàm riêng tư ngẫu nhiên nguồn ngẫu nhiên sáu byte() {
        các byte = nguồn ngẫu nhiên bảo mật các byte(6);
        nếu (máy ảo lấy độ dài(các byte) != 6) {
            ném "ngẫu nhiên nguyên: entropy không hợp lệ";
        };

        giá trị = 0.0;
        lặp(i = 0; i < 6; i++) {
            byte = các byte[i];
            nếu (loại của(byte) != "số nguyên" || byte < 0 || byte > 255) {
                ném "ngẫu nhiên nguyên: entropy không hợp lệ";
            };
            giá trị = giá trị * 256.0 + thành số thực(byte);
        };
        trả về giá trị;
    };

    // Dùng không gian 2^48. Double biểu diễn chính xác mọi số nguyên trong miền này.
    // Rejection sampling loại phần dư trước khi modulo logic để không tạo modulo bias.
    hàm công khai ngẫu nhiên nguyên(tối thiểu, tối đa) {
        nhỏ = mình.ngẫu nhiên nguyên yêu cầu giới hạn(tối thiểu);
        lớn = mình.ngẫu nhiên nguyên yêu cầu giới hạn(tối đa);
        nếu (nhỏ > lớn) {
            ném "ngẫu nhiên nguyên: giới hạn dưới lớn hơn giới hạn trên";
        };
        nếu (nhỏ == lớn) {
            trả về nhỏ;
        };

        độ rộng = thành số thực(lớn) - thành số thực(nhỏ) + 1.0;
        không gian = 281474976710656.0;
        số khối = làm tròn xuống(không gian / độ rộng);
        mức trần = số khối * độ rộng;

        mẫu = không gian;
        lặp(vòng = 0; mẫu >= mức trần; vòng++) {
            mẫu = mình.ngẫu nhiên nguồn ngẫu nhiên sáu byte();
        };

        thương = làm tròn xuống(mẫu / độ rộng);
        phần dư = mẫu - thương * độ rộng;
        trả về thành số nguyên(thành số thực(nhỏ) + phần dư);
    };

    // vi.random — bộ sinh giả ngẫu nhiên có hạt giống, tách khỏi nguồn mật mã.
    //
    // PRNG là logic thư viện thuần V++. State được giữ ngay trong handle map thay vì
    // registry C++ toàn cục. Thuật toán Park-Miller dùng biến thể Schrage để mọi
    // phép nhân trung gian vẫn nằm trong miền số nguyên 32-bit của VM.
    hàm riêng tư ngẫu nhiên yêu cầu số nguyên(giá trị, nhãn) {
        kiểu = loại của(giá trị);
        nếu (kiểu == "số nguyên") {
            trả về giá trị;
        };

        nếu (kiểu == "số thực") {
            thử {
                n = thành số nguyên(giá trị);
                nếu (thành số thực(n) == giá trị) {
                    trả về n;
                };
            } bắt lỗi (e) {
            };
        };

        nếu (kiểu == "chuỗi") {
            thử {
                trả về thành số nguyên(giá trị);
            } bắt lỗi (e) {
            };
        };

        ném "ngẫu nhiên: " + nhãn + " phải là số nguyên";
    };

    hàm riêng tư ngẫu nhiên yêu cầu bộ sinh(bộ sinh) {
        nếu (loại của(bộ sinh) != "từ điển") {
            ném "ngẫu nhiên: không tìm thấy bộ sinh";
        };
        nếu (lấy từ điển(bộ sinh, "__vpp_random", 0) != 1) {
            ném "ngẫu nhiên: không tìm thấy bộ sinh";
        };
        nếu (lấy từ điển(bộ sinh, "mở", 0) != 1) {
            ném "ngẫu nhiên: không tìm thấy bộ sinh";
        };
        nếu (lấy từ điển(bộ sinh, "thuật toán", "") != "park-miller-48271-v1") {
            ném "RANDOM_STATE";
        };
        trả về bộ sinh;
    };

    hàm riêng tư ngẫu nhiên bước(bộ sinh) {
        mình.ngẫu nhiên yêu cầu bộ sinh(bộ sinh);
        trạng thái = lấy từ điển(bộ sinh, "trạng thái", 1);

        // m = 2147483647, a = 48271, q = m / a = 44488, r = m % a = 3399.
        hi = thành số nguyên(trạng thái / 44488);
        lo = trạng thái % 44488;
        tiếp = 48271 * lo - 3399 * hi;
        nếu (tiếp <= 0) {
            tiếp = tiếp + 2147483647;
        };

        đặt từ điển(bộ sinh, "trạng thái", tiếp);
        trả về tiếp;
    };

    hàm công khai tạo bộ sinh ngẫu nhiên(hạt giống) {
        hạt giống = mình.ngẫu nhiên yêu cầu số nguyên(hạt giống, "hạt giống");
        trạng thái = hạt giống % 2147483647;
        nếu (trạng thái <= 0) {
            trạng thái = trạng thái + 2147483646;
        };
        trả về {
            "__vpp_random": 1,
            "mở": 1,
            "thuật toán": "park-miller-48271-v1",
            "trạng thái": trạng thái
        };
    };

    hàm công khai ngẫu nhiên nguyên từ bộ(bộ sinh, tối thiểu, tối đa) {
        mình.ngẫu nhiên yêu cầu bộ sinh(bộ sinh);
        nhỏ = mình.ngẫu nhiên yêu cầu số nguyên(tối thiểu, "tối thiểu");
        lớn = mình.ngẫu nhiên yêu cầu số nguyên(tối đa, "tối đa");
        nếu (nhỏ > lớn) {
            ném "RANDOM_RANGE";
        };
        nếu (nhỏ == lớn) {
            trả về nhỏ;
        };

        // Park-Miller sinh đều 1..2147483646. Dịch xuống 0..2147483645 rồi
        // rejection sampling để loại phần dư, tránh modulo/scale bias.
        không gian = 2147483646.0;
        độ rộng = thành số thực(lớn) - thành số thực(nhỏ) + 1.0;
        nếu (độ rộng <= 0.0 || độ rộng > không gian) {
            ném "RANDOM_RANGE";
        };
        số khối = làm tròn xuống(không gian / độ rộng);
        mức trần = số khối * độ rộng;

        mẫu = không gian;
        lặp(vòng = 0; mẫu >= mức trần; vòng++) {
            mẫu = thành số thực(mình.ngẫu nhiên bước(bộ sinh) - 1);
        };
        thương = làm tròn xuống(mẫu / độ rộng);
        phần dư = mẫu - thương * độ rộng;
        trả về thành số nguyên(thành số thực(nhỏ) + phần dư);
    };

    hàm công khai ngẫu nhiên thực từ bộ(bộ sinh) {
        trạng thái = mình.ngẫu nhiên bước(bộ sinh);
        trả về trạng thái / 2147483647.0;
    };

    hàm công khai ngẫu nhiên luận lý từ bộ(bộ sinh) {
        trạng thái = mình.ngẫu nhiên bước(bộ sinh);
        trả về trạng thái % 2 == 0;
    };

    hàm công khai ngẫu nhiên các byte từ bộ(bộ sinh, số lượng) {
        mình.ngẫu nhiên yêu cầu bộ sinh(bộ sinh);
        n = mình.ngẫu nhiên yêu cầu số nguyên(số lượng, "số lượng byte");
        nếu (n < 0 || n > 1048576) {
            ném "RANDOM_RANGE";
        };
        kết quả = [];
        lặp(i = 0; i < n; i++) {
            máy ảo thêm cuối danh sách(kết quả, mình.ngẫu nhiên nguyên từ bộ(bộ sinh, 0, 255));
        };
        trả về kết quả;
    };

    hàm công khai trạng thái bộ sinh ngẫu nhiên(bộ sinh) {
        mình.ngẫu nhiên yêu cầu bộ sinh(bộ sinh);
        trả về {
            "thuật toán": lấy từ điển(bộ sinh, "thuật toán", ""),
            "trạng thái": lấy từ điển(bộ sinh, "trạng thái", 0)
        };
    };

    hàm công khai khôi phục bộ sinh ngẫu nhiên(snapshot) {
        nếu (loại của(snapshot) != "từ điển") {
            ném "RANDOM_STATE";
        };
        thuật toán = lấy từ điển(snapshot, "thuật toán", "");
        nếu (thuật toán != "park-miller-48271-v1") {
            ném "RANDOM_STATE";
        };
        trạng thái = lấy từ điển(snapshot, "trạng thái", 0);
        nếu (loại của(trạng thái) != "số nguyên") {
            ném "RANDOM_STATE";
        };
        nếu (trạng thái <= 0 || trạng thái >= 2147483647) {
            ném "RANDOM_STATE";
        };
        trả về {
            "__vpp_random": 1,
            "mở": 1,
            "thuật toán": thuật toán,
            "trạng thái": trạng thái
        };
    };

    // Tên contract ngắn theo spec.
    hàm công khai bộ sinh giả ngẫu nhiên(hạt giống) {
        trả về mình.tạo bộ sinh ngẫu nhiên(hạt giống);
    };

    hàm công khai ngẫu nhiên i64(bộ sinh, tối thiểu, tối đa) {
        trả về mình.ngẫu nhiên nguyên từ bộ(bộ sinh, tối thiểu, tối đa);
    };

    hàm công khai ngẫu nhiên f64(bộ sinh) {
        trả về mình.ngẫu nhiên thực từ bộ(bộ sinh);
    };

    hàm công khai ngẫu nhiên luận lý(bộ sinh) {
        trả về mình.ngẫu nhiên luận lý từ bộ(bộ sinh);
    };

    hàm công khai xóa bộ sinh ngẫu nhiên(bộ sinh) {
        mình.ngẫu nhiên yêu cầu bộ sinh(bộ sinh);
        đặt từ điển(bộ sinh, "mở", 0);
        đặt từ điển(bộ sinh, "trạng thái", 0);
        trả về 1;
    };
};


hàm công khai ngẫu nhiên nguyên(tối thiểu, tối đa) {
    bộ nội bộ = Máy Ngẫu Nhiên Nội Bộ();
    trả về bộ nội bộ.ngẫu nhiên nguyên(tối thiểu, tối đa);
};


hàm công khai tạo bộ sinh ngẫu nhiên(hạt giống) {
    bộ nội bộ = Máy Ngẫu Nhiên Nội Bộ();
    trả về bộ nội bộ.tạo bộ sinh ngẫu nhiên(hạt giống);
};


hàm công khai ngẫu nhiên nguyên từ bộ(bộ sinh, tối thiểu, tối đa) {
    bộ nội bộ = Máy Ngẫu Nhiên Nội Bộ();
    trả về bộ nội bộ.ngẫu nhiên nguyên từ bộ(bộ sinh, tối thiểu, tối đa);
};


hàm công khai ngẫu nhiên thực từ bộ(bộ sinh) {
    bộ nội bộ = Máy Ngẫu Nhiên Nội Bộ();
    trả về bộ nội bộ.ngẫu nhiên thực từ bộ(bộ sinh);
};


hàm công khai ngẫu nhiên luận lý từ bộ(bộ sinh) {
    bộ nội bộ = Máy Ngẫu Nhiên Nội Bộ();
    trả về bộ nội bộ.ngẫu nhiên luận lý từ bộ(bộ sinh);
};


hàm công khai ngẫu nhiên các byte từ bộ(bộ sinh, số lượng) {
    bộ nội bộ = Máy Ngẫu Nhiên Nội Bộ();
    trả về bộ nội bộ.ngẫu nhiên các byte từ bộ(bộ sinh, số lượng);
};


hàm công khai trạng thái bộ sinh ngẫu nhiên(bộ sinh) {
    bộ nội bộ = Máy Ngẫu Nhiên Nội Bộ();
    trả về bộ nội bộ.trạng thái bộ sinh ngẫu nhiên(bộ sinh);
};


hàm công khai khôi phục bộ sinh ngẫu nhiên(snapshot) {
    bộ nội bộ = Máy Ngẫu Nhiên Nội Bộ();
    trả về bộ nội bộ.khôi phục bộ sinh ngẫu nhiên(snapshot);
};


hàm công khai bộ sinh giả ngẫu nhiên(hạt giống) {
    bộ nội bộ = Máy Ngẫu Nhiên Nội Bộ();
    trả về bộ nội bộ.bộ sinh giả ngẫu nhiên(hạt giống);
};


hàm công khai ngẫu nhiên i64(bộ sinh, tối thiểu, tối đa) {
    bộ nội bộ = Máy Ngẫu Nhiên Nội Bộ();
    trả về bộ nội bộ.ngẫu nhiên i64(bộ sinh, tối thiểu, tối đa);
};


hàm công khai ngẫu nhiên f64(bộ sinh) {
    bộ nội bộ = Máy Ngẫu Nhiên Nội Bộ();
    trả về bộ nội bộ.ngẫu nhiên f64(bộ sinh);
};


hàm công khai ngẫu nhiên luận lý(bộ sinh) {
    bộ nội bộ = Máy Ngẫu Nhiên Nội Bộ();
    trả về bộ nội bộ.ngẫu nhiên luận lý(bộ sinh);
};


hàm công khai xóa bộ sinh ngẫu nhiên(bộ sinh) {
    bộ nội bộ = Máy Ngẫu Nhiên Nội Bộ();
    trả về bộ nội bộ.xóa bộ sinh ngẫu nhiên(bộ sinh);
};

// Mỗi đối tượng sở hữu một chuỗi PRNG; snapshot không chia sẻ handle đang chạy.
lớp công khai Bộ Sinh Ngẫu Nhiên triển khai Đóng Được {
    hàm công khai khởi tạo(hạt giống) {
        mình.bộ = tạo bộ sinh ngẫu nhiên(hạt giống);
    };
    hàm công khai nguyên(nhỏ, lớn) { trả về ngẫu nhiên nguyên từ bộ(mình.bộ, nhỏ, lớn); };
    hàm công khai thực() { trả về ngẫu nhiên thực từ bộ(mình.bộ); };
    hàm công khai luận lý() { trả về ngẫu nhiên luận lý từ bộ(mình.bộ); };
    hàm công khai các byte(số lượng) { trả về ngẫu nhiên các byte từ bộ(mình.bộ, số lượng); };
    hàm công khai trạng thái() { trả về trạng thái bộ sinh ngẫu nhiên(mình.bộ); };
    hàm công khai khôi phục(snapshot) {
        mình.trạng thái();
        mới = khôi phục bộ sinh ngẫu nhiên(snapshot);
        mình.bộ = mới;
        trả về mình;
    };
    hàm công khai đóng() {
        nếu (lấy từ điển(mình.bộ, "mở", 0) == 0) { trả về sai; };
        xóa bộ sinh ngẫu nhiên(mình.bộ);
        trả về đúng;
    };
};
