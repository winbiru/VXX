// Module: lõi.ngẫu nhiên
// Sinh số nguyên trong đoạn đóng [tối thiểu, tối đa]. VM chỉ cung cấp
// entropy bảo mật dạng byte; việc ánh xạ vào khoảng số nguyên nằm hoàn toàn ở V++.
nhập gói/lõi/chuyển kiểu;
nhập gói/lõi/toán học;
nhập gói/bộ sưu tập/từ điển;
nhập gói/lõi/entropy;
nhập gói/lõi/giao diện tài nguyên;


// Các thuật toán và trợ giúp nằm trong lớp nội bộ, không được xuất qua import.
lớp riêng tư Máy Ngẫu Nhiên Nội Bộ {
    hàm công khai khởi tạo() {};

    hàm riêng tư ngẫu nhiên nguyên yêu cầu giới hạn(giá_trị) {
        kiểu = loai_cua(giá_trị);
        nếu (kiểu == "số nguyên") {
            trả về giá_trị;
        };

        nếu (kiểu == "số thực") {
            thử {
                n = thành số nguyên(giá_trị);
                nếu (thành số thực(n) == giá_trị) {
                    trả về n;
                };
            } bắt lỗi (e) {
            };
        };

        nếu (kiểu == "chuỗi") {
            thử {
                trả về thành số nguyên(giá_trị);
            } bắt lỗi (e) {
            };
        };

        ném "ngẫu nhiên nguyên: giới hạn phải là số nguyên";
    };

    hàm riêng tư ngẫu nhiên entropy sáu byte() {
        bytes = entropy bảo mật bytes(6);
        nếu (do_dai(bytes) != 6) {
            ném "ngẫu nhiên nguyên: entropy không hợp lệ";
        };

        giá_trị = 0.0;
        lặp(i = 0; i < 6; i++) {
            byte = bytes[i];
            nếu (loai_cua(byte) != "số nguyên" || byte < 0 || byte > 255) {
                ném "ngẫu nhiên nguyên: entropy không hợp lệ";
            };
            giá_trị = giá_trị * 256.0 + thành số thực(byte);
        };
        trả về giá_trị;
    };

    // Dùng không gian 2^48. Double biểu diễn chính xác mọi số nguyên trong miền này.
    // Rejection sampling loại phần dư trước khi modulo logic để không tạo modulo bias.
    hàm công khai ngẫu nhiên nguyên(tối thiểu, tối đa) {
        nhỏ = mình.ngẫu nhiên nguyên yêu cầu giới hạn(tối thiểu);
        lớn = mình.ngẫu nhiên nguyên yêu cầu giới hạn(tối đa);
        nếu (nhỏ > lớn) {
            ném "ngẫu nhiên nguyên: giới hạn dưới lớn hơn giới hạn trên";
        };
        nếu (nhỏ == lớn) {
            trả về nhỏ;
        };

        độ_rộng = thành số thực(lớn) - thành số thực(nhỏ) + 1.0;
        không_gian = 281474976710656.0;
        số_khối = lam_tron_xuong(không_gian / độ_rộng);
        giới_hạn = số_khối * độ_rộng;

        mẫu = không_gian;
        lặp(vòng = 0; mẫu >= giới_hạn; vòng++) {
            mẫu = mình.ngẫu nhiên entropy sáu byte();
        };

        thương = lam_tron_xuong(mẫu / độ_rộng);
        phần_dư = mẫu - thương * độ_rộng;
        trả về thành số nguyên(thành số thực(nhỏ) + phần_dư);
    };

    // vi.random — bộ sinh giả ngẫu nhiên có hạt giống, tách khỏi nguồn mật mã.
    //
    // PRNG là logic thư viện thuần V++. State được giữ ngay trong handle map thay vì
    // registry C++ toàn cục. Thuật toán Park-Miller dùng biến thể Schrage để mọi
    // phép nhân trung gian vẫn nằm trong miền số nguyên 32-bit của VM.
    hàm riêng tư ngẫu nhiên yêu cầu số nguyên(giá trị, nhãn) {
        kiểu = loai_cua(giá trị);
        nếu (kiểu == "số nguyên") {
            trả về giá trị;
        };

        nếu (kiểu == "số thực") {
            thử {
                n = thành số nguyên(giá trị);
                nếu (thành số thực(n) == giá trị) {
                    trả về n;
                };
            } bắt lỗi (e) {
            };
        };

        nếu (kiểu == "chuỗi") {
            thử {
                trả về thành số nguyên(giá trị);
            } bắt lỗi (e) {
            };
        };

        ném "ngẫu nhiên: " + nhãn + " phải là số nguyên";
    };

    hàm riêng tư ngẫu nhiên yêu cầu bộ sinh(bộ sinh) {
        nếu (loai_cua(bộ sinh) != "từ điển") {
            ném "ngẫu nhiên: không tìm thấy bộ sinh";
        };
        nếu (lấy map(bộ sinh, "__vpp_random", 0) != 1) {
            ném "ngẫu nhiên: không tìm thấy bộ sinh";
        };
        nếu (lấy map(bộ sinh, "mở", 0) != 1) {
            ném "ngẫu nhiên: không tìm thấy bộ sinh";
        };
        nếu (lấy map(bộ sinh, "thuật toán", "") != "park-miller-48271-v1") {
            ném "RANDOM_STATE";
        };
        trả về bộ sinh;
    };

    hàm riêng tư ngẫu nhiên bước(bộ sinh) {
        mình.ngẫu nhiên yêu cầu bộ sinh(bộ sinh);
        trạng_thái = lấy map(bộ sinh, "trạng thái", 1);

        // m = 2147483647, a = 48271, q = m / a = 44488, r = m % a = 3399.
        hi = thành số nguyên(trạng_thái / 44488);
        lo = trạng_thái % 44488;
        tiếp = 48271 * lo - 3399 * hi;
        nếu (tiếp <= 0) {
            tiếp = tiếp + 2147483647;
        };

        đặt map(bộ sinh, "trạng thái", tiếp);
        trả về tiếp;
    };

    hàm công khai tạo bộ sinh ngẫu nhiên(hạt giống) {
        seed = mình.ngẫu nhiên yêu cầu số nguyên(hạt giống, "hạt giống");
        trạng_thái = seed % 2147483647;
        nếu (trạng_thái <= 0) {
            trạng_thái = trạng_thái + 2147483646;
        };
        trả về {
            "__vpp_random": 1,
            "mở": 1,
            "thuật toán": "park-miller-48271-v1",
            "trạng thái": trạng_thái
        };
    };

    hàm công khai ngẫu nhiên nguyên từ bộ(bộ sinh, tối thiểu, tối đa) {
        mình.ngẫu nhiên yêu cầu bộ sinh(bộ sinh);
        nhỏ = mình.ngẫu nhiên yêu cầu số nguyên(tối thiểu, "tối thiểu");
        lớn = mình.ngẫu nhiên yêu cầu số nguyên(tối đa, "tối đa");
        nếu (nhỏ > lớn) {
            ném "RANDOM_RANGE";
        };
        nếu (nhỏ == lớn) {
            trả về nhỏ;
        };

        // Park-Miller sinh đều 1..2147483646. Dịch xuống 0..2147483645 rồi
        // rejection sampling để loại phần dư, tránh modulo/scale bias.
        không_gian = 2147483646.0;
        độ_rộng = thành số thực(lớn) - thành số thực(nhỏ) + 1.0;
        nếu (độ_rộng <= 0.0 || độ_rộng > không_gian) {
            ném "RANDOM_RANGE";
        };
        số_khối = lam_tron_xuong(không_gian / độ_rộng);
        giới_hạn = số_khối * độ_rộng;

        mẫu = không_gian;
        lặp(vòng = 0; mẫu >= giới_hạn; vòng++) {
            mẫu = thành số thực(mình.ngẫu nhiên bước(bộ sinh) - 1);
        };
        thương = lam_tron_xuong(mẫu / độ_rộng);
        phần_dư = mẫu - thương * độ_rộng;
        trả về thành số nguyên(thành số thực(nhỏ) + phần_dư);
    };

    hàm công khai ngẫu nhiên thực từ bộ(bộ sinh) {
        trạng_thái = mình.ngẫu nhiên bước(bộ sinh);
        trả về trạng_thái / 2147483647.0;
    };

    hàm công khai ngẫu nhiên luận lý từ bộ(bộ sinh) {
        trạng_thái = mình.ngẫu nhiên bước(bộ sinh);
        trả về trạng_thái % 2 == 0;
    };

    hàm công khai ngẫu nhiên bytes từ bộ(bộ sinh, số_lượng) {
        mình.ngẫu nhiên yêu cầu bộ sinh(bộ sinh);
        n = mình.ngẫu nhiên yêu cầu số nguyên(số_lượng, "số lượng byte");
        nếu (n < 0 || n > 1048576) {
            ném "RANDOM_RANGE";
        };
        kết_quả = [];
        lặp(i = 0; i < n; i++) {
            them(kết_quả, mình.ngẫu nhiên nguyên từ bộ(bộ sinh, 0, 255));
        };
        trả về kết_quả;
    };

    hàm công khai trạng thái bộ sinh ngẫu nhiên(bộ sinh) {
        mình.ngẫu nhiên yêu cầu bộ sinh(bộ sinh);
        trả về {
            "thuật toán": lấy map(bộ sinh, "thuật toán", ""),
            "trạng thái": lấy map(bộ sinh, "trạng thái", 0)
        };
    };

    hàm công khai khôi phục bộ sinh ngẫu nhiên(snapshot) {
        nếu (loai_cua(snapshot) != "từ điển") {
            ném "RANDOM_STATE";
        };
        thuật_toán = lấy map(snapshot, "thuật toán", "");
        nếu (thuật_toán != "park-miller-48271-v1") {
            ném "RANDOM_STATE";
        };
        trạng_thái = lấy map(snapshot, "trạng thái", 0);
        nếu (loai_cua(trạng_thái) != "số nguyên") {
            ném "RANDOM_STATE";
        };
        nếu (trạng_thái <= 0 || trạng_thái >= 2147483647) {
            ném "RANDOM_STATE";
        };
        trả về {
            "__vpp_random": 1,
            "mở": 1,
            "thuật toán": thuật_toán,
            "trạng thái": trạng_thái
        };
    };

    // Tên contract ngắn theo spec.
    hàm công khai prng(hạt_giống) {
        trả về mình.tạo bộ sinh ngẫu nhiên(hạt_giống);
    };

    hàm công khai random i64(bộ_sinh, tối_thiểu, tối_đa) {
        trả về mình.ngẫu nhiên nguyên từ bộ(bộ_sinh, tối_thiểu, tối_đa);
    };

    hàm công khai random f64(bộ_sinh) {
        trả về mình.ngẫu nhiên thực từ bộ(bộ_sinh);
    };

    hàm công khai random bool(bộ_sinh) {
        trả về mình.ngẫu nhiên luận lý từ bộ(bộ_sinh);
    };

    hàm công khai xóa bộ sinh ngẫu nhiên(bộ sinh) {
        mình.ngẫu nhiên yêu cầu bộ sinh(bộ sinh);
        đặt map(bộ sinh, "mở", 0);
        đặt map(bộ sinh, "trạng thái", 0);
        trả về 1;
    };
};


hàm công khai ngẫu nhiên nguyên(tối thiểu, tối đa) {
    bộ_nội_bộ = Máy Ngẫu Nhiên Nội Bộ();
    trả về bộ_nội_bộ.ngẫu nhiên nguyên(tối thiểu, tối đa);
};


hàm công khai tạo bộ sinh ngẫu nhiên(hạt giống) {
    bộ_nội_bộ = Máy Ngẫu Nhiên Nội Bộ();
    trả về bộ_nội_bộ.tạo bộ sinh ngẫu nhiên(hạt giống);
};


hàm công khai ngẫu nhiên nguyên từ bộ(bộ sinh, tối thiểu, tối đa) {
    bộ_nội_bộ = Máy Ngẫu Nhiên Nội Bộ();
    trả về bộ_nội_bộ.ngẫu nhiên nguyên từ bộ(bộ sinh, tối thiểu, tối đa);
};


hàm công khai ngẫu nhiên thực từ bộ(bộ sinh) {
    bộ_nội_bộ = Máy Ngẫu Nhiên Nội Bộ();
    trả về bộ_nội_bộ.ngẫu nhiên thực từ bộ(bộ sinh);
};


hàm công khai ngẫu nhiên luận lý từ bộ(bộ sinh) {
    bộ_nội_bộ = Máy Ngẫu Nhiên Nội Bộ();
    trả về bộ_nội_bộ.ngẫu nhiên luận lý từ bộ(bộ sinh);
};


hàm công khai ngẫu nhiên bytes từ bộ(bộ sinh, số_lượng) {
    bộ_nội_bộ = Máy Ngẫu Nhiên Nội Bộ();
    trả về bộ_nội_bộ.ngẫu nhiên bytes từ bộ(bộ sinh, số_lượng);
};


hàm công khai trạng thái bộ sinh ngẫu nhiên(bộ sinh) {
    bộ_nội_bộ = Máy Ngẫu Nhiên Nội Bộ();
    trả về bộ_nội_bộ.trạng thái bộ sinh ngẫu nhiên(bộ sinh);
};


hàm công khai khôi phục bộ sinh ngẫu nhiên(snapshot) {
    bộ_nội_bộ = Máy Ngẫu Nhiên Nội Bộ();
    trả về bộ_nội_bộ.khôi phục bộ sinh ngẫu nhiên(snapshot);
};


hàm công khai prng(hạt_giống) {
    bộ_nội_bộ = Máy Ngẫu Nhiên Nội Bộ();
    trả về bộ_nội_bộ.prng(hạt_giống);
};


hàm công khai random i64(bộ_sinh, tối_thiểu, tối_đa) {
    bộ_nội_bộ = Máy Ngẫu Nhiên Nội Bộ();
    trả về bộ_nội_bộ.random i64(bộ_sinh, tối_thiểu, tối_đa);
};


hàm công khai random f64(bộ_sinh) {
    bộ_nội_bộ = Máy Ngẫu Nhiên Nội Bộ();
    trả về bộ_nội_bộ.random f64(bộ_sinh);
};


hàm công khai random bool(bộ_sinh) {
    bộ_nội_bộ = Máy Ngẫu Nhiên Nội Bộ();
    trả về bộ_nội_bộ.random bool(bộ_sinh);
};


hàm công khai xóa bộ sinh ngẫu nhiên(bộ sinh) {
    bộ_nội_bộ = Máy Ngẫu Nhiên Nội Bộ();
    trả về bộ_nội_bộ.xóa bộ sinh ngẫu nhiên(bộ sinh);
};

// Mỗi đối tượng sở hữu một chuỗi PRNG; snapshot không chia sẻ handle đang chạy.
lớp công khai Bộ Sinh Ngẫu Nhiên triển khai Đóng Được {
    hàm công khai khởi tạo(hạt_giống) {
        mình.bộ = tạo bộ sinh ngẫu nhiên(hạt_giống);
    };
    hàm công khai nguyên(nhỏ, lớn) { trả về ngẫu nhiên nguyên từ bộ(mình.bộ, nhỏ, lớn); };
    hàm công khai thực() { trả về ngẫu nhiên thực từ bộ(mình.bộ); };
    hàm công khai luận lý() { trả về ngẫu nhiên luận lý từ bộ(mình.bộ); };
    hàm công khai bytes(số_lượng) { trả về ngẫu nhiên bytes từ bộ(mình.bộ, số_lượng); };
    hàm công khai trạng thái() { trả về trạng thái bộ sinh ngẫu nhiên(mình.bộ); };
    hàm công khai khôi phục(snapshot) {
        mình.trạng thái();
        mới = khôi phục bộ sinh ngẫu nhiên(snapshot);
        mình.bộ = mới;
        trả về mình;
    };
    hàm công khai đóng() {
        nếu (lấy map(mình.bộ, "mở", 0) == 0) { trả về sai; };
        xóa bộ sinh ngẫu nhiên(mình.bộ);
        trả về đúng;
    };
};
