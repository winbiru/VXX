// Kernel cung cấp entropy qua machine ABI; V++ kiểm tra giới hạn, chia khối
// và ghép bytes. Chỉ machine primitive có quyền system.entropy.read.

// Hàm thuần theo lời gọi: dữ liệu entropy không lưu trên một đối tượng.
hàm công khai entropy bảo mật bytes(số_byte) {
    nếu (loai_cua(số_byte) != "số nguyên" || số_byte < 1 || số_byte > 4096) {
        ném "entropy bảo mật: số byte phải là số nguyên từ 1 đến 4096";
    };
    kết_quả = [];
    còn_lại = số_byte;
    lặp(vòng = 0; còn_lại > 0; vòng++) {
        số_đọc = còn_lại;
        nếu (số_đọc > 256) { số_đọc = 256; };
        đệm = máy_entropy_bytes(số_đọc);
        lặp(i = 0; i < số_đọc; i++) { them(kết_quả, đệm[i]); };
        còn_lại = còn_lại - số_đọc;
    };
    trả về kết_quả;
};
