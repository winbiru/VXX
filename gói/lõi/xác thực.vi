// Module: lõi.xác thực
// Guard clause không cần lưu trạng thái đối tượng.

hàm công khai yêu cầu đúng(điều kiện, thông điệp) {
    nếu (!điều kiện) {
        ném thông điệp;
    };
    trả về đúng;
};

hàm công khai yêu cầu không rỗng(giá trị, thông điệp) {
    nếu (giá trị == "") {
        ném thông điệp;
    };
    trả về đúng;
};
