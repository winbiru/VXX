// Giữ ảnh chụp config trong từng instance; tải lại khi cần.
nhập gói.lõi.cấu hình.đọc cấu hình;
nhập gói.bộ sưu tập.từ điển.lấy từ điển;
nhập gói.bộ sưu tập.từ điển.có khóa;
nhập gói.bộ sưu tập.từ điển.khóa từ điển;

lớp công khai Cấu Hình Tệp {
    hàm công khai khởi tạo(đường dẫn) {
        nếu (loại của(đường dẫn) != "chuỗi") { ném "CONFIG_ARGUMENT"; };
        mình.đường = đường dẫn;
        mình.nội dung = {};
        mình.tải lại();
    };

    hàm công khai tải lại() {
        mới = đọc cấu hình(mình.đường);
        mình.nội dung = mới;
        trả về mình;
    };

    hàm công khai lấy(khóa, mặc định = rỗng) {
        trả về lấy từ điển(mình.nội dung, khóa, mặc định);
    };

    hàm công khai có(khóa) {
        trả về máy ảo có khóa từ điển(mình.nội dung, khóa);
    };

    hàm công khai đường dẫn() { trả về mình.đường; };
};
