// Logger cấp instance: đích và ngưỡng mức được lưu trong mỗi đối tượng.
nhập gói.lõi.nhật ký.ghi theo cấu hình;
nhập gói.lõi.chuyển kiểu.thành chuỗi;
nhập gói.lõi.tài nguyên có trạng thái.*;

hàm công khai nhật ký thứ tự mức(mức) {
    nếu (mức == "thông tin") { trả về 0; };
    nếu (mức == "cảnh báo") { trả về 1; };
    nếu (mức == "lỗi") { trả về 2; };
    ném "nhật ký: mức không hợp lệ";
};

lớp công khai Bộ Ghi Nhật Ký kế thừa Tài Nguyên Có Trạng Thái {
    hàm công khai khởi tạo(đích, đường, mức tối thiểu) {
        nếu (đích != "tệp" && đích != "bảng điều khiển") {
            ném "nhật ký: đích ghi không hợp lệ";
        };
        nếu (đích == "tệp" && đường == "") {
            ném "nhật ký: đường dẫn tệp rỗng";
        };
        nhật ký thứ tự mức(mức tối thiểu);
        gốc.khởi tạo();
        mình.đích = đích;
        mình.đường = đường;
        mình.mức tối thiểu = mức tối thiểu;
    };

    hàm công khai đổi mức(mức) {
        mình.yêu cầu mở("nhật ký");
        nhật ký thứ tự mức(mức);
        mình.mức tối thiểu = mức;
    };

    hàm công khai ghi(mức, nội dung) {
        mình.yêu cầu mở("nhật ký");
        thứ tự = nhật ký thứ tự mức(mức);
        nếu (thứ tự < nhật ký thứ tự mức(mình.mức tối thiểu)) {
            trả về 0;
        };
        trả về ghi theo cấu hình(mình.đích, mình.đường, mức, thành chuỗi(nội dung));
    };

    hàm công khai thông tin(nội dung) { trả về mình.ghi("thông tin", nội dung); };
    hàm công khai cảnh báo(nội dung) { trả về mình.ghi("cảnh báo", nội dung); };
    hàm công khai lỗi(nội dung) { trả về mình.ghi("lỗi", nội dung); };
};
