// Module: lõi.tùy chọn
// V++ dùng rỗng làm nullable/optional representation ở runtime hiện tại.
// Các helper giữ supplier/function lazy theo contract Optional.

hàm công khai có giá trị(giá trị) {
    trả về giá trị != rỗng;
};

hàm công khai hoặc giá trị(giá trị, mặc định) {
    nếu (giá trị == rỗng) {
        trả về mặc định;
    };
    trả về giá trị;
};

hàm công khai hoặc tạo(giá trị, bộ cung cấp) {
    nếu (giá trị == rỗng) {
        trả về bộ cung cấp();
    };
    trả về giá trị;
};

hàm công khai ánh xạ tùy chọn(giá trị, chương trình con hiện tại) {
    nếu (giá trị == rỗng) {
        trả về rỗng;
    };
    trả về chương trình con hiện tại(giá trị);
};

hàm công khai lọc tùy chọn(giá trị, biểu thức lọc) {
    nếu (giá trị == rỗng) {
        trả về rỗng;
    };
    nếu (biểu thức lọc(giá trị)) {
        trả về giá trị;
    };
    trả về rỗng;
};
