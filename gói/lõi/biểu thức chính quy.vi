// vi.regex — engine regex và API biểu thức chính quy viết bằng V++.
// Runtime chỉ cung cấp primitive chuỗi/list/map; parser, backtracking, capture,
// search, replace và split đều nằm ở tầng ngôn ngữ.

nhập gói.bộ sưu tập.danh sách.thêm;

// Mẫu được phân tích một lần, còn trạng thái backtracking luôn riêng mỗi lần gọi.
lớp công khai Biểu Thức Chính Quy {
    hàm công khai khởi tạo(mẫu) { mình.phân tích = mình.biểu thức chính quy phân tích(mẫu); };
    hàm công khai khớp(văn bản) { trả về mình.biểu thức chính quy khớp đã phân tích(văn bản, mình.phân tích); };
    hàm công khai quét(văn bản) { trả về mình.biểu thức chính quy quét đã phân tích(văn bản, mình.phân tích); };
    hàm công khai tìm(văn bản) {
        kết quả quét = mình.quét(văn bản);
        các khớp = kết quả quét[0];
        nếu (máy ảo lấy độ dài(các khớp) == 0) { trả về ""; };
        trả về các khớp[0][1][0];
    };
    hàm công khai thay(văn bản, thay thế) {
        nếu (loại của(thay thế) != "chuỗi") { ném "regex thay: giá trị thay thế phải là chuỗi"; };
        trả về mình.biểu thức chính quy thay kết quả(mình.quét(văn bản), thay thế);
    };
    hàm công khai tách(văn bản) { trả về mình.biểu thức chính quy tách kết quả(mình.quét(văn bản)); };

    hàm riêng tư biểu thức chính quy lỗi mẫu() {
        ném "regex: mẫu không hợp lệ";
    };

    hàm riêng tư biểu thức chính quy sao chép danh sách(danh sách đầu vào) {
        kết quả = [];
        lặp(i = 0; i < máy ảo lấy độ dài(danh sách đầu vào); i++) {
            máy ảo thêm cuối danh sách(kết quả, danh sách đầu vào[i]);
        };
        trả về kết quả;
    };

    hàm riêng tư biểu thức chính quy đoạn(văn bản, bắt đầu, kết thúc) {
        kết quả = "";
        lặp(i = bắt đầu; i < kết thúc; i++) {
            kết quả = kết quả + văn bản[i];
        };
        trả về kết quả;
    };

    hàm riêng tư biểu thức chính quy phân tích cú pháp tạo(mẫu) {
        trả về {"mẫu": mẫu, "vị trí": 0, "nhóm": 0};
    };

    hàm riêng tư biểu thức chính quy phân tích cú pháp biểu thức(p) {
        nhánh = [];
        máy ảo thêm cuối danh sách(nhánh, mình.biểu thức chính quy phân tích cú pháp chuỗi(p));
        mẫu = p["mẫu"];
        tiếp = đúng;
        khi (tiếp) {
            i = p["vị trí"];
            nếu (i >= máy ảo lấy độ dài(mẫu)) {
                tiếp = sai;
            } hoặc {
                nếu (mẫu[i] == "|") {
                    p["vị trí"] = i + 1;
                    máy ảo thêm cuối danh sách(nhánh, mình.biểu thức chính quy phân tích cú pháp chuỗi(p));
                } hoặc {
                    tiếp = sai;
                };
            };
        };
        nếu (máy ảo lấy độ dài(nhánh) == 1) {
            trả về nhánh[0];
        };
        trả về {"loại": "hoặc", "con": nhánh};
    };

    hàm riêng tư biểu thức chính quy phân tích cú pháp chuỗi(p) {
        con = [];
        mẫu = p["mẫu"];
        tiếp = đúng;
        khi (tiếp) {
            i = p["vị trí"];
            nếu (i >= máy ảo lấy độ dài(mẫu)) {
                tiếp = sai;
            } hoặc {
                c = mẫu[i];
                nếu (c == ")" || c == "|") {
                    tiếp = sai;
                } hoặc {
                    máy ảo thêm cuối danh sách(con, mình.biểu thức chính quy phân tích cú pháp phần tử(p));
                };
            };
        };
        trả về {"loại": "chuỗi", "con": con};
    };

    hàm riêng tư biểu thức chính quy phân tích cú pháp lớp(p) {
        mẫu = p["mẫu"];
        i = p["vị trí"] + 1;
        phủ định = sai;
        nếu (i < máy ảo lấy độ dài(mẫu)) {
            nếu (mẫu[i] == "^") {
                phủ định = đúng;
                i++;
            };
        };
        nội dung = "";
        đóng = sai;
        khi (i < máy ảo lấy độ dài(mẫu) && !đóng) {
            c = mẫu[i];
            nếu (c == "]") {
                đóng = đúng;
                i++;
            } hoặc {
                nếu (c == "\\") {
                    nội dung = nội dung + c;
                    i++;
                    nếu (i >= máy ảo lấy độ dài(mẫu)) { mình.biểu thức chính quy lỗi mẫu(); };
                    nội dung = nội dung + mẫu[i];
                    i++;
                } hoặc {
                    nội dung = nội dung + c;
                    i++;
                };
            };
        };
        nếu (!đóng) { mình.biểu thức chính quy lỗi mẫu(); };
        p["vị trí"] = i;
        trả về {"loại": "lớp", "mẫu": nội dung, "phủ định": phủ định};
    };

    hàm riêng tư biểu thức chính quy phân tích cú pháp đơn vị khớp(p) {
        mẫu = p["mẫu"];
        i = p["vị trí"];
        nếu (i >= máy ảo lấy độ dài(mẫu)) { mình.biểu thức chính quy lỗi mẫu(); };
        c = mẫu[i];

        nếu (c == "(" ) {
            p["vị trí"] = i + 1;
            kiểu = "nhóm";
            số nhóm = 0;
            j = p["vị trí"];
            nếu (j < máy ảo lấy độ dài(mẫu)) {
                nếu (mẫu[j] == "?") {
                    j++;
                    nếu (j >= máy ảo lấy độ dài(mẫu)) { mình.biểu thức chính quy lỗi mẫu(); };
                    dấu = mẫu[j];
                    nếu (dấu == ":") {
                        kiểu = "không bắt";
                    } hoặc {
                        nếu (dấu == "=") {
                            kiểu = "nhìn trước";
                        } hoặc {
                            nếu (dấu == "!") {
                                kiểu = "không nhìn trước";
                            } hoặc {
                                mình.biểu thức chính quy lỗi mẫu();
                            };
                        };
                    };
                    p["vị trí"] = j + 1;
                };
            };
            nếu (kiểu == "nhóm") {
                p["nhóm"] = p["nhóm"] + 1;
                số nhóm = p["nhóm"];
            };
            thân = mình.biểu thức chính quy phân tích cú pháp biểu thức(p);
            i = p["vị trí"];
            nếu (i >= máy ảo lấy độ dài(mẫu)) { mình.biểu thức chính quy lỗi mẫu(); };
            nếu (mẫu[i] != ")") { mình.biểu thức chính quy lỗi mẫu(); };
            p["vị trí"] = i + 1;
            nếu (kiểu == "không bắt") { trả về thân; };
            nếu (kiểu == "nhìn trước") {
                trả về {"loại": "nhìn trước", "con": thân};
            };
            nếu (kiểu == "không nhìn trước") {
                trả về {"loại": "không nhìn trước", "con": thân};
            };
            trả về {"loại": "nhóm", "con": thân, "số": số nhóm};
        };

        nếu (c == "[") {
            trả về mình.biểu thức chính quy phân tích cú pháp lớp(p);
        };

        nếu (c == "\\") {
            i++;
            nếu (i >= máy ảo lấy độ dài(mẫu)) { mình.biểu thức chính quy lỗi mẫu(); };
            p["vị trí"] = i + 1;
            e = mẫu[i];
            nếu (e == "s" || e == "d" || e == "w") {
                trả về {"loại": "lớp tắt", "mẫu": e};
            };
            nếu (e == "n") { trả về {"loại": "chữ", "giá trị": "\n"}; };
            nếu (e == "r") { trả về {"loại": "chữ", "giá trị": "\r"}; };
            nếu (e == "t") { trả về {"loại": "chữ", "giá trị": "\t"}; };
            trả về {"loại": "chữ", "giá trị": e};
        };

        nếu (c == "*" || c == "+" || c == "?") { mình.biểu thức chính quy lỗi mẫu(); };
        p["vị trí"] = i + 1;
        nếu (c == ".") { trả về {"loại": "bất kỳ"}; };
        nếu (c == "^") { trả về {"loại": "đầu"}; };
        nếu (c == "$") { trả về {"loại": "cuối"}; };
        trả về {"loại": "chữ", "giá trị": c};
    };

    hàm riêng tư biểu thức chính quy phân tích cú pháp phần tử(p) {
        đơn vị khớp = mình.biểu thức chính quy phân tích cú pháp đơn vị khớp(p);
        mẫu = p["mẫu"];
        i = p["vị trí"];
        nếu (i >= máy ảo lấy độ dài(mẫu)) { trả về đơn vị khớp; };
        q = mẫu[i];
        nếu (q != "*" && q != "+" && q != "?") { trả về đơn vị khớp; };
        tối thiểu = 0;
        tối đa = -1;
        nếu (q == "+") { tối thiểu = 1; };
        nếu (q == "?") { tối đa = 1; };
        i++;
        tham = đúng;
        nếu (i < máy ảo lấy độ dài(mẫu)) {
            nếu (mẫu[i] == "?") {
                tham = sai;
                i++;
            };
        };
        p["vị trí"] = i;
        trả về {
            "loại": "lặp",
            "con": đơn vị khớp,
            "tối thiểu": tối thiểu,
            "tối đa": tối đa,
            "tham": tham
        };
    };

    hàm riêng tư biểu thức chính quy phân tích(mẫu) {
        nếu (loại của(mẫu) != "chuỗi") {
            ném "regex: mẫu phải là chuỗi";
        };
        p = mình.biểu thức chính quy phân tích cú pháp tạo(mẫu);
        cây = mình.biểu thức chính quy phân tích cú pháp biểu thức(p);
        nếu (p["vị trí"] != máy ảo lấy độ dài(mẫu)) { mình.biểu thức chính quy lỗi mẫu(); };
        trả về {"cây": cây, "nhóm": p["nhóm"]};
    };

    hàm riêng tư biểu thức chính quy là chữ số(c) {
        trả về c >= "0" && c <= "9";
    };

    hàm riêng tư biểu thức chính quy là chữ(c) {
        trả về (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") ||
            mình.biểu thức chính quy là chữ số(c) || c == "_";
    };

    hàm riêng tư biểu thức chính quy là trắng(c) {
        trả về c == " " || c == "\t" || c == "\n" || c == "\r";
    };

    hàm riêng tư biểu thức chính quy lớp tắt khớp(mẫu, c) {
        nếu (mẫu == "s") { trả về mình.biểu thức chính quy là trắng(c); };
        nếu (mẫu == "d") { trả về mình.biểu thức chính quy là chữ số(c); };
        nếu (mẫu == "w") { trả về mình.biểu thức chính quy là chữ(c); };
        trả về sai;
    };

    hàm riêng tư biểu thức chính quy lớp khớp(nút, c) {
        mẫu = nút["mẫu"];
        mục khớp = sai;
        i = 0;
        khi (i < máy ảo lấy độ dài(mẫu)) {
            đầu = mẫu[i];
            nếu (đầu == "\\") {
                i++;
                nếu (i >= máy ảo lấy độ dài(mẫu)) { mình.biểu thức chính quy lỗi mẫu(); };
                e = mẫu[i];
                nếu (e == "s" || e == "d" || e == "w") {
                    nếu (mình.biểu thức chính quy lớp tắt khớp(e, c)) { mục khớp = đúng; };
                } hoặc {
                    nếu (e == c) { mục khớp = đúng; };
                };
                i++;
            } hoặc {
                có khoảng = sai;
                nếu (i + 2 < máy ảo lấy độ dài(mẫu)) {
                    nếu (mẫu[i + 1] == "-") { có khoảng = đúng; };
                };
                nếu (có khoảng) {
                    cuối = mẫu[i + 2];
                    nếu (c >= đầu && c <= cuối) { mục khớp = đúng; };
                    i = i + 3;
                } hoặc {
                    nếu (c == đầu) { mục khớp = đúng; };
                    i++;
                };
            };
        };
        nếu (nút["phủ định"]) { trả về !mục khớp; };
        trả về mục khớp;
    };

    hàm riêng tư biểu thức chính quy trạng thái(vị trí, nhóm) {
        trả về {"vị trí": vị trí, "nhóm": nhóm};
    };

    hàm riêng tư biểu thức chính quy ghép trạng thái(đích, nguồn) {
        lặp(i = 0; i < máy ảo lấy độ dài(nguồn); i++) { máy ảo thêm cuối danh sách(đích, nguồn[i]); };
        trả về đích;
    };

    hàm riêng tư biểu thức chính quy khớp lặp(nút, văn bản, trạng thái, số lần, kết quả) {
        tối thiểu = nút["tối thiểu"];
        tối đa = nút["tối đa"];
        tham = nút["tham"];
        nếu (!tham && số lần >= tối thiểu) {
            máy ảo thêm cuối danh sách(kết quả, trạng thái);
        };

        được lặp = tối đa < 0 || số lần < tối đa;
        nếu (được lặp) {
            tiếp = mình.biểu thức chính quy khớp nút(nút["con"], văn bản, trạng thái);
            lặp(i = 0; i < máy ảo lấy độ dài(tiếp); i++) {
                nếu (tiếp[i]["vị trí"] > trạng thái["vị trí"]) {
                    mình.biểu thức chính quy khớp lặp(nút, văn bản, tiếp[i], số lần + 1, kết quả);
                };
            };
        };

        nếu (tham && số lần >= tối thiểu) {
            máy ảo thêm cuối danh sách(kết quả, trạng thái);
        };
        trả về kết quả;
    };

    hàm riêng tư biểu thức chính quy khớp nút(nút, văn bản, trạng thái) {
        loại = nút["loại"];
        vị trí = trạng thái["vị trí"];
        n = máy ảo lấy độ dài(văn bản);

        nếu (loại == "chữ") {
            nếu (vị trí < n) {
                nếu (văn bản[vị trí] == nút["giá trị"]) {
                    trả về [mình.biểu thức chính quy trạng thái(vị trí + 1, trạng thái["nhóm"])];
                };
            };
            trả về [];
        };
        nếu (loại == "bất kỳ") {
            nếu (vị trí < n) {
                c = văn bản[vị trí];
                nếu (c != "\n" && c != "\r") {
                    trả về [mình.biểu thức chính quy trạng thái(vị trí + 1, trạng thái["nhóm"])];
                };
            };
            trả về [];
        };
        nếu (loại == "lớp") {
            nếu (vị trí < n) {
                nếu (mình.biểu thức chính quy lớp khớp(nút, văn bản[vị trí])) {
                    trả về [mình.biểu thức chính quy trạng thái(vị trí + 1, trạng thái["nhóm"])];
                };
            };
            trả về [];
        };
        nếu (loại == "lớp tắt") {
            nếu (vị trí < n) {
                nếu (mình.biểu thức chính quy lớp tắt khớp(nút["mẫu"], văn bản[vị trí])) {
                    trả về [mình.biểu thức chính quy trạng thái(vị trí + 1, trạng thái["nhóm"])];
                };
            };
            trả về [];
        };
        nếu (loại == "đầu") {
            nếu (vị trí == 0) { trả về [trạng thái]; };
            trả về [];
        };
        nếu (loại == "cuối") {
            nếu (vị trí == n) { trả về [trạng thái]; };
            trả về [];
        };
        nếu (loại == "chuỗi") {
            hiện = [trạng thái];
            con = nút["con"];
            lặp(i = 0; i < máy ảo lấy độ dài(con); i++) {
                kế = [];
                lặp(j = 0; j < máy ảo lấy độ dài(hiện); j++) {
                    mình.biểu thức chính quy ghép trạng thái(kế, mình.biểu thức chính quy khớp nút(con[i], văn bản, hiện[j]));
                };
                hiện = kế;
                nếu (máy ảo lấy độ dài(hiện) == 0) { trả về []; };
            };
            trả về hiện;
        };
        nếu (loại == "hoặc") {
            kết quả = [];
            con = nút["con"];
            lặp(i = 0; i < máy ảo lấy độ dài(con); i++) {
                mình.biểu thức chính quy ghép trạng thái(kết quả, mình.biểu thức chính quy khớp nút(con[i], văn bản, trạng thái));
            };
            trả về kết quả;
        };
        nếu (loại == "nhóm") {
            bắt đầu = vị trí;
            kết quả con = mình.biểu thức chính quy khớp nút(nút["con"], văn bản, trạng thái);
            kết quả = [];
            lặp(i = 0; i < máy ảo lấy độ dài(kết quả con); i++) {
                nhóm = mình.biểu thức chính quy sao chép danh sách(kết quả con[i]["nhóm"]);
                nhóm[nút["số"]] = mình.biểu thức chính quy đoạn(văn bản, bắt đầu, kết quả con[i]["vị trí"]);
                máy ảo thêm cuối danh sách(kết quả, mình.biểu thức chính quy trạng thái(kết quả con[i]["vị trí"], nhóm));
            };
            trả về kết quả;
        };
        nếu (loại == "nhìn trước") {
            lượt thử khớp = mình.biểu thức chính quy khớp nút(nút["con"], văn bản, trạng thái);
            nếu (máy ảo lấy độ dài(lượt thử khớp) == 0) { trả về []; };
            trả về [mình.biểu thức chính quy trạng thái(vị trí, lượt thử khớp[0]["nhóm"])];
        };
        nếu (loại == "không nhìn trước") {
            lượt thử khớp = mình.biểu thức chính quy khớp nút(nút["con"], văn bản, trạng thái);
            nếu (máy ảo lấy độ dài(lượt thử khớp) == 0) { trả về [trạng thái]; };
            trả về [];
        };
        nếu (loại == "lặp") {
            trả về mình.biểu thức chính quy khớp lặp(nút, văn bản, trạng thái, 0, []);
        };
        mình.biểu thức chính quy lỗi mẫu();
    };

    hàm riêng tư biểu thức chính quy nhóm rỗng(số nhóm) {
        nhóm = [];
        lặp(i = 0; i <= số nhóm; i++) { máy ảo thêm cuối danh sách(nhóm, ""); };
        trả về nhóm;
    };

    hàm riêng tư biểu thức chính quy thử tại(cây, số nhóm, văn bản, vị trí) {
        trạng thái = mình.biểu thức chính quy trạng thái(vị trí, mình.biểu thức chính quy nhóm rỗng(số nhóm));
        trả về mình.biểu thức chính quy khớp nút(cây, văn bản, trạng thái);
    };

    hàm riêng tư biểu thức chính quy chọn(kết quả, bắt đầu, cần dương) {
        lặp(i = 0; i < máy ảo lấy độ dài(kết quả); i++) {
            nếu (!cần dương || kết quả[i]["vị trí"] > bắt đầu) {
                trả về kết quả[i];
            };
        };
        trả về rỗng;
    };

    hàm riêng tư biểu thức chính quy thêm khớp(các khớp, văn bản, bắt đầu trước, bắt đầu, trạng thái) {
        nhóm = mình.biểu thức chính quy sao chép danh sách(trạng thái["nhóm"]);
        nhóm[0] = mình.biểu thức chính quy đoạn(văn bản, bắt đầu, trạng thái["vị trí"]);
        máy ảo thêm cuối danh sách(các khớp, [mình.biểu thức chính quy đoạn(văn bản, bắt đầu trước, bắt đầu), nhóm]);
        trả về trạng thái["vị trí"];
    };

    hàm riêng tư biểu thức chính quy quét đã phân tích(văn bản, phân tích) {
        nếu (loại của(văn bản) != "chuỗi") {
            ném "regex: văn bản phải là chuỗi";
        };
        cây = phân tích["cây"];
        số nhóm = phân tích["nhóm"];
        n = máy ảo lấy độ dài(văn bản);
        các khớp = [];
        tìm từ = 0;
        hết trước = 0;
        xong = sai;

        khi (!xong) {
            tìm thấy = rỗng;
            bắt đầu = -1;
            p = tìm từ;
            khi (p <= n && tìm thấy == rỗng) {
                lượt thử khớp = mình.biểu thức chính quy thử tại(cây, số nhóm, văn bản, p);
                tìm thấy = mình.biểu thức chính quy chọn(lượt thử khớp, p, sai);
                nếu (tìm thấy == rỗng) { p++; };
            };
            nếu (tìm thấy == rỗng) {
                xong = đúng;
            } hoặc {
                bắt đầu = p;
                hết = mình.biểu thức chính quy thêm khớp(các khớp, văn bản, hết trước, bắt đầu, tìm thấy);
                hết trước = hết;
                nếu (hết > bắt đầu) {
                    tìm từ = hết;
                } hoặc {
                    // ECMAScript iterator: sau empty match, thử một non-empty match
                    // liên tục tại cùng vị trí trước khi tiến một code point.
                    lượt thử dương = mình.biểu thức chính quy thử tại(cây, số nhóm, văn bản, bắt đầu);
                    dương = mình.biểu thức chính quy chọn(lượt thử dương, bắt đầu, đúng);
                    nếu (dương != rỗng) {
                        hết = mình.biểu thức chính quy thêm khớp(các khớp, văn bản, hết trước, bắt đầu, dương);
                        hết trước = hết;
                        tìm từ = hết;
                    } hoặc {
                        nếu (bắt đầu >= n) {
                            xong = đúng;
                        } hoặc {
                            tìm từ = bắt đầu + 1;
                        };
                    };
                };
            };
        };
        trả về [các khớp, mình.biểu thức chính quy đoạn(văn bản, hết trước, n)];
    };

    hàm riêng tư biểu thức chính quy khớp đã phân tích(văn bản, phân tích) {
        nếu (loại của(văn bản) != "chuỗi") {
            ném "regex: văn bản phải là chuỗi";
        };
        kết quả = mình.biểu thức chính quy thử tại(phân tích["cây"], phân tích["nhóm"], văn bản, 0);
        n = máy ảo lấy độ dài(văn bản);
        lặp(i = 0; i < máy ảo lấy độ dài(kết quả); i++) {
            nếu (kết quả[i]["vị trí"] == n) { trả về đúng; };
        };
        trả về sai;
    };

    hàm riêng tư biểu thức chính quy chữ số nhóm(c) {
        chữ số = "0123456789";
        lặp(i = 0; i < 10; i++) {
            nếu (chữ số[i] == c) { trả về i; };
        };
        trả về -1;
    };

    // scan trả [các khớp, đuôi]; mỗi khớp là [khoảng trước, các nhóm gồm nhóm 0].
    // Chỉ ghép các mảnh engine trả về, không đánh chỉ số Unicode vào byte offset.
    // Không lưu suffix đầy đủ cho từng khớp để tránh bộ nhớ O(n²) khi thay đơn giản.
    hàm riêng tư biểu thức chính quy phần sau(các khớp, chỉ số, đuôi) {
        kết quả = "";
        lặp(i = chỉ số + 1; i < máy ảo lấy độ dài(các khớp); i++) {
            mục khớp = các khớp[i];
            nhóm = mục khớp[1];
            kết quả = kết quả + mục khớp[0] + nhóm[0];
        };
        trả về kết quả + đuôi;
    };

    hàm riêng tư biểu thức chính quy mở rộng thay thế(mẫu thay, các khớp, chỉ số, đuôi) {
        mục khớp = các khớp[chỉ số];
        nhóm = mục khớp[1];
        kết quả = "";
        n = máy ảo lấy độ dài(mẫu thay);
        lặp(i = 0; i < n; i++) {
            c = mẫu thay[i];
            nếu (c != "$" || i + 1 >= n) {
                kết quả = kết quả + c;
            } hoặc {
                tiếp = mẫu thay[i + 1];
                đã xử lý = sai;
                nếu (tiếp == "$") {
                    kết quả = kết quả + "$";
                    i++;
                    đã xử lý = đúng;
                };
                nếu (tiếp == "&") {
                    kết quả = kết quả + nhóm[0];
                    i++;
                    đã xử lý = đúng;
                };
                nếu (tiếp == "`") {
                    kết quả = kết quả + mục khớp[0];
                    i++;
                    đã xử lý = đúng;
                };
                nếu (tiếp == "'") {
                    kết quả = kết quả + mình.biểu thức chính quy phần sau(các khớp, chỉ số, đuôi);
                    i++;
                    đã xử lý = đúng;
                };
                nếu (!đã xử lý) {
                    số nhóm = mình.biểu thức chính quy chữ số nhóm(tiếp);
                    nếu (số nhóm < 0) {
                        kết quả = kết quả + "$";
                    } hoặc {
                        i++;
                        nếu (i + 1 < n) {
                            chữ số sau = mình.biểu thức chính quy chữ số nhóm(mẫu thay[i + 1]);
                            nếu (chữ số sau >= 0) {
                                số nhóm = số nhóm * 10 + chữ số sau;
                                i++;
                            };
                        };
                        nếu (số nhóm < máy ảo lấy độ dài(nhóm)) {
                            kết quả = kết quả + nhóm[số nhóm];
                        };
                    };
                };
            };
        };
        trả về kết quả;
    };

    hàm riêng tư biểu thức chính quy thay kết quả(kết quả quét, giá trị thay thế) {
        các khớp = kết quả quét[0];
        đuôi = kết quả quét[1];
        kết quả = "";
        lặp(i = 0; i < máy ảo lấy độ dài(các khớp); i++) {
            mục khớp = các khớp[i];
            kết quả = kết quả + mục khớp[0] +
                mình.biểu thức chính quy mở rộng thay thế(giá trị thay thế, các khớp, i, đuôi);
        };
        trả về kết quả + đuôi;
    };

    hàm riêng tư biểu thức chính quy tách kết quả(kết quả quét) {
        các khớp = kết quả quét[0];
        đuôi = kết quả quét[1];
        kết quả = [];
        lặp(i = 0; i < máy ảo lấy độ dài(các khớp); i++) {
            mục khớp = các khớp[i];
            máy ảo thêm cuối danh sách(kết quả, mục khớp[0]);
        };
        // Contract std::regex_token_iterator: giữ mảnh rỗng đầu/giữa nhưng không
        // thêm đuôi rỗng sau delimiter cuối. Không khớp trả nguyên văn bản.
        nếu (đuôi != "" || máy ảo lấy độ dài(các khớp) == 0) {
            máy ảo thêm cuối danh sách(kết quả, đuôi);
        };
        trả về kết quả;
    };
};

// Hàm tiện ích dựng Biểu Thức Chính Quy; lớp giữ AST đã phân tích theo instance.
hàm công khai biểu thức chính quy khớp(văn bản, mẫu) {
    nếu (loại của(văn bản) != "chuỗi") { ném "regex: văn bản phải là chuỗi"; };
    bộ = Biểu Thức Chính Quy(mẫu);
    trả về bộ.khớp(văn bản);
};

hàm công khai biểu thức chính quy tìm(văn bản, mẫu) {
    nếu (loại của(văn bản) != "chuỗi") { ném "regex: văn bản phải là chuỗi"; };
    bộ = Biểu Thức Chính Quy(mẫu);
    trả về bộ.tìm(văn bản);
};

hàm công khai biểu thức chính quy thay(văn bản, mẫu, giá trị thay thế) {
    nếu (loại của(giá trị thay thế) != "chuỗi") { ném "regex thay: giá trị thay thế phải là chuỗi"; };
    nếu (loại của(văn bản) != "chuỗi") { ném "regex: văn bản phải là chuỗi"; };
    bộ = Biểu Thức Chính Quy(mẫu);
    trả về bộ.thay(văn bản, giá trị thay thế);
};

hàm công khai biểu thức chính quy tách(văn bản, mẫu) {
    nếu (loại của(văn bản) != "chuỗi") { ném "regex: văn bản phải là chuỗi"; };
    bộ = Biểu Thức Chính Quy(mẫu);
    trả về bộ.tách(văn bản);
};
