// Module: lõi.luận lý
// Các phép toán logic thuần túy được cung cấp trực tiếp tại cấp mô-đun.

hàm công khai bằng nhau(a, b) {
    trả về a == b;
};

hàm công khai khác nhau(a, b) {
    trả về a != b;
};

hàm công khai tất cả(a, b) {
    nếu (a && b) {
        trả về đúng;
    };
    trả về sai;
};

hàm công khai một trong hai(a, b) {
    nếu (a || b) {
        trả về đúng;
    };
    trả về sai;
};
