// vi.locale — định dạng số/tiền tệ theo vùng theo contract xác định của V++.
nhập gói.lõi.định dạng.định dạng;
nhập gói.lõi.chuyển kiểu.thành chuỗi;
nhập gói.lõi.chuyển kiểu.thành số nguyên;
nhập gói.lõi.chuyển kiểu.loại của;
nhập gói.lõi.ký hiệu vùng.ký hiệu vùng chuẩn hóa;
nhập gói.lõi.ký hiệu vùng.ký hiệu vùng lấy;
nhập gói.văn bản.chuỗi.độ dài;
nhập gói.văn bản.chuỗi.cắt chuỗi;
nhập gói.văn bản.chuỗi.chuỗi thường;
nhập gói.hệ thống.môi trường.đọc biến môi trường;

hàm công khai bản địa hóa chuẩn hóa vùng(vùng) {
    thử {
        trả về ký hiệu vùng chuẩn hóa(vùng);
    } bắt lỗi (e) {
        ném "bản địa hóa: vùng phải là chuỗi";
    };
};

hàm công khai vùng mặc định() {
    vùng = đọc biến môi trường("LC_ALL", "");
    nếu (vùng == "") {
        vùng = đọc biến môi trường("LANG", "");
    };
    nếu (vùng == "") {
        trả về "vi-VN";
    };
    trả về bản địa hóa chuẩn hóa vùng(vùng);
};

hàm riêng tư bản địa hóa là vùng vi(vùng) {
    thử {
        ký hiệu = ký hiệu vùng lấy(vùng);
    } bắt lỗi (e) {
        ném "bản địa hóa: vùng không được hỗ trợ";
    };
    trả về lấy từ điển(ký hiệu, "ngôn ngữ", "") == "vi";
};

hàm riêng tư bản địa hóa nhóm số thập phân(thô, vùng vi) {
    dấu = "";
    bắt đầu = 0;
    nếu (máy ảo lấy độ dài(thô) > 0 && thô[0] == "-") {
        dấu = "-";
        bắt đầu = 1;
    };

    vị trí chấm = -1;
    lặp(i = bắt đầu; i < máy ảo lấy độ dài(thô) && vị trí chấm < 0; i++) {
        nếu (thô[i] == ".") {
            vị trí chấm = i;
        };
    };

    cuối nguyên = máy ảo lấy độ dài(thô);
    nếu (vị trí chấm >= 0) {
        cuối nguyên = vị trí chấm;
    };
    số chữ số nguyên = cuối nguyên - bắt đầu;
    phân cách nghìn = ",";
    phân cách thập phân = ".";
    nếu (vùng vi) {
        phân cách nghìn = ".";
        phân cách thập phân = ",";
    };

    kết quả = dấu;
    lặp(i = bắt đầu; i < cuối nguyên; i++) {
        đã ghi = i - bắt đầu;
        nếu (đã ghi > 0 && (số chữ số nguyên - đã ghi) % 3 == 0) {
            kết quả = kết quả + phân cách nghìn;
        };
        kết quả = kết quả + thô[i];
    };

    nếu (vị trí chấm >= 0 && vị trí chấm + 1 < máy ảo lấy độ dài(thô)) {
        kết quả = kết quả + phân cách thập phân +
            cắt chuỗi(thô, vị trí chấm + 1, máy ảo lấy độ dài(thô) - vị trí chấm - 1);
    };
    trả về kết quả;
};

hàm công khai định dạng số vùng(giá trị, vùng, số chữ số thập phân = 2) {
    loại = loại của(giá trị);
    nếu (loại != "số nguyên" && loại != "số thực") {
        ném "bản địa hóa: giá trị phải là số hữu hạn";
    };
    nếu (loại của(vùng) != "chuỗi") {
        ném "bản địa hóa: vùng phải là chuỗi";
    };

    thử {
        chữ số = thành số nguyên(số chữ số thập phân);
    } bắt lỗi (e) {
        ném "bản địa hóa: số chữ số thập phân phải là số nguyên";
    };
    nếu (chữ số < 0 || chữ số > 12) {
        ném "bản địa hóa: số chữ số thập phân phải trong 0..12";
    };

    mẫu = "%,." + thành chuỗi(chữ số) + "f";
    thử {
        trả về định dạng(mẫu, [giá trị], vùng);
    } bắt lỗi (e) {
        nếu (e == "FORMAT_LOCALE") {
            ném "bản địa hóa: vùng không được hỗ trợ";
        };
        ném e;
    };
};

hàm công khai định dạng tiền vùng(giá trị, mã tiền tệ, vùng) {
    nếu (loại của(mã tiền tệ) != "chuỗi") {
        ném "bản địa hóa: mã tiền tệ phải là chuỗi";
    };
    nếu (loại của(vùng) != "chuỗi") {
        ném "bản địa hóa: vùng phải là chuỗi";
    };

    mã = chuỗi thường(mã tiền tệ);
    chữ số = 2;
    nếu (mã == "vnd") {
        chữ số = 0;
    };
    đã định dạng = định dạng số vùng(giá trị, vùng, chữ số);
    nếu (mã == "vnd") {
        trả về đã định dạng + " ₫";
    };
    nếu (mã == "usd") {
        nếu (bản địa hóa là vùng vi(vùng)) {
            trả về đã định dạng + " US$";
        };
        trả về "$" + đã định dạng;
    };
    trả về đã định dạng + " " + mã;
};
