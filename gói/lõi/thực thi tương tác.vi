// vpp.repl — phiên tương tác giữ nguồn qua nhiều lần nhập.
// Quản lý phiên được triển khai bằng V++. Chỉ thao tác thực thi mã nguồn dùng
// primitive `kịch bản chạy`, vì compiler/VM là năng lực thấp tầng của runtime.

nhập bộ sưu tập.*;
nhập văn bản.*;
nhập kịch bản.*;
nhập gói.lõi.giao diện tài nguyên.*;

hàm riêng tư repl yêu cầu phiên(phiên) {
    nếu (máy ảo có khóa từ điển(phiên, "__repl") == 0 ||
        lấy từ điển(phiên, "__repl", 0) != 1 ||
        lấy từ điển(phiên, "mở", 0) != 1) {
        ném "repl: phiên không tồn tại";
    };
    trả về phiên;
};

hàm công khai repl tạo() {
    trả về {
        "__repl": 1,
        "mở": 1,
        "nguồn": "",
        "đầu ra": ""
    };
};

hàm công khai repl chạy(phiên, dòng) {
    repl yêu cầu phiên(phiên);
    nguồn cũ = lấy từ điển(phiên, "nguồn", "");
    đầu ra cũ = lấy từ điển(phiên, "đầu ra", "");

    nguồn mới = nguồn cũ + dòng;
    nếu (kết thúc bằng(nguồn mới, "\n") == sai) {
        nguồn mới = nguồn mới + "\n";
    };

    đầu ra mới = kịch bản chạy(nguồn mới);
    phần mới = đầu ra mới;
    nếu (bắt đầu bằng(đầu ra mới, đầu ra cũ)) {
        phần mới = con chuỗi(
            đầu ra mới,
            máy ảo lấy độ dài(đầu ra cũ),
            máy ảo lấy độ dài(đầu ra mới)
        );
    };

    đặt từ điển(phiên, "nguồn", nguồn mới);
    đặt từ điển(phiên, "đầu ra", đầu ra mới);
    trả về phần mới;
};

hàm công khai repl nguồn(phiên) {
    repl yêu cầu phiên(phiên);
    trả về lấy từ điển(phiên, "nguồn", "");
};

hàm công khai repl đặt lại(phiên) {
    repl yêu cầu phiên(phiên);
    đặt từ điển(phiên, "nguồn", "");
    đặt từ điển(phiên, "đầu ra", "");
    trả về 1;
};

hàm công khai repl đóng(phiên) {
    repl yêu cầu phiên(phiên);
    đặt từ điển(phiên, "mở", 0);
    trả về 1;
};

lớp công khai Phiên Tương Tác triển khai Đóng Được {
    hàm công khai khởi tạo() { mình.phiên = repl tạo(); };
    hàm công khai chạy(dòng) { trả về repl chạy(mình.phiên, dòng); };
    hàm công khai nguồn() { trả về repl nguồn(mình.phiên); };
    hàm công khai đặt lại() { repl đặt lại(mình.phiên); trả về mình; };
    hàm công khai đóng() {
        nếu (lấy từ điển(mình.phiên, "mở", 0) == 0) { trả về sai; };
        repl đóng(mình.phiên);
        trả về đúng;
    };
};
