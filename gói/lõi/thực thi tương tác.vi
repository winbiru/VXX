// vpp.repl — phiên tương tác giữ nguồn qua nhiều lần nhập.
// Quản lý phiên được triển khai bằng V++. Chỉ thao tác thực thi mã nguồn dùng
// primitive `kịch bản chạy`, vì compiler/VM là năng lực thấp tầng của runtime.

nhập bộ sưu tập;
nhập văn bản;
nhập kịch bản;
nhập gói/lõi/giao diện tài nguyên;

hàm riêng tư repl yêu cầu phiên(phiên) {
    nếu (có khóa(phiên, "__repl") == 0 ||
        lấy map(phiên, "__repl", 0) != 1 ||
        lấy map(phiên, "mở", 0) != 1) {
        ném "repl: phiên không tồn tại";
    };
    trả về phiên;
};

hàm công khai repl tạo() {
    trả về {
        "__repl": 1,
        "mở": 1,
        "nguồn": "",
        "đầu ra": ""
    };
};

hàm công khai repl chạy(phiên, dòng) {
    repl yêu cầu phiên(phiên);
    nguồn_cũ = lấy map(phiên, "nguồn", "");
    đầu_ra_cũ = lấy map(phiên, "đầu ra", "");

    nguồn_mới = nguồn_cũ + dòng;
    nếu (kết thúc bằng(nguồn_mới, "\n") == sai) {
        nguồn_mới = nguồn_mới + "\n";
    };

    đầu_ra_mới = kịch bản chạy(nguồn_mới);
    phần_mới = đầu_ra_mới;
    nếu (bắt đầu bằng(đầu_ra_mới, đầu_ra_cũ)) {
        phần_mới = con chuỗi(
            đầu_ra_mới,
            độ dài(đầu_ra_cũ),
            độ dài(đầu_ra_mới)
        );
    };

    đặt map(phiên, "nguồn", nguồn_mới);
    đặt map(phiên, "đầu ra", đầu_ra_mới);
    trả về phần_mới;
};

hàm công khai repl nguồn(phiên) {
    repl yêu cầu phiên(phiên);
    trả về lấy map(phiên, "nguồn", "");
};

hàm công khai repl đặt lại(phiên) {
    repl yêu cầu phiên(phiên);
    đặt map(phiên, "nguồn", "");
    đặt map(phiên, "đầu ra", "");
    trả về 1;
};

hàm công khai repl đóng(phiên) {
    repl yêu cầu phiên(phiên);
    đặt map(phiên, "mở", 0);
    trả về 1;
};

lớp công khai Phiên Tương Tác triển khai Đóng Được {
    hàm công khai khởi tạo() { mình.phiên = repl tạo(); };
    hàm công khai chạy(dòng) { trả về repl chạy(mình.phiên, dòng); };
    hàm công khai nguồn() { trả về repl nguồn(mình.phiên); };
    hàm công khai đặt lại() { repl đặt lại(mình.phiên); trả về mình; };
    hàm công khai đóng() {
        nếu (lấy map(mình.phiên, "mở", 0) == 0) { trả về sai; };
        repl đóng(mình.phiên);
        trả về đúng;
    };
};
