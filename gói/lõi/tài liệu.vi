// vpp.doc — sinh tài liệu Markdown từ AST V++.
nhập nhập xuất.*;
nhập biên dịch.*;

hàm công khai khởi tạo() {};

hàm riêng tư tài liệu dựng tham số(tham số) {
    nếu (máy ảo lấy độ dài(tham số) == 0) {
        trả về "không có";
    };
    kết quả = "";
    lặp(i = 0; i < máy ảo lấy độ dài(tham số); i++) {
        nếu (i > 0) {
            kết quả = kết quả + ", ";
        };
        mục = tham số[i];
        kết quả = kết quả + lấy từ điển(mục, "tên", "");
        nếu (lấy từ điển(mục, "có mặc định", 0)) {
            kết quả = kết quả + " (có mặc định)";
        };
    };
    trả về kết quả;
};

hàm riêng tư tài liệu dựng hàm(mục, tiền tố) {
    trả về tiền tố + " Hàm " + lấy từ điển(mục, "tên", "") + "\n\n" +
        "- Phạm vi: " + lấy từ điển(mục, "phạm vi", "mặc định") + "\n" +
        "- Tham số: " + tài liệu dựng tham số(lấy từ điển(mục, "tham số", [])) + "\n\n";
};

hàm riêng tư tài liệu dựng kiểu(mục) {
    loại = lấy từ điển(mục, "loại", "");
    nhãn = "Giao diện";
    nếu (loại == "lớp") {
        nhãn = "Lớp";
    };
    kết quả = "## " + nhãn + " " + lấy từ điển(mục, "tên", "") + "\n\n" +
        "- Phạm vi: " + lấy từ điển(mục, "phạm vi", "mặc định") + "\n\n";
    thành viên = lấy từ điển(mục, "thành viên", []);
    lặp(i = 0; i < máy ảo lấy độ dài(thành viên); i++) {
        kết quả = kết quả + tài liệu dựng hàm(thành viên[i], "###");
    };
    trả về kết quả;
};

hàm công khai tài liệu dựng(mã nguồn, tiêu đề) {
    phân tích = biên dịch phân tích(mã nguồn);
    cây = lấy từ điển(phân tích, "cây cú pháp", []);
    nếu (tiêu đề == "") {
        tiêu đề = "Tài liệu V++";
    };
    kết quả = "# " + tiêu đề + "\n\n";

    phụ thuộc = [];
    lặp(i = 0; i < máy ảo lấy độ dài(cây); i++) {
        mục = cây[i];
        nếu (lấy từ điển(mục, "loại", "") == "nhập") {
            đích = lấy từ điển(mục, "đích", "");
            nếu (đích != "") { máy ảo thêm cuối danh sách(phụ thuộc, đích); };
        };
    };
    nếu (máy ảo lấy độ dài(phụ thuộc) > 0) {
        kết quả = kết quả + "## Phụ thuộc\n\n";
        lặp(i = 0; i < máy ảo lấy độ dài(phụ thuộc); i++) {
            kết quả = kết quả + "- " + phụ thuộc[i] + "\n";
        };
        kết quả = kết quả + "\n";
    };

    lặp(i = 0; i < máy ảo lấy độ dài(cây); i++) {
        mục = cây[i];
        phạm vi = lấy từ điển(mục, "phạm vi", "mặc định");
        nếu (phạm vi != "riêng tư" && phạm vi != "bảo vệ") {
            loại = lấy từ điển(mục, "loại", "");
            nếu (loại == "hàm") {
                kết quả = kết quả + tài liệu dựng hàm(mục, "##");
            } hoặc {
                nếu (loại == "lớp" || loại == "giao diện") {
                    kết quả = kết quả + tài liệu dựng kiểu(mục);
                };
            };
        };
    };
    trả về kết quả;
};

hàm công khai tài liệu tạo(mã nguồn) {
    trả về tài liệu dựng(mã nguồn, "Tài liệu V++");
};

hàm công khai tài liệu tạo từ tệp(đường dẫn) {
    mã nguồn = đọc tệp(đường dẫn);
    trả về tài liệu dựng(mã nguồn, đường dẫn tên(đường dẫn));
};

hàm công khai tài liệu ghi tệp(mã nguồn, đường dẫn) {
    nội dung = tài liệu tạo(mã nguồn);
    ghi tệp(đường dẫn, nội dung);
    trả về máy ảo lấy độ dài(nội dung);
};
