// Module: lõi.định dạng
// ABI V1 dùng một list đối số vì ngôn ngữ chưa có vararg public ổn định.
// Parser, validation, grouping, padding và dispatch kiểu nằm ở V++.
// V++ sở hữu cả chuyển đổi IEEE-754 thành thập phân và làm tròn.
// VM chỉ đọc byte biểu diễn số, không dựng thân thập phân hay chạy formatter.

nhập gói/lõi/chuyển kiểu;
nhập gói/lõi/toán học;
nhập gói/bộ sưu tập/danh sách;
nhập gói/bộ sưu tập/từ điển;
nhập gói/lõi/bảng mã;
nhập gói/lõi/ký hiệu vùng;
nhập gói/văn bản/chuỗi;
nhập gói/lõi/định dạng số thực;

// Thuật toán định dạng không giữ trạng thái được tổ chức thành hàm cấp mô-đun.
hàm riêng tư định dạng có ký tự(văn bản, ký tự) {
    lặp(i = 0; i < máy ảo lấy độ dài(văn bản); i++) {
        nếu (văn bản[i] == ký tự) {
            trả về đúng;
        };
    };
    trả về sai;
};

hàm riêng tư định dạng là chữ số(c) {
    trả về c >= "0" && c <= "9";
};

hàm riêng tư định dạng đọc số(mẫu, bắt đầu, kết thúc, lỗi) {
    nếu (bắt đầu == kết thúc) {
        ném lỗi;
    };
    giá trị = 0;
    lặp(i = bắt đầu; i < kết thúc; i++) {
        c = mẫu[i];
        nếu (!định dạng là chữ số(c)) {
            ném lỗi;
        };
        chữ số = thành số nguyên(c);
        nếu (giá trị > (1048576 - chữ số) / 10) {
            ném lỗi;
        };
        giá trị = giá trị * 10 + chữ số;
    };
    trả về giá trị;
};

hàm riêng tư định dạng cờ ngoài(cờ, cho phép) {
    lặp(i = 0; i < máy ảo lấy độ dài(cờ); i++) {
        nếu (!định dạng có ký tự(cho phép, cờ[i])) {
            trả về đúng;
        };
    };
    trả về sai;
};

hàm riêng tư định dạng chuyển đổi hợp lệ(c) {
    trả về c == "s" || c == "b" || c == "c" || c == "d" ||
        c == "o" || c == "x" || c == "X" || c == "f" ||
        c == "e" || c == "E" || c == "g" || c == "G" ||
        c == "%" || c == "n";
};

hàm riêng tư định dạng xác thực spec(spec) {
    cờ = lấy từ điển(spec, "cờ", "");
    chuyển = lấy từ điển(spec, "chuyển", "");
    có rộng = lấy từ điển(spec, "có rộng", sai);
    có chính xác = lấy từ điển(spec, "có chính xác", sai);

    nếu (định dạng có ký tự(cờ, "-") && định dạng có ký tự(cờ, "0")) {
        ném "FORMAT_FLAG_MISMATCH";
    };
    nếu (định dạng có ký tự(cờ, "+") && định dạng có ký tự(cờ, " ")) {
        ném "FORMAT_FLAG_MISMATCH";
    };
    nếu (định dạng có ký tự(cờ, "(") &&
        (định dạng có ký tự(cờ, "+") || định dạng có ký tự(cờ, " "))) {
        ném "FORMAT_FLAG_MISMATCH";
    };
    nếu ((định dạng có ký tự(cờ, "-") || định dạng có ký tự(cờ, "0")) && !có rộng) {
        ném "FORMAT_MISSING_WIDTH";
    };

    nếu (chuyển == "s" || chuyển == "b") {
        nếu (định dạng cờ ngoài(cờ, "-")) { ném "FORMAT_FLAG_MISMATCH"; };
    } hoặc {
        nếu (chuyển == "c") {
            nếu (định dạng cờ ngoài(cờ, "-") || có chính xác) {
                ném "FORMAT_FLAG_MISMATCH";
            };
        } hoặc {
            nếu (chuyển == "d") {
                nếu (định dạng cờ ngoài(cờ, "-+0 ,(") || có chính xác) {
                    ném "FORMAT_FLAG_MISMATCH";
                };
            } hoặc {
                nếu (chuyển == "o" || chuyển == "x" || chuyển == "X") {
                    nếu (định dạng cờ ngoài(cờ, "-0") || có chính xác) {
                        ném "FORMAT_FLAG_MISMATCH";
                    };
                } hoặc {
                    nếu (chuyển == "f") {
                        nếu (định dạng cờ ngoài(cờ, "-+0 ,(")) {
                            ném "FORMAT_FLAG_MISMATCH";
                        };
                    } hoặc {
                        nếu (chuyển == "e" || chuyển == "E") {
                            nếu (định dạng cờ ngoài(cờ, "-+0 (")) {
                                ném "FORMAT_FLAG_MISMATCH";
                            };
                        } hoặc {
                            nếu (chuyển == "g" || chuyển == "G") {
                                nếu (định dạng cờ ngoài(cờ, "-+0 ,(")) {
                                    ném "FORMAT_FLAG_MISMATCH";
                                };
                            } hoặc {
                                nếu (chuyển == "%") {
                                    nếu (định dạng cờ ngoài(cờ, "-") || có chính xác) {
                                        ném "FORMAT_FLAG_MISMATCH";
                                    };
                                } hoặc {
                                    nếu (chuyển == "n") {
                                        nếu (cờ != "" || có rộng || có chính xác) {
                                            ném "FORMAT_FLAG_MISMATCH";
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };
        };
    };
    trả về đúng;
};

hàm riêng tư định dạng lặp(ký tự, số lượng) {
    kết quả = "";
    lặp(i = 0; i < số lượng; i++) {
        kết quả = kết quả + ký tự;
    };
    trả về kết quả;
};

hàm riêng tư định dạng đệm(giá trị, spec, số = sai, tiền tố = 0, hậu tố = 0) {
    nếu (!lấy từ điển(spec, "có rộng", sai)) {
        trả về giá trị;
    };
    rộng = lấy từ điển(spec, "rộng", 0);
    n = máy ảo lấy độ dài(giá trị);
    nếu (rộng <= n) {
        trả về giá trị;
    };
    thêm vào = rộng - n;
    cờ = lấy từ điển(spec, "cờ", "");
    nếu (định dạng có ký tự(cờ, "-")) {
        trả về giá trị + định dạng lặp(" ", thêm vào);
    };
    nếu (số && định dạng có ký tự(cờ, "0")) {
        giữa = n - tiền tố - hậu tố;
        nếu (giữa < 0) { giữa = 0; };
        đầu = cắt chuỗi(giá trị, 0, tiền tố);
        thân = cắt chuỗi(giá trị, tiền tố, giữa);
        đuôi = cắt chuỗi(giá trị, tiền tố + giữa, hậu tố);
        trả về đầu + định dạng lặp("0", thêm vào) + thân + đuôi;
    };
    trả về định dạng lặp(" ", thêm vào) + giá trị;
};

hàm riêng tư định dạng nhóm chữ số(chữ số, phân cách = ",") {
    n = máy ảo lấy độ dài(chữ số);
    nếu (n == 0) { trả về chữ số; };
    đầu = n % 3;
    nếu (đầu == 0) { đầu = 3; };
    kết quả = "";
    lặp(i = 0; i < n; i++) {
        nếu (i != 0 && (i == đầu || (i > đầu && (i - đầu) % 3 == 0))) {
            kết quả = kết quả + phân cách;
        };
        kết quả = kết quả + chữ số[i];
    };
    trả về kết quả;
};

hàm riêng tư định dạng nhóm số thực(thân, phân cách = ",", thập phân = ".") {
    n = máy ảo lấy độ dài(thân);
    mũ = n;
    chấm = n;
    lặp(i = 0; i < n; i++) {
        nếu (mũ == n && (thân[i] == "e" || thân[i] == "E")) { mũ = i; };
        nếu (chấm == n && thân[i] == thập phân) { chấm = i; };
    };
    hết nguyên = chấm;
    nếu (mũ < hết nguyên) { hết nguyên = mũ; };
    trả về định dạng nhóm chữ số(cắt chuỗi(thân, 0, hết nguyên), phân cách) +
        cắt chuỗi(thân, hết nguyên, n - hết nguyên);
};

hàm riêng tư định dạng áp ký hiệu thập phân(thân, ký hiệu) {
    thập phân = lấy từ điển(ký hiệu, "thập phân", ".");
    nếu (thập phân == ".") {
        trả về thân;
    };
    kết quả = "";
    đã thay = sai;
    lặp(i = 0; i < máy ảo lấy độ dài(thân); i++) {
        c = thân[i];
        nếu (!đã thay && c == ".") {
            kết quả = kết quả + thập phân;
            đã thay = đúng;
        } hoặc {
            kết quả = kết quả + c;
        };
    };
    trả về kết quả;
};

hàm riêng tư định dạng cơ số dương(giá trị, cơ số, hoa) {
    chữ = "0123456789abcdef";
    nếu (hoa) { chữ = "0123456789ABCDEF"; };
    nếu (giá trị == 0) { trả về "0"; };
    kết quả = "";
    còn lại = giá trị;
    khi (còn lại > 0) {
        dư = còn lại % cơ số;
        kết quả = chữ[dư] + kết quả;
        còn lại = làm tròn xuống(còn lại / cơ số);
    };
    trả về kết quả;
};

hàm riêng tư định dạng thân số nguyên(giá trị, chuyển) {
    âm = giá trị < 0;
    nếu (giá trị == 0 - 2147483647 - 1) {
        nếu (chuyển == "d") { trả về "2147483648"; };
        nếu (chuyển == "o") { trả về "20000000000"; };
        nếu (chuyển == "X") { trả về "80000000"; };
        trả về "80000000";
    };
    độ lớn = giá trị;
    nếu (âm) { độ lớn = 0 - giá trị; };
    cơ số = 10;
    nếu (chuyển == "o") { cơ số = 8; };
    nếu (chuyển == "x" || chuyển == "X") { cơ số = 16; };
    trả về định dạng cơ số dương(độ lớn, cơ số, chuyển == "X");
};

hàm riêng tư định dạng áp dấu(thân, âm, spec) {
    cờ = lấy từ điển(spec, "cờ", "");
    tiền tố = 0;
    hậu tố = 0;
    nếu (âm && định dạng có ký tự(cờ, "(")) {
        thân = "(" + thân + ")";
        tiền tố = 1;
        hậu tố = 1;
    } hoặc {
        nếu (âm) {
            thân = "-" + thân;
            tiền tố = 1;
        } hoặc {
            nếu (định dạng có ký tự(cờ, "+")) {
                thân = "+" + thân;
                tiền tố = 1;
            } hoặc {
                nếu (định dạng có ký tự(cờ, " ")) {
                    thân = " " + thân;
                    tiền tố = 1;
                };
            };
        };
    };
    trả về định dạng đệm(thân, spec, đúng, tiền tố, hậu tố);
};

hàm riêng tư định dạng ký tự mã(mã) {
    nếu (mã < 0 || mã > 1114111 || (mã >= 55296 && mã <= 57343)) {
        ném "FORMAT_CODEPOINT";
    };
    các byte = [];
    nếu (mã <= 127) {
        máy ảo thêm cuối danh sách(các byte, mã);
    } hoặc {
        nếu (mã <= 2047) {
            máy ảo thêm cuối danh sách(các byte, 192 + làm tròn xuống(mã / 64));
            máy ảo thêm cuối danh sách(các byte, 128 + mã % 64);
        } hoặc {
            nếu (mã <= 65535) {
                máy ảo thêm cuối danh sách(các byte, 224 + làm tròn xuống(mã / 4096));
                máy ảo thêm cuối danh sách(các byte, 128 + (làm tròn xuống(mã / 64) % 64));
                máy ảo thêm cuối danh sách(các byte, 128 + mã % 64);
            } hoặc {
                máy ảo thêm cuối danh sách(các byte, 240 + làm tròn xuống(mã / 262144));
                máy ảo thêm cuối danh sách(các byte, 128 + (làm tròn xuống(mã / 4096) % 64));
                máy ảo thêm cuối danh sách(các byte, 128 + (làm tròn xuống(mã / 64) % 64));
                máy ảo thêm cuối danh sách(các byte, 128 + mã % 64);
            };
        };
    };
    trả về giải mã bảng mã(các byte, "UTF-8");
};

hàm riêng tư định dạng truthy(giá trị) {
    kiểu = loại của(giá trị);
    nếu (kiểu == "rỗng") { trả về sai; };
    nếu (kiểu == "số nguyên" || kiểu == "số thực") {
        trả về giá trị != 0;
    };
    nếu (kiểu == "chuỗi" || kiểu == "danh sách" || kiểu == "tuple" || kiểu == "từ điển") {
        trả về máy ảo lấy độ dài(giá trị) > 0;
    };
    trả về đúng;
};

hàm công khai có thể định dạng(chương trình gọi lại) {
    trả về {
        "loại": "CóThểĐịnhDạng",
        "callback": chương trình gọi lại
    };
};

hàm riêng tư định dạng tùy biến(giá trị, spec, ký hiệu) {
    nếu (loại của(giá trị) != "từ điển") {
        trả về rỗng;
    };
    nếu (lấy từ điển(giá trị, "loại", "") != "CóThểĐịnhDạng") {
        trả về rỗng;
    };
    chương trình gọi lại = lấy từ điển(giá trị, "callback", rỗng);
    ngữ cảnh = {
        "cờ": lấy từ điển(spec, "cờ", ""),
        "rộng": lấy từ điển(spec, "rộng", 0),
        "có rộng": lấy từ điển(spec, "có rộng", sai),
        "chính xác": lấy từ điển(spec, "chính xác", 0),
        "có chính xác": lấy từ điển(spec, "có chính xác", sai),
        "locale": lấy từ điển(ký hiệu, "tên", "C"),
        "vùng ngôn ngữ": lấy từ điển(ký hiệu, "tên", "C")
    };
    văn bản = chương trình gọi lại(ngữ cảnh);
    nếu (loại của(văn bản) != "chuỗi") {
        ném "FORMAT_FORMATTABLE";
    };
    trả về văn bản;
};

hàm riêng tư định dạng giá trị(giá trị, spec, ký hiệu) {
    chuyển = lấy từ điển(spec, "chuyển", "");
    có chính xác = lấy từ điển(spec, "có chính xác", sai);
    chính xác = lấy từ điển(spec, "chính xác", 0);

    nếu (chuyển == "s") {
        văn bản = định dạng tùy biến(giá trị, spec, ký hiệu);
        nếu (văn bản == rỗng) {
            văn bản = thành chuỗi(giá trị);
        };
        nếu (có chính xác && máy ảo lấy độ dài(văn bản) > chính xác) {
            văn bản = cắt chuỗi(văn bản, 0, chính xác);
        };
        trả về định dạng đệm(văn bản, spec);
    };
    nếu (chuyển == "b") {
        văn bản = "false";
        nếu (định dạng truthy(giá trị)) { văn bản = "true"; };
        nếu (có chính xác && máy ảo lấy độ dài(văn bản) > chính xác) {
            văn bản = cắt chuỗi(văn bản, 0, chính xác);
        };
        trả về định dạng đệm(văn bản, spec);
    };
    nếu (chuyển == "c") {
        kiểu = loại của(giá trị);
        nếu (kiểu == "số nguyên") {
            văn bản = định dạng ký tự mã(giá trị);
        } hoặc {
            nếu (kiểu == "chuỗi" && máy ảo lấy độ dài(giá trị) == 1) {
                văn bản = giá trị;
            } hoặc {
                ném "FORMAT_CONVERSION";
            };
        };
        trả về định dạng đệm(văn bản, spec);
    };
    nếu (chuyển == "d" || chuyển == "o" || chuyển == "x" || chuyển == "X") {
        nếu (loại của(giá trị) != "số nguyên") {
            ném "FORMAT_CONVERSION";
        };
        thân = định dạng thân số nguyên(giá trị, chuyển);
        nếu (chuyển == "d" && định dạng có ký tự(lấy từ điển(spec, "cờ", ""), ",")) {
            thân = định dạng nhóm chữ số(thân, lấy từ điển(ký hiệu, "nhóm", ","));
        };
        trả về định dạng áp dấu(thân, giá trị < 0, spec);
    };
    nếu (chuyển == "f" || chuyển == "e" || chuyển == "E" ||
        chuyển == "g" || chuyển == "G") {
        kiểu = loại của(giá trị);
        nếu (kiểu != "số nguyên" && kiểu != "số thực") {
            ném "FORMAT_CONVERSION";
        };
        nếu (!có chính xác) { chính xác = 6; };
        số đã định dạng = định dạng số thực nội bộ(giá trị, chuyển, chính xác);
        thân = lấy từ điển(số đã định dạng, "thân", "");
        âm = lấy từ điển(số đã định dạng, "âm", sai);
        thân = định dạng áp ký hiệu thập phân(thân, ký hiệu);
        nếu (định dạng có ký tự(lấy từ điển(spec, "cờ", ""), ",") &&
            (chuyển == "f" || chuyển == "g" || chuyển == "G")) {
            thân = định dạng nhóm số thực(
                thân,
                lấy từ điển(ký hiệu, "nhóm", ","),
                lấy từ điển(ký hiệu, "thập phân", ".")
            );
        };
        trả về định dạng áp dấu(thân, âm, spec);
    };
    ném "FORMAT_UNKNOWN_CONVERSION";
};

hàm riêng tư định dạng thực thi(mẫu, các đối số, vùng ngôn ngữ) {
    nếu (loại của(mẫu) != "chuỗi" || loại của(các đối số) != "danh sách") {
        ném "FORMAT_INVALID";
    };
    thử {
        ký hiệu = ký hiệu vùng lấy(vùng ngôn ngữ);
    } bắt lỗi (e) {
        ném "FORMAT_LOCALE";
    };
    nếu (máy ảo lấy độ dài(mã hóa bảng mã(mẫu, "UTF-8")) > 1048576) {
        ném "FORMAT_RESOURCE_LIMIT";
    };

    kết quả = "";
    n = máy ảo lấy độ dài(mẫu);
    con trỏ = 0;
    chỉ số ngầm = 0;
    đã tường mình = sai;
    đã ngầm = sai;

    khi (con trỏ < n) {
        nếu (mẫu[con trỏ] != "%") {
            kết quả = kết quả + mẫu[con trỏ];
            con trỏ = con trỏ + 1;
        } hoặc {
            vị trí hiện tại = con trỏ + 1;
            nếu (vị trí hiện tại >= n) { ném "FORMAT_INVALID"; };

            bắt đầu số = vị trí hiện tại;
            khi (vị trí hiện tại < n && định dạng là chữ số(mẫu[vị trí hiện tại])) {
                vị trí hiện tại = vị trí hiện tại + 1;
            };
            có chỉ số = sai;
            chỉ số = 0;
            nếu (vị trí hiện tại > bắt đầu số && vị trí hiện tại < n && mẫu[vị trí hiện tại] == "$") {
                một gốc = định dạng đọc số(mẫu, bắt đầu số, vị trí hiện tại, "FORMAT_INVALID");
                nếu (một gốc == 0) { ném "FORMAT_INVALID"; };
                chỉ số = một gốc - 1;
                có chỉ số = đúng;
                vị trí hiện tại = vị trí hiện tại + 1;
            } hoặc {
                vị trí hiện tại = bắt đầu số;
            };

            cờ = "";
            đang cờ = đúng;
            khi (vị trí hiện tại < n && đang cờ) {
                c = mẫu[vị trí hiện tại];
                nếu (c == "-" || c == "+" || c == "0" || c == " " || c == "," || c == "(") {
                    nếu (định dạng có ký tự(cờ, c)) { ném "FORMAT_DUPLICATE_FLAG"; };
                    cờ = cờ + c;
                    vị trí hiện tại = vị trí hiện tại + 1;
                } hoặc {
                    nếu (c == "#" || c == "<") { ném "FORMAT_UNKNOWN_FLAG"; };
                    đang cờ = sai;
                };
            };

            bắt đầu rộng = vị trí hiện tại;
            khi (vị trí hiện tại < n && định dạng là chữ số(mẫu[vị trí hiện tại])) {
                vị trí hiện tại = vị trí hiện tại + 1;
            };
            có rộng = vị trí hiện tại > bắt đầu rộng;
            rộng = 0;
            nếu (có rộng) {
                rộng = định dạng đọc số(mẫu, bắt đầu rộng, vị trí hiện tại, "FORMAT_WIDTH");
            };

            có chính xác = sai;
            chính xác = 0;
            nếu (vị trí hiện tại < n && mẫu[vị trí hiện tại] == ".") {
                có chính xác = đúng;
                vị trí hiện tại = vị trí hiện tại + 1;
                bắt đầu chính xác = vị trí hiện tại;
                khi (vị trí hiện tại < n && định dạng là chữ số(mẫu[vị trí hiện tại])) {
                    vị trí hiện tại = vị trí hiện tại + 1;
                };
                nếu (bắt đầu chính xác == vị trí hiện tại) { ném "FORMAT_PRECISION"; };
                chính xác = định dạng đọc số(mẫu, bắt đầu chính xác, vị trí hiện tại, "FORMAT_PRECISION");
            };

            nếu (vị trí hiện tại >= n) { ném "FORMAT_INVALID"; };
            chuyển = mẫu[vị trí hiện tại];
            vị trí hiện tại = vị trí hiện tại + 1;
            nếu (!định dạng chuyển đổi hợp lệ(chuyển)) {
                ném "FORMAT_UNKNOWN_CONVERSION";
            };
            nếu ((chuyển == "%" || chuyển == "n") && có chỉ số) {
                ném "FORMAT_INVALID";
            };

            spec = {
                "cờ": cờ,
                "rộng": rộng,
                "có rộng": có rộng,
                "chính xác": chính xác,
                "có chính xác": có chính xác,
                "chuyển": chuyển
            };
            định dạng xác thực spec(spec);

            nếu (chuyển == "%") {
                kết quả = kết quả + định dạng đệm("%", spec);
            } hoặc {
                nếu (chuyển == "n") {
                    kết quả = kết quả + "\n";
                } hoặc {
                    nếu (có chỉ số) {
                        đã tường mình = đúng;
                    } hoặc {
                        đã ngầm = đúng;
                    };
                    nếu (đã tường mình && đã ngầm) { ném "FORMAT_INVALID"; };

                    dùng = chỉ số ngầm;
                    nếu (có chỉ số) {
                        dùng = chỉ số;
                    } hoặc {
                        chỉ số ngầm = chỉ số ngầm + 1;
                    };
                    nếu (dùng < 0 || dùng >= máy ảo lấy độ dài(các đối số)) {
                        ném "FORMAT_MISSING_ARGUMENT";
                    };
                    kết quả = kết quả + định dạng giá trị(các đối số[dùng], spec, ký hiệu);
                };
            };
            nếu (máy ảo lấy độ dài(mã hóa bảng mã(kết quả, "UTF-8")) > 1048576) {
                ném "FORMAT_RESOURCE_LIMIT";
            };
            con trỏ = vị trí hiện tại;
        };
    };

    nếu (máy ảo lấy độ dài(mã hóa bảng mã(kết quả, "UTF-8")) > 1048576) {
        ném "FORMAT_RESOURCE_LIMIT";
    };
    trả về kết quả;
};

hàm riêng tư định dạng nội bộ(mẫu, các đối số, vùng ngôn ngữ) {
    thử {
        trả về {"giá trị": định dạng thực thi(mẫu, các đối số, vùng ngôn ngữ), "lỗi": ""};
    } bắt lỗi (e) {
        trả về {"giá trị": "", "lỗi": e};
    };
};

hàm công khai định dạng(mẫu, các đối số, vùng ngôn ngữ = rỗng) {
    kết quả = định dạng nội bộ(mẫu, các đối số, vùng ngôn ngữ);
    lỗi = lấy từ điển(kết quả, "lỗi", "FORMAT_INVALID");
    nếu (lỗi != "") {
        ném lỗi;
    };
    trả về lấy từ điển(kết quả, "giá trị", "");
};

// Appendable V++ đầu tiên là BộDựngChuỗi. Engine format dựng output atomically
// rồi append một lần, vì vậy formatter không để lại prefix dở nếu parse/render lỗi.
hàm công khai định dạng vào(đích, mẫu, các đối số, vùng ngôn ngữ = rỗng) {
    thử {
        bộ dựng yêu cầu(đích);
    } bắt lỗi (e) {
        ném "FORMAT_APPENDABLE";
    };
    văn bản = định dạng(mẫu, các đối số, vùng ngôn ngữ);
    thử {
        bộ dựng thêm(đích, văn bản);
    } bắt lỗi (e) {
        nếu (e == "STRING_RESOURCE_LIMIT") {
            ném "FORMAT_RESOURCE_LIMIT";
        };
        ném "FORMAT_APPENDABLE";
    };
    trả về đích;
};

// Processor cho MẫuChuỗi. Format spec nằm ở danh sách `specs`, tách khỏi
// values của template; vì vậy dữ liệu không bao giờ được diễn giải như cú pháp.
hàm công khai bộ xử lý mẫu định dạng(specs = rỗng, vùng ngôn ngữ = rỗng) {
    bộ xử lý = hàm(template) {
        mẫu chuỗi yêu cầu(template);
        mảnh = lấy từ điển(template, "mảnh", []);
        giá trị = lấy từ điển(template, "giá trị", []);
        nếu (specs != rỗng) {
            nếu (loại của(specs) != "danh sách") {
                ném "FORMAT_PROCESSOR_INVALID";
            };
            nếu (máy ảo lấy độ dài(specs) != máy ảo lấy độ dài(giá trị)) {
                ném "FORMAT_PROCESSOR_INVALID";
            };
        };

        kết quả = "";
        lặp(i = 0; i < máy ảo lấy độ dài(giá trị); i++) {
            spec = "%s";
            nếu (specs != rỗng) {
                spec = specs[i];
                nếu (loại của(spec) != "chuỗi") {
                    ném "FORMAT_PROCESSOR_INVALID";
                };
            };
            kết quả = kết quả + mảnh[i] + định dạng(spec, [giá trị[i]], vùng ngôn ngữ);
            nếu (máy ảo lấy độ dài(mã hóa bảng mã(kết quả, "UTF-8")) > 1048576) {
                ném "FORMAT_RESOURCE_LIMIT";
            };
        };
        kết quả = kết quả + mảnh[máy ảo lấy độ dài(mảnh) - 1];
        nếu (máy ảo lấy độ dài(mã hóa bảng mã(kết quả, "UTF-8")) > 1048576) {
            ném "FORMAT_RESOURCE_LIMIT";
        };
        trả về kết quả;
    };
    trả về bộ xử lý;
};

// Buffer chỉ đổi sau khi toàn bộ lần định dạng thành công.
lớp công khai Bộ Định Dạng {
    hàm công khai khởi tạo(vùng = rỗng) { mình.vùng = vùng; mình.văn bản = ""; };
    hàm công khai thêm(mẫu, đối số) {
        phần = định dạng(mẫu, đối số, mình.vùng);
        mới = mình.văn bản + phần;
        nếu (máy ảo lấy độ dài(mã hóa bảng mã(mới, "UTF-8")) > 1048576) { ném "FORMAT_RESOURCE_LIMIT"; };
        mình.văn bản = mới;
        trả về mình;
    };
    hàm công khai kết quả() { trả về mình.văn bản; };
    hàm công khai đặt lại() { mình.văn bản = ""; trả về mình; };
};
