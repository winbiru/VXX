// Module: lõi.bộ nối chuỗi
// ABI hiện tại biểu diễn BộNốiChuỗi bằng map nội bộ để package chuẩn không
// phụ thuộc class-lowering. Public semantics giữ encounter order.

hàm bộ nối chuỗi(phân_cách, tiền_tố = "", hậu_tố = "", giá_trị_rỗng = rỗng) {
    nếu (phân_cách == rỗng || tiền_tố == rỗng || hậu_tố == rỗng) {
        ném "JOIN_ARGUMENT";
    };
    trả về {
        "phân cách": phân_cách,
        "tiền tố": tiền_tố,
        "hậu tố": hậu_tố,
        "giá trị rỗng": giá_trị_rỗng,
        "các phần": []
    };
};

hàm bộ nối thêm(bộ, giá_trị) {
    các_phần = lấy map(bộ, "các phần", rỗng);
    nếu (các_phần == rỗng) {
        ném "JOIN_ARGUMENT";
    };
    thêm(các_phần, thành chuỗi(giá_trị));
    trả về bộ;
};

hàm bộ nối số phần(bộ) {
    các_phần = lấy map(bộ, "các phần", rỗng);
    nếu (các_phần == rỗng) {
        ném "JOIN_ARGUMENT";
    };
    trả về độ dài(các_phần);
};

hàm bộ nối kết quả(bộ) {
    các_phần = lấy map(bộ, "các phần", rỗng);
    nếu (các_phần == rỗng) {
        ném "JOIN_ARGUMENT";
    };

    phân_cách = lấy map(bộ, "phân cách", "");
    tiền_tố = lấy map(bộ, "tiền tố", "");
    hậu_tố = lấy map(bộ, "hậu tố", "");
    giá_trị_rỗng = lấy map(bộ, "giá trị rỗng", rỗng);
    n = độ dài(các_phần);
    nếu (n == 0) {
        nếu (giá_trị_rỗng != rỗng) {
            trả về giá_trị_rỗng;
        };
        trả về tiền_tố + hậu_tố;
    };

    kết_quả = tiền_tố;
    lặp(i = 0; i < n; i++) {
        nếu (i > 0) {
            kết_quả = kết_quả + phân_cách;
        };
        kết_quả = kết_quả + các_phần[i];
    };
    trả về kết_quả + hậu_tố;
};
