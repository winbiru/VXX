// Module: cấu hình
// Mục đích: đọc tệp properties/ini đơn giản ở tầng thư viện V++.
// File I/O vẫn là VM primitive; toàn bộ parsing và chuyển kiểu nằm ở V++.

nhập gói/nhập xuất/tệp;
nhập gói/nhập xuất/đường dẫn;
nhập gói/bộ sưu tập/từ điển;
nhập gói/lõi/chuyển kiểu;
nhập gói/văn bản/chuỗi;

hàm riêng tư cấu hình là khoảng trắng(c) {
    trả về c == " " || c == "\t" || c == "\r" || c == "\n";
};

hàm riêng tư cấu hình cắt khoảng trắng(s) {
    đầu = 0;
    cuối = máy ảo lấy độ dài(s);
    đang cắt = đúng;
    lặp(i = 0; i < cuối && đang cắt; i++) {
        nếu (cấu hình là khoảng trắng(s[đầu])) {
            đầu = đầu + 1;
            nếu (đầu == cuối) { đang cắt = sai; };
        } hoặc {
            đang cắt = sai;
        };
    };
    đang cắt = đúng;
    lặp(i = 0; i < cuối - đầu && đang cắt; i++) {
        nếu (cấu hình là khoảng trắng(s[cuối - 1])) {
            cuối = cuối - 1;
        } hoặc {
            đang cắt = sai;
        };
    };
    trả về cắt chuỗi(s, đầu, cuối - đầu);
};

// Trả {"khóa", "giá trị"} hoặc rỗng nếu dòng trống/comment/không có '='.
hàm riêng tư cấu hình phân tích dòng(dòng) {
    dòng = cấu hình cắt khoảng trắng(dòng);
    nếu (dòng == "") {
        trả về rỗng;
    };
    nếu (dòng[0] == "#") {
        trả về rỗng;
    };

    vị trí = -1;
    lặp(i = 0; i < máy ảo lấy độ dài(dòng) && vị trí < 0; i++) {
        nếu (dòng[i] == "=") {
            vị trí = i;
        };
    };
    nếu (vị trí < 0) {
        trả về rỗng;
    };

    khóa = cấu hình cắt khoảng trắng(cắt chuỗi(dòng, 0, vị trí));
    nếu (khóa == "") {
        trả về rỗng;
    };
    giá trị = cấu hình cắt khoảng trắng(
        cắt chuỗi(dòng, vị trí + 1, máy ảo lấy độ dài(dòng) - vị trí - 1)
    );
    trả về {"khóa": khóa, "giá trị": giá trị};
};

hàm riêng tư cấu hình là chữ số(c) {
    trả về c >= "0" && c <= "9";
};

hàm riêng tư cấu hình là số nguyên(s) {
    n = máy ảo lấy độ dài(s);
    nếu (n == 0) { trả về sai; };
    i = 0;
    nếu (s[0] == "+" || s[0] == "-") { i = 1; };
    nếu (i >= n) { trả về sai; };
    hợp lệ = đúng;
    lặp(vòng = 0; i < n && hợp lệ; vòng++) {
        nếu (!cấu hình là chữ số(s[i])) {
            hợp lệ = sai;
        };
        i = i + 1;
    };
    trả về hợp lệ;
};

// Decimal/exponent parser đủ cho cú pháp mà native std::stod trước đây nhận
// trong file cấu hình: 2.5, .5, 5., 1e3, -2.5E-4.
hàm riêng tư cấu hình là số thực(s) {
    n = máy ảo lấy độ dài(s);
    nếu (n == 0) { trả về sai; };
    i = 0;
    nếu (s[0] == "+" || s[0] == "-") { i = 1; };
    nếu (i >= n) { trả về sai; };

    có chữ số = sai;
    có chấm = sai;
    có mũ = sai;
    chữ số sau mũ = đúng;
    hợp lệ = đúng;

    lặp(vòng = 0; i < n && hợp lệ; vòng++) {
        c = s[i];
        nếu (cấu hình là chữ số(c)) {
            có chữ số = đúng;
            nếu (có mũ) { chữ số sau mũ = đúng; };
        } hoặc {
            nếu (c == "." && !có chấm && !có mũ) {
                có chấm = đúng;
            } hoặc {
                nếu ((c == "e" || c == "E") && !có mũ && có chữ số) {
                    có mũ = đúng;
                    chữ số sau mũ = sai;
                    nếu (i + 1 < n) {
                        nếu (s[i + 1] == "+" || s[i + 1] == "-") {
                            i = i + 1;
                        };
                    };
                } hoặc {
                    hợp lệ = sai;
                };
            };
        };
        i = i + 1;
    };
    trả về hợp lệ && có chữ số && (có chấm || có mũ) && chữ số sau mũ;
};

hàm riêng tư cấu hình chuyển giá trị(s) {
    nếu (s == "đúng") { trả về đúng; };
    nếu (s == "sai") { trả về sai; };
    nếu (s == "rỗng") { trả về rỗng; };
    nếu (cấu hình là số nguyên(s)) { trả về thành số nguyên(s); };
    nếu (cấu hình là số thực(s)) { trả về thành số thực(s); };
    trả về s;
};

hàm công khai đọc cấu hình(đường dẫn) {
    nội dung = đọc tệp(đường dẫn);
    kết quả = {};
    dòng = "";
    n = máy ảo lấy độ dài(nội dung);

    lặp(i = 0; i <= n; i++) {
        hết = i == n;
        c = "\n";
        nếu (!hết) { c = nội dung[i]; };

        nếu (c == "\n") {
            mục = cấu hình phân tích dòng(dòng);
            nếu (mục != rỗng) {
                khóa = lấy từ điển(mục, "khóa", "");
                giá trị = lấy từ điển(mục, "giá trị", "");
                đặt từ điển(kết quả, khóa, cấu hình chuyển giá trị(giá trị));
            };
            dòng = "";
        } hoặc {
            dòng = dòng + c;
        };
    };
    trả về kết quả;
};

hàm công khai đọc cấu hình khóa(đường dẫn, khóa, giá trị mặc định) {
    // Giữ contract cũ: tệp không tồn tại trả fallback thay vì ném lỗi đọc tệp.
    nếu (!đường dẫn tồn tại(đường dẫn)) {
        trả về giá trị mặc định;
    };

    nội dung = đọc tệp(đường dẫn);
    dòng = "";
    n = máy ảo lấy độ dài(nội dung);
    kết quả = giá trị mặc định;
    tìm thấy = sai;

    lặp(i = 0; i <= n && !tìm thấy; i++) {
        hết = i == n;
        c = "\n";
        nếu (!hết) { c = nội dung[i]; };

        nếu (c == "\n") {
            mục = cấu hình phân tích dòng(dòng);
            nếu (mục != rỗng) {
                nếu (lấy từ điển(mục, "khóa", "") == khóa) {
                    kết quả = lấy từ điển(mục, "giá trị", "");
                    tìm thấy = đúng;
                };
            };
            dòng = "";
        } hoặc {
            dòng = dòng + c;
        };
    };
    trả về kết quả;
};
