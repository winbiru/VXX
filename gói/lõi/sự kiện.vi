
nhập gói/lõi/chuyển kiểu;
nhập gói/bộ sưu tập/từ điển;
// Lớp sở hữu toàn bộ thuật toán của mô-đun; các hàm bên dưới chỉ giữ API cũ.
lớp công khai Hạ Tầng Sự Kiện {
    hàm công khai khởi tạo() {};

    // Module: lõi.sự kiện
    // Event emitter đồng bộ, bounded, snapshot-based.
    // Service loader thủ công giữ registry/lazy/lifecycle ở V++; discovery từ
    // module manifest và capability isolation vẫn là boundary runtime sau này.
    hàm riêng tư sự kiện yêu cầu bộ phát(emitter) {
        nếu (loại của(emitter) != "từ điển") {
            ném "LISTENER_STATE";
        };
        nếu (lấy từ điển(emitter, "__vpp_event_emitter__", 0) != 1) {
            ném "LISTENER_STATE";
        };
        trả về đúng;
    };

    hàm riêng tư sự kiện yêu cầu đăng ký(đăng ký) {
        nếu (loại của(đăng ký) != "từ điển") {
            ném "LISTENER_STATE";
        };
        nếu (lấy từ điển(đăng ký, "__vpp_event_registration__", 0) != 1) {
            ném "LISTENER_STATE";
        };
        trả về đúng;
    };

    hàm công khai bộ phát sự kiện(mức trần bộ lắng nghe = 1024, chính sách lỗi = "ném đầu") {
        nếu (loại của(mức trần bộ lắng nghe) != "số nguyên") {
            ném "LISTENER_STATE";
        };
        nếu (mức trần bộ lắng nghe <= 0) {
            ném "LISTENER_STATE";
        };
        nếu (chính sách lỗi != "ném đầu" && chính sách lỗi != "thu thập") {
            ném "LISTENER_STATE";
        };

        trả về {
            "__vpp_event_emitter__": 1,
            "giới hạn": mức trần bộ lắng nghe,
            "chính sách lỗi": chính sách lỗi,
            "đăng ký": [],
            "id kế tiếp": 1
        };
    };

    hàm công khai tạo sự kiện(nguồn, nội dung đệm, siêu dữ liệu = rỗng) {
        siêu dữ liệu = siêu dữ liệu;
        nếu (siêu dữ liệu == rỗng) {
            siêu dữ liệu = {};
        } hoặc {
            nếu (loại của(siêu dữ liệu) != "từ điển") {
                ném "LISTENER_STATE";
            };
        };
        trả về {
            "__vpp_event__": 1,
            "nguồn": nguồn,
            "payload": nội dung đệm,
            "metadata": siêu dữ liệu
        };
    };

    // Loại registration đã hủy/một-lần khỏi emitter. Registration object trả cho
    // caller vẫn tồn tại và giữ trạng thái inactive của chính nó.
    hàm riêng tư sự kiện gom đăng ký(emitter) {
        mình.sự kiện yêu cầu bộ phát(emitter);
        hiện tại = lấy từ điển(emitter, "đăng ký", []);
        đang hoạt động = [];
        lặp(i = 0; i < máy ảo lấy độ dài(hiện tại); i++) {
            thanh ghi = hiện tại[i];
            nếu (loại của(thanh ghi) == "từ điển") {
                nếu (lấy từ điển(thanh ghi, "__vpp_event_registration__", 0) == 1) {
                    nếu (lấy từ điển(thanh ghi, "hoạt động", 0) == 1) {
                        máy ảo thêm cuối danh sách(đang hoạt động, thanh ghi);
                    };
                };
            };
        };
        đặt từ điển(emitter, "đăng ký", đang hoạt động);
        trả về đang hoạt động;
    };

    hàm công khai số bộ lắng nghe(emitter) {
        đang hoạt động = mình.sự kiện gom đăng ký(emitter);
        trả về máy ảo lấy độ dài(đang hoạt động);
    };

    hàm công khai đăng ký sự kiện(emitter, bộ lắng nghe, một lần = sai) {
        mình.sự kiện yêu cầu bộ phát(emitter);
        nếu (bộ lắng nghe == rỗng) {
            ném "LISTENER_STATE";
        };

        hiện tại = mình.sự kiện gom đăng ký(emitter);
        mức trần = lấy từ điển(emitter, "giới hạn", 1024);
        nếu (máy ảo lấy độ dài(hiện tại) >= mức trần) {
            ném "LISTENER_LIMIT";
        };

        mã định danh = lấy từ điển(emitter, "id kế tiếp", 1);
        đặt từ điển(emitter, "id kế tiếp", mã định danh + 1);
        thanh ghi = {
            "__vpp_event_registration__": 1,
            "id": mã định danh,
            "listener": bộ lắng nghe,
            "một lần": một lần,
            "hoạt động": 1
        };
        máy ảo thêm cuối danh sách(hiện tại, thanh ghi);
        trả về thanh ghi;
    };

    // Idempotent: trả đúng nếu lời gọi này chuyển active -> inactive, sai nếu đã hủy.
    hàm công khai hủy đăng ký(đăng ký) {
        mình.sự kiện yêu cầu đăng ký(đăng ký);
        nếu (lấy từ điển(đăng ký, "hoạt động", 0) != 1) {
            trả về sai;
        };
        đặt từ điển(đăng ký, "hoạt động", 0);
        trả về đúng;
    };

    // Snapshot copy chỉ giữ dữ liệu cần cho dispatch. Vì vậy callback đăng ký/hủy
    // listener chỉ ảnh hưởng lần phát kế tiếp; listener đã có trong snapshot vẫn
    // được gọi trong lần phát hiện tại.
    hàm riêng tư sự kiện snapshot(emitter) {
        hiện tại = mình.sự kiện gom đăng ký(emitter);
        snapshot = [];
        lặp(i = 0; i < máy ảo lấy độ dài(hiện tại); i++) {
            thanh ghi = hiện tại[i];
            máy ảo thêm cuối danh sách(snapshot, {
                "listener": lấy từ điển(thanh ghi, "listener", rỗng),
                "một lần": lấy từ điển(thanh ghi, "một lần", sai),
                "registration": thanh ghi
            });
        };
        trả về snapshot;
    };

    hàm công khai phát sự kiện(emitter, sự kiện) {
        mình.sự kiện yêu cầu bộ phát(emitter);
        snapshot = mình.sự kiện snapshot(emitter);
        chính sách = lấy từ điển(emitter, "chính sách lỗi", "ném đầu");
        lỗi = [];
        đã gọi = 0;

        lặp(i = 0; i < máy ảo lấy độ dài(snapshot); i++) {
            mục = snapshot[i];
            bộ lắng nghe = lấy từ điển(mục, "listener", rỗng);
            thanh ghi = lấy từ điển(mục, "registration", rỗng);

            // Mark trước callback để reentrant emit vẫn đảm bảo at-most-once.
            nếu (lấy từ điển(mục, "một lần", sai)) {
                đặt từ điển(thanh ghi, "hoạt động", 0);
            };

            đã gọi += 1;
            nếu (chính sách == "thu thập") {
                thử {
                    bộ lắng nghe(sự kiện);
                } bắt lỗi (e) {
                    máy ảo thêm cuối danh sách(lỗi, e);
                };
            } hoặc {
                bộ lắng nghe(sự kiện);
            };
        };

        mình.sự kiện gom đăng ký(emitter);
        trả về {"đã gọi": đã gọi, "lỗi": lỗi};
    };

    // --- Service/provider registry thuần V++ ---
    hàm riêng tư dịch vụ yêu cầu bộ nạp(bộ nạp) {
        nếu (loại của(bộ nạp) != "từ điển") {
            ném "SERVICE_CONFIGURATION";
        };
        nếu (lấy từ điển(bộ nạp, "__vpp_service_loader__", 0) != 1) {
            ném "SERVICE_CONFIGURATION";
        };
        trả về bộ nạp;
    };

    hàm riêng tư dịch vụ yêu cầu nhà cung cấp(nhà cung cấp) {
        nếu (loại của(nhà cung cấp) != "từ điển") {
            ném "SERVICE_CONFIGURATION";
        };
        nếu (lấy từ điển(nhà cung cấp, "__vpp_service_provider__", 0) != 1) {
            ném "SERVICE_CONFIGURATION";
        };
        trả về nhà cung cấp;
    };

    hàm công khai bộ nạp dịch vụ(mức trần nhà cung cấp = 1024) {
        nếu (loại của(mức trần nhà cung cấp) != "số nguyên") {
            ném "SERVICE_CONFIGURATION";
        };
        nếu (mức trần nhà cung cấp <= 0) {
            ném "SERVICE_CONFIGURATION";
        };
        trả về {
            "__vpp_service_loader__": 1,
            "giới hạn": mức trần nhà cung cấp,
            "providers": []
        };
    };

    hàm công khai nhà cung cấp dịch vụ(
        mã định danh giao diện,
        triển khai mã định danh,
        bộ tạo,
        phiên bản = "0",
        mô đun mã định danh = "",
        capabilities = rỗng,
        vòng đời = "mỗi lần",
        validator = rỗng
    ) {
        nếu (loại của(mã định danh giao diện) != "chuỗi") {
            ném "SERVICE_CONFIGURATION";
        };
        nếu (máy ảo lấy độ dài(mã định danh giao diện) == 0) {
            ném "SERVICE_CONFIGURATION";
        };
        nếu (loại của(triển khai mã định danh) != "chuỗi") {
            ném "SERVICE_CONFIGURATION";
        };
        nếu (máy ảo lấy độ dài(triển khai mã định danh) == 0) {
            ném "SERVICE_CONFIGURATION";
        };
        nếu (loại của(phiên bản) != "chuỗi" || loại của(mô đun mã định danh) != "chuỗi") {
            ném "SERVICE_CONFIGURATION";
        };
        nếu (bộ tạo == rỗng) {
            ném "SERVICE_CONFIGURATION";
        };
        nếu (vòng đời != "mỗi lần" && vòng đời != "đơn thể") {
            ném "SERVICE_CONFIGURATION";
        };

        quyền = [];
        nếu (capabilities != rỗng) {
            nếu (loại của(capabilities) != "danh sách") {
                ném "SERVICE_CONFIGURATION";
            };
            lặp(i = 0; i < máy ảo lấy độ dài(capabilities); i++) {
                nếu (loại của(capabilities[i]) != "chuỗi") {
                    ném "SERVICE_CONFIGURATION";
                };
                máy ảo thêm cuối danh sách(quyền, capabilities[i]);
            };
        };

        trả về {
            "__vpp_service_provider__": 1,
            "interface_id": mã định danh giao diện,
            "implementation_id": triển khai mã định danh,
            "version": phiên bản,
            "module_id": mô đun mã định danh,
            "capabilities": quyền,
            "factory": bộ tạo,
            "validator": validator,
            "lifecycle": vòng đời,
            "đã tạo": 0,
            "instance": rỗng
        };
    };

    hàm công khai đăng ký nhà cung cấp(bộ nạp, nhà cung cấp) {
        mình.dịch vụ yêu cầu bộ nạp(bộ nạp);
        mình.dịch vụ yêu cầu nhà cung cấp(nhà cung cấp);
        danh sách = lấy từ điển(bộ nạp, "providers", []);
        mức trần = lấy từ điển(bộ nạp, "giới hạn", 1024);
        nếu (máy ảo lấy độ dài(danh sách) >= mức trần) {
            ném "SERVICE_CONFIGURATION";
        };

        mã định danh giao diện = lấy từ điển(nhà cung cấp, "interface_id", "");
        triển khai mã định danh = lấy từ điển(nhà cung cấp, "implementation_id", "");
        mô đun mã định danh = lấy từ điển(nhà cung cấp, "module_id", "");
        lặp(i = 0; i < máy ảo lấy độ dài(danh sách); i++) {
            hiện tại = danh sách[i];
            nếu (lấy từ điển(hiện tại, "interface_id", "") == mã định danh giao diện &&
                lấy từ điển(hiện tại, "implementation_id", "") == triển khai mã định danh &&
                lấy từ điển(hiện tại, "module_id", "") == mô đun mã định danh) {
                ném "SERVICE_CONFIGURATION";
            };
        };
        máy ảo thêm cuối danh sách(danh sách, nhà cung cấp);
        trả về nhà cung cấp;
    };

    hàm công khai dịch vụ(mã định danh giao diện, bộ nạp) {
        mình.dịch vụ yêu cầu bộ nạp(bộ nạp);
        nếu (loại của(mã định danh giao diện) != "chuỗi") {
            ném "SERVICE_CONFIGURATION";
        };
        nếu (máy ảo lấy độ dài(mã định danh giao diện) == 0) {
            ném "SERVICE_CONFIGURATION";
        };

        kết quả = [];
        danh sách = lấy từ điển(bộ nạp, "providers", []);
        lặp(i = 0; i < máy ảo lấy độ dài(danh sách); i++) {
            nhà cung cấp = danh sách[i];
            nếu (lấy từ điển(nhà cung cấp, "interface_id", "") == mã định danh giao diện) {
                máy ảo thêm cuối danh sách(kết quả, nhà cung cấp);
            };
        };
        nếu (máy ảo lấy độ dài(kết quả) == 0) {
            ném "SERVICE_NOT_FOUND";
        };
        trả về kết quả;
    };

    hàm công khai tải dịch vụ(nhà cung cấp) {
        mình.dịch vụ yêu cầu nhà cung cấp(nhà cung cấp);
        vòng đời = lấy từ điển(nhà cung cấp, "lifecycle", "mỗi lần");
        nếu (vòng đời == "đơn thể" && lấy từ điển(nhà cung cấp, "đã tạo", 0) == 1) {
            trả về lấy từ điển(nhà cung cấp, "instance", rỗng);
        };

        bộ tạo = lấy từ điển(nhà cung cấp, "factory", rỗng);
        thử {
            thể hiện = bộ tạo();
        } bắt lỗi (e) {
            ném "SERVICE_CONFIGURATION";
        };

        validator = lấy từ điển(nhà cung cấp, "validator", rỗng);
        nếu (validator != rỗng) {
            thử {
                hợp lệ = validator(thể hiện);
            } bắt lỗi (e) {
                ném "SERVICE_CONFIGURATION";
            };
            nếu (!hợp lệ) {
                ném "SERVICE_CONFIGURATION";
            };
        };

        nếu (vòng đời == "đơn thể") {
            đặt từ điển(nhà cung cấp, "instance", thể hiện);
            đặt từ điển(nhà cung cấp, "đã tạo", 1);
        };
        trả về thể hiện;
    };
};


hàm công khai bộ phát sự kiện(mức trần bộ lắng nghe = 1024, chính sách lỗi = "ném đầu") {
    bộ chuyển tiếp = Hạ Tầng Sự Kiện();
    trả về bộ chuyển tiếp.bộ phát sự kiện(mức trần bộ lắng nghe, chính sách lỗi);
};

hàm công khai tạo sự kiện(nguồn, nội dung đệm, siêu dữ liệu = rỗng) {
    bộ chuyển tiếp = Hạ Tầng Sự Kiện();
    trả về bộ chuyển tiếp.tạo sự kiện(nguồn, nội dung đệm, siêu dữ liệu);
};

hàm công khai số bộ lắng nghe(emitter) {
    bộ chuyển tiếp = Hạ Tầng Sự Kiện();
    trả về bộ chuyển tiếp.số bộ lắng nghe(emitter);
};

hàm công khai đăng ký sự kiện(emitter, bộ lắng nghe, một lần = sai) {
    bộ chuyển tiếp = Hạ Tầng Sự Kiện();
    trả về bộ chuyển tiếp.đăng ký sự kiện(emitter, bộ lắng nghe, một lần);
};

hàm công khai hủy đăng ký(đăng ký) {
    bộ chuyển tiếp = Hạ Tầng Sự Kiện();
    trả về bộ chuyển tiếp.hủy đăng ký(đăng ký);
};

hàm công khai phát sự kiện(emitter, sự kiện) {
    bộ chuyển tiếp = Hạ Tầng Sự Kiện();
    trả về bộ chuyển tiếp.phát sự kiện(emitter, sự kiện);
};

hàm công khai bộ nạp dịch vụ(mức trần nhà cung cấp = 1024) {
    bộ chuyển tiếp = Hạ Tầng Sự Kiện();
    trả về bộ chuyển tiếp.bộ nạp dịch vụ(mức trần nhà cung cấp);
};

hàm công khai nhà cung cấp dịch vụ(
    mã định danh giao diện,
    triển khai mã định danh,
    bộ tạo,
    phiên bản = "0",
    mô đun mã định danh = "",
    capabilities = rỗng,
    vòng đời = "mỗi lần",
    validator = rỗng
) {
    bộ chuyển tiếp = Hạ Tầng Sự Kiện();
    trả về bộ chuyển tiếp.nhà cung cấp dịch vụ(mã định danh giao diện, triển khai mã định danh, bộ tạo, phiên bản, mô đun mã định danh, capabilities, vòng đời, validator);
};

hàm công khai đăng ký nhà cung cấp(bộ nạp, nhà cung cấp) {
    bộ chuyển tiếp = Hạ Tầng Sự Kiện();
    trả về bộ chuyển tiếp.đăng ký nhà cung cấp(bộ nạp, nhà cung cấp);
};

hàm công khai dịch vụ(mã định danh giao diện, bộ nạp) {
    bộ chuyển tiếp = Hạ Tầng Sự Kiện();
    trả về bộ chuyển tiếp.dịch vụ(mã định danh giao diện, bộ nạp);
};

hàm công khai tải dịch vụ(nhà cung cấp) {
    bộ chuyển tiếp = Hạ Tầng Sự Kiện();
    trả về bộ chuyển tiếp.tải dịch vụ(nhà cung cấp);
};
