// vi.preferences — thiết lập bền vững theo người dùng/ứng dụng.
// Logic namespace/serialization/CRUD nằm ở V++. VM chỉ cung cấp các primitive
// môi trường, đường dẫn, file I/O và codec UTF-8.

nhập gói/hệ thống/môi trường;
nhập gói/hệ thống/nền tảng;
nhập gói/nhập xuất/tệp;
nhập gói/nhập xuất/đường dẫn;
nhập gói/nhập xuất/thư mục;
nhập gói/bộ sưu tập/từ điển;
nhập gói/lõi/chuyển kiểu;
nhập gói/văn bản/chuỗi;
nhập gói/văn bản/mã hóa tiện ích;
nhập gói/lõi/bảng mã;

// Hàm bền vững quản lý tệp; lớp Kho Tùy Chọn giữ namespace theo instance.
hàm riêng tư tùy chọn yêu cầu chuỗi(giá trị, nhãn) {
    nếu (loại của(giá trị) != "chuỗi") {
        ném "tùy chọn: " + nhãn + " phải là chuỗi";
    };
    trả về giá trị;
};

hàm riêng tư tùy chọn mã thập lục phân(văn bản) {
    trả về thập lục phân mã(mã hóa bảng mã(văn bản, "UTF-8"));
};

hàm riêng tư tùy chọn giải thập lục phân(văn bản) {
    thử {
        trả về giải mã bảng mã(thập lục phân giải(văn bản), "UTF-8");
    } bắt lỗi (e) {
        ném "tùy chọn: dữ liệu lưu không hợp lệ";
    };
};

hàm riêng tư tùy chọn thư mục gốc() {
    chỉ định = đọc biến môi trường("VPP_PREFERENCES_HOME", "");
    nếu (chỉ định != "") {
        trả về chỉ định;
    };

    nền tảng = tên nền tảng();
    nếu (nền tảng == "windows") {
        local = đọc biến môi trường("LOCALAPPDATA", "");
        nếu (local != "") {
            trả về đường dẫn nối(đường dẫn nối(local, "VPP"), "preferences");
        };
        thư mục nhà = đọc biến môi trường("USERPROFILE", "");
        nếu (thư mục nhà != "") {
            trả về đường dẫn nối(đường dẫn nối(thư mục nhà, ".vpp"), "preferences");
        };
    } hoặc {
        xdg = đọc biến môi trường("XDG_CONFIG_HOME", "");
        nếu (xdg != "") {
            trả về đường dẫn nối(đường dẫn nối(xdg, "vpp"), "preferences");
        };
        thư mục nhà = đọc biến môi trường("HOME", "");
        nếu (thư mục nhà != "") {
            trả về đường dẫn nối(
                đường dẫn nối(đường dẫn nối(thư mục nhà, ".config"), "vpp"),
                "preferences"
            );
        };
    };
    ném "tùy chọn: không xác định được thư mục cấu hình người dùng";
};

hàm riêng tư tùy chọn đường dẫn(không gian) {
    tùy chọn yêu cầu chuỗi(không gian, "không gian");
    nếu (không gian == "") {
        ném "tùy chọn: không gian không được rỗng";
    };
    gốc dữ liệu = tùy chọn thư mục gốc();
    tạo thư mục(gốc dữ liệu);
    trả về đường dẫn nối(gốc dữ liệu, tùy chọn mã thập lục phân(không gian) + ".prefs");
};

hàm riêng tư tùy chọn đọc dòng(dòng, kết quả) {
    nếu (dòng == "") {
        trả về rỗng;
    };
    vị trí = -1;
    lặp(i = 0; i < máy ảo lấy độ dài(dòng) && vị trí < 0; i++) {
        nếu (dòng[i] == "=") {
            vị trí = i;
        };
    };
    nếu (vị trí < 0) {
        ném "tùy chọn: dữ liệu lưu bị hỏng";
    };

    khóa thập lục phân = cắt chuỗi(dòng, 0, vị trí);
    giá trị thập lục phân = cắt chuỗi(dòng, vị trí + 1, máy ảo lấy độ dài(dòng) - vị trí - 1);
    khóa = tùy chọn giải thập lục phân(khóa thập lục phân);
    giá trị = tùy chọn giải thập lục phân(giá trị thập lục phân);
    đặt từ điển(kết quả, khóa, giá trị);
    trả về rỗng;
};

hàm riêng tư tùy chọn đọc tất cả(đường dẫn) {
    kết quả = {};
    nếu (!đường dẫn tồn tại(đường dẫn)) {
        trả về kết quả;
    };

    nội dung = đọc tệp(đường dẫn);
    dòng = "";
    n = máy ảo lấy độ dài(nội dung);
    lặp(i = 0; i <= n; i++) {
        hết = i == n;
        c = "\n";
        nếu (!hết) {
            c = nội dung[i];
        };
        nếu (c == "\n") {
            tùy chọn đọc dòng(dòng, kết quả);
            dòng = "";
        } hoặc {
            dòng = dòng + c;
        };
    };
    trả về kết quả;
};

hàm riêng tư tùy chọn ghi tất cả(đường dẫn, giá trị) {
    khóa = khóa từ điển(giá trị);
    nội dung = "";
    lặp(i = 0; i < máy ảo lấy độ dài(khóa); i++) {
        tên = khóa[i];
        nội dung = nội dung + tùy chọn mã thập lục phân(tên) + "=" +
            tùy chọn mã thập lục phân(lấy từ điển(giá trị, tên, "")) + "\n";
    };
    ghi tệp(đường dẫn, nội dung);
    trả về đúng;
};

hàm công khai tùy chọn đọc(không gian, khóa, giá trị mặc định) {
    tùy chọn yêu cầu chuỗi(khóa, "khóa");
    nếu (khóa == "") {
        ném "tùy chọn đọc: khóa không được rỗng";
    };
    dữ liệu = tùy chọn đọc tất cả(tùy chọn đường dẫn(không gian));
    trả về lấy từ điển(dữ liệu, khóa, giá trị mặc định);
};

hàm công khai tùy chọn lưu(không gian, khóa, giá trị) {
    tùy chọn yêu cầu chuỗi(khóa, "khóa");
    tùy chọn yêu cầu chuỗi(giá trị, "giá trị");
    nếu (khóa == "") {
        ném "tùy chọn lưu: khóa không được rỗng";
    };
    đường = tùy chọn đường dẫn(không gian);
    dữ liệu = tùy chọn đọc tất cả(đường);
    đặt từ điển(dữ liệu, khóa, giá trị);
    tùy chọn ghi tất cả(đường, dữ liệu);
    trả về đúng;
};

hàm công khai tùy chọn xóa(không gian, khóa) {
    tùy chọn yêu cầu chuỗi(khóa, "khóa");
    nếu (khóa == "") {
        ném "tùy chọn xóa: khóa không được rỗng";
    };
    đường = tùy chọn đường dẫn(không gian);
    dữ liệu = tùy chọn đọc tất cả(đường);
    nếu (!máy ảo có khóa từ điển(dữ liệu, khóa)) {
        trả về sai;
    };
    máy ảo xóa khóa từ điển(dữ liệu, khóa);
    tùy chọn ghi tất cả(đường, dữ liệu);
    trả về đúng;
};

hàm công khai tùy chọn khóa(không gian) {
    dữ liệu = tùy chọn đọc tất cả(tùy chọn đường dẫn(không gian));
    trả về khóa từ điển(dữ liệu);
};

hàm công khai tùy chọn xóa không gian(không gian) {
    đường = tùy chọn đường dẫn(không gian);
    nếu (!đường dẫn tồn tại(đường)) {
        trả về sai;
    };
    xóa đường dẫn(đường);
    trả về đúng;
};

// Giữ namespace theo instance, đọc lại tệp ở mỗi thao tác để không ghi đè
// thay đổi từ một instance khác cùng namespace bằng cache cũ.
lớp công khai Kho Tùy Chọn {
    hàm công khai khởi tạo(không gian) {
        tùy chọn yêu cầu chuỗi(không gian, "không gian");
        nếu (không gian == "") { ném "tùy chọn: không gian không được rỗng"; };
        mình.không gian = không gian;
    };
    hàm công khai đọc(khóa, mặc định = rỗng) { trả về tùy chọn đọc(mình.không gian, khóa, mặc định); };
    hàm công khai lưu(khóa, giá trị) { trả về tùy chọn lưu(mình.không gian, khóa, giá trị); };
    hàm công khai xóa(khóa) { trả về tùy chọn xóa(mình.không gian, khóa); };
    hàm công khai các khóa() { trả về tùy chọn khóa(mình.không gian); };
    hàm công khai xóa tất cả() { trả về tùy chọn xóa không gian(mình.không gian); };
};
