nhập gói.lõi.chuyển kiểu.loại của;
nhập gói.bộ sưu tập.từ điển.lấy từ điển;
nhập gói.bộ sưu tập.từ điển.đặt từ điển;
nhập gói.bộ sưu tập.danh sách.thêm;
nhập gói.bộ sưu tập.danh sách.tìm chỉ số;
nhập gói.bộ sưu tập.danh sách.sắp xếp;
// Lớp sở hữu toàn bộ thuật toán của mô-đun; các hàm bên dưới chỉ giữ API cũ.
lớp công khai Bộ Xử Lý Luồng {
    hàm công khai khởi tạo() {};

    // Module: lõi.luồng dữ liệu
    // Pipeline lazy/single-use trên source list/tuple hiện có của V++.
    // Representation dùng map nội bộ cho tới khi generic public type được khóa.
    hàm riêng tư luồng tạo tài nguyên() {
        trả về {
            "dọn dẹp": [],
            "đã dọn": sai
        };
    };

    hàm riêng tư luồng tạo nội bộ(nguồn, thao tác, tài nguyên = rỗng) {
        loại = loại của(nguồn);
        là bộ sinh = sai;
        nếu (loại == "từ điển") {
            là bộ sinh = lấy từ điển(nguồn, "__vpp_stream_generator__", 0) == 1;
        };
        nếu (loại != "danh sách" && loại != "tuple" && !là bộ sinh) {
            ném "STREAM_ARGUMENT";
        };
        nếu (tài nguyên == rỗng) {
            tài nguyên = mình.luồng tạo tài nguyên();
        };
        độ dài nguồn = -1;
        nếu (loại == "danh sách" || loại == "tuple") {
            độ dài nguồn = máy ảo lấy độ dài(nguồn);
        };
        trả về {
            "__vpp_stream__": 1,
            "nguồn": nguồn,
            "độ dài nguồn": độ dài nguồn,
            "thao tác": thao tác,
            "trạng thái": "mở",
            "tài nguyên": tài nguyên
        };
    };

    hàm công khai luồng(nguồn) {
        trả về mình.luồng tạo nội bộ(nguồn, []);
    };

    hàm công khai luồng rỗng() {
        trả về mình.luồng([]);
    };

    // Protocol pull-source thuần V++: callback tiếp() trả bước luồng(...) hoặc hết luồng().
    hàm công khai bước luồng(giá trị) {
        trả về {
            "__vpp_stream_step__": 1,
            "có": đúng,
            "giá trị": giá trị
        };
    };

    hàm công khai hết luồng() {
        trả về {
            "__vpp_stream_step__": 1,
            "có": sai
        };
    };

    hàm công khai luồng từ bộ sinh(tiếp, dọn dẹp = rỗng) {
        tài nguyên = mình.luồng tạo tài nguyên();
        nếu (dọn dẹp != rỗng) {
            danh sách = lấy từ điển(tài nguyên, "dọn dẹp", []);
            máy ảo thêm cuối danh sách(danh sách, dọn dẹp);
        };
        nguồn = {
            "__vpp_stream_generator__": 1,
            "tiếp": tiếp
        };
        trả về mình.luồng tạo nội bộ(nguồn, [], tài nguyên);
    };

    hàm riêng tư luồng yêu cầu mở(luồng) {
        nếu (loại của(luồng) != "từ điển") {
            ném "STREAM_ARGUMENT";
        };
        nếu (lấy từ điển(luồng, "__vpp_stream__", 0) != 1) {
            ném "STREAM_ARGUMENT";
        };
        nếu (lấy từ điển(luồng, "trạng thái", "") != "mở") {
            ném "STREAM_ALREADY_USED";
        };
        tài nguyên = lấy từ điển(luồng, "tài nguyên", rỗng);
        nếu (loại của(tài nguyên) != "từ điển" ||
            lấy từ điển(tài nguyên, "đã dọn", sai)) {
            ném "STREAM_ALREADY_USED";
        };
        trả về đúng;
    };

    hàm riêng tư luồng yêu cầu số lượng(n) {
        nếu (loại của(n) != "số nguyên" || n < 0) {
            ném "STREAM_ARGUMENT";
        };
        trả về n;
    };

    // Đăng ký callback đóng trên cùng resource-state của toàn pipeline.
    // Callback được gọi tối đa một lần, kể cả terminal thất bại.
    hàm công khai khi đóng luồng(luồng, dọn dẹp) {
        mình.luồng yêu cầu mở(luồng);
        tài nguyên = lấy từ điển(luồng, "tài nguyên", rỗng);
        danh sách = lấy từ điển(tài nguyên, "dọn dẹp", []);
        máy ảo thêm cuối danh sách(danh sách, dọn dẹp);
        trả về luồng;
    };

    hàm riêng tư luồng dọn dẹp(luồng) {
        tài nguyên = lấy từ điển(luồng, "tài nguyên", rỗng);
        nếu (loại của(tài nguyên) != "từ điển") {
            ném "STREAM_ARGUMENT";
        };
        nếu (lấy từ điển(tài nguyên, "đã dọn", sai)) {
            trả về rỗng;
        };

        // Đánh dấu trước callback để close đệ quy cũng không chạy lại cleanup.
        đặt từ điển(tài nguyên, "đã dọn", đúng);
        danh sách = lấy từ điển(tài nguyên, "dọn dẹp", []);
        lỗi đầu = rỗng;
        lặp(i = 0; i < máy ảo lấy độ dài(danh sách); i++) {
            dọn dẹp = danh sách[i];
            thử {
                dọn dẹp();
            } bắt lỗi (e) {
                nếu (lỗi đầu == rỗng) {
                    lỗi đầu = e;
                };
            };
        };
        nếu (lỗi đầu != rỗng) {
            ném lỗi đầu;
        };
        trả về rỗng;
    };

    hàm riêng tư luồng thêm thao tác(luồng, thao tác) {
        mình.luồng yêu cầu mở(luồng);
        đặt từ điển(luồng, "trạng thái", "liên kết");
        cũ = lấy từ điển(luồng, "thao tác", []);
        // Bản sao thao tác, tránh phụ thuộc ngầm vào module tuple.
        mới = [];
        lặp(i = 0; i < máy ảo lấy độ dài(cũ); i++) { máy ảo thêm cuối danh sách(mới, cũ[i]); };
        máy ảo thêm cuối danh sách(mới, thao tác);
        trả về mình.luồng tạo nội bộ(
            lấy từ điển(luồng, "nguồn", []),
            mới,
            lấy từ điển(luồng, "tài nguyên", rỗng)
        );
    };

    hàm công khai ánh xạ(luồng, chương trình con hiện tại) {
        trả về mình.luồng thêm thao tác(luồng, {"loại": "map", "hàm": chương trình con hiện tại});
    };

    hàm công khai lọc(luồng, biểu thức lọc) {
        trả về mình.luồng thêm thao tác(luồng, {"loại": "filter", "hàm": biểu thức lọc});
    };

    hàm công khai ánh xạ phẳng(luồng, chương trình con hiện tại) {
        trả về mình.luồng thêm thao tác(luồng, {"loại": "flatmap", "hàm": chương trình con hiện tại});
    };

    // Tên có hậu tố "luồng" để không xung đột hàm giới hạn(x,min,max) của toán học.
    hàm công khai giới hạn luồng(luồng, n) {
        mình.luồng yêu cầu số lượng(n);
        trả về mình.luồng thêm thao tác(luồng, {"loại": "limit", "n": n});
    };

    hàm công khai bỏ(luồng, n) {
        mình.luồng yêu cầu số lượng(n);
        trả về mình.luồng thêm thao tác(luồng, {"loại": "skip", "n": n});
    };

    hàm công khai phân biệt(luồng) {
        trả về mình.luồng thêm thao tác(luồng, {"loại": "distinct"});
    };

    hàm công khai sắp xếp luồng(luồng, số sánh = rỗng) {
        trả về mình.luồng thêm thao tác(luồng, {"loại": "sort", "hàm": số sánh});
    };

    hàm riêng tư luồng tạo trạng thái(thao tác) {
        trạng thái = [];
        lặp(i = 0; i < máy ảo lấy độ dài(thao tác); i++) {
            loại = lấy từ điển(thao tác[i], "loại", "");
            nếu (loại == "skip" || loại == "limit") {
                máy ảo thêm cuối danh sách(trạng thái, {"đếm": 0});
            } hoặc {
                nếu (loại == "distinct") {
                    máy ảo thêm cuối danh sách(trạng thái, {"đã thấy": []});
                } hoặc {
                    máy ảo thêm cuối danh sách(trạng thái, {});
                };
            };
        };
        trả về trạng thái;
    };

    // Đẩy một phần tử qua đoạn pipeline [vị_trí, kết_thúc).
    // Trả sai khi downstream đã đủ dữ liệu và caller phải dừng source.
    hàm riêng tư luồng đẩy(thao tác, trạng thái, vị trí, kết thúc, giá trị, đích dữ liệu) {
        nếu (vị trí >= kết thúc) {
            trả về đích dữ liệu(giá trị);
        };

        mã phép toán = thao tác[vị trí];
        loại = lấy từ điển(mã phép toán, "loại", "");

        nếu (loại == "map") {
            chương trình con hiện tại = lấy từ điển(mã phép toán, "hàm", rỗng);
            trả về mình.luồng đẩy(thao tác, trạng thái, vị trí + 1, kết thúc, chương trình con hiện tại(giá trị), đích dữ liệu);
        };

        nếu (loại == "filter") {
            chương trình con hiện tại = lấy từ điển(mã phép toán, "hàm", rỗng);
            nếu (!chương trình con hiện tại(giá trị)) {
                trả về đúng;
            };
            trả về mình.luồng đẩy(thao tác, trạng thái, vị trí + 1, kết thúc, giá trị, đích dữ liệu);
        };

        nếu (loại == "flatmap") {
            chương trình con hiện tại = lấy từ điển(mã phép toán, "hàm", rỗng);
            lồng = chương trình con hiện tại(giá trị);
            nếu (loại của(lồng) == "từ điển") {
                nếu (lấy từ điển(lồng, "__vpp_stream__", 0) == 1) {
                    lồng = mình.gom danh sách(lồng);
                };
            };
            kiểu lồng = loại của(lồng);
            nếu (kiểu lồng != "danh sách" && kiểu lồng != "tuple") {
                ném "STREAM_ARGUMENT";
            };
            tiếp tục = đúng;
            lặp(i = 0; i < máy ảo lấy độ dài(lồng) && tiếp tục; i++) {
                tiếp tục = mình.luồng đẩy(
                    thao tác, trạng thái, vị trí + 1, kết thúc, lồng[i], đích dữ liệu
                );
            };
            trả về tiếp tục;
        };

        nếu (loại == "skip") {
            trạng thái nội bộ = trạng thái[vị trí];
            đã đếm = lấy từ điển(trạng thái nội bộ, "đếm", 0);
            n = lấy từ điển(mã phép toán, "n", 0);
            nếu (đã đếm < n) {
                đặt từ điển(trạng thái nội bộ, "đếm", đã đếm + 1);
                trả về đúng;
            };
            trả về mình.luồng đẩy(thao tác, trạng thái, vị trí + 1, kết thúc, giá trị, đích dữ liệu);
        };

        nếu (loại == "limit") {
            trạng thái nội bộ = trạng thái[vị trí];
            đã đếm = lấy từ điển(trạng thái nội bộ, "đếm", 0);
            n = lấy từ điển(mã phép toán, "n", 0);
            nếu (đã đếm >= n) {
                trả về sai;
            };
            đặt từ điển(trạng thái nội bộ, "đếm", đã đếm + 1);
            trả về mình.luồng đẩy(thao tác, trạng thái, vị trí + 1, kết thúc, giá trị, đích dữ liệu);
        };

        nếu (loại == "distinct") {
            trạng thái nội bộ = trạng thái[vị trí];
            đã thấy = lấy từ điển(trạng thái nội bộ, "đã thấy", []);
            nếu (tìm chỉ số(đã thấy, giá trị) >= 0) {
                trả về đúng;
            };
            máy ảo thêm cuối danh sách(đã thấy, giá trị);
            trả về mình.luồng đẩy(thao tác, trạng thái, vị trí + 1, kết thúc, giá trị, đích dữ liệu);
        };

        nếu (loại == "sort") {
            ném "STREAM_INTERNAL_SORT_STAGE";
        };

        ném "STREAM_ARGUMENT";
    };

    hàm riêng tư luồng tìm sắp xếp(thao tác, bắt đầu) {
        vị trí = -1;
        lặp(i = bắt đầu; i < máy ảo lấy độ dài(thao tác) && vị trí < 0; i++) {
            nếu (lấy từ điển(thao tác[i], "loại", "") == "sort") {
                vị trí = i;
            };
        };
        trả về vị trí;
    };

    hàm riêng tư luồng sắp xếp vùng đệm(danh sách đầu vào, bộ so sánh) {
        n = máy ảo lấy độ dài(danh sách đầu vào);
        lặp(i = 0; i < n; i++) {
            lặp(j = 0; j + 1 < n - i; j++) {
                đổi = sai;
                nếu (bộ so sánh == rỗng) {
                    đổi = danh sách đầu vào[j] > danh sách đầu vào[j + 1];
                } hoặc {
                    đổi = bộ so sánh(danh sách đầu vào[j], danh sách đầu vào[j + 1]) > 0;
                };
                nếu (đổi) {
                    tạm = danh sách đầu vào[j];
                    danh sách đầu vào[j] = danh sách đầu vào[j + 1];
                    danh sách đầu vào[j + 1] = tạm;
                };
            };
        };
        trả về danh sách đầu vào;
    };

    hàm riêng tư luồng xác mình nguồn(luồng, nguồn, bắt đầu) {
        loại = loại của(nguồn);
        nếu (bắt đầu == 0 &&
            (loại == "danh sách" || loại == "tuple") &&
            máy ảo lấy độ dài(nguồn) != lấy từ điển(luồng, "độ dài nguồn", -1)) {
            ném "STREAM_SOURCE_MODIFIED";
        };
        trả về đúng;
    };

    hàm riêng tư luồng đoạn dừng ngày(thao tác, bắt đầu, kết thúc) {
        lặp(i = bắt đầu; i < kết thúc; i++) {
            nếu (lấy từ điển(thao tác[i], "loại", "") == "limit" &&
                lấy từ điển(thao tác[i], "n", -1) == 0) {
                trả về đúng;
            };
        };
        trả về sai;
    };

    hàm riêng tư luồng chạy đoạn nguồn(luồng, nguồn, thao tác, trạng thái,
                              bắt đầu, kết thúc, đích dữ liệu) {
        nếu (mình.luồng đoạn dừng ngày(thao tác, bắt đầu, kết thúc)) {
            trả về sai;
        };

        loại = loại của(nguồn);
        tiếp tục = đúng;
        nếu (loại == "danh sách" || loại == "tuple") {
            lặp(i = 0; i < máy ảo lấy độ dài(nguồn) && tiếp tục; i++) {
                mình.luồng xác mình nguồn(luồng, nguồn, bắt đầu);
                tiếp tục = mình.luồng đẩy(
                    thao tác, trạng thái, bắt đầu, kết thúc, nguồn[i], đích dữ liệu
                );
            };
            mình.luồng xác mình nguồn(luồng, nguồn, bắt đầu);
            trả về tiếp tục;
        };

        nếu (loại == "từ điển" &&
            lấy từ điển(nguồn, "__vpp_stream_generator__", 0) == 1) {
            tiếp = lấy từ điển(nguồn, "tiếp", rỗng);
            còn = đúng;
            khi (còn && tiếp tục) {
                bước = tiếp();
                nếu (loại của(bước) != "từ điển" ||
                    lấy từ điển(bước, "__vpp_stream_step__", 0) != 1) {
                    ném "STREAM_ARGUMENT";
                };
                còn = lấy từ điển(bước, "có", sai);
                nếu (còn) {
                    tiếp tục = mình.luồng đẩy(
                        thao tác,
                        trạng thái,
                        bắt đầu,
                        kết thúc,
                        lấy từ điển(bước, "giá trị", rỗng),
                        đích dữ liệu
                    );
                };
            };
            trả về tiếp tục;
        };

        ném "STREAM_ARGUMENT";
    };

    hàm riêng tư luồng chạy từ(luồng, nguồn, bắt đầu, đích dữ liệu) {
        thao tác = lấy từ điển(luồng, "thao tác", []);
        vị trí sắp xếp = mình.luồng tìm sắp xếp(thao tác, bắt đầu);
        kết thúc = máy ảo lấy độ dài(thao tác);
        nếu (vị trí sắp xếp >= 0) {
            kết thúc = vị trí sắp xếp;
        };

        trạng thái = mình.luồng tạo trạng thái(thao tác);
        nếu (vị trí sắp xếp < 0) {
            mình.luồng chạy đoạn nguồn(
                luồng, nguồn, thao tác, trạng thái, bắt đầu, kết thúc, đích dữ liệu
            );
            trả về rỗng;
        };

        vùng đệm = [];
        bộ nhận vùng đệm = hàm(x) {
            máy ảo thêm cuối danh sách(vùng đệm, x);
            trả về đúng;
        };
        mình.luồng chạy đoạn nguồn(
            luồng,
            nguồn,
            thao tác,
            trạng thái,
            bắt đầu,
            vị trí sắp xếp,
            bộ nhận vùng đệm
        );

        sắp xếp mã phép toán = thao tác[vị trí sắp xếp];
        bộ so sánh = lấy từ điển(sắp xếp mã phép toán, "hàm", rỗng);
        mình.luồng sắp xếp vùng đệm(vùng đệm, bộ so sánh);
        trả về mình.luồng chạy từ(luồng, vùng đệm, vị trí sắp xếp + 1, đích dữ liệu);
    };

    hàm riêng tư luồng bắt đầu terminal(luồng) {
        mình.luồng yêu cầu mở(luồng);
        nguồn = lấy từ điển(luồng, "nguồn", []);
        loại = loại của(nguồn);
        nếu (loại == "danh sách" || loại == "tuple") {
            nếu (máy ảo lấy độ dài(nguồn) != lấy từ điển(luồng, "độ dài nguồn", -1)) {
                đặt từ điển(luồng, "trạng thái", "đã dùng");
                ném "STREAM_SOURCE_MODIFIED";
            };
        };
        // Đánh dấu trước callback để reentrant terminal không thể dùng lại stream.
        đặt từ điển(luồng, "trạng thái", "đã dùng");
        trả về nguồn;
    };

    hàm riêng tư luồng terminal(luồng, xử lý) {
        nguồn = mình.luồng bắt đầu terminal(luồng);
        kết quả = rỗng;
        thử {
            kết quả = xử lý(nguồn);
        } bắt lỗi (e) {
            // Callback/pipeline error là lỗi chính; cleanup vẫn chạy đúng một lần.
            thử {
                mình.luồng dọn dẹp(luồng);
            } bắt lỗi (lỗi dọn) {
                // Giữ nguyên lỗi chính theo contract.
            };
            ném e;
        };
        mình.luồng dọn dẹp(luồng);
        trả về kết quả;
    };

    hàm công khai duyệt(luồng, bộ tiêu thụ) {
        xử lý = hàm(nguồn) {
            đích dữ liệu = hàm(x) {
                bộ tiêu thụ(x);
                trả về đúng;
            };
            mình.luồng chạy từ(luồng, nguồn, 0, đích dữ liệu);
            trả về rỗng;
        };
        trả về mình.luồng terminal(luồng, xử lý);
    };

    hàm công khai gom danh sách(luồng) {
        xử lý = hàm(nguồn) {
            kết quả = [];
            đích dữ liệu = hàm(x) {
                máy ảo thêm cuối danh sách(kết quả, x);
                trả về đúng;
            };
            mình.luồng chạy từ(luồng, nguồn, 0, đích dữ liệu);
            trả về kết quả;
        };
        trả về mình.luồng terminal(luồng, xử lý);
    };

    hàm công khai đếm luồng(luồng) {
        xử lý = hàm(nguồn) {
            đếm = 0;
            đích dữ liệu = hàm(x) {
                đếm += 1;
                trả về đúng;
            };
            mình.luồng chạy từ(luồng, nguồn, 0, đích dữ liệu);
            trả về đếm;
        };
        trả về mình.luồng terminal(luồng, xử lý);
    };

    hàm công khai bất kỳ(luồng, biểu thức lọc) {
        xử lý = hàm(nguồn) {
            kết quả = sai;
            đích dữ liệu = hàm(x) {
                nếu (biểu thức lọc(x)) {
                    kết quả = đúng;
                    trả về sai;
                };
                trả về đúng;
            };
            mình.luồng chạy từ(luồng, nguồn, 0, đích dữ liệu);
            trả về kết quả;
        };
        trả về mình.luồng terminal(luồng, xử lý);
    };

    hàm công khai tất cả luồng(luồng, biểu thức lọc) {
        xử lý = hàm(nguồn) {
            kết quả = đúng;
            đích dữ liệu = hàm(x) {
                nếu (!biểu thức lọc(x)) {
                    kết quả = sai;
                    trả về sai;
                };
                trả về đúng;
            };
            mình.luồng chạy từ(luồng, nguồn, 0, đích dữ liệu);
            trả về kết quả;
        };
        trả về mình.luồng terminal(luồng, xử lý);
    };

    hàm công khai đầu tiên(luồng) {
        xử lý = hàm(nguồn) {
            kết quả = rỗng;
            đích dữ liệu = hàm(x) {
                kết quả = x;
                trả về sai;
            };
            mình.luồng chạy từ(luồng, nguồn, 0, đích dữ liệu);
            trả về kết quả;
        };
        trả về mình.luồng terminal(luồng, xử lý);
    };

    hàm công khai rút gọn(luồng, giá trị đầu, bộ thu gọn) {
        xử lý = hàm(nguồn) {
            tích lũy = giá trị đầu;
            đích dữ liệu = hàm(x) {
                tích lũy = bộ thu gọn(tích lũy, x);
                trả về đúng;
            };
            mình.luồng chạy từ(luồng, nguồn, 0, đích dữ liệu);
            trả về tích lũy;
        };
        trả về mình.luồng terminal(luồng, xử lý);
    };

    hàm công khai đóng luồng(luồng) {
        nếu (loại của(luồng) != "từ điển") {
            ném "STREAM_ARGUMENT";
        };
        nếu (lấy từ điển(luồng, "__vpp_stream__", 0) != 1) {
            ném "STREAM_ARGUMENT";
        };
        nếu (lấy từ điển(luồng, "trạng thái", "") == "đóng") {
            trả về rỗng;
        };
        đặt từ điển(luồng, "trạng thái", "đóng");
        trả về mình.luồng dọn dẹp(luồng);
    };
};


hàm công khai luồng(nguồn) {
    bộ chuyển tiếp = Bộ Xử Lý Luồng();
    trả về bộ chuyển tiếp.luồng(nguồn);
};

