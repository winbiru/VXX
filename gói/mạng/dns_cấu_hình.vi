// Đọc DNS nameserver theo thứ tự bằng V++, không tra cứu DNS khi parse.
// Chỉ sử dụng cấu hình Linux khi caller yêu cầu rõ ràng.
nhập gói/mạng/ip;
nhập gói/mạng/dns_gói_tin;
nhập gói/nhập xuất/bộ đệm tệp;

lớp công khai Bộ Cấu Hình DNS {
    hàm công khai khởi tạo() {};

    hàm riêng tư dns trắng(k) {
        trả về k == 32 || k == 9 || k == 13 || k == 10;
    };

    hàm riêng tư dns trùng(danh_sách, địa_chỉ) {
        bộ = Bộ Phân Tích IP();
        mới = bộ.ip bytes(địa_chỉ);
        lặp(i = 0; i < do_dai(danh_sách); i++) {
            cũ = bộ.ip bytes(danh_sách[i]);
            nếu (do_dai(cũ) == do_dai(mới)) {
                giống = đúng;
                lặp(j = 0; j < do_dai(mới); j++) {
                    nếu (cũ[j] != mới[j]) { giống = sai; thoát; };
                };
                nếu (giống) { trả về đúng; };
            };
        };
        trả về sai;
    };

    // Không chấp nhận hostname, zone ID hoặc địa chỉ không hợp lệ.
    hàm riêng tư dns địa chỉ hợp lệ(địa_chỉ) {
        bytes = [];
        thử {
            bộ = Bộ Phân Tích IP();
            bytes = bộ.ip bytes(địa_chỉ);
        } bắt lỗi(e) { trả về sai; };
        trả về do_dai(bytes) == 4 || do_dai(bytes) == 16;
    };

    hàm riêng tư dns thêm máy chủ(danh_sách, địa_chỉ) {
        nếu (!mình.dns trùng(danh_sách, địa_chỉ)) {
            nếu (do_dai(danh_sách) >= 8) { ném "DNS: quá 8 nameserver"; };
            thêm(danh_sách, địa_chỉ);
        };
        trả về danh_sách;
    };

    // Tokenize riêng cho resolv.conf: # và ; mở đầu phần chú thích.
    hàm riêng tư dns dòng nameserver(dòng) {
        tokens = [];
        token = [];
        lặp(i = 0; i <= do_dai(dòng); i++) {
            k = 32;
            nếu (i < do_dai(dòng)) { k = dòng[i]; };
            nếu (k == 35 || k == 59) {
                nếu (do_dai(token) > 0) { thêm(tokens, chuoi_tu_bytes_vm(token)); };
                thoát;
            };
            nếu (mình.dns trắng(k)) {
                nếu (do_dai(token) > 0) {
                    thêm(tokens, chuoi_tu_bytes_vm(token));
                    token = [];
                };
            } hoặc {
                thêm(token, k);
            };
            nếu (do_dai(tokens) > 2) { thoát; };
        };
        nếu (do_dai(tokens) != 2) { trả về ""; };
        nếu (tokens[0] != "nameserver") { trả về ""; };
        nếu (!mình.dns địa chỉ hợp lệ(tokens[1])) { trả về ""; };
        trả về tokens[1];
    };

    // Tách token cho search/domain/options; dấu # và ; bắt đầu comment.
    hàm riêng tư dns dòng tokens(dòng) {
        tokens = [];
        token = [];
        lặp(i = 0; i <= do_dai(dòng); i++) {
            k = 32;
            nếu (i < do_dai(dòng)) { k = dòng[i]; };
            nếu (k == 35 || k == 59) {
                nếu (do_dai(token) > 0) { thêm(tokens, chuoi_tu_bytes_vm(token)); };
                thoát;
            };
            nếu (mình.dns trắng(k)) {
                nếu (do_dai(token) > 0) {
                    thêm(tokens, chuoi_tu_bytes_vm(token));
                    token = [];
                };
            } hoặc {
                thêm(token, k);
            };
            nếu (do_dai(tokens) > 32) { ném "DNS: quá nhiều token trên dòng cấu hình"; };
        };
        trả về tokens;
    };

    // Domain trong search phải là DNS name hợp lệ, không giữ dấu chấm cuối.
    hàm riêng tư dns chuẩn domain(tên) {
        bytes = chuoi_bytes_vm(tên);
        n = do_dai(bytes);
        nếu (n > 0 && bytes[n - 1] == 46) { n = n - 1; };
        chuẩn = [];
        lặp(i = 0; i < n; i++) {
            k = bytes[i];
            nếu (k >= 65 && k <= 90) { k = k + 32; };
            thêm(chuẩn, k);
        };
        kết_quả = chuoi_tu_bytes_vm(chuẩn);
        bộ = Bộ Mã DNS();
        bộ.dns tạo truy vấn(kết_quả, 1, 0);
        trả về kết_quả;
    };

    hàm riêng tư dns ndots(token) {
        bytes = chuoi_bytes_vm(token);
        nếu (do_dai(bytes) < 6 || bytes[0] != 110 || bytes[1] != 100 ||
            bytes[2] != 111 || bytes[3] != 116 || bytes[4] != 115 ||
            bytes[5] != 58) {
            trả về -1;
        };
        nếu (do_dai(bytes) < 7 || do_dai(bytes) > 8) {
            ném "DNS: ndots không hợp lệ";
        };
        số = 0;
        lặp(i = 6; i < do_dai(bytes); i++) {
            nếu (bytes[i] < 48 || bytes[i] > 57) {
                ném "DNS: ndots không hợp lệ";
            };
            số = số * 10 + bytes[i] - 48;
        };
        nếu (số > 15) { ném "DNS: ndots phải từ 0 đến 15"; };
        trả về số;
    };

    // API mới giữ nguyên parser nameserver cũ, bổ sung cấu hình search.
    // Giới hạn 6 suffix và 256 bytes tổng để tránh khuếch đại truy vấn.
    hàm công khai dns phân tích cấu hình đầy đủ(nội_dung) {
        máy_chủ = mình.dns phân tích resolv conf(nội_dung);
        dữ_liệu = chuoi_bytes_vm(nội_dung);
        search = [];
        ndots = 1;
        dòng = [];
        lặp(i = 0; i <= do_dai(dữ_liệu); i++) {
            k = 10;
            nếu (i < do_dai(dữ_liệu)) { k = dữ_liệu[i]; };
            nếu (k == 10) {
                tokens = mình.dns dòng tokens(dòng);
                nếu (do_dai(tokens) > 0) {
                    nếu (tokens[0] == "search" || tokens[0] == "domain") {
                        search = [];
                        tổng = 0;
                        giới_hạn = do_dai(tokens);
                        nếu (tokens[0] == "domain" && giới_hạn > 2) { giới_hạn = 2; };
                        lặp(j = 1; j < giới_hạn; j++) {
                            hậu_tố = mình.dns chuẩn domain(tokens[j]);
                            trùng = sai;
                            lặp(m = 0; m < do_dai(search); m++) {
                                nếu (search[m] == hậu_tố) { trùng = đúng; thoát; };
                            };
                            nếu (!trùng) {
                                nếu (do_dai(search) >= 6 || tổng + do_dai(hậu_tố) > 256) {
                                    ném "DNS: danh sách search quá dài";
                                };
                                thêm(search, hậu_tố);
                                tổng = tổng + do_dai(hậu_tố);
                            };
                        };
                    } hoặc nếu (tokens[0] == "options") {
                        lặp(j = 1; j < do_dai(tokens); j++) {
                            giá_trị = mình.dns ndots(tokens[j]);
                            nếu (giá_trị >= 0) { ndots = giá_trị; };
                        };
                    };
                };
                dòng = [];
            } hoặc {
                thêm(dòng, k);
            };
        };
        trả về {"nameservers": máy_chủ, "search": search, "ndots": ndots};
    };

    // FQDN có dấu chấm cuối bỏ qua suffix. ndots quyết định thứ tự thử.
    hàm công khai dns tên ứng viên(tên_máy, search, ndots) {
        nếu (loai_cua(search) != "danh sách" || loai_cua(ndots) != "số nguyên" ||
            ndots < 0 || ndots > 15) { ném "DNS: cấu hình search không hợp lệ"; };
        bộ = Bộ Mã DNS();
        bộ.dns tạo truy vấn(tên_máy, 1, 0);
        bytes = chuoi_bytes_vm(tên_máy);
        n = do_dai(bytes);
        tuyệt_đối = n > 0 && bytes[n - 1] == 46;
        tên = tên_máy;
        nếu (tuyệt_đối) {
            phần = [];
            lặp(i = 0; i < n - 1; i++) { thêm(phần, bytes[i]); };
            tên = chuoi_tu_bytes_vm(phần);
        };
        số_chấm = 0;
        lặp(i = 0; i < do_dai(bytes); i++) {
            nếu (bytes[i] == 46) { số_chấm = số_chấm + 1; };
        };
        kết_quả = [];
        nếu (tuyệt_đối || số_chấm >= ndots) { thêm(kết_quả, tên); };
        nếu (!tuyệt_đối) {
            lặp(i = 0; i < do_dai(search); i++) {
                hậu_tố = mình.dns chuẩn domain(search[i]);
                thử_tên = tên + "." + hậu_tố;
                // Tên vượt giới hạn wire format không thể gửi truy vấn.
                nếu (do_dai(chuoi_bytes_vm(thử_tên)) <= 253) {
                    bộ.dns tạo truy vấn(thử_tên, 1, 0);
                    trùng = sai;
                    lặp(j = 0; j < do_dai(kết_quả); j++) {
                        nếu (kết_quả[j] == thử_tên) { trùng = đúng; thoát; };
                    };
                    nếu (!trùng) { thêm(kết_quả, thử_tên); };
                };
            };
            nếu (số_chấm < ndots) { thêm(kết_quả, tên); };
        };
        trả về kết_quả;
    };

    hàm công khai dns phân tích resolv conf(nội_dung) {
        nếu (loai_cua(nội_dung) != "chuỗi") { ném "DNS: cấu hình phải là chuỗi"; };
        dữ_liệu = chuoi_bytes_vm(nội_dung);
        nếu (do_dai(dữ_liệu) > 16384) { ném "DNS: tệp cấu hình quá lớn"; };
        máy_chủ = [];
        dòng = [];
        lặp(i = 0; i <= do_dai(dữ_liệu); i++) {
            k = 10;
            nếu (i < do_dai(dữ_liệu)) { k = dữ_liệu[i]; };
            nếu (k == 10) {
                địa_chỉ = mình.dns dòng nameserver(dòng);
                nếu (địa_chỉ != "") { máy_chủ = mình.dns thêm máy chủ(máy_chủ, địa_chỉ); };
                dòng = [];
            } hoặc {
                thêm(dòng, k);
            };
        };
        trả về máy_chủ;
    };

    // Đọc tối đa 16 KiB + 1 byte rồi đóng handle kể cả khi lỗi.
    hàm công khai dns đọc cấu hình linux(đường_dẫn = "/etc/resolv.conf") {
        tệp = Bộ Đệm Tệp(đường_dẫn, "đọc", 4096, "DNS resolv.conf");
        dữ_liệu = [];
        thử {
            dữ_liệu = tệp.đọc bytes(16385);
            tệp.đóng();
        } bắt lỗi(e) {
            thử { tệp.đóng(); } bắt lỗi(bỏ_qua) {};
            ném e;
        };
        nếu (do_dai(dữ_liệu) > 16384) { ném "DNS: tệp cấu hình quá lớn"; };
        trả về mình.dns phân tích resolv conf(chuoi_tu_bytes_vm(dữ_liệu));
    };

    hàm công khai dns đọc cấu hình đầy đủ linux(đường_dẫn = "/etc/resolv.conf") {
        tệp = Bộ Đệm Tệp(đường_dẫn, "đọc", 4096, "DNS resolv.conf");
        dữ_liệu = [];
        thử {
            dữ_liệu = tệp.đọc bytes(16385);
            tệp.đóng();
        } bắt lỗi(e) {
            thử { tệp.đóng(); } bắt lỗi(bỏ_qua) {};
            ném e;
        };
        nếu (do_dai(dữ_liệu) > 16384) { ném "DNS: tệp cấu hình quá lớn"; };
        trả về mình.dns phân tích cấu hình đầy đủ(chuoi_tu_bytes_vm(dữ_liệu));
    };

    // Cấu hình VPP_DNS_VI_SERVERS: danh sách IP cách nhau bởi dấu phẩy,
    // dấu chấm phẩy hoặc whitespace. Địa chỉ lỗi bị từ chối có chủ đích.
    hàm công khai dns phân tích danh sách máy chủ(nội_dung) {
        nếu (loai_cua(nội_dung) != "chuỗi") { ném "DNS: danh sách phải là chuỗi"; };
        dữ_liệu = chuoi_bytes_vm(nội_dung);
        nếu (do_dai(dữ_liệu) > 4096) { ném "DNS: danh sách quá dài"; };
        máy_chủ = [];
        token = [];
        lặp(i = 0; i <= do_dai(dữ_liệu); i++) {
            k = 32;
            nếu (i < do_dai(dữ_liệu)) { k = dữ_liệu[i]; };
            nếu (mình.dns trắng(k) || k == 44 || k == 59) {
                nếu (do_dai(token) > 0) {
                    ip = chuoi_tu_bytes_vm(token);
                    nếu (!mình.dns địa chỉ hợp lệ(ip)) { ném "DNS: địa chỉ nameserver không hợp lệ"; };
                    máy_chủ = mình.dns thêm máy chủ(máy_chủ, ip);
                    token = [];
                };
            } hoặc {
                thêm(token, k);
            };
        };
        trả về máy_chủ;
    };
};

hàm công khai dns phân tích resolv conf(nội_dung) {
    bộ = Bộ Cấu Hình DNS();
    trả về bộ.dns phân tích resolv conf(nội_dung);
};

hàm công khai dns phân tích cấu hình đầy đủ(nội_dung) {
    bộ = Bộ Cấu Hình DNS();
    trả về bộ.dns phân tích cấu hình đầy đủ(nội_dung);
};

hàm công khai dns tên ứng viên(tên_máy, search, ndots) {
    bộ = Bộ Cấu Hình DNS();
    trả về bộ.dns tên ứng viên(tên_máy, search, ndots);
};

hàm công khai dns đọc cấu hình đầy đủ linux(đường_dẫn = "/etc/resolv.conf") {
    bộ = Bộ Cấu Hình DNS();
    trả về bộ.dns đọc cấu hình đầy đủ linux(đường_dẫn);
};

hàm công khai dns đọc cấu hình linux(đường_dẫn = "/etc/resolv.conf") {
    bộ = Bộ Cấu Hình DNS();
    trả về bộ.dns đọc cấu hình linux(đường_dẫn);
};

hàm công khai dns phân tích danh sách máy chủ(nội_dung) {
    bộ = Bộ Cấu Hình DNS();
    trả về bộ.dns phân tích danh sách máy chủ(nội_dung);
};
