    bộ chuyển tiếp = Bộ Xử Lý URI();
    trả về bộ chuyển tiếp.định danh tài nguyên chuẩn hóa(giá trị đang xét);
};

hàm công khai định danh tài nguyên hợp nhất(base, tương đối) {
    bộ chuyển tiếp = Bộ Xử Lý URI();
    trả về bộ chuyển tiếp.định danh tài nguyên hợp nhất(base, tương đối);
};

hàm công khai mã hóa biểu mẫu(văn bản, bảng mã = "UTF-8") {
    bộ chuyển tiếp = Bộ Xử Lý URI();
    trả về bộ chuyển tiếp.mã hóa biểu mẫu(văn bản, bảng mã);
};

hàm công khai giải mã biểu mẫu(văn bản, bảng mã = "UTF-8") {
    bộ chuyển tiếp = Bộ Xử Lý URI();
    trả về bộ chuyển tiếp.giải mã biểu mẫu(văn bản, bảng mã);
};

