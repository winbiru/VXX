    __vpp_adapter = Bộ Điều Khiển Ổ Cắm();
    trả về __vpp_adapter.socket nhận(mã socket, số byte tối đa);
};

hàm công khai socket đặt timeout(mã socket, thời gian chờ) {
    __vpp_adapter = Bộ Điều Khiển Ổ Cắm();
    trả về __vpp_adapter.socket đặt timeout(mã socket, thời gian chờ);
};

