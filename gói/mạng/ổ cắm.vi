// vi.net.sockets — TCP/UDP cơ bản dựa trên socket của hệ điều hành.
// Các thao tác socket là primitive OS; wrapper công khai nằm ở V++.
// Handle socket là số nguyên do runtime quản lý; luôn đóng khi dùng xong.

nhập gói/lõi/chuyển kiểu;
nhập gói/hệ thống/môi trường;
nhập gói/mạng/địa chỉ mạng;
nhập gói/mạng/bảng tên máy;

// Resolver Machine ABI giữ getaddrinfo/addrinfo trong OS adapter và trả token
// sở hữu VM. Thuật toán chọn địa chỉ và xử lý lỗi vẫn nằm trong V++.

// TCP/UDP connect nhận IP bytes từ V++; TLS gọi provider native qua Machine ABI.

// Lớp sở hữu toàn bộ thuật toán của mô-đun; các hàm bên dưới chỉ giữ API cũ.
lớp công khai Bộ Điều Khiển Ổ Cắm {
    hàm công khai khởi tạo() {};

    // Token FFI nằm trong miền dành riêng, bao gồm phiên TLS POSIX.
    // Runtime xác nhận sở hữu token thật sự trước mọi lời gọi.
    hàm riêng tư đầu nối dùng ffi(mã) {
        trả về mã >= 536870912;
    };

    // Đường public ưu tiên V++ trên Windows; cờ 0 dành cho kiểm thử parity
    // và rollback đến khi có xác nhận thực thi từ Windows CI.
    hàm riêng tư đầu nối mở bằng ffi() {
        trả về ten nền tảng máy ảo() != "windows" ||
            đọc biến môi trường("VPP_WINDOWS_SOCKET_FFI", "1") != "0";
    };

    // Giữ thứ tự trả về của resolver; DNS public tự sort/deduplicate còn kết nối
    // TCP/UDP dùng thứ tự này để thử từng địa chỉ. Mọi nhánh đều đóng token.
    hàm công khai đầu nối bộ phân giải danh sách(tên máy, cổng, datagram) {
        // Địa chỉ số đã có parser trong V++; tránh đi qua getaddrinfo của C.
        // Chỉ nhận IPv4 thập phân chuẩn: libc có thể hiểu các số 0 đầu là
        // bát phân, nên dạng không chuẩn tiếp tục đi qua OS resolver.
        là địa chỉ mạng = sai;
        thử {
            các byte = mình.đầu nối địa chỉ mạng các byte(tên máy);
            nếu (máy ảo lấy độ dài(các byte) == 16) {
                là địa chỉ mạng = đúng;
            } hoặc {
                dạng chuẩn = thành chuỗi(các byte[0]) + "." + thành chuỗi(các byte[1]) +
                    "." + thành chuỗi(các byte[2]) + "." + thành chuỗi(các byte[3]);
                là địa chỉ mạng = tên máy == dạng chuẩn;
            };
        } bắt lỗi(số mục bỏ qua) {};
        nếu (là địa chỉ mạng && loại của(cổng) == "số nguyên" && cổng >= 0 && cổng <= 65535) {
            nếu (cổng == 0) { trả về [tên máy]; };
            trả về [[tên máy, cổng]];
        };
        // Tệp hosts đã cấu hình: đọc bằng V++ qua File Machine ABI, không
        // cần OS getaddrinfo và không cấp token resolver FFI khi tìm thấy tên.
        đường bảng tên máy = đọc biến môi trường("VPP_DNS_VI_HOSTS_FILE", "");
        nếu (đường bảng tên máy != "" && loại của(cổng) == "số nguyên" &&
            cổng >= 0 && cổng <= 65535) {
            bảng tên máy = Bộ Bảng Tên Máy DNS();
            địa chỉ bảng tên máy = bảng tên máy.phân giải tên miền đọc bảng tên máy(tên máy, đường bảng tên máy);
            nếu (máy ảo lấy độ dài(địa chỉ bảng tên máy) > 0) {
                kết quả bảng tên máy = [];
                lặp(i = 0; i < máy ảo lấy độ dài(địa chỉ bảng tên máy); i++) {
                    nếu (cổng == 0) {
                        máy ảo thêm cuối danh sách(kết quả bảng tên máy, địa chỉ bảng tên máy[i]);
                    } hoặc {
                        máy ảo thêm cuối danh sách(kết quả bảng tên máy, [địa chỉ bảng tên máy[i], cổng]);
                    };
                };
                trả về kết quả bảng tên máy;
            };
        };
        // Chế độ chặn resolver libc để ứng dụng có thể kiểm chứng đường
        // .vi -> Machine ABI: chỉ nhận IP số hoặc hostname từ hosts V++.
        // Cấu hình mặc định vẫn dùng OS resolver để giữ tương thích.
        nếu (đọc biến môi trường("VPP_SOCKET_VI_ONLY", "0") == "1") {
            ném "socket resolver: tên máy không có trong hosts V++ (chế độ VI_ONLY)";
        };
        dịch vụ = "";
        nếu (cổng != 0) { dịch vụ = thành chuỗi(cổng); };
        giao vận gói tin = 0;
        nếu (datagram) { giao vận gói tin = 1; };
        mã bộ phân giải = máy bộ phân giải mở(tên máy, dịch vụ, giao vận gói tin);
        kết quả = [];
        thử {
            lặp(i = 0; i < 16384; i++) {
                địa chỉ = máy bộ phân giải tiếp(mã bộ phân giải);
                nếu (địa chỉ == rỗng) { thoát; };
                nếu (cổng == 0) {
                    máy ảo thêm cuối danh sách(kết quả, địa chỉ);
                } hoặc {
                    máy ảo thêm cuối danh sách(kết quả, [địa chỉ, cổng]);
                };
            };
            nếu (i == 16384) { ném "resolver: quá nhiều địa chỉ"; };
            máy bộ phân giải đóng(mã bộ phân giải);
        } bắt lỗi(e) {
            thử { máy bộ phân giải đóng(mã bộ phân giải); } bắt lỗi(số mục bỏ qua) {};
            ném e;
        };
        trả về kết quả;
    };

    hàm công khai đầu nối yêu cầu tên máy(giá trị, tên hàm) {
        nếu (loại của(giá trị) != "chuỗi") {
            ném tên hàm + ": tên máy phải là chuỗi";
        };
        nếu (máy ảo lấy độ dài(giá trị) == 0) {
            ném tên hàm + ": tên máy không được rỗng";
        };
        trả về giá trị;
    };

    hàm riêng tư đầu nối yêu cầu số nguyên(giá trị, tên hàm, nhãn) {
        thử {
            trả về thành số nguyên(giá trị);
        } bắt lỗi (e) {
            ném tên hàm + ": " + nhãn + " không hợp lệ";
        };
    };

    hàm công khai đầu nối yêu cầu cổng(giá trị, tên hàm) {
        cổng = mình.đầu nối yêu cầu số nguyên(giá trị, tên hàm, "cổng");
        nếu (cổng <= 0 || cổng > 65535) {
            ném tên hàm + ": cổng phải trong 1..65535";
        };
        trả về cổng;
    };

    hàm công khai đầu nối yêu cầu thời gian chờ(giá trị, tên hàm) {
        thời gian chờ = mình.đầu nối yêu cầu số nguyên(giá trị, tên hàm, "thời gian chờ");
        nếu (thời gian chờ <= 0 || thời gian chờ > 300000) {
            ném tên hàm + ": thời gian chờ phải trong 1..300000 ms";
        };
        trả về thời gian chờ;
    };

    hàm riêng tư đầu nối yêu cầu mã(giá trị, tên hàm, nhãn) {
        mã = mình.đầu nối yêu cầu số nguyên(giá trị, tên hàm, nhãn);
        nếu (mã <= 0) {
            ném tên hàm + ": " + nhãn + " không hợp lệ";
        };
        trả về mã;
    };

    // Gói IP độc lập cũng được DNS Hosts dùng; giữ nguyên API socket.
    hàm công khai đầu nối địa chỉ mạng các byte(địa chỉ mạng) {
        bộ = Bộ Phân Tích IP();
        trả về bộ.địa chỉ mạng các byte(địa chỉ mạng);
    };

    hàm công khai đầu nối mở kết nối(tên máy, cổng, thời gian chờ, là datagram, tên hàm, dùng tls cũ = sai) {
        địa chỉ = [];
        thử {
            // Giữ thứ tự resolver, không dùng danh sách DNS đã sort/deduplicate.
            địa chỉ = mình.đầu nối bộ phân giải danh sách(tên máy, cổng, là datagram);
        } bắt lỗi (e) {
            ném tên hàm + ": " + e;
        };
        lỗi cuối = "không có địa chỉ kết nối";
        lặp(i = 0; i < máy ảo lấy độ dài(địa chỉ); i++) {
            thử {
                mã = 0;
                nếu (!dùng tls cũ && mình.đầu nối mở bằng ffi()) {
                    giao vận gói tin = 0;
                    nếu (là datagram) { giao vận gói tin = 1; };
                    mã = máy đầu nối kết nối(
                        mình.đầu nối địa chỉ mạng các byte(địa chỉ[i][0]), cổng, giao vận gói tin, thời gian chờ
                    );
                } hoặc nếu (là datagram) {
                    mã = đầu nối giao vận gói tin mở máy ảo(địa chỉ[i], thời gian chờ);
                } hoặc {
                    mã = đầu nối giao vận tin cậy mở máy ảo(địa chỉ[i], thời gian chờ);
                };
                // Cấu hình timeout sau connect; lỗi phải đóng rồi thử địa chỉ kế.
                thử {
                    nếu (mình.đầu nối dùng ffi(mã)) {
                        máy đầu nối thời gian chờ(mã, thời gian chờ);
                    } hoặc {
                        đầu nối đặt thời gian chờ máy ảo(mã, thời gian chờ);
                    };
                } bắt lỗi (e) {
                    thử { mình.đầu nối đóng(mã); } bắt lỗi (số mục bỏ qua) {};
                    ném e;
                };
                trả về mã;
            } bắt lỗi (e) {
                lỗi cuối = e;
            };
        };
        ném tên hàm + ": " + lỗi cuối;
    };

    hàm công khai đầu nối giao vận tin cậy mở(tên máy, cổng, thời gian chờ = 5000) {
        tên máy = mình.đầu nối yêu cầu tên máy(tên máy, "socket_tcp_mo");
        cổng = mình.đầu nối yêu cầu cổng(cổng, "socket_tcp_mo");
        thời gian chờ = mình.đầu nối yêu cầu thời gian chờ(thời gian chờ, "socket_tcp_mo");
        trả về mình.đầu nối mở kết nối(tên máy, cổng, thời gian chờ, sai, "socket_tcp_mo");
    };

    hàm công khai đầu nối giao vận gói tin mở(tên máy, cổng, thời gian chờ = 5000) {
        tên máy = mình.đầu nối yêu cầu tên máy(tên máy, "socket_udp_mo");
        cổng = mình.đầu nối yêu cầu cổng(cổng, "socket_udp_mo");
        thời gian chờ = mình.đầu nối yêu cầu thời gian chờ(thời gian chờ, "socket_udp_mo");
        trả về mình.đầu nối mở kết nối(tên máy, cổng, thời gian chờ, đúng, "socket_udp_mo");
    };

    // TLS client primitive: hệ điều hành/thư viện TLS thực hiện handshake, xác minh
    // chứng chỉ và mã hóa; framing HTTP/ứng dụng vẫn nằm hoàn toàn ở V++.
    hàm công khai đầu nối tls mở(tên máy, cổng = 443, thời gian chờ = 20000) {
        tên máy = mình.đầu nối yêu cầu tên máy(tên máy, "socket_tls_mo");
        cổng = mình.đầu nối yêu cầu cổng(cổng, "socket_tls_mo");
        thời gian chờ = mình.đầu nối yêu cầu thời gian chờ(thời gian chờ, "socket_tls_mo");
        cũ = ten nền tảng máy ảo() == "windows";
        mã = mình.đầu nối mở kết nối(tên máy, cổng, thời gian chờ, sai, "socket_tls_mo", cũ);
        // TLS chỉ bắt đầu sau khi đã chọn kết nối. Lỗi chứng chỉ/handshake được
        // trả ngay; V++ đóng socket TCP, không thử lại TLS trên địa chỉ khác.
        thử {
            nếu (!cũ) { trả về máy tls nâng cấp(mã, tên máy); };
            trả về đầu nối tls nâng cấp máy ảo(mã, tên máy);
        } bắt lỗi (e) {
            thử { mình.đầu nối đóng(mã); } bắt lỗi (số mục bỏ qua) {};
            ném e;
        };
    };

    // Primitive máy chủ: bind/listen và accept do hệ điều hành thực hiện. Mọi
    // protocol framing/parsing phía trên (HTTP, WebSocket...) thuộc thư viện V++.
    hàm công khai đầu nối giao vận tin cậy lắng nghe(cổng, hàng đợi chờ = 64) {
        cổng = mình.đầu nối yêu cầu cổng(cổng, "socket_tcp_lang_nghe");
        hàng đợi chờ = mình.đầu nối yêu cầu số nguyên(hàng đợi chờ, "socket_tcp_lang_nghe", "backlog");
        nếu (hàng đợi chờ <= 0 || hàng đợi chờ > 1024) {
            ném "socket_tcp_lang_nghe: backlog phải trong 1..1024";
        };
        nếu (mình.đầu nối mở bằng ffi()) {
            trả về máy đầu nối lắng nghe(cổng, hàng đợi chờ);
        };
        trả về đầu nối giao vận tin cậy lắng nghe máy ảo(cổng, hàng đợi chờ);
    };

    hàm công khai đầu nối chấp nhận(mã đầu nối lắng nghe, thời gian chờ = 300000) {
        mã đầu nối lắng nghe = mình.đầu nối yêu cầu mã(
            mã đầu nối lắng nghe,
            "socket_chap_nhan",
            "mã socket lắng nghe"
        );
        thời gian chờ = mình.đầu nối yêu cầu thời gian chờ(
            thời gian chờ,
            "socket_chap_nhan"
        );

        // `accept()` chỉ là primitive OS. Chính sách timeout của connection mới
        // thuộc thư viện V++; nếu cấu hình thất bại phải đóng handle vừa nhận.
        mã đầu nối = rỗng;
        nếu (mình.đầu nối dùng ffi(mã đầu nối lắng nghe)) {
            mã đầu nối = máy đầu nối chấp nhận(mã đầu nối lắng nghe);
        } hoặc {
            mã đầu nối = đầu nối chấp nhận máy ảo(mã đầu nối lắng nghe);
        };
        thử {
            mình.đầu nối đặt thời gian chờ(mã đầu nối, thời gian chờ);
        } bắt lỗi (e) {
            mình.đầu nối đóng(mã đầu nối);
            ném e;
        };
        trả về mã đầu nối;
    };

    hàm công khai đầu nối gửi(mã đầu nối, dữ liệu) {
        mã đầu nối = mình.đầu nối yêu cầu mã(mã đầu nối, "socket_gui", "mã socket");
        nếu (loại của(dữ liệu) != "chuỗi") { ném "socket_gui: dữ liệu phải là chuỗi"; };
        nếu (mình.đầu nối dùng ffi(mã đầu nối)) {
            các byte = chuỗi thành byte máy ảo(dữ liệu);
            tổng = máy ảo lấy độ dài(các byte);
            loại = máy đầu nối loại(mã đầu nối);
            datagram = loại == 1;
            tls = loại == 2;
            nếu (datagram && tổng > 65507) {
                ném "socket_gui: datagram vượt quá 65507 byte";
            };
            đã gửi = 0;
            lặp(vòng = 0; đã gửi < tổng; vòng++) {
                đệm = [];
                hết = đã gửi + 65536;
                nếu (hết > tổng) { hết = tổng; };
                lặp(i = đã gửi; i < hết; i++) { máy ảo thêm cuối danh sách(đệm, các byte[i]); };
                n = 0;
                nếu (tls) {
                    n = máy tls gửi(mã đầu nối, đệm, máy ảo lấy độ dài(đệm));
                } hoặc {
                    n = máy đầu nối gửi(mã đầu nối, đệm, máy ảo lấy độ dài(đệm), 0);
                };
                nếu (n <= 0 || n > máy ảo lấy độ dài(đệm)) { ném "socket_gui: gửi thất bại hoặc không tiến triển"; };
                đã gửi = đã gửi + n;
                // UDP phải là một datagram; không gửi tiếp phần còn thiếu.
                nếu (datagram) {
                    nếu (đã gửi != tổng) { ném "socket_gui: gửi datagram không đủ"; };
                    trả về đã gửi;
                };
            };
            trả về đã gửi;
        };
        đã gửi = 0;
        xong = sai;
        // VM chỉ send/SSLWrite một lần (một record với SChannel). V++ sở hữu
        // vòng gửi hết stream và quy tắc chỉ gửi một datagram cho UDP.
        // Offset tính theo byte nên partial write giữa hai byte UTF-8 vẫn đúng.
        lặp(vòng = 0; !xong; vòng++) {
            lần gửi = đầu nối gửi máy ảo(mã đầu nối, dữ liệu, đã gửi);
            byte = lần gửi[0];
            tổng byte = lần gửi[1];
            nếu (byte < 0 || byte > tổng byte - đã gửi) {
                ném "socket_gui: số byte gửi không hợp lệ";
            };
            nếu (byte == 0 && đã gửi < tổng byte) {
                ném "socket_gui: gửi không tiến triển";
            };
            đã gửi = đã gửi + byte;
            xong = lần gửi[2] || đã gửi == tổng byte;
        };
        trả về đã gửi;
    };

    hàm công khai đầu nối nhận(mã đầu nối, số byte tối đa = 65536) {
        mã đầu nối = mình.đầu nối yêu cầu mã(mã đầu nối, "socket_nhan", "mã socket");
        số byte tối đa = mình.đầu nối yêu cầu số nguyên(
            số byte tối đa,
            "socket_nhan",
            "số byte tối đa"
        );
        nếu (số byte tối đa <= 0 || số byte tối đa > 16777216) {
            ném "socket_nhan: số byte tối đa phải trong 1..16777216";
        };
        nếu (mình.đầu nối dùng ffi(mã đầu nối)) {
            mức trần = số byte tối đa;
            nếu (mức trần > 65536) { mức trần = 65536; };
            đệm = [];
            lặp(i = 0; i < mức trần; i++) { máy ảo thêm cuối danh sách(đệm, 0); };
            n = 0;
            nếu (máy đầu nối loại(mã đầu nối) == 2) {
                n = máy tls nhận(mã đầu nối, đệm, mức trần);
            } hoặc {
                n = máy đầu nối nhận(mã đầu nối, đệm, mức trần, 0);
            };
            nếu (n < 0 || n > mức trần) { ném "socket_nhan: nhận thất bại"; };
            các byte = [];
            lặp(i = 0; i < n; i++) { máy ảo thêm cuối danh sách(các byte, đệm[i]); };
            trả về chuỗi từ byte máy ảo(các byte);
        };
        trả về đầu nối nhận máy ảo(mã đầu nối, số byte tối đa);
    };

    hàm công khai đầu nối đặt thời gian chờ(mã đầu nối, thời gian chờ) {
        mã đầu nối = mình.đầu nối yêu cầu mã(mã đầu nối, "socket_dat_timeout", "mã socket");
        thời gian chờ = mình.đầu nối yêu cầu thời gian chờ(thời gian chờ, "socket_dat_timeout");
        nếu (mình.đầu nối dùng ffi(mã đầu nối)) {
            trả về máy đầu nối thời gian chờ(mã đầu nối, thời gian chờ);
        };
        trả về đầu nối đặt thời gian chờ máy ảo(mã đầu nối, thời gian chờ);
    };

    hàm công khai đầu nối đóng(mã đầu nối) {
        mã đầu nối = mình.đầu nối yêu cầu mã(mã đầu nối, "socket_dong", "mã socket");
        nếu (mình.đầu nối dùng ffi(mã đầu nối)) {
            kết quả = máy đầu nối đóng(mã đầu nối);
            // close()/closesocket() trả về 0 nếu thành công, còn API công khai
            // socket đóng() trả về đúng và giữ nguyên lỗi OS khi thất bại.
            nếu (kết quả != 0) { ném "socket_dong: đóng socket thất bại"; };
            trả về đúng;
        };
        trả về đầu nối đóng máy ảo(mã đầu nối);
    };
};


