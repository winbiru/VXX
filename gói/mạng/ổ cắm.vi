hàm công khai socket tcp lắng nghe(cổng, backlog = 64) {
    __vpp_adapter = Bộ Điều Khiển Ổ Cắm();
    trả về __vpp_adapter.socket tcp lắng nghe(cổng, backlog);
};

hàm công khai socket chấp nhận(mã socket lắng nghe, thời gian chờ = 300000) {
    __vpp_adapter = Bộ Điều Khiển Ổ Cắm();
    trả về __vpp_adapter.socket chấp nhận(mã socket lắng nghe, thời gian chờ);
};

