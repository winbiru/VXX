// IPv4/IPv6 parser thuần V++ dùng chung cho socket, DNS hosts và DNS config.
// Không gọi libc hoặc hệ điều hành.
nhập gói/lõi/chuyển kiểu;

lớp công khai Bộ Phân Tích IP {
    hàm công khai khởi tạo() {};

    // Chuyển IPv4 thập phân thành bốn byte mạng. Không dùng inet_pton/libc.
    hàm riêng tư ipv4 bytes(ip) {
        mã = chuoi_bytes_vm(ip);
        n = do_dai(mã);
        nếu (n < 7 || n > 15) { ném "socket_connect: IPv4 không hợp lệ"; };
        kết_quả = [];
        phần = 0;
        chữ_số = 0;
        lặp(i = 0; i <= n; i++) {
            k = 46;
            nếu (i < n) { k = mã[i]; };
            nếu (k == 46) {
                nếu (chữ_số == 0 || phần > 255 || do_dai(kết_quả) >= 4) {
                    ném "socket_connect: IPv4 không hợp lệ";
                };
                them(kết_quả, phần);
                phần = 0;
                chữ_số = 0;
            } hoặc {
                nếu (k < 48 || k > 57 || chữ_số >= 3) {
                    ném "socket_connect: IPv4 không hợp lệ";
                };
                phần = phần * 10 + k - 48;
                chữ_số = chữ_số + 1;
            };
        };
        nếu (do_dai(kết_quả) != 4) { ném "socket_connect: IPv4 không hợp lệ"; };
        trả về kết_quả;
    };

    // IPv6 hỗ trợ dạng đầy đủ, :: rút gọn và IPv4 suffix (::ffff:127.0.0.1).
    // Nhóm hex và số byte zero-padding được tính hoàn toàn trong V++.
    hàm công khai ip bytes(ip) {
        mã = chuoi_bytes_vm(ip);
        n = do_dai(mã);
        có_hai_chấm = sai;
        lặp(i = 0; i < n; i++) {
            nếu (mã[i] == 58) { có_hai_chấm = đúng; thoát; };
        };
        nếu (!có_hai_chấm) { trả về mình.ipv4 bytes(ip); };
        nếu (n < 2 || n > 45) { ném "socket_connect: IPv6 không hợp lệ"; };
        phần = [];
        vị_trí_nén = -1;
        i = 0;
        nếu (mã[0] == 58) {
            nếu (mã[1] != 58) { ném "socket_connect: IPv6 không hợp lệ"; };
            vị_trí_nén = 0;
            i = 2;
        };
        lặp(vòng = 0; i < n && vòng < 16; vòng++) {
            bắt_đầu = i;
            giá_trị = 0;
            chữ_số = 0;
            có_chấm = sai;
            lặp(j = i; j < n; j++) {
                nếu (mã[j] == 58) { thoát; };
                k = mã[j];
                nếu (k == 46) { có_chấm = đúng; };
            };
            nếu (có_chấm) {
                đuôi = [];
                lặp(j = bắt_đầu; j < n; j++) { them(đuôi, mã[j]); };
                v4 = mình.ipv4 bytes(chuoi_tu_bytes_vm(đuôi));
                lặp(j = 0; j < 4; j++) { them(phần, v4[j]); };
                i = n;
            } hoặc {
                lặp(j = i; j < n; j++) {
                    nếu (mã[j] == 58) { thoát; };
                    k = mã[j];
                    chữ = -1;
                    nếu (k >= 48 && k <= 57) { chữ = k - 48; }
                    hoặc nếu (k >= 65 && k <= 70) { chữ = k - 65 + 10; }
                    hoặc nếu (k >= 97 && k <= 102) { chữ = k - 97 + 10; };
                    nếu (chữ < 0 || chữ_số >= 4) {
                        ném "socket_connect: IPv6 không hợp lệ";
                    };
                    giá_trị = giá_trị * 16 + chữ;
                    chữ_số = chữ_số + 1;
                };
                nếu (chữ_số == 0) { ném "socket_connect: IPv6 không hợp lệ"; };
                them(phần, (giá_trị - giá_trị % 256) / 256);
                them(phần, giá_trị % 256);
                i = j;
                nếu (i < n) {
                    i = i + 1;
                    nếu (i == n) {
                        ném "socket_connect: IPv6 kết thúc bằng dấu hai chấm";
                    };
                    nếu (mã[i] == 58) {
                        nếu (vị_trí_nén >= 0) { ném "socket_connect: IPv6 nén hai lần"; };
                        vị_trí_nén = do_dai(phần);
                        i = i + 1;
                    };
                };
            };
        };
        nếu (i != n || do_dai(phần) > 16) { ném "socket_connect: IPv6 không hợp lệ"; };
        nếu (vị_trí_nén < 0) {
            nếu (do_dai(phần) != 16) { ném "socket_connect: IPv6 thiếu nhóm"; };
            trả về phần;
        };
        thiếu = 16 - do_dai(phần);
        nếu (thiếu < 2 || thiếu % 2 != 0) {
            ném "socket_connect: IPv6 nén không hợp lệ";
        };
        kết_quả = [];
        lặp(j = 0; j < vị_trí_nén; j++) { them(kết_quả, phần[j]); };
        lặp(j = 0; j < thiếu; j++) { them(kết_quả, 0); };
        lặp(j = vị_trí_nén; j < do_dai(phần); j++) { them(kết_quả, phần[j]); };
        trả về kết_quả;
    };

};

hàm công khai ip bytes(ip) {
    bộ = Bộ Phân Tích IP();
    trả về bộ.ip bytes(ip);
};
