// Bộ nhớ đệm DNS dương thuần V++; TTL tính theo đồng hồ đơn điệu.
// Mỗi instance sở hữu bộ nhớ riêng. Không cache NXDOMAIN/NODATA khi chưa
// phân tích SOA negative TTL theo RFC 2308.
nhập gói/bộ sưu tập/danh sách;
nhập gói/bộ sưu tập/từ điển;
nhập gói/lõi/toán học;
nhập gói/thời gian/đơn điệu;

lớp công khai Bộ Nhớ Đệm DNS {
    hàm công khai khởi tạo(giới_hạn = 64) {
        nếu (loai_cua(giới_hạn) != "số nguyên" || giới_hạn < 1 || giới_hạn > 256) {
            ném "DNS cache: giới hạn mục không hợp lệ";
        };
        mình.mục = [];
        mình.giới_hạn = giới_hạn;
    };

    hàm riêng tư dns sao chép(ds) {
        bản_sao = [];
        lặp(i = 0; i < do_dai(ds); i++) { thêm(bản_sao, ds[i]); };
        trả về bản_sao;
    };

    // Bản ghi: [khóa, thời điểm hết hạn (ms), địa chỉ].
    // Trả {} nếu không có kết quả; TTL được giảm khi đọc cache.
    hàm công khai dns đọc(khóa) {
        bây_giờ = thời gian đơn điệu mili giây();
        i = 0;
        lặp(vòng = 0; i < do_dai(mình.mục); vòng++) {
            mục = mình.mục[i];
            nếu (mục[1] <= bây_giờ) {
                xóa tại(mình.mục, i);
            } hoặc nếu (mục[0] == khóa) {
                còn = làm tròn xuống((mục[1] - bây_giờ) / 1000.0);
                nếu (còn < 0) { còn = 0; };
                trả về {"status": "NOERROR", "addresses": mình.dns sao chép(mục[2]),
                        "rcode": 0, "ttl": còn};
            } hoặc { i = i + 1; };
        };
        trả về {};
    };

    // Lưu duy nhất phản hồi NOERROR có địa chỉ và TTL dương.
    hàm công khai dns ghi(khóa, chi_tiết) {
        nếu (lấy map(chi_tiết, "status", "") != "NOERROR") { trả về sai; };
        địa_chỉ = lấy map(chi_tiết, "addresses", []);
        ttl = lấy map(chi_tiết, "ttl", 0);
        nếu (do_dai(địa_chỉ) == 0 || ttl <= 0) { trả về sai; };
        bây_giờ = thời gian đơn điệu mili giây();
        i = 0;
        lặp(vòng = 0; i < do_dai(mình.mục); vòng++) {
            mục = mình.mục[i];
            nếu (mục[1] <= bây_giờ || mục[0] == khóa) {
                xóa tại(mình.mục, i);
            } hoặc { i = i + 1; };
        };
        nếu (do_dai(mình.mục) >= mình.giới_hạn) { xóa tại(mình.mục, 0); };
        thêm(mình.mục, [khóa, bây_giờ + ttl * 1000.0,
                        mình.dns sao chép(địa_chỉ)]);
        trả về đúng;
    };

    hàm công khai dns số mục() { trả về do_dai(mình.mục); };
};
