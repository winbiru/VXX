// Module: mạng.kiểm thử.api
// Mục đích: helper tạo request theo HTTP verb để test/mô phỏng controller.
// Nhóm hàm: api get, api post, api put, api delete và biến thể json/query.

// Ghi chú hàm: api url hợp lệ.
hàm api url hợp lệ(đường_dẫn_yêu_cầu) {
    nếu (đường_dẫn_yêu_cầu == "") {
        trả về sai;
    };
    trả về đúng;
};

// Ghi chú hàm: api payload mặc định.
hàm api payload mặc định(payload) {
    nếu (payload == "") {
        trả về "{}";
    };
    trả về payload;
};

// Ghi chú hàm: api tạo yêu cầu.
hàm api tạo yêu cầu(method, đường_dẫn_yêu_cầu, payload) {
    nếu (!api url hợp lệ(đường_dẫn_yêu_cầu)) {
        trả về "ERR|missing-url";
    };

    nếu (method == "GET" || method == "DELETE") {
        trả về method + "|" + đường_dẫn_yêu_cầu;
    };

    trả về method + "|" + đường_dẫn_yêu_cầu + "|" + payload;
};

// Ghi chú hàm: api get.
hàm api get(đường_dẫn_yêu_cầu) {
    trả về api tạo yêu cầu("GET", đường_dẫn_yêu_cầu, "");
};

// Ghi chú hàm: api post.
hàm api post(đường_dẫn_yêu_cầu, payload) {
    trả về api tạo yêu cầu("POST", đường_dẫn_yêu_cầu, payload);
};

// Ghi chú hàm: api put.
hàm api put(đường_dẫn_yêu_cầu, payload) {
    trả về api tạo yêu cầu("PUT", đường_dẫn_yêu_cầu, payload);
};

// Ghi chú hàm: api delete.
hàm api delete(đường_dẫn_yêu_cầu) {
    trả về api tạo yêu cầu("DELETE", đường_dẫn_yêu_cầu, "");
};

// Ghi chú hàm: api post json.
hàm api post json(đường_dẫn_yêu_cầu, payload) {
    trả về api post(đường_dẫn_yêu_cầu, api payload mặc định(payload));
};

// Ghi chú hàm: api put json.
hàm api put json(đường_dẫn_yêu_cầu, payload) {
    trả về api put(đường_dẫn_yêu_cầu, api payload mặc định(payload));
};

// Ghi chú hàm: api get có query.
hàm api get có query(đường_dẫn_yêu_cầu, query) {
    nếu (query == "") {
        trả về api get(đường_dẫn_yêu_cầu);
    };
    trả về api get(đường_dẫn_yêu_cầu + "?" + query);
};
