// vi.net.http.server — bề mặt server V++ trên socket primitives của hệ điều hành.
nhập gói/mạng/ổ cắm;
nhập gói/mạng/http/máy khách;

// Lớp sở hữu toàn bộ thuật toán của mô-đun; các hàm bên dưới chỉ giữ API cũ.
lớp công khai Máy Chủ HTTP {
    hàm công khai khởi tạo() {};

    hàm công khai máy chủ http mở(cổng) {
        trả về mạng mở máy chủ giao diện lập trình(cổng);
    };

    hàm công khai máy chủ http yêu cầu kế tiếp(mã máy chủ) {
        trả về mạng lấy yêu cầu kế tiếp(mã máy chủ);
    };

    hàm công khai yêu cầu http phương thức(mã yêu cầu) {
        trả về mạng phương thức yêu cầu(mã yêu cầu);
    };

    hàm công khai yêu cầu http đường dẫn(mã yêu cầu) {
        trả về mạng đường tệp yêu cầu(mã yêu cầu);
    };

    hàm công khai yêu cầu http truy vấn(mã yêu cầu) {
        trả về mạng truy vấn yêu cầu(mã yêu cầu);
    };

    hàm công khai yêu cầu http nội dung(mã yêu cầu) {
        trả về mạng thân khối yêu cầu(mã yêu cầu);
    };

    hàm công khai yêu cầu http phần đầu(mã yêu cầu, khóa) {
        trả về mạng phần đầu yêu cầu(mã yêu cầu, khóa);
    };

    hàm công khai yêu cầu http tham số(mã yêu cầu, khóa) {
        trả về mạng truy vấn tham số yêu cầu(mã yêu cầu, khóa);
    };

    hàm công khai máy chủ http trả lời(mã yêu cầu, trạng thái, nội dung) {
        trả về mạng trả phản hồi(mã yêu cầu, trạng thái, nội dung);
    };

    hàm công khai máy chủ http đóng(mã máy chủ) {
        trả về mạng đóng máy chủ giao diện lập trình(mã máy chủ);
    };
};


hàm công khai máy chủ http mở(cổng) {
    bộ chuyển tiếp = Máy Chủ HTTP();
    trả về bộ chuyển tiếp.máy chủ http mở(cổng);
};

hàm công khai máy chủ http yêu cầu kế tiếp(mã máy chủ) {
    bộ chuyển tiếp = Máy Chủ HTTP();
    trả về bộ chuyển tiếp.máy chủ http yêu cầu kế tiếp(mã máy chủ);
};

hàm công khai yêu cầu http phương thức(mã yêu cầu) {
    bộ chuyển tiếp = Máy Chủ HTTP();
    trả về bộ chuyển tiếp.yêu cầu http phương thức(mã yêu cầu);
};

hàm công khai yêu cầu http đường dẫn(mã yêu cầu) {
    bộ chuyển tiếp = Máy Chủ HTTP();
    trả về bộ chuyển tiếp.yêu cầu http đường dẫn(mã yêu cầu);
};

hàm công khai yêu cầu http truy vấn(mã yêu cầu) {
    bộ chuyển tiếp = Máy Chủ HTTP();
    trả về bộ chuyển tiếp.yêu cầu http truy vấn(mã yêu cầu);
};

hàm công khai yêu cầu http nội dung(mã yêu cầu) {
    bộ chuyển tiếp = Máy Chủ HTTP();
    trả về bộ chuyển tiếp.yêu cầu http nội dung(mã yêu cầu);
};

hàm công khai yêu cầu http phần đầu(mã yêu cầu, khóa) {
    bộ chuyển tiếp = Máy Chủ HTTP();
    trả về bộ chuyển tiếp.yêu cầu http phần đầu(mã yêu cầu, khóa);
};

hàm công khai yêu cầu http tham số(mã yêu cầu, khóa) {
    bộ chuyển tiếp = Máy Chủ HTTP();
    trả về bộ chuyển tiếp.yêu cầu http tham số(mã yêu cầu, khóa);
};

hàm công khai máy chủ http trả lời(mã yêu cầu, trạng thái, nội dung) {
    bộ chuyển tiếp = Máy Chủ HTTP();
    trả về bộ chuyển tiếp.máy chủ http trả lời(mã yêu cầu, trạng thái, nội dung);
};

hàm công khai máy chủ http đóng(mã máy chủ) {
    bộ chuyển tiếp = Máy Chủ HTTP();
    trả về bộ chuyển tiếp.máy chủ http đóng(mã máy chủ);
};
