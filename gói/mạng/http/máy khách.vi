// Module: mạng
// HTTP method wrappers và HTTP/1.1 nằm ở V++; VM chỉ giữ socket/TLS primitive I/O.
// HTTP client chỉ nhận URL UTF-8 hợp lệ dùng http:// hoặc https://, có host và
// không chứa khoảng trắng/ký tự điều khiển chưa percent-encode.
// Lỗi socket/transport được ném qua thử/bắt để caller có thể xử lý hoặc thử
// lại khi máy chủ chưa sẵn sàng. Không tự động gửi lại POST/PUT/DELETE.
// Cả HTTP và HTTPS đều dùng cùng framing/parsing V++; HTTPS chỉ đổi transport sang TLS.

nhập gói/dữ liệu/json/chính;
nhập gói/bộ sưu tập/từ điển;
nhập gói/mạng/ổ cắm;
nhập gói/văn bản/chuỗi;

// Lớp sở hữu toàn bộ thuật toán của mô-đun; các hàm bên dưới chỉ giữ API cũ.
lớp công khai Bộ Giao Thức HTTP {
    hàm công khai khởi tạo() {};

    // HTTP/1.x là logic thư viện và được viết bằng V++. VM chỉ giữ transport
    // socket/TLS, certificate verification và crypto primitive của hệ điều hành.
    hàm riêng tư mạng http tìm ký tự đầu(giá trị, ký tự, từ = 0) {
        trả về tìm chuỗi chính xác(giá trị, ký tự, từ);
    };

    hàm riêng tư mạng http thẩm quyền kết thúc(đường dẫn, bắt đầu) {
        n = máy ảo lấy độ dài(đường dẫn);
        kết thúc = n;
        dấu gạch chéo = mình.mạng http tìm ký tự đầu(đường dẫn, "/", bắt đầu);
        truy vấn = mình.mạng http tìm ký tự đầu(đường dẫn, "?", bắt đầu);
        phân đoạn = mình.mạng http tìm ký tự đầu(đường dẫn, "#", bắt đầu);
        nếu (dấu gạch chéo != rỗng) {
            nếu (dấu gạch chéo < kết thúc) { kết thúc = dấu gạch chéo; };
        };
        nếu (truy vấn != rỗng) {
            nếu (truy vấn < kết thúc) { kết thúc = truy vấn; };
        };
        nếu (phân đoạn != rỗng) {
            nếu (phân đoạn < kết thúc) { kết thúc = phân đoạn; };
        };
        trả về kết thúc;
    };

    hàm công khai mạng http phân tích địa chỉ tài nguyên(đường dẫn) {
        nếu (đường dẫn == "") {
            ném "mạng http: URL không được rỗng";
        };
        lặp(i = 0; i < máy ảo lấy độ dài(đường dẫn); i++) {
            mã = chuỗi mã điểm unicode(đường dẫn[i]);
            nếu (mã <= 32 || mã == 127) {
                ném "mạng http: URL chứa khoảng trắng hoặc ký tự điều khiển; hãy percent-encode trước";
            };
        };

        dùng tls = sai;
        n = máy ảo lấy độ dài(đường dẫn);
        thẩm quyền bắt đầu = 0;
        cổng mặc định = 80;
        nếu (bắt đầu bằng(đường dẫn, "http://")) {
            thẩm quyền bắt đầu = 7;
        } hoặc {
            nếu (bắt đầu bằng(đường dẫn, "https://")) {
                thẩm quyền bắt đầu = 8;
                cổng mặc định = 443;
                dùng tls = đúng;
            } hoặc {
                ném "mạng http: chỉ hỗ trợ URL http:// hoặc https://";
            };
        };
        thẩm quyền kết thúc = mình.mạng http thẩm quyền kết thúc(đường dẫn, thẩm quyền bắt đầu);
        nếu (thẩm quyền kết thúc <= thẩm quyền bắt đầu) {
            ném "mạng http: URL thiếu tên máy";
        };

        thẩm quyền = con chuỗi(đường dẫn, thẩm quyền bắt đầu, thẩm quyền kết thúc);
        nếu (chứa chính xác(thẩm quyền, "@")) {
            ném "mạng http: userinfo trong URL chưa được hỗ trợ";
        };

        tên máy = "";
        cổng = cổng mặc định;
        nếu (bắt đầu bằng(thẩm quyền, "[")) {
            đóng = mình.mạng http tìm ký tự đầu(thẩm quyền, "]", 1);
            nếu (đóng == rỗng) {
                ném "mạng http: địa chỉ IPv6 không hợp lệ";
            };
            nếu (đóng <= 1) {
                ném "mạng http: địa chỉ IPv6 không hợp lệ";
            };
            tên máy = con chuỗi(thẩm quyền, 1, đóng);
            hậu = con chuỗi(thẩm quyền, đóng + 1, máy ảo lấy độ dài(thẩm quyền));
            nếu (hậu != "") {
                nếu (!bắt đầu bằng(hậu, ":") || máy ảo lấy độ dài(hậu) == 1) {
                    ném "mạng http: cổng không hợp lệ";
                };
                cổng = thành số nguyên(con chuỗi(hậu, 1, máy ảo lấy độ dài(hậu)));
            };
        } hoặc {
            dấu hai chấm = mình.mạng http tìm ký tự đầu(thẩm quyền, ":", 0);
            nếu (dấu hai chấm == rỗng) {
                tên máy = thẩm quyền;
            } hoặc {
                nếu (mình.mạng http tìm ký tự đầu(thẩm quyền, ":", dấu hai chấm + 1) != rỗng) {
                    ném "mạng http: IPv6 phải đặt trong []";
                };
                tên máy = con chuỗi(thẩm quyền, 0, dấu hai chấm);
                cổng chữ = con chuỗi(thẩm quyền, dấu hai chấm + 1, máy ảo lấy độ dài(thẩm quyền));
                nếu (cổng chữ == "") {
                    ném "mạng http: cổng không hợp lệ";
                };
                thử {
                    cổng = thành số nguyên(cổng chữ);
                } bắt lỗi (e) {
                    ném "mạng http: cổng không hợp lệ";
                };
            };
        };

        nếu (tên máy == "" || cổng <= 0 || cổng > 65535) {
            ném "mạng http: tên máy hoặc cổng không hợp lệ";
        };

        đích = "/";
        nếu (thẩm quyền kết thúc < n) {
            đích = con chuỗi(đường dẫn, thẩm quyền kết thúc, n);
            nếu (bắt đầu bằng(đích, "?")) {
                đích = "/" + đích;
            };
            phân đoạn = mình.mạng http tìm ký tự đầu(đích, "#", 0);
            nếu (phân đoạn != rỗng) {
                đích = con chuỗi(đích, 0, phân đoạn);
            };
            nếu (đích == "") { đích = "/"; };
        };

        trả về [tên máy, cổng, đích, thẩm quyền, dùng tls];
    };

    hàm công khai mạng http dựng yêu cầu(phương thức, đích, máy đích phần đầu, dữ liệu, có thân khối) {
        yêu cầu = phương thức + " " + đích + " HTTP/1.1\r\n" +
                  "Host: " + máy đích phần đầu + "\r\n" +
                  "Accept: */*\r\n" +
                  "Connection: close\r\n";
        nếu (có thân khối) {
            số byte = máy ảo lấy độ dài(chuỗi thành các byte(dữ liệu, "UTF-8"));
            yêu cầu = yêu cầu +
                      "Content-Type: application/json\r\n" +
                      "Content-Length: " + thành chuỗi(số byte) + "\r\n";
        };
        yêu cầu = yêu cầu + "\r\n";
        nếu (có thân khối) { yêu cầu = yêu cầu + dữ liệu; };
        trả về yêu cầu;
    };

    hàm riêng tư mạng http lấy tiền tố byte(văn bản, số byte, nhãn = "dữ liệu") {
        các byte = chuỗi thành các byte(văn bản, "UTF-8");
        nếu (số byte < 0 || máy ảo lấy độ dài(các byte) < số byte) {
            ném "mạng http: " + nhãn + " ngắn hơn độ dài đã khai báo";
        };
        nếu (máy ảo lấy độ dài(các byte) == số byte) { trả về văn bản; };
        kết quả = [];
        lặp(i = 0; i < số byte; i++) {
            máy ảo thêm cuối danh sách(kết quả, các byte[i]);
        };
        trả về chuỗi từ các byte(kết quả, "UTF-8", "BÁO_LỖI");
    };

    hàm riêng tư mạng http thập lục phân byte(b) {
        nếu (b >= 48 && b <= 57) { trả về b - 48; };
        nếu (b >= 65 && b <= 70) { trả về b - 65 + 10; };
        nếu (b >= 97 && b <= 102) { trả về b - 97 + 10; };
        trả về -1;
    };

    // Khi đang đọc socket, một lần nhận có thể kết thúc giữa size line, dữ liệu
    // chunk hoặc trailer. Hàm này trả `hoàn tất = sai` cho đúng trường hợp thiếu
    // byte đó; lỗi cú pháp vẫn được ném ngay từ tầng HTTP V++.
    hàm riêng tư mạng http chia khối cần máy ảo thêm cuối danh sách(cho phép thiếu, thông báo) {
        nếu (cho phép thiếu) {
            trả về đúng;
        };
        ném thông báo;
    };

    // Quét Transfer-Encoding: chunked trực tiếp trên bytes để kích thước chunk
    // không bị nhầm giữa byte UTF-8 và code point V++. `loại` chỉ đi vào lỗi để
    // client và server giữ được ngữ cảnh riêng.
    hàm riêng tư mạng http quét chia khối(thân khối, cho phép thiếu = sai,
                              tiền tố = "mạng http", loại = "response") {
        nguồn = chuỗi thành các byte(thân khối, "UTF-8");
        kết quả = [];
        vị trí = 0;
        hoàn tất = sai;
        cần thêm = sai;

        khi (!hoàn tất && !cần thêm) {
            nếu (vị trí >= máy ảo lấy độ dài(nguồn)) {
                cần thêm = mình.mạng http chia khối cần máy ảo thêm cuối danh sách(
                    cho phép thiếu,
                    tiền tố + ": chunked " + loại + " thiếu kích thước chunk"
                );
            } hoặc {
                cuối dòng = -1;
                lặp(i = vị trí; i + 1 < máy ảo lấy độ dài(nguồn) && cuối dòng < 0; i++) {
                    nếu (nguồn[i] == 13 && nguồn[i + 1] == 10) {
                        cuối dòng = i;
                    };
                };
                nếu (cuối dòng < 0) {
                    cần thêm = mình.mạng http chia khối cần máy ảo thêm cuối danh sách(
                        cho phép thiếu,
                        tiền tố + ": chunked " + loại + " thiếu CRLF"
                    );
                } hoặc {
                    kích thước = 0;
                    có chữ số = sai;
                    đang thập lục phân = đúng;
                    lặp(i = vị trí; i < cuối dòng && đang thập lục phân; i++) {
                        nếu (nguồn[i] == 59) {
                            đang thập lục phân = sai; // ';' bắt đầu chunk extension.
                        } hoặc {
                            nửa byte = mình.mạng http thập lục phân byte(nguồn[i]);
                            nếu (nửa byte < 0) {
                                ném tiền tố + ": kích thước chunk không hợp lệ";
                            };
                            có chữ số = đúng;
                            kích thước = kích thước * 16 + nửa byte;
                            nếu (kích thước > 16777216) {
                                ném tiền tố + ": chunk vượt giới hạn 16 MiB";
                            };
                        };
                    };
                    nếu (!có chữ số) {
                        ném tiền tố + ": kích thước chunk rỗng";
                    };

                    vị trí = cuối dòng + 2;
                    nếu (kích thước == 0) {
                        // Sau zero chunk là trailer section, kết thúc bởi một dòng
                        // rỗng. Trailer chưa được nhập vào headers nhưng phải được
                        // xác thực để không chấp nhận message bị cắt cụt.
                        phần kết xong = sai;
                        khi (!phần kết xong && !cần thêm) {
                            cuối phần kết = -1;
                            lặp(i = vị trí;
                                 i + 1 < máy ảo lấy độ dài(nguồn) && cuối phần kết < 0;
                                 i++) {
                                nếu (nguồn[i] == 13 && nguồn[i + 1] == 10) {
                                    cuối phần kết = i;
                                };
                            };
                            nếu (cuối phần kết < 0) {
                                cần thêm = mình.mạng http chia khối cần máy ảo thêm cuối danh sách(
                                    cho phép thiếu,
                                    tiền tố + ": chunked " + loại +
                                        " thiếu CRLF kết thúc trailer"
                                );
                            } hoặc {
                                nếu (cuối phần kết == vị trí) {
                                    vị trí = cuối phần kết + 2;
                                    phần kết xong = đúng;
                                    hoàn tất = đúng;
                                } hoặc {
                                    có hai chấm = sai;
                                    lặp(i = vị trí;
                                         i < cuối phần kết && !có hai chấm;
                                         i++) {
                                        nếu (nguồn[i] == 58 && i > vị trí) {
                                            có hai chấm = đúng;
                                        };
                                    };
                                    nếu (!có hai chấm) {
                                        ném tiền tố + ": trailer chunked không hợp lệ";
                                    };
                                    vị trí = cuối phần kết + 2;
                                };
                            };
                        };
                    } hoặc {
                        nếu (vị trí + kích thước + 2 > máy ảo lấy độ dài(nguồn)) {
                            cần thêm = mình.mạng http chia khối cần máy ảo thêm cuối danh sách(
                                cho phép thiếu,
                                tiền tố + ": chunk ngắn hơn kích thước đã khai báo"
                            );
                        } hoặc {
                            nếu (máy ảo lấy độ dài(kết quả) + kích thước > 16777216) {
                                ném tiền tố + ": body chunked vượt giới hạn 16 MiB";
                            };
                            lặp(i = 0; i < kích thước; i++) {
                                máy ảo thêm cuối danh sách(kết quả, nguồn[vị trí + i]);
                            };
                            vị trí = vị trí + kích thước;
                            nếu (nguồn[vị trí] != 13 || nguồn[vị trí + 1] != 10) {
                                ném tiền tố + ": chunk thiếu CRLF kết thúc";
                            };
                            vị trí = vị trí + 2;
                        };
                    };
                };
            };
        };

        nếu (cần thêm) {
            trả về {"hoàn tất": sai, "body": "", "đã dùng": vị trí};
        };
        trả về {
            "hoàn tất": đúng,
            "body": chuỗi từ các byte(kết quả, "UTF-8", "BÁO_LỖI"),
            "đã dùng": vị trí
        };
    };

    hàm riêng tư mạng http giải chia khối(thân khối) {
        quét = mình.mạng http quét chia khối(thân khối);
        trả về lấy từ điển(quét, "body", "");
    };

    hàm công khai mạng http phân tích phản hồi(phản hồi) {
        ngăn = tìm chuỗi chính xác(phản hồi, "\r\n\r\n", 0);
        nếu (ngăn == rỗng) {
            ném "mạng http: phản hồi không có phần đầu HTTP hợp lệ";
        };
        phần đầu = con chuỗi(phản hồi, 0, ngăn);
        dòng = tách hằng văn bản(phần đầu, "\r\n");
        nếu (máy ảo lấy độ dài(dòng) == 0) {
            ném "mạng http: status line bị thiếu";
        };
        mã trạng thái các phần = tách hằng văn bản(dòng[0], " ");
        nếu (máy ảo lấy độ dài(mã trạng thái các phần) < 2) {
            ném "mạng http: status line không hợp lệ";
        };
        nếu (!bắt đầu bằng(mã trạng thái các phần[0], "HTTP/")) {
            ném "mạng http: status line không hợp lệ";
        };
        thử {
            mã trạng thái = thành số nguyên(mã trạng thái các phần[1]);
        } bắt lỗi (e) {
            ném "mạng http: status code không hợp lệ";
        };

        các phần đầu = {};
        lặp(i = 1; i < máy ảo lấy độ dài(dòng); i++) {
            nếu (dòng[i] != "") {
                dấu hai chấm = tìm chuỗi chính xác(dòng[i], ":", 0);
                nếu (dấu hai chấm == rỗng || dấu hai chấm == 0) {
                    ném "mạng http: response header không hợp lệ";
                };
                khóa = chuỗi thường(bỏ khoảng trắng(
                    con chuỗi(dòng[i], 0, dấu hai chấm)
                ));
                giá trị = bỏ khoảng trắng(
                    con chuỗi(dòng[i], dấu hai chấm + 1, máy ảo lấy độ dài(dòng[i]))
                );
                đặt từ điển(các phần đầu, khóa, giá trị);
            };
        };

        thân khối = con chuỗi(phản hồi, ngăn + 4, máy ảo lấy độ dài(phản hồi));
        chuyển = chuỗi thường(lấy từ điển(các phần đầu, "transfer-encoding", ""));
        nếu (chứa chính xác(chuyển, "chunked")) {
            thân khối = mình.mạng http giải chia khối(thân khối);
        } hoặc {
            nội dung chiều dài văn bản = lấy từ điển(các phần đầu, "content-length", "");
            nếu (nội dung chiều dài văn bản != "") {
                thử {
                    nội dung chiều dài = thành số nguyên(nội dung chiều dài văn bản);
                } bắt lỗi (e) {
                    ném "mạng http: Content-Length response không hợp lệ";
                };
                nếu (nội dung chiều dài < 0 || nội dung chiều dài > 16777216) {
                    ném "mạng http: Content-Length response vượt giới hạn 16 MiB";
                };
                thân khối = mình.mạng http lấy tiền tố byte(thân khối, nội dung chiều dài, "response body");
            };
        };

        trả về {"status": mã trạng thái, "headers": các phần đầu, "body": thân khối};
    };

    hàm công khai mạng http tách thân khối(phản hồi) {
        phản hồi = mình.mạng http phân tích phản hồi(phản hồi);
        trả về lấy từ điển(phản hồi, "body", "");
    };

    hàm riêng tư mạng http thực thi phản hồi qua đầu nối(phương thức, đường dẫn, dữ liệu, có thân khối) {
        địa chỉ tài nguyên yêu cầu = mình.mạng http phân tích địa chỉ tài nguyên(đường dẫn);
        tên máy = địa chỉ tài nguyên yêu cầu[0];
        cổng = địa chỉ tài nguyên yêu cầu[1];
        đích = địa chỉ tài nguyên yêu cầu[2];
        máy đích phần đầu = địa chỉ tài nguyên yêu cầu[3];
        dùng tls = địa chỉ tài nguyên yêu cầu[4];
        đầu nối = 0;
        nếu (dùng tls) {
            đầu nối = đầu nối tls mở(tên máy, cổng, 20000);
        } hoặc {
            đầu nối = đầu nối giao vận tin cậy mở(tên máy, cổng, 20000);
        };
        phản hồi = "";
        thử {
            yêu cầu = mình.mạng http dựng yêu cầu(phương thức, đích, máy đích phần đầu, dữ liệu, có thân khối);
            đầu nối gửi(đầu nối, yêu cầu);
            đang đọc = đúng;
            khi (đang đọc) {
                phần = đầu nối nhận(đầu nối, 65536);
                nếu (phần == "") {
                    đang đọc = sai;
                } hoặc {
                    phản hồi = phản hồi + phần;
                    nếu (máy ảo lấy độ dài(chuỗi thành các byte(phản hồi, "UTF-8")) > 16842752) {
                        ném "mạng http: response vượt giới hạn 16 MiB + 64 KiB header";
                    };
                };
            };
        } bắt lỗi (e) {
            thử { đầu nối đóng(đầu nối); } bắt lỗi (số mục bỏ qua) {};
            ném e;
        };
        đầu nối đóng(đầu nối);
        trả về mình.mạng http phân tích phản hồi(phản hồi);
    };

    hàm riêng tư mạng http thực thi qua đầu nối(phương thức, đường dẫn, dữ liệu, có thân khối) {
        phản hồi = mình.mạng http thực thi phản hồi qua đầu nối(
            phương thức, đường dẫn, dữ liệu, có thân khối
        );
        trả về lấy từ điển(phản hồi, "body", "");
    };

    hàm riêng tư mạng http là redirect(mã trạng thái) {
        trả về mã trạng thái == 301 || mã trạng thái == 302 || mã trạng thái == 303 ||
                mã trạng thái == 307 || mã trạng thái == 308;
    };

    hàm riêng tư mạng http chuẩn hóa đường tệp redirect(đường tệp và hậu tố) {
        đường tệp = đường tệp và hậu tố;
        hậu tố = "";
        vị trí hậu = rỗng;
        vị trí truy vấn = tìm chuỗi chính xác(đường tệp, "?", 0);
        vị trí phân đoạn = tìm chuỗi chính xác(đường tệp, "#", 0);
        nếu (vị trí truy vấn != rỗng) { vị trí hậu = vị trí truy vấn; };
        nếu (vị trí phân đoạn != rỗng) {
            nếu (vị trí hậu == rỗng || vị trí phân đoạn < vị trí hậu) {
                vị trí hậu = vị trí phân đoạn;
            };
        };
        nếu (vị trí hậu != rỗng) {
            hậu tố = con chuỗi(đường tệp, vị trí hậu, máy ảo lấy độ dài(đường tệp));
            đường tệp = con chuỗi(đường tệp, 0, vị trí hậu);
        };

        giữ dấu gạch chéo cuối = kết thúc bằng(đường tệp, "/") ||
                         kết thúc bằng(đường tệp, "/.") ||
                         kết thúc bằng(đường tệp, "/..");
        phần = tách hằng văn bản(đường tệp, "/");
        chuẩn = [];
        lặp(i = 0; i < máy ảo lấy độ dài(phần); i++) {
            đoạn = phần[i];
            nếu (đoạn == "" || đoạn == ".") {
                // Bỏ segment rỗng và '.'.
            } hoặc {
                nếu (đoạn == "..") {
                    nếu (máy ảo lấy độ dài(chuẩn) > 0) {
                        máy ảo xóa vị trí danh sách(chuẩn, máy ảo lấy độ dài(chuẩn) - 1);
                    };
                } hoặc {
                    máy ảo thêm cuối danh sách(chuẩn, đoạn);
                };
            };
        };

        kết quả = "/";
        lặp(i = 0; i < máy ảo lấy độ dài(chuẩn); i++) {
            nếu (i > 0) { kết quả = kết quả + "/"; };
            kết quả = kết quả + chuẩn[i];
        };
        nếu (giữ dấu gạch chéo cuối && kết quả != "/") {
            kết quả = kết quả + "/";
        };
        trả về kết quả + hậu tố;
    };

    hàm công khai mạng http địa chỉ tài nguyên redirect(gốc dữ liệu, location) {
        nếu (bắt đầu bằng(location, "http://") || bắt đầu bằng(location, "https://")) {
            trả về location;
        };
        base = mình.mạng http phân tích địa chỉ tài nguyên(gốc dữ liệu);
        lược đồ = "http://";
        nếu (base[4]) { lược đồ = "https://"; };
        nguồn gốc = lược đồ + base[3];
        nếu (bắt đầu bằng(location, "//")) {
            trả về con chuỗi(lược đồ, 0, máy ảo lấy độ dài(lược đồ) - 2) + location;
        };
        nếu (bắt đầu bằng(location, "/")) {
            trả về nguồn gốc + mình.mạng http chuẩn hóa đường tệp redirect(location);
        };

        đường tệp = base[2];
        vị trí truy vấn = tìm chuỗi chính xác(đường tệp, "?", 0);
        nếu (vị trí truy vấn != rỗng) {
            đường tệp = con chuỗi(đường tệp, 0, vị trí truy vấn);
        };
        nếu (bắt đầu bằng(location, "?")) {
            trả về nguồn gốc + đường tệp + location;
        };
        dấu gạch chéo cuối = 0;
        lặp(i = 0; i < máy ảo lấy độ dài(đường tệp); i++) {
            nếu (đường tệp[i] == "/") { dấu gạch chéo cuối = i; };
        };
        thư mục = con chuỗi(đường tệp, 0, dấu gạch chéo cuối + 1);
        trả về nguồn gốc + mình.mạng http chuẩn hóa đường tệp redirect(thư mục + location);
    };

    hàm công khai mạng thực thi yêu cầu(phương thức, đường dẫn, dữ liệu = "") {
        nếu (phương thức != "GET" && phương thức != "POST" && phương thức != "PUT" && phương thức != "DELETE") {
            ném "mạng http: phương thức HTTP không được hỗ trợ";
        };
        phương thức hiện tại = phương thức;
        địa chỉ tài nguyên hiện tại = đường dẫn;
        dữ liệu hiện tại = dữ liệu;
        lặp(lần = 0; lần <= 8; lần++) {
            có thân khối = phương thức hiện tại == "POST" || phương thức hiện tại == "PUT";
            phản hồi = mình.mạng http thực thi phản hồi qua đầu nối(
                phương thức hiện tại, địa chỉ tài nguyên hiện tại, dữ liệu hiện tại, có thân khối
            );
            mã trạng thái = lấy từ điển(phản hồi, "status", 0);
            các phần đầu = lấy từ điển(phản hồi, "headers", {});
            location = lấy từ điển(các phần đầu, "location", "");
            nếu (!mình.mạng http là redirect(mã trạng thái) || location == "") {
                trả về lấy từ điển(phản hồi, "body", "");
            };
            nếu (lần == 8) {
                ném "mạng http: vượt quá 8 lần redirect";
            };
            địa chỉ tài nguyên hiện tại = mình.mạng http địa chỉ tài nguyên redirect(địa chỉ tài nguyên hiện tại, location);
            nếu (mã trạng thái == 303 ||
                ((mã trạng thái == 301 || mã trạng thái == 302) && phương thức hiện tại == "POST")) {
                phương thức hiện tại = "GET";
                dữ liệu hiện tại = "";
            };
        };
        ném "mạng http: redirect không kết thúc";
    };

    hàm công khai mạng lấy(đường dẫn) {
        trả về mình.mạng thực thi yêu cầu("GET", đường dẫn, "");
    };

    hàm công khai mạng gửi(đường dẫn, dữ liệu) {
        trả về mình.mạng thực thi yêu cầu("POST", đường dẫn, dữ liệu);
    };

    hàm công khai mạng cập nhật(đường dẫn, dữ liệu) {
        trả về mình.mạng thực thi yêu cầu("PUT", đường dẫn, dữ liệu);
    };

    hàm công khai mạng xóa(đường dẫn) {
        trả về mình.mạng thực thi yêu cầu("DELETE", đường dẫn, "");
    };

    // Tương thích API cũ. HTTP server được triển khai ở V++; VM chỉ cung cấp
    // bind/listen/accept/send/recv/close trên socket.
    hàm công khai mạng chạy máy chủ giao diện lập trình(cổng, trình điều khiển, địa chỉ kết nối cơ sở dữ liệu, tên đăng nhập, mật khẩu) {
        trả về mình.mạng mở máy chủ giao diện lập trình(cổng);
    };

    hàm công khai mạng mở máy chủ giao diện lập trình(cổng) {
        trả về đầu nối giao vận tin cậy lắng nghe(cổng, 64);
    };

    // Parse request line + headers. Body được đọc riêng vì Content-Length tính byte,
    // còn chuỗi V++ lập chỉ mục theo code point.
    hàm công khai mạng http phân tích phần đầu yêu cầu(phần đầu) {
        dòng = tách hằng văn bản(phần đầu, "\r\n");
        nếu (máy ảo lấy độ dài(dòng) == 0 || dòng[0] == "") {
            ném "mạng http server: request line rỗng";
        };

        yêu cầu dòng = dòng[0];
        khoảng một = tìm chuỗi chính xác(yêu cầu dòng, " ", 0);
        nếu (khoảng một == rỗng) {
            ném "mạng http server: request line không hợp lệ";
        };
        khoảng hai = tìm chuỗi chính xác(yêu cầu dòng, " ", khoảng một + 1);
        nếu (khoảng hai == rỗng) {
            ném "mạng http server: request line không hợp lệ";
        };

        phương thức = con chuỗi(yêu cầu dòng, 0, khoảng một);
        đích đến = con chuỗi(yêu cầu dòng, khoảng một + 1, khoảng hai);
        phiên bản = con chuỗi(yêu cầu dòng, khoảng hai + 1, máy ảo lấy độ dài(yêu cầu dòng));
        nếu (phương thức == "" || đích đến == "" ||
            (phiên bản != "HTTP/1.0" && phiên bản != "HTTP/1.1")) {
            ném "mạng http server: request line không hợp lệ";
        };

        đường tệp = đích đến;
        truy vấn = "";
        vị trí truy vấn = tìm chuỗi chính xác(đích đến, "?", 0);
        nếu (vị trí truy vấn != rỗng) {
            đường tệp = con chuỗi(đích đến, 0, vị trí truy vấn);
            truy vấn = con chuỗi(đích đến, vị trí truy vấn + 1, máy ảo lấy độ dài(đích đến));
        };
        nếu (đường tệp == "") { đường tệp = "/"; };

        các phần đầu = {};
        lặp(i = 1; i < máy ảo lấy độ dài(dòng); i++) {
            nếu (dòng[i] != "") {
                dấu hai chấm = tìm chuỗi chính xác(dòng[i], ":", 0);
                nếu (dấu hai chấm == rỗng || dấu hai chấm == 0) {
                    ném "mạng http server: header không hợp lệ";
                };
                khóa = chuỗi thường(bỏ khoảng trắng(
                    con chuỗi(dòng[i], 0, dấu hai chấm)
                ));
                giá trị = bỏ khoảng trắng(
                    con chuỗi(dòng[i], dấu hai chấm + 1, máy ảo lấy độ dài(dòng[i]))
                );
                đặt từ điển(các phần đầu, khóa, giá trị);
            };
        };

        chuyển = chuỗi thường(lấy từ điển(các phần đầu, "transfer-encoding", ""));
        chia khối = chứa chính xác(chuyển, "chunked");
        nội dung chiều dài = 0;
        nội dung chiều dài văn bản = lấy từ điển(các phần đầu, "content-length", "");
        // Content-Length và chunked cùng xuất hiện tạo ambiguity framing. Server
        // đóng connection sau response, nhưng vẫn từ chối message này ngay ở V++.
        nếu (chia khối && nội dung chiều dài văn bản != "") {
            ném "mạng http server: không được gửi cả Transfer-Encoding chunked và Content-Length";
        };
        nếu (!chia khối && nội dung chiều dài văn bản != "") {
            thử {
                nội dung chiều dài = thành số nguyên(nội dung chiều dài văn bản);
            } bắt lỗi (e) {
                ném "mạng http server: Content-Length không hợp lệ";
            };
            nếu (nội dung chiều dài < 0 || nội dung chiều dài > 16777216) {
                ném "mạng http server: Content-Length vượt giới hạn";
            };
        };

        trả về {
            "method": phương thức,
            "path": đường tệp,
            "query": truy vấn,
            "headers": các phần đầu,
            "content length": nội dung chiều dài,
            "chunked": chia khối
        };
    };

    hàm công khai mạng http cắt thân khối theo byte(thân khối, số byte) {
        nếu (số byte == 0) { trả về ""; };
        các byte = chuỗi thành các byte(thân khối, "UTF-8");
        nếu (máy ảo lấy độ dài(các byte) < số byte) {
            ném "mạng http server: body ngắn hơn Content-Length";
        };
        nếu (máy ảo lấy độ dài(các byte) == số byte) { trả về thân khối; };
        đủ = [];
        lặp(i = 0; i < số byte; i++) {
            máy ảo thêm cuối danh sách(đủ, các byte[i]);
        };
        trả về chuỗi từ các byte(đủ, "UTF-8", "BÁO_LỖI");
    };

    hàm riêng tư mạng http đọc yêu cầu đầu nối(mã đầu nối) {
        dữ liệu = "";
        vị trí ngăn = rỗng;
        khi (vị trí ngăn == rỗng) {
            phần = đầu nối nhận(mã đầu nối, 65536);
            nếu (phần == "") {
                nếu (dữ liệu == "") {
                    trả về "";
                };
                ném "mạng http server: kết nối đóng trước khi nhận đủ header";
            };
            dữ liệu = dữ liệu + phần;
            nếu (máy ảo lấy độ dài(chuỗi thành các byte(dữ liệu, "UTF-8")) > 16842752) {
                ném "mạng http server: request vượt giới hạn";
            };
            vị trí ngăn = tìm chuỗi chính xác(dữ liệu, "\r\n\r\n", 0);
        };

        phần đầu = con chuỗi(dữ liệu, 0, vị trí ngăn);
        yêu cầu = mình.mạng http phân tích phần đầu yêu cầu(phần đầu);
        nội dung chiều dài = lấy từ điển(yêu cầu, "content length", 0);
        thân khối = con chuỗi(dữ liệu, vị trí ngăn + 4, máy ảo lấy độ dài(dữ liệu));

        nếu (lấy từ điển(yêu cầu, "chunked", sai)) {
            quét = mình.mạng http quét chia khối(
                thân khối,
                đúng,
                "mạng http server",
                "request"
            );
            khi (!lấy từ điển(quét, "hoàn tất", sai)) {
                phần = đầu nối nhận(mã đầu nối, 65536);
                nếu (phần == "") {
                    ném "mạng http server: kết nối đóng trước khi nhận đủ chunked body";
                };
                thân khối = thân khối + phần;
                nếu (máy ảo lấy độ dài(chuỗi thành các byte(thân khối, "UTF-8")) > 16842752) {
                    ném "mạng http server: body chunked vượt giới hạn 16 MiB + 64 KiB framing";
                };
                quét = mình.mạng http quét chia khối(
                    thân khối,
                    đúng,
                    "mạng http server",
                    "request"
                );
            };
            đặt từ điển(yêu cầu, "body", lấy từ điển(quét, "body", ""));
        } hoặc {
            khi (máy ảo lấy độ dài(chuỗi thành các byte(thân khối, "UTF-8")) < nội dung chiều dài) {
                phần = đầu nối nhận(mã đầu nối, 65536);
                nếu (phần == "") {
                    ném "mạng http server: kết nối đóng trước khi nhận đủ body";
                };
                thân khối = thân khối + phần;
                nếu (máy ảo lấy độ dài(chuỗi thành các byte(thân khối, "UTF-8")) > 16777216) {
                    ném "mạng http server: body vượt giới hạn";
                };
            };
            đặt từ điển(yêu cầu, "body", mình.mạng http cắt thân khối theo byte(thân khối, nội dung chiều dài));
        };
        đặt từ điển(yêu cầu, "socket", mã đầu nối);
        trả về yêu cầu;
    };

    // Chấp nhận connection cho tới khi nhận được một request thật.
    // Client kết nối rồi đóng ngay là nhiễu transport và không được lộ ra API
    // dưới dạng một kiểu giá trị khác với request map.
    hàm công khai mạng lấy yêu cầu kế tiếp(mã máy chủ) {
        lặp(vòng = 0; vòng < 2147483647; vòng++) {
            máy khách = đầu nối chấp nhận(mã máy chủ);
            thử {
                yêu cầu = mình.mạng http đọc yêu cầu đầu nối(máy khách);
                nếu (loại của(yêu cầu) == "chuỗi" && yêu cầu == "") {
                    đầu nối đóng(máy khách);
                    bỏ qua;
                };
                trả về yêu cầu;
            } bắt lỗi (e) {
                thử { đầu nối đóng(máy khách); } bắt lỗi (số mục bỏ qua) {};
                ném e;
            };
        };
        ném "mạng http server: vòng lặp accept đã kết thúc ngoài dự kiến";
    };

    hàm công khai mạng trường yêu cầu(mã yêu cầu, trường, khóa = "") {
        nếu (loại của(mã yêu cầu) != "từ điển") {
            ném "mạng http server: request handle không hợp lệ";
        };
        nếu (trường == "header") {
            các phần đầu = lấy từ điển(mã yêu cầu, "headers", {});
            trả về lấy từ điển(các phần đầu, chuỗi thường(khóa), "");
        };
        nếu (trường == "method" || trường == "path" ||
            trường == "query" || trường == "body") {
            trả về lấy từ điển(mã yêu cầu, trường, "");
        };
        ném "mạng http server: trường yêu cầu không hợp lệ";
    };

    hàm công khai mạng phương thức yêu cầu(mã yêu cầu) {
        trả về mình.mạng trường yêu cầu(mã yêu cầu, "method", "");
    };

    hàm công khai mạng đường tệp yêu cầu(mã yêu cầu) {
        trả về mình.mạng trường yêu cầu(mã yêu cầu, "path", "");
    };

    hàm công khai mạng truy vấn yêu cầu(mã yêu cầu) {
        trả về mình.mạng trường yêu cầu(mã yêu cầu, "query", "");
    };

    hàm công khai mạng thân khối yêu cầu(mã yêu cầu) {
        trả về mình.mạng trường yêu cầu(mã yêu cầu, "body", "");
    };

    hàm công khai mạng phần đầu yêu cầu(mã yêu cầu, khóa tra cứu) {
        trả về mình.mạng trường yêu cầu(mã yêu cầu, "header", khóa tra cứu);
    };

    // Ghi chú hàm: lấy query param theo key.
    hàm công khai mạng truy vấn tham số yêu cầu(mã yêu cầu, khóa tra cứu) {
        truy vấn = mình.mạng truy vấn yêu cầu(mã yêu cầu);
        n = máy ảo lấy độ dài(truy vấn);
        bắt đầu = 0;
        kết quả = "";
        tìm thấy = sai;

        khi (bắt đầu <= n && !tìm thấy) {
            kết thúc = bắt đầu;
            đang quét = đúng;
            lặp(i = bắt đầu; i < n && đang quét; i++) {
                nếu (truy vấn[i] == "&") {
                    đang quét = sai;
                } hoặc {
                    kết thúc = i + 1;
                };
            };

            cặp = cắt chuỗi(truy vấn, bắt đầu, kết thúc - bắt đầu);
            vị trí bằng = -1;
            lặp(i = 0; i < máy ảo lấy độ dài(cặp) && vị trí bằng < 0; i++) {
                nếu (cặp[i] == "=") {
                    vị trí bằng = i;
                };
            };

            nếu (vị trí bằng >= 0) {
                khóa cặp = cắt chuỗi(cặp, 0, vị trí bằng);
                nếu (khóa cặp == khóa tra cứu) {
                    kết quả = cắt chuỗi(
                        cặp,
                        vị trí bằng + 1,
                        máy ảo lấy độ dài(cặp) - vị trí bằng - 1
                    );
                    tìm thấy = đúng;
                };
            } hoặc {
                nếu (cặp == khóa tra cứu) {
                    tìm thấy = đúng;
                };
            };

            nếu (kết thúc >= n) {
                bắt đầu = n + 1;
            } hoặc {
                bắt đầu = kết thúc + 1;
            };
        };
        trả về kết quả;
    };

    // Ghi chú hàm: lấy json field chuỗi từ request body.
    hàm công khai mạng json trường dữ liệu yêu cầu(mã yêu cầu, khóa tra cứu) {
        thân khối = mình.mạng thân khối yêu cầu(mã yêu cầu);
        kết quả = "";
        thử {
            đã phân tích = json phân tích(thân khối);
            nếu (loại của(đã phân tích) == "từ điển") {
                giá trị đang xét = lấy từ điển(đã phân tích, khóa tra cứu, rỗng);
                nếu (loại của(giá trị đang xét) == "chuỗi") {
                    kết quả = giá trị đang xét;
                };
            };
        } bắt lỗi (e) {
            // Giữ contract cũ: JSON lỗi hoặc field không phải chuỗi trả chuỗi rỗng.
            kết quả = "";
        };
        trả về kết quả;
    };

    // Ghi chú hàm: lấy path suffix sau prefix.
    hàm công khai mạng đường tệp hậu tố yêu cầu(mã yêu cầu, tiền tố) {
        đường tệp = mình.mạng đường tệp yêu cầu(mã yêu cầu);
        n tiền tố = máy ảo lấy độ dài(tiền tố);
        nếu (n tiền tố > máy ảo lấy độ dài(đường tệp)) {
            trả về "";
        };
        nếu (cắt chuỗi(đường tệp, 0, n tiền tố) != tiền tố) {
            trả về "";
        };
        trả về cắt chuỗi(đường tệp, n tiền tố, máy ảo lấy độ dài(đường tệp) - n tiền tố);
    };

    hàm riêng tư mạng http trạng thái chữ(mã trạng thái) {
        nếu (mã trạng thái == 200) { trả về "OK"; };
        nếu (mã trạng thái == 201) { trả về "Created"; };
        nếu (mã trạng thái == 400) { trả về "Bad Request"; };
        nếu (mã trạng thái == 401) { trả về "Unauthorized"; };
        nếu (mã trạng thái == 403) { trả về "Forbidden"; };
        nếu (mã trạng thái == 404) { trả về "Not Found"; };
        nếu (mã trạng thái == 405) { trả về "Method Not Allowed"; };
        nếu (mã trạng thái == 409) { trả về "Conflict"; };
        nếu (mã trạng thái == 422) { trả về "Unprocessable Content"; };
        nếu (mã trạng thái == 429) { trả về "Too Many Requests"; };
        nếu (mã trạng thái == 500) { trả về "Internal Server Error"; };
        nếu (mã trạng thái == 502) { trả về "Bad Gateway"; };
        nếu (mã trạng thái == 503) { trả về "Service Unavailable"; };
        trả về "OK";
    };

    hàm công khai mạng http dựng phản hồi(mã trạng thái, thân khối) {
        số byte = máy ảo lấy độ dài(chuỗi thành các byte(thân khối, "UTF-8"));
        trả về "HTTP/1.1 " + thành chuỗi(mã trạng thái) + " " +
                mình.mạng http trạng thái chữ(mã trạng thái) + "\r\n" +
                "Content-Type: application/json; charset=utf-8\r\n" +
                "Content-Length: " + thành chuỗi(số byte) + "\r\n" +
                "Connection: close\r\n\r\n" + thân khối;
    };

    // Gửi response bằng socket primitive rồi đóng connection theo contract cũ.
    hàm công khai mạng trả phản hồi(mã yêu cầu, mã trạng thái, thân khối) {
        nếu (loại của(mã yêu cầu) != "từ điển") {
            ném "mạng http server: request handle không hợp lệ";
        };
        mã đầu nối = lấy từ điển(mã yêu cầu, "socket", 0);
        nếu (mã đầu nối <= 0) {
            ném "mạng http server: request socket đã đóng hoặc không hợp lệ";
        };
        thử {
            phản hồi = mình.mạng http dựng phản hồi(mã trạng thái, thân khối);
            đầu nối gửi(mã đầu nối, phản hồi);
            đầu nối đóng(mã đầu nối);
            đặt từ điển(mã yêu cầu, "socket", 0);
            trả về 1;
        } bắt lỗi (e) {
            thử { đầu nối đóng(mã đầu nối); } bắt lỗi (số mục bỏ qua) {};
            đặt từ điển(mã yêu cầu, "socket", 0);
            ném e;
        };
    };

    hàm công khai mạng đóng máy chủ giao diện lập trình(mã máy chủ) {
        trả về đầu nối đóng(mã máy chủ);
    };
};


