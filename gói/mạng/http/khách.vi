// Client HTTP hướng đối tượng. Dùng chung parser, transport và API hàm hiện có.
// Mỗi instance giữ URL gốc; không sở hữu kết nối socket dùng lâu dài.
nhập gói.mạng.http.máy khách.mạng http phân tích địa chỉ tài nguyên;
nhập gói.mạng.http.máy khách.mạng thực thi yêu cầu;
nhập gói.văn bản.chuỗi.độ dài;
nhập gói.văn bản.chuỗi.con chuỗi;
nhập gói.văn bản.chuỗi.bắt đầu bằng;
nhập gói.văn bản.chuỗi.chứa chính xác;
nhập gói.lõi.giao diện tài nguyên.*;

lớp công khai Khách HTTP triển khai Đóng Được {
    hàm công khai khởi tạo(địa chỉ tài nguyên gốc) {
        nếu (loại của(địa chỉ tài nguyên gốc) != "chuỗi") { ném "khách HTTP: URL gốc phải là chuỗi"; };
        mạng http phân tích địa chỉ tài nguyên(địa chỉ tài nguyên gốc);
        nếu (chứa chính xác(địa chỉ tài nguyên gốc, "?") || chứa chính xác(địa chỉ tài nguyên gốc, "#")) {
            ném "khách HTTP: URL gốc không được chứa query hoặc fragment";
        };
        mình.địa chỉ tài nguyên gốc = địa chỉ tài nguyên gốc;
        mình.đã đóng = sai;
    };

    hàm công khai tạo URL(đường) {
        nếu (mình.đã đóng) { ném "khách HTTP: đã đóng"; };
        nếu (loại của(đường) != "chuỗi") { ném "khách HTTP: đường phải là chuỗi"; };
        nếu (đường == "") { trả về mình.địa chỉ tài nguyên gốc; };
        nếu (bắt đầu bằng(đường, "http://") || bắt đầu bằng(đường, "https://")) {
            ném "khách HTTP: đường tương đối không được là URL tuyệt đối";
        };
        gốc dữ liệu = mình.địa chỉ tài nguyên gốc;
        nếu (đường[0] == "?" || đường[0] == "#") {
            kết quả = gốc dữ liệu + đường;
            mạng http phân tích địa chỉ tài nguyên(kết quả);
            trả về kết quả;
        };
        cuối = gốc dữ liệu[máy ảo lấy độ dài(gốc dữ liệu) - 1] == "/";
        đầu = đường[0] == "/";
        nếu (cuối && đầu) {
            kết quả = gốc dữ liệu + con chuỗi(đường, 1, máy ảo lấy độ dài(đường));
        } hoặc {
            nếu (!cuối && !đầu) { kết quả = gốc dữ liệu + "/" + đường; }
            hoặc { kết quả = gốc dữ liệu + đường; };
        };
        mạng http phân tích địa chỉ tài nguyên(kết quả);
        trả về kết quả;
    };

    hàm công khai yêu cầu(phương thức, đường, dữ liệu = "") {
        nếu (phương thức != "GET" && phương thức != "POST" &&
            phương thức != "PUT" && phương thức != "DELETE") {
            ném "khách HTTP: phương thức không hợp lệ";
        };
        trả về mình.thực thi(phương thức, mình.tạo URL(đường), dữ liệu);
    };

    hàm bảo vệ thực thi(phương thức, địa chỉ tài nguyên, dữ liệu) {
        trả về mạng thực thi yêu cầu(phương thức, địa chỉ tài nguyên, dữ liệu);
    };

    hàm công khai đóng() { mình.đã đóng = đúng; trả về đúng; };

    hàm công khai lấy(đường) {
        trả về mình.yêu cầu("GET", đường);
    };

    hàm công khai gửi(đường, dữ liệu) {
        trả về mình.yêu cầu("POST", đường, dữ liệu);
    };

    hàm công khai cập nhật(đường, dữ liệu) {
        trả về mình.yêu cầu("PUT", đường, dữ liệu);
    };

    hàm công khai xóa(đường) {
        trả về mình.yêu cầu("DELETE", đường);
    };
};
