

// Lớp sở hữu toàn bộ thuật toán của mô-đun; các hàm bên dưới chỉ giữ API cũ.
lớp công khai Vòng Đời Chung {
    hàm công khai khởi tạo() {};

    // Module: ứng dụng.vòng đời
    // Mục đích: hỗ trợ vòng đời ứng dụng (banner, chạy, dừng).
    // Nhóm hàm: banner ứng dụng, chạy ứng dụng, dừng ứng dụng.

    // Ghi chú hàm: banner ứng dụng.
    hàm công khai banner ứng dụng(tên ứng dụng, phiên bản) {
        trả về "[ỨNG DỤNG] " + tên ứng dụng + " v" + phiên bản;
    };

    // Ghi chú hàm: chạy ứng dụng.
    hàm công khai chạy ứng dụng(tên ứng dụng, phiên bản) {
        in mình.banner ứng dụng(tên ứng dụng, phiên bản);
        in "[ỨNG DỤNG] sẵn sàng";
        trả về 1;
    };

    // Ghi chú hàm: dừng ứng dụng.
    hàm công khai dừng ứng dụng(tên ứng dụng) {
        in "[ỨNG DỤNG] dừng " + tên ứng dụng;
        trả về 0;
    };
};


hàm công khai banner ứng dụng(tên ứng dụng, phiên bản) {
    __vpp_adapter = Vòng Đời Chung();
    trả về __vpp_adapter.banner ứng dụng(tên ứng dụng, phiên bản);
};

hàm công khai chạy ứng dụng(tên ứng dụng, phiên bản) {
    __vpp_adapter = Vòng Đời Chung();
    trả về __vpp_adapter.chạy ứng dụng(tên ứng dụng, phiên bản);
};

hàm công khai dừng ứng dụng(tên ứng dụng) {
    __vpp_adapter = Vòng Đời Chung();
    trả về __vpp_adapter.dừng ứng dụng(tên ứng dụng);
};
