// API hướng đối tượng dùng lại các hàm vòng đời hiện hữu.
nhập gói/ứng dụng/giao diện;
nhập gói/ứng dụng/vòng đời;

lớp công khai Bộ Điều Khiển Ứng Dụng triển khai Vòng Đời Ứng Dụng {
    hàm công khai khởi tạo(tên, phiên bản) {
        nếu (loại của(tên) != "chuỗi" || tên == "") {
            ném "ứng dụng: tên phải là chuỗi không rỗng";
        };
        nếu (loại của(phiên bản) != "chuỗi" || phiên bản == "") {
            ném "ứng dụng: phiên bản phải là chuỗi không rỗng";
        };
        mình.tên = tên;
        mình.phiên bản = phiên bản;
        mình.đang chạy = sai;
    };

    hàm công khai biểu ngữ() { trả về biểu ngữ ứng dụng(mình.tên, mình.phiên bản); };

    hàm công khai đang chạy() { trả về mình.đang chạy; };

    hàm công khai chạy() {
        nếu (mình.đang chạy) { trả về sai; };
        chạy ứng dụng(mình.tên, mình.phiên bản);
        mình.đang chạy = đúng;
        trả về đúng;
    };

    hàm công khai dừng() {
        nếu (!mình.đang chạy) { trả về sai; };
        dừng ứng dụng(mình.tên);
        mình.đang chạy = sai;
        trả về đúng;
    };
};
