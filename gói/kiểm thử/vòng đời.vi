

// Lớp sở hữu toàn bộ thuật toán của mô-đun; các hàm bên dưới chỉ giữ API cũ.
lớp công khai Vòng Đời Kiểm Thử {
    hàm công khai khởi tạo() {};

    // Module: kiểm thử.vòng đời
    // Mục đích: wrapper nhỏ cho một ca kiểm thử có setup/teardown.

    // Chạy một ca kiểm thử. `thiếtLập` chạy trước thân khi khác rỗng; `dọnDẹp`
    // luôn chạy sau thân nếu setup đã hoàn tất, kể cả khi thân ném lỗi. Lỗi của thân
    // được ném lại sau cleanup để CLI vẫn đánh dấu tệp kiểm thử là thất bại.
    hàm công khai chạy ca kiểm thử(thân, thiếtLập = rỗng, dọnDẹp = rỗng) {
        nếu (thiếtLập != rỗng) {
            thiếtLập();
        };

        kếtQuả = rỗng;
        thử {
            kếtQuả = thân();
        } bắt lỗi (e) {
            nếu (dọnDẹp != rỗng) {
                dọnDẹp();
            };
            ném e;
        }

        nếu (dọnDẹp != rỗng) {
            dọnDẹp();
        };
        trả về kếtQuả;
    };
};


hàm công khai chạy ca kiểm thử(thân, thiếtLập = rỗng, dọnDẹp = rỗng) {
    __vpp_adapter = Vòng Đời Kiểm Thử();
    trả về __vpp_adapter.chạy ca kiểm thử(thân, thiếtLập, dọnDẹp);
};
