// Chạy nhiều Ca Kiểm Thử và thu thập báo cáo, không thay đổi vòng đời từng ca.
nhập gói.kiểm thử.ca kiểm thử.*;

lớp công khai Bộ Kiểm Thử {
    hàm công khai khởi tạo(dừng khi lỗi = sai) {
        mình.dừng khi lỗi = dừng khi lỗi;
        mình.các ca = [];
        mình.kết quả = [];
    };

    hàm công khai đăng ký(tên, ca) {
        nếu (loại của(tên) != "chuỗi" || tên == "" || ca == rỗng) {
            ném "TEST_ARGUMENT";
        };
        máy ảo thêm cuối danh sách(mình.các ca, {"tên": tên, "ca": ca});
        trả về mình;
    };

    hàm công khai chạy() {
        mình.kết quả = [];
        các ca = mình.các ca;
        kết quả = mình.kết quả;
        lặp(i = 0; i < máy ảo lấy độ dài(các ca); i++) {
            ca = các ca[i]["ca"];
            tên = các ca[i]["tên"];
            thử {
                giá trị = ca.chạy();
                máy ảo thêm cuối danh sách(kết quả, {"tên": tên, "đạt": đúng, "giá trị": giá trị, "lỗi": rỗng});
            } bắt lỗi(e) {
                máy ảo thêm cuối danh sách(kết quả, {"tên": tên, "đạt": sai, "giá trị": rỗng, "lỗi": e});
                nếu (mình.dừng khi lỗi) { thoát; };
            };
        };
        trả về mình.báo cáo();
    };

    hàm công khai báo cáo() {
        kết quả = mình.kết quả;
        đạt = 0;
        lặp(i = 0; i < máy ảo lấy độ dài(kết quả); i++) {
            nếu (kết quả[i]["đạt"]) { đạt += 1; };
        };
        trả về {"tổng": máy ảo lấy độ dài(kết quả), "đạt": đạt,
                "lỗi": máy ảo lấy độ dài(kết quả) - đạt, "kết quả": kết quả};
    };
};
