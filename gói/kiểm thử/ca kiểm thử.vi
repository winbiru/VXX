// Một ca kiểm thử có thể chạy lại, mỗi lần vẫn có setup/cleanup riêng.
nhập gói/kiểm thử/vòng đời;

lớp công khai Ca Kiểm Thử {
    hàm công khai khởi tạo(thân, thiết lập = rỗng, dọn dẹp = rỗng) {
        nếu (thân == rỗng) { ném "TEST_ARGUMENT"; };
        mình.thân = thân;
        mình.thiết lập = thiết lập;
        mình.dọn dẹp = dọn dẹp;
        mình.số lần = 0;
    };

    hàm công khai chạy() {
        mình.số lần = mình.số lần + 1;
        trả về chạy ca kiểm thử(mình.thân, mình.thiết lập, mình.dọn dẹp);
    };

    hàm công khai số lần chạy() { trả về mình.số lần; };
};
