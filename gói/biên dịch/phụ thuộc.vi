// Phân tích đồ thị phụ thuộc dùng snapshot compiler V++ chung.
nhập gói/bộ sưu tập/từ điển;
// vpp.dependencies — phân tích import và kiểm tra đồ thị phụ thuộc bằng compiler V++.

nhập gói/nhập xuất/tệp;
nhập gói/nhập xuất/đường dẫn;
nhập gói/biên dịch/chính;

// Một phiên compiler được dùng chung cho việc kiểm tra và liệt kê import.
lớp công khai Bộ Phân Tích Phụ Thuộc {
    hàm công khai khởi tạo(mã nguồn, thư mục) {
        mình.phiên = Bộ Biên Dịch(mã nguồn, thư mục);
    };

    hàm công khai danh sách() {
        phiên = mình.phiên;
        cây = phiên.cây cú pháp();
        kết quả = [];
        lặp(i = 0; i < máy ảo lấy độ dài(cây); i++) {
            mục = cây[i];
            nếu (lấy từ điển(mục, "loại", "") == "nhập") {
                đích = lấy từ điển(mục, "đích", "");
                nếu (đích != "") {
                    máy ảo thêm cuối danh sách(kết quả, {
                        "tên": đích,
                        "bí danh": lấy từ điển(mục, "bí danh", ""),
                        "công khai": lấy từ điển(mục, "công khai", 0)
                    });
                };
            };
        };
        trả về kết quả;
    };

    hàm công khai kiểm tra() {
        phiên = mình.phiên;
        kết quả = phiên.kiểm tra();
        trả về {
            "hợp lệ": lấy từ điển(kết quả, "hợp lệ", 0),
            "lỗi": lấy từ điển(kết quả, "lỗi", "")
        };
    };
};

hàm công khai phụ thuộc danh sách(mã nguồn) {
    phân tích = Bộ Phân Tích Phụ Thuộc(mã nguồn, ".");
    trả về phân tích.danh sách();
};

hàm công khai phụ thuộc tệp(đường dẫn) {
    phân tích = Bộ Phân Tích Phụ Thuộc(đọc tệp(đường dẫn), ".");
    trả về phân tích.danh sách();
};

hàm công khai phụ thuộc kiểm tra tệp(đường dẫn) {
    phân tích = Bộ Phân Tích Phụ Thuộc(đọc tệp(đường dẫn), đường dẫn cha(đường dẫn));
    trả về phân tích.kiểm tra();
};
