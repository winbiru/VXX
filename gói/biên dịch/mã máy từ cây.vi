// AST thuần V++ -> compiler::IrProgram wire schema -> MachineFunction.
// ABI i32 hỗ trợ AArch64/x86-64 và số tham số động (giới hạn bởi tài nguyên).
// Không gọi snapshot/IR của C++; mọi node ngoài tập hỗ trợ phải báo lỗi.
nhập gói/biên dịch/ngữ nghĩa;
nhập gói/biên dịch/chương trình;
nhập gói/biên dịch/mã máy hạ biểu diễn trung gian;
nhập gói/biên dịch/mã máy;
nhập gói/biên dịch/đối tượng;
nhập gói/bộ sưu tập/từ điển;

// Lớp sở hữu toàn bộ thuật toán của mô-đun; các hàm bên dưới chỉ giữ API cũ.
lớp công khai Bộ Hạ Cây {
    hàm công khai khởi tạo() {};

    hàm riêng tư báo lỗi(thông báo) {
        ném "V++ native AST: " + thông báo;
    };

    // Native ABI v1: giữ tên ASCII thông thường; mã hóa UTF-8 của mọi tên
    // Unicode thành vpp_u_<hex>. Hai tiền tố dành riêng phải được escape
    // thành vpp_a_<hex> để không va chạm với định danh do compiler tạo.
    // Quy tắc này khớp nativeAbiSymbol() trong C++ Stage 0.
    hàm riêng tư mã hóa tên ABI(tên) {
        các byte = chuỗi thành byte máy ảo(tên);
        nếu (máy ảo lấy độ dài(các byte) == 0) {
            mình.báo lỗi("tên symbol native rỗng");
        };
        ascii = đúng;
        đơn giản = đúng;
        lặp (i = 0; i < máy ảo lấy độ dài(các byte); i++) {
            b = các byte[i];
            nếu (b >= 128) { ascii = sai; }
            hoặc nếu (b < 32 || b == 127) {
                mình.báo lỗi("tên symbol native chứa ký tự điều khiển");
            }
            hoặc nếu (!((b >= 65 && b <= 90) || (b >= 97 && b <= 122) ||
                        b == 95 || (i > 0 && b >= 48 && b <= 57))) {
                đơn giản = sai;
            };
        };
        dành riêng = sai;
        nếu (máy ảo lấy độ dài(các byte) >= 6) {
            dành riêng = các byte[0] == 118 && các byte[1] == 112 &&
                        các byte[2] == 112 && các byte[3] == 95 &&
                        (các byte[4] == 117 || các byte[4] == 97) &&
                        các byte[5] == 95;
        };
        nếu (ascii && đơn giản && !dành riêng) { trả về tên; };
        bảng = "0123456789abcdef";
        kết quả = "vpp_u_";
        nếu (ascii && đơn giản && dành riêng) { kết quả = "vpp_a_"; };
        lặp (i = 0; i < máy ảo lấy độ dài(các byte); i++) {
            b = các byte[i];
            kết quả += bảng[(b - b % 16) / 16] + bảng[b % 16];
        };
        trả về kết quả;
    };

    // Symbol ID đã được semantic binding. Chỉ đổi tên xuất object và CALL
    // trước khi lower; mọi định danh trong mã nguồn vẫn giữ nguyên có dấu.
    hàm riêng tư chuẩn hóa ABI(IR) {
        các hàm = IR["functions"];
        lặp (i = 0; i < máy ảo lấy độ dài(các hàm); i++) {
            các hàm[i]["name"] = mình.mã hóa tên ABI(các hàm[i]["name"]);
        };
    };

    // ABI native dùng handle i32, byte i32; không đưa con trỏ C qua V++.
    // Mọi tên ở đây phải khớp whitelist trong mã máy hạ ir.vi.
    hàm riêng tư tra ABI hệ thống(tên) {
        nếu (tên == "đọc số") { trả về {"symbol": "vpp_native_read_i32", "arity": 0}; };
        nếu (tên == "trạng thái đọc") { trả về {"symbol": "vpp_native_read_status", "arity": 0}; };
        nếu (tên == "byte mới") { trả về {"symbol": "vpp_native_bytes_new", "arity": 0}; };
        nếu (tên == "byte thêm") { trả về {"symbol": "vpp_native_bytes_append", "arity": 2}; };
        nếu (tên == "byte nối") { trả về {"symbol": "vpp_native_bytes_concat", "arity": 2}; };
        nếu (tên == "byte bằng") { trả về {"symbol": "vpp_native_bytes_equal", "arity": 2}; };
        nếu (tên == "byte cắt") { trả về {"symbol": "vpp_native_bytes_slice", "arity": 3}; };
        nếu (tên == "byte tìm") { trả về {"symbol": "vpp_native_bytes_find", "arity": 2}; };
        nếu (tên == "byte làm rỗng") { trả về {"symbol": "vpp_native_bytes_clear", "arity": 1}; };
        nếu (tên == "byte in") { trả về {"symbol": "vpp_native_bytes_print", "arity": 1}; };
        nếu (tên == "byte dài") { trả về {"symbol": "vpp_native_bytes_length", "arity": 1}; };
        nếu (tên == "byte lấy") { trả về {"symbol": "vpp_native_bytes_get", "arity": 2}; };
        nếu (tên == "byte đẩy số nguyên ba mươi hai bit") { trả về {"symbol": "vpp_native_bytes_push_i32", "arity": 2}; };
        nếu (tên == "byte đọc số nguyên ba mươi hai bit") { trả về {"symbol": "vpp_native_bytes_load_i32", "arity": 2}; };
        nếu (tên == "byte ghi số nguyên ba mươi hai bit") { trả về {"symbol": "vpp_native_bytes_store_i32", "arity": 3}; };
        nếu (tên == "byte hủy") { trả về {"symbol": "vpp_native_bytes_free", "arity": 1}; };
        nếu (tên == "tệp mở đọc") { trả về {"symbol": "vpp_native_file_open_read", "arity": 1}; };
        nếu (tên == "tệp mở ghi") { trả về {"symbol": "vpp_native_file_open_write", "arity": 1}; };
        nếu (tên == "tệp đọc byte") { trả về {"symbol": "vpp_native_file_read_byte", "arity": 1}; };
        nếu (tên == "tệp ghi byte") { trả về {"symbol": "vpp_native_file_write_byte", "arity": 2}; };
        nếu (tên == "tệp đọc khối") { trả về {"symbol": "vpp_native_file_read_block", "arity": 2}; };
        nếu (tên == "tệp ghi khối") { trả về {"symbol": "vpp_native_file_write_block", "arity": 2}; };
        nếu (tên == "tệp đóng") { trả về {"symbol": "vpp_native_file_close", "arity": 1}; };
        nếu (tên == "đối số đếm") { trả về {"symbol": "vpp_native_argc", "arity": 0}; };
        nếu (tên == "đối số lấy") { trả về {"symbol": "vpp_native_argv", "arity": 1}; };
        nếu (tên == "liên kết macho") { trả về {"symbol": "vpp_native_link_macho", "arity": 3}; };
        nếu (tên == "liên kết đối tượng") { trả về {"symbol": "vpp_native_link_macho_modules", "arity": 3}; };
        nếu (tên == "bộ nhớ đệm đọc") { trả về {"symbol": "vpp_native_cache_read", "arity": 2}; };
        nếu (tên == "bộ nhớ đệm ghi") { trả về {"symbol": "vpp_native_cache_write", "arity": 2}; };
        nếu (tên == "máy đọc byte") { trả về {"symbol": "vpp_native_memory_read_byte", "arity": 1}; };
        nếu (tên == "máy ghi byte") { trả về {"symbol": "vpp_native_memory_write_byte", "arity": 2}; };
        nếu (tên == "máy đọc số nguyên ba mươi hai bit") { trả về {"symbol": "vpp_native_memory_read_i32", "arity": 1}; };
        nếu (tên == "máy ghi số nguyên ba mươi hai bit") { trả về {"symbol": "vpp_native_memory_write_i32", "arity": 2}; };
        nếu (tên == "máy gắn địa chỉ") { trả về {"symbol": "vpp_native_memory_bind", "arity": 2}; };
        nếu (tên == "máy mở") { trả về {"symbol": "vpp_native_os_open", "arity": 2}; };
        nếu (tên == "máy đọc") { trả về {"symbol": "vpp_native_os_read", "arity": 3}; };
        nếu (tên == "máy ghi") { trả về {"symbol": "vpp_native_os_write", "arity": 3}; };
        nếu (tên == "máy đóng") { trả về {"symbol": "vpp_native_os_close", "arity": 1}; };
        nếu (tên == "máy lỗi") { trả về {"symbol": "vpp_native_os_errno", "arity": 0}; };
        nếu (tên == "máy đối số dài") { trả về {"symbol": "vpp_native_os_argument_length", "arity": 1}; };
        nếu (tên == "máy đối số byte") { trả về {"symbol": "vpp_native_os_argument_byte", "arity": 2}; };
        nếu (tên == "máy chia số nguyên ba mươi hai bit") { trả về {"symbol": "vpp_native_i32_div", "arity": 2}; };
        nếu (tên == "máy thư mục nhà") { trả về {"symbol": "vpp_native_os_home", "arity": 1}; };
        nếu (tên == "máy thư mục hiện hành") { trả về {"symbol": "vpp_native_os_cwd", "arity": 1}; };
        nếu (tên == "máy tạm mở") { trả về {"symbol": "vpp_native_os_mkstemp", "arity": 1}; };
        nếu (tên == "máy đổi tên") { trả về {"symbol": "vpp_native_os_rename", "arity": 2}; };
        nếu (tên == "máy khởi chạy clang") { trả về {"symbol": "vpp_native_os_spawn_clang", "arity": 1}; };
        nếu (tên == "máy đợi") { trả về {"symbol": "vpp_native_os_waitpid", "arity": 2}; };
        nếu (tên == "máy thông tin tệp") { trả về {"symbol": "vpp_native_os_stat", "arity": 2}; };
        nếu (tên == "máy thông tin liên kết") { trả về {"symbol": "vpp_native_os_lstat", "arity": 2}; };
        nếu (tên == "máy quyền chạy") { trả về {"symbol": "vpp_native_os_access_exec", "arity": 1}; };
        nếu (tên == "máy xóa") { trả về {"symbol": "vpp_native_os_unlink", "arity": 1}; };
        nếu (tên == "máy giá trị môi trường lấy") { trả về {"symbol": "vpp_native_os_env_copy", "arity": 2}; };
        nếu (tên == "máy tệp thực thi lấy") { trả về {"symbol": "vpp_native_os_executable_path", "arity": 1}; };
        nếu (tên == "máy tạo thư mục") { trả về {"symbol": "vpp_native_os_mkdir", "arity": 1}; };
        nếu (tên == "máy thông tin tệp mở") { trả về {"symbol": "vpp_native_os_fstat", "arity": 2}; };
        nếu (tên == "máy sha bắt đầu") { trả về {"symbol": "vpp_native_sha_begin", "arity": 0}; };
        nếu (tên == "máy sha nạp") { trả về {"symbol": "vpp_native_sha_update", "arity": 2}; };
        nếu (tên == "máy sha kết") { trả về {"symbol": "vpp_native_sha_end", "arity": 1}; };
        nếu (tên == "máy báo cáo bộ nhớ đệm") { trả về {"symbol": "vpp_native_os_register_cache_report", "arity": 0}; };
        nếu (tên == "môi trường thực thi nguồn") { trả về {"symbol": "vpp_native_runtime_module_path", "arity": 0}; };
        trả về rỗng;
    };

    hàm riêng tư tên hệ thống dành riêng(tên) {
        nếu (mình.tra ABI hệ thống(tên) != rỗng || tên == "vpp_native_print_i32") {
            trả về đúng;
        };
        các tên = ["vpp_native_read_i32", "vpp_native_read_status",
                    "vpp_native_bytes_new", "vpp_native_bytes_append",
                    "vpp_native_bytes_concat", "vpp_native_bytes_equal", "vpp_native_bytes_print",
                    "vpp_native_bytes_slice", "vpp_native_bytes_find", "vpp_native_bytes_clear",
                    "vpp_native_bytes_length", "vpp_native_bytes_get",
                    "vpp_native_bytes_free", "vpp_native_file_open_read",
                    "vpp_native_file_open_write", "vpp_native_file_read_byte",
                    "vpp_native_file_write_byte", "vpp_native_file_close"];
        máy ảo thêm cuối danh sách(các tên, "vpp_native_file_read_block");
        máy ảo thêm cuối danh sách(các tên, "vpp_native_file_write_block");
        máy ảo thêm cuối danh sách(các tên, "vpp_native_bytes_push_i32");
        máy ảo thêm cuối danh sách(các tên, "vpp_native_bytes_load_i32");
        máy ảo thêm cuối danh sách(các tên, "vpp_native_bytes_store_i32");
        máy ảo thêm cuối danh sách(các tên, "vpp_native_argc");
        máy ảo thêm cuối danh sách(các tên, "vpp_native_argv");
        máy ảo thêm cuối danh sách(các tên, "vpp_native_link_macho");
        máy ảo thêm cuối danh sách(các tên, "vpp_native_link_macho_modules");
        máy ảo thêm cuối danh sách(các tên, "vpp_native_cache_read");
        máy ảo thêm cuối danh sách(các tên, "vpp_native_cache_write");
        máy ảo thêm cuối danh sách(các tên, "vpp_native_memory_read_byte");
        máy ảo thêm cuối danh sách(các tên, "vpp_native_memory_write_byte");
        máy ảo thêm cuối danh sách(các tên, "vpp_native_memory_read_i32");
        máy ảo thêm cuối danh sách(các tên, "vpp_native_memory_write_i32");
        máy ảo thêm cuối danh sách(các tên, "vpp_native_memory_bind");
        máy ảo thêm cuối danh sách(các tên, "vpp_native_os_open");
        máy ảo thêm cuối danh sách(các tên, "vpp_native_os_read");
        máy ảo thêm cuối danh sách(các tên, "vpp_native_os_write");
        máy ảo thêm cuối danh sách(các tên, "vpp_native_os_close");
        máy ảo thêm cuối danh sách(các tên, "vpp_native_os_errno");
        máy ảo thêm cuối danh sách(các tên, "vpp_native_os_argument_length");
        máy ảo thêm cuối danh sách(các tên, "vpp_native_os_argument_byte");
        máy ảo thêm cuối danh sách(các tên, "vpp_native_i32_div");
        máy ảo thêm cuối danh sách(các tên, "vpp_native_os_home");
        máy ảo thêm cuối danh sách(các tên, "vpp_native_os_cwd");
        máy ảo thêm cuối danh sách(các tên, "vpp_native_os_mkstemp");
        máy ảo thêm cuối danh sách(các tên, "vpp_native_os_rename");
        máy ảo thêm cuối danh sách(các tên, "vpp_native_os_spawn_clang");
        máy ảo thêm cuối danh sách(các tên, "vpp_native_os_waitpid");
        máy ảo thêm cuối danh sách(các tên, "vpp_native_runtime_module_path");
        lặp (i = 0; i < máy ảo lấy độ dài(các tên); i++) {
            nếu (tên == các tên[i]) { trả về đúng; };
        };
        trả về sai;
    };

    hàm riêng tư cấp mã ký hiệu(trạng thái) {
        mã định danh = trạng thái["nextId"];
        trạng thái["nextId"] = mã định danh + 1;
        trả về mã định danh;
    };

    hàm riêng tư mở phạm vi(trạng thái) {
        máy ảo thêm cuối danh sách(trạng thái["scopes"], {});
    };

    hàm riêng tư đóng phạm vi(trạng thái) {
        phạm vi = trạng thái["scopes"];
        máy ảo xóa vị trí danh sách(phạm vi, máy ảo lấy độ dài(phạm vi) - 1);
    };

    hàm riêng tư tìm biến(trạng thái, tên) {
        phạm vi = trạng thái["scopes"];
        lặp (i = máy ảo lấy độ dài(phạm vi) - 1; i >= 0; i--) {
            mã định danh = lấy từ điển(phạm vi[i], tên, -1);
            nếu (mã định danh != -1) { trả về mã định danh; };
        };
        trả về -1;
    };

    hàm riêng tư khai biến(trạng thái, tên) {
        phạm vi = trạng thái["scopes"];
        hiện tại = phạm vi[máy ảo lấy độ dài(phạm vi) - 1];
        nếu (lấy từ điển(hiện tại, tên, -1) != -1) {
            mình.báo lỗi("trùng biến/tham số: " + tên);
        };
        mã định danh = mình.cấp mã ký hiệu(trạng thái);
        hiện tại[tên] = mã định danh;
        trả về mã định danh;
    };

    hàm riêng tư thêm giá trị IR(trạng thái, mã thao tác, văn bản = "", các mã phép toán = rỗng, mục ký hiệu = -1, lời triệu hồi = "Invalid") {
        nếu (các mã phép toán == rỗng) { các mã phép toán = []; };
        danh sách = trạng thái["values"];
        máy ảo thêm cuối danh sách(danh sách, {"opcode": mã thao tác, "text": văn bản, "operands": các mã phép toán,
                         "symbolId": mục ký hiệu, "callTarget": lời triệu hồi});
        trả về máy ảo lấy độ dài(danh sách) - 1;
    };

    hàm riêng tư tạo câu IR(mã thao tác, các gốc = rỗng, các con = rỗng, mục ký hiệu = -1,
                              biểu thức điều kiện = "Unstructured", vòng = "Unstructured") {
        nếu (các gốc == rỗng) { các gốc = []; };
        nếu (các con == rỗng) { các con = []; };
        trả về {"opcode": mã thao tác, "roots": các gốc, "children": các con,
                "symbolId": mục ký hiệu, "unsupported": sai,
                "conditionalForm": biểu thức điều kiện, "loopForm": vòng};
    };

    hàm riêng tư nạp biến(trạng thái, cây) {
        nếu (lấy từ điển(cây, "loại", "") != "tên") {
            mình.báo lỗi("phép gán i32 yêu cầu biến cục bộ");
        };
        tên = cây["giá trị"];
        mã định danh = mình.tìm biến(trạng thái, tên);
        nếu (mã định danh == -1) { mình.báo lỗi("biến chưa khai báo: " + tên); };
        trả về mình.thêm giá trị IR(trạng thái, "LoadName", tên, [], mã định danh);
    };

    hàm riêng tư hạ biểu thức(trạng thái, cây, sâu = 0) {
        nếu (sâu >= 64 || cây == rỗng) { mình.báo lỗi("biểu thức i32 rỗng hoặc quá sâu"); };
        loại = lấy từ điển(cây, "loại", "");
        chọn (loại) {
            ca "hằng": {
                kiểu = lấy từ điển(cây, "kiểu", "");
                văn bản = cây["giá trị"];
                nếu (kiểu == "số nguyên") {
                    trả về mình.thêm giá trị IR(trạng thái, "ConstInt", văn bản);
                };
                nếu (kiểu == "chuỗi") {
                    // Chuỗi literal native là handle tới bộ đệm UTF-8, do caller giải phóng.
                    trả về mình.thêm giá trị IR(trạng thái, "ConstString", văn bản);
                };
                nếu (văn bản == "đúng" || văn bản == "sai") {
                    trả về mình.thêm giá trị IR(trạng thái, "ConstBool", văn bản);
                };
                mình.báo lỗi("chưa hỗ trợ hằng khác i32/bool: " + văn bản);
            }
            ca "tên": { trả về mình.nạp biến(trạng thái, cây); }
            ca "một ngôi": {
                mã phép toán = cây["toán tử"];
                nếu (mã phép toán != "+" && mã phép toán != "-" && mã phép toán != "!") {
                    mình.báo lỗi("toán tử một ngôi chưa hỗ trợ: " + mã phép toán);
                };
                trong = mình.hạ biểu thức(trạng thái, cây["toán hạng"], sâu + 1);
                trả về mình.thêm giá trị IR(trạng thái, "Unary", mã phép toán, [trong]);
            }
            ca "hai ngôi": {
                mã phép toán = cây["toán tử"];
                nếu (mã phép toán == "=" || mã phép toán == "+=" || mã phép toán == "-=" ||
                    mã phép toán == "*=" || mã phép toán == "/=" || mã phép toán == "%=") {
                    toán hạng trái = mình.nạp biến(trạng thái, cây["trái"]);
                    toán hạng phải = mình.hạ biểu thức(trạng thái, cây["phải"], sâu + 1);
                    nếu (mã phép toán != "=") {
                        toán = "+";
                        nếu (mã phép toán == "-=") { toán = "-"; };
                        nếu (mã phép toán == "*=") { toán = "*"; };
                        nếu (mã phép toán == "/=") { toán = "/"; };
                        nếu (mã phép toán == "%=") { toán = "%"; };
                        toán hạng phải = mình.thêm giá trị IR(trạng thái, "Binary", toán, [toán hạng trái, toán hạng phải]);
                    };
                    trả về mình.thêm giá trị IR(trạng thái, "StoreName", "=", [toán hạng trái, toán hạng phải]);
                };
                nếu (mã phép toán != "+" && mã phép toán != "-" && mã phép toán != "*" &&
                    mã phép toán != "/" && mã phép toán != "%" && mã phép toán != "==" &&
                    mã phép toán != "!=" && mã phép toán != "<" && mã phép toán != "<=" && mã phép toán != ">" && mã phép toán != ">=") {
                    mình.báo lỗi("toán tử i32 chưa hỗ trợ: " + mã phép toán);
                };
                trái = mình.hạ biểu thức(trạng thái, cây["trái"], sâu + 1);
                phải = mình.hạ biểu thức(trạng thái, cây["phải"], sâu + 1);
                trả về mình.thêm giá trị IR(trạng thái, "Binary", mã phép toán, [trái, phải]);
            }
            ca "cập nhật": {
                toán hạng trái = mình.nạp biến(trạng thái, cây["đối tượng"]);
                một = mình.thêm giá trị IR(trạng thái, "ConstInt", "1");
                mã phép toán = cây["toán tử"];
                nếu (mã phép toán != "++" && mã phép toán != "--") { mình.báo lỗi("cập nhật chưa hỗ trợ: " + mã phép toán); };
                phép = "+";
                nếu (mã phép toán == "--") { phép = "-"; };
                toán hạng phải = mình.thêm giá trị IR(trạng thái, "Binary", phép, [toán hạng trái, một]);
                // Postfix dùng được trong vị trí statement/update của vòng lặp.
                trả về mình.thêm giá trị IR(trạng thái, "StoreName", "=", [toán hạng trái, toán hạng phải]);
            }
            ca "gọi": {
                đích = cây["hàm"];
                nếu (lấy từ điển(đích, "loại", "") != "tên") {
                    mình.báo lỗi("chỉ hỗ trợ gọi hàm trực tiếp");
                };
                tên = đích["giá trị"];
                nếu (mình.tìm biến(trạng thái, tên) != -1) {
                    mình.báo lỗi("không thể gọi biến cục bộ như hàm: " + tên);
                };
                abi = mình.tra ABI hệ thống(tên);
                nếu (abi != rỗng) {
                    các đối số = cây["đối số"];
                    nếu (máy ảo lấy độ dài(các đối số) != abi["arity"]) {
                        nếu (abi["arity"] == 0) {
                            mình.báo lỗi("runtime native không nhận đối số: " + tên);
                        };
                        mình.báo lỗi("runtime native sai số đối số: " + tên);
                    };
                    các mã phép toán = [];
                    lặp (i = 0; i < máy ảo lấy độ dài(các đối số); i++) {
                        máy ảo thêm cuối danh sách(các mã phép toán, mình.hạ biểu thức(trạng thái, các đối số[i], sâu + 1));
                    };
                    trả về mình.thêm giá trị IR(trạng thái, "Call", abi["symbol"], các mã phép toán,
                                                         -1, "NativeRuntime");
                };
                mã định danh = lấy từ điển(trạng thái["functions"], tên, -1);
                nếu (mã định danh == -1) { mình.báo lỗi("hàm chưa định nghĩa: " + tên); };
                các đối số = cây["đối số"];
                nếu (máy ảo lấy độ dài(các đối số) != lấy từ điển(trạng thái["arity"], tên, -1)) {
                    mình.báo lỗi("sai số đối số hàm: " + tên);
                };
                các mã phép toán = [mình.thêm giá trị IR(trạng thái, "LoadName", tên, [], mã định danh)];
                lặp (i = 0; i < máy ảo lấy độ dài(các đối số); i++) {
                    máy ảo thêm cuối danh sách(các mã phép toán, mình.hạ biểu thức(trạng thái, các đối số[i], sâu + 1));
                };
                trả về mình.thêm giá trị IR(trạng thái, "Call", "", các mã phép toán, mã định danh, "DirectFunction");
            }
            mặc định: { mình.báo lỗi("biểu thức chưa hỗ trợ: " + loại); }
        };
    };

    hàm riêng tư hạ câu lệnh(trạng thái, cây, sâu = 0) {
        nếu (sâu >= 64) { mình.báo lỗi("khối lồng quá 64 tầng"); };
        loại = lấy từ điển(cây, "loại", "");
        chọn (loại) {
            ca "trống": { trả về mình.tạo câu IR("NoOp"); }
            ca "khối": {
                mình.mở phạm vi(trạng thái);
                con = [];
                các câu = cây["câu lệnh"];
                lặp (i = 0; i < máy ảo lấy độ dài(các câu); i++) {
                    máy ảo thêm cuối danh sách(con, mình.hạ câu lệnh(trạng thái, các câu[i], sâu + 1));
                };
                mình.đóng phạm vi(trạng thái);
                trả về mình.tạo câu IR("Block", [], con);
            }
            ca "biến": {
                tên = cây["tên"];
                mã định danh = mình.khai biến(trạng thái, tên);
                nếu (cây["giá trị"] == rỗng) { mình.báo lỗi("biến i32 cần giá trị khởi tạo: " + tên); };
                giá trị = mình.hạ biểu thức(trạng thái, cây["giá trị"]);
                trả về mình.tạo câu IR("DeclareVariable", [giá trị], [], mã định danh);
            }
            ca "biểu thức": {
                mã định danh = mình.hạ biểu thức(trạng thái, cây["biểu thức"]);
                trả về mình.tạo câu IR("Statement", [mã định danh]);
            }
            ca "in": {
                // Native print ABI nhận i32; literal UTF-8 là handle, không
                // thể tự động coi handle đó là chuỗi in ra console.
                biểu thức = cây["biểu thức"];
                nếu (lấy từ điển(biểu thức, "loại", "") == "hằng" &&
                    lấy từ điển(biểu thức, "kiểu", "") == "chuỗi") {
                    mình.báo lỗi("in chuỗi native chưa hỗ trợ");
                };
                mã định danh = mình.hạ biểu thức(trạng thái, cây["biểu thức"]);
                trả về mình.tạo câu IR("Print", [mã định danh]);
            }
            ca "trả về": {
                mã định danh = mình.hạ biểu thức(trạng thái, cây["biểu thức"]);
                trả về mình.tạo câu IR("Return", [mã định danh]);
            }
            ca "nếu": {
                biểu thức điều kiện = mình.hạ biểu thức(trạng thái, cây["điều kiện"]);
                con = [mình.hạ câu lệnh(trạng thái, cây["thân"], sâu + 1)];
                dạng = "IfBlock";
                nếu (cây["nhánh khác"] != rỗng) {
                    máy ảo thêm cuối danh sách(con, mình.hạ câu lệnh(trạng thái, cây["nhánh khác"], sâu + 1));
                    dạng = "IfElseBlocks";
                };
                trả về mình.tạo câu IR("Conditional", [biểu thức điều kiện], con, -1, dạng);
            }
            ca "lặp": {
                mình.mở phạm vi(trạng thái);
                nếu (lấy từ điển(cây, "dạng", "") == "khi") {
                    cond = mình.hạ biểu thức(trạng thái, cây["điều kiện"]);
                    thân = mình.hạ câu lệnh(trạng thái, cây["thân"], sâu + 1);
                    mình.đóng phạm vi(trạng thái);
                    trả về mình.tạo câu IR("Loop", [cond], [thân], -1,
                                               "Unstructured", "WhileBlock");
                };
                bước khởi tạo = cây["khởi tạo"];
                nếu (bước khởi tạo != rỗng && lấy từ điển(bước khởi tạo, "loại", "") == "hai ngôi" &&
                    lấy từ điển(bước khởi tạo, "toán tử", "") == "=" &&
                    lấy từ điển(bước khởi tạo["trái"], "loại", "") == "tên") {
                    tên = bước khởi tạo["trái"]["giá trị"];
                    nếu (mình.tìm biến(trạng thái, tên) == -1) {
                        mình.khai biến(trạng thái, tên);
                    };
                };
                init = mình.thêm giá trị IR(trạng thái, "ConstInt", "0");
                nếu (bước khởi tạo != rỗng) { init = mình.hạ biểu thức(trạng thái, bước khởi tạo); };
                cond = mình.thêm giá trị IR(trạng thái, "ConstBool", "đúng");
                nếu (cây["điều kiện"] != rỗng) { cond = mình.hạ biểu thức(trạng thái, cây["điều kiện"]); };
                bước cập nhật = mình.thêm giá trị IR(trạng thái, "ConstInt", "0");
                nếu (cây["cập nhật"] != rỗng) { bước cập nhật = mình.hạ biểu thức(trạng thái, cây["cập nhật"]); };
                thân = mình.hạ câu lệnh(trạng thái, cây["thân"], sâu + 1);
                mình.đóng phạm vi(trạng thái);
                trả về mình.tạo câu IR("Loop", [init, cond, bước cập nhật], [thân], -1,
                                           "Unstructured", "ForBlock");
            }
            ca "thoát": { trả về mình.tạo câu IR("Break"); }
            ca "bỏ qua": { trả về mình.tạo câu IR("Continue"); }
            mặc định: { mình.báo lỗi("câu lệnh native chưa hỗ trợ: " + loại); }
        };
    };

    // Đây là IR đầu vào độc lập cho bộ hạ native V++, không phải bytecode VM.
    hàm công khai tạo IR(mã nguồn) {
        cây = biên dịch phân tích ngữ nghĩa thuần(mã nguồn);
        trạng thái = {"values": [], "nextId": 1, "functions": {}, "arity": {}, "scopes": []};
        câu lệnh = cây["câu lệnh"];
        lặp (i = 0; i < máy ảo lấy độ dài(câu lệnh); i++) {
            khai báo = câu lệnh[i];
            nếu (khai báo["loại"] != "hàm") {
                mình.báo lỗi("chỉ nhận khai báo hàm cấp chương trình");
            };
            tên = khai báo["tên"];
            nếu (mình.tên hệ thống dành riêng(tên)) {
                mình.báo lỗi("tên hàm dành riêng cho hệ thống: " + tên);
            };
            nếu (lấy từ điển(trạng thái["functions"], tên, -1) != -1) {
                mình.báo lỗi("trùng tên hàm: " + tên);
            };
            trạng thái["functions"][tên] = mình.cấp mã ký hiệu(trạng thái);
            trạng thái["arity"][tên] = máy ảo lấy độ dài(khai báo["tham số"]);
        };
        các hàm = [];
        lặp (i = 0; i < máy ảo lấy độ dài(câu lệnh); i++) {
            danh sách hàm cây cú pháp = câu lệnh[i];
            trạng thái["scopes"] = [];
            mình.mở phạm vi(trạng thái);
            tham số = [];
            danh sách = danh sách hàm cây cú pháp["tham số"];
            mặc định = lấy từ điển(danh sách hàm cây cú pháp, "mặc định tham số", []);
            lặp (j = 0; j < máy ảo lấy độ dài(danh sách); j++) {
                nếu (j < máy ảo lấy độ dài(mặc định)) {
                    nếu (mặc định[j] != rỗng) {
                        mình.báo lỗi("tham số mặc định chưa hỗ trợ trong ABI i32");
                    };
                };
                mã định danh = mình.khai biến(trạng thái, danh sách[j]);
                máy ảo thêm cuối danh sách(tham số, {"symbolId": mã định danh, "hasDefault": sai});
            };
            thân = mình.hạ câu lệnh(trạng thái, danh sách hàm cây cú pháp["thân"]);
            máy ảo thêm cuối danh sách(các hàm, {"opcode": "DefineFunction", "name": danh sách hàm cây cú pháp["tên"],
                            "symbolId": trạng thái["functions"][danh sách hàm cây cú pháp["tên"]],
                            "parameters": tham số, "roots": [], "children": [thân],
                            "unsupported": sai});
        };
        trả về {"values": trạng thái["values"], "functions": các hàm};
    };

    // Pipeline độc lập: nguồn .vi -> AST -> IR -> Machine IR -> ISA bytes.
    hàm công khai sinh mã hàm(mã nguồn, tên hàm, kiến trúc, hệ điều hành = "linux") {
        nếu (kiến trúc != "aarch64" && kiến trúc != "x86_64") {
            mình.báo lỗi("backend tổng quát chỉ hỗ trợ aarch64/x86_64");
        };
        biểu diễn trung gian = mình.tạo IR(mã nguồn);
        mình.chuẩn hóa ABI(biểu diễn trung gian);
        máy = biên dịch máy hạ IR(biểu diễn trung gian, mình.mã hóa tên ABI(tên hàm));
        phát = biên dịch mã máy hàm(kiến trúc, máy, hệ điều hành);
        trả về {"ir": biểu diễn trung gian, "machine": máy, "bytes": phát["bytes"],
                "relocations": phát["relocations"]};
    };

    hàm công khai tạo đối tượng hàm(mã nguồn, tên hàm, kiến trúc,
                                       hệ điều hành = "linux", abi = "gnu") {
        kết quả = mình.sinh mã hàm(mã nguồn, tên hàm, kiến trúc, hệ điều hành);
        kết quả["object"] = biên dịch đối tượng(kiến trúc, hệ điều hành, abi,
            kết quả["bytes"], mình.mã hóa tên ABI(tên hàm), kết quả["relocations"]);
        trả về kết quả;
    };

    // Cả chương trình dùng chung một lần parse, semantic và IR; mỗi hàm
    // giữ object/relocation riêng để host linker xử lý các lời gọi chéo.
    hàm công khai tạo đối tượng chương trình(mã nguồn, kiến trúc,
                                             hệ điều hành = "linux", abi = "gnu") {
        nếu (kiến trúc != "aarch64" && kiến trúc != "x86_64") {
            mình.báo lỗi("backend tổng quát chỉ hỗ trợ aarch64/x86_64");
        };
        biểu diễn trung gian = mình.tạo IR(mã nguồn);
        các hàm = biểu diễn trung gian["functions"];
        // Đổi symbol sau khi semantic đã binding bằng symbolId. Nhờ vậy cả
        // hàm đích và CALL tới 'chính' cùng hạ thành ABI symbol 'main'.
        có chính = sai;
        có main = sai;
        lặp (i = 0; i < máy ảo lấy độ dài(các hàm); i++) {
            nếu (các hàm[i]["name"] == "main") { có main = đúng; };
            nếu (các hàm[i]["name"] == "chính") { có chính = đúng; };
        };
        nếu (có chính && có main) {
            mình.báo lỗi("không thể khai báo đồng thời main() và chính()");
        };
        lặp (i = 0; i < máy ảo lấy độ dài(các hàm); i++) {
            nếu (các hàm[i]["name"] == "chính") {
                các hàm[i]["name"] = "main";
            } hoặc {
                các hàm[i]["name"] = mình.mã hóa tên ABI(các hàm[i]["name"]);
            };
        };
        kết quả = [];
        lặp (i = 0; i < máy ảo lấy độ dài(các hàm); i++) {
            tên hàm = các hàm[i]["name"];
            máy = biên dịch máy hạ IR(biểu diễn trung gian, tên hàm);
            phát = biên dịch mã máy hàm(kiến trúc, máy, hệ điều hành);
            đối tượng = biên dịch đối tượng(kiến trúc, hệ điều hành, abi,
                phát["bytes"], tên hàm, phát["relocations"]);
            máy ảo thêm cuối danh sách(kết quả, {"name": tên hàm, "machine": máy,
                "bytes": phát["bytes"], "relocations": phát["relocations"],
                "object": đối tượng});
        };
        trả về kết quả;
    };

    // Wire format cho CLI: giữ hợp đồng M:/I:/B:/R:/O: của bridge hiện hữu.
    // CLI chỉ vận chuyển dữ liệu, toàn bộ AST/IR/ISA/object được dựng bằng V++.
    hàm công khai xuất bản ghi(kết quả) {
        chương trình con hiện tại = kết quả["machine"];
        in "M:" + chương trình con hiện tại["parameterCount"] + ":" + chương trình con hiện tại["slotCount"] + ":" + chương trình con hiện tại["maxStackDepth"];
        lệnh = chương trình con hiện tại["instructions"];
        lặp (i = 0; i < máy ảo lấy độ dài(lệnh); i++) {
            mã phép toán = lệnh[i];
            in "I:" + mã phép toán["opcode"] + ":" + mã phép toán["immediate"] + ":" +
                mã phép toán["operand"] + ":" + mã phép toán["depthBefore"] + ":" + mã phép toán["symbol"];
        };
        bảng = "0123456789abcdef";
        byte = kết quả["bytes"];
        thập lục phân = "";
        lặp (i = 0; i < máy ảo lấy độ dài(byte); i++) {
            b = byte[i];
            nếu (b < 0 || b > 255) { mình.báo lỗi("byte ISA ngoài u8"); };
            thập lục phân += bảng[(b - b % 16) / 16] + bảng[b % 16];
        };
        in "B:" + thập lục phân;
        các mục tái định vị = kết quả["relocations"];
        lặp (i = 0; i < máy ảo lấy độ dài(các mục tái định vị); i++) {
            in "R:" + các mục tái định vị[i]["offset"] + ":" + các mục tái định vị[i]["symbol"];
        };
        đối tượng = kết quả["object"];
        thập lục phân = "";
        lặp (i = 0; i < máy ảo lấy độ dài(đối tượng); i++) {
            b = đối tượng[i];
            nếu (b < 0 || b > 255) { mình.báo lỗi("byte object ngoài u8"); };
            thập lục phân += bảng[(b - b % 16) / 16] + bảng[b % 16];
        };
        in "O:" + thập lục phân;
    };
};


hàm công khai tạo IR(mã nguồn) {
    bộ chuyển tiếp = Bộ Hạ Cây();
    trả về bộ chuyển tiếp.tạo IR(mã nguồn);
};

hàm công khai sinh mã hàm(mã nguồn, tên hàm, kiến trúc, hệ điều hành = "linux") {
    bộ chuyển tiếp = Bộ Hạ Cây();
    trả về bộ chuyển tiếp.sinh mã hàm(mã nguồn, tên hàm, kiến trúc, hệ điều hành);
};

hàm công khai tạo đối tượng hàm(mã nguồn, tên hàm, kiến trúc,
                                   hệ điều hành = "linux", abi = "gnu") {
    bộ chuyển tiếp = Bộ Hạ Cây();
    trả về bộ chuyển tiếp.tạo đối tượng hàm(mã nguồn, tên hàm, kiến trúc, hệ điều hành, abi);
};

hàm công khai tạo đối tượng chương trình(mã nguồn, kiến trúc,
                                          hệ điều hành = "linux", abi = "gnu") {
    bộ chuyển tiếp = Bộ Hạ Cây();
    trả về bộ chuyển tiếp.tạo đối tượng chương trình(
        mã nguồn, kiến trúc, hệ điều hành, abi);
};

hàm công khai xuất bản ghi(kết quả) {
    bộ chuyển tiếp = Bộ Hạ Cây();
    trả về bộ chuyển tiếp.xuất bản ghi(kết quả);
};
