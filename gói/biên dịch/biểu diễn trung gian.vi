// Hạ AST parser/semantic V++ thành IR stack-based độc lập với C++.
// Mỗi lệnh dùng {"mã": ..., "giá trị": ...}; lệnh có thứ tự thực thi.
// Những cú pháp chưa lower được phải thất bại ngay tại pass này.
nhập gói/biên dịch/ngữ nghĩa;
nhập gói/biên dịch/chương trình;
nhập gói/biên dịch/biểu thức;
nhập gói/bộ sưu tập/từ điển;
nhập gói/lõi/chuyển kiểu;
nhập gói/lõi/bảng mã;

// Phiên giữ nguồn và cache kết quả riêng; các phương thức nhận tham số giữ API cũ.
lớp công khai Bộ Hạ IR {
    hàm công khai khởi tạo(mã nguồn = "") {
        mình.làm mới(mã nguồn);
    };

    hàm công khai làm mới(mã nguồn) {
        nếu (loại của(mã nguồn) != "chuỗi") {
            ném "Bộ Hạ IR: mã nguồn phải là chuỗi";
        };
        mình.nguồn = mã nguồn;
        mình.kết quả = rỗng;
        trả về mình;
    };

    hàm công khai hạ() {
        nếu (mình.kết quả == rỗng) {
            mình.kết quả = mình.biên dịch hạ IR thuần(mình.nguồn);
        };
        trả về mình.kết quả;
    };

    hàm riêng tư biên dịch IR máy ảo thêm cuối danh sách(lệnh, mã, giá trị) {
        máy ảo thêm cuối danh sách(lệnh, {"mã": mã, "giá trị": giá trị});
    };

    // Thứ tự mã ABI phải khớp bytecode::ForeignAbiType trong foreign.h.
    hàm riêng tư biên dịch IR kiểu ngoại(kiểu) {
        loại = ["void", "i32", "u32", "i64", "u64", "f64", "c_chuỗi",
                "c_đệm_ra", "c_đệm_vào", "c_tệp", "c_thư_mục",
                "c_mục_thư_mục", "c_cờ_con_trỏ", "c_dns", "c_socket"];
        nếu (kiểu == "rỗng") { trả về 0; };
        lặp(i = 0; i < máy ảo lấy độ dài(loại); i++) {
            nếu (loại[i] == kiểu) { trả về i; };
        };
        ném "biên dịch IR: kiểu ABI FFI không hợp lệ '" + kiểu + "'";
    };

    hàm riêng tư biên dịch IR khai ngoại(mục, thư viện, các ngoại) {
        đích = lấy từ điển(thư viện, mục["thư viện"], "");
        nếu (đích == "") {
            ném "biên dịch IR: thư viện FFI chưa khai báo '" + mục["thư viện"] + "'";
        };
        tham số = mục["tham số"];
        kiểu = [];
        đệm = [];
        lặp(i = 0; i < máy ảo lấy độ dài(tham số); i++) {
            p = tham số[i];
            loại = mình.biên dịch IR kiểu ngoại(p["kiểu"]);
            máy ảo thêm cuối danh sách(kiểu, loại);
            nếu (loại == 7 || loại == 8) {
                chiều dài = p["độ dài"];
                đầu = mã điểm unicode(chiều dài[0]);
                tham chiếu = -1;
                cố định = 0;
                nếu (đầu >= 48 && đầu <= 57) {
                    // Semantic đã xác nhận số nguyên dương không vượt 65536.
                    cố định = thành số nguyên(chiều dài);
                } hoặc {
                    lặp(j = 0; j < máy ảo lấy độ dài(tham số); j++) {
                        nếu (tham số[j]["tên"] == chiều dài) { tham chiếu = j; };
                    };
                    nếu (tham chiếu < 0) { ném "biên dịch IR: thiếu tham số độ dài FFI"; };
                };
                máy ảo thêm cuối danh sách(đệm, [i, tham chiếu, cố định]);
            };
        };
        máy ảo thêm cuối danh sách(các ngoại, {"id": máy ảo lấy độ dài(các ngoại), "tên": mục["tên"],
            "thư viện": đích, "ký hiệu": mục["ký hiệu"],
            "tham số": kiểu, "đệm": đệm,
            "kết quả": mình.biên dịch IR kiểu ngoại(mục["kiểu trả về"]),
            "abi": mục["abi"], "khả năng": mục["khả năng"]});
    };

    // Lexer có thể giữ `đối_tượng.thành_viên` trong một token tên.
    // Trả về cặp receiver/member; việc phân biệt alias module xử lý ở emitter.
    hàm công khai biên dịch IR tách thành viên(tên) {
        nhận = "";
        lặp(i = 0; i < máy ảo lấy độ dài(tên); i++) {
            nếu (tên[i] == ".") {
                nếu (nhận == "" || i + 1 >= máy ảo lấy độ dài(tên)) { trả về rỗng; };
                phần = "";
                lặp(j = i + 1; j < máy ảo lấy độ dài(tên); j++) { phần += tên[j]; };
                trả về {"nhận": nhận, "tên": phần};
            };
            nhận += tên[i];
        };
        trả về rỗng;
    };

    hàm riêng tư biên dịch IR lấy thành viên(nút) {
        nếu (lấy từ điển(nút, "loại", "") == "thành viên") {
            gốc dữ liệu = lấy từ điển(nút, "đối tượng", rỗng);
            nếu (lấy từ điển(gốc dữ liệu, "loại", "") != "tên") {
                trả về {"nhận": "", "tên": nút["tên"], "tạm": đúng,
                         "biểu thức nhận": gốc dữ liệu};
            };
            trả về {"nhận": gốc dữ liệu["giá trị"], "tên": nút["tên"]};
        };
        nếu (lấy từ điển(nút, "loại", "") == "tên") {
            trả về mình.biên dịch IR tách thành viên(nút["giá trị"]);
        };
        trả về rỗng;
    };

    // Binding ID thuộc semantic IR, độc lập với tên và function ID của VM.
    // Các biến thông thường dùng scope hàm/global (như C++ SemanticBuilder);
    // mỗi catch có scope từ vựng riêng, kể cả hai catch trùng tên.
    hàm riêng tư biên dịch IR tìm ràng buộc(bảng, tên) {
        lặp(i = 0; i < máy ảo lấy độ dài(bảng); i++) {
            nếu (bảng[i]["tên"] == tên) { trả về bảng[i]["id"]; };
        };
        trả về -1;
    };

    hàm riêng tư biên dịch IR khai ràng buộc(bảng, tên, bộ đếm) {
        mã định danh = mình.biên dịch IR tìm ràng buộc(bảng, tên);
        nếu (mã định danh >= 0) { trả về mã định danh; };
        mã định danh = bộ đếm["tiếp"];
        bộ đếm["tiếp"] = mã định danh + 1;
        máy ảo thêm cuối danh sách(bảng, {"tên": tên, "id": mã định danh});
        trả về mã định danh;
    };

    hàm riêng tư biên dịch IR tên mục(mục) {
        mã = mục["mã"];
        nếu (mã == "ca") {
            nếu (lấy từ điển(mục["giá trị"], "loại", "") == "tên") {
                trả về mục["giá trị"]["giá trị"];
            };
        };
        nếu (mã == "gọi tên" || mã == "gọi tường minh") {
            trả về mục["giá trị"]["tên"];
        };
        nếu (mã == "đọc tên" || mã == "khai báo" ||
            mã == "chuẩn bị gán" || mã == "gán tên" ||
            mã == "++" || mã == "--" || mã == "bắt đầu lặp") {
            trả về mục["giá trị"];
        };
        nếu (mã == "đọc thành viên" || mã == "chuẩn bị gán thành viên" ||
            mã == "bắt đầu gọi thành viên") {
            trả về mục["giá trị"]["nhận"];
        };
        trả về "";
    };

    // Pass 1: dựng symbol cho mọi khai báo và phép gán implicit của cùng hàm.
    // Bỏ qua biến catch: scope này chỉ tồn tại trong phần `bắt lỗi`.
    hàm riêng tư biên dịch IR tập hợp ràng buộc(lệnh, bảng, toàn cục, bộ đếm) {
        các catch = [];
        lặp(i = 0; i < máy ảo lấy độ dài(lệnh); i++) {
            mục = lệnh[i];
            mã = mục["mã"];
            nếu (mã == "bắt đầu thử") { máy ảo thêm cuối danh sách(các catch, ""); };
            nếu (mã == "bắt lỗi") {
                các catch[máy ảo lấy độ dài(các catch) - 1] = mục["giá trị"];
            };
            nếu (mã == "kết thúc thử") { máy ảo xóa vị trí danh sách(các catch, máy ảo lấy độ dài(các catch) - 1); };
            nếu (mã == "khai báo" || mã == "chuẩn bị gán" ||
                mã == "gán tên" || mã == "++" || mã == "--" ||
                mã == "bắt đầu lặp") {
                tên = mục["giá trị"];
                bị che = sai;
                nếu (mã != "khai báo") {
                    lặp(j = 0; j < máy ảo lấy độ dài(các catch); j++) {
                        nếu (các catch[j] == tên) { bị che = đúng; };
                    };
                };
                nếu (!bị che && tên != "") {
                    nếu (mã == "khai báo" ||
                        mình.biên dịch IR tìm ràng buộc(toàn cục, tên) < 0) {
                        mình.biên dịch IR khai ràng buộc(bảng, tên, bộ đếm);
                    };
                };
            };
        };
    };

    // Pass 2: phân giải mọi thao tác đọc/ghi/gọi tới cùng SymbolId.
    // Stack catch bảo đảm tên chỉ che binding ngoài khi vào nhánh catch.
    hàm riêng tư biên dịch IR gắn ràng buộc(lệnh, bảng, toàn cục, bộ đếm) {
        các catch = [];
        lặp(i = 0; i < máy ảo lấy độ dài(lệnh); i++) {
            mục = lệnh[i];
            mã = mục["mã"];
            nếu (mã == "bắt đầu thử") {
                máy ảo thêm cuối danh sách(các catch, {"tên": "", "id": -1});
            };
            nếu (mã == "bắt lỗi") {
                tên lỗi = mục["giá trị"];
                mã định danh lỗi = -1;
                nếu (tên lỗi != "") {
                    mã định danh lỗi = bộ đếm["tiếp"];
                    bộ đếm["tiếp"] = mã định danh lỗi + 1;
                };
                các catch[máy ảo lấy độ dài(các catch) - 1] = {"tên": tên lỗi, "id": mã định danh lỗi};
                mục["symbol"] = mã định danh lỗi;
            };
            nếu (mã == "kết thúc thử") {
                máy ảo xóa vị trí danh sách(các catch, máy ảo lấy độ dài(các catch) - 1);
            };
            tên = mình.biên dịch IR tên mục(mục);
            nếu (tên != "" && mã != "gọi tường minh") {
                mã định danh = -1;
                nếu (mã != "khai báo") {
                    lặp(j = máy ảo lấy độ dài(các catch); j > 0; j--) {
                        nếu (các catch[j - 1]["tên"] == tên) {
                            mã định danh = các catch[j - 1]["id"];
                            thoát;
                        };
                    };
                };
                nếu (mã định danh < 0) { mã định danh = mình.biên dịch IR tìm ràng buộc(bảng, tên); };
                nếu (mã định danh < 0) { mã định danh = mình.biên dịch IR tìm ràng buộc(toàn cục, tên); };
                nếu (mã định danh >= 0) { mục["symbol"] = mã định danh; };
            };
            lệnh[i] = mục;
        };
    };

    hàm riêng tư biên dịch IR phân giải ràng buộc(đỉnh, các hàm) {
        bộ đếm = {"tiếp": 0};
        toàn cục = [];
        mình.biên dịch IR tập hợp ràng buộc(đỉnh, toàn cục, [], bộ đếm);
        lặp(i = 0; i < máy ảo lấy độ dài(các hàm); i++) {
            mục = các hàm[i];
            cục bộ = [];
            các mã định danh = [];
            nhận ngầm = [];
            nhận các mã định danh = [];
            nếu (lấy từ điển(mục, "phương thức", sai)) {
                lệnh nhận = mục["lệnh"];
                lặp(k = 0; k < 2; k++) {
                    tên nhận = "mình";
                    nếu (k == 1) { tên nhận = "gốc"; };
                    dùng = sai;
                    lặp(t = 0; t < máy ảo lấy độ dài(lệnh nhận); t++) {
                        chỉ dẫn = lệnh nhận[t];
                        mã nhận = chỉ dẫn["mã"];
                        nếu (mã nhận == "đọc tên" && chỉ dẫn["giá trị"] == tên nhận) {
                            dùng = đúng;
                        };
                        nếu (mã nhận == "đọc thành viên" ||
                            mã nhận == "chuẩn bị gán thành viên" ||
                            mã nhận == "bắt đầu gọi thành viên") {
                            nếu (chỉ dẫn["giá trị"]["nhận"] == tên nhận) {
                                dùng = đúng;
                            };
                        };
                    };
                    nếu (dùng) {
                        máy ảo thêm cuối danh sách(nhận ngầm, tên nhận);
                        máy ảo thêm cuối danh sách(nhận các mã định danh, mình.biên dịch IR khai ràng buộc(cục bộ, tên nhận, bộ đếm));
                    };
                };
            };
            tham số = mục["tham số"];
            lặp(j = 0; j < máy ảo lấy độ dài(tham số); j++) {
                máy ảo thêm cuối danh sách(các mã định danh, mình.biên dịch IR khai ràng buộc(cục bộ, tham số[j], bộ đếm));
            };
            lệnh = mục["lệnh"];
            mình.biên dịch IR tập hợp ràng buộc(lệnh, cục bộ, toàn cục, bộ đếm);
            mình.biên dịch IR gắn ràng buộc(lệnh, cục bộ, toàn cục, bộ đếm);
            mục["tham số symbol"] = các mã định danh;
            mục["nhận ngầm"] = nhận ngầm;
            mục["nhận symbol"] = nhận các mã định danh;
            các hàm[i] = mục;
        };
        mình.biên dịch IR gắn ràng buộc(đỉnh, toàn cục, [], bộ đếm);
    };

    // C++ codegen.cpp::isStaticCollectionLiteralValue chỉ nhận hằng và
    // collection tĩnh lồng nhau; tên và phép tính luôn là biểu thức động.
    hàm riêng tư biên dịch IR tập hợp tĩnh(nút) {
        loại = lấy từ điển(nút, "loại", "");
        nếu (loại == "hằng") { trả về đúng; };
        nếu (loại == "danh sách") {
            phần tử = lấy từ điển(nút, "phần tử", []);
            lặp(i = 0; i < máy ảo lấy độ dài(phần tử); i++) {
                nếu (!mình.biên dịch IR tập hợp tĩnh(phần tử[i])) { trả về sai; };
            };
            trả về đúng;
        };
        nếu (loại == "từ điển") {
            mục = lấy từ điển(nút, "mục", []);
            lặp(i = 0; i < máy ảo lấy độ dài(mục); i++) {
                nếu (!mình.biên dịch IR tập hợp tĩnh(mục[i]["giá trị"])) { trả về sai; };
            };
            trả về đúng;
        };
        trả về sai;
    };

    hàm riêng tư biên dịch IR biểu thức(nút, lệnh) {
        nếu (nút == rỗng) { ném "biên dịch IR: thiếu biểu thức"; };
        loại = lấy từ điển(nút, "loại", "");
        nếu (loại == "hằng") {
            kiểu = lấy từ điển(nút, "kiểu", "");
            giá trị = lấy từ điển(nút, "giá trị", "");
            nếu (kiểu == "số nguyên") {
                mình.biên dịch IR máy ảo thêm cuối danh sách(lệnh, "số nguyên", giá trị);
            } hoặc {
                nếu (kiểu == "số thực") {
                    mình.biên dịch IR máy ảo thêm cuối danh sách(lệnh, "số thực", giá trị);
                } hoặc {
                    nếu (kiểu == "chuỗi") {
                        mình.biên dịch IR máy ảo thêm cuối danh sách(lệnh, "chuỗi", giá trị);
                    } hoặc {
                        nếu (giá trị == "đúng" || giá trị == "sai" ||
                            giá trị == "rỗng") {
                            mình.biên dịch IR máy ảo thêm cuối danh sách(lệnh, giá trị, "");
                        } hoặc {
                            ném "biên dịch IR: hằng chưa hỗ trợ '" + giá trị + "'";
                        };
                    };
                };
            };
            trả về đúng;
        };
        nếu (loại == "tên") {
            mình.biên dịch IR máy ảo thêm cuối danh sách(lệnh, "đọc tên", lấy từ điển(nút, "giá trị", ""));
            trả về đúng;
        };
        nếu (loại == "thành viên") {
            thành viên = mình.biên dịch IR lấy thành viên(nút);
            nếu (lấy từ điển(thành viên, "tạm", sai)) {
                mình.biên dịch IR biểu thức(thành viên["biểu thức nhận"], lệnh);
            };
            mình.biên dịch IR máy ảo thêm cuối danh sách(lệnh, "đọc thành viên", thành viên);
            trả về đúng;
        };
        nếu (loại == "danh sách") {
            nếu (mình.biên dịch IR tập hợp tĩnh(nút)) {
                mình.biên dịch IR máy ảo thêm cuối danh sách(lệnh, "danh sách tĩnh", nút);
                trả về đúng;
            };
            phần tử = lấy từ điển(nút, "phần tử", []);
            lặp(i = 0; i < máy ảo lấy độ dài(phần tử); i++) {
                mình.biên dịch IR biểu thức(phần tử[i], lệnh);
            };
            mình.biên dịch IR máy ảo thêm cuối danh sách(lệnh, "danh sách động", máy ảo lấy độ dài(phần tử));
            trả về đúng;
        };
        nếu (loại == "từ điển") {
            nếu (mình.biên dịch IR tập hợp tĩnh(nút)) {
                mình.biên dịch IR máy ảo thêm cuối danh sách(lệnh, "từ điển tĩnh", nút);
                trả về đúng;
            };
            mục = lấy từ điển(nút, "mục", []);
            lặp(i = 0; i < máy ảo lấy độ dài(mục); i++) {
                // C++ nạp key của map như chuỗi hằng, không đọc biến tên key.
                khóa = mục[i]["khóa"];
                mình.biên dịch IR máy ảo thêm cuối danh sách(lệnh, "khóa từ điển", khóa);
                mình.biên dịch IR biểu thức(mục[i]["giá trị"], lệnh);
            };
            mình.biên dịch IR máy ảo thêm cuối danh sách(lệnh, "từ điển động", máy ảo lấy độ dài(mục));
            trả về đúng;
        };
        nếu (loại == "gọi") {
            đích = lấy từ điển(nút, "hàm", rỗng);
            kiểu đích = lấy từ điển(đích, "loại", "");
            nếu (kiểu đích != "tên" && kiểu đích != "thành viên") {
                ném "biên dịch IR: lời gọi chỉ hỗ trợ tên hàm";
            };
            thành viên = mình.biên dịch IR lấy thành viên(đích);
            nếu (thành viên != rỗng) {
                nếu (lấy từ điển(thành viên, "tạm", sai)) {
                    mình.biên dịch IR biểu thức(thành viên["biểu thức nhận"], lệnh);
                };
                mình.biên dịch IR máy ảo thêm cuối danh sách(lệnh, "bắt đầu gọi thành viên", thành viên);
            };
            đối số = lấy từ điển(nút, "đối số", []);
            lặp(i = 0; i < máy ảo lấy độ dài(đối số); i++) {
                mình.biên dịch IR biểu thức(đối số[i], lệnh);
            };
            nếu (thành viên != rỗng) {
                thành viên["số đối số"] = máy ảo lấy độ dài(đối số);
                mình.biên dịch IR máy ảo thêm cuối danh sách(lệnh, "gọi thành viên", thành viên);
                trả về đúng;
            };
            mã gọi = "gọi tên";
            nếu (lấy từ điển(nút, "tường minh", sai)) { mã gọi = "gọi tường minh"; };
            mình.biên dịch IR máy ảo thêm cuối danh sách(lệnh, mã gọi, {"tên": đích["giá trị"],
                                             "số đối số": máy ảo lấy độ dài(đối số)});
            trả về đúng;
        };
        nếu (loại == "một ngôi") {
            toán tử = lấy từ điển(nút, "toán tử", "");
            toán hạng = lấy từ điển(nút, "toán hạng", rỗng);
            nếu (toán tử == "-" && lấy từ điển(toán hạng, "loại", "") == "hằng" &&
                lấy từ điển(toán hạng, "kiểu", "") == "số nguyên") {
                mình.biên dịch IR máy ảo thêm cuối danh sách(lệnh, "số nguyên", "-" + lấy từ điển(toán hạng, "giá trị", "0"));
                trả về đúng;
            };
            nếu (toán tử == "-") {
                nếu (lấy từ điển(toán hạng, "loại", "") == "hằng" &&
                    lấy từ điển(toán hạng, "kiểu", "") == "số thực") {
                    mình.biên dịch IR máy ảo thêm cuối danh sách(lệnh, "số thực", "-" + toán hạng["giá trị"]);
                } hoặc {
                    mình.biên dịch IR máy ảo thêm cuối danh sách(lệnh, "số nguyên", "0");
                    mình.biên dịch IR biểu thức(toán hạng, lệnh);
                    mình.biên dịch IR máy ảo thêm cuối danh sách(lệnh, "toán tử", "-");
                };
                trả về đúng;
            };
            nếu (toán tử == "+") {
                mình.biên dịch IR biểu thức(toán hạng, lệnh);
                trả về đúng;
            };
            nếu (toán tử != "!") {
                ném "biên dịch IR: toán tử một ngôi chưa hỗ trợ '" + toán tử + "'";
            };
            mình.biên dịch IR biểu thức(toán hạng, lệnh);
            mình.biên dịch IR máy ảo thêm cuối danh sách(lệnh, "phủ định", "");
            trả về đúng;
        };
        nếu (loại == "hai ngôi") {
            toán tử = lấy từ điển(nút, "toán tử", "");
            trái = lấy từ điển(nút, "trái", rỗng);
            phải = lấy từ điển(nút, "phải", rỗng);
            nếu (biên dịch biểu thức là phép gán(toán tử)) {
                đích thành viên = mình.biên dịch IR lấy thành viên(trái);
                nếu (đích thành viên != rỗng) {
                    nếu (toán tử != "=") {
                        ném "biên dịch IR: gán kết hợp vào thuộc tính chưa hỗ trợ";
                    };
                    nếu (lấy từ điển(đích thành viên, "tạm", sai)) {
                        mình.biên dịch IR biểu thức(đích thành viên["biểu thức nhận"], lệnh);
                    };
                    mình.biên dịch IR máy ảo thêm cuối danh sách(lệnh, "chuẩn bị gán thành viên", đích thành viên);
                    mình.biên dịch IR biểu thức(phải, lệnh);
                    mình.biên dịch IR máy ảo thêm cuối danh sách(lệnh, "gán thành viên", đích thành viên);
                    trả về đúng;
                };
                nếu (lấy từ điển(trái, "loại", "") == "chỉ số") {
                    nếu (toán tử != "=") {
                        ném "biên dịch IR: gán kết hợp vào chỉ số chưa hỗ trợ";
                    };
                    mình.biên dịch IR biểu thức(trái["đối tượng"], lệnh);
                    mình.biên dịch IR biểu thức(trái["chỉ số"], lệnh);
                    mình.biên dịch IR biểu thức(phải, lệnh);
                    mình.biên dịch IR máy ảo thêm cuối danh sách(lệnh, "gán chỉ số", "");
                    trả về đúng;
                };
                nếu (lấy từ điển(trái, "loại", "") != "tên") {
                    ném "biên dịch IR: chỉ hỗ trợ gán vào tên";
                };
                tên = lấy từ điển(trái, "giá trị", "");
                // Backend C++ đăng ký slot của đích trước khi đi qua vế phải.
                // IR cần giữ thứ tự này dù việc đẩy ID biến diễn ra sau RHS.
                mình.biên dịch IR máy ảo thêm cuối danh sách(lệnh, "chuẩn bị gán", tên);
                nếu (toán tử != "=") {
                    mình.biên dịch IR máy ảo thêm cuối danh sách(lệnh, "đọc tên", tên);
                };
                mình.biên dịch IR biểu thức(phải, lệnh);
                nếu (toán tử != "=") {
                    // Theo direct IR C++, compound gán = đọc đích, tính nhị phân,
                    // rồi phát OP_TEN_BIEN_ID + OP_GAN. Opcode 72..76 dành cho
                    // ký hiệu toán tử, không dùng ở chuỗi bytecode này.
                    mình.biên dịch IR máy ảo thêm cuối danh sách(lệnh, "toán tử gán", toán tử);
                };
                mình.biên dịch IR máy ảo thêm cuối danh sách(lệnh, "gán tên", tên);
                trả về đúng;
            };
            nếu (biên dịch biểu thức ưu tiên(toán tử) == 0) {
                ném "biên dịch IR: phép hai ngôi chưa hỗ trợ '" + toán tử + "'";
            };
            mình.biên dịch IR biểu thức(trái, lệnh);
            mình.biên dịch IR biểu thức(phải, lệnh);
            mình.biên dịch IR máy ảo thêm cuối danh sách(lệnh, "toán tử", toán tử);
            trả về đúng;
        };
        nếu (loại == "chỉ số") {
            mình.biên dịch IR biểu thức(lấy từ điển(nút, "đối tượng", rỗng), lệnh);
            mình.biên dịch IR biểu thức(lấy từ điển(nút, "chỉ số", rỗng), lệnh);
            mình.biên dịch IR máy ảo thêm cuối danh sách(lệnh, "đọc chỉ số", "");
            trả về đúng;
        };
        nếu (loại == "cập nhật") {
            đích = lấy từ điển(nút, "đối tượng", rỗng);
            nếu (lấy từ điển(đích, "loại", "") != "tên") {
                ném "biên dịch IR: chỉ hỗ trợ ++/-- trên tên";
            };
            toán tử = lấy từ điển(nút, "toán tử", "");
            nếu (toán tử != "++" && toán tử != "--") {
                ném "biên dịch IR: toán tử cập nhật chưa hỗ trợ";
            };
            mình.biên dịch IR máy ảo thêm cuối danh sách(lệnh, toán tử, lấy từ điển(đích, "giá trị", ""));
            trả về đúng;
        };
        ném "biên dịch IR: biểu thức chưa hỗ trợ '" + loại + "'";
    };

    hàm riêng tư biên dịch IR câu lệnh(nút, lệnh) {
        loại = lấy từ điển(nút, "loại", "");
        nếu (loại == "trống") { trả về đúng; };
        nếu (loại == "khối") {
            mình.biên dịch IR máy ảo thêm cuối danh sách(lệnh, "mở khối", "");
            con = lấy từ điển(nút, "câu lệnh", []);
            lặp(i = 0; i < máy ảo lấy độ dài(con); i++) {
                mình.biên dịch IR câu lệnh(con[i], lệnh);
            };
            mình.biên dịch IR máy ảo thêm cuối danh sách(lệnh, "đóng khối", "");
            trả về đúng;
        };
        nếu (loại == "biến") {
            tên = lấy từ điển(nút, "tên", "");
            mình.biên dịch IR máy ảo thêm cuối danh sách(lệnh, "khai báo", tên);
            giá trị = lấy từ điển(nút, "giá trị", rỗng);
            nếu (giá trị != rỗng) {
                mình.biên dịch IR biểu thức(giá trị, lệnh);
                mình.biên dịch IR máy ảo thêm cuối danh sách(lệnh, "gán tên", tên);
            };
            trả về đúng;
        };
        nếu (loại == "nếu") {
            mình.biên dịch IR máy ảo thêm cuối danh sách(lệnh, "bắt đầu nếu", "");
            mình.biên dịch IR biểu thức(lấy từ điển(nút, "điều kiện", rỗng), lệnh);
            mình.biên dịch IR máy ảo thêm cuối danh sách(lệnh, "nhảy nếu sai", "");
            mình.biên dịch IR câu lệnh(lấy từ điển(nút, "thân", {}), lệnh);
            nhánh khác = lấy từ điển(nút, "nhánh khác", rỗng);
            nếu (nhánh khác != rỗng) {
                mình.biên dịch IR máy ảo thêm cuối danh sách(lệnh, "bắt đầu nhánh khác", "");
                mình.biên dịch IR câu lệnh(nhánh khác, lệnh);
            };
            mình.biên dịch IR máy ảo thêm cuối danh sách(lệnh, "kết thúc nếu", "");
            trả về đúng;
        };
        nếu (loại == "lặp") {
            bước khởi tạo = lấy từ điển(nút, "khởi tạo", rỗng);
            đích = lấy từ điển(bước khởi tạo, "trái", rỗng);
            nếu (lấy từ điển(bước khởi tạo, "loại", "") != "hai ngôi" ||
                lấy từ điển(bước khởi tạo, "toán tử", "") != "=" ||
                lấy từ điển(đích, "loại", "") != "tên") {
                ném "biên dịch IR: lặp yêu cầu khởi tạo dạng tên = giá trị";
            };
            nếu (lấy từ điển(nút, "điều kiện", rỗng) == rỗng ||
                lấy từ điển(nút, "cập nhật", rỗng) == rỗng) {
                ném "biên dịch IR: lặp yêu cầu điều kiện và cập nhật";
            };
            mình.biên dịch IR máy ảo thêm cuối danh sách(lệnh, "bắt đầu lặp", đích["giá trị"]);
            mình.biên dịch IR biểu thức(bước khởi tạo, lệnh);
            mình.biên dịch IR máy ảo thêm cuối danh sách(lệnh, "vào lặp", "");
            mình.biên dịch IR máy ảo thêm cuối danh sách(lệnh, "điều kiện lặp", "");
            mình.biên dịch IR biểu thức(nút["điều kiện"], lệnh);
            mình.biên dịch IR máy ảo thêm cuối danh sách(lệnh, "nhảy nếu sai lặp", "");
            mình.biên dịch IR câu lệnh(nút["thân"], lệnh);
            mình.biên dịch IR máy ảo thêm cuối danh sách(lệnh, "cập nhật lặp", "");
            mình.biên dịch IR biểu thức(nút["cập nhật"], lệnh);
            mình.biên dịch IR máy ảo thêm cuối danh sách(lệnh, "kết thúc lặp", "");
            trả về đúng;
        };
        nếu (loại == "chọn") {
            mình.biên dịch IR biểu thức(lấy từ điển(nút, "biểu thức", rỗng), lệnh);
            mình.biên dịch IR máy ảo thêm cuối danh sách(lệnh, "bắt đầu chọn", "");
            nhánh = lấy từ điển(nút, "nhánh", []);
            lặp(i = 0; i < máy ảo lấy độ dài(nhánh); i++) {
                mục = nhánh[i];
                nếu (mục["loại"] == "ca") {
                    mình.biên dịch IR máy ảo thêm cuối danh sách(lệnh, "ca", mục["nhãn"]);
                } hoặc {
                    mình.biên dịch IR máy ảo thêm cuối danh sách(lệnh, "mặc định", "");
                };
                mình.biên dịch IR câu lệnh(mục["thân"], lệnh);
            };
            mình.biên dịch IR máy ảo thêm cuối danh sách(lệnh, "kết thúc chọn", "");
            trả về đúng;
        };
        nếu (loại == "thoát") {
            mình.biên dịch IR máy ảo thêm cuối danh sách(lệnh, "thoát", "");
            trả về đúng;
        };
        nếu (loại == "bỏ qua") {
            mình.biên dịch IR máy ảo thêm cuối danh sách(lệnh, "bỏ qua", "");
            trả về đúng;
        };
        nếu (loại == "thử") {
            mình.biên dịch IR máy ảo thêm cuối danh sách(lệnh, "bắt đầu thử", "");
            mình.biên dịch IR câu lệnh(nút["thân"], lệnh);
            mình.biên dịch IR máy ảo thêm cuối danh sách(lệnh, "bắt lỗi", lấy từ điển(nút, "biến lỗi", ""));
            mình.biên dịch IR câu lệnh(nút["bắt"], lệnh);
            mình.biên dịch IR máy ảo thêm cuối danh sách(lệnh, "kết thúc thử", "");
            trả về đúng;
        };
        nếu (loại == "ném") {
            giá trị = lấy từ điển(nút, "biểu thức", rỗng);
            nếu (giá trị == rỗng) {
                mình.biên dịch IR máy ảo thêm cuối danh sách(lệnh, "chuỗi", "\"lỗi không xác định\"");
            } hoặc {
                mình.biên dịch IR biểu thức(giá trị, lệnh);
            };
            mình.biên dịch IR máy ảo thêm cuối danh sách(lệnh, "ném", "");
            trả về đúng;
        };
        nếu (loại == "in") {
            mình.biên dịch IR biểu thức(lấy từ điển(nút, "biểu thức", rỗng), lệnh);
            mình.biên dịch IR máy ảo thêm cuối danh sách(lệnh, "in", "");
            trả về đúng;
        };
        nếu (loại == "biểu thức") {
            mình.biên dịch IR biểu thức(lấy từ điển(nút, "biểu thức", rỗng), lệnh);
            trả về đúng;
        };
        nếu (loại == "trả về") {
            giá trị = lấy từ điển(nút, "biểu thức", rỗng);
            nếu (giá trị == rỗng) {
                mình.biên dịch IR máy ảo thêm cuối danh sách(lệnh, "số nguyên", "0");
            } hoặc {
                mình.biên dịch IR biểu thức(giá trị, lệnh);
            };
            mình.biên dịch IR máy ảo thêm cuối danh sách(lệnh, "trả về", "");
            trả về đúng;
        };
        ném "biên dịch IR: câu lệnh chưa hỗ trợ '" + loại + "'";
    };

    // Hạ AST đã được semantic kiểm tra. Module imports chỉ được bỏ qua ở
    // nhánh emitter đa mô-đun sau khi graph đã giải tất cả dependencies.
    hàm công khai biên dịch hạ IR từ cây thuần(cây, số mục bỏ qua nhập) {
        biên dịch kiểm tra ngữ nghĩa thuần(cây);
        câu lệnh = lấy từ điển(cây, "câu lệnh", []);
        đỉnh = [];
        các hàm = [];
        các lớp = [];
        thư viện = {};
        các ngoại = [];
        // Predeclare mọi thư viện trước: semantic cho phép thứ tự nguồn bất kỳ.
        lặp(i = 0; i < máy ảo lấy độ dài(câu lệnh); i++) {
            mục = câu lệnh[i];
            nếu (lấy từ điển(mục, "loại", "") == "ngoại thư viện") {
                thư viện[mục["tên"]] = mục["đích"];
            };
        };
        lặp(i = 0; i < máy ảo lấy độ dài(câu lệnh); i++) {
            mục = câu lệnh[i];
            nếu (lấy từ điển(mục, "loại", "") == "ngoại hàm") {
                mình.biên dịch IR khai ngoại(mục, thư viện, các ngoại);
            };
        };
        thứ tự = [];
        lặp(i = 0; i < máy ảo lấy độ dài(câu lệnh); i++) {
            mục = câu lệnh[i];
            nếu (lấy từ điển(mục, "loại", "") == "hàm") {
                nội dung = [];
                thân = lấy từ điển(mục, "thân", {});
                phần thân = lấy từ điển(thân, "câu lệnh", []);
                lặp(j = 0; j < máy ảo lấy độ dài(phần thân); j++) {
                    mình.biên dịch IR câu lệnh(phần thân[j], nội dung);
                };
                máy ảo thêm cuối danh sách(các hàm, {"tên": lấy từ điển(mục, "tên", ""),
                               "tham số": lấy từ điển(mục, "tham số", []),
                               "mặc định tham số": lấy từ điển(mục, "mặc định tham số", []),
                               "lệnh": nội dung});
                máy ảo thêm cuối danh sách(thứ tự, {"loại": "hàm", "chỉ số": máy ảo lấy độ dài(các hàm) - 1});
            } hoặc {
                nếu (lấy từ điển(mục, "loại", "") == "lớp") {
                    máy ảo thêm cuối danh sách(các lớp, {"tên": mục["tên"],
                                    "lớp cha": lấy từ điển(mục, "lớp cha", ""),
                                    "phương thức": [],
                                    "cây phương thức": lấy từ điển(mục, "phương thức", [])});
                    máy ảo thêm cuối danh sách(thứ tự, {"loại": "lớp", "chỉ số": máy ảo lấy độ dài(các lớp) - 1});
                    bỏ qua;
                };
                nếu (lấy từ điển(mục, "loại", "") == "giao diện") { bỏ qua; };
                nếu (lấy từ điển(mục, "loại", "") == "ngoại thư viện" ||
                    lấy từ điển(mục, "loại", "") == "ngoại hàm") { bỏ qua; };
                nếu (lấy từ điển(mục, "loại", "") == "nhập" && số mục bỏ qua nhập) {
                    // Bước phát mã cần biết đúng vị trí import trong nguồn.
                    máy ảo thêm cuối danh sách(thứ tự, {"loại": "nhập", "đích": mục["đích"],
                        "bí danh": lấy từ điển(mục, "bí danh", ""),
                        "tái xuất": lấy từ điển(mục, "tái xuất", sai)});
                    bỏ qua;
                };
                bắt đầu = máy ảo lấy độ dài(đỉnh);
                mình.biên dịch IR câu lệnh(mục, đỉnh);
                máy ảo thêm cuối danh sách(thứ tự, {"loại": "lệnh", "bắt đầu": bắt đầu,
                              "kết thúc": máy ảo lấy độ dài(đỉnh)});
            };
        };
        // Các phương thức được hạ sau mọi hàm global, vì C++ predeclare
        // function ID cho hàm global trước rồi mới cấp ID khi phát lớp.
        lặp(i = 0; i < máy ảo lấy độ dài(các lớp); i++) {
            kiểu lớp biểu diễn trung gian = các lớp[i];
            phương thức = kiểu lớp biểu diễn trung gian["cây phương thức"];
            lặp(j = 0; j < máy ảo lấy độ dài(phương thức); j++) {
                khai = phương thức[j];
                thân = [];
                câu = lấy từ điển(lấy từ điển(khai, "thân", {}), "câu lệnh", []);
                lặp(k = 0; k < máy ảo lấy độ dài(câu); k++) {
                    mình.biên dịch IR câu lệnh(câu[k], thân);
                };
                máy ảo thêm cuối danh sách(các hàm, {"tên": kiểu lớp biểu diễn trung gian["tên"] + "." + khai["tên"],
                               "tên ngắn": khai["tên"],
                               "phương thức": đúng,
                               "phạm vi": lấy từ điển(khai, "phạm vi", ""),
                               "tham số": lấy từ điển(khai, "tham số", []),
                               "mặc định tham số": lấy từ điển(khai, "mặc định tham số", []),
                               "lệnh": thân});
                máy ảo thêm cuối danh sách(kiểu lớp biểu diễn trung gian["phương thức"], máy ảo lấy độ dài(các hàm) - 1);
            };
            kiểu lớp biểu diễn trung gian["cây phương thức"] = [];
            các lớp[i] = kiểu lớp biểu diễn trung gian;
        };
        mình.biên dịch IR phân giải ràng buộc(đỉnh, các hàm);
        trả về {"loại": "chương trình IR", "lệnh": đỉnh, "hàm": các hàm,
                "lớp": các lớp,
                "ngoại": các ngoại,
                "thứ tự": thứ tự};
    };

    // Đường đơn vị giữ nguyên hành vi: import chưa giải phải báo lỗi ở IR.
    hàm công khai biên dịch hạ IR thuần(mã nguồn) {
        trả về mình.biên dịch hạ IR từ cây thuần(
            biên dịch phân tích chương trình thuần(mã nguồn), sai);
    };
};


hàm công khai biên dịch IR tách thành viên(tên) {
    bộ chuyển tiếp = Bộ Hạ IR();
    trả về bộ chuyển tiếp.biên dịch IR tách thành viên(tên);
};

hàm công khai biên dịch hạ IR từ cây thuần(cây, số mục bỏ qua nhập) {
    bộ chuyển tiếp = Bộ Hạ IR();
    trả về bộ chuyển tiếp.biên dịch hạ IR từ cây thuần(cây, số mục bỏ qua nhập);
};

hàm công khai biên dịch hạ IR thuần(mã nguồn) {
    bộ chuyển tiếp = Bộ Hạ IR();
    trả về bộ chuyển tiếp.biên dịch hạ IR thuần(mã nguồn);
};
