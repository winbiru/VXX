// Bộ nạp artifact: tương thích ABI bốn vùng cũ, native FFI dùng năm vùng.
// Backend AOT chuyển cả hai giao thức thành mã máy; VM legacy nhận bốn vùng.
nhập gói.biên dịch.liên kết.biên dịch chương trình tự chủ;
nhập gói.biên dịch.liên kết.biên dịch chương trình mô đun tự chủ;
nhập gói.bộ sưu tập.từ điển.lấy từ điển;
nhập gói.bộ sưu tập.từ điển.có khóa;
nhập gói.bộ sưu tập.từ điển.khóa từ điển;
nhập gói.lõi.chuyển kiểu.thành chuỗi;
nhập gói.lõi.chuyển kiểu.loại của;

// Kiểm tra dữ liệu dùng chung không cần một đối tượng trung gian.
hàm công khai biên dịch nạp danh sách(giá trị, vị trí) {
    nếu (loại của(giá trị) != "danh sách") {
        ném "biên dịch nạp: " + vị trí + " phải là danh sách";
    };
    trả về giá trị;
};

// Một bộ nạp giữ artifact và cache ABI; bộ chuyển mã dùng chung cho mọi module.
lớp công khai Bộ Nạp Sản Phẩm Biên Dịch {
    hàm công khai khởi tạo(sản phẩm biên dịch) {
        mình.sản phẩm biên dịch = sản phẩm biên dịch;
        mình.abi = rỗng;
    };

    hàm công khai mã trung gian(danh sách) {
        biên dịch nạp danh sách(danh sách, "bytecode");
        dây = [];
        lặp(i = 0; i < máy ảo lấy độ dài(danh sách); i++) {
            lệnh = danh sách[i];
            nếu (loại của(lệnh) != "từ điển") {
                ném "biên dịch nạp: bản ghi bytecode phải là từ điển";
            };
            nếu (!máy ảo có khóa từ điển(lệnh, "op") || !máy ảo có khóa từ điển(lệnh, "toán hạng") ||
                !máy ảo có khóa từ điển(lệnh, "chỉ số") || !máy ảo có khóa từ điển(lệnh, "giá trị")) {
                ném "biên dịch nạp: bytecode thiếu trường ABI";
            };
            máy ảo thêm cuối danh sách(dây, [lệnh["op"], lệnh["toán hạng"],
                       lệnh["chỉ số"], lệnh["giá trị"]]);
        };
        trả về dây;
    };

    // Hỗ trợ artifact một mô-đun và đồ thị đa mô-đun.
    hàm công khai nạp() {
        nếu (mình.abi != rỗng) { trả về mình.abi; };
        sản phẩm biên dịch = mình.sản phẩm biên dịch;
        nếu (loại của(sản phẩm biên dịch) != "từ điển") {
            ném "biên dịch nạp: artifact phải là từ điển";
        };
        loại = lấy từ điển(sản phẩm biên dịch, "loại", "");
        nếu (loại != "bytecode V++ đã liên kết" &&
            loại != "bytecode V++ đồ thị đã liên kết") {
            ném "biên dịch nạp: cần artifact bytecode V++ đã liên kết";
        };
        chuỗi = biên dịch nạp danh sách(lấy từ điển(sản phẩm biên dịch, "chuỗi", rỗng), "chuỗi");
        nguồn = mình.mã trung gian(lấy từ điển(sản phẩm biên dịch, "bytecode", rỗng));
        các hàm = biên dịch nạp danh sách(lấy từ điển(sản phẩm biên dịch, "hàm", rỗng), "hàm");
        bảng hàm = [];
        tên đã khai = {};
        lặp(i = 0; i < máy ảo lấy độ dài(các hàm); i++) {
            h = các hàm[i];
            nếu (loại của(h) != "từ điển" ||
                loại của(lấy từ điển(h, "id", rỗng)) != "số nguyên" || lấy từ điển(h, "id", -1) != i) {
                ném "biên dịch nạp: function ID không liên tiếp";
            };
            tên chỉ mục = lấy từ điển(h, "tên index", -1);
            nếu (loại == "bytecode V++ đồ thị đã liên kết") {
                tên chỉ mục = lấy từ điển(h, "tên index runtime", -1);
            };
            nếu (loại của(tên chỉ mục) != "số nguyên") {
                ném "biên dịch nạp: function name index ngoài StringPool";
            };
            nếu (tên chỉ mục < -1 || tên chỉ mục >= máy ảo lấy độ dài(chuỗi)) {
                ném "biên dịch nạp: function name index ngoài StringPool";
            };
            nếu (tên chỉ mục >= 0) {
                khóa = thành chuỗi(tên chỉ mục);
                nếu (máy ảo có khóa từ điển(tên đã khai, khóa)) {
                    ném "biên dịch nạp: trùng function runtime name index";
                };
                tên đã khai[khóa] = đúng;
            };
            máy ảo thêm cuối danh sách(bảng hàm, [i, tên chỉ mục,
                            mình.mã trung gian(lấy từ điển(h, "bytecode", rỗng))]);
        };

        các mô đun = lấy từ điển(sản phẩm biên dịch, "mô đun khởi tạo", []);
        biên dịch nạp danh sách(các mô đun, "mô đun khởi tạo");
        nếu (loại == "bytecode V++ đã liên kết" && máy ảo lấy độ dài(các mô đun) != 0) {
            ném "biên dịch nạp: artifact một mô-đun không có initializer";
        };
        bước khởi tạo = [];
        mô đun đã khai = {};
        lặp(i = 0; i < máy ảo lấy độ dài(các mô đun); i++) {
            mô đun = các mô đun[i];
            nếu (loại của(mô đun) != "từ điển") {
                ném "biên dịch nạp: initializer phải là từ điển";
            };
            định danh = lấy từ điển(mô đun, "định danh", "");
            nếu (loại của(định danh) != "chuỗi" || định danh == "") {
                ném "biên dịch nạp: định danh initializer không hợp lệ";
            };
            nếu (máy ảo có khóa từ điển(mô đun đã khai, định danh)) {
                ném "biên dịch nạp: trùng định danh initializer";
            };
            mô đun đã khai[định danh] = đúng;
            máy ảo thêm cuối danh sách(bước khởi tạo, [định danh,
                            mình.mã trung gian(lấy từ điển(mô đun, "bytecode", rỗng))]);
        };
        mình.abi = [nguồn, chuỗi, bảng hàm, bước khởi tạo];
        ngoại = biên dịch nạp danh sách(lấy từ điển(sản phẩm biên dịch, "ngoại", []), "ngoại hàm");
        nếu (máy ảo lấy độ dài(ngoại) > 0) {
            dây ngoại = [];
            lặp(i = 0; i < máy ảo lấy độ dài(ngoại); i++) {
                d = ngoại[i];
                nếu (loại của(d) != "từ điển" || d["id"] != i) {
                    ném "biên dịch nạp: foreign descriptor ID không liên tiếp";
                };
                máy ảo thêm cuối danh sách(dây ngoại, [d["id"], d["thư viện"], d["ký hiệu"],
                    d["tham số"], d["đệm"], d["kết quả"],
                    d["abi"], d["khả năng"]]);
            };
            máy ảo thêm cuối danh sách(mình.abi, dây ngoại);
        };
        trả về mình.abi;
    };

    hàm công khai chạy() {
        dây = mình.nạp();
        nếu (máy ảo lấy độ dài(dây) == 5) {
            trả về mã trung gian chạy bản địa(dây[0], dây[1], dây[2], dây[3], dây[4]);
        };
        trả về mã trung gian chạy máy ảo(dây[0], dây[1], dây[2], dây[3]);
    };
};

hàm công khai biên dịch nạp mã trung gian(danh sách) {
    bộ nạp = Bộ Nạp Sản Phẩm Biên Dịch(rỗng);
    trả về bộ nạp.mã trung gian(danh sách);
};

hàm công khai biên dịch nạp sản phẩm biên dịch(sản phẩm biên dịch) {
    bộ nạp = Bộ Nạp Sản Phẩm Biên Dịch(sản phẩm biên dịch);
    trả về bộ nạp.nạp();
};

hàm công khai biên dịch chạy sản phẩm biên dịch(sản phẩm biên dịch) {
    bộ nạp = Bộ Nạp Sản Phẩm Biên Dịch(sản phẩm biên dịch);
    trả về bộ nạp.chạy();
};

hàm công khai biên dịch chạy chương trình tự chủ(mã nguồn) {
    trả về biên dịch chạy sản phẩm biên dịch(biên dịch chương trình tự chủ(mã nguồn));
};

hàm công khai biên dịch chạy chương trình mô đun tự chủ(điểm vào, nguồn) {
    trả về biên dịch chạy sản phẩm biên dịch(
        biên dịch chương trình mô đun tự chủ(điểm vào, nguồn));
};
