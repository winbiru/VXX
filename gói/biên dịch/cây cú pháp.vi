// Chuyển đổi AST thô thành mô hình cú pháp V++ công khai.
nhập gói.bộ sưu tập.từ điển.lấy từ điển;
nhập gói.bộ sưu tập.từ điển.đặt từ điển;

// Các phép chuyển đổi AST thuần là hàm cấp mô-đun.
hàm công khai biên dịch loại câu lệnh từ mã(mã) {
    nếu (mã == 0) { trả về "nhập"; };
    nếu (mã == 1) { trả về "hàm"; };
    nếu (mã == 2) { trả về "lớp"; };
    nếu (mã == 3) { trả về "giao diện"; };
    trả về "khác";
};

hàm công khai biên dịch phạm vi từ mã(mã) {
    nếu (mã == 1) { trả về "công khai"; };
    nếu (mã == 2) { trả về "riêng tư"; };
    nếu (mã == 3) { trả về "bảo vệ"; };
    trả về "mặc định";
};

hàm công khai biên dịch tham số từ thô(các tham số) {
    kết quả = [];
    lặp(i = 0; i < máy ảo lấy độ dài(các tham số); i++) {
        thô = các tham số[i];
        máy ảo thêm cuối danh sách(kết quả, {
            "tên": thô[0],
            "có mặc định": thô[1]
        });
    };
    trả về kết quả;
};

hàm công khai biên dịch câu lệnh từ thô(thô) {
    thành viên = [];
    con = thô[7];
    lặp(i = 0; i < máy ảo lấy độ dài(con); i++) {
        máy ảo thêm cuối danh sách(thành viên, biên dịch câu lệnh từ thô(con[i]));
    };
    kết quả = {
        "loại": biên dịch loại câu lệnh từ mã(thô[0]),
        "tên": thô[1],
        "phạm vi": biên dịch phạm vi từ mã(thô[2]),
        "tham số": biên dịch tham số từ thô(thô[3]),
        "đích": thô[4],
        "bí danh": thô[5],
        "công khai": thô[6],
        "thành viên": thành viên
    };
    nếu (độ dài(thô) > 8) {
        nếu (thô[8] != "") { kết quả["tên nhập"] = thô[8]; };
    };
    trả về kết quả;
};

hàm công khai biên dịch cây từ thô(cây thô) {
    kết quả = [];
    lặp(i = 0; i < máy ảo lấy độ dài(cây thô); i++) {
        máy ảo thêm cuối danh sách(kết quả, biên dịch câu lệnh từ thô(cây thô[i]));
    };
    trả về kết quả;
};

// Một snapshot AST có thể được truy vấn nhiều lần (IDE, linter, compiler).
// Lập chỉ mục tên một lần theo DFS pre-order, kể cả thành viên lớp/giao diện.
lớp công khai Bộ Chỉ Mục Khai Báo {
    hàm công khai khởi tạo(cây) {
        nếu (loại của(cây) != "danh sách") {
            ném "biên dịch: cây khai báo phải là danh sách";
        };
        mình.cây = cây;
        mình.chỉ mục = {};
        mình.đã lập = sai;
    };

    hàm riêng tư ghi danh sách(cây) {
        bảng = mình.chỉ mục;
        lặp(i = 0; i < máy ảo lấy độ dài(cây); i++) {
            mục = cây[i];
            tên = lấy từ điển(mục, "tên", "");
            nếu (loại của(tên) == "chuỗi") {
                kết quả = lấy từ điển(bảng, tên, rỗng);
                nếu (kết quả == rỗng) {
                    kết quả = [];
                    đặt từ điển(bảng, tên, kết quả);
                };
                máy ảo thêm cuối danh sách(kết quả, mục);
            };
            mình.ghi danh sách(lấy từ điển(mục, "thành viên", []));
        };
    };

    hàm công khai tìm(tên) {
        nếu (!mình.đã lập) {
            mình.chỉ mục = {};
            mình.ghi danh sách(mình.cây);
            mình.đã lập = đúng;
        };
        // Trả bản danh sách riêng để người gọi không sửa trực tiếp chỉ mục.
        kết quả = lấy từ điển(mình.chỉ mục, tên, []);
        bản sao = [];
        lặp(i = 0; i < máy ảo lấy độ dài(kết quả); i++) { máy ảo thêm cuối danh sách(bản sao, kết quả[i]); };
        trả về bản sao;
    };

    hàm công khai làm mới() {
        mình.chỉ mục = {};
        mình.đã lập = sai;
    };
};

// API cũ: mỗi lần nhận một cây độc lập, giữ nguyên thứ tự kết quả DFS.
hàm công khai biên dịch tìm khai báo trong cây(cây, tên) {
    chỉ mục = Bộ Chỉ Mục Khai Báo(cây);
    trả về chỉ mục.tìm(tên);
};

