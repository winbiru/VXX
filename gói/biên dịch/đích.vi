// Registry target thuần V++ dùng trong compiler self-host.
// Các tên canonical, độ rộng và thứ tự byte phải tương ứng với
// src/native/target.cpp. Các ISA chưa có backend phát mã máy đầy đủ.
hàm công khai biên dịch danh sách kiến trúc() {
    trả về ["x86_64", "aarch64", "riscv64", "armv7", "i386",
            "powerpc", "powerpc64", "powerpc64le", "mips", "mipsel",
            "mips64", "mips64el", "loongarch64", "s390x", "sparc", "sparc64"];
};

hàm công khai biên dịch chuẩn hóa kiến trúc(tên) {
    chọn (tên) {
        ca "amd64": { trả về "x86_64"; }
        ca "x64": { trả về "x86_64"; }
        ca "arm64": { trả về "aarch64"; }
        ca "arm64e": { trả về "aarch64"; }
        ca "rv64": { trả về "riscv64"; }
        ca "arm": { trả về "armv7"; }
        ca "armhf": { trả về "armv7"; }
        ca "armv7l": { trả về "armv7"; }
        ca "x86": { trả về "i386"; }
        ca "i486": { trả về "i386"; }
        ca "i586": { trả về "i386"; }
        ca "i686": { trả về "i386"; }
        ca "ppc": { trả về "powerpc"; }
        ca "ppc64": { trả về "powerpc64"; }
        ca "ppc64le": { trả về "powerpc64le"; }
        ca "mips32": { trả về "mips"; }
        ca "mips32el": { trả về "mipsel"; }
        ca "sparcv9": { trả về "sparc64"; }
        mặc định: { trả về tên; }
    };
};

hàm công khai biên dịch thông tin kiến trúc(tên) {
    tên = biên dịch chuẩn hóa kiến trúc(tên);
    chọn (tên) {
        ca "x86_64": { trả về {"tên": tên, "bit": 64, "little endian": đúng}; }
        ca "aarch64": { trả về {"tên": tên, "bit": 64, "little endian": đúng}; }
        ca "riscv64": { trả về {"tên": tên, "bit": 64, "little endian": đúng}; }
        ca "armv7": { trả về {"tên": tên, "bit": 32, "little endian": đúng}; }
        ca "i386": { trả về {"tên": tên, "bit": 32, "little endian": đúng}; }
        ca "powerpc": { trả về {"tên": tên, "bit": 32, "little endian": sai}; }
        ca "powerpc64": { trả về {"tên": tên, "bit": 64, "little endian": sai}; }
        ca "powerpc64le": { trả về {"tên": tên, "bit": 64, "little endian": đúng}; }
        ca "mips": { trả về {"tên": tên, "bit": 32, "little endian": sai}; }
        ca "mipsel": { trả về {"tên": tên, "bit": 32, "little endian": đúng}; }
        ca "mips64": { trả về {"tên": tên, "bit": 64, "little endian": sai}; }
        ca "mips64el": { trả về {"tên": tên, "bit": 64, "little endian": đúng}; }
        ca "loongarch64": { trả về {"tên": tên, "bit": 64, "little endian": đúng}; }
        ca "s390x": { trả về {"tên": tên, "bit": 64, "little endian": sai}; }
        ca "sparc": { trả về {"tên": tên, "bit": 32, "little endian": sai}; }
        ca "sparc64": { trả về {"tên": tên, "bit": 64, "little endian": sai}; }
        mặc định: { ném "biên dịch: kiến trúc chưa đăng ký: " + tên; }
    };
};

// Không quảng cáo backend chỉ vì kiến trúc đã có trong registry.
hàm công khai biên dịch jit máy thử nghiệm(tên, hệ điều hành) {
    tên = biên dịch thông tin kiến trúc(tên)["tên"];
    chọn (hệ điều hành) {
        ca "linux": { trả về tên == "x86_64" || tên == "aarch64"; }
        ca "windows": { trả về tên == "x86_64"; }
        ca "macos": { trả về tên == "aarch64"; }
        mặc định: { ném "biên dịch: hệ điều hành target chưa đăng ký: " + hệ điều hành; }
    };
};

// Phân tích target triple trực tiếp trong V++. Quy tắc khớp với
// src/native/target.cpp; trường không rõ phải ném lỗi tường minh.
hàm công khai biên dịch đích chữ thường ASCII(chuỗi) {
    hoa = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    thường = "abcdefghijklmnopqrstuvwxyz";
    kết quả = "";
    lặp (i = 0; i < máy ảo lấy độ dài(chuỗi); i++) {
        ký tự = chuỗi[i];
        lặp (j = 0; j < 26; j++) {
            nếu (ký tự == hoa[j]) { ký tự = thường[j]; thoát; };
        };
        kết quả += ký tự;
    };
    trả về kết quả;
};

hàm công khai biên dịch đích cắt(chuỗi, bắt đầu) {
    kết quả = "";
    lặp (i = bắt đầu; i < máy ảo lấy độ dài(chuỗi); i++) { kết quả += chuỗi[i]; };
    trả về kết quả;
};

hàm công khai biên dịch đích bắt đầu(chuỗi, tiền tố) {
    nếu (máy ảo lấy độ dài(chuỗi) < máy ảo lấy độ dài(tiền tố)) { trả về sai; };
    lặp (i = 0; i < máy ảo lấy độ dài(tiền tố); i++) {
        nếu (chuỗi[i] != tiền tố[i]) { trả về sai; };
    };
    trả về đúng;
};

hàm công khai biên dịch phân tích đích(bộ ba) {
    nếu (loại của(bộ ba) != "chuỗi") { ném "target phải là chuỗi"; };
    đầu vào = biên dịch đích chữ thường ASCII(bộ ba);
    vị trí = -1;
    lặp (i = 0; i < máy ảo lấy độ dài(đầu vào); i++) {
        nếu (đầu vào[i] == "-") { vị trí = i; thoát; };
    };
    nếu (vị trí <= 0) { ném "target cần kiến trúc, hệ điều hành và ABI"; };
    tên bộ xử lý trung tâm = "";
    lặp (i = 0; i < vị trí; i++) { tên bộ xử lý trung tâm += đầu vào[i]; };
    tên bộ xử lý trung tâm = biên dịch chuẩn hóa kiến trúc(tên bộ xử lý trung tâm);
    bộ xử lý trung tâm = rỗng;
    thử { bộ xử lý trung tâm = biên dịch thông tin kiến trúc(tên bộ xử lý trung tâm); }
    bắt lỗi (e) { ném "kiến trúc CPU chưa được đăng ký: " + tên bộ xử lý trung tâm; };

    phần sau = biên dịch đích cắt(đầu vào, vị trí + 1);
    tiền tố = ["unknown-", "pc-", "w64-", "apple-"];
    lặp (i = 0; i < máy ảo lấy độ dài(tiền tố); i++) {
        nếu (biên dịch đích bắt đầu(phần sau, tiền tố[i])) {
            phần sau = biên dịch đích cắt(phần sau, máy ảo lấy độ dài(tiền tố[i]));
            thoát;
        };
    };

    hệ = "";
    abi = "";
    định dạng = "";
    chọn (phần sau) {
        ca "linux": { hệ = "linux"; abi = "gnu"; định dạng = "ELF"; }
        ca "linux-gnu": { hệ = "linux"; abi = "gnu"; định dạng = "ELF"; }
        ca "linux-gnueabihf": { hệ = "linux"; abi = "gnueabihf"; định dạng = "ELF"; }
        ca "linux-musl": { hệ = "linux"; abi = "musl"; định dạng = "ELF"; }
        ca "linux-musleabihf": { hệ = "linux"; abi = "musleabihf"; định dạng = "ELF"; }
        ca "windows-msvc": { hệ = "windows"; abi = "msvc"; định dạng = "COFF"; }
        ca "windows-gnu": { hệ = "windows"; abi = "gnu"; định dạng = "COFF"; }
        ca "mingw32": { hệ = "windows"; abi = "gnu"; định dạng = "COFF"; }
        ca "darwin": { hệ = "macos"; abi = "darwin"; định dạng = "Mach-O"; }
        ca "macos": { hệ = "macos"; abi = "darwin"; định dạng = "Mach-O"; }
        mặc định: { ném "hệ điều hành hoặc ABI chưa hỗ trợ: " + phần sau; }
    };
    nếu (hệ == "macos" && tên bộ xử lý trung tâm != "aarch64" && tên bộ xử lý trung tâm != "x86_64") {
        ném "kiến trúc này không có target macOS";
    };
    nếu (hệ == "windows" && tên bộ xử lý trung tâm != "x86_64" && tên bộ xử lý trung tâm != "i386" && tên bộ xử lý trung tâm != "aarch64") {
        ném "kiến trúc này không có target Windows";
    };
    trả về {"kiến trúc": tên bộ xử lý trung tâm, "hệ điều hành": hệ, "ABI": abi,
            "định dạng": định dạng, "bit": bộ xử lý trung tâm["bit"], "little endian": bộ xử lý trung tâm["little endian"]};
};

hàm công khai biên dịch bộ ba chuẩn(đích) {
    tên = đích["kiến trúc"];
    hệ = đích["hệ điều hành"];
    abi = đích["ABI"];
    chọn (hệ) {
        ca "macos": { trả về tên + "-apple-darwin"; }
        ca "windows": {
            nếu (abi == "msvc") { trả về tên + "-pc-windows-msvc"; };
            trả về tên + "-w64-windows-" + abi;
        }
        ca "linux": { trả về tên + "-unknown-linux-" + abi; }
        mặc định: { ném "hệ điều hành chưa hỗ trợ trong canonical triple: " + hệ; }
    };
};
