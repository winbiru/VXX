// Chuẩn hóa bytecode và các pass phân tích bytecode thuần V++.
nhập gói.bộ sưu tập.từ điển.lấy từ điển;

// Lớp sở hữu toàn bộ thuật toán của mô-đun; các hàm bên dưới chỉ giữ API cũ.
lớp công khai Bộ Đọc Mã Lệnh {
    hàm công khai khởi tạo() {};

    hàm công khai biên dịch mã trung gian từ thô(mã trung gian thô) {
        kết quả = [];
        lặp(i = 0; i < máy ảo lấy độ dài(mã trung gian thô); i++) {
            lệnh = mã trung gian thô[i];
            máy ảo thêm cuối danh sách(kết quả, {
                "op": lệnh[0],
                "toán hạng": lệnh[1],
                "chỉ số": lệnh[2],
                "giá trị": lệnh[3]
            });
        };
        trả về kết quả;
    };

    // Pass đếm tần suất opcode thực hiện trong V++ (không cần native riêng).
    // Giữ thứ tự opcode xuất hiện đầu tiên để kết quả có tính quyết định.
    hàm công khai biên dịch thống kê mã thao tác từ mã trung gian(mã trung gian) {
        kết quả = [];
        lặp(i = 0; i < máy ảo lấy độ dài(mã trung gian); i++) {
            mã phép toán = lấy từ điển(mã trung gian[i], "op", -1);
            đã có = sai;
            lặp(j = 0; j < máy ảo lấy độ dài(kết quả); j++) {
                mục = kết quả[j];
                nếu (lấy từ điển(mục, "op", -1) == mã phép toán) {
                    kết quả[j] = {
                        "op": mã phép toán,
                        "số lượng": lấy từ điển(mục, "số lượng", 0) + 1
                    };
                    đã có = đúng;
                    thoát;
                };
            };
            nếu (!đã có) {
                máy ảo thêm cuối danh sách(kết quả, {"op": mã phép toán, "số lượng": 1});
            };
        };
        trả về kết quả;
    };
};


hàm công khai biên dịch mã trung gian từ thô(mã trung gian thô) {
    bộ chuyển tiếp = Bộ Đọc Mã Lệnh();
    trả về bộ chuyển tiếp.biên dịch mã trung gian từ thô(mã trung gian thô);
};

hàm công khai biên dịch thống kê mã thao tác từ mã trung gian(mã trung gian) {
    bộ chuyển tiếp = Bộ Đọc Mã Lệnh();
    trả về bộ chuyển tiếp.biên dịch thống kê mã thao tác từ mã trung gian(mã trung gian);
};

