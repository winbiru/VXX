// Artifact bytecode có version; serializer và parser đều viết bằng V++.
// Giữ nguyên ABI Instruction C++: op, operand, operandIndex, operandValue.
nhập gói/biên dịch/bộ nạp;
nhập gói/biên dịch/mã lệnh;
nhập gói/biên dịch/mã thao tác;
nhập gói/dữ liệu/json/json;
nhập gói/bộ sưu tập/từ điển;
nhập gói/lõi/chuyển kiểu;

// Codec giữ artifact đang xử lý; các bước kiểm tra, tuần tự hóa và giải mã
// sử dụng chung logic ABI và cùng quy tắc kiểm tra dữ liệu.
lớp công khai Bộ Mã Hóa Sản Phẩm Biên Dịch {
    hàm công khai khởi tạo(sản phẩm biên dịch) {
        mình.sản phẩm biên dịch = sản phẩm biên dịch;
    };

    hàm công khai kiểm tra vùng(vùng) {
    biên dịch nạp danh sách(vùng, "bytecode ABI");
    lặp(i = 0; i < máy ảo lấy độ dài(vùng); i++) {
        lệnh = biên dịch nạp danh sách(vùng[i], "lệnh ABI");
        nếu (máy ảo lấy độ dài(lệnh) != 4) { ném "biên dịch artifact: lệnh ABI phải có 4 trường"; };
        lặp(k = 0; k < 4; k++) {
            nếu (loại của(lệnh[k]) != "số nguyên") {
                ném "biên dịch artifact: trường ABI phải là số nguyên i32";
            };
        };
        nếu (!biên dịch có mã thao tác(lệnh[0])) {
            ném "biên dịch artifact: opcode C++ chưa định nghĩa";
        };
    };
    trả về vùng;
    };

    hàm riêng tư kiểm tra gọi ngoại(vùng, ngoại) {
        mã ngoại = biên dịch mã thao tác("OP_FFI_CALL");
        lặp(i = 0; i < máy ảo lấy độ dài(vùng); i++) {
            lệnh = vùng[i];
            nếu (lệnh[0] == mã ngoại) {
                mã định danh = lệnh[2];
                nếu (mã định danh < 0 || mã định danh >= máy ảo lấy độ dài(ngoại) || lệnh[1] < 0 ||
                    lệnh[3] != 0 || lệnh[1] != máy ảo lấy độ dài(ngoại[mã định danh][3])) {
                    ném "biên dịch artifact: OP_FFI_CALL tham chiếu descriptor không hợp lệ";
                };
            };
        };
    };

    // Giữ wire arrays xuyên suốt bước nạp; không tạo một map cho mỗi opcode
    // rồi chuyển ngược thành arrays chỉ để gọi VM.
    hàm công khai kiểm tra dây(dây, loại) {
    biên dịch nạp danh sách(dây, "artifact ABI");
    nếu (máy ảo lấy độ dài(dây) != 4 && máy ảo lấy độ dài(dây) != 5) {
        ném "biên dịch artifact: cần 4 hoặc 5 vùng ABI";
    };
    nếu (loại != "bytecode V++ đã liên kết" && loại != "bytecode V++ đồ thị đã liên kết") {
        ném "biên dịch nạp: cần artifact bytecode V++ đã liên kết";
    };
    biên dịch nạp danh sách(dây[1], "StringPool");
    lặp(i = 0; i < máy ảo lấy độ dài(dây[1]); i++) {
        nếu (loại của(dây[1][i]) != "chuỗi") {
            ném "biên dịch artifact: StringPool phải chứa chuỗi";
        };
    };
    mình.kiểm tra vùng(dây[0]);
    biên dịch nạp danh sách(dây[2], "hàm ABI");
    tên đã khai = {};
    lặp(i = 0; i < máy ảo lấy độ dài(dây[2]); i++) {
        h = biên dịch nạp danh sách(dây[2][i], "hàm ABI");
        nếu (máy ảo lấy độ dài(h) != 3) { ném "biên dịch sản phẩm biên dịch: hàm ABI cần 3 trường"; };
        nếu (loại của(h[0]) != "số nguyên" || h[0] != i) {
            ném "biên dịch nạp: function ID không liên tiếp";
        };
        chỉ mục = h[1];
        nếu (loại của(chỉ mục) != "số nguyên") {
            ném "biên dịch artifact: function name index ngoài StringPool";
        };
        nếu (chỉ mục < -1 || chỉ mục >= máy ảo lấy độ dài(dây[1])) {
            ném "biên dịch artifact: function name index ngoài StringPool";
        };
        nếu (chỉ mục >= 0) {
            khóa = thành chuỗi(chỉ mục);
            nếu (máy ảo có khóa từ điển(tên đã khai, khóa)) { ném "biên dịch nạp: trùng function runtime name index"; };
            tên đã khai[khóa] = đúng;
        };
        mình.kiểm tra vùng(h[2]);
    };
    biên dịch nạp danh sách(dây[3], "initializer ABI");
    nếu (loại == "bytecode V++ đã liên kết" && máy ảo lấy độ dài(dây[3]) != 0) {
        ném "biên dịch nạp: artifact một mô-đun không có initializer";
    };
    mô đun đã khai = {};
    lặp(i = 0; i < máy ảo lấy độ dài(dây[3]); i++) {
        mục = biên dịch nạp danh sách(dây[3][i], "initializer ABI");
        nếu (máy ảo lấy độ dài(mục) != 2) { ném "biên dịch artifact: initializer ABI cần 2 trường"; };
        tên = mục[0];
        nếu (loại của(tên) != "chuỗi" || tên == "") {
            ném "biên dịch nạp: định danh initializer không hợp lệ";
        };
        nếu (máy ảo có khóa từ điển(mô đun đã khai, tên)) { ném "biên dịch nạp: trùng định danh initializer"; };
        mô đun đã khai[tên] = đúng;
        mình.kiểm tra vùng(mục[1]);
    };
    nếu (máy ảo lấy độ dài(dây) == 5) {
        biên dịch nạp danh sách(dây[4], "foreign descriptors ABI");
        lặp(i = 0; i < máy ảo lấy độ dài(dây[4]); i++) {
            d = biên dịch nạp danh sách(dây[4][i], "foreign descriptor ABI");
            nếu (máy ảo lấy độ dài(d) != 8 || loại của(d[0]) != "số nguyên" || d[0] != i ||
                loại của(d[1]) != "chuỗi" || d[1] == "" ||
                loại của(d[2]) != "chuỗi" || d[2] == "" ||
                loại của(d[5]) != "số nguyên" || d[5] < 0 || d[5] > 14 ||
                d[5] == 7 || d[5] == 8 ||
                loại của(d[6]) != "chuỗi" || d[6] != "c" ||
                loại của(d[7]) != "chuỗi" || d[7] == "") {
                ném "biên dịch artifact: foreign descriptor ABI không hợp lệ";
            };
            biên dịch nạp danh sách(d[3], "foreign ABI parameters");
            lặp(j = 0; j < máy ảo lấy độ dài(d[3]); j++) {
                nếu (loại của(d[3][j]) != "số nguyên" ||
                    d[3][j] <= 0 || d[3][j] > 14) {
                    ném "biên dịch artifact: foreign parameter ABI không hợp lệ";
                };
            };
            biên dịch nạp danh sách(d[4], "foreign buffer extents");
            đệm đã thấy = {};
            lặp(j = 0; j < máy ảo lấy độ dài(d[4]); j++) {
                e = biên dịch nạp danh sách(d[4][j], "foreign extent ABI");
                nếu (máy ảo lấy độ dài(e) != 3 || loại của(e[0]) != "số nguyên" ||
                    loại của(e[1]) != "số nguyên" || loại của(e[2]) != "số nguyên" ||
                    e[0] < 0 || e[0] >= máy ảo lấy độ dài(d[3]) ||
                    (d[3][e[0]] != 7 && d[3][e[0]] != 8) ||
                    e[1] < -1 || e[1] >= máy ảo lấy độ dài(d[3]) ||
                    e[2] < 0 || e[2] > 65536 ||
                    (e[1] == -1 && e[2] == 0) ||
                    (e[1] >= 0 && e[2] != 0) ||
                    (e[1] >= 0 && d[3][e[1]] != 1 && d[3][e[1]] != 2 &&
                     d[3][e[1]] != 3 && d[3][e[1]] != 4)) {
                    ném "biên dịch artifact: foreign buffer extent ABI không hợp lệ";
                };
                khóa đệm = thành chuỗi(e[0]);
                nếu (máy ảo có khóa từ điển(đệm đã thấy, khóa đệm)) {
                    ném "biên dịch artifact: foreign buffer extent trùng";
                };
                đệm đã thấy[khóa đệm] = đúng;
            };
            lặp(j = 0; j < máy ảo lấy độ dài(d[3]); j++) {
                nếu ((d[3][j] == 7 || d[3][j] == 8) &&
                    !máy ảo có khóa từ điển(đệm đã thấy, thành chuỗi(j))) {
                    ném "biên dịch artifact: thiếu foreign buffer extent";
                };
            };
        };
    };
    ngoại = [];
    nếu (máy ảo lấy độ dài(dây) == 5) { ngoại = dây[4]; };
    mình.kiểm tra gọi ngoại(dây[0], ngoại);
    lặp(i = 0; i < máy ảo lấy độ dài(dây[2]); i++) {
        mình.kiểm tra gọi ngoại(dây[2][i][2], ngoại);
    };
    lặp(i = 0; i < máy ảo lấy độ dài(dây[3]); i++) {
        mình.kiểm tra gọi ngoại(dây[3][i][1], ngoại);
    };
    trả về dây;
    };

    hàm riêng tư chuẩn bị dây() {
        trả về mình.kiểm tra dây(biên dịch nạp sản phẩm biên dịch(mình.sản phẩm biên dịch), mình.sản phẩm biên dịch["loại"]);
    };

    hàm công khai kiểm tra() {
        mình.chuẩn bị dây();
        trả về mình.sản phẩm biên dịch;
    };

    hàm công khai tuần tự() {
    dây = mình.chuẩn bị dây();
    // Lưu Instruction dưới dạng bốn i32 thay vì lặp bốn tên trường cho mỗi
    // opcode. Compiler lớn có hàng chục nghìn lệnh; metadata tên trường chỉ
    // thuộc biểu diễn trong bộ nhớ, không cần nhân lên trong artifact trên đĩa.
    phiên bản = 1;
    nếu (máy ảo lấy độ dài(dây) == 5) { phiên bản = 2; };
    trả về json tạo({"định dạng": "VPP bytecode", "phiên bản": phiên bản,
                    "ABI": "Instruction 4*i32", "loại": mình.sản phẩm biên dịch["loại"],
                    "dây": dây});
    };

    hàm công khai đọc lệnh(dây) {
    mình.kiểm tra vùng(dây);
    trả về biên dịch mã trung gian từ thô(dây);
    };

    hàm công khai từ dây(gói) {
    dây = mình.kiểm tra dây(lấy từ điển(gói, "dây", rỗng), lấy từ điển(gói, "loại", ""));
    chuỗi = dây[1];
    khai = dây[2];
    danh sách hàm đã khai = [];
    lặp(i = 0; i < máy ảo lấy độ dài(khai); i++) {
        h = khai[i];
        chỉ mục = h[1];
        tên = "";
        nếu (chỉ mục >= 0) { tên = chuỗi[chỉ mục]; };
        máy ảo thêm cuối danh sách(danh sách hàm đã khai, {"id": h[0], "tên": tên, "tên index": chỉ mục,
            "tên index runtime": chỉ mục, "bytecode": biên dịch mã trung gian từ thô(h[2])});
    };
    initializer = dây[3];
    mô đun = [];
    lặp(i = 0; i < máy ảo lấy độ dài(initializer); i++) {
        mục = initializer[i];
        máy ảo thêm cuối danh sách(mô đun, {"định danh": mục[0], "bytecode": biên dịch mã trung gian từ thô(mục[1])});
    };
    ngoại = [];
    nếu (máy ảo lấy độ dài(dây) == 5) {
        lặp(i = 0; i < máy ảo lấy độ dài(dây[4]); i++) {
            d = dây[4][i];
            máy ảo thêm cuối danh sách(ngoại, {"id": d[0], "thư viện": d[1], "ký hiệu": d[2],
                "tham số": d[3], "đệm": d[4], "kết quả": d[5],
                "abi": d[6], "khả năng": d[7]});
        };
    };
    trả về {"loại": lấy từ điển(gói, "loại", ""), "chuỗi": chuỗi,
        "bytecode": biên dịch mã trung gian từ thô(dây[0]),
        "hàm": danh sách hàm đã khai, "mô đun khởi tạo": mô đun, "ngoại": ngoại};
    };

    hàm riêng tư đọc gói(văn bản) {
    gói = json phân tích(văn bản);
    nếu (loại của(gói) != "từ điển") {
        ném "biên dịch artifact: cần tài liệu từ điển";
    };
    nếu (lấy từ điển(gói, "định dạng", "") != "VPP bytecode" ||
        loại của(lấy từ điển(gói, "phiên bản", rỗng)) != "số nguyên" ||
        (lấy từ điển(gói, "phiên bản", -1) != 1 &&
         lấy từ điển(gói, "phiên bản", -1) != 2) ||
        lấy từ điển(gói, "ABI", "") != "Instruction 4*i32") {
        ném "biên dịch artifact: định dạng, phiên bản hoặc ABI không hỗ trợ";
    };
    nếu (máy ảo có khóa từ điển(gói, "dây")) {
        dây = biên dịch nạp danh sách(gói["dây"], "artifact wire");
        nếu ((máy ảo lấy độ dài(dây) == 4 && gói["phiên bản"] != 1) ||
            (máy ảo lấy độ dài(dây) == 5 && gói["phiên bản"] != 2)) {
            ném "biên dịch artifact: phiên bản không khớp số vùng ABI";
        };
    };
    trả về gói;
    };

    hàm công khai giải mã(văn bản) {
    gói = mình.đọc gói(văn bản);
    nếu (máy ảo có khóa từ điển(gói, "dây")) {
        mình.sản phẩm biên dịch = mình.từ dây(gói);
        trả về mình.sản phẩm biên dịch;
    };
    // Đọc được biểu diễn map của bootstrap version 1 trước khi chuyển sang
    // wire arrays; không gọi lại compiler hoặc sửa opcode của dữ liệu cũ.
    mình.sản phẩm biên dịch = lấy từ điển(gói, "artifact", rỗng);
    trả về mình.kiểm tra();
    };

    hàm công khai giải mã dây(văn bản) {
        gói = mình.đọc gói(văn bản);
        nếu (máy ảo có khóa từ điển(gói, "dây")) {
            trả về mình.kiểm tra dây(gói["dây"], lấy từ điển(gói, "loại", ""));
        };
        mình.sản phẩm biên dịch = lấy từ điển(gói, "artifact", rỗng);
        trả về mình.chuẩn bị dây();
    };

    hàm công khai chạy văn bản(văn bản) {
        dây = mình.giải mã dây(văn bản);
        nếu (máy ảo lấy độ dài(dây) == 5) {
            trả về mã trung gian chạy bản địa(dây[0], dây[1], dây[2], dây[3], dây[4]);
        };
        trả về mã trung gian chạy máy ảo(dây[0], dây[1], dây[2], dây[3]);
    };
};

// Hàm tương thích dành cho compiler/linker và các chương trình đã viết.
hàm công khai biên dịch sản phẩm biên dịch kiểm tra(sản phẩm biên dịch) {
    bộ mã hóa = Bộ Mã Hóa Sản Phẩm Biên Dịch(sản phẩm biên dịch);
    trả về bộ mã hóa.kiểm tra();
};

hàm công khai biên dịch sản phẩm biên dịch tuần tự(sản phẩm biên dịch) {
    bộ mã hóa = Bộ Mã Hóa Sản Phẩm Biên Dịch(sản phẩm biên dịch);
    trả về bộ mã hóa.tuần tự();
};

hàm công khai biên dịch sản phẩm biên dịch đọc lệnh(dây) {
    bộ mã hóa = Bộ Mã Hóa Sản Phẩm Biên Dịch(rỗng);
    trả về bộ mã hóa.đọc lệnh(dây);
};

hàm công khai biên dịch sản phẩm biên dịch từ dây(gói) {
    bộ mã hóa = Bộ Mã Hóa Sản Phẩm Biên Dịch(rỗng);
    trả về bộ mã hóa.từ dây(gói);
};

hàm công khai biên dịch sản phẩm biên dịch giải mã(văn bản) {
    bộ mã hóa = Bộ Mã Hóa Sản Phẩm Biên Dịch(rỗng);
    trả về bộ mã hóa.giải mã(văn bản);
};

hàm công khai biên dịch sản phẩm biên dịch giải mã dây(văn bản) {
    bộ mã hóa = Bộ Mã Hóa Sản Phẩm Biên Dịch(rỗng);
    trả về bộ mã hóa.giải mã dây(văn bản);
};

hàm công khai biên dịch chạy sản phẩm biên dịch văn bản(văn bản) {
    bộ mã hóa = Bộ Mã Hóa Sản Phẩm Biên Dịch(rỗng);
    trả về bộ mã hóa.chạy văn bản(văn bản);
};
