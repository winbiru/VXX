

// Lớp sở hữu toàn bộ thuật toán của mô-đun; các hàm bên dưới chỉ giữ API cũ.
lớp công khai Tiện Ích Mã Máy {
    hàm công khai khởi tạo() {};

    // Bootstrap raw machine-code leaf emitter THUẦN V++.
    // Trả về DANH SÁCH BYTE, không phải ELF/COFF/Mach-O hay executable.
    // Các word/opcode phải khớp src/native/raw_codegen.cpp (parity tests).
    // Tiện ích ghép byte được dùng chung bởi các backend ISA.
    hàm công khai biên dịch mã máy chữ thập lục phân(chữ) {
        bảng = "0123456789abcdef";
        lặp (i = 0; i < 16; i++) {
            nếu (bảng[i] == chữ) { trả về i; };
        };
        ném "mã máy: chữ số hex không hợp lệ";
    };

    // V++ hiện dùng int32 cho nhiều phép tính. Ghép hai halfword ở dạng signed
    // để không tạo intermediate unsigned 0xffffffff vượt miền số nguyên.
    hàm công khai biên dịch mã máy từ máy thập lục phân(chuỗi) {
        nếu (máy ảo lấy độ dài(chuỗi) != 8) { ném "mã máy: word hex cần 8 chữ số"; };
        cao = 0;
        thấp = 0;
        lặp (i = 0; i < 4; i++) {
            cao = cao * 16 + mình.biên dịch mã máy chữ thập lục phân(chuỗi[i]);
            thấp = thấp * 16 + mình.biên dịch mã máy chữ thập lục phân(chuỗi[i + 4]);
        };
        trả về mình.biên dịch mã máy ghép(cao, thấp);
    };

    hàm công khai biên dịch mã máy ghép(cao, thấp) {
        nếu (cao < 0 || cao > 65535 || thấp < 0 || thấp > 65535) {
            ném "mã máy: halfword nằm ngoài u16";
        };
        nếu (cao >= 32768) { cao -= 65536; };
        trả về cao * 65536 + thấp;
    };

    // Chia nguyên signed sau khi trừ remainder chính xác; hỗ trợ word âm.
    hàm công khai biên dịch mã máy thêm từ máy(ra, từ máy, ít trước) {
        các byte = [];
        số = từ máy;
        lặp (i = 0; i < 4; i++) {
            byte = số % 256;
            nếu (byte < 0) { byte += 256; };
            máy ảo thêm cuối danh sách(các byte, byte);
            số = (số - byte) / 256;
        };
        lặp (i = 0; i < 4; i++) {
            nếu (ít trước) { máy ảo thêm cuối danh sách(ra, các byte[i]); }
            hoặc { máy ảo thêm cuối danh sách(ra, các byte[3 - i]); };
        };
        trả về ra;
    };

    hàm công khai biên dịch mã máy thêm thập lục phân(ra, từ máy thập lục phân, ít trước) {
        trả về mình.biên dịch mã máy thêm từ máy(ra,
            mình.biên dịch mã máy từ máy thập lục phân(từ máy thập lục phân), ít trước);
    };

    hàm công khai biên dịch mã máy trả về(hằng) {
        nếu (hằng < -2147483647 - 1 || hằng > 2147483647) {
            ném "mã máy V++: hằng nằm ngoài i32";
        };
        lo = hằng % 65536;
        nếu (lo < 0) { lo += 65536; };
        hi = (hằng - lo) / 65536;
        nếu (hi < 0) { hi += 65536; };
        trả về {"lo": lo, "hi": hi};
    };

    // Machine IR dùng cùng tên opcode và các trường với C++ MachineInstruction.
    hàm công khai biên dịch mã máy lệnh(mã thao tác, hằng tức thời = 0, toán hạng = 0,
                               độ sâu trước đó = 0, mục ký hiệu = "") {
        trả về {"opcode": mã thao tác, "immediate": hằng tức thời, "operand": toán hạng,
                "depthBefore": độ sâu trước đó, "symbol": mục ký hiệu};
    };

    // C++ symbolNameSafe: chỉ chấp nhận ASCII [A-Za-z_][A-Za-z0-9_]*.
    hàm công khai biên dịch mã máy ký hiệu hợp lệ(tên) {
        nếu (máy ảo lấy độ dài(tên) == 0) { trả về sai; };
        chữ cái = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_";
        chữ số = chữ cái + "0123456789";
        lặp (i = 0; i < máy ảo lấy độ dài(tên); i++) {
            bảng = chữ số;
            nếu (i == 0) { bảng = chữ cái; };
            có = sai;
            lặp (j = 0; j < máy ảo lấy độ dài(bảng); j++) {
                nếu (tên[i] == bảng[j]) { có = đúng; thoát; };
            };
            nếu (!có) { trả về sai; };
        };
        trả về đúng;
    };

    // Validate stack transfer từng opcode, kể cả lệnh không thể tới được.
    hàm riêng tư biên dịch mã máy stack sau(mã phép toán, ô nhớ, sâu nhất, tổng lệnh) {
        mã = mã phép toán["opcode"];
        trước = mã phép toán["depthBefore"];
        toán hạng = mã phép toán["operand"];
        nếu (trước < 0 || trước > sâu nhất) { ném "machine IR stack vượt frame"; };
        nếu (mã == "Jump" || mã == "BranchZero") {
            nếu (toán hạng < 0 || toán hạng >= tổng lệnh) {
                ném "machine IR branch ngoài phạm vi";
            };
        };
        chọn (mã) {
            ca "PushConstant": {
                nếu (trước >= sâu nhất) { ném "machine IR stack overflow"; };
                trả về trước + 1;
            }
            ca "LoadSlot": {
                nếu (toán hạng < 0 || toán hạng >= ô nhớ || trước >= sâu nhất) {
                    ném "machine IR load slot ngoài frame";
                };
                trả về trước + 1;
            }
            ca "StoreSlot": {
                nếu (toán hạng < 0 || toán hạng >= ô nhớ || trước == 0) {
                    ném "machine IR store slot ngoài frame";
                };
                trả về trước;
            }
            ca "Drop": {
                nếu (trước == 0) { ném "machine IR stack underflow"; };
                trả về trước - 1;
            }
            ca "BranchZero": {
                nếu (trước == 0) { ném "machine IR stack underflow"; };
                trả về trước - 1;
            }
            ca "Return": {
                nếu (trước != 1) { ném "machine IR return phải tiêu thụ đúng một giá trị"; };
                trả về 0;
            }
            ca "Add": { trả về mình.biên dịch mã máy stack nhị phân(trước); }
            ca "Sub": { trả về mình.biên dịch mã máy stack nhị phân(trước); }
            ca "Mul": { trả về mình.biên dịch mã máy stack nhị phân(trước); }
            ca "Equal": { trả về mình.biên dịch mã máy stack nhị phân(trước); }
            ca "NotEqual": { trả về mình.biên dịch mã máy stack nhị phân(trước); }
            ca "Less": { trả về mình.biên dịch mã máy stack nhị phân(trước); }
            ca "LessEqual": { trả về mình.biên dịch mã máy stack nhị phân(trước); }
            ca "Greater": { trả về mình.biên dịch mã máy stack nhị phân(trước); }
            ca "GreaterEqual": { trả về mình.biên dịch mã máy stack nhị phân(trước); }
            ca "Call": {
                nếu (toán hạng < 0 || trước < toán hạng ||
                    trước - toán hạng >= sâu nhất ||
                    !mình.biên dịch mã máy ký hiệu hợp lệ(mã phép toán["symbol"])) {
                    ném "machine IR call/stack/symbol không hợp lệ";
                };
                trả về trước - toán hạng + 1;
            }
            ca "Jump": { trả về trước; }
            ca "Trap": { trả về trước; }
            mặc định: { ném "MachineOpcode C++ chưa định nghĩa: " + mã; }
        };
    };

    hàm riêng tư biên dịch mã máy stack nhị phân(trước) {
        nếu (trước < 2) { ném "machine IR binary stack underflow"; };
        trả về trước - 1;
    };

    // Bản V++ của validateMachineStack C++: kiểm tra các đường CFG, nhảy lùi,
    // độ sâu tại điểm hợp nhánh, return và fallthrough.
    hàm riêng tư biên dịch mã máy CFG nối(độ sâu đến, hàng đợi, đích, sâu) {
        nếu (độ sâu đến[đích] == -1) {
            độ sâu đến[đích] = sâu;
            máy ảo thêm cuối danh sách(hàng đợi, đích);
        };
        nếu (độ sâu đến[đích] != sâu) {
            ném "machine IR stack không khớp tại CFG join/branch";
        };
    };

    hàm công khai biên dịch mã máy kiểm tra CFG(danh sách hàm biểu diễn trung gian) {
        lệnh = danh sách hàm biểu diễn trung gian["instructions"];
        n = máy ảo lấy độ dài(lệnh);
        nếu (n == 0) { ném "machine IR không có lệnh"; };
        ô nhớ = danh sách hàm biểu diễn trung gian["slotCount"];
        sâu nhất = danh sách hàm biểu diễn trung gian["maxStackDepth"];
        sau = [];
        độ sâu đến = [];
        lặp (i = 0; i < n; i++) {
            máy ảo thêm cuối danh sách(sau, mình.biên dịch mã máy stack sau(lệnh[i], ô nhớ, sâu nhất, n));
            máy ảo thêm cuối danh sách(độ sâu đến, -1);
        };
        độ sâu đến[0] = 0;
        hàng đợi = [0];
        lặp (head = 0; head < máy ảo lấy độ dài(hàng đợi); head++) {
            i = hàng đợi[head];
            mã phép toán = lệnh[i];
            nếu (độ sâu đến[i] != mã phép toán["depthBefore"]) {
                ném "machine IR stack depth sai tại CFG join/branch";
            };
            mã = mã phép toán["opcode"];
            nếu (mã == "Return" || mã == "Trap") { bỏ qua; };
            nếu (mã == "Jump" || mã == "BranchZero") {
                mình.biên dịch mã máy CFG nối(độ sâu đến, hàng đợi, mã phép toán["operand"], sau[i]);
            };
            nếu (mã != "Jump") {
                nếu (i + 1 >= n) { ném "machine IR fallthrough vượt cuối hàm"; };
                mình.biên dịch mã máy CFG nối(độ sâu đến, hàng đợi, i + 1, sau[i]);
            };
        };
        trả về đúng;
    };
};


hàm công khai biên dịch mã máy chữ thập lục phân(chữ) {
    bộ chuyển tiếp = Tiện Ích Mã Máy();
    trả về bộ chuyển tiếp.biên dịch mã máy chữ thập lục phân(chữ);
};

hàm công khai biên dịch mã máy từ máy thập lục phân(chuỗi) {
    bộ chuyển tiếp = Tiện Ích Mã Máy();
    trả về bộ chuyển tiếp.biên dịch mã máy từ máy thập lục phân(chuỗi);
};

hàm công khai biên dịch mã máy ghép(cao, thấp) {
    bộ chuyển tiếp = Tiện Ích Mã Máy();
    trả về bộ chuyển tiếp.biên dịch mã máy ghép(cao, thấp);
};

hàm công khai biên dịch mã máy thêm từ máy(ra, từ máy, ít trước) {
    bộ chuyển tiếp = Tiện Ích Mã Máy();
    trả về bộ chuyển tiếp.biên dịch mã máy thêm từ máy(ra, từ máy, ít trước);
};

hàm công khai biên dịch mã máy thêm thập lục phân(ra, từ máy thập lục phân, ít trước) {
    bộ chuyển tiếp = Tiện Ích Mã Máy();
    trả về bộ chuyển tiếp.biên dịch mã máy thêm thập lục phân(ra, từ máy thập lục phân, ít trước);
};

hàm công khai biên dịch mã máy trả về(hằng) {
    bộ chuyển tiếp = Tiện Ích Mã Máy();
    trả về bộ chuyển tiếp.biên dịch mã máy trả về(hằng);
};

hàm công khai biên dịch mã máy lệnh(mã thao tác, hằng tức thời = 0, toán hạng = 0,
                           độ sâu trước đó = 0, mục ký hiệu = "") {
    bộ chuyển tiếp = Tiện Ích Mã Máy();
    trả về bộ chuyển tiếp.biên dịch mã máy lệnh(mã thao tác, hằng tức thời, toán hạng, độ sâu trước đó, mục ký hiệu);
};

hàm công khai biên dịch mã máy ký hiệu hợp lệ(tên) {
    bộ chuyển tiếp = Tiện Ích Mã Máy();
    trả về bộ chuyển tiếp.biên dịch mã máy ký hiệu hợp lệ(tên);
};

hàm công khai biên dịch mã máy kiểm tra CFG(danh sách hàm biểu diễn trung gian) {
    bộ chuyển tiếp = Tiện Ích Mã Máy();
    trả về bộ chuyển tiếp.biên dịch mã máy kiểm tra CFG(danh sách hàm biểu diễn trung gian);
};

