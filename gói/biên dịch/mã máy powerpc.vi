// powerpc: phát byte mã máy kiến trúc riêng.
// Các phép chưa hỗ trợ phải ném lỗi tại bộ chọn lowering, không phát mã sai.
nhập gói/biên dịch/mã máy nền;

// Lớp sở hữu toàn bộ thuật toán của mô-đun; các hàm bên dưới chỉ giữ API cũ.
lớp công khai Bộ Phát POWERPC {
    hàm công khai khởi tạo() {};

    hàm công khai biên dịch mã máy phát powerpc(loại, hằng, thấp, cao, ít, hệ điều hành) {
        ra = [];
        nếu (loại == "hằng") {
                biên dịch mã máy thêm từ máy(ra, biên dịch mã máy từ máy thập lục phân("3c600000") + cao, ít);
                biên dịch mã máy thêm từ máy(ra, biên dịch mã máy từ máy thập lục phân("60630000") + thấp, ít);
            } hoặc {
                nếu (loại == "cộng") { biên dịch mã máy thêm thập lục phân(ra, "7c632214", ít); }
                hoặc { biên dịch mã máy thêm thập lục phân(ra, "7c641850", ít); };
            };
            biên dịch mã máy thêm thập lục phân(ra, "4e800020", ít);
        trả về ra;
    };
};


hàm công khai biên dịch mã máy phát powerpc(loại, hằng, thấp, cao, ít, hệ điều hành) {
    bộ chuyển tiếp = Bộ Phát POWERPC();
    trả về bộ chuyển tiếp.biên dịch mã máy phát powerpc(loại, hằng, thấp, cao, ít, hệ điều hành);
};
