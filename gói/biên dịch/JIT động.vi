// Native ARM64/x86-64 in-memory image writer. The AOT lowering emits native
// instructions; this sink replaces the object writer, not the code generator.
// All symbol resolution, branch layout and metadata construction are V++.
nhập gói.biên dịch.asm chương trình.biên dịch asm chương trình;
nhập gói.biên dịch.nguồn tệp.biên dịch nguồn tệp tự chủ;
nhập gói.biên dịch.nguồn tệp.biên dịch nguồn nhúng tự chủ;
nhập gói.biên dịch.bộ nạp.biên dịch nạp sản phẩm biên dịch;
nhập gói.bộ sưu tập.từ điển.lấy từ điển;

hàm riêng tư ảnh cần(ok, lỗi) {
    nếu (!ok) { ném "V++ JIT động: " + lỗi; };
};
// Keep in lockstep with vpp_aot_vpp_exports.inc and the bridge table.
