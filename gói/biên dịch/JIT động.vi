    trả về [
        "vpp_native_dynamic_integer",
        "vpp_native_dynamic_string",
        "vpp_native_dynamic_floating",
        "vpp_native_dynamic_null",
        "vpp_native_dynamic_load",
        "vpp_native_dynamic_load_inline",
        "vpp_native_dynamic_is_i32",
