hàm đọc tệp nguồn(đường tệp, nguồn đầu vào) {
    biến tệp dữ liệu = tệp mở đọc(đường tệp);
    nếu (tệp dữ liệu <= 0) { trả về -1; };
    biến hoàn thành = 0;
    lặp (i = 0; i < 300; i++) {
        biến số phần tử = tệp đọc khối(tệp dữ liệu, nguồn đầu vào);
        nếu (số phần tử < 0) { thoát; };
        nếu (số phần tử == 0) { hoàn thành = 1; thoát; };
    };
    nếu (tệp đóng(tệp dữ liệu) != 0) { trả về -1; };
    nếu (hoàn thành != 1) { trả về -1; };
    trả về byte dài(nguồn đầu vào);
};

// Nhận diện Linux qua procfs cho cả Stage 0 và các thế hệ tự biên dịch.
hàm chạy trên linux() {
    biến đường tệp = "/proc/self/exe";
    biến mã tài nguyên = tệp mở đọc(đường tệp);
    byte hủy(đường tệp);
    nếu (mã tài nguyên <= 0) { trả về 0; };
    tệp đóng(mã tài nguyên);
    trả về 1;
};

// Xuất object có thể liên kết; lời gọi runtime được giải quyết khi liên kết.
// Ghi tệp tạm rồi đổi tên để giữ nguyên đầu ra cũ nếu thất bại.
hàm ghi tệp đối tượng(kho lưu trữ, tiền tố, kết xuất, nguồn đầu vào) {
    nếu (thực thi liên kết kiểm tra hợp lệ files(kết xuất, nguồn đầu vào) != 0) { trả về -1; };
    biến chiều dài = thực thi đối tượng kho lưu trữ điểm vào(kho lưu trữ, tiền tố);
    nếu (chiều dài <= 0) { trả về -1; };
    nếu (byte dài(kho lưu trữ) != tiền tố + chiều dài + 4) { trả về -1; };
    biến tạm = byte mới();
    nếu (tạm <= 0) { trả về -1; };
    biến mã trạng thái = -1;
    biến mã tệp mở = -1;
    biến đã tạo = 0;
    nếu (thực thi liên kết tạm thời đường tệp(kết xuất, tạm, 0) == 0) {
        mã tệp mở = thực thi liên kết tạm mở(tạm);
        nếu (mã tệp mở >= 0) { đã tạo = 1; };
    };
    nếu (mã tệp mở >= 0) {
        nếu (thực thi liên kết ghi đối tượng(mã tệp mở, kho lưu trữ, tiền tố) == chiều dài) {
            mã trạng thái = 0;
        };
        nếu (máy đóng(mã tệp mở) != 0) { mã trạng thái = -1; };
    };
    nếu (mã trạng thái == 0) {
        nếu (thực thi liên kết công bố(tạm, kết xuất) != 0) { mã trạng thái = -1; };
    };
    nếu (đã tạo == 1) {
        // On successful rename the temporary pathname no longer exists.
        máy xóa(thực thi nội dung đệm(thực thi các byte ô nhớ(tạm)));
    };
    byte hủy(tạm);
    trả về mã trạng thái;
};

// Chế độ 0: tệp chạy; chế độ 1: object có thể liên kết.
hàm biên dịch tệp(nguồn đầu vào đường tệp, kết xuất đường tệp, chế độ xuất) {
    biến linux = chạy trên linux();
    biến nguồn đầu vào = byte mới();
    biến biểu diễn trung gian = byte mới();
    biến các hàm = byte mới();
    biến mã máy = byte mới();
    biến đối tượng = byte mới();
    biến ngoại các lời gọi = byte mới();
    biến sổ đăng ký = byte mới();
    biến mô đun ends = byte mới();
    biến các điểm bắt đầu = byte mới();
    biến các phần nhập = byte mới();
    biến đối tượng kho lưu trữ = byte mới();
    biến đơn vị nguồn đầu vào = byte mới();
    biến mã trạng thái = 0;
    // Kể cả khi cấp phát giữa chừng thất bại, đi qua một đường giải phóng.
    nếu (nguồn đầu vào <= 0) { mã trạng thái = 11; };
    nếu (biểu diễn trung gian <= 0) { mã trạng thái = 11; };
    nếu (các hàm <= 0) { mã trạng thái = 11; };
    nếu (mã máy <= 0) { mã trạng thái = 11; };
    nếu (đối tượng <= 0) { mã trạng thái = 11; };
    nếu (ngoại các lời gọi <= 0) { mã trạng thái = 11; };
    nếu (sổ đăng ký <= 0) { mã trạng thái = 11; };
    nếu (mô đun ends <= 0) { mã trạng thái = 11; };
    nếu (các điểm bắt đầu <= 0) { mã trạng thái = 11; };
    nếu (các phần nhập <= 0) { mã trạng thái = 11; };
    nếu (đối tượng kho lưu trữ <= 0) { mã trạng thái = 11; };
    nếu (đơn vị nguồn đầu vào <= 0) { mã trạng thái = 11; };
    biến điểm vào mã định danh = -1;
    nếu (mã trạng thái == 0) {
        nếu (nạp mô đun chuẩn bị(nguồn đầu vào đường tệp, nguồn đầu vào) <= 0) { mã trạng thái = 12; };
    };
    nếu (mã trạng thái == 0) {
        điểm vào mã định danh = biên dịch các mô đun(nguồn đầu vào, biểu diễn trung gian, các hàm, sổ đăng ký, mô đun ends) - 1;
        nếu (điểm vào mã định danh < 0) { mã trạng thái = 14; };
    };
    nếu (mã trạng thái == 0) {
        biến đầu tiên = 0;
        biến nguồn đầu vào độ lệch = 0;
        lặp (đơn vị = 0; đơn vị < byte dài(mô đun ends); đơn vị = đơn vị + 4) {
            biến cuối cùng = byte đọc số nguyên ba mươi hai bit(mô đun ends, đơn vị);
            nếu (cuối cùng < đầu tiên) { mã trạng thái = 14; thoát; };
            nguồn đầu vào độ lệch = biên dịch mô đun đọc đơn vị(nguồn đầu vào, nguồn đầu vào độ lệch, đơn vị nguồn đầu vào);
            nếu (nguồn đầu vào độ lệch < 0) { mã trạng thái = 14; thoát; };
            nếu (cuối cùng > đầu tiên) {
                biến định dạng xuất = 2;
                nếu (linux == 1) { định dạng xuất = 3; };
                biến khóa tra cứu = bộ nhớ đệm biên dịch khóa tra cứu(định dạng xuất, đơn vị nguồn đầu vào, sổ đăng ký, đầu tiên, cuối cùng, điểm vào mã định danh);
                biến đã có bộ nhớ đệm = 0;
                nếu (khóa tra cứu > 0) { đã có bộ nhớ đệm = bộ nhớ đệm đọc(khóa tra cứu, đối tượng); };
                nếu (đã có bộ nhớ đệm != 1) {
                    biến đã sinh mã = -1;
                    nếu (linux == 1) {
                        đã sinh mã = sinh mã chương trình x86 phát mô đun(biểu diễn trung gian, các hàm, mã máy, đầu tiên, cuối cùng, các điểm bắt đầu, các phần nhập, ngoại các lời gọi);
                    } hoặc {
                        đã sinh mã = sinh mã chương trình phát mô đun(biểu diễn trung gian, các hàm, mã máy, đầu tiên, cuối cùng, các điểm bắt đầu, các phần nhập, ngoại các lời gọi);
                    };
                    nếu (đã sinh mã <= 0) {
                        mã trạng thái = 15;
                    }
                    hoặc {
                        biến đã phát mã = -1;
                        nếu (linux == 1) {
                            đã phát mã = elf mô đun(mã máy, đối tượng, các điểm bắt đầu, sổ đăng ký, đầu tiên, cuối cùng, điểm vào mã định danh, các phần nhập, ngoại các lời gọi);
                        } hoặc {
                            đã phát mã = tạo macho mô đun(mã máy, đối tượng, các điểm bắt đầu, sổ đăng ký, đầu tiên, cuối cùng, điểm vào mã định danh, các phần nhập, ngoại các lời gọi);
                        };
                        nếu (đã phát mã <= 0) {
                            mã trạng thái = 16;
                        };
                    };
                    nếu (mã trạng thái == 0) {
                        nếu (khóa tra cứu > 0) { bộ nhớ đệm ghi(khóa tra cứu, đối tượng); };
                    };
                };
                nếu (khóa tra cứu > 0) { byte hủy(khóa tra cứu); };
                nếu (mã trạng thái != 0) { thoát; };
                nếu (byte đẩy số nguyên ba mươi hai bit(đối tượng kho lưu trữ, byte dài(đối tượng)) != 0) { mã trạng thái = 16; thoát; };
                nếu (byte nối(đối tượng kho lưu trữ, đối tượng) != 0) { mã trạng thái = 16; thoát; };
            };
            đầu tiên = cuối cùng;
        };
        nếu (byte dài(đối tượng kho lưu trữ) <= 0) { mã trạng thái = 16; };
    };
    nếu (mã trạng thái == 0) {
        nếu (chế độ xuất == 1) {
            // A single source object can be written without invoking ld.
            // Multiple import objects are merged with relocations intact;
            // the implicit runtime object is deliberately omitted.
            nếu (byte dài(mô đun ends) == 8) {
                biến runtime chiều dài = thực thi đối tượng kho lưu trữ điểm vào(đối tượng kho lưu trữ, 0);
                nếu (runtime chiều dài <= 0) { mã trạng thái = 19; }
                hoặc {
                    nếu (ghi tệp đối tượng(đối tượng kho lưu trữ, runtime chiều dài + 4, kết xuất đường tệp, nguồn đầu vào đường tệp) != 0) {
                        mã trạng thái = 19;
                    };
                };
            } hoặc {
                nếu (thực thi liên kết đối tượng các mô đun(đối tượng kho lưu trữ, kết xuất đường tệp, nguồn đầu vào đường tệp) != 0) {
                    mã trạng thái = 19;
                };
            };
        } hoặc {
            nếu (liên kết đối tượng(đối tượng kho lưu trữ, kết xuất đường tệp, nguồn đầu vào đường tệp) != 0) { mã trạng thái = 17; };
        };
    };

    byte hủy(nguồn đầu vào);
    byte hủy(biểu diễn trung gian);
    byte hủy(các hàm);
    byte hủy(mã máy);
    byte hủy(đối tượng);
    byte hủy(ngoại các lời gọi);
    byte hủy(sổ đăng ký);
    byte hủy(mô đun ends);
    byte hủy(các điểm bắt đầu);
    byte hủy(các phần nhập);
    byte hủy(đối tượng kho lưu trữ);
    byte hủy(đơn vị nguồn đầu vào);
    trả về mã trạng thái;
};

// Kiểm tra nguồn, mô đun và IR hoàn toàn trong V++; không cần liên kết.
hàm kiểm tra nguồn(nguồn đầu vào đường tệp) {
    biến nguồn đầu vào = byte mới();
    biến biểu diễn trung gian = byte mới();
    biến các hàm = byte mới();
    biến sổ đăng ký = byte mới();
    biến mô đun ends = byte mới();
    biến mã trạng thái = 0;
    nếu (nguồn đầu vào <= 0) { mã trạng thái = 11; };
    nếu (biểu diễn trung gian <= 0) { mã trạng thái = 11; };
    nếu (các hàm <= 0) { mã trạng thái = 11; };
    nếu (sổ đăng ký <= 0) { mã trạng thái = 11; };
    nếu (mô đun ends <= 0) { mã trạng thái = 11; };
    nếu (mã trạng thái == 0) {
        nếu (nạp mô đun chuẩn bị(nguồn đầu vào đường tệp, nguồn đầu vào) <= 0) { mã trạng thái = 12; };
    };
    nếu (mã trạng thái == 0) {
        nếu (biên dịch các mô đun(nguồn đầu vào, biểu diễn trung gian, các hàm, sổ đăng ký, mô đun ends) <= 0) {
            mã trạng thái = 14;
        };
    };
    byte hủy(nguồn đầu vào);
    byte hủy(biểu diễn trung gian);
    byte hủy(các hàm);
    byte hủy(sổ đăng ký);
    byte hủy(mô đun ends);
    trả về mã trạng thái;
};

// CLI native tự xuất hướng dẫn, không cần khởi động CLI C++.
hàm hiện trợ giúp() {
    biến nội dung = "V++ - trình biên dịch i32 (Mach-O/ELF)\nLệnh:\n  kiểm tra <nguồn.vi>\n  biên dịch <nguồn.vi> [--đầu-ra <tệp>]\n  đối tượng <nguồn.vi> [--đầu-ra <tệp.o>]\n  xuất đối tượng <nguồn.vi> [--đầu-ra <tệp.o>]\n  biên dịch --đầu-ra <tệp> <nguồn.vi>\n  trợ giúp | phiên bản\nTương thích: check, build, dựng, object, -o, --help, --version\n";
    biến kết quả = byte in(nội dung);
    byte hủy(nội dung);
    nếu (kết quả < 0) { trả về 11; };
    trả về 0;
};

hàm hiện phiên bản() {
    biến nội dung = "V++ - trình biên dịch i32 (Mach-O/ELF)\n";
    biến kết quả = byte in(nội dung);
    byte hủy(nội dung);
    nếu (kết quả < 0) { trả về 11; };
    trả về 0;
};

// Không ghi đè nguồn: tên mặc định lấy từ nguồn.vi hoặc thêm hậu tố.
// Bên gọi có trách nhiệm giải phóng bộ đệm kết quả.
hàm tạo tên đầu ra(nguồn, chế độ xuất) {
    biến chiều dài = byte dài(nguồn);
    nếu (chiều dài <= 0) { trả về -1; };
    biến đầu ra = byte mới();
    nếu (đầu ra <= 0) { trả về -1; };
    biến có đuôi vi = 0;
    nếu (chiều dài > 3) {
        biến đuôi = byte cắt(nguồn, chiều dài - 3, 3);
        biến tên đuôi = ".vi";
        nếu (đuôi > 0) {
            nếu (byte bằng(đuôi, tên đuôi) == 1) { có đuôi vi = 1; };
            byte hủy(đuôi);
        };
        byte hủy(tên đuôi);
    };
    biến số byte = chiều dài;
    nếu (có đuôi vi == 1) { số byte = chiều dài - 3; };
    biến phần tên = byte cắt(nguồn, 0, số byte);
    nếu (phần tên <= 0) { byte hủy(đầu ra); trả về -1; };
    biến trạng thái = byte nối(đầu ra, phần tên);
    byte hủy(phần tên);
    biến hậu tố = ".o";
    nếu (chế độ xuất == 0) {
        nếu (có đuôi vi == 1) { byte hủy(hậu tố); hậu tố = ""; }
        hoặc { byte hủy(hậu tố); hậu tố = ".out"; };
    };
    nếu (trạng thái == 0) { trạng thái = byte nối(đầu ra, hậu tố); };
    byte hủy(hậu tố);
    nếu (trạng thái != 0) { byte hủy(đầu ra); trả về -1; };
    trả về đầu ra;
};

// Giá trị 0: biên dịch, 1: đối tượng, 2: kiểm tra, 3: trợ giúp,
// 4: phiên bản. Mọi lệnh CLI được phân tích trong V++.
hàm loại lệnh(đầu lệnh) {
    nếu (byte bằng(đầu lệnh, "build") == 1) { trả về 0; };
    nếu (byte bằng(đầu lệnh, "biên dịch") == 1) { trả về 0; };
    nếu (byte bằng(đầu lệnh, "dựng") == 1) { trả về 0; };
    nếu (byte bằng(đầu lệnh, "object") == 1) { trả về 1; };
    nếu (byte bằng(đầu lệnh, "đối tượng") == 1) { trả về 1; };
    nếu (byte bằng(đầu lệnh, "check") == 1) { trả về 2; };
    nếu (byte bằng(đầu lệnh, "kiểm tra") == 1) { trả về 2; };
    nếu (byte bằng(đầu lệnh, "--help") == 1) { trả về 3; };
    nếu (byte bằng(đầu lệnh, "-h") == 1) { trả về 3; };
    nếu (byte bằng(đầu lệnh, "help") == 1) { trả về 3; };
    nếu (byte bằng(đầu lệnh, "trợ giúp") == 1) { trả về 3; };
    nếu (byte bằng(đầu lệnh, "--trợ-giúp") == 1) { trả về 3; };
    nếu (byte bằng(đầu lệnh, "giúp đỡ") == 1) { trả về 3; };
    nếu (byte bằng(đầu lệnh, "--version") == 1) { trả về 4; };
    nếu (byte bằng(đầu lệnh, "--phiên-bản") == 1) { trả về 4; };
    nếu (byte bằng(đầu lệnh, "-v") == 1) { trả về 4; };
    nếu (byte bằng(đầu lệnh, "version") == 1) { trả về 4; };
    nếu (byte bằng(đầu lệnh, "phiên bản") == 1) { trả về 4; };
    trả về -1;
};

hàm loại lệnh ghép(đầu lệnh, từ thứ hai) {
    nếu (byte bằng(đầu lệnh, "kiểm") == 1) {
        nếu (byte bằng(từ thứ hai, "tra") == 1) { trả về 2; };
    };
    nếu (byte bằng(đầu lệnh, "biên") == 1) {
        nếu (byte bằng(từ thứ hai, "dịch") == 1) { trả về 0; };
    };
    nếu (byte bằng(đầu lệnh, "xuất") == 1) {
        nếu (byte bằng(từ thứ hai, "đối tượng") == 1) { trả về 1; };
    };
    nếu (byte bằng(đầu lệnh, "trợ") == 1) {
        nếu (byte bằng(từ thứ hai, "giúp") == 1) { trả về 3; };
    };
    nếu (byte bằng(đầu lệnh, "giúp") == 1) {
        nếu (byte bằng(từ thứ hai, "đỡ") == 1) { trả về 3; };
    };
    nếu (byte bằng(đầu lệnh, "phiên") == 1) {
        nếu (byte bằng(từ thứ hai, "bản") == 1) { trả về 4; };
    };
    trả về -1;
};

hàm là tùy chọn đầu ra(tùy chọn) {
    nếu (byte bằng(tùy chọn, "-o") == 1) { trả về 1; };
    nếu (byte bằng(tùy chọn, "--đầu-ra") == 1) { trả về 1; };
    trả về 0;
};

hàm dựng mặc định(nguồn, chế độ xuất) {
    biến đầu ra = tạo tên đầu ra(nguồn, chế độ xuất);
    nếu (đầu ra <= 0) { trả về 11; };
    biến trạng thái = biên dịch tệp(nguồn, đầu ra, chế độ xuất);
    byte hủy(đầu ra);
    trả về trạng thái;
};

// Chỉ một nơi thực hiện lệnh, bất kể tên lệnh dùng tiếng Việt hay tiếng Anh.
hàm chạy lệnh(nguồn, kết xuất, chế độ) {
    nếu (chế độ == 2) {
        nếu (kết xuất > 0) { trả về 2; };
        trả về kiểm tra nguồn(nguồn);
    };
    nếu (chế độ == 0) {
        nếu (kết xuất > 0) { trả về biên dịch tệp(nguồn, kết xuất, 0); };
        trả về dựng mặc định(nguồn, 0);
    };
    nếu (chế độ == 1) {
        nếu (kết xuất > 0) { trả về biên dịch tệp(nguồn, kết xuất, 1); };
        trả về dựng mặc định(nguồn, 1);
    };
    trả về 2;
};

hàm chính() {
    biến số đối số = đối số đếm();
    nếu (số đối số == 1) { trả về hiện trợ giúp(); };
    nếu (số đối số < 2) { trả về 2; };

    biến lệnh đầu = đối số lấy(1);
    nếu (lệnh đầu <= 0) { byte hủy(lệnh đầu); trả về 2; };
    biến chế độ = loại lệnh(lệnh đầu);
    biến vị trí nguồn = 2;
    nếu (chế độ < 0) {
        nếu (số đối số >= 3) {
            biến từ ghép = đối số lấy(2);
            nếu (từ ghép > 0) {
                chế độ = loại lệnh ghép(lệnh đầu, từ ghép);
                nếu (chế độ >= 0) { vị trí nguồn = 3; };
            };
            byte hủy(từ ghép);
        };
    };
    byte hủy(lệnh đầu);

    nếu (chế độ == 3) {
        nếu (số đối số == vị trí nguồn) { trả về hiện trợ giúp(); };
        trả về 2;
    };
    nếu (chế độ == 4) {
        nếu (số đối số == vị trí nguồn) { trả về hiện phiên bản(); };
        trả về 2;
    };
    nếu (chế độ < 0) { trả về 2; };

    // Lệnh kiểm tra, biên dịch hoặc xuất object không chỉ định đường đầu ra.
    nếu (số đối số == vị trí nguồn + 1) {
        biến nguồn mặc định = đối số lấy(vị trí nguồn);
        biến trạng thái mặc định = 2;
        nếu (nguồn mặc định > 0) {
            trạng thái mặc định = chạy lệnh(nguồn mặc định, -1, chế độ);
        };
        byte hủy(nguồn mặc định);
        trả về trạng thái mặc định;
    };

    // Hỗ trợ cả: <nguồn> -o <đầu ra> và -o <đầu ra> <nguồn>.
    nếu (số đối số == vị trí nguồn + 3) {
        nếu (chế độ == 2) { trả về 2; };
        biến đối số đầu = đối số lấy(vị trí nguồn);
        biến đối số giữa = đối số lấy(vị trí nguồn + 1);
        biến đối số cuối = đối số lấy(vị trí nguồn + 2);
        biến trạng thái định tuyến = 2;
        nếu (đối số đầu > 0) {
            nếu (đối số giữa > 0) {
                nếu (đối số cuối > 0) {
                    nếu (là tùy chọn đầu ra(đối số giữa) == 1) {
                        trạng thái định tuyến = chạy lệnh(đối số đầu, đối số cuối, chế độ);
                    } hoặc {
                        nếu (là tùy chọn đầu ra(đối số đầu) == 1) {
                            trạng thái định tuyến = chạy lệnh(đối số cuối, đối số giữa, chế độ);
                        };
                    };
                };
            };
        };
        byte hủy(đối số đầu);
        byte hủy(đối số giữa);
        byte hủy(đối số cuối);
        trả về trạng thái định tuyến;
    };
    trả về 2;
};
