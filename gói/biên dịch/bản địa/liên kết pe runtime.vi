            nếu (giá trị ký hiệu đối tượng < 0) { trạng thái = -1; };
            máy ghi số nguyên ba mươi hai bit(67240000 + j * 4, giá trị ký hiệu đối tượng);
        };
        nếu (main < 4096) { trạng thái = -1; };
    };
