            đối tượng i32(kết quả, 23117); đối tượng đệm(kết quả, 60); đối tượng i32(kết quả, 128); đối tượng đệm(kết quả, 128);
            đối tượng i32(kết quả, 17744); byte thêm(kết quả, 100); byte thêm(kết quả, 134); byte thêm(kết quả, 2); byte thêm(kết quả, 0);
            đối tượng i32(kết quả, 0); đối tượng i32(kết quả, 0); đối tượng i32(kết quả, 0);
            byte thêm(kết quả, 240); byte thêm(kết quả, 0); byte thêm(kết quả, 35); byte thêm(kết quả, 0); // đã loại bỏ tái định vị
            byte thêm(kết quả, 11); byte thêm(kết quả, 2); byte thêm(kết quả, 0); byte thêm(kết quả, 0);
            đối tượng i32(kết quả, thô); đối tượng i32(kết quả, thô data); đối tượng i32(kết quả, 0);
            đối tượng i32(kết quả, main); đối tượng i32(kết quả, 4096);
            đối tượng i32(kết quả, 1073741824); đối tượng i32(kết quả, 1);
            đối tượng i32(kết quả, 4096); đối tượng i32(kết quả, 512);
            lặp (j = 0; j < 3; j++) { byte thêm(kết quả, 6); byte thêm(kết quả, 0); byte thêm(kết quả, 0); byte thêm(kết quả, 0); };
            đối tượng i32(kết quả, 0); đối tượng i32(kết quả, data rva + macho rt căn(byte dài(dữ liệu), 4096)); đối tượng i32(kết quả, 512); đối tượng i32(kết quả, 0);
            byte thêm(kết quả, 3); byte thêm(kết quả, 0); byte thêm(kết quả, 0); byte thêm(kết quả, 1);
            đối tượng u64(kết quả, 1048576); đối tượng u64(kết quả, 4096); đối tượng u64(kết quả, 1048576); đối tượng u64(kết quả, 4096);
            đối tượng i32(kết quả, 0); đối tượng i32(kết quả, 16);
            lặp (j = 0; j < 16; j++) {
                biến v = 0; biến kích thước thư mục dữ liệu = 0;
                nếu (j == 1) { v = data rva + bảng nhập tại; kích thước thư mục dữ liệu = 100; };
                đối tượng i32(kết quả, v); đối tượng i32(kết quả, kích thước thư mục dữ liệu);
            };
            nếu (byte dài(kết quả) != 392) { trạng thái = -1; };
            pe rt phần(kết quả, ".text", byte dài(mã), 4096, thô, 512, 1610612768);
            pe rt phần(kết quả, ".data", byte dài(dữ liệu), data rva, thô data, 512 + thô, -1073741760);
            nếu (đối tượng đệm(kết quả, 512) != 0 || byte nối(kết quả, mã) != 0 || đối tượng đệm(kết quả, 512 + thô) != 0 || byte nối(kết quả, dữ liệu) != 0 || đối tượng đệm(kết quả, 512 + thô + thô data) != 0) { trạng thái = -1; };
        };
    };
    byte hủy(mã); byte hủy(dữ liệu);
    nếu (trạng thái != 0) { thực thi liên kết báo lỗi("V++ PE: runtime symbol, section, import or relocation failure\n"); byte làm rỗng(kết quả); trả về -1; };
    trả về byte dài(kết quả);
};
