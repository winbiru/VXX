// PE32+ AMD64 linking with the preassembled Windows boundary. All machine
// references must be REL32..REL32_5; absolute relocations fail closed. Code
// uses RIP-relative addressing; the image is fixed-base, NX and has no RWX
// sections. DLL imports are limited to the boundary's explicit API catalog.
hàm pe rt tên(kho, mục, chuỗi) {
    biến tại = mục;
    biến cuối = mục + 8;
    nếu (byte đọc số nguyên ba mươi hai bit(kho, mục) == 0) {
        biến chỉ mục = byte đọc số nguyên ba mươi hai bit(kho, mục + 4);
        nếu (chỉ mục < 4 || chỉ mục >= byte dài(kho) - chuỗi) { trả về -1; };
        tại = chuỗi + chỉ mục;
        cuối = byte dài(kho);
    };
    nếu (tại < 0 || tại >= byte dài(kho)) { trả về -1; };
    biến n = 0;
    khi (tại + n < cuối && byte lấy(kho, tại + n) != 0 && n < 1024) { n = n + 1; };
    nếu (n == 0 || n == 1024 || (cuối > mục + 8 && tại + n == cuối)) { trả về -1; };
    trả về byte cắt(kho, tại, n);
};

hàm pe rt tìm(kho, sym, ns, str, tên) {
    biến i = 0;
    khi (i < ns) {
