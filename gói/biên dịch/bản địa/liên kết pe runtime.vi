        biến số tái định vị đối tượng = elf bản địa đọc u16(coff, 52);
        lặp (j = 0; j < số tái định vị đối tượng; j++) {
            biến vị trí bản ghi tái định vị đối tượng = 60 + n + j * 10;
            biến vị trí tái định vị đối tượng = byte đọc số nguyên ba mươi hai bit(coff, vị trí bản ghi tái định vị đối tượng);
            biến chỉ mục tái định vị đối tượng = byte đọc số nguyên ba mươi hai bit(coff, vị trí bản ghi tái định vị đối tượng + 4);
            nếu (vị trí tái định vị đối tượng < 0 || vị trí tái định vị đối tượng > n - 4 || chỉ mục tái định vị đối tượng < 0 || chỉ mục tái định vị đối tượng >= ons || elf bản địa đọc u16(coff, vị trí bản ghi tái định vị đối tượng + 8) != 4) { trạng thái = -1; thoát; };
            byte ghi số nguyên ba mươi hai bit(mã, vị trí tái định vị đối tượng, máy đọc số nguyên ba mươi hai bit(67240000 + chỉ mục tái định vị đối tượng * 4) - 4096 - vị trí tái định vị đối tượng - 4 + byte đọc số nguyên ba mươi hai bit(mã, vị trí tái định vị đối tượng));
        };
        lặp (s = 0; s < số phần; s++) {
            biến đích phần = mã; biến địa chỉ nền phần = 4096;
            nếu (macho rt trường(s, 4) == 1) { đích phần = dữ liệu; địa chỉ nền phần = data rva; };
            lặp (j = 0; j < macho rt trường(s, 16); j++) {
                biến vị trí bản ghi tái định vị runtime = macho rt trường(s, 12) + j * 10;
                biến vị trí tái định vị runtime = byte đọc số nguyên ba mươi hai bit(runtime, vị trí bản ghi tái định vị runtime);
                biến chỉ mục tái định vị runtime = byte đọc số nguyên ba mươi hai bit(runtime, vị trí bản ghi tái định vị runtime + 4);
                biến loại = elf bản địa đọc u16(runtime, vị trí bản ghi tái định vị runtime + 8);
                nếu (vị trí tái định vị runtime < 0 || vị trí tái định vị runtime > macho rt trường(s, 8) - 4 || chỉ mục tái định vị runtime < 0 || chỉ mục tái định vị runtime >= ns || loại < 4 || loại > 9) { trạng thái = -1; thoát; };
                biến giá trị tái định vị runtime = máy đọc số nguyên ba mươi hai bit(67210000 + chỉ mục tái định vị runtime * 4);
                nếu (giá trị tái định vị runtime < 0) { trạng thái = -1; thoát; };
                vị trí tái định vị runtime = vị trí tái định vị runtime + macho rt trường(s, 0);
                byte ghi số nguyên ba mươi hai bit(đích phần, vị trí tái định vị runtime, giá trị tái định vị runtime - địa chỉ nền phần - vị trí tái định vị runtime - 4 - (loại - 4) + byte đọc số nguyên ba mươi hai bit(đích phần, vị trí tái định vị runtime));
            };
        };
    };
    nếu (trạng thái == 0) {
        biến thô = macho rt căn(byte dài(mã), 512);
        biến thô data = macho rt căn(byte dài(dữ liệu), 512);
        nếu (512 + thô + thô data > 2097152) { trạng thái = -1; }
