hàm as_line(s, line) {
    biến n = 0;
    biến name = 0;
    biến numeric = 0;
    biến id = 0;
    biến syms = 0;
    biến end = 0;
    biến op = 0;
    biến args = 0;
    biến result = 0;

    n = byte dài(line); nếu (n == 0) { trả về 0; };
    nếu (n >= 2 && byte lấy(line, 0) == 47 && byte lấy(line, 1) == 47) { trả về 0; };
    nếu (byte lấy(line, n - 1) == 58) {
        name = as_unquote(byte cắt(line, 0, n - 1)); numeric = 0;
        nếu (byte dài(name) == 1 && byte lấy(name, 0) >= 48 && byte lấy(name, 0) <= 57) { numeric = 1; };
        id = as_symbol(s, name, numeric); byte hủy(name); nếu (id < 0) { trả về -1; };
        syms = as_get(s, 6); nếu (byte đọc số nguyên ba mươi hai bit(syms, id * 24 + 4) != 0) { trả về as_error(s); };
        byte ghi số nguyên ba mươi hai bit(syms, id * 24 + 4, as_get(s, 9)); byte ghi số nguyên ba mươi hai bit(syms, id * 24 + 8, byte dài(as_get(s, as_get(s, 9))));
        byte ghi số nguyên ba mươi hai bit(syms, id * 24 + 16, as_get(s, 10)); trả về 0;
    };
    end = 0; khi (end < n && as_space(byte lấy(line, end)) == 0) { end = end + 1; };
    op = byte cắt(line, 0, end); args = as_trim(line, end, n); result = 0;
    nếu (byte lấy(op, 0) == 46) { result = as_directive(s, op, args); }
    hoặc { nếu (as_get(s, 9) != 1) { as_error(s); } hoặc { result = as_instruction(s, op, args); }; };
    byte hủy(op); byte hủy(args); trả về result;
};

hàm as_u64(out, low, high) {
 byte đẩy số nguyên ba mươi hai bit(out, low); trả về byte đẩy số nguyên ba mươi hai bit(out, high); };
hàm as_zeros(out, n) {
    biến i = 0;
 lặp (i = 0; i < n; i++) { nếu (byte thêm(out, 0) != 0) { trả về -1; }; }; trả về 0; };
hàm as_sh(out, name, kind, flags, offset, size, link, info, alignment, entry) {
    byte đẩy số nguyên ba mươi hai bit(out, name); byte đẩy số nguyên ba mươi hai bit(out, kind);
    as_u64(out, flags, 0); as_u64(out, 0, 0); as_u64(out, offset, 0); as_u64(out, size, 0);
    byte đẩy số nguyên ba mươi hai bit(out, link); byte đẩy số nguyên ba mươi hai bit(out, info);
    as_u64(out, alignment, 0); trả về as_u64(out, entry, 0);
};
hàm as_numeric_ref(names, offset) {
    biến c = 0;
    biến d = 0;

    c = byte lấy(names, offset); d = byte lấy(names, offset + 1);
    nếu (c >= 48 && c <= 57 && (d == 102 || d == 98) && byte lấy(names, offset + 2) == 0) { trả về 1; }; trả về 0;
};
hàm as_symbols(s) {
    biến syms = 0;
    biến names = 0;
    biến out = 0;
    biến index = 0;
    biến global = 0;
    biến i = 0;
    biến name = 0;
    biến sec = 0;
    biến binding = 0;

    syms = as_get(s, 6); names = as_get(s, 7); out = as_get(s, 34);
    as_zeros(out, 24); index = 1;
    lặp (global = 0; global <= 2; global++) {
        nếu (global == 1) { as_set(s, 19, index); };
        lặp (i = 0; i < byte dài(syms); i = i + 24) {
            name = byte đọc số nguyên ba mươi hai bit(syms, i); sec = byte đọc số nguyên ba mươi hai bit(syms, i + 4);
            nếu (as_numeric_ref(names, name) == 1) { bỏ qua; };
            binding = byte đọc số nguyên ba mươi hai bit(syms, i + 12);
            nếu (sec == 0 && binding == 0) { binding = 1; };
            nếu (binding != global) { bỏ qua; };
            byte ghi số nguyên ba mươi hai bit(syms, i + 20, index); index = index + 1;
            byte đẩy số nguyên ba mươi hai bit(out, name); byte thêm(out, binding * 16); byte thêm(out, 0); byte thêm(out, sec); byte thêm(out, 0);
            as_u64(out, byte đọc số nguyên ba mươi hai bit(syms, i + 8), 0); as_u64(out, 0, 0);
