hàm as_relocations(s) {
    biến syms = 0;
    biến names = 0;
    biến fixes = 0;
    biến i = 0;
    biến sec = 0;
    biến pos = 0;
    biến id = 0;
    biến add = 0;
    biến kind = 0;
    biến line = 0;
    biến name = 0;
    biến digit = 0;
    biến direction = 0;
    biến best = 0;
    biến j = 0;
    biến off = 0;
    biến at = 0;
    biến target_sec = 0;
    biến out = 0;
    biến hi = 0;

    syms = as_get(s, 6); names = as_get(s, 7); fixes = as_get(s, 8);
    lặp (i = 0; i < byte dài(fixes); i = i + 24) {
        sec = byte đọc số nguyên ba mươi hai bit(fixes, i); pos = byte đọc số nguyên ba mươi hai bit(fixes, i + 4);
        id = byte đọc số nguyên ba mươi hai bit(fixes, i + 8); add = byte đọc số nguyên ba mươi hai bit(fixes, i + 12);
        kind = byte đọc số nguyên ba mươi hai bit(fixes, i + 16); line = byte đọc số nguyên ba mươi hai bit(fixes, i + 20);
        name = byte đọc số nguyên ba mươi hai bit(syms, id * 24);
        nếu (as_numeric_ref(names, name) == 1) {
            digit = byte lấy(names, name); direction = byte lấy(names, name + 1); best = -1;
            lặp (j = 0; j < byte dài(syms); j = j + 24) {
                off = byte đọc số nguyên ba mươi hai bit(syms, j); at = byte đọc số nguyên ba mươi hai bit(syms, j + 16);
                nếu (byte lấy(names, off) != digit || byte lấy(names, off + 1) != 0) { bỏ qua; };
                nếu (direction == 102 && at > line && (best < 0 || at < byte đọc số nguyên ba mươi hai bit(syms, best + 16))) { best = j; };
                nếu (direction == 98 && at < line && (best < 0 || at > byte đọc số nguyên ba mươi hai bit(syms, best + 16))) { best = j; };
            };
            nếu (best < 0) { as_set(s, 10, line); trả về as_error(s); }; id = máy chia số nguyên ba mươi hai bit(best, 24);
        };
        target_sec = byte đọc số nguyên ba mươi hai bit(syms, id * 24 + 4);
        nếu (kind == 2 && target_sec == sec) {
            byte ghi số nguyên ba mươi hai bit(as_get(s, sec), pos, byte đọc số nguyên ba mươi hai bit(syms, id * 24 + 8) + add - pos);
        } hoặc {
            nếu (sec < 1 || sec > 4) { trả về as_error(s); };
            out = as_get(s, 29 + sec); as_u64(out, pos, 0);
            byte đẩy số nguyên ba mươi hai bit(out, kind); byte đẩy số nguyên ba mươi hai bit(out, byte đọc số nguyên ba mươi hai bit(syms, id * 24 + 20));
            hi = 0; nếu (add < 0) { hi = -1; }; as_u64(out, add, hi);
        };
    }; trả về 0;
};
hàm as_object(s) {
    biến out = 0;
    biến section_names = 0;
    biến offsets = 0;
    biến name_offsets = 0;
    biến names = 0;
    biến start = 0;
    biến i = 0;
    biến t = 0;
    biến align = 0;
    biến buf = 0;
    biến table = 0;
    biến kind = 0;
    biến flags = 0;
    biến link = 0;
    biến info = 0;
    biến entry = 0;

    as_symbols(s); nếu (as_relocations(s) != 0) { trả về -1; };
    out = as_get(s, 36); section_names = as_get(s, 35); offsets = as_get(s, 37); name_offsets = as_get(s, 38);
    names = ".text|.rodata|.data|.fini_array|.note.GNU-stack|.rela.text|.rela.rodata|.rela.data|.rela.fini_array|.symtab|.strtab|.shstrtab|";
    byte thêm(section_names, 0); start = 0;
    lặp (i = 0; i < byte dài(names); i++) { nếu (byte lấy(names, i) == 124) { byte đẩy số nguyên ba mươi hai bit(name_offsets, byte dài(section_names)); t = byte cắt(names, start, i - start); byte nối(section_names, t); byte thêm(section_names, 0); byte hủy(t); start = i + 1; }; }; byte hủy(names);
    as_zeros(out, 64);
    lặp (i = 1; i <= 12; i++) {
        align = 8; nếu (i == 1) { align = 16; }; nếu (i == 5 || i == 11 || i == 12) { align = 1; };
        khi (as_mod(byte dài(out), align) != 0) { byte thêm(out, 0); }; byte đẩy số nguyên ba mươi hai bit(offsets, byte dài(out));
        buf = -1; nếu (i <= 5) { buf = as_get(s, i); }; nếu (i >= 6 && i <= 9) { buf = as_get(s, i + 24); }; nếu (i == 10) { buf = as_get(s, 34); }; nếu (i == 11) { buf = as_get(s, 7); }; nếu (i == 12) { buf = section_names; };
        nếu (byte nối(out, buf) != 0) { trả về as_error(s); }; byte đẩy số nguyên ba mươi hai bit(offsets, byte dài(buf));
    };
    khi (as_mod(byte dài(out), 8) != 0) { byte thêm(out, 0); };
    nếu (byte dài(out) > 2097152 - 832) { trả về as_error(s); };
    table = byte dài(out); as_zeros(out, 64);
    lặp (i = 1; i <= 12; i++) {
        kind = 1; flags = 0; link = 0; info = 0; align = 1; entry = 0;
        nếu (i == 1) { flags = 6; align = 16; }; nếu (i == 2) { flags = 2; align = 8; }; nếu (i == 3) { flags = 3; align = 8; }; nếu (i == 4) { kind = 15; flags = 3; align = 8; entry = 8; };
        nếu (i >= 6 && i <= 9) { kind = 4; link = 10; info = i - 5; align = 8; entry = 24; };
        nếu (i == 10) { kind = 2; link = 11; info = as_get(s, 19); align = 8; entry = 24; }; nếu (i == 11 || i == 12) { kind = 3; };
        as_sh(out, byte đọc số nguyên ba mươi hai bit(name_offsets, (i - 1) * 4), kind, flags, byte đọc số nguyên ba mươi hai bit(offsets, (i - 1) * 8), byte đọc số nguyên ba mươi hai bit(offsets, (i - 1) * 8 + 4), link, info, align, entry);
    };
    byte ghi số nguyên ba mươi hai bit(out, 0, 1179403647); byte ghi số nguyên ba mươi hai bit(out, 4, 65794);
    byte ghi số nguyên ba mươi hai bit(out, 16, 4063233); byte ghi số nguyên ba mươi hai bit(out, 20, 1);
    byte ghi số nguyên ba mươi hai bit(out, 40, table); byte ghi số nguyên ba mươi hai bit(out, 52, 64);
    byte ghi số nguyên ba mươi hai bit(out, 56, 4194304); byte ghi số nguyên ba mươi hai bit(out, 60, 786445);
    trả về 0;
};

hàm as_assemble(source, destination) {
    biến s = 0;
    biến status = 0;
    biến i = 0;
    biến b = 0;
    biến text = 0;
    biến start = 0;
    biến line = 0;
    biến msg = 0;

    s = byte mới(); nếu (s <= 0) { trả về 1; };
    as_zeros(s, 160); status = 0;
    lặp (i = 1; i <= 8; i++) { b = byte mới(); as_set(s, i, b); nếu (b <= 0) { status = 1; }; };
    lặp (i = 20; i <= 22; i++) { b = byte mới(); as_set(s, i, b); nếu (b <= 0) { status = 1; } hoặc { as_zeros(b, 32); }; };
    lặp (i = 30; i <= 38; i++) { b = byte mới(); as_set(s, i, b); nếu (b <= 0) { status = 1; }; };
    text = byte mới(); nếu (text <= 0) { status = 1; };
    nếu (status == 0) { nếu (elf bản địa đọc tệp(source, text) != 0) { status = 1; }; };
    as_set(s, 9, 1); as_set(s, 10, 1); byte thêm(as_get(s, 7), 0);
    nếu (status == 0) {
        start = 0;
        lặp (i = 0; i <= byte dài(text); i++) {
            nếu (i == byte dài(text) || byte lấy(text, i) == 10) {
                line = as_trim(text, start, i); as_line(s, line);
                nếu (as_get(s, 0) != 0) { byte in(line); byte hủy(line); status = 1; thoát; };
                byte hủy(line); as_set(s, 10, as_get(s, 10) + 1); start = i + 1;
            };
        };
    };
    nếu (status == 0) { nếu (as_object(s) != 0 || as_get(s, 0) != 0) { status = 1; }; };
    nếu (status == 0) {
        nếu (thực thi liên kết kiểm tra hợp lệ files(destination, source) != 0) { status = 1; }
        hoặc nếu (elf bản địa công bố theo chế độ(as_get(s, 36), destination, 0) != 0) { status = 1; };
    };
    nếu (status != 0) { msg = "\nV++ assembler: failed at source line\n"; byte in(msg); byte hủy(msg); in as_get(s, 10); };
    byte hủy(text);
    lặp (i = 1; i <= 8; i++) { byte hủy(as_get(s, i)); };
    lặp (i = 20; i <= 22; i++) { byte hủy(as_get(s, i)); };
    lặp (i = 30; i <= 38; i++) { byte hủy(as_get(s, i)); };
    byte hủy(s); trả về status;
};
