// Source assembler for the Linux x86-64 self-host boundary. AT&T operands,
// fixed rel32 branches and disp32 memory operands make layout deterministic.
// This deliberately bounded dialect rejects unsupported syntax before publish.
// State words: error, section buffers 1..5, symbols 6, names 7, fixups 8,
// current section 9, line 10. Symbol records: name, section, value, global,
// source line, ELF index. Fixups: section, offset, symbol, addend, type, line.
hàm as_get(s, i) { trả về byte đọc số nguyên ba mươi hai bit(s, i * 4); };
hàm as_set(s, i, v) { trả về byte ghi số nguyên ba mươi hai bit(s, i * 4, v); };
hàm as_eq(a, b) { biến r = byte bằng(a, b); byte hủy(b); trả về r; };
hàm as_error(s) { as_set(s, 0, 1); trả về -1; };
hàm as_mod(a, b) { trả về a - máy chia số nguyên ba mươi hai bit(a, b) * b; };
hàm as_space(c) { nếu (c == 32 || c == 9 || c == 13) { trả về 1; }; trả về 0; };
hàm as_trim(t, a, b) {
    khi (a < b && as_space(byte lấy(t, a)) == 1) { a = a + 1; };
    khi (b > a && as_space(byte lấy(t, b - 1)) == 1) { b = b - 1; };
    trả về byte cắt(t, a, b - a);
};
hàm as_unquote(t) {
    biến n = 0;
    biến v = 0;

    n = byte dài(t);
    nếu (n >= 2 && byte lấy(t, 0) == 34 && byte lấy(t, n - 1) == 34) {
        v = byte cắt(t, 1, n - 2); byte hủy(t); trả về v;
    };
    trả về t;
};
hàm as_number(s, t) {
    biến p = 0;
    biến end = byte dài(t);
    biến value = 0;
    biến sign = 1;
    biến term = 0;
    biến base = 10;
    biến digits = 0;
    biến c = 0;
    biến d = 0;
    khi (p < end && as_space(byte lấy(t, p)) == 1) { p = p + 1; };
    khi (end > p && as_space(byte lấy(t, end - 1)) == 1) { end = end - 1; };
    nếu (byte lấy(t, p) == 36) { p = p + 1; };
    nếu (byte lấy(t, p) == 40 && byte lấy(t, end - 1) == 41) { p = p + 1; end = end - 1; };
    khi (p < end) {
        khi (p < end && as_space(byte lấy(t, p)) == 1) { p = p + 1; };
        sign = 1; nếu (byte lấy(t, p) == 45) { sign = -1; p = p + 1; }
        hoặc nếu (byte lấy(t, p) == 43) { p = p + 1; };
        khi (p < end && as_space(byte lấy(t, p)) == 1) { p = p + 1; };
        term = 0; base = 10; digits = 0;
        nếu (byte lấy(t, p) == 39 && p + 2 < end && byte lấy(t, p + 2) == 39) {
            term = byte lấy(t, p + 1); digits = 1; p = p + 3;
        } hoặc {
            nếu (byte lấy(t, p) == 48 && byte lấy(t, p + 1) == 120) { base = 16; p = p + 2; };
            khi (p < end) {
                c = byte lấy(t, p); d = c - 48;
                nếu (c >= 97 && c <= 102) { d = c - 87; };
                nếu (c >= 65 && c <= 70) { d = c - 55; };
                nếu (d < 0 || d >= base) { thoát; };
                nếu (base == 16 && digits >= 8) { as_error(s); trả về 0; };
                nếu (base == 10 && (digits >= 10 || term < 0 || term > 214748364 || term == 214748364 && (d > 8 || d == 8 && sign == 1))) { as_error(s); trả về 0; };
                term = term * base + d; digits = digits + 1; p = p + 1;
            };
        };
        nếu (digits == 0) { as_error(s); trả về 0; };
        value = value + sign * term;
        khi (p < end && as_space(byte lấy(t, p)) == 1) { p = p + 1; };
        nếu (p < end && byte lấy(t, p) != 43 && byte lấy(t, p) != 45) { as_error(s); trả về 0; };
        nếu (p == end) { trả về value; };
    };
    as_error(s); trả về 0;
};

hàm as_name_equal(names, offset, t) {
    biến j = 0;

    lặp (j = 0; j < byte dài(t); j++) { nếu (byte lấy(names, offset + j) != byte lấy(t, j)) { trả về 0; }; };
    nếu (byte lấy(names, offset + byte dài(t)) != 0) { trả về 0; }; trả về 1;
};
hàm as_symbol(s, t, numeric) {
    biến syms = 0;
    biến names = 0;
    biến i = 0;
    biến id = 0;

    syms = as_get(s, 6); names = as_get(s, 7);
    nếu (byte dài(t) == 0) { trả về as_error(s); };
    lặp (j = 0; j < byte dài(t); j++) {
        biến ch = byte lấy(t, j);
        nếu (ch != 32 && ch != 46 && ch != 95 && ch < 128 && (ch < 48 || ch > 57) && (ch < 65 || ch > 90) && (ch < 97 || ch > 122)) { trả về as_error(s); };
    };
    nếu (numeric == 0) {
        lặp (i = 0; i < byte dài(syms); i = i + 24) {
            nếu (as_name_equal(names, byte đọc số nguyên ba mươi hai bit(syms, i), t) == 1) { trả về máy chia số nguyên ba mươi hai bit(i, 24); };
        };
    };
    nếu (byte dài(syms) >= 24000 || byte dài(t) > 131071 - byte dài(names)) { trả về as_error(s); };
    id = máy chia số nguyên ba mươi hai bit(byte dài(syms), 24);
    byte đẩy số nguyên ba mươi hai bit(syms, byte dài(names));
    nếu (byte nối(names, t) != 0 || byte thêm(names, 0) != 0) { trả về as_error(s); };
    byte đẩy số nguyên ba mươi hai bit(syms, 0); byte đẩy số nguyên ba mươi hai bit(syms, 0);
    byte đẩy số nguyên ba mươi hai bit(syms, 0); byte đẩy số nguyên ba mươi hai bit(syms, as_get(s, 10));
    byte đẩy số nguyên ba mươi hai bit(syms, 0); trả về id;
};
hàm as_fix(s, target, addend, kind) {
    biến f = 0;
    biến sec = 0;
    biến buf = 0;
    biến id = 0;

    f = as_get(s, 8); sec = as_get(s, 9); buf = as_get(s, sec);
    id = as_symbol(s, target, 0);
    nếu (id < 0 || byte dài(f) >= 144000) { trả về as_error(s); };
    byte đẩy số nguyên ba mươi hai bit(f, sec); byte đẩy số nguyên ba mươi hai bit(f, byte dài(buf));
    byte đẩy số nguyên ba mươi hai bit(f, id); byte đẩy số nguyên ba mươi hai bit(f, addend);
    byte đẩy số nguyên ba mươi hai bit(f, kind); byte đẩy số nguyên ba mươi hai bit(f, as_get(s, 10));
    byte đẩy số nguyên ba mươi hai bit(buf, 0);
    nếu (kind == 1) { byte đẩy số nguyên ba mươi hai bit(buf, 0); };
    trả về 0;
};
hàm as_emit(s, b) {
    nếu (b < 0 || b > 255 || byte dài(as_get(s, as_get(s, 9))) >= 131072) { trả về as_error(s); };
    nếu (byte thêm(as_get(s, as_get(s, 9)), b) != 0) { trả về as_error(s); }; trả về 0;
};
hàm as_int(s, v, width) {
    biến b = 0;
    biến i = 0;
    biến low = 0;

    nếu (width == 1 && (v < -128 || v > 255) || width == 2 && (v < -32768 || v > 65535)) { trả về as_error(s); };
    b = as_get(s, as_get(s, 9));
    nếu (width == 4) { nếu (byte đẩy số nguyên ba mươi hai bit(b, v) != 0) { trả về as_error(s); }; trả về 0; };
    lặp (i = 0; i < width; i++) {
        low = as_mod(v, 256); nếu (low < 0) { low = low + 256; };
        as_emit(s, low); v = máy chia số nguyên ba mươi hai bit(v - low, 256);
    }; trả về 0;
};
// Register code includes width in the upper byte (8/16/32/64/128).
hàm as_register(t) {
    biến names = 0;
    biến start = 0;
    biến index = 0;
    biến answer = 0;
    biến i = 0;
    biến n = 0;
    biến width = 0;
    biến end = 0;
    biến last = 0;
    biến c = 0;

    names = "%rax %rcx %rdx %rbx %rsp %rbp %rsi %rdi %eax %ecx %edx %ebx %esp %ebp %esi %edi %ax %cx %dx %bx %sp %bp %si %di %al %cl %dl %bl %spl %bpl %sil %dil";
    start = 0; index = 0; answer = -1;
    lặp (i = 0; i <= byte dài(names); i++) {
        nếu (i == byte dài(names) || byte lấy(names, i) == 32) {
            n = byte cắt(names, start, i - start);
            nếu (byte bằng(n, t) == 1) { width = 64; nếu (index >= 8) { width = 32; }; nếu (index >= 16) { width = 16; }; nếu (index >= 24) { width = 8; }; answer = width * 256 + as_mod(index, 8); };
            byte hủy(n); start = i + 1; index = index + 1;
        };
    }; byte hủy(names);
    nếu (answer >= 0) { trả về answer; };
    nếu (byte dài(t) >= 3 && byte lấy(t, 0) == 37 && byte lấy(t, 1) == 114) {
        end = byte dài(t); width = 64; last = byte lấy(t, end - 1);
        nếu (last == 100) { width = 32; end = end - 1; }; nếu (last == 119) { width = 16; end = end - 1; }; nếu (last == 98) { width = 8; end = end - 1; };
        n = 0; lặp (i = 2; i < end; i++) { c = byte lấy(t, i) - 48; nếu (c < 0 || c > 9) { trả về -1; }; n = n * 10 + c; };
        nếu (n >= 8 && n <= 15) { trả về width * 256 + n; };
    };
    nếu (byte dài(t) == 5 && byte lấy(t, 1) == 120 && byte lấy(t, 2) == 109 && byte lấy(t, 3) == 109) {
        n = byte lấy(t, 4) - 48; nếu (n >= 0 && n <= 7) { trả về 128 * 256 + n; };
    }; trả về -1;
};
// Operand fields: kind (1=reg,2=immediate,3=memory), reg, width, base,
// index, scale log2, displacement, symbol handle (owned by the caller).
hàm as_operand(s, t, o) {
    biến i = 0;
    biến reg = 0;
    biến p = 0;
    biến disp = 0;
    biến c = 0;
    biến end = 0;
    biến a = 0;
    biến start = 0;
    biến field = 0;
    biến part = 0;
    biến r = 0;
    biến scale = 0;
    biến log = 0;

    lặp (i = 0; i < 8; i++) { as_set(o, i, 0); };
    as_set(o, 3, -1); as_set(o, 4, -1);
    nếu (byte dài(t) == 0) { trả về as_error(s); };
    nếu (byte lấy(t, 0) == 37) {
        reg = as_register(t); nếu (reg < 0) { trả về as_error(s); };
        as_set(o, 0, 1); as_set(o, 1, as_mod(reg, 256)); as_set(o, 2, máy chia số nguyên ba mươi hai bit(reg, 256)); trả về 0;
    };
    nếu (byte lấy(t, 0) == 36) { as_set(o, 0, 2); as_set(o, 6, as_number(s, t)); trả về 0; };
    as_set(o, 0, 3);
    p = -1; lặp (i = 0; i < byte dài(t) - 1; i++) { nếu (byte lấy(t, i) == 40 && byte lấy(t, i + 1) == 37) { p = i; thoát; }; };
    nếu (p < 0 || byte lấy(t, byte dài(t) - 1) != 41) { trả về as_error(s); };
    disp = as_trim(t, 0, p);
    nếu (byte dài(disp) > 0) {
        c = byte lấy(disp, 0);
        nếu (c == 40 || c == 45 || c >= 48 && c <= 57) { as_set(o, 6, as_number(s, disp)); }
        hoặc {
            end = byte dài(disp); lặp (i = 1; i < end; i++) { nếu (byte lấy(disp, i) == 43) { end = i; thoát; }; };
            as_set(o, 7, byte cắt(disp, 0, end));
            nếu (end < byte dài(disp)) { a = byte cắt(disp, end + 1, byte dài(disp) - end - 1); as_set(o, 6, as_number(s, a)); byte hủy(a); };
        };
    }; byte hủy(disp);
    start = p + 1; field = 0;
    lặp (i = p + 1; i < byte dài(t); i++) {
        nếu (byte lấy(t, i) == 41 && i != byte dài(t) - 1) { trả về as_error(s); };
        nếu (byte lấy(t, i) == 44 || byte lấy(t, i) == 41) {
            part = as_trim(t, start, i);
            nếu (field < 2) {
                r = -1;
                nếu (as_eq(part, "%rip") == 1 && field == 0) { r = -2; }
                hoặc nếu (byte dài(part) > 0) { reg = as_register(part); nếu (reg < 0 || máy chia số nguyên ba mươi hai bit(reg, 256) != 64) { as_error(s); }; r = as_mod(reg, 256); };
                as_set(o, 3 + field, r);
            } hoặc {
                scale = as_number(s, part); log = -1;
                nếu (scale == 1) { log = 0; }; nếu (scale == 2) { log = 1; }; nếu (scale == 4) { log = 2; }; nếu (scale == 8) { log = 3; };
                nếu (log < 0) { as_error(s); }; as_set(o, 5, log);
            }; byte hủy(part); start = i + 1; field = field + 1;
        };
    };
    nếu (field > 3 || as_get(o, 3) == -1 || as_get(o, 4) == 4 || as_get(o, 3) == -2 && as_get(o, 4) != -1) { trả về as_error(s); };
    trả về 0;
};
hàm as_prefix(s, width, reg, o, force) {
    biến rex = 0;
    biến base = 0;
    biến index = 0;

    nếu (width == 16) { as_emit(s, 102); };
    rex = 64; nếu (width == 64) { rex = rex + 8; };
    nếu (reg >= 8) { rex = rex + 4; };
    base = as_get(o, 3); index = as_get(o, 4);
    nếu (as_get(o, 0) == 1) { base = as_get(o, 1); };
    nếu (base >= 8) { rex = rex + 1; }; nếu (index >= 8) { rex = rex + 2; };
    nếu (width == 8 && (base >= 4 || reg >= 4)) { force = 1; };
    nếu (as_get(o, 0) == 1 && as_get(o, 2) == 8 && as_get(o, 1) >= 4) { force = 1; };
    nếu (rex != 64 || force == 1) { as_emit(s, rex); }; trả về 0;
};
hàm as_modrm(s, reg, o, tail) {
    biến r = 0;
    biến base = 0;
    biến index = 0;
    biến rm = 0;
    biến ix = 0;

    r = as_mod(reg, 8);
    nếu (as_get(o, 0) == 1) { trả về as_emit(s, 192 + r * 8 + as_mod(as_get(o, 1), 8)); };
    nếu (as_get(o, 0) != 3) { trả về as_error(s); };
    base = as_get(o, 3); index = as_get(o, 4);
    nếu (base == -2) {
        as_emit(s, r * 8 + 5);
        nếu (as_get(o, 7) > 0) { trả về as_fix(s, as_get(o, 7), as_get(o, 6) - 4 - tail, 2); };
        trả về as_int(s, as_get(o, 6), 4);
    };
    nếu (as_get(o, 7) > 0) { trả về as_error(s); };
    rm = as_mod(base, 8);
    nếu (index >= 0 || rm == 4) {
        as_emit(s, 128 + r * 8 + 4); ix = 4; nếu (index >= 0) { ix = as_mod(index, 8); };
        as_emit(s, as_get(o, 5) * 64 + ix * 8 + rm);
    } hoặc { as_emit(s, 128 + r * 8 + rm); };
    trả về as_int(s, as_get(o, 6), 4);
};
hàm as_rm(s, width, opcode, reg, o, escape, tail) {
    as_prefix(s, width, reg, o, 0); nếu (escape == 1) { as_emit(s, 15); };
    as_emit(s, opcode); trả về as_modrm(s, reg, o, tail);
};
hàm as_condition(t) {
    nếu (as_eq(t, "e") == 1 || as_eq(t, "z") == 1) { trả về 4; };
    nếu (as_eq(t, "ne") == 1 || as_eq(t, "nz") == 1) { trả về 5; };
    nếu (as_eq(t, "b") == 1 || as_eq(t, "c") == 1) { trả về 2; };
    nếu (as_eq(t, "ae") == 1 || as_eq(t, "nc") == 1) { trả về 3; };
    nếu (as_eq(t, "be") == 1) { trả về 6; }; nếu (as_eq(t, "a") == 1) { trả về 7; };
    nếu (as_eq(t, "s") == 1) { trả về 8; }; nếu (as_eq(t, "ns") == 1) { trả về 9; };
    nếu (as_eq(t, "p") == 1) { trả về 10; }; nếu (as_eq(t, "l") == 1) { trả về 12; };
    nếu (as_eq(t, "ge") == 1) { trả về 13; }; nếu (as_eq(t, "le") == 1) { trả về 14; };
    nếu (as_eq(t, "g") == 1) { trả về 15; }; trả về -1;
};

hàm as_supported(mnemonic) {
    biến dialect = "|pushq|popq|movb|movw|movl|movq|movzbl|movzwl|movslq|leal|leaq|addl|addq|orl|andl|andq|subl|subq|xorl|xorq|cmpb|cmpl|cmpq|testb|testw|testl|testq|incl|incq|decl|decq|negl|divl|divq|idivl|imull|imulq|rolw|rorl|shrl|shlq|bswapl|bswapq|xchgl|seta|setb|setnz|movsd|addsd|subsd|mulsd|divsd|ucomisd|cvtsi2sdl|cvttsd2sil|";
    biến key = "|"; byte nối(key, mnemonic); byte thêm(key, 124);
    biến found = byte tìm(dialect, key); byte hủy(key); byte hủy(dialect);
    nếu (found < 0) { trả về 0; }; trả về 1;
};

hàm as_instruction(s, mnemonic, args) {
    biến target = 0;
    biến cc = 0;
    biến cond = 0;
    biến result = 0;
    biến count = 0;
    biến start = 0;
    biến depth = 0;
    biến quoted = 0;
    biến i = 0;
    biến c = 0;
    biến t = 0;
    biến a = 0;
    biến b = 0;
    biến d = 0;
    biến width = 0;
    biến n = 0;
    biến suffix = 0;
    biến op = 0;
    biến handled = 0;
    biến reg = 0;
    biến code = 0;
    biến size = 0;
    biến escape = 0;
    biến w = 0;
    biến arithmetic = 0;
    biến unary = 0;
    biến shift = 0;
    biến r = 0;
    biến rex = 0;
    biến sse = 0;
    biến prefix = 0;
    biến reverse = 0;
    biến o = 0;

    nếu (as_eq(mnemonic, "ret") == 1 || as_eq(mnemonic, "leave") == 1 || as_eq(mnemonic, "syscall") == 1 || as_eq(mnemonic, "ud2") == 1 || as_eq(mnemonic, "cltd") == 1) {
        nếu (byte dài(args) != 0) { trả về as_error(s); };
    };
    nếu (as_eq(mnemonic, "ret") == 1) { trả về as_emit(s, 195); };
    nếu (as_eq(mnemonic, "leave") == 1) { trả về as_emit(s, 201); };
    nếu (as_eq(mnemonic, "syscall") == 1) { as_emit(s, 15); trả về as_emit(s, 5); };
    nếu (as_eq(mnemonic, "ud2") == 1) { as_emit(s, 15); trả về as_emit(s, 11); };
    nếu (as_eq(mnemonic, "cltd") == 1) { trả về as_emit(s, 153); };
    nếu (as_eq(mnemonic, "rep") == 1) {
        nếu (as_eq(args, "stosb") == 1) { as_emit(s, 243); trả về as_emit(s, 170); };
        nếu (as_eq(args, "stosq") == 1) { as_emit(s, 243); as_emit(s, 72); trả về as_emit(s, 171); };
        trả về as_error(s);
    };
    nếu (as_eq(mnemonic, "call") == 1 || byte lấy(mnemonic, 0) == 106) {
        target = as_unquote(as_trim(args, 0, byte dài(args)));
        nếu (as_eq(mnemonic, "call") == 1) { as_emit(s, 232); }
        hoặc nếu (as_eq(mnemonic, "jmp") == 1) { as_emit(s, 233); }
        hoặc { cc = byte cắt(mnemonic, 1, byte dài(mnemonic) - 1); cond = as_condition(cc); byte hủy(cc); nếu (cond < 0) { byte hủy(target); trả về as_error(s); }; as_emit(s, 15); as_emit(s, 128 + cond); };
        result = as_fix(s, target, -4, 2); byte hủy(target); trả về result;
    };
    nếu (as_supported(mnemonic) != 1) { trả về as_error(s); };
    count = 0; start = 0; depth = 0; quoted = 0;
    lặp (i = 0; i <= byte dài(args); i++) {
        c = byte lấy(args, i);
        nếu (c == 34) { quoted = 1 - quoted; };
        nếu (quoted == 0) { nếu (c == 40) { depth = depth + 1; }; nếu (c == 41) { depth = depth - 1; }; };
        nếu (i == byte dài(args) || c == 44 && depth == 0 && quoted == 0) {
            nếu (count >= 3) { trả về as_error(s); };
            t = as_trim(args, start, i); as_operand(s, t, as_get(s, 20 + count)); byte hủy(t); count = count + 1; start = i + 1;
        };
    };
