            lặp (i = 0; i < macho rt trường(s, 16); i++) {
                biến rt rel = macho rt trường(s, 12) + i * 8;
                biến vị trí tái định vị runtime = byte đọc số nguyên ba mươi hai bit(runtime, rt rel);
                biến bits = byte lấy(runtime, rt rel + 7);
                biến chỉ mục tái định vị runtime = byte lấy(runtime, rt rel + 4) + byte lấy(runtime, rt rel + 5) * 256 + byte lấy(runtime, rt rel + 6) * 65536;
                biến loại tái định vị runtime = bits / 16;
                nếu (chỉ mục tái định vị runtime >= nsym || (bits != 45 && bits != 61 && bits != 76) || vị trí tái định vị runtime < 0 || vị trí tái định vị runtime > macho rt trường(s, 4) - 4) { trạng thái = -1; thoát; };
                nếu (macho rt vá(mã, macho rt trường(s, 24) + vị trí tái định vị runtime, máy đọc số nguyên ba mươi hai bit(67210000 + chỉ mục tái định vị runtime * 4), loại tái định vị runtime) != 0) { trạng thái = -1; thoát; };
            };
        };
    };
    nếu (trạng thái == 0) {
        đối tượng đệm(mã, stub);
        byte thêm(bind, 17); byte thêm(bind, 81); // thư viện động số 1, con trỏ
        lặp (i = 0; i < số nhập; i++) {
            biến vị trí stub = byte dài(mã); biến đích = text + got + i * 8;
            đối tượng i32(mã, -1879048176); // adrp x16
            đối tượng i32(mã, -113245680); // ldr x16, [x16]
            đối tượng i32(mã, -702610944); // br x16
