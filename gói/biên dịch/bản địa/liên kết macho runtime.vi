        đối tượng i32(kết quả, 2); đối tượng i32(kết quả, 24);
        đối tượng i32(kết quả, linkedit + byte dài(bind)); đối tượng i32(kết quả, 1);
        đối tượng i32(kết quả, linkedit + byte dài(bind) + 16); đối tượng i32(kết quả, 8);
