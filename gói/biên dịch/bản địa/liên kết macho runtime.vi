            biến chỉ mục ký hiệu nhập = máy đọc số nguyên ba mươi hai bit(67310000 + i * 4);
            biến vị trí tên nhập = str + byte đọc số nguyên ba mươi hai bit(runtime, sym + chỉ mục ký hiệu nhập * 16);
            byte thêm(bind, 64);
            khi (byte lấy(runtime, vị trí tên nhập) != 0) { byte thêm(bind, byte lấy(runtime, vị trí tên nhập)); vị trí tên nhập = vị trí tên nhập + 1; };
            byte thêm(bind, 0); byte thêm(bind, 114);
            macho rt uleb(bind, got + i * 8); byte thêm(bind, 144);
        };
        byte thêm(bind, 0);
        đối tượng đệm(bind, macho rt căn(byte dài(bind), 8));
    };
    nếu (trạng thái == 0) {
