            biến v = 0; nếu (i == 3 || i == 4) { v = 1; }; đối tượng i32(kết quả, v);
        };
        đối tượng i32(kết quả, 14); đối tượng i32(kết quả, 32); đối tượng i32(kết quả, 12); đối tượng tên định danh(kết quả, "/usr/lib/dyld", 20);
        đối tượng i32(kết quả, 50); đối tượng i32(kết quả, 24); đối tượng i32(kết quả, 1); đối tượng i32(kết quả, 720896); đối tượng i32(kết quả, 720896); đối tượng i32(kết quả, 0);
        đối tượng i32(kết quả, -2147483608); đối tượng i32(kết quả, 24); đối tượng u64(kết quả, main); đối tượng u64(kết quả, 0);
        đối tượng i32(kết quả, 12); đối tượng i32(kết quả, 56); đối tượng i32(kết quả, 24); đối tượng i32(kết quả, 2); đối tượng i32(kết quả, 88866816); đối tượng i32(kết quả, 65536); đối tượng tên định danh(kết quả, "/usr/lib/libSystem.B.dylib", 32);
        nếu (byte dài(kết quả) != 768) { trạng thái = -1; };
        nếu (đối tượng đệm(kết quả, 1024) != 0 || coff nối vùng(kết quả, mã, 1024, byte dài(mã) - 1024) != 0 || đối tượng đệm(kết quả, linkedit) != 0 || byte nối(kết quả, bind) != 0) { trạng thái = -1; };
        đối tượng i32(kết quả, 1); đối tượng i32(kết quả, 271); macho exe u64(kết quả, main, 1);
        byte thêm(kết quả, 0); byte nối(kết quả, "_main"); byte thêm(kết quả, 0); byte thêm(kết quả, 0);
        nếu (byte dài(kết quả) != linkedit + byte dài(bind) + 24) { trạng thái = -1; };
    };
    byte hủy(mã); byte hủy(bind);
    nếu (trạng thái != 0) { thực thi liên kết báo lỗi("V++ Mach-O: runtime symbol, section or relocation failure\n"); byte làm rỗng(kết quả); trả về -1; };
    trả về byte dài(kết quả);
};
