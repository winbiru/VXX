// Shared native source reader used by the module loader and CLI.
hàm đọc tệp nguồn(đường tệp, nguồn đầu vào) {
    biến tệp dữ liệu = tệp mở đọc(đường tệp);
    nếu (tệp dữ liệu <= 0) { trả về -1; };
    biến hoàn thành = 0;
    lặp (i = 0; i < 300; i++) {
        biến số phần tử = tệp đọc khối(tệp dữ liệu, nguồn đầu vào);
        nếu (số phần tử < 0) { thoát; };
        nếu (số phần tử == 0) { hoàn thành = 1; thoát; };
    };
    nếu (tệp đóng(tệp dữ liệu) != 0) { trả về -1; };
    nếu (hoàn thành != 1) { trả về -1; };
    trả về byte dài(nguồn đầu vào);
};


// Native module loader for the self-hosted i32 compiler.
// Supported source form: leading dotted module imports (`nhập tên.mô đun.*;`).
// Paths are relative to the importing file; imports are compiled once in
// dependency-first order. The current subset uses a single function namespace.

// Seen table records: i32 path_length, i32 state (1 visiting, 2 done), bytes.
// Return 0 for missing, 1 for an active dependency, 2 for completed.
hàm nạp mô đun báo lỗi(đường tệp) {
    thực thi liên kết báo lỗi("V++ native module load failed: ");
    biến ô nhớ = thực thi các byte ô nhớ(đường tệp);
    nếu (ô nhớ >= 0) {
        máy ghi(2, thực thi nội dung đệm(ô nhớ), byte dài(đường tệp));
    };
    thực thi liên kết báo lỗi("\n");
    trả về -1;
};

hàm nạp mô đun đã gặp(bảng, đường tệp) {
    biến chiều dài = byte dài(đường tệp);
    biến độ lệch = 0;
    khi (độ lệch < byte dài(bảng)) {
        nếu (độ lệch + 8 > byte dài(bảng)) { trả về -1; };
        biến kích cỡ = byte đọc số nguyên ba mươi hai bit(bảng, độ lệch);
        nếu (kích cỡ <= 0) { trả về -1; };
        nếu (kích cỡ > byte dài(bảng) - độ lệch - 8) { trả về -1; };
        nếu (kích cỡ == chiều dài) {
            biến bằng nhau = 1;
            lặp (i = 0; i < kích cỡ; i++) {
                nếu (byte lấy(bảng, độ lệch + 8 + i) != byte lấy(đường tệp, i)) {
                    bằng nhau = 0;
                    thoát;
                };
            };
            nếu (bằng nhau == 1) { trả về byte đọc số nguyên ba mươi hai bit(bảng, độ lệch + 4); };
        };
        độ lệch = độ lệch + 8 + kích cỡ;
    };
    trả về 0;
};

// Chuyển đường nhập mô đun thành đường tệp, ưu tiên thư mục của tệp nguồn.
// `nhập sub.leaf.*;` -> sub/leaf.vi, `nhập ..sub.leaf.*;` -> ../sub/leaf.vi.
// Plain `nhập leaf;` and slash imports remain valid during migration.
// Native's current function namespace is shared; selected names are resolved
// to their module here, while symbol pruning belongs to the full compiler.
// Returns token index after ';', or -1 for malformed source syntax.
hàm nạp mô đun nhập đường tệp(đường tệp, nguồn văn bản, các từ tố, điểm bắt đầu, con) {
    nếu (byte làm rỗng(con) != 0) { trả về -1; };
    biến cuối cùng dấu gạch chéo = -1;
    lặp (i = 0; i < byte dài(đường tệp); i++) {
        biến dấu ngăn = byte lấy(đường tệp, i);
        nếu (dấu ngăn == 47) { cuối cùng dấu gạch chéo = i; };
        nếu (dấu ngăn == 92) { cuối cùng dấu gạch chéo = i; };
    };
    lặp (i = 0; i <= cuối cùng dấu gạch chéo; i++) {
        nếu (byte thêm(con, byte lấy(đường tệp, i)) != 0) { trả về -1; };
    };
    biến bắt đầu tên mô đun = byte dài(con);
    biến số từ tố = từ tố số phần tử(các từ tố);
    nếu (điểm bắt đầu < 0) { trả về -1; };
    nếu (điểm bắt đầu >= số từ tố) { trả về -1; };
    biến kết thúc từ tố = -1;
    lặp (i = điểm bắt đầu; i < số từ tố; i++) {
        nếu (từ tố bằng(nguồn văn bản, các từ tố, i, ";") == 1) {
            kết thúc từ tố = i;
            thoát;
        };
        // Alias/quoted targets are not implemented in the native subset.
        nếu (từ tố bằng(nguồn văn bản, các từ tố, i, "như") == 1) { trả về -1; };
        nếu (từ tố trường dữ liệu(các từ tố, i, 2) == 4) { trả về -1; };
    };
    nếu (kết thúc từ tố <= điểm bắt đầu) { trả về -1; };
    biến đầu = từ tố trường dữ liệu(các từ tố, điểm bắt đầu, 0);
    biến cuối = từ tố trường dữ liệu(các từ tố, kết thúc từ tố, 0);
    khi (cuối > đầu) {
        biến ký tự cuối = byte lấy(nguồn văn bản, cuối - 1);
        nếu (ký tự cuối != 32) { nếu (ký tự cuối != 9) { thoát; }; };
        cuối = cuối - 1;
    };
    nếu (cuối <= đầu) { trả về -1; };
    // A trailing .* imports a complete module; a final .name selects an
    // export from the preceding module path.
    biến là toàn bộ = 0;
    nếu (byte lấy(nguồn văn bản, cuối - 1) == 42) {
        nếu (cuối - đầu < 3) { trả về -1; };
        nếu (byte lấy(nguồn văn bản, cuối - 2) != 46) { trả về -1; };
        là toàn bộ = 1;
        cuối = cuối - 2;
    };
    biến số dấu chấm đầu = 0;
    khi (đầu + số dấu chấm đầu < cuối) {
        nếu (byte lấy(nguồn văn bản, đầu + số dấu chấm đầu) != 46) { thoát; };
        số dấu chấm đầu = số dấu chấm đầu + 1;
    };
    nếu (đầu + số dấu chấm đầu >= cuối) { trả về -1; };
    biến dấu chấm cuối = -1;
    lặp (i = đầu + số dấu chấm đầu; i < cuối; i++) {
        nếu (byte lấy(nguồn văn bản, i) == 46) { dấu chấm cuối = i; };
    };
    nếu (là toàn bộ == 0) {
        nếu (dấu chấm cuối >= 0) {
            // Native handles the containing file; the full compiler prunes
            // unselected exports. Never treat a selected name as a directory.
            nếu (dấu chấm cuối + 1 >= cuối) { trả về -1; };
            nếu (cuối - dấu chấm cuối == 3) {
                nếu (byte lấy(nguồn văn bản, dấu chấm cuối + 1) == 118) {
                    nếu (byte lấy(nguồn văn bản, dấu chấm cuối + 2) == 105) { trả về -1; };
                };
            };
            cuối = dấu chấm cuối;
        };
    };
    nếu (đầu + số dấu chấm đầu >= cuối) { trả về -1; };
    lặp (i = 1; i < số dấu chấm đầu; i++) {
        nếu (byte thêm(con, 46) != 0) { trả về -1; };
        nếu (byte thêm(con, 46) != 0) { trả về -1; };
        nếu (byte thêm(con, 47) != 0) { trả về -1; };
    };
    biến ký tự trước = 47;
    lặp (i = đầu + số dấu chấm đầu; i < cuối; i++) {
        biến ch = byte lấy(nguồn văn bản, i);
        nếu (ch == 46) {
            nếu (ký tự trước == 47) { trả về -1; };
            ch = 47;
        };
        nếu (ch == 47) { nếu (ký tự trước == 47) { trả về -1; }; };
        nếu (ch == 42) { trả về -1; };
        nếu (ch == 92) { trả về -1; };
        nếu (ch == 34) { trả về -1; };
        nếu (ch == 39) { trả về -1; };
        nếu (ch == 40) { trả về -1; };
        nếu (ch == 41) { trả về -1; };
        nếu (ch == 44) { trả về -1; };
        nếu (ch == 10) { trả về -1; };
        nếu (ch == 13) { trả về -1; };
        nếu (byte thêm(con, ch) != 0) { trả về -1; };
        ký tự trước = ch;
    };
    nếu (ký tự trước == 47) { trả về -1; };
    biến hậu tố = ".vi";
    biến mã trạng thái = byte nối(con, hậu tố);
    byte hủy(hậu tố);
    nếu (mã trạng thái != 0) { trả về -1; };
    // Nhập gói.* luôn có thể tìm từ thư mục cài V++ nếu tệp nguồn ở ngoài gốc.
    // Giữ nguyên ưu tiên nhập tương đối, kể cả khi có mô đun cục bộ trùng tên.
    nếu (số dấu chấm đầu == 0 && byte dài(con) - bắt đầu tên mô đun >= 4) {
        nếu (byte lấy(con, bắt đầu tên mô đun) == 103 &&
            byte lấy(con, bắt đầu tên mô đun + 1) == 195 &&
            byte lấy(con, bắt đầu tên mô đun + 2) == 179 &&
            byte lấy(con, bắt đầu tên mô đun + 3) == 105) {
            biến tệp cục bộ = tệp mở đọc(con);
            nếu (tệp cục bộ > 0) { tệp đóng(tệp cục bộ); }
            hoặc {
                biến tệp runtime = thực thi môi trường thực thi mô đun đường tệp();
                nếu (tệp runtime > 0) {
                    biến đuôi runtime = "gói/biên dịch/bản địa/môi trường thực thi.vi";
                    biến nơi bắt đầu = byte tìm(tệp runtime, đuôi runtime);
                    nếu (nơi bắt đầu >= 0) {
                        biến thư mục gốc = byte cắt(tệp runtime, 0, nơi bắt đầu);
                        biến tên tương đối = byte cắt(con, bắt đầu tên mô đun,
                            byte dài(con) - bắt đầu tên mô đun);
                        nếu (thư mục gốc > 0 && tên tương đối > 0) {
                            biến tìm được = thực thi môi trường thực thi ứng viên(thư mục gốc, tên tương đối);
                            nếu (tìm được > 0) {
                                nếu (byte làm rỗng(con) != 0 || byte nối(con, tìm được) != 0) {
                                    mã trạng thái = -1;
                                };
                                byte hủy(tìm được);
                            };
                        };
                        nếu (thư mục gốc > 0) { byte hủy(thư mục gốc); };
                        nếu (tên tương đối > 0) { byte hủy(tên tương đối); };
                    };
                    byte hủy(đuôi runtime);
                    byte hủy(tệp runtime);
                };
            };
        };
    };
    nếu (mã trạng thái != 0) { trả về -1; };
    trả về kết thúc từ tố + 1;
};

// Recursively collect independent module payloads using the native lexer.
// Import-only files are allowed. Source and token handles remain local to
// their recursion frame. Cycles, missing modules and malformed imports fail.
hàm nạp mô đun nạp(đường tệp, đã kết hợp, bảng, độ sâu hiện tại) {
    nếu (độ sâu hiện tại >= 12) { trả về nạp mô đun báo lỗi(đường tệp); };
    biến trạng thái nội bộ = nạp mô đun đã gặp(bảng, đường tệp);
    nếu (trạng thái nội bộ == 2) { trả về 0; };
    nếu (trạng thái nội bộ != 0) { trả về -1; };
    biến đánh dấu = byte dài(bảng);
    nếu (byte đẩy số nguyên ba mươi hai bit(bảng, byte dài(đường tệp)) != 0) { trả về -1; };
    nếu (byte đẩy số nguyên ba mươi hai bit(bảng, 1) != 0) { trả về -1; };
    lặp (i = 0; i < byte dài(đường tệp); i++) {
        nếu (byte thêm(bảng, byte lấy(đường tệp, i)) != 0) { trả về -1; };
    };
    biến nguồn đầu vào = byte mới();
    biến các từ tố = byte mới();
    biến con = byte mới();
    biến mã trạng thái = 0;
    nếu (nguồn đầu vào <= 0) { mã trạng thái = -1; };
    nếu (các từ tố <= 0) { mã trạng thái = -1; };
    nếu (con <= 0) { mã trạng thái = -1; };
    nếu (mã trạng thái == 0) {
        nếu (đọc tệp nguồn(đường tệp, nguồn đầu vào) <= 0) { mã trạng thái = -1; };
    };
    nếu (mã trạng thái == 0) {
        nếu (từ vựng tách từ tố(nguồn đầu vào, các từ tố) < 0) { mã trạng thái = -1; };
    };
    biến con trỏ hiện tại = 0;
    nếu (mã trạng thái == 0) {
        lặp (i = 0; i < từ tố số phần tử(các từ tố); i++) {
            nếu (từ tố bằng(nguồn đầu vào, các từ tố, con trỏ hiện tại, "nhập") != 1) { thoát; };
            biến kế tiếp = nạp mô đun nhập đường tệp(đường tệp, nguồn đầu vào, các từ tố, con trỏ hiện tại + 1, con);
            nếu (kế tiếp < 0) { mã trạng thái = -1; thoát; };
            nếu (nạp mô đun nạp(con, đã kết hợp, bảng, độ sâu hiện tại + 1) != 0) {
                mã trạng thái = -1;
                thoát;
            };
            con trỏ hiện tại = kế tiếp;
        };
    };
    nếu (mã trạng thái == 0) {
        nếu (con trỏ hiện tại < từ tố số phần tử(các từ tố)) {
            biến điểm bắt đầu = từ tố trường dữ liệu(các từ tố, con trỏ hiện tại, 0);
            // Wire format: [i32 source_length, source_bytes] per module.
            // The parser now lexes each payload independently.
            nếu (byte đẩy số nguyên ba mươi hai bit(đã kết hợp, byte dài(nguồn đầu vào) - điểm bắt đầu) != 0) { mã trạng thái = -1; };
            nếu (mã trạng thái == 0) {
                nếu (thực thi các byte nối đoạn(đã kết hợp, nguồn đầu vào, điểm bắt đầu, byte dài(nguồn đầu vào) - điểm bắt đầu) != 0) {
                    mã trạng thái = -1;
                } hoặc { thực thi tiến độ nguồn(đường tệp); };
            };
        };
    };
    nếu (mã trạng thái == 0) {
        nếu (byte ghi số nguyên ba mươi hai bit(bảng, đánh dấu + 4, 2) != 0) { mã trạng thái = -1; };
    };
    nếu (nguồn đầu vào > 0) { byte hủy(nguồn đầu vào); };
    nếu (các từ tố > 0) { byte hủy(các từ tố); };
    nếu (con > 0) { byte hủy(con); };
    nếu (mã trạng thái != 0) { trả về nạp mô đun báo lỗi(đường tệp); };
    trả về mã trạng thái;
};

// Give relative entry paths the same identity as the implicit runtime.
// Preserve ".." components: collapsing them can change symlink semantics.
// Normalize Windows separators only on Windows; a POSIX backslash is a name.
hàm nạp mô đun đường tuyệt đối(đường tệp) {
    nếu (byte dài(đường tệp) <= 0) { trả về -1; };
    biến thư mục = thực thi hệ điều hành đường tệp(1);
    nếu (thư mục <= 0) { trả về -1; };
    biến windows = thực thi máy đích windows();
    biến kết quả trả về = byte mới();
    nếu (kết quả trả về <= 0) { byte hủy(thư mục); trả về -1; };
    biến dấu đầu = byte lấy(đường tệp, 0);
    nếu (windows == 1 && dấu đầu == 92) { dấu đầu = 47; };
    biến tuyệt đối = 0;
    nếu (dấu đầu == 47) { tuyệt đối = 1; };
    nếu (windows == 1 && byte dài(đường tệp) >= 2) {
        nếu (byte lấy(đường tệp, 1) == 58) {
            // Drive-relative paths such as C:foo use a separate OS cwd.
            // Keep their original spelling rather than inventing a root.
            tuyệt đối = 1;
        };
    };
    biến mã trạng thái = 0;
    nếu (tuyệt đối == 0) {
        lặp (i = 0; i < byte dài(thư mục); i++) {
            biến ký tự = byte lấy(thư mục, i);
            nếu (windows == 1 && ký tự == 92) { ký tự = 47; };
            nếu (byte thêm(kết quả trả về, ký tự) != 0) { mã trạng thái = -1; thoát; };
        };
        nếu (mã trạng thái == 0 && byte lấy(kết quả trả về, byte dài(kết quả trả về) - 1) != 47) {
            mã trạng thái = byte thêm(kết quả trả về, 47);
        };
    } hoặc nếu (windows == 1 && dấu đầu == 47) {
        // A single leading slash is relative to the current Windows drive.
        biến unc = 0;
        nếu (byte dài(đường tệp) >= 2) {
            biến dấu thứ hai = byte lấy(đường tệp, 1);
            nếu (dấu thứ hai == 47 || dấu thứ hai == 92) { unc = 1; };
        };
        nếu (unc == 0) {
            mã trạng thái = byte thêm(kết quả trả về, byte lấy(thư mục, 0));
            nếu (mã trạng thái == 0) { mã trạng thái = byte thêm(kết quả trả về, 58); };
        };
    };
    byte hủy(thư mục);
    nếu (mã trạng thái == 0) {
        biến đầu = 0;
        nếu (tuyệt đối == 0) {
            khi (đầu + 1 < byte dài(đường tệp)) {
                nếu (byte lấy(đường tệp, đầu) != 46) { thoát; };
                biến dấu = byte lấy(đường tệp, đầu + 1);
                nếu (dấu != 47 && !(windows == 1 && dấu == 92)) { thoát; };
                đầu = đầu + 2;
            };
        };
        lặp (i = đầu; i < byte dài(đường tệp); i++) {
            biến ký tự = byte lấy(đường tệp, i);
            nếu (windows == 1 && ký tự == 92) { ký tự = 47; };
            nếu (byte thêm(kết quả trả về, ký tự) != 0) { mã trạng thái = -1; thoát; };
        };
    };
    nếu (mã trạng thái != 0 || byte dài(kết quả trả về) >= 4096) {
        byte hủy(kết quả trả về); trả về -1;
    };
    trả về kết quả trả về;
};

hàm nạp mô đun chuẩn bị(đường tệp, đã kết hợp) {
    nếu (byte làm rỗng(đã kết hợp) != 0) { trả về -1; };
    biến bảng = byte mới();
    nếu (bảng <= 0) { trả về -1; };
    biến môi trường thực thi = môi trường thực thi nguồn();
    biến nguồn tuyệt đối = nạp mô đun đường tuyệt đối(đường tệp);
    biến mã trạng thái = -1;
    biến số đơn vị runtime = 0;
    nếu (môi trường thực thi > 0 && nguồn tuyệt đối > 0) {
        biến runtime tuyệt đối = nạp mô đun đường tuyệt đối(môi trường thực thi);
        nếu (runtime tuyệt đối > 0) {
            mã trạng thái = nạp mô đun nạp(runtime tuyệt đối, đã kết hợp, bảng, 0);
            byte hủy(runtime tuyệt đối);
        };
        nếu (mã trạng thái == 0) {
            biến nơi = 0;
            khi (nơi < byte dài(đã kết hợp)) {
                nếu (nơi > byte dài(đã kết hợp) - 4) { mã trạng thái = -1; thoát; };
                biến dài = byte đọc số nguyên ba mươi hai bit(đã kết hợp, nơi);
                nếu (dài < 1) { mã trạng thái = -1; thoát; };
                nếu (dài > byte dài(đã kết hợp) - nơi - 4) { mã trạng thái = -1; thoát; };
                nơi = nơi + 4 + dài;
                số đơn vị runtime = số đơn vị runtime + 1;
            };
        };
        nếu (mã trạng thái == 0) { mã trạng thái = nạp mô đun nạp(nguồn tuyệt đối, đã kết hợp, bảng, 0); };
    };
    nếu (môi trường thực thi > 0) { byte hủy(môi trường thực thi); };
    nếu (nguồn tuyệt đối > 0) { byte hủy(nguồn tuyệt đối); };
    byte hủy(bảng);
    nếu (mã trạng thái != 0) { byte làm rỗng(đã kết hợp); trả về -1; };
    nếu (byte dài(đã kết hợp) <= 0) { trả về -1; };
    // Positive return is the number of implicit runtime units, including imports.
    trả về số đơn vị runtime;
};
