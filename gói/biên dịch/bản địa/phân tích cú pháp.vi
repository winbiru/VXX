    trả về -1;
};

hàm phân tích bản địa số tham số(mã định danh) {
    nếu (mã định danh == 0) { trả về 0; };
    nếu (mã định danh == 1) { trả về 1; };
    nếu (mã định danh == 2) { trả về 2; };
    nếu (mã định danh == 3) { trả về 2; };
    nếu (mã định danh == 4) { trả về 2; };
    nếu (mã định danh == 5) { trả về 2; };
