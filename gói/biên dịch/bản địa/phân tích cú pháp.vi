hàm phân tích sơ cấp(nguồn văn bản, các từ tố, trạng thái nội bộ, biểu diễn trung gian) {
    biến con trỏ hiện tại = byte đọc số nguyên ba mươi hai bit(trạng thái nội bộ, 0);
    biến loại từ tố = từ tố trường dữ liệu(các từ tố, con trỏ hiện tại, 2);
    nếu (từ tố bằng(nguồn văn bản, các từ tố, con trỏ hiện tại, "đúng") == 1) {
        byte ghi số nguyên ba mươi hai bit(trạng thái nội bộ, 0, con trỏ hiện tại + 1);
        trả về phân tích phát(biểu diễn trung gian, 1, 1);
    };
    nếu (từ tố bằng(nguồn văn bản, các từ tố, con trỏ hiện tại, "sai") == 1) {
        byte ghi số nguyên ba mươi hai bit(trạng thái nội bộ, 0, con trỏ hiện tại + 1);
        trả về phân tích phát(biểu diễn trung gian, 1, 0);
    };
    nếu (loại từ tố == 2) {
        biến giá trị đang xét = phân tích số(nguồn văn bản, từ tố trường dữ liệu(các từ tố, con trỏ hiện tại, 0), từ tố trường dữ liệu(các từ tố, con trỏ hiện tại, 1));
        nếu (giá trị đang xét < 0) { trả về -1; };
        byte ghi số nguyên ba mươi hai bit(trạng thái nội bộ, 0, con trỏ hiện tại + 1);
        trả về phân tích phát(biểu diễn trung gian, 1, giá trị đang xét);
    };
    nếu (loại từ tố == 4) {
        biến điểm mở đầu = từ tố trường dữ liệu(các từ tố, con trỏ hiện tại, 0) + 1;
        biến điểm kết thúc = từ tố trường dữ liệu(các từ tố, con trỏ hiện tại, 1) - 1;
        byte ghi số nguyên ba mươi hai bit(trạng thái nội bộ, 0, con trỏ hiện tại + 1);
        // STR_NEW / STR_APPEND_BYTE keep the resulting handle on the stack.
        nếu (phân tích phát(biểu diễn trung gian, 22, 0) != 0) { trả về -1; };
        lặp (i = điểm mở đầu; i < điểm kết thúc; i++) {
            biến ch = byte lấy(nguồn văn bản, i);
            nếu (ch == 92) {
                i = i + 1;
                nếu (i >= điểm kết thúc) { trả về -1; };
                ch = byte lấy(nguồn văn bản, i);
                nếu (ch == 110) { ch = 10; }
                hoặc nếu (ch == 114) { ch = 13; }
                hoặc nếu (ch == 116) { ch = 9; }
                hoặc nếu (ch == 48) { ch = 0; };
            };
            nếu (phân tích phát(biểu diễn trung gian, 23, ch) != 0) { trả về -1; };
        };
        trả về 0;
    };
    nếu (loại từ tố == 1) {
        nếu (phân tích định danh(nguồn văn bản, các từ tố, con trỏ hiện tại) != 1) { trả về -1; };
        nếu (từ tố bằng(nguồn văn bản, các từ tố, con trỏ hiện tại + 1, "(") == 1) {
            biến sổ đăng ký = byte đọc số nguyên ba mươi hai bit(trạng thái nội bộ, 16);
            biến chương trình con hiện tại = -1;
            nếu (sổ đăng ký > 0) { chương trình con hiện tại = phân tích sổ đăng ký mã định danh(nguồn văn bản, các từ tố, con trỏ hiện tại, sổ đăng ký); }
            hoặc { chương trình con hiện tại = phân tích chương trình con mã định danh(nguồn văn bản, các từ tố, con trỏ hiện tại); };
            biến giá trị mong đợi = -1;
            nếu (chương trình con hiện tại < 0) {
                biến bản địa mã định danh = phân tích bản địa mã định danh(nguồn văn bản, các từ tố, con trỏ hiện tại);
                nếu (bản địa mã định danh < 0) { trả về -1; };
                chương trình con hiện tại = -bản địa mã định danh - 1;
                giá trị mong đợi = phân tích bản địa số tham số(bản địa mã định danh);
            } hoặc {
                nếu (sổ đăng ký > 0) { giá trị mong đợi = phân tích sổ đăng ký số tham số(sổ đăng ký, chương trình con hiện tại); }
                hoặc { giá trị mong đợi = phân tích chương trình con số tham số(nguồn văn bản, các từ tố, chương trình con hiện tại); };
            };
            nếu (giá trị mong đợi < 0) { trả về -1; };
            byte ghi số nguyên ba mươi hai bit(trạng thái nội bộ, 0, con trỏ hiện tại + 2);
            biến đã cung cấp = 0;
            nếu (phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, ")") != 1) {
                lặp (i = 0; i < từ tố số phần tử(các từ tố); i++) {
                    nếu (phân tích biểu thức(nguồn văn bản, các từ tố, trạng thái nội bộ, biểu diễn trung gian) != 0) { trả về -1; };
                    đã cung cấp = đã cung cấp + 1;
                    nếu (phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, ")") == 1) { thoát; };
                    nếu (phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, ",") != 1) { trả về -1; };
                };
                biến trước đó = byte đọc số nguyên ba mươi hai bit(trạng thái nội bộ, 0);
                nếu (từ tố bằng(nguồn văn bản, các từ tố, trước đó - 1, ")") != 1) { trả về -1; };
            };
            nếu (đã cung cấp != giá trị mong đợi) { trả về -1; };
            nếu (phân tích phát(biểu diễn trung gian, 19, đã cung cấp) != 0) { trả về -1; };
            trả về phân tích phát(biểu diễn trung gian, 17, chương trình con hiện tại);
        };
        biến ô nhớ = phân tích mục ký hiệu(nguồn văn bản, các từ tố, trạng thái nội bộ, con trỏ hiện tại);
        nếu (ô nhớ < 0) { trả về -1; };
        byte ghi số nguyên ba mươi hai bit(trạng thái nội bộ, 0, con trỏ hiện tại + 1);
        trả về phân tích phát(biểu diễn trung gian, 2, ô nhớ);
    };
    nếu (phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, "(") == 1) {
        nếu (phân tích biểu thức(nguồn văn bản, các từ tố, trạng thái nội bộ, biểu diễn trung gian) != 0) { trả về -1; };
        nếu (phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, ")") != 1) { trả về -1; };
        trả về 0;
    };
    nếu (phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, "-") == 1) {
        // The magnitude of INT32_MIN is one larger than INT32_MAX.
        // Recognize that exact token without overflowing p_number().
        biến kế tiếp = byte đọc số nguyên ba mươi hai bit(trạng thái nội bộ, 0);
        nếu (từ tố trường dữ liệu(các từ tố, kế tiếp, 2) == 2) {
            nếu (từ tố bằng(nguồn văn bản, các từ tố, kế tiếp, "2147483648") == 1) {
                byte ghi số nguyên ba mươi hai bit(trạng thái nội bộ, 0, kế tiếp + 1);
                trả về phân tích phát(biểu diễn trung gian, 1, -2147483648);
            };
        };
        nếu (phân tích sơ cấp(nguồn văn bản, các từ tố, trạng thái nội bộ, biểu diễn trung gian) != 0) { trả về -1; };
        trả về phân tích phát(biểu diễn trung gian, 8, 0);
    };
    nếu (phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, "!") == 1) {
        nếu (phân tích sơ cấp(nguồn văn bản, các từ tố, trạng thái nội bộ, biểu diễn trung gian) != 0) { trả về -1; };
        trả về phân tích phát(biểu diễn trung gian, 25, 0);
    };
    nếu (phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, "+") == 1) {
        trả về phân tích sơ cấp(nguồn văn bản, các từ tố, trạng thái nội bộ, biểu diễn trung gian);
    };
    trả về -1;
};

hàm phân tích tích(nguồn văn bản, các từ tố, trạng thái nội bộ, biểu diễn trung gian) {
    nếu (phân tích sơ cấp(nguồn văn bản, các từ tố, trạng thái nội bộ, biểu diễn trung gian) != 0) { trả về -1; };
    lặp (n = 0; n < từ tố số phần tử(các từ tố); n++) {
        biến mã phép toán = 0;
        nếu (phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, "*") == 1) { mã phép toán = 6; }
        hoặc nếu (phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, "/") == 1) { mã phép toán = 26; }
        hoặc nếu (phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, "%") == 1) { mã phép toán = 27; };
        nếu (mã phép toán == 0) { thoát; };
        nếu (phân tích sơ cấp(nguồn văn bản, các từ tố, trạng thái nội bộ, biểu diễn trung gian) != 0) { trả về -1; };
        nếu (phân tích phát(biểu diễn trung gian, mã phép toán, 0) != 0) { trả về -1; };
    };
    trả về 0;
};

hàm phân tích tổng(nguồn văn bản, các từ tố, trạng thái nội bộ, biểu diễn trung gian) {
    nếu (phân tích tích(nguồn văn bản, các từ tố, trạng thái nội bộ, biểu diễn trung gian) != 0) { trả về -1; };
    lặp (n = 0; n < từ tố số phần tử(các từ tố); n++) {
        biến mã phép toán = 0;
        nếu (phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, "+") == 1) { mã phép toán = 4; }
        hoặc { nếu (phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, "-") == 1) { mã phép toán = 5; }; };
        nếu (mã phép toán == 0) { thoát; };
        nếu (phân tích tích(nguồn văn bản, các từ tố, trạng thái nội bộ, biểu diễn trung gian) != 0) { trả về -1; };
        nếu (phân tích phát(biểu diễn trung gian, mã phép toán, 0) != 0) { trả về -1; };
    };
    trả về 0;
};

hàm phân tích quan hệ(nguồn văn bản, các từ tố, trạng thái nội bộ, biểu diễn trung gian) {
    nếu (phân tích tổng(nguồn văn bản, các từ tố, trạng thái nội bộ, biểu diễn trung gian) != 0) { trả về -1; };
    lặp (i = 0; i < từ tố số phần tử(các từ tố); i++) {
        biến mã phép toán = 0;
        nếu (phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, "<") == 1) { mã phép toán = 13; }
        hoặc nếu (phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, "<=") == 1) { mã phép toán = 14; }
        hoặc nếu (phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, ">") == 1) { mã phép toán = 15; }
        hoặc nếu (phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, ">=") == 1) { mã phép toán = 16; };
        nếu (mã phép toán == 0) { thoát; };
        nếu (phân tích tổng(nguồn văn bản, các từ tố, trạng thái nội bộ, biểu diễn trung gian) != 0) { trả về -1; };
        nếu (phân tích phát(biểu diễn trung gian, mã phép toán, 0) != 0) { trả về -1; };
    };
    trả về 0;
};

hàm phân tích biểu thức(nguồn văn bản, các từ tố, trạng thái nội bộ, biểu diễn trung gian) {
    nếu (phân tích quan hệ(nguồn văn bản, các từ tố, trạng thái nội bộ, biểu diễn trung gian) != 0) { trả về -1; };
    lặp (i = 0; i < từ tố số phần tử(các từ tố); i++) {
        biến mã phép toán = 0;
        nếu (phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, "==") == 1) { mã phép toán = 11; }
        hoặc nếu (phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, "!=") == 1) { mã phép toán = 12; };
        nếu (mã phép toán == 0) { thoát; };
        nếu (phân tích quan hệ(nguồn văn bản, các từ tố, trạng thái nội bộ, biểu diễn trung gian) != 0) { trả về -1; };
        nếu (phân tích phát(biểu diễn trung gian, mã phép toán, 0) != 0) { trả về -1; };
    };
    trả về 0;
};

// Nhánh có thể có biến cục bộ và kết thúc bằng 'trả về' sớm.
// Giữ số slot tăng đơn điệu để các STORE/LOAD có ID ổn định, nhưng đánh dấu
// tên khai báo trong nhánh đã hết phạm vi khi đóng block. Trả 1 nếu tất cả
// đường đi trong block kết thúc bằng return, 0 nếu còn fallthrough, -1 nếu lỗi.
hàm phân tích nhánh khối(nguồn văn bản, các từ tố, trạng thái nội bộ, biểu diễn trung gian) {
    nếu (phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, "{") != 1) { trả về -1; };
    biến đã hoàn trả trước = byte đọc số nguyên ba mươi hai bit(trạng thái nội bộ, 8);
    biến locals trước = byte đọc số nguyên ba mươi hai bit(trạng thái nội bộ, 4);
    lặp (i = 0; i < từ tố số phần tử(các từ tố); i++) {
        nếu (phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, "}") == 1) {
            biến khối đã hoàn trả = byte đọc số nguyên ba mươi hai bit(trạng thái nội bộ, 8);
            lặp (ô nhớ = locals trước; ô nhớ < byte đọc số nguyên ba mươi hai bit(trạng thái nội bộ, 4); ô nhớ++) {
                nếu (byte ghi số nguyên ba mươi hai bit(trạng thái nội bộ, 20 + ô nhớ * 8, -1) != 0) { trả về -1; };
                nếu (byte ghi số nguyên ba mươi hai bit(trạng thái nội bộ, 24 + ô nhớ * 8, -1) != 0) { trả về -1; };
            };
            byte ghi số nguyên ba mươi hai bit(trạng thái nội bộ, 8, đã hoàn trả trước);
            nếu (khối đã hoàn trả != đã hoàn trả trước) { trả về 1; };
            trả về 0;
        };
        // Không cho phép câu lệnh sau return trong cùng block.
        nếu (byte đọc số nguyên ba mươi hai bit(trạng thái nội bộ, 8) != đã hoàn trả trước) { trả về -1; };
        biến con trỏ hiện tại = byte đọc số nguyên ba mươi hai bit(trạng thái nội bộ, 0);
        nếu (con trỏ hiện tại >= từ tố số phần tử(các từ tố)) { trả về -1; };
        nếu (phân tích câu lệnh(nguồn văn bản, các từ tố, trạng thái nội bộ, biểu diễn trung gian) != 0) { trả về -1; };
    };
    trả về -1;
};

hàm phân tích vòng lặp bước cập nhật(nguồn văn bản, các từ tố, trạng thái nội bộ, bước cập nhật) {
    biến bước cập nhật con trỏ hiện tại = byte đọc số nguyên ba mươi hai bit(trạng thái nội bộ, 0);
    nếu (phân tích định danh(nguồn văn bản, các từ tố, bước cập nhật con trỏ hiện tại) != 1) { trả về -1; };
    biến bước cập nhật ô nhớ = phân tích mục ký hiệu(nguồn văn bản, các từ tố, trạng thái nội bộ, bước cập nhật con trỏ hiện tại);
    nếu (bước cập nhật ô nhớ < 0) { trả về -1; };
    byte ghi số nguyên ba mươi hai bit(trạng thái nội bộ, 0, bước cập nhật con trỏ hiện tại + 1);
    biến lượng tăng = 0;
    nếu (phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, "++") == 1) { lượng tăng = 4; }
    hoặc nếu (phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, "--") == 1) { lượng tăng = 5; };
    nếu (lượng tăng != 0) {
        nếu (phân tích phát(bước cập nhật, 2, bước cập nhật ô nhớ) != 0) { trả về -1; };
        nếu (phân tích phát(bước cập nhật, 1, 1) != 0) { trả về -1; };
        nếu (phân tích phát(bước cập nhật, lượng tăng, 0) != 0) { trả về -1; };
        nếu (phân tích phát(bước cập nhật, 3, bước cập nhật ô nhớ) != 0) { trả về -1; };
        nếu (phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, ")") != 1) { trả về -1; };
        trả về 0;
    };
    biến kết hợp = 0;
    nếu (phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, "=") == 1) { kết hợp = 0; }
    hoặc nếu (phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, "+=") == 1) { kết hợp = 4; }
    hoặc nếu (phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, "-=") == 1) { kết hợp = 5; }
    hoặc nếu (phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, "*=") == 1) { kết hợp = 6; }
    hoặc nếu (phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, "/=") == 1) { kết hợp = 26; }
    hoặc nếu (phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, "%=") == 1) { kết hợp = 27; }
    hoặc { trả về -1; };
    nếu (kết hợp != 0) {
        nếu (phân tích phát(bước cập nhật, 2, bước cập nhật ô nhớ) != 0) { trả về -1; };
    };
    nếu (phân tích biểu thức(nguồn văn bản, các từ tố, trạng thái nội bộ, bước cập nhật) != 0) { trả về -1; };
    nếu (kết hợp != 0) {
        nếu (phân tích phát(bước cập nhật, kết hợp, 0) != 0) { trả về -1; };
    };
    nếu (phân tích phát(bước cập nhật, 3, bước cập nhật ô nhớ) != 0) { trả về -1; };
    nếu (phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, ")") != 1) { trả về -1; };
    trả về 0;
};

// BREAK/CONTINUE là opcode tạm chỉ tồn tại trong khi phân tích cú pháp.
// Gắn loop-depth để vòng lặp ngoài không sửa nhầm lệnh của vòng lặp trong.
// Trước khi đến codegen, mọi opcode tạm được đổi thành JMP thông thường.
hàm phân tích vá vòng lặp(biểu diễn trung gian, điểm mở đầu, điểm kết thúc, cấp, bước cập nhật đích đến, exit đích đến) {
    lặp (pc = điểm mở đầu; pc < điểm kết thúc; pc = pc + 8) {
        biến mã phép toán = byte đọc số nguyên ba mươi hai bit(biểu diễn trung gian, pc);
        nếu (mã phép toán == 20) {
            nếu (byte đọc số nguyên ba mươi hai bit(biểu diễn trung gian, pc + 4) != cấp) { trả về -1; };
            nếu (byte ghi số nguyên ba mươi hai bit(biểu diễn trung gian, pc, 10) != 0) { trả về -1; };
            nếu (byte ghi số nguyên ba mươi hai bit(biểu diễn trung gian, pc + 4, exit đích đến) != 0) { trả về -1; };
        };
        nếu (mã phép toán == 21) {
            nếu (byte đọc số nguyên ba mươi hai bit(biểu diễn trung gian, pc + 4) != cấp) { trả về -1; };
            nếu (byte ghi số nguyên ba mươi hai bit(biểu diễn trung gian, pc, 10) != 0) { trả về -1; };
            nếu (byte ghi số nguyên ba mươi hai bit(biểu diễn trung gian, pc + 4, bước cập nhật đích đến) != 0) { trả về -1; };
        };
    };
    trả về 0;
};

hàm phân tích câu lệnh(nguồn văn bản, các từ tố, trạng thái nội bộ, biểu diễn trung gian) {
    nếu (phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, "thoát") == 1) {
        biến cấp thoát lặp = byte đọc số nguyên ba mươi hai bit(trạng thái nội bộ, 12);
        nếu (cấp thoát lặp <= 0) { trả về -1; };
        nếu (phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, ";") != 1) { trả về -1; };
        trả về phân tích phát(biểu diễn trung gian, 20, cấp thoát lặp);
    };
    nếu (phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, "bỏ") == 1) {
        nếu (phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, "qua") != 1) { trả về -1; };
        biến tiếp tục cấp = byte đọc số nguyên ba mươi hai bit(trạng thái nội bộ, 12);
        nếu (tiếp tục cấp <= 0) { trả về -1; };
        nếu (phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, ";") != 1) { trả về -1; };
        trả về phân tích phát(biểu diễn trung gian, 21, tiếp tục cấp);
    };
    nếu (phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, "lặp") == 1) {
        nếu (phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, "(") != 1) { trả về -1; };
        biến vòng lặp con trỏ hiện tại = byte đọc số nguyên ba mươi hai bit(trạng thái nội bộ, 0);
        nếu (phân tích định danh(nguồn văn bản, các từ tố, vòng lặp con trỏ hiện tại) != 1) { trả về -1; };
        biến vòng lặp ô nhớ = phân tích mục ký hiệu(nguồn văn bản, các từ tố, trạng thái nội bộ, vòng lặp con trỏ hiện tại);
        biến vòng lặp đã khai báo = 0;
        nếu (vòng lặp ô nhớ < 0) {
            vòng lặp đã khai báo = 1;
            vòng lặp ô nhớ = byte đọc số nguyên ba mươi hai bit(trạng thái nội bộ, 4);
            nếu (vòng lặp ô nhớ >= 130000) { trả về -1; };
            nếu (byte đẩy số nguyên ba mươi hai bit(trạng thái nội bộ, từ tố trường dữ liệu(các từ tố, vòng lặp con trỏ hiện tại, 0)) != 0) { trả về -1; };
            nếu (byte đẩy số nguyên ba mươi hai bit(trạng thái nội bộ, từ tố trường dữ liệu(các từ tố, vòng lặp con trỏ hiện tại, 1)) != 0) { trả về -1; };
            byte ghi số nguyên ba mươi hai bit(trạng thái nội bộ, 4, vòng lặp ô nhớ + 1);
        };
        byte ghi số nguyên ba mươi hai bit(trạng thái nội bộ, 0, vòng lặp con trỏ hiện tại + 1);
        nếu (phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, "=") != 1) { trả về -1; };
        nếu (phân tích biểu thức(nguồn văn bản, các từ tố, trạng thái nội bộ, biểu diễn trung gian) != 0) { trả về -1; };
        nếu (phân tích phát(biểu diễn trung gian, 3, vòng lặp ô nhớ) != 0) { trả về -1; };
        nếu (phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, ";") != 1) { trả về -1; };
        biến biểu thức điều kiện location = byte dài(biểu diễn trung gian);
        nếu (phân tích biểu thức(nguồn văn bản, các từ tố, trạng thái nội bộ, biểu diễn trung gian) != 0) { trả về -1; };
        nếu (phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, ";") != 1) { trả về -1; };
        biến số mục bỏ qua vòng lặp = byte dài(biểu diễn trung gian);
        nếu (phân tích phát(biểu diễn trung gian, 9, -1) != 0) { trả về -1; };
        // Parse update now, but append it to IR after the loop body.
        biến bước cập nhật biểu diễn trung gian = byte mới();
        nếu (bước cập nhật biểu diễn trung gian <= 0) { trả về -1; };
        biến bước cập nhật mã trạng thái = phân tích vòng lặp bước cập nhật(nguồn văn bản, các từ tố, trạng thái nội bộ, bước cập nhật biểu diễn trung gian);
        nếu (bước cập nhật mã trạng thái != 0) { byte hủy(bước cập nhật biểu diễn trung gian); trả về -1; };
        biến vòng lặp cấp = byte đọc số nguyên ba mươi hai bit(trạng thái nội bộ, 12) + 1;
        nếu (byte ghi số nguyên ba mươi hai bit(trạng thái nội bộ, 12, vòng lặp cấp) != 0) { byte hủy(bước cập nhật biểu diễn trung gian); trả về -1; };
        biến thân khối điểm mở đầu = byte dài(biểu diễn trung gian);
        biến thân khối kết quả trả về = phân tích nhánh khối(nguồn văn bản, các từ tố, trạng thái nội bộ, biểu diễn trung gian);
        biến thân khối điểm kết thúc = byte dài(biểu diễn trung gian);
        byte ghi số nguyên ba mươi hai bit(trạng thái nội bộ, 12, vòng lặp cấp - 1);
        nếu (thân khối kết quả trả về < 0) {
            byte hủy(bước cập nhật biểu diễn trung gian);
            trả về -1;
        };
        nếu (byte dài(biểu diễn trung gian) > 1048568 - byte dài(bước cập nhật biểu diễn trung gian) - 8) {
            byte hủy(bước cập nhật biểu diễn trung gian); trả về -1;
        };
        biến bước cập nhật đích đến = byte dài(biểu diễn trung gian);
        nếu (byte nối(biểu diễn trung gian, bước cập nhật biểu diễn trung gian) != 0) { byte hủy(bước cập nhật biểu diễn trung gian); trả về -1; };
        byte hủy(bước cập nhật biểu diễn trung gian);
        nếu (phân tích phát(biểu diễn trung gian, 10, biểu thức điều kiện location) != 0) { trả về -1; };
        biến exit đích đến = byte dài(biểu diễn trung gian);
        nếu (byte ghi số nguyên ba mươi hai bit(biểu diễn trung gian, số mục bỏ qua vòng lặp + 4, exit đích đến) != 0) { trả về -1; };
        nếu (phân tích vá vòng lặp(biểu diễn trung gian, thân khối điểm mở đầu, thân khối điểm kết thúc, vòng lặp cấp, bước cập nhật đích đến, exit đích đến) != 0) { trả về -1; };
        // A loop-introduced variable is only visible inside this loop.
        // Preserve its allocated slot for IR references, but hide its name.
        nếu (vòng lặp đã khai báo == 1) {
            nếu (byte ghi số nguyên ba mươi hai bit(trạng thái nội bộ, 20 + vòng lặp ô nhớ * 8, -1) != 0) { trả về -1; };
            nếu (byte ghi số nguyên ba mươi hai bit(trạng thái nội bộ, 24 + vòng lặp ô nhớ * 8, -1) != 0) { trả về -1; };
        };
        phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, ";");
        trả về 0;
    };
    nếu (phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, "nếu") == 1) {
        nếu (phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, "(") != 1) { trả về -1; };
        nếu (phân tích biểu thức(nguồn văn bản, các từ tố, trạng thái nội bộ, biểu diễn trung gian) != 0) { trả về -1; };
        nếu (phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, ")") != 1) { trả về -1; };
        biến số mục bỏ qua = byte dài(biểu diễn trung gian);
        nếu (phân tích phát(biểu diễn trung gian, 9, -1) != 0) { trả về -1; };
        biến lần hoàn trả thứ nhất = phân tích nhánh khối(nguồn văn bản, các từ tố, trạng thái nội bộ, biểu diễn trung gian);
        nếu (lần hoàn trả thứ nhất < 0) { trả về -1; };
        nếu (phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, "hoặc") == 1) {
            biến jump điểm kết thúc location = -1;
            // Khi nhánh đúng đã return, không phát JMP thừa tới cuối hàm.
            nếu (lần hoàn trả thứ nhất != 1) {
                jump điểm kết thúc location = byte dài(biểu diễn trung gian);
                nếu (phân tích phát(biểu diễn trung gian, 10, -1) != 0) { trả về -1; };
            };
            nếu (byte ghi số nguyên ba mươi hai bit(biểu diễn trung gian, số mục bỏ qua + 4, byte dài(biểu diễn trung gian)) != 0) { trả về -1; };
            biến lần hoàn trả thứ hai = -1;
            nếu (từ tố bằng(nguồn văn bản, các từ tố, byte đọc số nguyên ba mươi hai bit(trạng thái nội bộ, 0), "nếu") == 1) {
                // 'hoặc nếu' is a nested conditional that shares this branch.
                // Restore the outer return flag before merging both arms.
                nếu (phân tích câu lệnh(nguồn văn bản, các từ tố, trạng thái nội bộ, biểu diễn trung gian) != 0) { trả về -1; };
                lần hoàn trả thứ hai = byte đọc số nguyên ba mươi hai bit(trạng thái nội bộ, 8);
                nếu (byte ghi số nguyên ba mươi hai bit(trạng thái nội bộ, 8, 0) != 0) { trả về -1; };
            } hoặc {
                lần hoàn trả thứ hai = phân tích nhánh khối(nguồn văn bản, các từ tố, trạng thái nội bộ, biểu diễn trung gian);
            };
            nếu (lần hoàn trả thứ hai < 0) { trả về -1; };
            nếu (jump điểm kết thúc location >= 0) {
                nếu (byte ghi số nguyên ba mươi hai bit(biểu diễn trung gian, jump điểm kết thúc location + 4, byte dài(biểu diễn trung gian)) != 0) { trả về -1; };
            };
            nếu (lần hoàn trả thứ nhất == 1) {
                nếu (lần hoàn trả thứ hai == 1) { byte ghi số nguyên ba mươi hai bit(trạng thái nội bộ, 8, 1); };
            };
        } hoặc {
            nếu (byte ghi số nguyên ba mươi hai bit(biểu diễn trung gian, số mục bỏ qua + 4, byte dài(biểu diễn trung gian)) != 0) { trả về -1; };
        };
        phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, ";");
        trả về 0;
    };
    nếu (phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, "biến") == 1) {
        biến con trỏ hiện tại = byte đọc số nguyên ba mươi hai bit(trạng thái nội bộ, 0);
        nếu (phân tích định danh(nguồn văn bản, các từ tố, con trỏ hiện tại) != 1) { trả về -1; };
        nếu (phân tích mục ký hiệu(nguồn văn bản, các từ tố, trạng thái nội bộ, con trỏ hiện tại) >= 0) { trả về -1; };
        biến điểm bắt đầu = từ tố trường dữ liệu(các từ tố, con trỏ hiện tại, 0);
        biến điểm kết thúc = từ tố trường dữ liệu(các từ tố, con trỏ hiện tại, 1);
        byte ghi số nguyên ba mươi hai bit(trạng thái nội bộ, 0, con trỏ hiện tại + 1);
        nếu (phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, "=") != 1) { trả về -1; };
        nếu (phân tích biểu thức(nguồn văn bản, các từ tố, trạng thái nội bộ, biểu diễn trung gian) != 0) { trả về -1; };
        nếu (phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, ";") != 1) { trả về -1; };
        biến ô nhớ = byte đọc số nguyên ba mươi hai bit(trạng thái nội bộ, 4);
        nếu (ô nhớ >= 130000) { trả về -1; };
        nếu (phân tích phát(biểu diễn trung gian, 3, ô nhớ) != 0) { trả về -1; };
        nếu (byte đẩy số nguyên ba mươi hai bit(trạng thái nội bộ, điểm bắt đầu) != 0) { trả về -1; };
        nếu (byte đẩy số nguyên ba mươi hai bit(trạng thái nội bộ, điểm kết thúc) != 0) { trả về -1; };
        byte ghi số nguyên ba mươi hai bit(trạng thái nội bộ, 4, ô nhớ + 1);
        trả về 0;
    };
    nếu (phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, "trả") == 1) {
        nếu (phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, "về") != 1) { trả về -1; };
        nếu (phân tích biểu thức(nguồn văn bản, các từ tố, trạng thái nội bộ, biểu diễn trung gian) != 0) { trả về -1; };
        nếu (phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, ";") != 1) { trả về -1; };
        nếu (phân tích phát(biểu diễn trung gian, 7, 0) != 0) { trả về -1; };
        byte ghi số nguyên ba mươi hai bit(trạng thái nội bộ, 8, 1);
        trả về 0;
    };
    // Standalone calls are legal statements; discard their i32 return value.
    biến câu lệnh con trỏ hiện tại = byte đọc số nguyên ba mươi hai bit(trạng thái nội bộ, 0);
    nếu (phân tích định danh(nguồn văn bản, các từ tố, câu lệnh con trỏ hiện tại) == 1) {
        nếu (từ tố bằng(nguồn văn bản, các từ tố, câu lệnh con trỏ hiện tại + 1, "(") == 1) {
            nếu (phân tích biểu thức(nguồn văn bản, các từ tố, trạng thái nội bộ, biểu diễn trung gian) != 0) { trả về -1; };
            nếu (phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, ";") != 1) { trả về -1; };
            trả về phân tích phát(biểu diễn trung gian, 24, 0);
        };
    };
    // Gán lại biến cục bộ đã khai báo, không cấp slot mới.
    biến assign con trỏ hiện tại = byte đọc số nguyên ba mươi hai bit(trạng thái nội bộ, 0);
    nếu (phân tích định danh(nguồn văn bản, các từ tố, assign con trỏ hiện tại) != 1) { trả về -1; };
    biến assign ô nhớ = phân tích mục ký hiệu(nguồn văn bản, các từ tố, trạng thái nội bộ, assign con trỏ hiện tại);
    nếu (assign ô nhớ < 0) { trả về -1; };
    byte ghi số nguyên ba mươi hai bit(trạng thái nội bộ, 0, assign con trỏ hiện tại + 1);
    biến kết hợp = 0;
    biến hậu tố = 0;
    nếu (phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, "=") == 1) { kết hợp = 0; }
    hoặc nếu (phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, "+=") == 1) { kết hợp = 4; }
    hoặc nếu (phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, "-=") == 1) { kết hợp = 5; }
    hoặc nếu (phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, "*=") == 1) { kết hợp = 6; }
    hoặc nếu (phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, "/=") == 1) { kết hợp = 26; }
    hoặc nếu (phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, "%=") == 1) { kết hợp = 27; }
    hoặc nếu (phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, "++") == 1) {
        kết hợp = 4;
        hậu tố = 1;
    }
    hoặc nếu (phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, "--") == 1) {
        kết hợp = 5;
        hậu tố = 1;
    }
    hoặc { trả về -1; };
    nếu (kết hợp != 0) {
        nếu (phân tích phát(biểu diễn trung gian, 2, assign ô nhớ) != 0) { trả về -1; };
    };
    nếu (hậu tố == 1) {
        nếu (phân tích phát(biểu diễn trung gian, 1, 1) != 0) { trả về -1; };
    } hoặc {
        nếu (phân tích biểu thức(nguồn văn bản, các từ tố, trạng thái nội bộ, biểu diễn trung gian) != 0) { trả về -1; };
    };
    nếu (kết hợp != 0) {
        nếu (phân tích phát(biểu diễn trung gian, kết hợp, 0) != 0) { trả về -1; };
    };
    nếu (phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, ";") != 1) { trả về -1; };
    trả về phân tích phát(biểu diễn trung gian, 3, assign ô nhớ);
};

hàm phân tích thân khối(nguồn văn bản, các từ tố, trạng thái nội bộ, biểu diễn trung gian) {
    nếu (phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, "hàm") != 1) { trả về -1; };
    nếu (phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, "chính") != 1) { trả về -1; };
    nếu (phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, "(") != 1) { trả về -1; };
    nếu (phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, ")") != 1) { trả về -1; };
    nếu (phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, "{") != 1) { trả về -1; };
    lặp (i = 0; i < từ tố số phần tử(các từ tố); i++) {
        biến con trỏ hiện tại = byte đọc số nguyên ba mươi hai bit(trạng thái nội bộ, 0);
        nếu (con trỏ hiện tại >= từ tố số phần tử(các từ tố)) { trả về -1; };
        nếu (phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, "}") == 1) {
            nếu (byte đọc số nguyên ba mươi hai bit(trạng thái nội bộ, 8) != 1) { trả về -1; };
            // Dấu ; sau khai báo hàm là tùy chọn.
            phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, ";");
            nếu (byte đọc số nguyên ba mươi hai bit(trạng thái nội bộ, 0) != từ tố số phần tử(các từ tố)) { trả về -1; };
            trả về byte dài(biểu diễn trung gian);
        };
        nếu (byte đọc số nguyên ba mươi hai bit(trạng thái nội bộ, 8) != 0) { trả về -1; };
        nếu (phân tích câu lệnh(nguồn văn bản, các từ tố, trạng thái nội bộ, biểu diễn trung gian) != 0) { trả về -1; };
    };
    trả về -1;
};

// IR đích phải có handle riêng. Thành công: số byte IR; lỗi: -1,
// luôn xóa IR nếu parse/semantic thất bại, tránh sinh artifact dang dở.
hàm phân tích biên dịch(nguồn văn bản, các từ tố, biểu diễn trung gian) {
    nếu (byte dài(nguồn văn bản) < 0) { trả về -1; };
    nếu (byte dài(biểu diễn trung gian) < 0) { trả về -1; };
    nếu (biểu diễn trung gian == nguồn văn bản) { trả về -1; };
    nếu (biểu diễn trung gian == các từ tố) { trả về -1; };
    nếu (byte làm rỗng(biểu diễn trung gian) != 0) { trả về -1; };
    nếu (từ tố kiểm tra hợp lệ(nguồn văn bản, các từ tố) < 0) { trả về -1; };
    biến trạng thái nội bộ = byte mới();
    nếu (trạng thái nội bộ <= 0) { trả về -1; };
    biến sẵn sàng = 0;
    nếu (byte đẩy số nguyên ba mươi hai bit(trạng thái nội bộ, 0) == 0) { sẵn sàng = sẵn sàng + 1; };
    nếu (byte đẩy số nguyên ba mươi hai bit(trạng thái nội bộ, 0) == 0) { sẵn sàng = sẵn sàng + 1; };
    nếu (byte đẩy số nguyên ba mươi hai bit(trạng thái nội bộ, 0) == 0) { sẵn sàng = sẵn sàng + 1; };
    nếu (byte đẩy số nguyên ba mươi hai bit(trạng thái nội bộ, 0) == 0) { sẵn sàng = sẵn sàng + 1; };
    nếu (byte đẩy số nguyên ba mươi hai bit(trạng thái nội bộ, 0) == 0) { sẵn sàng = sẵn sàng + 1; };
    biến kết quả trả về = -1;
    nếu (sẵn sàng == 5) { kết quả trả về = phân tích thân khối(nguồn văn bản, các từ tố, trạng thái nội bộ, biểu diễn trung gian); };
    byte hủy(trạng thái nội bộ);
    nếu (kết quả trả về < 0) { byte làm rỗng(biểu diễn trung gian); };
    trả về kết quả trả về;
};
