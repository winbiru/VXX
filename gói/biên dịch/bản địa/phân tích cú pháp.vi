// Parser/semantic và IR tuyến tính native cho tập con hàm chính() i32.
// Ngữ pháp: hàm chính() { (biến tên = expr; | tên = expr; | nếu ...)* trả về expr; };
// expr: i32, đúng/sai, tên đã khai báo, dấu ngoặc, unary -/+/!, +, -, *, /, %, so sánh.
// Câu lệnh và bước cập nhật vòng lặp hỗ trợ =, +=, -=, *=, /=, %=; biến cục bộ
// cũng có thể dùng ++/--. Các phép tính dùng opcode IR i32 hiện có.
// IR là dãy (i32 opcode, i32 operand) dùng stack, có thể tự chạy bằng V++.
// op: 1 PUSH, 2 LOAD, 3 STORE, 4 ADD, 5 SUB, 6 MUL, 7 RET, 8 NEG,
// 9 JZ (pop), 10 JMP; 11 EQ, 12 NE, 13 LT, 14 LE, 15 GT, 16 GE;
// 25 NOT, 26 DIV (signed i32), 27 MOD (signed i32). Chia cho 0 là lỗi.
// Đích JZ/JMP là byte offset (bội của 8) trong buffer IR.
// parser state: cursor, số biến, return-flag, loop-depth,
//               (start,end) * số biến.

hàm phân tích nhận(nguồn văn bản, các từ tố, trạng thái nội bộ, giá trị mong đợi) {
    biến con trỏ hiện tại = byte đọc số nguyên ba mươi hai bit(trạng thái nội bộ, 0);
    biến đã khớp = từ tố bằng(nguồn văn bản, các từ tố, con trỏ hiện tại, giá trị mong đợi);
    nếu (đã khớp == 1) { byte ghi số nguyên ba mươi hai bit(trạng thái nội bộ, 0, con trỏ hiện tại + 1); };
    trả về đã khớp;
};

hàm phân tích phát(biểu diễn trung gian, mã phép toán, toán hạng) {
    nếu (byte dài(biểu diễn trung gian) > 1048568) { trả về -1; };
    nếu (byte đẩy số nguyên ba mươi hai bit(biểu diễn trung gian, mã phép toán) != 0) { trả về -1; };
    nếu (byte đẩy số nguyên ba mươi hai bit(biểu diễn trung gian, toán hạng) != 0) { trả về -1; };
    trả về 0;
};

// Symbol lookup: same UTF-8 byte span, no name allocation.
hàm phân tích mục ký hiệu(nguồn văn bản, các từ tố, trạng thái nội bộ, chỉ mục) {
    biến điểm bắt đầu = từ tố trường dữ liệu(các từ tố, chỉ mục, 0);
    biến điểm kết thúc = từ tố trường dữ liệu(các từ tố, chỉ mục, 1);
    nếu (điểm bắt đầu < 0) { trả về -1; };
    biến số phần tử = byte đọc số nguyên ba mươi hai bit(trạng thái nội bộ, 4);
    lặp (i = 0; i < số phần tử; i++) {
        biến điểm mở đầu = byte đọc số nguyên ba mươi hai bit(trạng thái nội bộ, 20 + i * 8);
        biến điểm hoàn thành = byte đọc số nguyên ba mươi hai bit(trạng thái nội bộ, 24 + i * 8);
        nếu (điểm mở đầu < 0) { bỏ qua; };
        biến giống nhau = 1;
        nếu (điểm kết thúc - điểm bắt đầu != điểm hoàn thành - điểm mở đầu) { giống nhau = 0; };
        nếu (giống nhau == 1) {
            lặp (j = 0; j < điểm kết thúc - điểm bắt đầu; j++) {
                nếu (byte lấy(nguồn văn bản, điểm bắt đầu + j) != byte lấy(nguồn văn bản, điểm mở đầu + j)) {
                    giống nhau = 0;
                    thoát;
                };
            };
        };
        nếu (giống nhau == 1) { trả về i; };
    };
    trả về -1;
};

// Parse i32 không dấu, báo lỗi trước khi overflow.
hàm phân tích số(nguồn văn bản, điểm bắt đầu, điểm kết thúc) {
    nếu (điểm bắt đầu < 0) { trả về -1; };
    nếu (điểm kết thúc <= điểm bắt đầu) { trả về -1; };
    biến giá trị đang xét = 0;
    lặp (i = điểm bắt đầu; i < điểm kết thúc; i++) {
        biến chữ số đang xét = byte lấy(nguồn văn bản, i) - 48;
        nếu (chữ số đang xét < 0) { trả về -1; };
        nếu (chữ số đang xét > 9) { trả về -1; };
        nếu (giá trị đang xét > 214748364) { trả về -1; };
        nếu (giá trị đang xét == 214748364) {
            nếu (chữ số đang xét > 7) { trả về -1; };
        };
        giá trị đang xét = giá trị đang xét * 10 + chữ số đang xét;
    };
    trả về giá trị đang xét;
};

// Một định danh trong tập con native phải là chuỗi UTF-8 bắt đầu bằng
// chữ cái hoặc dấu gạch dưới; dấu chấm/số ở đầu và từ khóa bị từ chối.
hàm phân tích định danh(nguồn văn bản, các từ tố, chỉ mục) {
    nếu (từ tố trường dữ liệu(các từ tố, chỉ mục, 2) != 1) { trả về 0; };
    biến điểm bắt đầu = từ tố trường dữ liệu(các từ tố, chỉ mục, 0);
    biến điểm kết thúc = từ tố trường dữ liệu(các từ tố, chỉ mục, 1);
    nếu (điểm bắt đầu < 0) { trả về 0; };
    biến đầu tiên = byte lấy(nguồn văn bản, điểm bắt đầu);
    nếu (đầu tiên >= 48) { nếu (đầu tiên <= 57) { trả về 0; }; };
    lặp (i = điểm bắt đầu; i < điểm kết thúc; i++) {
        biến ch = byte lấy(nguồn văn bản, i);
        nếu (ch < 128) {
            biến hợp lệ = 0;
            nếu (ch >= 65) { nếu (ch <= 90) { hợp lệ = 1; }; };
            nếu (ch >= 97) { nếu (ch <= 122) { hợp lệ = 1; }; };
            nếu (ch >= 48) { nếu (ch <= 57) { hợp lệ = 1; }; };
            nếu (ch == 95) { hợp lệ = 1; };
            nếu (ch == 32) { hợp lệ = 1; };
            nếu (ch == 9) { hợp lệ = 1; };
            nếu (hợp lệ == 0) { trả về 0; };
        };
    };
    nếu (từ tố bằng(nguồn văn bản, các từ tố, chỉ mục, "hàm") == 1) { trả về 0; };
    nếu (từ tố bằng(nguồn văn bản, các từ tố, chỉ mục, "biến") == 1) { trả về 0; };
    nếu (từ tố bằng(nguồn văn bản, các từ tố, chỉ mục, "trả") == 1) { trả về 0; };
    nếu (từ tố bằng(nguồn văn bản, các từ tố, chỉ mục, "về") == 1) { trả về 0; };
    nếu (từ tố bằng(nguồn văn bản, các từ tố, chỉ mục, "nếu") == 1) { trả về 0; };
    nếu (từ tố bằng(nguồn văn bản, các từ tố, chỉ mục, "lặp") == 1) { trả về 0; };
    nếu (từ tố bằng(nguồn văn bản, các từ tố, chỉ mục, "đúng") == 1) { trả về 0; };
    nếu (từ tố bằng(nguồn văn bản, các từ tố, chỉ mục, "sai") == 1) { trả về 0; };
    nếu (từ tố bằng(nguồn văn bản, các từ tố, chỉ mục, "rỗng") == 1) { trả về 0; };
    trả về 1;
};

// Name matching keeps all function references in UTF-8 source byte spans.
hàm phân tích giống nhau từ tố(nguồn văn bản, các từ tố, a chỉ mục, b chỉ mục) {
    biến a = từ tố trường dữ liệu(các từ tố, a chỉ mục, 0);
    biến a điểm kết thúc = từ tố trường dữ liệu(các từ tố, a chỉ mục, 1);
    biến b = từ tố trường dữ liệu(các từ tố, b chỉ mục, 0);
    biến b điểm kết thúc = từ tố trường dữ liệu(các từ tố, b chỉ mục, 1);
    nếu (a < 0) { trả về 0; };
    nếu (b < 0) { trả về 0; };
    nếu (a điểm kết thúc - a != b điểm kết thúc - b) { trả về 0; };
    lặp (i = 0; i < a điểm kết thúc - a; i++) {
        nếu (byte lấy(nguồn văn bản, a + i) != byte lấy(nguồn văn bản, b + i)) { trả về 0; };
    };
    trả về 1;
};

// The machine runtime owns the entire vpp_native_* symbol namespace.
// Reject declarations at the V++ frontend so user objects cannot shadow
// ASM primitives when the native linker resolves external symbols.
hàm phân tích dành riêng abi tên định danh(nguồn văn bản, các từ tố, chỉ mục) {
    biến điểm bắt đầu = từ tố trường dữ liệu(các từ tố, chỉ mục, 0);
    biến điểm kết thúc = từ tố trường dữ liệu(các từ tố, chỉ mục, 1);
    nếu (điểm bắt đầu < 0) { trả về 0; };
    nếu (điểm kết thúc - điểm bắt đầu < 11) { trả về 0; };
    biến tiền tố = "vpp_native_";
    biến đã khớp = 1;
    lặp (i = 0; i < 11; i++) {
        nếu (byte lấy(nguồn văn bản, điểm bắt đầu + i) != byte lấy(tiền tố, i)) {
            đã khớp = 0;
            thoát;
        };
    };
    byte hủy(tiền tố);
    trả về đã khớp;
};

// Return the number of i32 parameters in a function header.
// The first parameter starts at declaration token + 3.
hàm phân tích phần đầu số tham số(nguồn văn bản, các từ tố, chương trình con hiện tại từ tố) {
    nếu (phân tích định danh(nguồn văn bản, các từ tố, chương trình con hiện tại từ tố + 1) != 1) { trả về -1; };
    nếu (phân tích bản địa mã định danh(nguồn văn bản, các từ tố, chương trình con hiện tại từ tố + 1) >= 0) { trả về -1; };
    nếu (phân tích dành riêng abi tên định danh(nguồn văn bản, các từ tố, chương trình con hiện tại từ tố + 1) == 1) { trả về -1; };
    nếu (từ tố bằng(nguồn văn bản, các từ tố, chương trình con hiện tại từ tố + 2, "(") != 1) { trả về -1; };
    biến con trỏ hiện tại = chương trình con hiện tại từ tố + 3;
    biến n = 0;
    nếu (từ tố bằng(nguồn văn bản, các từ tố, con trỏ hiện tại, ")") == 1) {
        nếu (từ tố bằng(nguồn văn bản, các từ tố, con trỏ hiện tại + 1, "{") == 1) { trả về 0; };
        trả về -1;
    };
    lặp (k = 0; k < từ tố số phần tử(các từ tố); k++) {
        nếu (phân tích định danh(nguồn văn bản, các từ tố, con trỏ hiện tại) != 1) { trả về -1; };
        n = n + 1;
        con trỏ hiện tại = con trỏ hiện tại + 1;
        nếu (từ tố bằng(nguồn văn bản, các từ tố, con trỏ hiện tại, ")") == 1) {
            nếu (từ tố bằng(nguồn văn bản, các từ tố, con trỏ hiện tại + 1, "{") == 1) { trả về n; };
            trả về -1;
        };
        nếu (từ tố bằng(nguồn văn bản, các từ tố, con trỏ hiện tại, ",") != 1) { trả về -1; };
        con trỏ hiện tại = con trỏ hiện tại + 1;
    };
    trả về -1;
};

// Function IDs follow declaration order; calls may reference later functions.
// CALL's function ID and CALL_ARITY's argument count are separate IR fields,
// so the argument count is not limited by bit packing.
hàm phân tích chương trình con mã định danh(nguồn văn bản, các từ tố, tên định danh chỉ mục) {
    biến số phần tử = 0;
    lặp (i = 0; i < từ tố số phần tử(các từ tố); i++) {
        nếu (từ tố bằng(nguồn văn bản, các từ tố, i, "hàm") == 1) {
            biến số tham số = phân tích phần đầu số tham số(nguồn văn bản, các từ tố, i);
            nếu (số tham số >= 0) {
                nếu (phân tích giống nhau từ tố(nguồn văn bản, các từ tố, tên định danh chỉ mục, i + 1) == 1) {
                    trả về số phần tử;
                };
                số phần tử = số phần tử + 1;
            };
        };
    };
    trả về -1;
};

hàm phân tích chương trình con số tham số(nguồn văn bản, các từ tố, chương trình con mã định danh) {
    biến số phần tử = 0;
    lặp (i = 0; i < từ tố số phần tử(các từ tố); i++) {
        nếu (từ tố bằng(nguồn văn bản, các từ tố, i, "hàm") == 1) {
            biến số tham số = phân tích phần đầu số tham số(nguồn văn bản, các từ tố, i);
            nếu (số tham số >= 0) {
                nếu (số phần tử == chương trình con mã định danh) { trả về số tham số; };
                số phần tử = số phần tử + 1;
            };
        };
    };
    trả về -1;
};

// Shared signature lookup belongs to the parser so standalone parser and
// codegen users do not depend on the module compilation driver.
// Registry records are [i32 byte_length, i32 arity, UTF-8 name bytes].
hàm phân tích sổ đăng ký mã định danh(nguồn văn bản, các từ tố, tên định danh chỉ mục, sổ đăng ký) {
    biến điểm bắt đầu = từ tố trường dữ liệu(các từ tố, tên định danh chỉ mục, 0);
    biến điểm kết thúc = từ tố trường dữ liệu(các từ tố, tên định danh chỉ mục, 1);
    nếu (điểm bắt đầu < 0) { trả về -1; };
    biến chỉ mục = 0;
    lặp (độ lệch = 0; độ lệch < byte dài(sổ đăng ký); độ lệch = độ lệch) {
        nếu (độ lệch + 8 > byte dài(sổ đăng ký)) { trả về -1; };
        biến chiều dài = byte đọc số nguyên ba mươi hai bit(sổ đăng ký, độ lệch);
        nếu (chiều dài <= 0) { trả về -1; };
        nếu (chiều dài > byte dài(sổ đăng ký) - độ lệch - 8) { trả về -1; };
        nếu (chiều dài == điểm kết thúc - điểm bắt đầu) {
            biến khớp = 1;
            lặp (i = 0; i < chiều dài; i++) {
                nếu (byte lấy(nguồn văn bản, điểm bắt đầu + i) != byte lấy(sổ đăng ký, độ lệch + 8 + i)) {
                    khớp = 0;
                    thoát;
                };
            };
            nếu (khớp == 1) { trả về chỉ mục; };
        };
        độ lệch = độ lệch + 8 + chiều dài;
        chỉ mục = chỉ mục + 1;
    };
    trả về -1;
};

hàm phân tích sổ đăng ký số tham số(sổ đăng ký, chương trình con mã định danh) {
    nếu (chương trình con mã định danh < 0) { trả về -1; };
    biến chỉ mục = 0;
    lặp (độ lệch = 0; độ lệch < byte dài(sổ đăng ký); độ lệch = độ lệch) {
        nếu (độ lệch + 8 > byte dài(sổ đăng ký)) { trả về -1; };
        biến chiều dài = byte đọc số nguyên ba mươi hai bit(sổ đăng ký, độ lệch);
        nếu (chiều dài <= 0) { trả về -1; };
        nếu (chiều dài > byte dài(sổ đăng ký) - độ lệch - 8) { trả về -1; };
        nếu (chỉ mục == chương trình con mã định danh) { trả về byte đọc số nguyên ba mươi hai bit(sổ đăng ký, độ lệch + 4); };
        độ lệch = độ lệch + 8 + chiều dài;
        chỉ mục = chỉ mục + 1;
    };
    trả về -1;
};

// IDs of the closed native runtime ABI. A negative CALL operand encodes
// -(id + 1); nonnegative operands continue to name user-defined functions.
// Keep this table in the same order as obj_native_name in object.vi.
hàm phân tích bản địa mã định danh(nguồn văn bản, các từ tố, con trỏ hiện tại) {
    nếu (từ tố bằng(nguồn văn bản, các từ tố, con trỏ hiện tại, "byte mới") == 1) { trả về 0; };
    nếu (từ tố bằng(nguồn văn bản, các từ tố, con trỏ hiện tại, "byte dài") == 1) { trả về 1; };
    nếu (từ tố bằng(nguồn văn bản, các từ tố, con trỏ hiện tại, "byte lấy") == 1) { trả về 2; };
    nếu (từ tố bằng(nguồn văn bản, các từ tố, con trỏ hiện tại, "byte thêm") == 1) { trả về 3; };
    nếu (từ tố bằng(nguồn văn bản, các từ tố, con trỏ hiện tại, "byte đẩy số nguyên ba mươi hai bit") == 1) { trả về 4; };
    nếu (từ tố bằng(nguồn văn bản, các từ tố, con trỏ hiện tại, "byte đọc số nguyên ba mươi hai bit") == 1) { trả về 5; };
    nếu (từ tố bằng(nguồn văn bản, các từ tố, con trỏ hiện tại, "byte ghi số nguyên ba mươi hai bit") == 1) { trả về 6; };
    nếu (từ tố bằng(nguồn văn bản, các từ tố, con trỏ hiện tại, "byte làm rỗng") == 1) { trả về 7; };
    nếu (từ tố bằng(nguồn văn bản, các từ tố, con trỏ hiện tại, "byte nối") == 1) { trả về 8; };
    nếu (từ tố bằng(nguồn văn bản, các từ tố, con trỏ hiện tại, "byte bằng") == 1) { trả về 9; };
    nếu (từ tố bằng(nguồn văn bản, các từ tố, con trỏ hiện tại, "byte hủy") == 1) { trả về 10; };
    nếu (từ tố bằng(nguồn văn bản, các từ tố, con trỏ hiện tại, "đối số đếm") == 1) { trả về 11; };
    nếu (từ tố bằng(nguồn văn bản, các từ tố, con trỏ hiện tại, "đối số lấy") == 1) { trả về 12; };
