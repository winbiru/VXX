// aarch64: phát byte mã máy kiến trúc riêng.
// Các phép chưa hỗ trợ phải ném lỗi tại bộ chọn lowering, không phát mã sai.
nhập gói/biên dịch/mã máy nền;

// Lớp sở hữu toàn bộ thuật toán của mô-đun; các hàm bên dưới chỉ giữ API cũ.
lớp công khai Bộ Phát AARCH64 {
    hàm công khai khởi tạo() {};

    hàm công khai biên dịch mã máy phát aarch64(loại, hằng, thấp, cao, ít, hệ điều hành) {
        ra = [];
        nếu (loại == "hằng") {
                        biên dịch mã máy thêm từ máy(ra, biên dịch mã máy từ máy thập lục phân("52800000") + thấp * 32, ít);
                        biên dịch mã máy thêm từ máy(ra, biên dịch mã máy từ máy thập lục phân("72a00000") + cao * 32, ít);
                    } hoặc {
                        nếu (loại == "cộng") { biên dịch mã máy thêm thập lục phân(ra, "0b010000", ít); }
                        hoặc { biên dịch mã máy thêm thập lục phân(ra, "4b010000", ít); };
                    };
                    biên dịch mã máy thêm thập lục phân(ra, "d65f03c0", ít);
        trả về ra;
    };

    // Machine IR i32: byte emitter thuần V++ tương ứng chính xác với
    // emitAArch64Function trong src/native/aarch64_codegen.cpp.
    // Input gồm {"parameterCount", "slotCount", "maxStackDepth", "instructions"};
    // mỗi lệnh gồm {"opcode", "immediate", "operand", "depthBefore", "symbol"}.
    // Không nhận IR động/không có kiểu; relocation CALL để object writer xử lý.
    hàm riêng tư biên dịch mã máy aarch64 từ máy(ra, từ máy) {
        biên dịch mã máy thêm từ máy(ra, từ máy, đúng);
    };

    // Ánh xạ cố định qua mọi nhánh/vòng lặp; bỏ qua scratch W9/W10.
    // Chỉ dùng W0..W17, không chạm W18 của nền tảng hoặc callee-saved W19+.
    hàm riêng tư biên dịch mã máy aarch64 thành ghi(ô nhớ) {
        nếu (ô nhớ < 9) { trả về ô nhớ; };
        trả về ô nhớ + 2;
    };

    hàm riêng tư biên dịch mã máy aarch64 chuyển(ra, đích, nguồn) {
        nếu (đích != nguồn) {
            mình.biên dịch mã máy aarch64 từ máy(ra,
                biên dịch mã máy từ máy thập lục phân("2a0003e0") + nguồn * 65536 + đích);
        };
    };

    hàm riêng tư biên dịch mã máy aarch64 điều chỉnh con trỏ ngăn xếp(ra, các byte, trừ) {
        còn = các byte;
        lặp (i = 0; i < các byte; i += 4095) {
            bước = còn;
            nếu (bước > 4095) { bước = 4095; };
            nền = biên dịch mã máy từ máy thập lục phân("910003ff");
            nếu (trừ) { nền = biên dịch mã máy từ máy thập lục phân("d10003ff"); };
            mình.biên dịch mã máy aarch64 từ máy(ra, nền + bước * 1024);
            còn -= bước;
        };
    };

    hàm riêng tư biên dịch mã máy aarch64 truy cập byte(ra, tải, thành ghi, độ lệch) {
        nếu (độ lệch < 0 || độ lệch > 2147483647 || độ lệch % 4 != 0) {
            ném "AArch64: offset stack không hợp lệ";
        };
        cơ sở = biên dịch mã máy từ máy thập lục phân("b9000000");
        nếu (tải) { cơ sở = biên dịch mã máy từ máy thập lục phân("b9400000"); };
        nếu (độ lệch <= 16380) {
            mình.biên dịch mã máy aarch64 từ máy(ra, cơ sở + độ lệch * 256 + 992 + thành ghi);
            trả về;
        };
        mình.biên dịch mã máy aarch64 từ máy(ra, biên dịch mã máy từ máy thập lục phân("910003eb"));
        còn = độ lệch;
        lặp (i = 0; i < độ lệch; i += 4095) {
            bước = còn;
            nếu (bước > 4095) { bước = 4095; };
            mình.biên dịch mã máy aarch64 từ máy(ra,
                biên dịch mã máy từ máy thập lục phân("9100016b") + bước * 1024);
            còn -= bước;
        };
        mình.biên dịch mã máy aarch64 từ máy(ra, cơ sở + 352 + thành ghi);
    };

    // LDR/STR cho fallback; MOV cho hàm lá vừa đủ thanh ghi.
    hàm riêng tư biên dịch mã máy aarch64 truy cập(ra, tải, thành ghi, ô nhớ, dùng thành ghi) {
        nếu (ô nhớ < 0 || thành ghi < 0 || thành ghi > 31) {
            ném "AArch64: slot hoặc thanh ghi ngoài frame";
        };
        nếu (dùng thành ghi) {
            vị trí = mình.biên dịch mã máy aarch64 thành ghi(ô nhớ);
            nếu (tải) { mình.biên dịch mã máy aarch64 chuyển(ra, thành ghi, vị trí); }
            hoặc { mình.biên dịch mã máy aarch64 chuyển(ra, vị trí, thành ghi); };
            trả về;
        };
        mình.biên dịch mã máy aarch64 truy cập byte(ra, tải, thành ghi, ô nhớ * 4);
    };

    // Nhận IR đã được CFG validator kiểm tra depth tại các điểm nối.
    // Branch target là chỉ số lệnh; kết quả offset và relocation là byte offset.
    hàm công khai biên dịch mã máy phát aarch64 hàm(danh sách hàm biểu diễn trung gian, hệ điều hành = "linux") {
        tham số = danh sách hàm biểu diễn trung gian["parameterCount"];
        ô nhớ = danh sách hàm biểu diễn trung gian["slotCount"];
        sâu nhất = danh sách hàm biểu diễn trung gian["maxStackDepth"];
        lệnh = danh sách hàm biểu diễn trung gian["instructions"];
        nếu (tham số < 0 || ô nhớ < tham số || ô nhớ < 0 ||
            sâu nhất < 0 || ô nhớ + sâu nhất > 134217724 || máy ảo lấy độ dài(lệnh) == 0) {
            ném "AArch64 machine IR/frame không hợp lệ";
        };
        khung = ((4 * (ô nhớ + sâu nhất) + 15) / 16) * 16;
        bước tham số = 8;
        nếu (hệ điều hành == "macos") { bước tham số = 4; };
        dùng thành ghi = tham số <= 8 && ô nhớ + sâu nhất <= 16;
        lặp (i = 0; i < máy ảo lấy độ dài(lệnh); i++) {
            nếu (lệnh[i]["opcode"] == "Call") { dùng thành ghi = sai; };
        };
        nếu (dùng thành ghi) { khung = 0; };
        ra = [];
        tái định vị = [];
        vá nhánh = [];
        vị trí lệnh = [];

        nếu (!dùng thành ghi) {
            biên dịch mã máy thêm thập lục phân(ra, "a9bf7bfd", đúng);
            biên dịch mã máy thêm thập lục phân(ra, "910003fd", đúng);
        };
        nếu (khung > 0) {
            mình.biên dịch mã máy aarch64 điều chỉnh con trỏ ngăn xếp(ra, khung, đúng);
        };
        lặp (i = 0; i < tham số; i++) {
            nếu (i < 8) {
                mình.biên dịch mã máy aarch64 truy cập(ra, sai, i, i, dùng thành ghi);
            } hoặc {
                mình.biên dịch mã máy aarch64 truy cập byte(ra, đúng, 9, khung + 16 + (i - 8) * bước tham số);
                mình.biên dịch mã máy aarch64 truy cập(ra, sai, 9, i, sai);
            };
        };

        lặp (i = 0; i < máy ảo lấy độ dài(lệnh); i++) {
            máy ảo thêm cuối danh sách(vị trí lệnh, máy ảo lấy độ dài(ra));
            mã phép toán = lệnh[i];
            mã = mã phép toán["opcode"];
            d = mã phép toán["depthBefore"];
            số = mã phép toán["operand"];
            nếu (d < 0 || d > sâu nhất) { ném "AArch64: độ sâu stack không hợp lệ"; };
            chọn (mã) {
                ca "PushConstant": {
                    nếu (d >= sâu nhất) { ném "ARM64 eval stack overflow"; };
                    nửa = biên dịch mã máy trả về(mã phép toán["immediate"]);
                    đích = 9;
                    nếu (dùng thành ghi) { đích = mình.biên dịch mã máy aarch64 thành ghi(ô nhớ + d); };
                    mình.biên dịch mã máy aarch64 từ máy(ra, biên dịch mã máy từ máy thập lục phân("52800000") + nửa["lo"] * 32 + đích);
                    nếu (!dùng thành ghi || nửa["hi"] != 0) {
                        mình.biên dịch mã máy aarch64 từ máy(ra, biên dịch mã máy từ máy thập lục phân("72a00000") + nửa["hi"] * 32 + đích);
                    };
                    mình.biên dịch mã máy aarch64 truy cập(ra, sai, đích, ô nhớ + d, dùng thành ghi);
                }
                ca "LoadSlot": {
                    nếu (số < 0 || số >= ô nhớ || d >= sâu nhất) { ném "ARM64 load slot ngoài frame"; };
                    nếu (dùng thành ghi) {
                        mình.biên dịch mã máy aarch64 chuyển(ra,
                            mình.biên dịch mã máy aarch64 thành ghi(ô nhớ + d),
                            mình.biên dịch mã máy aarch64 thành ghi(số));
                    } hoặc {
                        mình.biên dịch mã máy aarch64 truy cập(ra, đúng, 9, số, sai);
                        mình.biên dịch mã máy aarch64 truy cập(ra, sai, 9, ô nhớ + d, sai);
                    };
                }
                ca "StoreSlot": {
                    nếu (số < 0 || số >= ô nhớ || d == 0) { ném "ARM64 store slot ngoài frame"; };
                    nếu (dùng thành ghi) {
                        mình.biên dịch mã máy aarch64 chuyển(ra,
                            mình.biên dịch mã máy aarch64 thành ghi(số),
                            mình.biên dịch mã máy aarch64 thành ghi(ô nhớ + d - 1));
                    } hoặc {
                        mình.biên dịch mã máy aarch64 truy cập(ra, đúng, 9, ô nhớ + d - 1, sai);
                        mình.biên dịch mã máy aarch64 truy cập(ra, sai, 9, số, sai);
                    };
                }
                ca "Drop": {
                    nếu (d == 0) { ném "ARM64 eval stack underflow"; };
                }
                ca "Add": {
                    mình.biên dịch mã máy aarch64 phép tính(ra, d, ô nhớ, "0b000000", dùng thành ghi);
                }
                ca "Sub": {
                    mình.biên dịch mã máy aarch64 phép tính(ra, d, ô nhớ, "4b000000", dùng thành ghi);
                }
                ca "Mul": {
                    mình.biên dịch mã máy aarch64 phép tính(ra, d, ô nhớ, "1b007c00", dùng thành ghi);
                }
                ca "Equal": { mình.biên dịch mã máy aarch64 số sánh(ra, d, ô nhớ, 1, dùng thành ghi); }
                ca "NotEqual": { mình.biên dịch mã máy aarch64 số sánh(ra, d, ô nhớ, 0, dùng thành ghi); }
                ca "Less": { mình.biên dịch mã máy aarch64 số sánh(ra, d, ô nhớ, 10, dùng thành ghi); }
                ca "LessEqual": { mình.biên dịch mã máy aarch64 số sánh(ra, d, ô nhớ, 12, dùng thành ghi); }
                ca "Greater": { mình.biên dịch mã máy aarch64 số sánh(ra, d, ô nhớ, 13, dùng thành ghi); }
                ca "GreaterEqual": { mình.biên dịch mã máy aarch64 số sánh(ra, d, ô nhớ, 11, dùng thành ghi); }
                ca "BranchZero": {
                    nếu (d == 0 || số < 0 || số >= máy ảo lấy độ dài(lệnh)) { ném "ARM64 branch không hợp lệ"; };
                    nguồn = 9;
                    nếu (dùng thành ghi) { nguồn = mình.biên dịch mã máy aarch64 thành ghi(ô nhớ + d - 1); };
                    mình.biên dịch mã máy aarch64 truy cập(ra, đúng, nguồn, ô nhớ + d - 1, dùng thành ghi);
                    máy ảo thêm cuối danh sách(vá nhánh, {"vị trí": máy ảo lấy độ dài(ra), "đích": số, "điều kiện": đúng, "thanh ghi": nguồn});
                    mình.biên dịch mã máy aarch64 từ máy(ra, biên dịch mã máy từ máy thập lục phân("34000000") + nguồn);
                }
                ca "Jump": {
                    nếu (số < 0 || số >= máy ảo lấy độ dài(lệnh)) { ném "ARM64 jump không hợp lệ"; };
                    máy ảo thêm cuối danh sách(vá nhánh, {"vị trí": máy ảo lấy độ dài(ra), "đích": số, "điều kiện": sai});
                    biên dịch mã máy thêm thập lục phân(ra, "14000000", đúng);
                }
                ca "Call": {
                    nếu (số < 0 || d < số || mã phép toán["symbol"] == "") {
                        ném "ARM64 call thiếu arguments/symbol";
                    };
                    trực tiếp = số;
                    nếu (trực tiếp > 8) { trực tiếp = 8; };
                    lặp (n = 0; n < trực tiếp; n++) {
                        mình.biên dịch mã máy aarch64 truy cập(ra, đúng, n, ô nhớ + d - số + n, sai);
                    };
                    vượt = số - trực tiếp;
                    nếu (vượt > (2147483647 - 16) / bước tham số) {
                        ném "ARM64 call stack quá lớn";
                    };
                    kích cỡ = ((vượt * bước tham số + 15) / 16) * 16;
                    mình.biên dịch mã máy aarch64 điều chỉnh con trỏ ngăn xếp(ra, kích cỡ, đúng);
                    lặp (n = 8; n < số; n++) {
                        mình.biên dịch mã máy aarch64 truy cập byte(ra, đúng, 9,
                            kích cỡ + (ô nhớ + d - số + n) * 4);
                        mình.biên dịch mã máy aarch64 truy cập byte(ra, sai, 9, (n - 8) * bước tham số);
                    };
                    máy ảo thêm cuối danh sách(tái định vị, {"offset": máy ảo lấy độ dài(ra), "symbol": mã phép toán["symbol"]});
                    biên dịch mã máy thêm thập lục phân(ra, "94000000", đúng);
                    mình.biên dịch mã máy aarch64 điều chỉnh con trỏ ngăn xếp(ra, kích cỡ, sai);
                    mình.biên dịch mã máy aarch64 truy cập(ra, sai, 0, ô nhớ + d - số, sai);
                }
                ca "Return": {
                    nếu (d == 0) { ném "ARM64 return không có giá trị"; };
                    mình.biên dịch mã máy aarch64 truy cập(ra, đúng, 0, ô nhớ + d - 1, dùng thành ghi);
                    nếu (khung > 0) {
                        mình.biên dịch mã máy aarch64 điều chỉnh con trỏ ngăn xếp(ra, khung, sai);
                    };
                    nếu (!dùng thành ghi) { biên dịch mã máy thêm thập lục phân(ra, "a8c17bfd", đúng); };
                    biên dịch mã máy thêm thập lục phân(ra, "d65f03c0", đúng);
                }
                ca "Trap": { biên dịch mã máy thêm thập lục phân(ra, "d4200000", đúng); }
                mặc định: { ném "AArch64 MachineOpcode C++ chưa định nghĩa: " + mã; }
            };
        };
        lặp (i = 0; i < máy ảo lấy độ dài(vá nhánh); i++) {
            f = vá nhánh[i];
            byte đích = vị trí lệnh[f["đích"]];
            chênh = byte đích - f["vị trí"];
            nếu (chênh % 4 != 0) { ném "ARM64 branch không căn theo word"; };
            từ máy chênh = chênh / 4;
            biểu thức điều kiện = f["điều kiện"];
            phạm vi = 33554432;
            mô đun = 67108864;
            cơ sở = biên dịch mã máy từ máy thập lục phân("14000000");
            hệ số = 1;
            nếu (biểu thức điều kiện) {
                phạm vi = 262144;
                mô đun = 524288;
                cơ sở = biên dịch mã máy từ máy thập lục phân("34000000") + f["thanh ghi"];
                hệ số = 32;
            };
            nếu (từ máy chênh < -phạm vi || từ máy chênh >= phạm vi) {
                ném "ARM64 branch vượt giới hạn ISA";
            };
            giá trị = từ máy chênh % mô đun;
            nếu (giá trị < 0) { giá trị += mô đun; };
            byte vá = [];
            mình.biên dịch mã máy aarch64 từ máy(byte vá, cơ sở + giá trị * hệ số);
            lặp (n = 0; n < 4; n++) { ra[f["vị trí"] + n] = byte vá[n]; };
        };
        trả về {"bytes": ra, "relocations": tái định vị};
    };

    hàm riêng tư biên dịch mã máy aarch64 phép tính(ra, d, ô nhớ, cơ sở, dùng thành ghi) {
        nếu (d < 2) { ném "ARM64 binary stack underflow"; };
        trái = 9;
        phải = 10;
        nếu (dùng thành ghi) {
            trái = mình.biên dịch mã máy aarch64 thành ghi(ô nhớ + d - 2);
            phải = mình.biên dịch mã máy aarch64 thành ghi(ô nhớ + d - 1);
        };
        mình.biên dịch mã máy aarch64 truy cập(ra, đúng, trái, ô nhớ + d - 2, dùng thành ghi);
        mình.biên dịch mã máy aarch64 truy cập(ra, đúng, phải, ô nhớ + d - 1, dùng thành ghi);
        mình.biên dịch mã máy aarch64 từ máy(ra,
            biên dịch mã máy từ máy thập lục phân(cơ sở) + phải * 65536 + trái * 32 + trái);
        mình.biên dịch mã máy aarch64 truy cập(ra, sai, trái, ô nhớ + d - 2, dùng thành ghi);
    };

    hàm riêng tư biên dịch mã máy aarch64 số sánh(ra, d, ô nhớ, biểu thức điều kiện ngược, dùng thành ghi) {
        nếu (d < 2) { ném "ARM64 binary stack underflow"; };
        trái = 9;
        phải = 10;
        nếu (dùng thành ghi) {
            trái = mình.biên dịch mã máy aarch64 thành ghi(ô nhớ + d - 2);
            phải = mình.biên dịch mã máy aarch64 thành ghi(ô nhớ + d - 1);
        };
        mình.biên dịch mã máy aarch64 truy cập(ra, đúng, trái, ô nhớ + d - 2, dùng thành ghi);
        mình.biên dịch mã máy aarch64 truy cập(ra, đúng, phải, ô nhớ + d - 1, dùng thành ghi);
        mình.biên dịch mã máy aarch64 từ máy(ra, biên dịch mã máy từ máy thập lục phân("6b00001f") + phải * 65536 + trái * 32);
        mình.biên dịch mã máy aarch64 từ máy(ra, biên dịch mã máy từ máy thập lục phân("1a9f07e0") + biểu thức điều kiện ngược * 4096 + trái);
        mình.biên dịch mã máy aarch64 truy cập(ra, sai, trái, ô nhớ + d - 2, dùng thành ghi);
    };
};


hàm công khai biên dịch mã máy phát aarch64(loại, hằng, thấp, cao, ít, hệ điều hành) {
    bộ chuyển tiếp = Bộ Phát AARCH64();
    trả về bộ chuyển tiếp.biên dịch mã máy phát aarch64(loại, hằng, thấp, cao, ít, hệ điều hành);
};

hàm công khai biên dịch mã máy phát aarch64 hàm(danh sách hàm biểu diễn trung gian, hệ điều hành = "linux") {
    bộ chuyển tiếp = Bộ Phát AARCH64();
    trả về bộ chuyển tiếp.biên dịch mã máy phát aarch64 hàm(danh sách hàm biểu diễn trung gian, hệ điều hành);
};

