            giá trị = từ máy chênh % mô đun;
            nếu (giá trị < 0) { giá trị += mô đun; };
            byte vá = [];
            mình.biên dịch mã máy aarch64 từ máy(byte vá, cơ sở + giá trị * hệ số);
            lặp (n = 0; n < 4; n++) { ra[f["vị trí"] + n] = byte vá[n]; };
        };
        trả về {"bytes": ra, "relocations": tái định vị};
    };

    hàm riêng tư biên dịch mã máy aarch64 phép chia(ra, d, ô nhớ, dùng thành ghi) {
        nếu (d < 2) { ném "ARM64 division stack underflow"; };
        trái = 9;
        phải = 10;
        nếu (dùng thành ghi) {
            trái = mình.biên dịch mã máy aarch64 thành ghi(ô nhớ + d - 2);
            phải = mình.biên dịch mã máy aarch64 thành ghi(ô nhớ + d - 1);
        };
        mình.biên dịch mã máy aarch64 truy cập(ra, đúng, trái, ô nhớ + d - 2, dùng thành ghi);
        mình.biên dịch mã máy aarch64 truy cập(ra, đúng, phải, ô nhớ + d - 1, dùng thành ghi);
        // CBNZ divisor,+12; MOVN result,#0; B +8; SDIV result,left,right.
        // Chia 0 trả -1, và ARM SDIV giữ INT32_MIN/-1 ở INT32_MIN.
        mình.biên dịch mã máy aarch64 từ máy(ra,
            biên dịch mã máy từ máy thập lục phân("35000060") + phải);
        mình.biên dịch mã máy aarch64 từ máy(ra,
            biên dịch mã máy từ máy thập lục phân("12800000") + trái);
        mình.biên dịch mã máy aarch64 từ máy(ra,
            biên dịch mã máy từ máy thập lục phân("14000002"));
        mình.biên dịch mã máy aarch64 từ máy(ra,
            biên dịch mã máy từ máy thập lục phân("1ac00c00") + phải * 65536 + trái * 32 + trái);
        mình.biên dịch mã máy aarch64 truy cập(ra, sai, trái, ô nhớ + d - 2, dùng thành ghi);
    };

    hàm riêng tư biên dịch mã máy aarch64 phép dư(ra, d, ô nhớ, dùng thành ghi) {
        nếu (d < 2) { ném "ARM64 remainder stack underflow"; };
        trái = 9;
        phải = 10;
        thương = 11;
        nếu (dùng thành ghi) {
            trái = mình.biên dịch mã máy aarch64 thành ghi(ô nhớ + d - 2);
            phải = mình.biên dịch mã máy aarch64 thành ghi(ô nhớ + d - 1);
            thương = 9; // W9 không nằm trong tập register allocation.
        };
        mình.biên dịch mã máy aarch64 truy cập(ra, đúng, trái, ô nhớ + d - 2, dùng thành ghi);
        mình.biên dịch mã máy aarch64 truy cập(ra, đúng, phải, ô nhớ + d - 1, dùng thành ghi);
        // CBNZ divisor,+12; MOVN left,#0; B +12;
        // SDIV quotient,left,right; MSUB left,quotient,right,left.
        // INT32_MIN % -1 = 0, chia 0 = -1.
        mình.biên dịch mã máy aarch64 từ máy(ra,
            biên dịch mã máy từ máy thập lục phân("35000060") + phải);
        mình.biên dịch mã máy aarch64 từ máy(ra,
            biên dịch mã máy từ máy thập lục phân("12800000") + trái);
        mình.biên dịch mã máy aarch64 từ máy(ra,
            biên dịch mã máy từ máy thập lục phân("14000003"));
        mình.biên dịch mã máy aarch64 từ máy(ra,
            biên dịch mã máy từ máy thập lục phân("1ac00c00") + phải * 65536 + trái * 32 + thương);
        mình.biên dịch mã máy aarch64 từ máy(ra,
            biên dịch mã máy từ máy thập lục phân("1b008000") + phải * 65536 + trái * 1024 + thương * 32 + trái);
        mình.biên dịch mã máy aarch64 truy cập(ra, sai, trái, ô nhớ + d - 2, dùng thành ghi);
    };

    hàm riêng tư biên dịch mã máy aarch64 phép tính(ra, d, ô nhớ, cơ sở, dùng thành ghi, nguồn trái = -1, nguồn phải = -1, đích ghi = -1, hằng nhỏ = -1, có hằng lớn = sai, hằng lớn = 0, có hằng giữ = sai, hằng giữ = 0) {
        nếu (d < 2) { ném "ARM64 binary stack underflow"; };
        trái = 9;
        phải = 10;
        nếu (dùng thành ghi) {
            trái = mình.biên dịch mã máy aarch64 thành ghi(ô nhớ + d - 2);
            phải = mình.biên dịch mã máy aarch64 thành ghi(ô nhớ + d - 1);
        };
        đích = trái;
        nếu (đích ghi >= 0) { đích = mình.biên dịch mã máy aarch64 thành ghi(đích ghi); };
        nếu (hằng nhỏ >= 0 && nguồn trái >= 0 && dùng thành ghi) {
            nguồn = mình.biên dịch mã máy aarch64 thành ghi(nguồn trái);
            nền = biên dịch mã máy từ máy thập lục phân("11000000");
            nếu (cơ sở == "4b000000") { nền = biên dịch mã máy từ máy thập lục phân("51000000"); };
            mình.biên dịch mã máy aarch64 từ máy(ra, nền + hằng nhỏ * 1024 + nguồn * 32 + đích);
            trả về;
        };
        nếu (có hằng lớn && nguồn trái >= 0 && dùng thành ghi) {
            trái = mình.biên dịch mã máy aarch64 thành ghi(nguồn trái);
            phải = 9;
            nếu (có hằng giữ && hằng lớn == hằng giữ) { phải = 10; }
            hoặc { mình.biên dịch mã máy aarch64 nạp hằng(ra, phải, hằng lớn); };
            mình.biên dịch mã máy aarch64 từ máy(ra,
                biên dịch mã máy từ máy thập lục phân(cơ sở) + phải * 65536 + trái * 32 + đích);
            trả về;
        };
        nếu (dùng thành ghi && nguồn trái >= 0 && nguồn phải >= 0) {
            trái = mình.biên dịch mã máy aarch64 thành ghi(nguồn trái);
            phải = mình.biên dịch mã máy aarch64 thành ghi(nguồn phải);
        } hoặc {
            mình.biên dịch mã máy aarch64 truy cập(ra, đúng, trái, ô nhớ + d - 2, dùng thành ghi);
            mình.biên dịch mã máy aarch64 truy cập(ra, đúng, phải, ô nhớ + d - 1, dùng thành ghi);
        };
        mình.biên dịch mã máy aarch64 từ máy(ra,
            biên dịch mã máy từ máy thập lục phân(cơ sở) + phải * 65536 + trái * 32 + đích);
        nếu (đích ghi < 0) {
            mình.biên dịch mã máy aarch64 truy cập(ra, sai, đích, ô nhớ + d - 2, dùng thành ghi);
        };
    };

    hàm riêng tư biên dịch mã máy aarch64 số sánh(ra, d, ô nhớ, biểu thức điều kiện ngược, dùng thành ghi, bỏ boolean = sai, nguồn trái = -1, nguồn phải = -1, đích ghi = -1, có hằng = sai, hằng = 0, có hằng giữ = sai, hằng giữ = 0) {
        nếu (d < 2) { ném "ARM64 binary stack underflow"; };
        trái = 9;
        phải = 10;
        nếu (dùng thành ghi) {
            trái = mình.biên dịch mã máy aarch64 thành ghi(ô nhớ + d - 2);
            phải = mình.biên dịch mã máy aarch64 thành ghi(ô nhớ + d - 1);
        };
        đích = trái;
        nếu (đích ghi >= 0) { đích = mình.biên dịch mã máy aarch64 thành ghi(đích ghi); };
        so sánh tức thời = sai;
        nếu (dùng thành ghi && nguồn trái >= 0 && có hằng) {
            trái = mình.biên dịch mã máy aarch64 thành ghi(nguồn trái);
            nếu (hằng >= 0 && hằng <= 4095) {
                so sánh tức thời = đúng;
            } hoặc {
                phải = 9; // Scratch W9 không thuộc tập thanh ghi của slot.
                nếu (có hằng giữ && hằng == hằng giữ) { phải = 10; }
                hoặc { mình.biên dịch mã máy aarch64 nạp hằng(ra, phải, hằng); };
            };
        } hoặc nếu (dùng thành ghi && nguồn trái >= 0 && nguồn phải >= 0) {
            trái = mình.biên dịch mã máy aarch64 thành ghi(nguồn trái);
            phải = mình.biên dịch mã máy aarch64 thành ghi(nguồn phải);
        } hoặc {
            mình.biên dịch mã máy aarch64 truy cập(ra, đúng, trái, ô nhớ + d - 2, dùng thành ghi);
            mình.biên dịch mã máy aarch64 truy cập(ra, đúng, phải, ô nhớ + d - 1, dùng thành ghi);
        };
        nếu (so sánh tức thời) {
            mình.biên dịch mã máy aarch64 từ máy(ra,
                biên dịch mã máy từ máy thập lục phân("7100001f") + hằng * 1024 + trái * 32);
        } hoặc {
            mình.biên dịch mã máy aarch64 từ máy(ra, biên dịch mã máy từ máy thập lục phân("6b00001f") + phải * 65536 + trái * 32);
        };
        nếu (!bỏ boolean) {
            mình.biên dịch mã máy aarch64 từ máy(ra, biên dịch mã máy từ máy thập lục phân("1a9f07e0") + biểu thức điều kiện ngược * 4096 + đích);
            nếu (đích ghi < 0) {
                mình.biên dịch mã máy aarch64 truy cập(ra, sai, đích, ô nhớ + d - 2, dùng thành ghi);
            };
        };
    };
};


hàm công khai biên dịch mã máy phát aarch64(loại, hằng, thấp, cao, ít, hệ điều hành) {
    bộ chuyển tiếp = Bộ Phát AARCH64();
    trả về bộ chuyển tiếp.biên dịch mã máy phát aarch64(loại, hằng, thấp, cao, ít, hệ điều hành);
};

hàm công khai biên dịch mã máy phát aarch64 hàm(danh sách hàm biểu diễn trung gian, hệ điều hành = "linux") {
    bộ chuyển tiếp = Bộ Phát AARCH64();
    trả về bộ chuyển tiếp.biên dịch mã máy phát aarch64 hàm(danh sách hàm biểu diễn trung gian, hệ điều hành);
};

