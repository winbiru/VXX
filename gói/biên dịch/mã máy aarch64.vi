// aarch64: phát byte mã máy kiến trúc riêng.
// Các phép chưa hỗ trợ phải ném lỗi tại bộ chọn lowering, không phát mã sai.
nhập gói.biên dịch.mã máy nền.biên dịch mã máy từ máy thập lục phân;
nhập gói.biên dịch.mã máy nền.biên dịch mã máy thêm từ máy;
nhập gói.biên dịch.mã máy nền.biên dịch mã máy thêm thập lục phân;
nhập gói.biên dịch.mã máy nền.biên dịch mã máy trả về;

// Lớp sở hữu toàn bộ thuật toán của mô-đun; các hàm bên dưới chỉ giữ API cũ.
lớp công khai Bộ Phát AARCH64 {
    hàm công khai khởi tạo() {};

    hàm công khai biên dịch mã máy phát aarch64(loại, hằng, thấp, cao, ít, hệ điều hành) {
        ra = [];
        nếu (loại == "hằng") {
                        biên dịch mã máy thêm từ máy(ra, biên dịch mã máy từ máy thập lục phân("52800000") + thấp * 32, ít);
                        biên dịch mã máy thêm từ máy(ra, biên dịch mã máy từ máy thập lục phân("72a00000") + cao * 32, ít);
                    } hoặc {
                        nếu (loại == "cộng") { biên dịch mã máy thêm thập lục phân(ra, "0b010000", ít); }
                        hoặc { biên dịch mã máy thêm thập lục phân(ra, "4b010000", ít); };
                    };
                    biên dịch mã máy thêm thập lục phân(ra, "d65f03c0", ít);
        trả về ra;
    };

    // Machine IR i32: byte emitter thuần V++ tương ứng chính xác với
    // emitAArch64Function trong src/native/aarch64_codegen.cpp.
    // Input gồm {"parameterCount", "slotCount", "maxStackDepth", "instructions"};
    // mỗi lệnh gồm {"opcode", "immediate", "operand", "depthBefore", "symbol"}.
    // Không nhận IR động/không có kiểu; relocation CALL để object writer xử lý.
    hàm riêng tư biên dịch mã máy aarch64 từ máy(ra, từ máy) {
        biên dịch mã máy thêm từ máy(ra, từ máy, đúng);
    };

    // Ánh xạ cố định qua mọi nhánh/vòng lặp; bỏ qua scratch W9/W10.
    // Chỉ dùng W0..W17, không chạm W18 của nền tảng hoặc callee-saved W19+.
    hàm riêng tư biên dịch mã máy aarch64 thành ghi(ô nhớ) {
        nếu (ô nhớ < 9) { trả về ô nhớ; };
        trả về ô nhớ + 2;
    };

    hàm riêng tư biên dịch mã máy aarch64 chuyển(ra, đích, nguồn) {
        nếu (đích != nguồn) {
            mình.biên dịch mã máy aarch64 từ máy(ra,
                biên dịch mã máy từ máy thập lục phân("2a0003e0") + nguồn * 65536 + đích);
        };
    };

    hàm riêng tư biên dịch mã máy aarch64 nạp hằng(ra, đích, giá trị) {
        nửa = biên dịch mã máy trả về(giá trị);
        mình.biên dịch mã máy aarch64 từ máy(ra,
            biên dịch mã máy từ máy thập lục phân("52800000") + nửa["lo"] * 32 + đích);
        nếu (nửa["hi"] != 0) {
            mình.biên dịch mã máy aarch64 từ máy(ra,
                biên dịch mã máy từ máy thập lục phân("72a00000") + nửa["hi"] * 32 + đích);
        };
    };

    hàm riêng tư biên dịch mã máy aarch64 điều chỉnh con trỏ ngăn xếp(ra, các byte, trừ) {
        còn = các byte;
        lặp (i = 0; i < các byte; i += 4095) {
            bước = còn;
            nếu (bước > 4095) { bước = 4095; };
            nền = biên dịch mã máy từ máy thập lục phân("910003ff");
            nếu (trừ) { nền = biên dịch mã máy từ máy thập lục phân("d10003ff"); };
            mình.biên dịch mã máy aarch64 từ máy(ra, nền + bước * 1024);
            còn -= bước;
        };
    };

    hàm riêng tư biên dịch mã máy aarch64 truy cập byte(ra, tải, thành ghi, độ lệch) {
        nếu (độ lệch < 0 || độ lệch > 2147483647 || độ lệch % 4 != 0) {
            ném "AArch64: offset stack không hợp lệ";
        };
        cơ sở = biên dịch mã máy từ máy thập lục phân("b9000000");
        nếu (tải) { cơ sở = biên dịch mã máy từ máy thập lục phân("b9400000"); };
        nếu (độ lệch <= 16380) {
            mình.biên dịch mã máy aarch64 từ máy(ra, cơ sở + độ lệch * 256 + 992 + thành ghi);
            trả về;
        };
        mình.biên dịch mã máy aarch64 từ máy(ra, biên dịch mã máy từ máy thập lục phân("910003eb"));
        còn = độ lệch;
        lặp (i = 0; i < độ lệch; i += 4095) {
            bước = còn;
            nếu (bước > 4095) { bước = 4095; };
            mình.biên dịch mã máy aarch64 từ máy(ra,
                biên dịch mã máy từ máy thập lục phân("9100016b") + bước * 1024);
            còn -= bước;
        };
        mình.biên dịch mã máy aarch64 từ máy(ra, cơ sở + 352 + thành ghi);
    };

    // LDR/STR cho fallback; MOV cho hàm lá vừa đủ thanh ghi.
    hàm riêng tư biên dịch mã máy aarch64 truy cập(ra, tải, thành ghi, ô nhớ, dùng thành ghi) {
        nếu (ô nhớ < 0 || thành ghi < 0 || thành ghi > 31) {
            ném "AArch64: slot hoặc thanh ghi ngoài frame";
        };
        nếu (dùng thành ghi) {
            vị trí = mình.biên dịch mã máy aarch64 thành ghi(ô nhớ);
            nếu (tải) { mình.biên dịch mã máy aarch64 chuyển(ra, thành ghi, vị trí); }
            hoặc { mình.biên dịch mã máy aarch64 chuyển(ra, vị trí, thành ghi); };
            trả về;
        };
        mình.biên dịch mã máy aarch64 truy cập byte(ra, tải, thành ghi, ô nhớ * 4);
    };

    // Nhận IR đã được CFG validator kiểm tra depth tại các điểm nối.
    // Branch target là chỉ số lệnh; kết quả offset và relocation là byte offset.
    hàm công khai biên dịch mã máy phát aarch64 hàm(danh sách hàm biểu diễn trung gian, hệ điều hành = "linux") {
        tham số = danh sách hàm biểu diễn trung gian["parameterCount"];
        ô nhớ = danh sách hàm biểu diễn trung gian["slotCount"];
        sâu nhất = danh sách hàm biểu diễn trung gian["maxStackDepth"];
        lệnh = danh sách hàm biểu diễn trung gian["instructions"];
        nếu (tham số < 0 || ô nhớ < tham số || ô nhớ < 0 ||
            sâu nhất < 0 || ô nhớ + sâu nhất > 134217724 || máy ảo lấy độ dài(lệnh) == 0) {
            ném "AArch64 machine IR/frame không hợp lệ";
        };
        khung = ((4 * (ô nhớ + sâu nhất) + 15) / 16) * 16;
        bước tham số = 8;
        nếu (hệ điều hành == "macos") { bước tham số = 4; };
        dùng thành ghi = tham số <= 8 && ô nhớ + sâu nhất <= 16;
        lặp (i = 0; i < máy ảo lấy độ dài(lệnh); i++) {
            nếu (lệnh[i]["opcode"] == "Call") { dùng thành ghi = sai; };
        };
        // Chỉ ghép CMP + BranchZero khi BranchZero không phải đích nhảy
        // độc lập. Nếu có nhánh khác đi vào, giá trị bool vẫn cần tồn tại.
        đích nhảy = [];
        ghép nhánh = [];
        lặp (i = 0; i < máy ảo lấy độ dài(lệnh); i++) {
            máy ảo thêm cuối danh sách(đích nhảy, sai);
            máy ảo thêm cuối danh sách(ghép nhánh, -1);
        };
        lặp (i = 0; i < máy ảo lấy độ dài(lệnh); i++) {
            op = lệnh[i];
            nếu ((op["opcode"] == "Jump" || op["opcode"] == "BranchZero") &&
                op["operand"] >= 0 && op["operand"] < máy ảo lấy độ dài(lệnh)) {
                đích nhảy[op["operand"]] = đúng;
            };
        };
        lặp (i = 0; i + 1 < máy ảo lấy độ dài(lệnh); i++) {
            hiện tại = lệnh[i];
            sau = lệnh[i + 1];
            mã ghép = -1;
            chọn (hiện tại["opcode"]) {
                ca "Equal": { mã ghép = 1; }
                ca "NotEqual": { mã ghép = 0; }
                ca "Less": { mã ghép = 10; }
                ca "LessEqual": { mã ghép = 12; }
                ca "Greater": { mã ghép = 13; }
                ca "GreaterEqual": { mã ghép = 11; }
            };
            nếu (mã ghép >= 0 && hiện tại["depthBefore"] >= 2 &&
                sau["opcode"] == "BranchZero" &&
                sau["depthBefore"] == hiện tại["depthBefore"] - 1 &&
                !đích nhảy[i + 1]) {
                ghép nhánh[i] = mã ghép;
                ghép nhánh[i + 1] = mã ghép;
            };
        };
        // LoadSlot(a), LoadSlot(b), phép nhị phân: đọc trực tiếp hai slot
        // bằng thanh ghi. Chỉ áp dụng nếu không có cạnh CFG vào giữa bộ ba.
        bỏ nạp = [];
        nguồn trái trực tiếp = [];
        nguồn phải trực tiếp = [];
        hằng trực tiếp = [];
        có hằng phép tính = [];
        hằng phép tính = [];
        có hằng so sánh = [];
        hằng so sánh = [];
        lặp (i = 0; i < máy ảo lấy độ dài(lệnh); i++) {
            máy ảo thêm cuối danh sách(bỏ nạp, sai);
            máy ảo thêm cuối danh sách(nguồn trái trực tiếp, -1);
            máy ảo thêm cuối danh sách(nguồn phải trực tiếp, -1);
            máy ảo thêm cuối danh sách(hằng trực tiếp, -1);
            máy ảo thêm cuối danh sách(có hằng phép tính, sai);
            máy ảo thêm cuối danh sách(hằng phép tính, 0);
            máy ảo thêm cuối danh sách(có hằng so sánh, sai);
            máy ảo thêm cuối danh sách(hằng so sánh, 0);
        };
        nếu (dùng thành ghi) {
            lặp (i = 0; i + 2 < máy ảo lấy độ dài(lệnh); i++) {
                a = lệnh[i];
                b = lệnh[i + 1];
                c = lệnh[i + 2];
                toán tử = c["opcode"];
                là nhị phân = toán tử == "Add" || toán tử == "Sub" || toán tử == "Mul" ||
                    toán tử == "Equal" || toán tử == "NotEqual" || toán tử == "Less" ||
                    toán tử == "LessEqual" || toán tử == "Greater" || toán tử == "GreaterEqual";
                nếu (a["opcode"] == "LoadSlot" && b["opcode"] == "LoadSlot" &&
                    là nhị phân && !đích nhảy[i + 1] && !đích nhảy[i + 2] &&
                    a["operand"] >= 0 && a["operand"] < ô nhớ &&
                    b["operand"] >= 0 && b["operand"] < ô nhớ &&
                    a["depthBefore"] >= 0 && a["depthBefore"] + 1 < sâu nhất &&
                    b["depthBefore"] == a["depthBefore"] + 1 &&
                    c["depthBefore"] == b["depthBefore"] + 1) {
                    bỏ nạp[i] = đúng;
                    bỏ nạp[i + 1] = đúng;
                    nguồn trái trực tiếp[i + 2] = a["operand"];
                    nguồn phải trực tiếp[i + 2] = b["operand"];
                };
                // ADD/SUB imm12 dùng trực tiếp slot nguồn và hằng 0..4095.
                nếu (a["opcode"] == "LoadSlot" && b["opcode"] == "PushConstant" &&
                    (toán tử == "Add" || toán tử == "Sub") &&
                    !đích nhảy[i + 1] && !đích nhảy[i + 2] &&
                    a["operand"] >= 0 && a["operand"] < ô nhớ &&
                    b["immediate"] >= 0 && b["immediate"] <= 4095 &&
                    a["depthBefore"] >= 0 && a["depthBefore"] + 1 < sâu nhất &&
                    b["depthBefore"] == a["depthBefore"] + 1 &&
                    c["depthBefore"] == b["depthBefore"] + 1) {
                    bỏ nạp[i] = đúng;
                    bỏ nạp[i + 1] = đúng;
                    nguồn trái trực tiếp[i + 2] = a["operand"];
                    hằng trực tiếp[i + 2] = b["immediate"];
                };
                // Hằng ngoài imm12 vẫn bỏ được MOV qua eval-stack register.
                nếu (a["opcode"] == "LoadSlot" && b["opcode"] == "PushConstant" &&
                    (toán tử == "Add" || toán tử == "Sub") &&
                    (b["immediate"] < 0 || b["immediate"] > 4095) &&
                    !đích nhảy[i + 1] && !đích nhảy[i + 2] &&
                    a["operand"] >= 0 && a["operand"] < ô nhớ &&
                    a["depthBefore"] >= 0 && a["depthBefore"] + 1 < sâu nhất &&
                    b["depthBefore"] == a["depthBefore"] + 1 &&
                    c["depthBefore"] == b["depthBefore"] + 1) {
                    bỏ nạp[i] = đúng;
                    bỏ nạp[i + 1] = đúng;
                    nguồn trái trực tiếp[i + 2] = a["operand"];
                    có hằng phép tính[i + 2] = đúng;
                    hằng phép tính[i + 2] = b["immediate"];
                };
                // CMP đọc slot trực tiếp, dùng CMP imm12 hoặc W9 làm scratch.
                là so sánh = toán tử == "Equal" || toán tử == "NotEqual" ||
                    toán tử == "Less" || toán tử == "LessEqual" ||
                    toán tử == "Greater" || toán tử == "GreaterEqual";
                nếu (a["opcode"] == "LoadSlot" && b["opcode"] == "PushConstant" &&
                    là so sánh && !đích nhảy[i + 1] && !đích nhảy[i + 2] &&
                    a["operand"] >= 0 && a["operand"] < ô nhớ &&
                    a["depthBefore"] >= 0 && a["depthBefore"] + 1 < sâu nhất &&
                    b["depthBefore"] == a["depthBefore"] + 1 &&
                    c["depthBefore"] == b["depthBefore"] + 1) {
                    bỏ nạp[i] = đúng;
                    bỏ nạp[i + 1] = đúng;
                    nguồn trái trực tiếp[i + 2] = a["operand"];
                    có hằng so sánh[i + 2] = đúng;
                    hằng so sánh[i + 2] = b["immediate"];
                };
            };
        };
        // W10 không được ánh xạ thành slot, và ở hàm lá không có CALL.
        // Giữ một hằng tải lặp lại trong vùng back-edge, tránh nạp lại
        // hằng ở mỗi vòng; các phép khác dùng W9 nếu cần scratch.
        trong vòng = [];
        lặp (i = 0; i < máy ảo lấy độ dài(lệnh); i++) {
            máy ảo thêm cuối danh sách(trong vòng, sai);
        };
        lặp (i = 0; i < máy ảo lấy độ dài(lệnh); i++) {
            op = lệnh[i];
            nếu ((op["opcode"] == "Jump" || op["opcode"] == "BranchZero") &&
                op["operand"] >= 0 && op["operand"] < i) {
                lặp (j = op["operand"]; j <= i; j++) { trong vòng[j] = đúng; };
            };
        };
        có hằng giữ = sai;
        hằng giữ = 0;
        nếu (dùng thành ghi) {
            lặp (i = 0; i < máy ảo lấy độ dài(lệnh); i++) {
                ứng cử = sai;
                giá trị = 0;
                nếu (có hằng phép tính[i]) { ứng cử = đúng; giá trị = hằng phép tính[i]; };
                nếu (có hằng so sánh[i] && (hằng so sánh[i] < 0 || hằng so sánh[i] > 4095)) {
                    ứng cử = đúng; giá trị = hằng so sánh[i];
                };
                nếu (ứng cử && trong vòng[i] && !có hằng giữ) {
                    số lần = 0;
                    lặp (j = 0; j < máy ảo lấy độ dài(lệnh); j++) {
                        nếu (trong vòng[j] &&
                            ((có hằng phép tính[j] && hằng phép tính[j] == giá trị) ||
                             (có hằng so sánh[j] && hằng so sánh[j] == giá trị &&
                              (giá trị < 0 || giá trị > 4095)))) {
                            số lần += 1;
                        };
                    };
                    nếu (số lần >= 2) { có hằng giữ = đúng; hằng giữ = giá trị; };
                };
            };
        };
        // Gộp phép tính hoặc hằng với StoreSlot + Drop: ghi kết quả
        // thẳng vào thanh ghi của biến, không vòng qua ô eval stack.
        bỏ lưu = [];
        đích ghi thẳng = [];
        nguồn gán thẳng = [];
        nguồn trả thẳng = [];
        lặp (i = 0; i < máy ảo lấy độ dài(lệnh); i++) {
            máy ảo thêm cuối danh sách(bỏ lưu, sai);
            máy ảo thêm cuối danh sách(đích ghi thẳng, -1);
            máy ảo thêm cuối danh sách(nguồn gán thẳng, -1);
            máy ảo thêm cuối danh sách(nguồn trả thẳng, -1);
        };
        nếu (dùng thành ghi) {
            lặp (i = 0; i + 2 < máy ảo lấy độ dài(lệnh); i++) {
                a = lệnh[i];
                b = lệnh[i + 1];
                c = lệnh[i + 2];
                mã ghi = a["opcode"];
                có kết quả = mã ghi == "PushConstant" || mã ghi == "Add" ||
                    mã ghi == "Sub" || mã ghi == "Mul" || mã ghi == "Equal" ||
                    mã ghi == "NotEqual" || mã ghi == "Less" ||
                    mã ghi == "LessEqual" || mã ghi == "Greater" || mã ghi == "GreaterEqual";
                nếu (b["opcode"] == "StoreSlot" && c["opcode"] == "Drop" &&
                    !đích nhảy[i + 1] && !đích nhảy[i + 2] &&
                    b["operand"] >= 0 && b["operand"] < ô nhớ &&
                    b["depthBefore"] == c["depthBefore"] &&
                    b["depthBefore"] >= 1) {
                    nếu (có kết quả &&
                        ((mã ghi == "PushConstant" && a["depthBefore"] + 1 == b["depthBefore"]) ||
                         (mã ghi != "PushConstant" && a["depthBefore"] - 1 == b["depthBefore"]))) {
                        đích ghi thẳng[i] = b["operand"];
                        bỏ lưu[i + 1] = đúng;
                    };
                    nếu (mã ghi == "LoadSlot" && a["depthBefore"] + 1 == b["depthBefore"] &&
                        a["operand"] >= 0 && a["operand"] < ô nhớ && !bỏ nạp[i]) {
                        bỏ nạp[i] = đúng;
                        nguồn gán thẳng[i + 1] = a["operand"];
                    };
                };
            };
            lặp (i = 0; i + 1 < máy ảo lấy độ dài(lệnh); i++) {
                a = lệnh[i];
                b = lệnh[i + 1];
                nếu (a["opcode"] == "LoadSlot" && b["opcode"] == "Return" &&
                    !đích nhảy[i + 1] && !bỏ nạp[i] &&
                    a["operand"] >= 0 && a["operand"] < ô nhớ &&
                    b["depthBefore"] == a["depthBefore"] + 1) {
                    bỏ nạp[i] = đúng;
                    nguồn trả thẳng[i + 1] = a["operand"];
                };
            };
        };
        nếu (dùng thành ghi) { khung = 0; };
        ra = [];
        tái định vị = [];
        vá nhánh = [];
        vị trí lệnh = [];

        nếu (!dùng thành ghi) {
            biên dịch mã máy thêm thập lục phân(ra, "a9bf7bfd", đúng);
            biên dịch mã máy thêm thập lục phân(ra, "910003fd", đúng);
        };
        nếu (khung > 0) {
            mình.biên dịch mã máy aarch64 điều chỉnh con trỏ ngăn xếp(ra, khung, đúng);
        };
        lặp (i = 0; i < tham số; i++) {
            nếu (i < 8) {
                mình.biên dịch mã máy aarch64 truy cập(ra, sai, i, i, dùng thành ghi);
            } hoặc {
                mình.biên dịch mã máy aarch64 truy cập byte(ra, đúng, 9, khung + 16 + (i - 8) * bước tham số);
                mình.biên dịch mã máy aarch64 truy cập(ra, sai, 9, i, sai);
            };
        };
        nếu (có hằng giữ) { mình.biên dịch mã máy aarch64 nạp hằng(ra, 10, hằng giữ); };

        lặp (i = 0; i < máy ảo lấy độ dài(lệnh); i++) {
            máy ảo thêm cuối danh sách(vị trí lệnh, máy ảo lấy độ dài(ra));
            mã phép toán = lệnh[i];
            mã = mã phép toán["opcode"];
            d = mã phép toán["depthBefore"];
