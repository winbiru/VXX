                        máy ảo thêm cuối danh sách(vá nhánh, {"vị trí": máy ảo lấy độ dài(ra), "đích": số,
                            "điều kiện": đúng, "nhánh so sánh": đúng, "mã điều kiện": ghép nhánh[i]});
