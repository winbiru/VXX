            } hoặc {
                phải = 9; // Scratch W9 không thuộc tập thanh ghi của slot.
                nếu (có hằng giữ && hằng == hằng giữ) { phải = 10; }
                hoặc { bỏ kết quả = mình.biên dịch mã máy aarch64 nạp hằng(ra, phải, hằng); };
            };
        } hoặc nếu (dùng thành ghi && nguồn trái >= 0 && nguồn phải >= 0) {
            trái = mình.biên dịch mã máy aarch64 thành ghi(nguồn trái, giữ thành ghi);
            phải = mình.biên dịch mã máy aarch64 thành ghi(nguồn phải, giữ thành ghi);
        } hoặc {
            bỏ kết quả = mình.biên dịch mã máy aarch64 truy cập(ra, đúng, trái, ô nhớ + d - 2, dùng thành ghi, giữ thành ghi);
            bỏ kết quả = mình.biên dịch mã máy aarch64 truy cập(ra, đúng, phải, ô nhớ + d - 1, dùng thành ghi, giữ thành ghi);
        };
        nếu (so sánh tức thời) {
            bỏ kết quả = mình.biên dịch mã máy aarch64 từ máy(ra,
                1895825439 + hằng * 1024 + trái * 32);
        } hoặc {
            bỏ kết quả = mình.biên dịch mã máy aarch64 từ máy(ra, 1795162143 + phải * 65536 + trái * 32);
        };
        nếu (!bỏ boolean) {
            bỏ kết quả = mình.biên dịch mã máy aarch64 từ máy(ra, 446629856 + biểu thức điều kiện ngược * 4096 + đích);
            nếu (đích ghi < 0) {
                bỏ kết quả = mình.biên dịch mã máy aarch64 truy cập(ra, sai, đích, ô nhớ + d - 2, dùng thành ghi, giữ thành ghi);
            };
        };
    };
};


hàm công khai biên dịch mã máy phát aarch64(loại, hằng, thấp, cao, ít, hệ điều hành) {
    bộ chuyển tiếp = Bộ Phát AARCH64();
    trả về bộ chuyển tiếp.biên dịch mã máy phát aarch64(loại, hằng, thấp, cao, ít, hệ điều hành);
};

hàm công khai biên dịch mã máy phát aarch64 hàm(danh sách hàm biểu diễn trung gian, hệ điều hành = "linux", phân khối = sai) {
    bộ chuyển tiếp = Bộ Phát AARCH64();
    trả về bộ chuyển tiếp.biên dịch mã máy phát aarch64 hàm(danh sách hàm biểu diễn trung gian, hệ điều hành, phân khối);
};
