                }
                ca "Sub": {
                    mình.biên dịch mã máy aarch64 phép tính(ra, d, ô nhớ, "4b000000", dùng thành ghi, nguồn trái trực tiếp[i], nguồn phải trực tiếp[i], đích ghi thẳng[i], hằng trực tiếp[i], có hằng phép tính[i], hằng phép tính[i], có hằng giữ, hằng giữ);
                }
