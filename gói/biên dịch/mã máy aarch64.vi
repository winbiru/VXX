// aarch64: phát byte mã máy kiến trúc riêng.
// Các phép chưa hỗ trợ phải ném lỗi tại bộ chọn lowering, không phát mã sai.
// Opcode cố định dùng literal i32 để tránh parse hex trong mỗi lệnh phát.
// Quy đổi uint32 hex sang signed i32: 0x52800000 -> 1384120320,
// 0xd65f03c0 -> -698416192. Opcode tính động vẫn dùng helper hex.
nhập gói.biên dịch.mã máy nền.biên dịch mã máy từ máy thập lục phân;
nhập gói.biên dịch.mã máy nền.biên dịch mã máy thêm từ máy;
nhập gói.biên dịch.mã máy nền.biên dịch mã máy trả về;
nhập gói.bộ sưu tập.từ điển.lấy từ điển;

// Lớp sở hữu toàn bộ thuật toán của mô-đun; các hàm bên dưới chỉ giữ API cũ.
lớp công khai Bộ Phát AARCH64 {
    hàm công khai khởi tạo() { mình.phân khối = sai; mình.số byte = 0; };

    hàm công khai biên dịch mã máy phát aarch64(loại, hằng, thấp, cao, ít, hệ điều hành) {
        ra = [];
        nếu (loại == "hằng") {
                        bỏ kết quả = biên dịch mã máy thêm từ máy(ra, 1384120320 + thấp * 32, ít);
                        bỏ kết quả = biên dịch mã máy thêm từ máy(ra, 1923088384 + cao * 32, ít);
                    } hoặc {
                        nếu (loại == "cộng") { bỏ kết quả = biên dịch mã máy thêm từ máy(ra, 184614912, ít); }
                        hoặc { bỏ kết quả = biên dịch mã máy thêm từ máy(ra, 1258356736, ít); };
                    };
                    bỏ kết quả = biên dịch mã máy thêm từ máy(ra, -698416192, ít);
        trả về ra;
    };

    // Machine IR i32: byte emitter thuần V++ tương ứng chính xác với
    // emitAArch64Function trong src/native/aarch64_codegen.cpp.
    // Input gồm {"parameterCount", "slotCount", "maxStackDepth", "instructions"};
    // mỗi lệnh gồm {"opcode", "immediate", "operand", "depthBefore", "symbol"}.
    // Không nhận IR động/không có kiểu; relocation CALL để object writer xử lý.
    // Explicitly discard side-effect call results and use assignment for loop
    // updates: V++ retains expression results for implicit returns. Large IR
    // functions must not accumulate these unused values on the dynamic stack.
    // Direct object output uses 2048-byte blocks (8 KiB reference arrays),
    // avoiding 32 KiB allocations on a fragmented nonmoving heap. All
    // offsets remain byte offsets; the legacy encoder returns a flat list.
    hàm riêng tư biên dịch mã máy aarch64 từ máy(ra, từ máy) {
        đích byte = ra;
        nếu (mình.phân khối) {
            nếu (mình.số byte % 2048 == 0) { bỏ kết quả = máy ảo thêm cuối danh sách(ra, []); };
            đích byte = ra[máy ảo lấy độ dài(ra) - 1];
        };
        bỏ kết quả = máy ảo thêm cuối danh sách(đích byte, từ máy & 255);
        bỏ kết quả = máy ảo thêm cuối danh sách(đích byte, (từ máy >> 8) & 255);
        bỏ kết quả = máy ảo thêm cuối danh sách(đích byte, (từ máy >> 16) & 255);
        bỏ kết quả = máy ảo thêm cuối danh sách(đích byte, (từ máy >> 24) & 255);
        mình.số byte = mình.số byte + 4;
    };

    hàm riêng tư vá từ máy(ra, vị trí, từ máy) {
        đích byte = ra;
        lệch = vị trí;
        nếu (mình.phân khối) {
            đích byte = ra[vị trí / 2048];
            lệch = vị trí % 2048;
        };
        đích byte[lệch] = từ máy & 255;
        đích byte[lệch + 1] = (từ máy >> 8) & 255;
        đích byte[lệch + 2] = (từ máy >> 16) & 255;
        đích byte[lệch + 3] = (từ máy >> 24) & 255;
    };

    // Ánh xạ cố định qua mọi nhánh/vòng lặp; bỏ qua scratch W9/W10.
    // Hàm lá dùng W0..W17. Hàm có lời gọi dùng W19..W28 để giá trị
    // sống qua BL mà không phải đẩy/nạp lại từng ô từ ngăn xếp.
    hàm riêng tư biên dịch mã máy aarch64 thành ghi(ô nhớ, giữ thành ghi = sai) {
        nếu (giữ thành ghi) { trả về 19 + ô nhớ; };
        nếu (ô nhớ < 9) { trả về ô nhớ; };
        trả về ô nhớ + 2;
    };

    hàm riêng tư biên dịch mã máy aarch64 chuyển(ra, đích, nguồn) {
        nếu (đích != nguồn) {
            bỏ kết quả = mình.biên dịch mã máy aarch64 từ máy(ra,
                704644064 + nguồn * 65536 + đích);
        };
    };

    hàm riêng tư biên dịch mã máy aarch64 nạp hằng(ra, đích, giá trị) {
        nửa = biên dịch mã máy trả về(giá trị);
        bỏ kết quả = mình.biên dịch mã máy aarch64 từ máy(ra,
            1384120320 + nửa["lo"] * 32 + đích);
        nếu (nửa["hi"] != 0) {
            bỏ kết quả = mình.biên dịch mã máy aarch64 từ máy(ra,
                1923088384 + nửa["hi"] * 32 + đích);
        };
    };

    hàm riêng tư biên dịch mã máy aarch64 điều chỉnh con trỏ ngăn xếp(ra, các byte, trừ) {
        còn = các byte;
        lặp (i = 0; i < các byte; i += 4095) {
            bước = còn;
            nếu (bước > 4095) { bước = 4095; };
            nền = -1862269953;
            nếu (trừ) { nền = -788528129; };
            bỏ kết quả = mình.biên dịch mã máy aarch64 từ máy(ra, nền + bước * 1024);
            còn -= bước;
        };
    };

    hàm riêng tư biên dịch mã máy aarch64 truy cập byte(ra, tải, thành ghi, độ lệch) {
        nếu (độ lệch < 0 || độ lệch > 2147483647 || độ lệch % 4 != 0) {
            ném "AArch64: offset stack không hợp lệ";
        };
        cơ sở = -1191182336;
        nếu (tải) { cơ sở = -1186988032; };
        nếu (độ lệch <= 16380) {
            bỏ kết quả = mình.biên dịch mã máy aarch64 từ máy(ra, cơ sở + độ lệch * 256 + 992 + thành ghi);
            trả về;
        };
        bỏ kết quả = mình.biên dịch mã máy aarch64 từ máy(ra, -1862269973);
        còn = độ lệch;
        lặp (i = 0; i < độ lệch; i += 4095) {
            bước = còn;
            nếu (bước > 4095) { bước = 4095; };
            bỏ kết quả = mình.biên dịch mã máy aarch64 từ máy(ra,
                -1862270613 + bước * 1024);
            còn -= bước;
        };
        bỏ kết quả = mình.biên dịch mã máy aarch64 từ máy(ra, cơ sở + 352 + thành ghi);
    };

    // LDR/STR cho fallback; MOV cho hàm có đủ thanh ghi.
    hàm riêng tư biên dịch mã máy aarch64 truy cập(ra, tải, thành ghi, ô nhớ, dùng thành ghi, giữ thành ghi = sai) {
        nếu (ô nhớ < 0 || thành ghi < 0 || thành ghi > 31) {
            ném "AArch64: slot hoặc thanh ghi ngoài frame";
        };
        nếu (dùng thành ghi) {
            vị trí = mình.biên dịch mã máy aarch64 thành ghi(ô nhớ, giữ thành ghi);
            nếu (tải) { bỏ kết quả = mình.biên dịch mã máy aarch64 chuyển(ra, thành ghi, vị trí); }
            hoặc { bỏ kết quả = mình.biên dịch mã máy aarch64 chuyển(ra, vị trí, thành ghi); };
            trả về;
        };
        bỏ kết quả = mình.biên dịch mã máy aarch64 truy cập byte(ra, tải, thành ghi, ô nhớ * 4);
    };

    // Nhận IR đã được CFG validator kiểm tra depth tại các điểm nối.
    // Branch target là chỉ số lệnh; kết quả offset và relocation là byte offset.
    hàm công khai biên dịch mã máy phát aarch64 hàm(danh sách hàm biểu diễn trung gian, hệ điều hành = "linux", phân khối = sai) {
        mình.phân khối = phân khối; mình.số byte = 0;
        tham số = danh sách hàm biểu diễn trung gian["parameterCount"];
        ô nhớ = danh sách hàm biểu diễn trung gian["slotCount"];
        sâu nhất = danh sách hàm biểu diễn trung gian["maxStackDepth"];
        lệnh gốc = danh sách hàm biểu diễn trung gian["instructions"];
        số lệnh = máy ảo lấy độ dài(lệnh gốc);
        nếu (tham số < 0 || ô nhớ < tham số || ô nhớ < 0 ||
            sâu nhất < 0 || ô nhớ + sâu nhất > 134217724 || số lệnh == 0) {
            ném "AArch64 machine IR/frame không hợp lệ";
        };
        // Convert dynamic instruction maps once to parallel scalar arrays.
        // Opcode IDs match MachineOpcode in raw_codegen.h; hot passes avoid
        // per-instruction maps, strings, and temporary record allocations.
        // Page each scalar column at 2048 entries: large compiler functions
        // must not request a 128 KiB contiguous reference array from a
        // fragmented nonmoving heap. The output and IR offsets are unchanged.
        lệnh = [];
        hằng lệnh = [];
        toán hạng lệnh = [];
        độ sâu lệnh = [];
        ký hiệu lệnh = [];
        lặp (i = 0; i < số lệnh; i += 1) {
            nếu ((i & 2047) == 0) {
                bỏ kết quả = máy ảo thêm cuối danh sách(lệnh, []);
                bỏ kết quả = máy ảo thêm cuối danh sách(hằng lệnh, []);
                bỏ kết quả = máy ảo thêm cuối danh sách(toán hạng lệnh, []);
                bỏ kết quả = máy ảo thêm cuối danh sách(độ sâu lệnh, []);
                bỏ kết quả = máy ảo thêm cuối danh sách(ký hiệu lệnh, []);
            };
            nguồn = lệnh gốc[i];
            mã = -1;
            chọn (nguồn["opcode"]) {
                ca "PushConstant": { mã = 0; }
                ca "LoadSlot": { mã = 1; }
                ca "StoreSlot": { mã = 2; }
                ca "Drop": { mã = 3; }
                ca "Add": { mã = 4; }
                ca "Sub": { mã = 5; }
                ca "Mul": { mã = 6; }
                ca "Div": { mã = 7; }
                ca "Mod": { mã = 8; }
                ca "Equal": { mã = 9; }
                ca "NotEqual": { mã = 10; }
                ca "Less": { mã = 11; }
                ca "LessEqual": { mã = 12; }
                ca "Greater": { mã = 13; }
                ca "GreaterEqual": { mã = 14; }
                ca "BranchZero": { mã = 15; }
                ca "Jump": { mã = 16; }
                ca "Call": { mã = 17; }
                ca "Return": { mã = 18; }
                ca "Trap": { mã = 19; }
                ca "BitAnd": { mã = 20; }
                ca "BitOr": { mã = 21; }
                ca "BitXor": { mã = 22; }
                ca "ShiftLeft": { mã = 23; }
                ca "ShiftRight": { mã = 24; }
                mặc định: { ném "AArch64: opcode Machine IR không hợp lệ"; }
            };
            bỏ kết quả = máy ảo thêm cuối danh sách(lệnh[i >> 11], mã);
            bỏ kết quả = máy ảo thêm cuối danh sách(hằng lệnh[i >> 11], nguồn["immediate"]);
            bỏ kết quả = máy ảo thêm cuối danh sách(toán hạng lệnh[i >> 11], nguồn["operand"]);
            bỏ kết quả = máy ảo thêm cuối danh sách(độ sâu lệnh[i >> 11], nguồn["depthBefore"]);
            bỏ kết quả = máy ảo thêm cuối danh sách(ký hiệu lệnh[i >> 11], nguồn["symbol"]);
        };
        bước tham số = 8;
        nếu (hệ điều hành == "macos") { bước tham số = 4; };
        có lời gọi = sai;
        lặp (i = 0; i < số lệnh; i += 1) {
            nếu (lệnh[(i) >> 11][(i) & 2047] == 17) { có lời gọi = đúng; };
        };
        giữ thành ghi = có lời gọi && tham số <= 8 && ô nhớ + sâu nhất <= 10;
        dùng thành ghi = giữ thành ghi || (!có lời gọi && tham số <= 8 && ô nhớ + sâu nhất <= 16);
        số thành ghi giữ = 0;
        nếu (giữ thành ghi) { số thành ghi giữ = ô nhớ + sâu nhất; };
        khung = ((4 * (ô nhớ + sâu nhất) + 15) / 16) * 16;
        nếu (giữ thành ghi) { khung = ((8 * số thành ghi giữ + 15) / 16) * 16; }
        hoặc nếu (dùng thành ghi) { khung = 0; };
        // Chỉ ghép CMP + BranchZero khi BranchZero không phải đích nhảy
        // độc lập. Nếu có nhánh khác đi vào, giá trị bool vẫn cần tồn tại.
        đích nhảy = [];
        ghép nhánh = [];
        lặp (i = 0; i < số lệnh; i += 1) {
            nếu ((i & 2047) == 0) {
                bỏ kết quả = máy ảo thêm cuối danh sách(đích nhảy, []);
                bỏ kết quả = máy ảo thêm cuối danh sách(ghép nhánh, []);
            };
            bỏ kết quả = máy ảo thêm cuối danh sách(đích nhảy[i >> 11], sai);
            bỏ kết quả = máy ảo thêm cuối danh sách(ghép nhánh[i >> 11], -1);
        };
        lặp (i = 0; i < số lệnh; i += 1) {
            op = lệnh[(i) >> 11][(i) & 2047];
            nếu ((op == 16 || op == 15) &&
                toán hạng lệnh[(i) >> 11][(i) & 2047] >= 0 && toán hạng lệnh[(i) >> 11][(i) & 2047] < số lệnh) {
                đích nhảy[(toán hạng lệnh[(i) >> 11][(i) & 2047]) >> 11][(toán hạng lệnh[(i) >> 11][(i) & 2047]) & 2047] = đúng;
            };
        };
        lặp (i = 0; i + 1 < số lệnh; i += 1) {
            hiện tại = lệnh[(i) >> 11][(i) & 2047];
            sau = lệnh[(i + 1) >> 11][(i + 1) & 2047];
            mã ghép = -1;
            chọn (hiện tại) {
                ca 9: { mã ghép = 1; }
                ca 10: { mã ghép = 0; }
                ca 11: { mã ghép = 10; }
                ca 12: { mã ghép = 12; }
                ca 13: { mã ghép = 13; }
                ca 14: { mã ghép = 11; }
            };
            nếu (mã ghép >= 0 && độ sâu lệnh[(i) >> 11][(i) & 2047] >= 2 &&
                sau == 15 &&
                độ sâu lệnh[(i + 1) >> 11][(i + 1) & 2047] == độ sâu lệnh[(i) >> 11][(i) & 2047] - 1 &&
                !đích nhảy[(i + 1) >> 11][(i + 1) & 2047]) {
                ghép nhánh[(i) >> 11][(i) & 2047] = mã ghép;
                ghép nhánh[(i + 1) >> 11][(i + 1) & 2047] = mã ghép;
            };
        };
        // LoadSlot(a), LoadSlot(b), phép nhị phân: đọc trực tiếp hai slot
        // bằng thanh ghi. Chỉ áp dụng nếu không có cạnh CFG vào giữa bộ ba.
        bỏ nạp = [];
        nguồn trái trực tiếp = [];
        nguồn phải trực tiếp = [];
        hằng trực tiếp = [];
        có hằng phép tính = [];
        hằng phép tính = [];
        có hằng so sánh = [];
        hằng so sánh = [];
        lặp (i = 0; i < số lệnh; i += 1) {
            nếu ((i & 2047) == 0) {
                bỏ kết quả = máy ảo thêm cuối danh sách(bỏ nạp, []);
                bỏ kết quả = máy ảo thêm cuối danh sách(nguồn trái trực tiếp, []);
                bỏ kết quả = máy ảo thêm cuối danh sách(nguồn phải trực tiếp, []);
                bỏ kết quả = máy ảo thêm cuối danh sách(hằng trực tiếp, []);
                bỏ kết quả = máy ảo thêm cuối danh sách(có hằng phép tính, []);
                bỏ kết quả = máy ảo thêm cuối danh sách(hằng phép tính, []);
                bỏ kết quả = máy ảo thêm cuối danh sách(có hằng so sánh, []);
                bỏ kết quả = máy ảo thêm cuối danh sách(hằng so sánh, []);
            };
            bỏ kết quả = máy ảo thêm cuối danh sách(bỏ nạp[i >> 11], sai);
            bỏ kết quả = máy ảo thêm cuối danh sách(nguồn trái trực tiếp[i >> 11], -1);
            bỏ kết quả = máy ảo thêm cuối danh sách(nguồn phải trực tiếp[i >> 11], -1);
            bỏ kết quả = máy ảo thêm cuối danh sách(hằng trực tiếp[i >> 11], -1);
            bỏ kết quả = máy ảo thêm cuối danh sách(có hằng phép tính[i >> 11], sai);
            bỏ kết quả = máy ảo thêm cuối danh sách(hằng phép tính[i >> 11], 0);
            bỏ kết quả = máy ảo thêm cuối danh sách(có hằng so sánh[i >> 11], sai);
            bỏ kết quả = máy ảo thêm cuối danh sách(hằng so sánh[i >> 11], 0);
        };
        nếu (dùng thành ghi) {
            lặp (i = 0; i + 2 < số lệnh; i += 1) {
                a = lệnh[(i) >> 11][(i) & 2047];
                b = lệnh[(i + 1) >> 11][(i + 1) & 2047];
                c = lệnh[(i + 2) >> 11][(i + 2) & 2047];
                toán tử = c;
                là nhị phân = toán tử == 4 || toán tử == 5 || toán tử == 6 ||
                    toán tử == 9 || toán tử == 10 || toán tử == 11 ||
                    toán tử == 12 || toán tử == 13 || toán tử == 14;
                nếu (a == 1 && b == 1 &&
                    là nhị phân && !đích nhảy[(i + 1) >> 11][(i + 1) & 2047] && !đích nhảy[(i + 2) >> 11][(i + 2) & 2047] &&
                    toán hạng lệnh[(i) >> 11][(i) & 2047] >= 0 && toán hạng lệnh[(i) >> 11][(i) & 2047] < ô nhớ &&
                    toán hạng lệnh[(i + 1) >> 11][(i + 1) & 2047] >= 0 && toán hạng lệnh[(i + 1) >> 11][(i + 1) & 2047] < ô nhớ &&
                    độ sâu lệnh[(i) >> 11][(i) & 2047] >= 0 && độ sâu lệnh[(i) >> 11][(i) & 2047] + 1 < sâu nhất &&
                    độ sâu lệnh[(i + 1) >> 11][(i + 1) & 2047] == độ sâu lệnh[(i) >> 11][(i) & 2047] + 1 &&
                    độ sâu lệnh[(i + 2) >> 11][(i + 2) & 2047] == độ sâu lệnh[(i + 1) >> 11][(i + 1) & 2047] + 1) {
                    bỏ nạp[(i) >> 11][(i) & 2047] = đúng;
                    bỏ nạp[(i + 1) >> 11][(i + 1) & 2047] = đúng;
                    nguồn trái trực tiếp[(i + 2) >> 11][(i + 2) & 2047] = toán hạng lệnh[(i) >> 11][(i) & 2047];
                    nguồn phải trực tiếp[(i + 2) >> 11][(i + 2) & 2047] = toán hạng lệnh[(i + 1) >> 11][(i + 1) & 2047];
                };
                // ADD/SUB imm12 dùng trực tiếp slot nguồn và hằng 0..4095.
                nếu (a == 1 && b == 0 &&
                    (toán tử == 4 || toán tử == 5) &&
                    !đích nhảy[(i + 1) >> 11][(i + 1) & 2047] && !đích nhảy[(i + 2) >> 11][(i + 2) & 2047] &&
                    toán hạng lệnh[(i) >> 11][(i) & 2047] >= 0 && toán hạng lệnh[(i) >> 11][(i) & 2047] < ô nhớ &&
                    hằng lệnh[(i + 1) >> 11][(i + 1) & 2047] >= 0 && hằng lệnh[(i + 1) >> 11][(i + 1) & 2047] <= 4095 &&
                    độ sâu lệnh[(i) >> 11][(i) & 2047] >= 0 && độ sâu lệnh[(i) >> 11][(i) & 2047] + 1 < sâu nhất &&
