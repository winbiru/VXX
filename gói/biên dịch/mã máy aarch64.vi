                    mình.biên dịch mã máy aarch64 phép dư(ra, d, ô nhớ, dùng thành ghi);
                }
                ca "Equal": { mình.biên dịch mã máy aarch64 số sánh(ra, d, ô nhớ, 1, dùng thành ghi, ghép nhánh[i] >= 0, nguồn trái trực tiếp[i], nguồn phải trực tiếp[i], đích ghi thẳng[i], có hằng so sánh[i], hằng so sánh[i], có hằng giữ, hằng giữ); }
                ca "NotEqual": { mình.biên dịch mã máy aarch64 số sánh(ra, d, ô nhớ, 0, dùng thành ghi, ghép nhánh[i] >= 0, nguồn trái trực tiếp[i], nguồn phải trực tiếp[i], đích ghi thẳng[i], có hằng so sánh[i], hằng so sánh[i], có hằng giữ, hằng giữ); }
                ca "Less": { mình.biên dịch mã máy aarch64 số sánh(ra, d, ô nhớ, 10, dùng thành ghi, ghép nhánh[i] >= 0, nguồn trái trực tiếp[i], nguồn phải trực tiếp[i], đích ghi thẳng[i], có hằng so sánh[i], hằng so sánh[i], có hằng giữ, hằng giữ); }
                ca "LessEqual": { mình.biên dịch mã máy aarch64 số sánh(ra, d, ô nhớ, 12, dùng thành ghi, ghép nhánh[i] >= 0, nguồn trái trực tiếp[i], nguồn phải trực tiếp[i], đích ghi thẳng[i], có hằng so sánh[i], hằng so sánh[i], có hằng giữ, hằng giữ); }
                ca "Greater": { mình.biên dịch mã máy aarch64 số sánh(ra, d, ô nhớ, 13, dùng thành ghi, ghép nhánh[i] >= 0, nguồn trái trực tiếp[i], nguồn phải trực tiếp[i], đích ghi thẳng[i], có hằng so sánh[i], hằng so sánh[i], có hằng giữ, hằng giữ); }
                ca "GreaterEqual": { mình.biên dịch mã máy aarch64 số sánh(ra, d, ô nhớ, 11, dùng thành ghi, ghép nhánh[i] >= 0, nguồn trái trực tiếp[i], nguồn phải trực tiếp[i], đích ghi thẳng[i], có hằng so sánh[i], hằng so sánh[i], có hằng giữ, hằng giữ); }
                ca "BranchZero": {
