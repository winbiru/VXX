// Biên dịch nhúng: V++ kiểm tra hợp đồng và dựng snapshot.
// Boundary bootstrap bien_dich_phan_tich_vm hiện gọi compiler C++.
nhập gói/biên dịch/cây cú pháp;
nhập gói/biên dịch/mã lệnh;

// Snapshot chỉ phụ thuộc tham số; không cần tạo đối tượng trung gian.
hàm công khai biên dịch snapshot lỗi(lỗi) {
    trả về {
        "hợp lệ": 0,
        "lỗi": lỗi,
        "token": 0,
        "ký hiệu": 0,
        "phạm vi": 0,
        "tham chiếu": 0,
        "lệnh": 0,
        "vùng ir chưa trực tiếp": 0,
        "mô đun": 0,
        "bytecode": [],
        "hàm": [],
        "cây cú pháp": []
    };
};

hàm công khai biên dịch chuẩn hóa gốc(gốc) {
    nếu (loai_cua(gốc) != "chuỗi") {
        ném "biên dịch: gốc phải là chuỗi";
    };
    nếu (gốc == "") {
        trả về ".";
    };
    trả về gốc;
};

hàm công khai biên dịch snapshot nội bộ(mã nguồn, gốc = ".") {
    nếu (loai_cua(mã nguồn) != "chuỗi") {
        ném "biên dịch: mã nguồn phải là chuỗi";
    };
    gốc = biên dịch chuẩn hóa gốc(gốc);
    thô = rỗng;
    thử {
        thô = bien_dich_phan_tich_vm(mã nguồn, gốc);
    } bắt lỗi (e) {
        trả về biên dịch snapshot lỗi(e);
    };
    các_hàm = [];
    lặp(i = 0; i < độ dài(thô[9]); i++) {
        h = thô[9][i];
        thêm(các_hàm, {"tên": h[0], "id": h[1],
                        "bytecode": biên dịch bytecode từ thô(h[2])});
    };
    trả về {
        "hợp lệ": 1,
        "lỗi": "",
        "token": thô[0],
        "ký hiệu": thô[1],
        "phạm vi": thô[2],
        "tham chiếu": thô[3],
        "lệnh": thô[4],
        "vùng ir chưa trực tiếp": thô[5],
        "mô đun": thô[6],
        "bytecode": biên dịch bytecode từ thô(thô[7]),
        "hàm": các_hàm,
        "cây cú pháp": biên dịch cây từ thô(thô[8])
    };
};

