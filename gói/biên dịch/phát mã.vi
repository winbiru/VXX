// Native-codegen bootstrap bằng V++: chuyển IR stack-based thành opcode VM.
// Trả cả string pool/slots và function ID cho hàm có tên; chưa thay CLI.
nhập gói/biên dịch/biểu diễn trung gian;
nhập gói/biên dịch/mã lệnh;
nhập gói/biên dịch/mã thao tác;
nhập gói/biên dịch/nội tại;
nhập gói/biên dịch/sổ đăng ký;
nhập gói/biên dịch/kiểu mô đun;
nhập gói/biên dịch/đồ thị mô đun;
nhập gói/lõi/chuyển kiểu;
nhập gói/lõi/bảng mã;
nhập gói/bộ sưu tập/danh sách;
nhập gói/bộ sưu tập/từ điển;

// Phiên giữ nguồn và cache kết quả riêng; các phương thức nhận tham số giữ API cũ.
lớp công khai Bộ Phát Bytecode {
    hàm công khai khởi tạo(mã nguồn = "") {
        mình.làm mới(mã nguồn);
    };

    hàm công khai làm mới(mã nguồn) {
        nếu (loại của(mã nguồn) != "chuỗi") {
            ném "Bộ Phát Bytecode: mã nguồn phải là chuỗi";
        };
        mình.nguồn = mã nguồn;
        mình.kết quả = rỗng;
        trả về mình;
    };

    hàm công khai phát() {
        nếu (mình.kết quả == rỗng) {
            mình.kết quả = mình.biên dịch phát mã trung gian thuần(mình.nguồn);
        };
        trả về mình.kết quả;
    };

    hàm riêng tư biên dịch phát mã mã thao tác hai ngôi(toán tử) {
        nếu (toán tử == "+") { trả về biên dịch mã thao tác("OP_CONG"); };
        nếu (toán tử == "-") { trả về biên dịch mã thao tác("OP_TRU"); };
        nếu (toán tử == "*") { trả về biên dịch mã thao tác("OP_NHAN"); };
        nếu (toán tử == "/") { trả về biên dịch mã thao tác("OP_CHIA"); };
        nếu (toán tử == "&&") { trả về biên dịch mã thao tác("OP_Logic_VA"); };
        nếu (toán tử == "||") { trả về biên dịch mã thao tác("OP_Logic_HOAC"); };
        nếu (toán tử == "==") { trả về biên dịch mã thao tác("OP_SO_SANH_BANG"); };
        nếu (toán tử == "!=") { trả về biên dịch mã thao tác("OP_KHAC_BANG"); };
        nếu (toán tử == ">") { trả về biên dịch mã thao tác("OP_LON_HON"); };
        nếu (toán tử == "<") { trả về biên dịch mã thao tác("OP_NHO_HON"); };
        nếu (toán tử == ">=") { trả về biên dịch mã thao tác("OP_LON_HON_HOAC_BANG"); };
        nếu (toán tử == "<=") { trả về biên dịch mã thao tác("OP_NHO_HON_HOAC_BANG"); };
        nếu (toán tử == "%") { trả về biên dịch mã thao tác("OP_MODULO"); };
        ném "biên dịch phát mã: toán tử không hợp lệ '" + toán tử + "'";
    };

    hàm riêng tư biên dịch phát mã mã thao tác gán(toán tử) {
        // src/compiler/codegen.cpp::compoundOpcode: toán tử ở đây thực hiện
        // phép tính trên hai giá trị đã đẩy lên stack, rồi OP_GAN lưu kết quả.
        nếu (toán tử == "+=") { trả về biên dịch mã thao tác("OP_CONG"); };
        nếu (toán tử == "-=") { trả về biên dịch mã thao tác("OP_TRU"); };
        nếu (toán tử == "*=") { trả về biên dịch mã thao tác("OP_NHAN"); };
        nếu (toán tử == "/=") { trả về biên dịch mã thao tác("OP_CHIA"); };
        nếu (toán tử == "%=") { trả về biên dịch mã thao tác("OP_MODULO"); };
        ném "biên dịch phát mã: gán kết hợp không hợp lệ '" + toán tử + "'";
    };

    hàm riêng tư biên dịch phát mã lệnh(thô, mã phép toán, toán hạng, chỉ số, giá trị) {
        máy ảo thêm cuối danh sách(thô, [mã phép toán, toán hạng, chỉ số, giá trị]);
    };

    hàm riêng tư biên dịch phát mã ô nhớ(trạng thái, tên) {
        các ô nhớ = trạng thái["slots"];
        khóa = trạng thái["khóa slots"];
        // SymbolId đã có khóa riêng; fallback văn bản dành cho tên chưa phân giải.
        // Danh sách khóa song song giữ ID ổn định mà không đổi ABI `slots`.
        lặp(i = máy ảo lấy độ dài(khóa); i < máy ảo lấy độ dài(các ô nhớ); i++) {
            máy ảo thêm cuối danh sách(khóa, các ô nhớ[i]);
        };
        lặp(i = 0; i < máy ảo lấy độ dài(khóa); i++) {
            nếu (khóa[i] == tên) { trả về i; };
        };
        chỉ số = máy ảo lấy độ dài(các ô nhớ);
        máy ảo thêm cuối danh sách(các ô nhớ, tên);
        máy ảo thêm cuối danh sách(khóa, tên);
        trả về chỉ số;
    };

    // IR đã phân giải binding; một SymbolId dùng đúng một VM slot dù cùng tên
    // với function ID, local của hàm khác hoặc biến của catch lồng nhau.
    hàm riêng tư biên dịch phát mã ô nhớ mục ký hiệu(trạng thái, tên, mục ký hiệu) {
        nếu (mục ký hiệu < 0) { trả về mình.biên dịch phát mã ô nhớ(trạng thái, tên); };
        các ô nhớ = trạng thái["slots"];
        khóa = trạng thái["khóa slots"];
        lặp(i = máy ảo lấy độ dài(khóa); i < máy ảo lấy độ dài(các ô nhớ); i++) {
            máy ảo thêm cuối danh sách(khóa, các ô nhớ[i]);
        };
        tên khóa = "symbol:" + thành chuỗi(mục ký hiệu);
        lặp(i = 0; i < máy ảo lấy độ dài(khóa); i++) {
            nếu (khóa[i] == tên khóa) { trả về i; };
        };
        chỉ số = máy ảo lấy độ dài(các ô nhớ);
        máy ảo thêm cuối danh sách(các ô nhớ, tên);
        máy ảo thêm cuối danh sách(khóa, tên khóa);
        trả về chỉ số;
    };

    hàm riêng tư biên dịch phát mã lưu chuỗi(trạng thái, văn bản) {
        // StringPool trong VM đánh địa chỉ bằng số nguyên.
        vùng chứa = trạng thái["chuỗi"];
        // Dùng chung index với registry, kể cả khi nhập module lồng nhau.
        nếu (máy ảo có khóa từ điển(trạng thái, "chỉ mục chuỗi")) {
            tra cứu = trạng thái["chỉ mục chuỗi"];
            nếu (máy ảo có khóa từ điển(tra cứu, văn bản)) { trả về tra cứu[văn bản]; };
            chỉ số = máy ảo lấy độ dài(vùng chứa);
            máy ảo thêm cuối danh sách(vùng chứa, văn bản);
            tra cứu[văn bản] = chỉ số;
            trả về chỉ số;
        };
        lặp(i = 0; i < máy ảo lấy độ dài(vùng chứa); i++) {
            nếu (vùng chứa[i] == văn bản) { trả về i; };
        };
        chỉ số = máy ảo lấy độ dài(vùng chứa);
        máy ảo thêm cuối danh sách(vùng chứa, văn bản);
        trả về chỉ số;
    };

    // Chỉ một receiver có slot từ vựng mới được hiểu là đối tượng;
    // `mô_đun.hàm` tiếp tục đi theo bộ giải tên của linker.
    hàm riêng tư biên dịch phát mã tìm receiver(trạng thái, tên) {
        các ô nhớ = trạng thái["slots"];
        lặp(i = 0; i < máy ảo lấy độ dài(các ô nhớ); i++) {
            nếu (các ô nhớ[i] == tên) { trả về i; };
        };
        trả về -1;
    };

    hàm riêng tư biên dịch phát mã ô nhớ receiver(trạng thái, tên, mục ký hiệu) {
        nếu (mục ký hiệu >= 0) {
            trả về mình.biên dịch phát mã ô nhớ mục ký hiệu(trạng thái, tên, mục ký hiệu);
        };
        trả về mình.biên dịch phát mã ô nhớ(trạng thái, tên);
    };

    hàm công khai biên dịch phát mã tách chuỗi(từ tố) {
        n = máy ảo lấy độ dài(từ tố);
        nếu (n < 2 || !((từ tố[0] == "\"" && từ tố[n - 1] == "\"") ||
                        (từ tố[0] == "'" && từ tố[n - 1] == "'"))) {
            ném "biên dịch phát mã: literal chuỗi không hợp lệ";
        };
        // Trùng src/frontend/lexer.cpp::stripQuotes: giải mã một lần rồi mới
        // lưu StringPool hoặc escape tiếp khi đóng gói list/map literal.
        // Escape không nhận diện: C++ giữ ký tự sau dấu gạch chéo.
        văn bản = "";
        i = 1;
        khi (i < n - 1) {
            c = từ tố[i];
            nếu (c == "\\" && i + 1 < n - 1) {
                i += 1;
                dấu thoát = từ tố[i];
                nếu (dấu thoát == "n") { văn bản += "\n"; }
                hoặc {
                    nếu (dấu thoát == "r") { văn bản += "\r"; }
                    hoặc {
                        nếu (dấu thoát == "t") { văn bản += "\t"; }
                        hoặc {
                            nếu (dấu thoát == "0") { văn bản += ký tự unicode(0); }
                            hoặc { văn bản += dấu thoát; };
                        };
                    };
                };
            } hoặc {
                văn bản += c;
            };
            i += 1;
        };
        trả về văn bản;
    };

    // encodeDefaultValue của emitter C++: literal scalar hoặc số nguyên âm.
    // Không đánh giá biểu thức động hoặc thay tham số mặc định bằng giá trị khác.
    hàm riêng tư biên dịch phát mã mặc định(nút) {
        loại = lấy từ điển(nút, "loại", "");
        nếu (loại == "một ngôi" && nút["toán tử"] == "-") {
            hằng = nút["toán hạng"];
            nếu (lấy từ điển(hằng, "loại", "") == "hằng" && hằng["kiểu"] == "số nguyên") {
                văn bản = "-" + hằng["giá trị"];
                // Kiểm tra biên i32 trước khi mã hóa, gồm -2147483648.
                giá trị = thành số nguyên(văn bản);
                trả về "i:" + thành chuỗi(giá trị);
            };
        };
        nếu (loại == "hằng") {
            s = nút["giá trị"];
            chọn (nút["kiểu"]) {
                ca "số nguyên": { thành số nguyên(s); trả về "i:" + s; }
                ca "số thực": { trả về "d:" + s; }
                ca "chuỗi": { trả về "s:" + mình.biên dịch phát mã tách chuỗi(s); }
                mặc định: {
                    nếu (s == "đúng") { trả về "i:1"; };
                    nếu (s == "sai") { trả về "i:0"; };
                    nếu (s == "rỗng") { trả về "n:"; };
                }
            }
        };
        ném "biên dịch phát mã: tham số mặc định chưa hỗ trợ";
    };

    // Cùng định dạng với src/include/vpp/bytecode/literal_wire.h.
    // 0x1e ngăn cách record; 0x1f ngăn cách field.
    hàm riêng tư biên dịch phát mã ngăn bản ghi() { trả về ký tự unicode(30); };

    hàm riêng tư biên dịch phát mã ngăn trường() { trả về ký tự unicode(31); };

    hàm riêng tư biên dịch phát mã ký tự thoát trường(s) {
        kết quả = "";
        lặp(i = 0; i < máy ảo lấy độ dài(s); i++) {
            c = s[i];
            nếu (c == "\\") { kết quả += "\\\\"; }
            hoặc {
                nếu (c == "\n") { kết quả += "\\n"; }
                hoặc {
                    nếu (c == "\r") { kết quả += "\\r"; }
                    hoặc {
                        nếu (c == "\t") { kết quả += "\\t"; }
                        hoặc {
                            nếu (c == mình.biên dịch phát mã ngăn bản ghi()) { kết quả += "\\e"; }
                            hoặc {
                                nếu (c == mình.biên dịch phát mã ngăn trường()) { kết quả += "\\f"; }
                                hoặc { kết quả += c; };
                            };
                        };
                    };
                };
            };
        };
        trả về kết quả;
    };

    hàm riêng tư biên dịch phát mã khóa từ điển(nút) {
        nếu (lấy từ điển(nút, "loại", "") == "tên") {
            trả về nút["giá trị"];
        };
        nếu (lấy từ điển(nút, "loại", "") == "hằng" &&
            lấy từ điển(nút, "kiểu", "") == "chuỗi") {
            trả về mình.biên dịch phát mã tách chuỗi(nút["giá trị"]);
        };
        ném "biên dịch phát mã: khóa từ điển phải là tên hoặc chuỗi";
    };

    hàm riêng tư biên dịch phát mã mã hóa tập hợp(nút) {
        loại = lấy từ điển(nút, "loại", "");
        nếu (loại == "hằng") {
            kiểu = lấy từ điển(nút, "kiểu", "");
            s = lấy từ điển(nút, "giá trị", "");
            nếu (kiểu == "số nguyên") {
                trả về "i" + mình.biên dịch phát mã ngăn trường() + mình.biên dịch phát mã ký tự thoát trường(s);
            };
            nếu (kiểu == "số thực") {
                trả về "d" + mình.biên dịch phát mã ngăn trường() + mình.biên dịch phát mã ký tự thoát trường(s);
            };
            nếu (kiểu == "chuỗi") {
                trả về "s" + mình.biên dịch phát mã ngăn trường() +
                       mình.biên dịch phát mã ký tự thoát trường(mình.biên dịch phát mã tách chuỗi(s));
            };
            nếu (s == "đúng") { trả về "i" + mình.biên dịch phát mã ngăn trường() + "1"; };
            nếu (s == "sai") { trả về "i" + mình.biên dịch phát mã ngăn trường() + "0"; };
            nếu (s == "rỗng") { trả về "n" + mình.biên dịch phát mã ngăn trường(); };
        };
        nếu (loại == "danh sách") {
            trả về "l" + mình.biên dịch phát mã ngăn trường() +
                    mình.biên dịch phát mã ký tự thoát trường(mình.biên dịch phát mã chuỗi tập hợp(nút));
        };
        nếu (loại == "từ điển") {
            trả về "m" + mình.biên dịch phát mã ngăn trường() +
                    mình.biên dịch phát mã ký tự thoát trường(mình.biên dịch phát mã chuỗi tập hợp(nút));
        };
        ném "biên dịch phát mã: tập hợp tĩnh chứa biểu thức không hỗ trợ";
    };

    // Opcode static lưu payload không có type tag của collection ngoài cùng.
    hàm riêng tư biên dịch phát mã chuỗi tập hợp(nút) {
        loại = lấy từ điển(nút, "loại", "");
        kết quả = "";
        nếu (loại == "danh sách") {
            phần tử = lấy từ điển(nút, "phần tử", []);
            lặp(i = 0; i < máy ảo lấy độ dài(phần tử); i++) {
                nếu (i > 0) { kết quả += mình.biên dịch phát mã ngăn bản ghi(); };
                kết quả += mình.biên dịch phát mã mã hóa tập hợp(phần tử[i]);
            };
            trả về kết quả;
        };
        nếu (loại == "từ điển") {
            mục = lấy từ điển(nút, "mục", []);
            lặp(i = 0; i < máy ảo lấy độ dài(mục); i++) {
                nếu (i > 0) { kết quả += mình.biên dịch phát mã ngăn bản ghi(); };
                kết quả += mình.biên dịch phát mã ký tự thoát trường(
                    mình.biên dịch phát mã khóa từ điển(mục[i]["khóa"])) +
                    mình.biên dịch phát mã ngăn trường() +
                    mình.biên dịch phát mã mã hóa tập hợp(mục[i]["giá trị"]);
            };
            trả về kết quả;
        };
        ném "biên dịch phát mã: chỉ nhận danh sách hoặc từ điển tĩnh";
    };

    hàm riêng tư phát hàm ẩn danh(khai, trạng thái, thô) {
        sổ = trạng thái["sổ hàm"];
        mã định danh = máy ảo lấy độ dài(sổ["hàm"]);
        // Hàm ẩn danh không tạo tên xuất hay ô biến dành cho tên hàm.
        máy ảo thêm cuối danh sách(sổ["hàm"], {"id": mã định danh, "tên": "",
            "tên index": -1, "tên chạy": "", "tên index runtime": -1,
            "mô đun": trạng thái["mô đun"], "ẩn danh": đúng});
        các hàm = trạng thái["hàm ẩn danh"];
        vị trí = máy ảo lấy độ dài(các hàm);
        máy ảo thêm cuối danh sách(các hàm, rỗng);
        con = {};
        khóa = khóa từ điển(trạng thái);
        lặp(i = 0; i < máy ảo lấy độ dài(khóa); i++) { con[khóa[i]] = trạng thái[khóa[i]]; };
        // Không để return/break/try của closure làm đổi khung điều khiển bên ngoài.
        khung = ["nhánh nếu", "chọn", "thử", "gọi thành viên", "gán thành viên", "lặp", "phạm vi thoát"];
        lặp(i = 0; i < máy ảo lấy độ dài(khung); i++) { con[khung[i]] = []; };
        con["độ sâu khối"] = 0;
        con["độ sâu thử"] = 0;
        thân = mình.biên dịch phát mã thân phương thức(khai, con);
        các hàm[vị trí] = {"id": mã định danh, "tên": "", "tên index": -1,
            "bytecode": thân, "ẩn danh": đúng};
        bắt giữ = khai["bắt giữ"];
        lặp(i = 0; i < máy ảo lấy độ dài(bắt giữ); i++) {
            ô nhớ = mình.biên dịch phát mã ô nhớ mục ký hiệu(trạng thái, bắt giữ[i]["tên"], bắt giữ[i]["id"]);
            mình.biên dịch phát mã lệnh(thô, biên dịch mã thao tác("OP_TEN_BIEN_ID"), 0, ô nhớ, 0);
        };
        nếu (máy ảo lấy độ dài(bắt giữ) == 0) {
            mình.biên dịch phát mã lệnh(thô, biên dịch mã thao tác("OP_BIEN_SO"), mã định danh, 0, 0);
        } hoặc {
            mình.biên dịch phát mã lệnh(thô, biên dịch mã thao tác("OP_TAO_DONG_BAO"),
                mã định danh, máy ảo lấy độ dài(bắt giữ), 0);
        };
        trả về đúng;
    };

    hàm riêng tư biên dịch phát mã IR một(mục, trạng thái, thô) {
        mã = lấy từ điển(mục, "mã", "");
        giá trị = lấy từ điển(mục, "giá trị", "");
        mục ký hiệu = lấy từ điển(mục, "symbol", -1);
        nếu (mã == "hàm ẩn danh") { trả về mình.phát hàm ẩn danh(giá trị, trạng thái, thô); };
        nếu (mã == "gọi giá trị") {
            mình.biên dịch phát mã lệnh(thô, biên dịch mã thao tác("OP_GOI_GIAN_TIEP"), giá trị, 0, 0);
            trả về đúng;
        };
        nếu (mã == "danh sách tĩnh" || mã == "từ điển tĩnh") {
            dây = mình.biên dịch phát mã chuỗi tập hợp(giá trị);
            chỉ số = mình.biên dịch phát mã lưu chuỗi(trạng thái, dây);
            mã phép toán = biên dịch mã thao tác("OP_LIST_LITERAL");
            nếu (mã == "từ điển tĩnh") { mã phép toán = biên dịch mã thao tác("OP_MAP_LITERAL"); };
            mình.biên dịch phát mã lệnh(thô, mã phép toán, 0, chỉ số, 0);
            trả về đúng;
        };
        nếu (mã == "danh sách động" || mã == "từ điển động") {
            mã phép toán = biên dịch mã thao tác("OP_LIST_LITERAL");
            nếu (mã == "từ điển động") { mã phép toán = biên dịch mã thao tác("OP_MAP_LITERAL"); };
            mình.biên dịch phát mã lệnh(thô, mã phép toán, giá trị, -1, 0);
            trả về đúng;
        };
        nếu (mã == "khóa từ điển") {
            tên khóa = mình.biên dịch phát mã khóa từ điển(giá trị);
            chỉ số = mình.biên dịch phát mã lưu chuỗi(trạng thái, tên khóa);
            mình.biên dịch phát mã lệnh(thô, biên dịch mã thao tác("OP_CHUOI"), 0, chỉ số, 0);
            trả về đúng;
        };
        nếu (mã == "số nguyên") {
            mình.biên dịch phát mã lệnh(thô, biên dịch mã thao tác("OP_BIEN_SO"), thành số nguyên(giá trị), 0, 0);
            trả về đúng;
        };
        nếu (mã == "đúng" || mã == "sai") {
            mình.biên dịch phát mã lệnh(thô, biên dịch mã thao tác("OP_BIEN_SO"), mã == "đúng", 0, 0);
            trả về đúng;
        };
        nếu (mã == "rỗng") {
            mình.biên dịch phát mã lệnh(thô, biên dịch mã thao tác("OP_RONG_GIA_TRI"), 0, 0, 0);
            trả về đúng;
        };
        nếu (mã == "số thực") {
            chỉ số = mình.biên dịch phát mã lưu chuỗi(trạng thái, giá trị);
            mình.biên dịch phát mã lệnh(thô, biên dịch mã thao tác("OP_BIEN_SO_FLOAT"), 0, chỉ số, 0);
            trả về đúng;
        };
        nếu (mã == "chuỗi") {
            chuỗi = mình.biên dịch phát mã tách chuỗi(giá trị);
            chỉ số = mình.biên dịch phát mã lưu chuỗi(trạng thái, chuỗi);
            mình.biên dịch phát mã lệnh(thô, biên dịch mã thao tác("OP_CHUOI"), 0, chỉ số, 0);
            trả về đúng;
        };
        nếu (mã == "đọc tên") {
            tách = biên dịch IR tách thành viên(giá trị);
            nếu (tách != rỗng && mục ký hiệu < 0) {
                nhận ô nhớ = mình.biên dịch phát mã tìm receiver(trạng thái, tách["nhận"]);
                nếu (nhận ô nhớ >= 0) {
                    tên chỉ mục = mình.biên dịch phát mã lưu chuỗi(trạng thái, tách["tên"]);
                    mình.biên dịch phát mã lệnh(thô, biên dịch mã thao tác("OP_TEN_BIEN_GIA_TRI"), 0, nhận ô nhớ, 0);
                    mình.biên dịch phát mã lệnh(thô, biên dịch mã thao tác("OP_DOC_THUOC_TINH"), 0, tên chỉ mục, 0);
                    trả về đúng;
                };
            };
            nếu (mục ký hiệu >= 0) {
                ô nhớ = mình.biên dịch phát mã ô nhớ mục ký hiệu(trạng thái, giá trị, mục ký hiệu);
                mình.biên dịch phát mã lệnh(thô, biên dịch mã thao tác("OP_TEN_BIEN_GIA_TRI"), 0, ô nhớ, 0);
                trả về đúng;
            };
            danh sách hàm đã khai = trạng thái["hàm đã khai"];
            lặp(i = 0; i < máy ảo lấy độ dài(danh sách hàm đã khai); i++) {
                nếu (danh sách hàm đã khai[i] == giá trị) {
                    mình.biên dịch phát mã lệnh(thô, biên dịch mã thao tác("OP_BIEN_SO"),
                                         trạng thái["hàm các mã định danh"][i], 0, 0);
                    trả về đúng;
                };
            };
            nếu (lấy từ điển(trạng thái, "liên mô đun", sai)) {
                thấy = trạng thái["hàm nhìn thấy"];
                lặp(i = 0; i < máy ảo lấy độ dài(thấy); i++) {
                    nếu (thấy[i]["tên"] == giá trị) {
                        mình.biên dịch phát mã lệnh(thô, biên dịch mã thao tác("OP_BIEN_SO"),
                                             thấy[i]["id"], 0, 0);
                        trả về đúng;
                    };
                };
            };
            ô nhớ = mình.biên dịch phát mã ô nhớ(trạng thái, giá trị);
            mình.biên dịch phát mã lệnh(thô, biên dịch mã thao tác("OP_TEN_BIEN_GIA_TRI"), 0, ô nhớ, 0);
            trả về đúng;
        };
        nếu (mã == "đọc thành viên") {
            nếu (!lấy từ điển(giá trị, "tạm", sai)) {
                nhận ô nhớ = mình.biên dịch phát mã ô nhớ receiver(trạng thái, giá trị["nhận"], mục ký hiệu);
                mình.biên dịch phát mã lệnh(thô, biên dịch mã thao tác("OP_TEN_BIEN_GIA_TRI"), 0, nhận ô nhớ, 0);
            };
            tên chỉ mục = mình.biên dịch phát mã lưu chuỗi(trạng thái, giá trị["tên"]);
            mình.biên dịch phát mã lệnh(thô, biên dịch mã thao tác("OP_DOC_THUOC_TINH"), 0, tên chỉ mục, 0);
            trả về đúng;
        };
        nếu (mã == "chuẩn bị gán thành viên") {
            nếu (!lấy từ điển(giá trị, "tạm", sai)) {
                nhận ô nhớ = mình.biên dịch phát mã ô nhớ receiver(trạng thái, giá trị["nhận"], mục ký hiệu);
                mình.biên dịch phát mã lệnh(thô, biên dịch mã thao tác("OP_TEN_BIEN_GIA_TRI"), 0, nhận ô nhớ, 0);
            };
            tên chỉ mục = mình.biên dịch phát mã lưu chuỗi(trạng thái, giá trị["tên"]);
            máy ảo thêm cuối danh sách(trạng thái["gán thành viên"], tên chỉ mục);
            trả về đúng;
        };
        nếu (mã == "gán thành viên") {
            ngăn = trạng thái["gán thành viên"];
            nếu (máy ảo lấy độ dài(ngăn) == 0) { ném "biên dịch phát mã: thiếu receiver gán"; };
            tên chỉ mục = ngăn[máy ảo lấy độ dài(ngăn) - 1];
            máy ảo xóa vị trí danh sách(ngăn, máy ảo lấy độ dài(ngăn) - 1);
            mình.biên dịch phát mã lệnh(thô, biên dịch mã thao tác("OP_GAN_THUOC_TINH"), 0, tên chỉ mục, 0);
            trả về đúng;
        };
        nếu (mã == "bắt đầu gọi thành viên") {
            tên đầy đủ = giá trị["nhận"] + "." + giá trị["tên"];
            các lớp = lấy từ điển(trạng thái, "lớp nhập", []);
            lặp(i = 0; i < máy ảo lấy độ dài(các lớp); i++) {
                nếu (các lớp[i]["tên"] == tên đầy đủ) {
                    máy ảo thêm cuối danh sách(trạng thái["gọi thành viên"], {"động": sai});
                    trả về đúng;
                };
            };
            nếu (lấy từ điển(giá trị, "tạm", sai)) {
                tên chỉ mục = mình.biên dịch phát mã lưu chuỗi(trạng thái, giá trị["tên"]);
                máy ảo thêm cuối danh sách(trạng thái["gọi thành viên"], {"động": đúng, "tên index": tên chỉ mục});
                trả về đúng;
            };
            nhận ô nhớ = -1;
            nếu (mục ký hiệu >= 0) {
                nhận ô nhớ = mình.biên dịch phát mã ô nhớ mục ký hiệu(trạng thái, giá trị["nhận"], mục ký hiệu);
            } hoặc {
                nhận ô nhớ = mình.biên dịch phát mã tìm receiver(trạng thái, giá trị["nhận"]);
            };
            nếu (nhận ô nhớ >= 0) {
                tên chỉ mục = mình.biên dịch phát mã lưu chuỗi(trạng thái, giá trị["tên"]);
                mình.biên dịch phát mã lệnh(thô, biên dịch mã thao tác("OP_TEN_BIEN_GIA_TRI"), 0, nhận ô nhớ, 0);
                máy ảo thêm cuối danh sách(trạng thái["gọi thành viên"], {"động": đúng, "tên index": tên chỉ mục});
            } hoặc {
                máy ảo thêm cuối danh sách(trạng thái["gọi thành viên"], {"động": sai});
            };
            trả về đúng;
        };
        nếu (mã == "gọi thành viên") {
            ngăn = trạng thái["gọi thành viên"];
            nếu (máy ảo lấy độ dài(ngăn) == 0) { ném "biên dịch phát mã: lời gọi thiếu receiver"; };
            bước = ngăn[máy ảo lấy độ dài(ngăn) - 1];
            máy ảo xóa vị trí danh sách(ngăn, máy ảo lấy độ dài(ngăn) - 1);
            nếu (bước["động"]) {
                mình.biên dịch phát mã lệnh(thô, biên dịch mã thao tác("OP_GOI_PHUONG_THUC"),
                    giá trị["số đối số"], bước["tên index"], giá trị["nhận"] == "gốc");
            } hoặc {
                tên đầy đủ = giá trị["nhận"] + "." + giá trị["tên"];
                mình.biên dịch phát mã IR một({"mã": "gọi tên",
                    "giá trị": {"tên": tên đầy đủ,
                                  "số đối số": giá trị["số đối số"]}}, trạng thái, thô);
            };
            trả về đúng;
        };
        nếu (mã == "gọi tên" || mã == "gọi tường minh") {
            tên = giá trị["tên"];
            số đối số = giá trị["số đối số"];
            các lớp = lấy từ điển(trạng thái, "lớp nhập", []);
            lặp(i = 0; i < máy ảo lấy độ dài(các lớp); i++) {
                nếu (các lớp[i]["tên"] == tên) {
                    tên mã định danh = mình.biên dịch phát mã lưu chuỗi(trạng thái, các lớp[i]["runtime"]);
                    mình.biên dịch phát mã lệnh(thô, biên dịch mã thao tác("OP_TAO_DOI_TUONG"), số đối số, tên mã định danh, 0);
                    trả về đúng;
                };
            };
            kiểu lớp đã khai = lấy từ điển(trạng thái, "lớp đã khai", []);
            lặp(i = 0; i < máy ảo lấy độ dài(kiểu lớp đã khai); i++) {
                nếu (kiểu lớp đã khai[i] == tên) {
                    tên mã định danh = mình.biên dịch phát mã lưu chuỗi(trạng thái, tên);
                    mình.biên dịch phát mã lệnh(thô, biên dịch mã thao tác("OP_TAO_DOI_TUONG"),
                                         số đối số, tên mã định danh, 0);
                    trả về đúng;
                };
            };
            nội tại = biên dịch nội tại(tên);
            nếu (nội tại != rỗng) {
              nếu (nội tại[2]) {
                nếu (số đối số != nội tại[1]) { ném "biên dịch phát mã: sai số đối số nội tại '" + tên + "'"; };
                mình.biên dịch phát mã lệnh(thô, nội tại[0], 0, 0, 0);
                trả về đúng;
              };
            };
            nếu (mã == "gọi tên" && mục ký hiệu >= 0) {
                ô nhớ = mình.biên dịch phát mã ô nhớ mục ký hiệu(trạng thái, tên, mục ký hiệu);
                mình.biên dịch phát mã lệnh(thô, biên dịch mã thao tác("OP_TEN_BIEN_GIA_TRI"), 0, ô nhớ, 0);
                mình.biên dịch phát mã lệnh(thô, biên dịch mã thao tác("OP_GOI_GIAN_TIEP"), số đối số, 0, 0);
                trả về đúng;
            };
            danh sách hàm đã khai = trạng thái["hàm đã khai"];
            lặp(i = 0; i < máy ảo lấy độ dài(danh sách hàm đã khai); i++) {
                nếu (danh sách hàm đã khai[i] == tên) {
                    mình.biên dịch phát mã lệnh(thô, biên dịch mã thao tác("OP_GOI"),
                                         số đối số, trạng thái["hàm các mã định danh"][i], 0);
                    trả về đúng;
                };
            };
            nếu (lấy từ điển(trạng thái, "liên mô đun", sai)) {
                thấy = trạng thái["hàm nhìn thấy"];
                lặp(i = 0; i < máy ảo lấy độ dài(thấy); i++) {
                    nếu (thấy[i]["tên"] == tên) {
                        mình.biên dịch phát mã lệnh(thô, biên dịch mã thao tác("OP_GOI"),
                                             số đối số, thấy[i]["id"], 0);
                        trả về đúng;
                    };
                };
            };
            nếu (mã == "gọi tên") {
                các ô nhớ = trạng thái["slots"];
                lặp(i = 0; i < máy ảo lấy độ dài(các ô nhớ); i++) {
                    nếu (các ô nhớ[i] == tên) {
                        mình.biên dịch phát mã lệnh(thô, biên dịch mã thao tác("OP_TEN_BIEN_GIA_TRI"), 0, i, 0);
                        mình.biên dịch phát mã lệnh(thô, biên dịch mã thao tác("OP_GOI_GIAN_TIEP"), số đối số, 0, 0);
                        trả về đúng;
                    };
                };
            };
            // Binding lexical có thể chưa có symbol ID ở đường tương thích.
            // Chỉ phát foreign call sau khi đã thử các slot cục bộ.
            các ngoại = trạng thái["ngoại"];
            lặp(i = 0; i < máy ảo lấy độ dài(các ngoại); i++) {
                nếu (các ngoại[i]["tên"] == tên) {
                    nếu (số đối số != máy ảo lấy độ dài(các ngoại[i]["tham số"])) {
                        ném "biên dịch phát mã: sai số đối số ngoại hàm '" + tên + "'";
                    };
                    mình.biên dịch phát mã lệnh(thô, biên dịch mã thao tác("OP_FFI_CALL"),
                        số đối số, các ngoại[i]["id"], 0);
                    trả về đúng;
                };
            };
            nếu (nội tại != rỗng) {
                nếu (số đối số != nội tại[1]) { ném "biên dịch phát mã: sai số đối số nội tại '" + tên + "'"; };
                mình.biên dịch phát mã lệnh(thô, nội tại[0], 0, 0, 0);
                trả về đúng;
            };
            nếu (lấy từ điển(trạng thái, "liên mô đun", sai)) {
                ném "biên dịch phát mã: lời gọi chưa phân giải '" +
                    tên + "' trong mô đun '" + lấy từ điển(trạng thái, "mô đun", "") + "'";
            };
            tên mã định danh = mình.biên dịch phát mã lưu chuỗi(trạng thái, tên);
            mình.biên dịch phát mã lệnh(thô, biên dịch mã thao tác("OP_GOI"), số đối số, 0 - tên mã định danh - 1, 0);
            trả về đúng;
        };
        nếu (mã == "chuẩn bị gán") {
            // Chỉ đặt chỗ trong bảng symbol; không thêm opcode vào VM stack.
            mình.biên dịch phát mã ô nhớ mục ký hiệu(trạng thái, giá trị, mục ký hiệu);
            trả về đúng;
        };
        nếu (mã == "khai báo") {
            ô nhớ = mình.biên dịch phát mã ô nhớ mục ký hiệu(trạng thái, giá trị, mục ký hiệu);
            mình.biên dịch phát mã lệnh(thô, biên dịch mã thao tác("OP_KHOI_TAO"), 0, ô nhớ, 0);
            trả về đúng;
        };
        nếu (mã == "gán tên") {
            ô nhớ = mình.biên dịch phát mã ô nhớ mục ký hiệu(trạng thái, giá trị, mục ký hiệu);
            mình.biên dịch phát mã lệnh(thô, biên dịch mã thao tác("OP_TEN_BIEN_ID"), 0, ô nhớ, 0);
            mình.biên dịch phát mã lệnh(thô, biên dịch mã thao tác("OP_GAN"), 0, 0, 0);
            trả về đúng;
        };
        nếu (mã == "++" || mã == "--") {
            ô nhớ = mình.biên dịch phát mã ô nhớ mục ký hiệu(trạng thái, giá trị, mục ký hiệu);
            mình.biên dịch phát mã lệnh(thô, biên dịch mã thao tác("OP_TEN_BIEN_ID"), 0, ô nhớ, 0);
            nếu (mã == "++") {
                mình.biên dịch phát mã lệnh(thô, biên dịch mã thao tác("OP_CONG_MOT"), 0, 0, 0);
            } hoặc {
                mình.biên dịch phát mã lệnh(thô, biên dịch mã thao tác("OP_TRU_MOT"), 0, 0, 0);
            };
            trả về đúng;
        };
        nếu (mã == "toán tử") {
            mã phép toán = mình.biên dịch phát mã mã thao tác hai ngôi(giá trị);
            mình.biên dịch phát mã lệnh(thô, mã phép toán, 0, 0, 0);
            trả về đúng;
        };
        nếu (mã == "toán tử gán") {
            mã phép toán = mình.biên dịch phát mã mã thao tác gán(giá trị);
            mình.biên dịch phát mã lệnh(thô, mã phép toán, 0, 0, 0);
            trả về đúng;
        };
        nếu (mã == "phủ định") {
            mình.biên dịch phát mã lệnh(thô, biên dịch mã thao tác("OP_PHU_DINH"), 0, 0, 0);
            trả về đúng;
        };
        nếu (mã == "đọc chỉ số") {
            mình.biên dịch phát mã lệnh(thô, biên dịch mã thao tác("OP_DOC_CHI_SO"), 0, 0, 0);
            trả về đúng;
        };
        nếu (mã == "gán chỉ số") {
            mình.biên dịch phát mã lệnh(thô, biên dịch mã thao tác("OP_GAN_CHI_SO"), 0, 0, 0);
            trả về đúng;
        };
        nếu (mã == "bắt đầu nếu") {
            mình.biên dịch phát mã lệnh(thô, biên dịch mã thao tác("OP_NEU"), 0, 0, 0);
            trả về đúng;
        };
        nếu (mã == "nhảy nếu sai") {
            vị trí = máy ảo lấy độ dài(thô);
            mình.biên dịch phát mã lệnh(thô, biên dịch mã thao tác("OP_JUMP_IF_FALSE"), 0, 0, 0);
            máy ảo thêm cuối danh sách(trạng thái["nhánh nếu"], {"sai": vị trí, "cuối": -1});
            trả về đúng;
        };
        nếu (mã == "bắt đầu nhánh khác") {
            ngăn = trạng thái["nhánh nếu"];
            nếu (máy ảo lấy độ dài(ngăn) == 0) {
                ném "biên dịch phát mã: nhánh khác thiếu điều kiện";
            };
            vị trí = máy ảo lấy độ dài(ngăn) - 1;
            khung = ngăn[vị trí];
            nếu (khung["cuối"] != -1) {
                ném "biên dịch phát mã: trùng nhánh khác";
            };
            cuối = máy ảo lấy độ dài(thô);
            mình.biên dịch phát mã lệnh(thô, biên dịch mã thao tác("OP_JUMP"), 0, 0, 0);
            lệnh sai = thô[khung["sai"]];
            lệnh sai[1] = máy ảo lấy độ dài(thô);
            thô[khung["sai"]] = lệnh sai;
            khung["cuối"] = cuối;
            ngăn[vị trí] = khung;
            trả về đúng;
        };
        nếu (mã == "kết thúc nếu") {
            ngăn = trạng thái["nhánh nếu"];
            nếu (máy ảo lấy độ dài(ngăn) == 0) {
                ném "biên dịch phát mã: kết thúc nếu thiếu điều kiện";
            };
            vị trí = máy ảo lấy độ dài(ngăn) - 1;
            khung = ngăn[vị trí];
            vị trí nhảy = khung["sai"];
            nếu (khung["cuối"] != -1) { vị trí nhảy = khung["cuối"]; };
            lệnh nhảy = thô[vị trí nhảy];
            lệnh nhảy[1] = máy ảo lấy độ dài(thô);
            thô[vị trí nhảy] = lệnh nhảy;
            máy ảo xóa vị trí danh sách(ngăn, vị trí);
            trả về đúng;
        };
        nếu (mã == "bắt đầu chọn") {
            bắt đầu = máy ảo lấy độ dài(thô);
            mình.biên dịch phát mã lệnh(thô, biên dịch mã thao tác("OP_CHON"), 0, 0, 0);
            máy ảo thêm cuối danh sách(trạng thái["chọn"], {"bắt đầu": bắt đầu, "nhánh trước": -1});
            máy ảo thêm cuối danh sách(trạng thái["phạm vi thoát"], "chọn");
            trả về đúng;
        };
        nếu (mã == "ca" || mã == "mặc định") {
            ngăn = trạng thái["chọn"];
            nếu (máy ảo lấy độ dài(ngăn) == 0) { ném "biên dịch phát mã: ca ngoài chọn"; };
            i = máy ảo lấy độ dài(ngăn) - 1;
            khung = ngăn[i];
            trước = khung["nhánh trước"];
            nếu (trước != -1) {
                lệnh trước = thô[trước];
                lệnh trước[3] = máy ảo lấy độ dài(thô);
                thô[trước] = lệnh trước;
            };
            nhánh mới = máy ảo lấy độ dài(thô);
            nếu (mã == "mặc định") {
                mình.biên dịch phát mã lệnh(thô, biên dịch mã thao tác("OP_MAC_DINH"), 0, 0, 0);
            } hoặc {
                nhãn = giá trị;
                loại nhãn = lấy từ điển(nhãn, "loại", "");
                nếu (loại nhãn == "tên") {
                    ô nhớ = mình.biên dịch phát mã ô nhớ mục ký hiệu(trạng thái, nhãn["giá trị"], mục ký hiệu);
                    mình.biên dịch phát mã lệnh(thô, biên dịch mã thao tác("OP_CA"), ô nhớ, -2, 0);
                } hoặc {
                    kiểu = lấy từ điển(nhãn, "kiểu", "");
                    nếu (kiểu == "số nguyên") {
                        mình.biên dịch phát mã lệnh(thô, biên dịch mã thao tác("OP_CA"),
                            thành số nguyên(nhãn["giá trị"]), -1, 0);
                    } hoặc {
                        nếu (kiểu != "chuỗi") {
                            ném "biên dịch phát mã: nhãn ca chưa hỗ trợ";
                        };
                        chuỗi = mình.biên dịch phát mã tách chuỗi(nhãn["giá trị"]);
                        vị trí chuỗi = mình.biên dịch phát mã lưu chuỗi(trạng thái, chuỗi);
                        mình.biên dịch phát mã lệnh(thô, biên dịch mã thao tác("OP_CA"), 0, vị trí chuỗi, 0);
                    };
                };
            };
            khung["nhánh trước"] = nhánh mới;
            ngăn[i] = khung;
            trả về đúng;
        };
        nếu (mã == "kết thúc chọn") {
            ngăn = trạng thái["chọn"];
            nếu (máy ảo lấy độ dài(ngăn) == 0) { ném "biên dịch phát mã: chọn chưa mở"; };
            i = máy ảo lấy độ dài(ngăn) - 1;
            khung = ngăn[i];
            nếu (khung["nhánh trước"] != -1) {
                trước = khung["nhánh trước"];
                lệnh trước = thô[trước];
                lệnh trước[3] = máy ảo lấy độ dài(thô);
                thô[trước] = lệnh trước;
            };
            mở = khung["bắt đầu"];
            lệnh mở = thô[mở];
            lệnh mở[1] = máy ảo lấy độ dài(thô);
            thô[mở] = lệnh mở;
            mình.biên dịch phát mã lệnh(thô, biên dịch mã thao tác("OP_KET_THUC_CHUYEN"), 0, 0, 0);
            máy ảo xóa vị trí danh sách(ngăn, i);
            phạm vi = trạng thái["phạm vi thoát"];
            máy ảo xóa vị trí danh sách(phạm vi, máy ảo lấy độ dài(phạm vi) - 1);
            trả về đúng;
        };
        nếu (mã == "bắt đầu lặp" || mã == "bắt đầu khi") {
            nếu (mã == "bắt đầu lặp") {
                ô nhớ = mình.biên dịch phát mã ô nhớ mục ký hiệu(trạng thái, giá trị, mục ký hiệu);
                mình.biên dịch phát mã lệnh(thô, biên dịch mã thao tác("OP_KHOI_TAO"), 0, ô nhớ, 0);
            };
            máy ảo thêm cuối danh sách(trạng thái["lặp"], {"điều kiện": -1, "nhảy ra": -1,
                                     "khối": trạng thái["độ sâu khối"],
                                     "thử": trạng thái["độ sâu thử"],
                                     "thoát": []});
            máy ảo thêm cuối danh sách(trạng thái["phạm vi thoát"], "lặp");
            trả về đúng;
        };
        nếu (mã == "vào lặp") {
            mình.biên dịch phát mã lệnh(thô, biên dịch mã thao tác("OP_LAP"), 0, 0, 0);
            trả về đúng;
        };
        nếu (mã == "điều kiện lặp") {
            ngăn = trạng thái["lặp"];
            i = máy ảo lấy độ dài(ngăn) - 1;
            khung = ngăn[i];
            khung["điều kiện"] = máy ảo lấy độ dài(thô);
            ngăn[i] = khung;
            mình.biên dịch phát mã lệnh(thô, biên dịch mã thao tác("OP_DIEU_KIEN"), 0, 0, 0);
            trả về đúng;
        };
        nếu (mã == "nhảy nếu sai lặp") {
            ngăn = trạng thái["lặp"];
            i = máy ảo lấy độ dài(ngăn) - 1;
            khung = ngăn[i];
            khung["nhảy ra"] = máy ảo lấy độ dài(thô);
            ngăn[i] = khung;
            mình.biên dịch phát mã lệnh(thô, biên dịch mã thao tác("OP_JUMP_IF_FALSE"), 0, 0, 0);
            trả về đúng;
        };
        nếu (mã == "cập nhật lặp") {
            mình.biên dịch phát mã lệnh(thô, biên dịch mã thao tác("OP_CAP_NHAT"), 0, 0, 0);
            trả về đúng;
        };
        nếu (mã == "kết thúc lặp") {
            ngăn = trạng thái["lặp"];
            i = máy ảo lấy độ dài(ngăn) - 1;
            khung = ngăn[i];
            mình.biên dịch phát mã lệnh(thô, biên dịch mã thao tác("OP_JUMP"), khung["điều kiện"], 0, 0);
            kết thúc = máy ảo lấy độ dài(thô);
            lệnh sai = thô[khung["nhảy ra"]];
            lệnh sai[1] = kết thúc;
            thô[khung["nhảy ra"]] = lệnh sai;
            các thoát = khung["thoát"];
            lặp(j = 0; j < máy ảo lấy độ dài(các thoát); j++) {
                vị trí = các thoát[j];
                lệnh thoát = thô[vị trí];
                lệnh thoát[1] = kết thúc;
                thô[vị trí] = lệnh thoát;
            };
            máy ảo xóa vị trí danh sách(ngăn, i);
            phạm vi = trạng thái["phạm vi thoát"];
            máy ảo xóa vị trí danh sách(phạm vi, máy ảo lấy độ dài(phạm vi) - 1);
            trả về đúng;
        };
        nếu (mã == "thoát") {
            phạm vi = trạng thái["phạm vi thoát"];
            nếu (máy ảo lấy độ dài(phạm vi) == 0) { ném "biên dịch phát mã: thoát ngoài vòng lặp/chọn"; };
            nếu (phạm vi[máy ảo lấy độ dài(phạm vi) - 1] == "lặp") {
                ngăn = trạng thái["lặp"];
                i = máy ảo lấy độ dài(ngăn) - 1;
                khung = ngăn[i];
                khối = trạng thái["độ sâu khối"] - khung["khối"];
                lượt thử đang mở = trạng thái["độ sâu thử"] - khung["thử"];
                máy ảo thêm cuối danh sách(khung["thoát"], máy ảo lấy độ dài(thô));
                ngăn[i] = khung;
                mình.biên dịch phát mã lệnh(thô, biên dịch mã thao tác("OP_THOAT"), 0,
                                      -1 - khối, lượt thử đang mở);
            } hoặc {
                mình.biên dịch phát mã lệnh(thô, biên dịch mã thao tác("OP_THOAT"), 0, 0, 0);
            };
            trả về đúng;
        };
        nếu (mã == "bỏ qua") {
            mình.biên dịch phát mã lệnh(thô, biên dịch mã thao tác("OP_BO_QUA"), 0, 0, 0);
            trả về đúng;
        };
        nếu (mã == "bắt đầu thử") {
            bắt đầu = máy ảo lấy độ dài(thô);
            mình.biên dịch phát mã lệnh(thô, biên dịch mã thao tác("OP_THU"), 0, -1, 0);
            máy ảo thêm cuối danh sách(trạng thái["thử"], {"bắt đầu": bắt đầu, "kết thúc thân": -1});
            trạng thái["độ sâu thử"] = trạng thái["độ sâu thử"] + 1;
            trả về đúng;
        };
        nếu (mã == "bắt lỗi") {
            ngăn = trạng thái["thử"];
            nếu (máy ảo lấy độ dài(ngăn) == 0) { ném "biên dịch phát mã: bắt lỗi thiếu thử"; };
            i = máy ảo lấy độ dài(ngăn) - 1;
            khung = ngăn[i];
            nếu (khung["kết thúc thân"] != -1) {
                ném "biên dịch phát mã: trùng bắt lỗi";
            };
            kết thúc = máy ảo lấy độ dài(thô);
            mình.biên dịch phát mã lệnh(thô, biên dịch mã thao tác("OP_THU_KET_THUC"), 0, 0, 0);
            trạng thái["độ sâu thử"] = trạng thái["độ sâu thử"] - 1;
            mở = khung["bắt đầu"];
            lệnh mở = thô[mở];
            lệnh mở[1] = máy ảo lấy độ dài(thô);
            ô nhớ = -1;
            nếu (giá trị != "") {
                ô nhớ = mình.biên dịch phát mã ô nhớ mục ký hiệu(trạng thái, giá trị, mục ký hiệu);
            };
            thô[mở] = lệnh mở;
            mình.biên dịch phát mã lệnh(thô, biên dịch mã thao tác("OP_BAT_LOI"), 0, ô nhớ, 0);
            khung["kết thúc thân"] = kết thúc;
            ngăn[i] = khung;
            trả về đúng;
        };
        nếu (mã == "kết thúc thử") {
            ngăn = trạng thái["thử"];
            nếu (máy ảo lấy độ dài(ngăn) == 0) { ném "biên dịch phát mã: thử chưa mở"; };
            i = máy ảo lấy độ dài(ngăn) - 1;
            khung = ngăn[i];
            nếu (khung["kết thúc thân"] == -1) {
                ném "biên dịch phát mã: thử thiếu bắt lỗi";
            };
            kết thúc = khung["kết thúc thân"];
            lệnh kết thúc = thô[kết thúc];
            lệnh kết thúc[1] = máy ảo lấy độ dài(thô);
            thô[kết thúc] = lệnh kết thúc;
            máy ảo xóa vị trí danh sách(ngăn, i);
            trả về đúng;
        };
        nếu (mã == "ném") {
            mình.biên dịch phát mã lệnh(thô, biên dịch mã thao tác("OP_NEM"), 0, 0, 0);
            trả về đúng;
        };
        nếu (mã == "mở khối") {
            mình.biên dịch phát mã lệnh(thô, biên dịch mã thao tác("OP_MO_KHOI"), 0, 0, 0);
            trạng thái["độ sâu khối"] = trạng thái["độ sâu khối"] + 1;
            trả về đúng;
        };
        nếu (mã == "đóng khối") {
            mình.biên dịch phát mã lệnh(thô, biên dịch mã thao tác("OP_DONG_KHOI"), 0, 0, 0);
            trạng thái["độ sâu khối"] = trạng thái["độ sâu khối"] - 1;
            trả về đúng;
        };
        nếu (mã == "in") {
            mình.biên dịch phát mã lệnh(thô, biên dịch mã thao tác("OP_IN"), 0, 0, 0);
            trả về đúng;
        };
        nếu (mã == "trả về") {
            mình.biên dịch phát mã lệnh(thô, biên dịch mã thao tác("OP_TRA_VE"), 0, 0, 0);
            trả về đúng;
        };
        ném "biên dịch phát mã: lệnh IR chưa hỗ trợ '" + mã + "'";
    };

    hàm riêng tư biên dịch phát mã danh sách(các lệnh, trạng thái, thô) {
        lặp(i = 0; i < máy ảo lấy độ dài(các lệnh); i++) {
            mình.biên dịch phát mã IR một(các lệnh[i], trạng thái, thô);
        };
    };

    // Emitter C++ biên dịch module phụ thuộc ngay tại câu lệnh import, dùng
    // chung StringPool. Không thể phát toàn bộ initializer theo postorder
    // trước vì như vậy index của literal xen kẽ import sẽ bị thay đổi.
    hàm riêng tư biên dịch phát mã nhập đồ thị(sổ, đồ thị, phiên, tên mô đun, mục, trạng thái) {
        đích = biên dịch đồ thị tìm đích(đồ thị, tên mô đun, mục["đích"]);
        cạnh = đồ thị["cạnh"];
        dùng = phiên["cạnh dùng"];
        vị trí = -1;
        lặp(i = 0; i < máy ảo lấy độ dài(cạnh); i++) {
            e = cạnh[i];
            nếu (e["nguồn"] == tên mô đun && e["đích"] == đích &&
                e["bí danh"] == mục["bí danh"] &&
                e["tái xuất"] == mục["tái xuất"]) {
                có = sai;
                lặp(j = 0; j < máy ảo lấy độ dài(dùng); j++) {
                    nếu (dùng[j] == i) { có = đúng; };
                };
                nếu (!có && vị trí == -1) { vị trí = i; };
            };
        };
        nếu (vị trí == -1) {
            ném "biên dịch phát mã: không khớp cạnh nhập '" + tên mô đun + "' -> '" + đích + "'";
        };
        máy ảo thêm cuối danh sách(dùng, vị trí);
        e = cạnh[vị trí];
        nếu (e["hành động"] == "duplicate_no_op") { trả về đúng; };
        nếu (e["hành động"] != "load") {
            ném "biên dịch phát mã: hành động nhập không hỗ trợ";
        };

        phụ thuộc = biên dịch sổ tìm mô đun(sổ["mô đun"], đích);
        cây = biên dịch kiểu cây(sổ, đồ thị, đích);
        biểu diễn trung gian = biên dịch hạ IR từ cây thuần(cây, đúng);
        phần = mình.biên dịch phát mã trung gian IR đồ thị lõi(biểu diễn trung gian, sổ, phụ thuộc, đồ thị, phiên);
        máy ảo thêm cuối danh sách(phiên["đã phát"], {"định danh": đích, "phần": phần});

        // C++ đặt tên runtime của các hàm sau khi compile xong module.
        bí danh = e["bí danh"];
        nếu (bí danh != "") {
            trực tiếp = phụ thuộc["trực tiếp"];
            lặp(i = 0; i < máy ảo lấy độ dài(trực tiếp); i++) {
                biên dịch sổ đổi tên chạy(sổ, trực tiếp[i]["id"],
                    bí danh + "." + trực tiếp[i]["tên"]);
            };
            xuất = phụ thuộc["xuất"];
            lặp(i = 0; i < máy ảo lấy độ dài(xuất); i++) {
                biên dịch sổ đổi tên chạy(sổ, xuất[i]["id"],
                    bí danh + "." + xuất[i]["tên"]);
            };
            // C++ cũng đổi tên runtime của method được tạo trong mô-đun.
            // Cấp chuỗi bí danh ngay tại import để StringPool của root ổn định.
            danh sách hàm phụ = phần["hàm"];
            lặp(i = 0; i < máy ảo lấy độ dài(danh sách hàm phụ); i++) {
                nếu (lấy từ điển(danh sách hàm phụ[i], "phương thức", sai)) {
                    biên dịch sổ đổi tên chạy(sổ, danh sách hàm phụ[i]["id"],
                        bí danh + "." + danh sách hàm phụ[i]["tên"]);
                };
            };
        };
        các ô nhớ = trạng thái["slots"];
        lặp(i = máy ảo lấy độ dài(các ô nhớ); i <= phiên["id tối đa"]; i++) {
            máy ảo thêm cuối danh sách(các ô nhớ, "");
        };
        trả về đúng;
    };

    // Thân phương thức có receiver ngầm (mình/gốc) ở trước các tham số thường.
    // C++ chỉ tạo binding receiver khi phương thức thật sự tham chiếu tới nó.
    hàm riêng tư biên dịch phát mã thân phương thức(danh sách hàm biểu diễn trung gian, trạng thái) {
        thân = [];
        mình.biên dịch phát mã lệnh(thân, biên dịch mã thao tác("OP_MO_KHOI"), 0, 0, 0);
        nhận = lấy từ điển(danh sách hàm biểu diễn trung gian, "nhận ngầm", []);
        nhận các mã định danh = lấy từ điển(danh sách hàm biểu diễn trung gian, "nhận symbol", []);
        lặp(j = 0; j < máy ảo lấy độ dài(nhận); j++) {
            ô nhớ = mình.biên dịch phát mã ô nhớ mục ký hiệu(trạng thái, nhận[j], nhận các mã định danh[j]);
            mình.biên dịch phát mã lệnh(thân, biên dịch mã thao tác("OP_KHOI_TAO"), 0, ô nhớ, 0);
            mình.biên dịch phát mã lệnh(thân, biên dịch mã thao tác("OP_PARAM"), 0, ô nhớ, -1);
        };
        tham số = lấy từ điển(danh sách hàm biểu diễn trung gian, "tham số", []);
        mặc định = lấy từ điển(danh sách hàm biểu diễn trung gian, "mặc định tham số", []);
        các mã định danh = lấy từ điển(danh sách hàm biểu diễn trung gian, "tham số symbol", []);
        lặp(j = 0; j < máy ảo lấy độ dài(tham số); j++) {
            ô nhớ = mình.biên dịch phát mã ô nhớ mục ký hiệu(trạng thái, tham số[j], các mã định danh[j]);
            mình.biên dịch phát mã lệnh(thân, biên dịch mã thao tác("OP_KHOI_TAO"), 0, ô nhớ, 0);
            có mặc định = sai;
            nếu (j < máy ảo lấy độ dài(mặc định)) { có mặc định = mặc định[j] != rỗng; };
            nếu (có mặc định) {
                mã mặc định = mình.biên dịch phát mã lưu chuỗi(trạng thái,
                    mình.biên dịch phát mã mặc định(mặc định[j]));
                mình.biên dịch phát mã lệnh(thân, biên dịch mã thao tác("OP_PARAM_MAC_DINH"), mã mặc định, ô nhớ, j);
            } hoặc {
                mình.biên dịch phát mã lệnh(thân, biên dịch mã thao tác("OP_PARAM"), 0, ô nhớ, j);
            };
        };
        mình.biên dịch phát mã danh sách(danh sách hàm biểu diễn trung gian["lệnh"], trạng thái, thân);
        nếu (máy ảo lấy độ dài(trạng thái["nhánh nếu"]) != 0 ||
            máy ảo lấy độ dài(trạng thái["chọn"]) != 0 || máy ảo lấy độ dài(trạng thái["thử"]) != 0 ||
            máy ảo lấy độ dài(trạng thái["lặp"]) != 0 || máy ảo lấy độ dài(trạng thái["phạm vi thoát"]) != 0 ||
            máy ảo lấy độ dài(trạng thái["gọi thành viên"]) != 0 ||
            máy ảo lấy độ dài(trạng thái["gán thành viên"]) != 0) {
            ném "biên dịch phát mã: khối phương thức chưa đóng";
        };
        mình.biên dịch phát mã lệnh(thân, biên dịch mã thao tác("OP_DONG_KHOI"), 0, 0, 0);
        trả về biên dịch mã trung gian từ thô(thân);
    };

    // Tôn trọng thứ tự C++: lớp cha, OP_TAO_LOP, rồi từng OP_HAM và
    // OP_THEM_PHUONG_THUC. Function ID của method cấp tại đây.
    hàm riêng tư biên dịch phát mã lớp(biểu diễn trung gian, chỉ số, trạng thái, sổ, các hàm, đỉnh, phiên) {
        khai lớp = biểu diễn trung gian["lớp"][chỉ số];
        tên lớp = khai lớp["tên"];
        đã phát = trạng thái["lớp đã phát"];
        lặp(i = 0; i < máy ảo lấy độ dài(đã phát); i++) {
            nếu (đã phát[i] == tên lớp) { trả về đúng; };
        };
        kiểu lớp cha = lấy từ điển(khai lớp, "lớp cha", "");
        nếu (kiểu lớp cha != "") {
            có cha = sai;
            kiểu lớp khác = biểu diễn trung gian["lớp"];
            lặp(i = 0; i < máy ảo lấy độ dài(kiểu lớp khác); i++) {
                nếu (kiểu lớp khác[i]["tên"] == kiểu lớp cha) {
                    mình.biên dịch phát mã lớp(biểu diễn trung gian, i, trạng thái, sổ, các hàm, đỉnh, phiên);
                    có cha = đúng;
                    thoát;
                };
            };
            nếu (!có cha) {
                kiểu lớp nhập = lấy từ điển(trạng thái, "lớp nhập", []);
                lặp(i = 0; i < máy ảo lấy độ dài(kiểu lớp nhập); i++) {
                    nếu (kiểu lớp nhập[i]["tên"] == kiểu lớp cha) {
                        kiểu lớp cha = kiểu lớp nhập[i]["runtime"];
                        có cha = đúng;
                        thoát;
                    };
                };
            };
            nếu (!có cha) { ném "biên dịch phát mã: thiếu lớp cha '" + kiểu lớp cha + "'"; };
        };
        máy ảo thêm cuối danh sách(đã phát, tên lớp);
        tên chỉ mục = mình.biên dịch phát mã lưu chuỗi(trạng thái, tên lớp);
        cha chỉ mục = 0;
        nếu (kiểu lớp cha != "") {
            cha chỉ mục = mình.biên dịch phát mã lưu chuỗi(trạng thái, kiểu lớp cha) + 1;
        };
        mình.biên dịch phát mã lệnh(đỉnh, biên dịch mã thao tác("OP_TAO_LOP"), 0, tên chỉ mục, cha chỉ mục);
        phương thức = khai lớp["phương thức"];
        lặp(i = 0; i < máy ảo lấy độ dài(phương thức); i++) {
            danh sách hàm biểu diễn trung gian = biểu diễn trung gian["hàm"][phương thức[i]];
            tên hàm = danh sách hàm biểu diễn trung gian["tên"];
            mã định danh = -1;
            nếu (lấy từ điển(phiên, "đa mô đun", sai)) {
                mã định danh = biên dịch sổ tìm hàm trực tiếp(sổ, trạng thái["mô đun"], tên hàm);
            } hoặc {
                mã định danh = biên dịch sổ cấp hàm(sổ, "", tên hàm);
            };
            các ô nhớ = trạng thái["slots"];
            lặp(j = máy ảo lấy độ dài(các ô nhớ); j <= mã định danh; j++) { máy ảo thêm cuối danh sách(các ô nhớ, ""); };
            các ô nhớ[mã định danh] = tên hàm;
            tên hàm chỉ mục = mình.biên dịch phát mã lưu chuỗi(trạng thái, tên hàm);
            nếu (lấy từ điển(sổ, "hoãn chuỗi", sai)) {
                bản ghi = sổ["hàm"][mã định danh];
                bản ghi["tên index"] = tên hàm chỉ mục;
                bản ghi["tên index runtime"] = tên hàm chỉ mục;
                sổ["hàm"][mã định danh] = bản ghi;
            };
            thân = mình.biên dịch phát mã thân phương thức(danh sách hàm biểu diễn trung gian, trạng thái);
            máy ảo thêm cuối danh sách(các hàm, {"tên": tên hàm, "id": mã định danh,
                           "tên index": tên hàm chỉ mục, "bytecode": thân,
                           "phương thức": đúng});
            mình.biên dịch phát mã lệnh(đỉnh, biên dịch mã thao tác("OP_HAM"), tên hàm chỉ mục, mã định danh, 0);
            tên phương thức = mình.biên dịch phát mã lưu chuỗi(trạng thái, danh sách hàm biểu diễn trung gian["tên ngắn"]);
            chức năng mã định danh = mã định danh;
            chỉ mục lớp = tên chỉ mục;
            nếu (danh sách hàm biểu diễn trung gian["phạm vi"] == "riêng tư") { chức năng mã định danh = 0 - mã định danh - 1; };
            nếu (danh sách hàm biểu diễn trung gian["phạm vi"] == "bảo vệ") { chỉ mục lớp = 0 - tên chỉ mục - 1; };
            mình.biên dịch phát mã lệnh(đỉnh, biên dịch mã thao tác("OP_THEM_PHUONG_THUC"),
                                 chỉ mục lớp, tên phương thức, chức năng mã định danh);
            nếu (lấy từ điển(phiên, "đa mô đun", sai)) {
                nếu (mã định danh > phiên["id tối đa"]) {
                    phiên["id tối đa"] = mã định danh;
                };
            };
        };
        trả về đúng;
    };

    // Emitter dùng global function ID/StringPool; tạo bảng slot RIÊNG cho
    // mỗi module, với vị trí function slot đúng ID toàn phiên của C++.
    // `mô_đun` phải được đăng ký trong sổ trước khi gọi hàm này.
    hàm công khai biên dịch phát mã trung gian IR đồ thị lõi(biểu diễn trung gian, sổ, mô đun, đồ thị, phiên) {
        nếu (lấy từ điển(biểu diễn trung gian, "loại", "") != "chương trình IR") {
            ném "biên dịch phát mã: cần chương trình IR";
        };
        tên mô đun = lấy từ điển(mô đun, "định danh", "");
        trực tiếp = lấy từ điển(mô đun, "trực tiếp", []);
        các hàm biểu diễn trung gian = lấy từ điển(biểu diễn trung gian, "hàm", []);
        số toàn cục = 0;
        thứ tự = lấy từ điển(biểu diễn trung gian, "thứ tự", []);
        lặp(i = 0; i < máy ảo lấy độ dài(thứ tự); i++) {
            nếu (thứ tự[i]["loại"] == "hàm") { số toàn cục += 1; };
        };
        nếu (máy ảo lấy độ dài(trực tiếp) != số toàn cục) {
            ném "biên dịch phát mã: sổ hàm khác IR trong '" + tên mô đun + "'";
        };
        // Cấp descriptor ID cho toàn phiên trước khi phát thân hàm. Khi
        // import lồng nhau, cùng một registry được truyền qua mọi module.
        nếu (!máy ảo có khóa từ điển(phiên, "ngoại")) { phiên["ngoại"] = []; };
        toàn phiên = phiên["ngoại"];
        ngoại cục bộ = [];
        khai ngoại = lấy từ điển(biểu diễn trung gian, "ngoại", []);
        lặp(i = 0; i < máy ảo lấy độ dài(khai ngoại); i++) {
            bản ghi = khai ngoại[i];
            bản ghi["id"] = máy ảo lấy độ dài(toàn phiên);
            máy ảo thêm cuối danh sách(toàn phiên, bản ghi);
            máy ảo thêm cuối danh sách(ngoại cục bộ, bản ghi);
        };
        các ô nhớ = [];
        danh sách hàm đã khai = [];
        danh sách hàm các mã định danh = [];
        các hàm = [];
        // C++ emitter giữ namespace slot riêng và nextSlot ít nhất bằng
        // function ID lớn nhất của các hàm được predeclare trong module.
        lặp(i = 0; i < số toàn cục; i++) {
            tên hàm = lấy từ điển(các hàm biểu diễn trung gian[i], "tên", "");
            khai = trực tiếp[i];
            mã định danh = khai["id"];
            nếu (tên hàm == "" || tên hàm != khai["tên"] ||
                mã định danh < 0 || mã định danh >= máy ảo lấy độ dài(sổ["hàm"]) ||
                sổ["hàm"][mã định danh]["tên"] != tên hàm) {
                ném "biên dịch phát mã: function ID/tên không khớp sổ";
            };
            lặp(j = máy ảo lấy độ dài(các ô nhớ); j <= mã định danh; j++) { máy ảo thêm cuối danh sách(các ô nhớ, ""); };
            nếu (các ô nhớ[mã định danh] != "") {
                ném "biên dịch phát mã: trùng function slot";
            };
            các ô nhớ[mã định danh] = tên hàm;
            máy ảo thêm cuối danh sách(danh sách hàm đã khai, tên hàm);
            máy ảo thêm cuối danh sách(danh sách hàm các mã định danh, mã định danh);
            // Global pool được truyền bằng tham chiếu từ phiên biên dịch;
            // predeclare của mỗi module lưu tên trước khi phát lệnh/thân.
            tên chỉ mục = biên dịch sổ lưu chuỗi(sổ, tên hàm);
            nếu (lấy từ điển(phiên, "đa mô đun", sai)) {
                nếu (mã định danh > phiên["id tối đa"]) {
                    phiên["id tối đa"] = mã định danh;
                };
            };
            nếu (lấy từ điển(sổ, "hoãn chuỗi", sai)) {
                bản ghi = sổ["hàm"][mã định danh];
                bản ghi["tên index"] = tên chỉ mục;
                bản ghi["tên index runtime"] = tên chỉ mục;
                sổ["hàm"][mã định danh] = bản ghi;
            };
            máy ảo thêm cuối danh sách(các hàm, {"tên": tên hàm, "id": mã định danh, "tên index": tên chỉ mục,
                            "bytecode": []});
        };
        kiểu lớp đã khai = [];
        lặp(i = 0; i < máy ảo lấy độ dài(lấy từ điển(biểu diễn trung gian, "lớp", [])); i++) {
            máy ảo thêm cuối danh sách(kiểu lớp đã khai, biểu diễn trung gian["lớp"][i]["tên"]);
        };
        trạng thái = {"slots": các ô nhớ, "khóa slots": [], "chuỗi": sổ["chuỗi"],
                      "sổ hàm": sổ, "hàm ẩn danh": [],
                      "chỉ mục chuỗi": lấy từ điển(sổ, "chỉ mục chuỗi", {}),
                      "mô đun": tên mô đun,
                      "ngoại": ngoại cục bộ,
                      "nhánh nếu": [], "chọn": [], "thử": [],
                      "gọi thành viên": [], "gán thành viên": [],
                      "lớp đã khai": kiểu lớp đã khai, "lớp đã phát": [],
                      "lớp nhập": biên dịch kiểu lớp chạy(sổ, mô đun),
                      "hàm đã khai": danh sách hàm đã khai, "hàm các mã định danh": danh sách hàm các mã định danh,
                      "hàm nhìn thấy": lấy từ điển(mô đun, "nhìn thấy", []),
                      "liên mô đun": tên mô đun != "",
                      "lặp": [], "phạm vi thoát": [],
                      "độ sâu khối": 0, "độ sâu thử": 0};
        đỉnh = [];
        tất cả lệnh = lấy từ điển(biểu diễn trung gian, "lệnh", []);
        thứ tự = lấy từ điển(biểu diễn trung gian, "thứ tự", []);
        // C++ duyệt từng top-level statement theo thứ tự nguồn sau bước
        // predeclareFunctions. Điều này quyết định thứ tự slot và StringPool.
        lặp(i = 0; i < máy ảo lấy độ dài(thứ tự); i++) {
            mục = thứ tự[i];
            nếu (mục["loại"] == "nhập") {
                nếu (!lấy từ điển(phiên, "đa mô đun", sai)) {
                    ném "biên dịch phát mã: câu lệnh nhập thiếu phiên đồ thị";
                };
                mình.biên dịch phát mã nhập đồ thị(sổ, đồ thị, phiên,
                    tên mô đun, mục, trạng thái);
            } hoặc {
            nếu (mục["loại"] == "lớp") {
                mình.biên dịch phát mã lớp(biểu diễn trung gian, mục["chỉ số"], trạng thái, sổ, các hàm, đỉnh, phiên);
            } hoặc {
            nếu (mục["loại"] == "hàm") {
                local mã định danh = mục["chỉ số"];
                mã định danh = danh sách hàm các mã định danh[local mã định danh];
                danh sách hàm biểu diễn trung gian = các hàm biểu diễn trung gian[local mã định danh];
                thân = [];
                mình.biên dịch phát mã lệnh(thân, biên dịch mã thao tác("OP_MO_KHOI"), 0, 0, 0);
                tham số = lấy từ điển(danh sách hàm biểu diễn trung gian, "tham số", []);
                mặc định = lấy từ điển(danh sách hàm biểu diễn trung gian, "mặc định tham số", []);
                tham số các mã định danh = lấy từ điển(danh sách hàm biểu diễn trung gian, "tham số symbol", []);
                lặp(j = 0; j < máy ảo lấy độ dài(tham số); j++) {
                    nếu (j >= máy ảo lấy độ dài(tham số các mã định danh)) {
                        ném "biên dịch phát mã: thiếu SymbolId của tham số";
                    };
                    ô nhớ = mình.biên dịch phát mã ô nhớ mục ký hiệu(trạng thái, tham số[j], tham số các mã định danh[j]);
                    mình.biên dịch phát mã lệnh(thân, biên dịch mã thao tác("OP_KHOI_TAO"), 0, ô nhớ, 0);
                    có mặc định = sai;
                    nếu (j < máy ảo lấy độ dài(mặc định)) { có mặc định = mặc định[j] != rỗng; };
                    nếu (có mặc định) {
                        mã mặc định = mình.biên dịch phát mã lưu chuỗi(trạng thái,
                            mình.biên dịch phát mã mặc định(mặc định[j]));
                        mình.biên dịch phát mã lệnh(thân, biên dịch mã thao tác("OP_PARAM_MAC_DINH"), mã mặc định, ô nhớ, j);
                    } hoặc {
                        mình.biên dịch phát mã lệnh(thân, biên dịch mã thao tác("OP_PARAM"), 0, ô nhớ, j);
                    };
                };
                mình.biên dịch phát mã danh sách(lấy từ điển(danh sách hàm biểu diễn trung gian, "lệnh", []), trạng thái, thân);
                nếu (máy ảo lấy độ dài(trạng thái["nhánh nếu"]) != 0 ||
                    máy ảo lấy độ dài(trạng thái["chọn"]) != 0 || máy ảo lấy độ dài(trạng thái["thử"]) != 0 ||
                    máy ảo lấy độ dài(trạng thái["lặp"]) != 0 || máy ảo lấy độ dài(trạng thái["phạm vi thoát"]) != 0) {
                    ném "biên dịch phát mã: khối điều khiển chưa đóng trong hàm";
                };
                mình.biên dịch phát mã lệnh(thân, biên dịch mã thao tác("OP_DONG_KHOI"), 0, 0, 0);
                tên hàm = danh sách hàm biểu diễn trung gian["tên"];
                các hàm[local mã định danh] = {"tên": tên hàm, "id": mã định danh,
                               "tên index": biên dịch sổ lưu chuỗi(sổ, tên hàm),
                               "bytecode": biên dịch mã trung gian từ thô(thân)};
                tên mã định danh = mình.biên dịch phát mã lưu chuỗi(trạng thái, tên hàm);
                mình.biên dịch phát mã lệnh(đỉnh, biên dịch mã thao tác("OP_HAM"), tên mã định danh, mã định danh, 0);
            } hoặc {
                lặp(j = mục["bắt đầu"]; j < mục["kết thúc"]; j++) {
                    mình.biên dịch phát mã IR một(tất cả lệnh[j], trạng thái, đỉnh);
                };
            };
            };
            };
        };
        nếu (máy ảo lấy độ dài(trạng thái["nhánh nếu"]) != 0 ||
            máy ảo lấy độ dài(trạng thái["chọn"]) != 0 || máy ảo lấy độ dài(trạng thái["thử"]) != 0 ||
            máy ảo lấy độ dài(trạng thái["lặp"]) != 0 || máy ảo lấy độ dài(trạng thái["phạm vi thoát"]) != 0) {
            ném "biên dịch phát mã: khối điều khiển chưa đóng trong chương trình";
        };
        ẩn danh = trạng thái["hàm ẩn danh"];
        lặp(i = 0; i < máy ảo lấy độ dài(ẩn danh); i++) { máy ảo thêm cuối danh sách(các hàm, ẩn danh[i]); };
        nếu (máy ảo lấy độ dài(ẩn danh) > 0) {
            // Closure lồng nhau được cấp ID trước khi phát xong thân hàm ngoài.
            lặp(i = 1; i < máy ảo lấy độ dài(các hàm); i++) {
                mục = các hàm[i];
                j = i;
                khi (j > 0) {
                    nếu (các hàm[j - 1]["id"] < mục["id"]) { thoát; };
                    các hàm[j] = các hàm[j - 1];
                    j -= 1;
                };
                các hàm[j] = mục;
            };
        };
        // Giống compilePipeline(..., emitEntryPointCall=false) trong snapshot C++:
        // opcode 44 (halt) và lời gọi entrypoint thuộc bước linker cuối cùng.
        trả về {"loại": "bytecode V++ chưa liên kết",
                "bytecode": biên dịch mã trung gian từ thô(đỉnh),
                "hàm": các hàm,
                "ngoại": ngoại cục bộ,
                "slots": trạng thái["slots"],
                "chuỗi": trạng thái["chuỗi"]};
    };

    // API một đơn vị vẫn dùng emitter tương tự, không có import.
    hàm công khai biên dịch phát mã trung gian IR có sổ(biểu diễn trung gian, sổ, mô đun) {
        trả về mình.biên dịch phát mã trung gian IR đồ thị lõi(biểu diễn trung gian, sổ, mô đun,
            rỗng, {"đa mô đun": sai});
    };

    // Đường tương thích 1 đơn vị, giữ nguyên ABI snapshot C++.
    hàm công khai biên dịch phát mã trung gian thuần(mã nguồn) {
        biểu diễn trung gian = biên dịch hạ IR thuần(mã nguồn);
        trả về mình.biên dịch phát mã trung gian từ IR thuần(biểu diễn trung gian);
    };

    hàm công khai biên dịch phát mã trung gian từ IR thuần(biểu diễn trung gian) {
        sổ = biên dịch đăng ký hàm IR thuần(biểu diễn trung gian);
        trực tiếp = [];
        lặp(i = 0; i < máy ảo lấy độ dài(sổ["hàm"]); i++) {
            máy ảo thêm cuối danh sách(trực tiếp, {"tên": sổ["hàm"][i]["tên"], "id": i});
        };
        trả về mình.biên dịch phát mã trung gian IR có sổ(biểu diễn trung gian, sổ,
            {"định danh": "", "trực tiếp": trực tiếp,
             "nhìn thấy": trực tiếp});
    };
};


hàm công khai biên dịch phát mã tách chuỗi(từ tố) {
    bộ chuyển tiếp = Bộ Phát Bytecode();
    trả về bộ chuyển tiếp.biên dịch phát mã tách chuỗi(từ tố);
};

hàm công khai biên dịch phát mã trung gian IR đồ thị lõi(biểu diễn trung gian, sổ, mô đun, đồ thị, phiên) {
    bộ chuyển tiếp = Bộ Phát Bytecode();
    trả về bộ chuyển tiếp.biên dịch phát mã trung gian IR đồ thị lõi(biểu diễn trung gian, sổ, mô đun, đồ thị, phiên);
};

hàm công khai biên dịch phát mã trung gian IR có sổ(biểu diễn trung gian, sổ, mô đun) {
    bộ chuyển tiếp = Bộ Phát Bytecode();
    trả về bộ chuyển tiếp.biên dịch phát mã trung gian IR có sổ(biểu diễn trung gian, sổ, mô đun);
};

hàm công khai biên dịch phát mã trung gian thuần(mã nguồn) {
    bộ chuyển tiếp = Bộ Phát Bytecode();
    trả về bộ chuyển tiếp.biên dịch phát mã trung gian thuần(mã nguồn);
};

hàm công khai biên dịch phát mã trung gian từ IR thuần(biểu diễn trung gian) {
    bộ chuyển tiếp = Bộ Phát Bytecode();
    trả về bộ chuyển tiếp.biên dịch phát mã trung gian từ IR thuần(biểu diễn trung gian);
};
