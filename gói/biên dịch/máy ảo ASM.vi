// Portable VM image backend. Compilation, validation and serialization are
// V++; the resulting image runs on the standalone V++/ASM interpreter.
nhập gói/biên dịch/sản phẩm biên dịch;
nhập gói/nhập xuất/tệp;
nhập gói/nhập xuất/tệp thô;

hàm riêng tư biên dịch VM i32(bytes, value) {
    // Phần lớn field opcode/slot là số không âm. Tránh bốn lượt nhánh
    // và vòng lặp cho từng i32 trong ảnh compiler nhiều trăm KiB.
    nếu (value >= 0) {
        máy ảo thêm cuối danh sách(bytes, value % 256);
        value = (value - value % 256) / 256;
        máy ảo thêm cuối danh sách(bytes, value % 256);
        value = (value - value % 256) / 256;
        máy ảo thêm cuối danh sách(bytes, value % 256);
        value = (value - value % 256) / 256;
        máy ảo thêm cuối danh sách(bytes, value % 256);
        trả về;
    };
    // Division is truncating: normalize each remainder for negative i32.
    lặp(i = 0; i < 4; i++) {
        byte = value % 256;
        nếu (byte < 0) { byte += 256; };
        máy ảo thêm cuối danh sách(bytes, byte);
        value = (value - byte) / 256;
    };
};

hàm riêng tư biên dịch VM vùng(bytes, code) {
    lặp(i = 0; i < độ dài(code); i++) {
        lặp(j = 0; j < 4; j++) { biên dịch VM i32(bytes, code[i][j]); };
    };
};

hàm công khai biên dịch VM mã hóa(dây) {
    codec = Bộ Mã Hóa Sản Phẩm Biên Dịch(rỗng);
    codec.kiểm tra dây(dây, "bytecode V++ đồ thị đã liên kết");
    nếu (độ dài(dây) == 5) {
        nếu (độ dài(dây[4]) > 0) { ném "VM ASM: descriptor FFI chưa có primitive ASM tương ứng"; };
    };
    bytes = [86, 80, 80, 86, 77, 0, 1, 0];
    biên dịch VM i32(bytes, độ dài(dây[1]));
    biên dịch VM i32(bytes, độ dài(dây[2]));
    biên dịch VM i32(bytes, độ dài(dây[3]));
    biên dịch VM i32(bytes, độ dài(dây[0]));
    lặp(i = 0; i < độ dài(dây[1]); i++) {
        encoded = chuỗi thành byte máy ảo(dây[1][i]);
        biên dịch VM i32(bytes, độ dài(encoded));
        lặp(j = 0; j < độ dài(encoded); j++) { máy ảo thêm cuối danh sách(bytes, encoded[j]); };
    };
    lặp(i = 0; i < độ dài(dây[2]); i++) {
        function = dây[2][i];
        biên dịch VM i32(bytes, function[0]); biên dịch VM i32(bytes, function[1]);
        biên dịch VM i32(bytes, độ dài(function[2])); biên dịch VM vùng(bytes, function[2]);
    };
    lặp(i = 0; i < độ dài(dây[3]); i++) {
        code = dây[3][i][1]; biên dịch VM i32(bytes, độ dài(code)); biên dịch VM vùng(bytes, code);
    };
    biên dịch VM vùng(bytes, dây[0]);
    trả về bytes;
};

// Bound serialized output independently of compiler size. Keeping a complete
// list of boxed bytes alongside the IR exhausts the standalone VM heap.
lớp riêng tư Bộ Ghi Ảnh VM {
    hàm công khai khởi tạo(tệp) { mình.tệp = tệp; mình.khối = []; };
    hàm công khai xả() {
        n = độ dài(mình.khối); đã ghi = 0;
        khi (đã ghi < n) {
            phần = mình.khối;
            nếu (đã ghi > 0) {
                phần = [];
                lặp(i = đã ghi; i < n; i++) { thêm(phần, mình.khối[i]); };
            };
            ghi = máy tệp ghi(mình.tệp, phần, độ dài(phần));
            nếu (ghi < 0 && tệp thô mã lỗi() == tệp thô lỗi gián đoạn()) { bỏ qua; };
            nếu (ghi <= 0) { ném "VM ASM: ghi tệp ảnh thất bại"; };
            đã ghi += ghi;
        };
        mình.khối = [];
    };
    hàm công khai byte(value) {
        thêm(mình.khối, value);
        nếu (độ dài(mình.khối) >= 16384) { mình.xả(); };
    };
    hàm công khai số(value) {
        biên dịch VM i32(mình.khối, value);
        nếu (độ dài(mình.khối) >= 16384) { mình.xả(); };
    };
    hàm công khai vùng(code) {
        lặp(i = 0; i < độ dài(code); i++) {
            lặp(j = 0; j < 4; j++) { mình.số(code[i][j]); };
        };
    };
};

hàm công khai biên dịch VM ghi(dây, đường) {
    codec = Bộ Mã Hóa Sản Phẩm Biên Dịch(rỗng);
    codec.kiểm tra dây(dây, "bytecode V++ đồ thị đã liên kết");
    nếu (độ dài(dây) == 5) {
        nếu (độ dài(dây[4]) > 0) { ném "VM ASM: descriptor FFI chưa có primitive ASM tương ứng"; };
    };
    tệp = tệp thô mở(đường, 1);
    nếu (tệp == rỗng) { ném "VM ASM: không mở được tệp ảnh"; };
    thử {
        ghi = Bộ Ghi Ảnh VM(tệp);
        header = [86, 80, 80, 86, 77, 0, 1, 0];
        lặp(i = 0; i < 8; i++) { ghi.byte(header[i]); };
        ghi.số(độ dài(dây[1])); ghi.số(độ dài(dây[2]));
        ghi.số(độ dài(dây[3])); ghi.số(độ dài(dây[0]));
        lặp(i = 0; i < độ dài(dây[1]); i++) {
            encoded = chuỗi thành byte máy ảo(dây[1][i]);
            ghi.số(độ dài(encoded));
            lặp(j = 0; j < độ dài(encoded); j++) { ghi.byte(encoded[j]); };
        };
        lặp(i = 0; i < độ dài(dây[2]); i++) {
            function = dây[2][i];
            ghi.số(function[0]); ghi.số(function[1]);
            ghi.số(độ dài(function[2])); ghi.vùng(function[2]);
        };
        lặp(i = 0; i < độ dài(dây[3]); i++) {
            code = dây[3][i][1]; ghi.số(độ dài(code)); ghi.vùng(code);
        };
        ghi.vùng(dây[0]); ghi.xả();
    } bắt lỗi(e) {
        tệp thô đóng(tệp); ném e;
    };
    nếu (tệp thô đóng(tệp) != 0) { ném "VM ASM: đóng tệp ảnh thất bại"; };
    trả về "";
};
