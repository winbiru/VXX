// i386: phát byte mã máy kiến trúc riêng.
// Các phép chưa hỗ trợ phải ném lỗi tại bộ chọn lowering, không phát mã sai.
nhập gói.biên dịch.mã máy nền.biên dịch mã máy thêm từ máy;

// Bộ phát không giữ trạng thái, nên cung cấp trực tiếp hàm cấp mô-đun.
hàm công khai biên dịch mã máy phát i386(loại, hằng, thấp, cao, ít, hệ điều hành) {
    ra = [];
    nếu (loại == "hằng") {
        máy ảo thêm cuối danh sách(ra, 184);
        biên dịch mã máy thêm từ máy(ra, hằng, đúng);
    } hoặc {
        nếu (loại == "cộng") { ra = [139, 68, 36, 4, 3, 68, 36, 8]; }
        hoặc { ra = [139, 68, 36, 4, 43, 68, 36, 8]; };
    };
    máy ảo thêm cuối danh sách(ra, 195);
    trả về ra;
};
