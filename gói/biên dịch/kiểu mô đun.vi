// Bảng kiểu của đồ thị: định danh khai báo tách khỏi tên nhìn thấy qua import.
nhập gói/biên dịch/sổ đăng ký;
nhập gói/bộ sưu tập/từ điển;

// Các hàm phụ trợ không giữ trạng thái; Bộ Đăng Ký Kiểu sở hữu sổ và đồ thị.
hàm riêng tư biên dịch kiểu tìm(bảng, tên) {
    lặp(i = 0; i < máy ảo lấy độ dài(bảng); i++) {
        nếu (bảng[i]["tên"] == tên) { trả về bảng[i]["id"]; };
    };
    trả về -1;
};

hàm riêng tư biên dịch kiểu sao(khai, tên) {
    kết quả = {};
    khóa = khóa từ điển(khai);
    lặp(i = 0; i < máy ảo lấy độ dài(khóa); i++) { kết quả[khóa[i]] = khai[khóa[i]]; };
    kết quả["tên"] = tên;
    trả về kết quả;
};

// API cũ vẫn nhận sổ và đồ thị, áp dụng kết quả vào sổ đang được linker dùng.
hàm riêng tư biên dịch kiểu đăng ký(sổ, đồ thị) {
    bộ = Bộ Đăng Ký Kiểu(sổ, đồ thị);
    bộ.đăng ký();
};

hàm công khai biên dịch kiểu cây(sổ, đồ thị, tên mô đun) {
    bộ = Bộ Đăng Ký Kiểu(sổ, đồ thị);
    trả về bộ.cây(tên mô đun);
};

hàm công khai biên dịch kiểu lớp chạy(sổ, mô đun) {
    bộ = Bộ Đăng Ký Kiểu(sổ, rỗng);
    trả về bộ.lớp chạy(mô đun);
};

// Một sổ kiểu sống cùng phiên linker: ID và tên chuẩn thuộc môi trường
// khai báo, còn tên nhìn thấy / tái xuất thuộc từng mô-đun nhập.
lớp công khai Bộ Đăng Ký Kiểu {
    hàm công khai khởi tạo(sổ, đồ thị) {
        mình.sổ = sổ;
        mình.đồ thị = đồ thị;
    };

    hàm riêng tư gom kiểu() {
        sổ = mình.sổ;
        đồ thị = mình.đồ thị;
        các kiểu = [];
        mô đun = sổ["mô đun"];
        cạnh = đồ thị["cạnh"];
        lặp(i = 0; i < máy ảo lấy độ dài(mô đun); i++) {
            mục = mô đun[i];
            tên mô đun = mục["định danh"];
            cây mô đun = biên dịch sổ cây mô đun(đồ thị, tên mô đun);
            lệnh = cây mô đun["câu lệnh"];
            trực = []; thấy = []; xuất = [];
            lặp(j = 0; j < máy ảo lấy độ dài(lệnh); j++) {
                khai = lệnh[j];
                loại = lấy từ điển(khai, "loại", "");
                nếu (loại == "lớp" || loại == "giao diện") {
                    mã định danh = máy ảo lấy độ dài(các kiểu);
                    máy ảo thêm cuối danh sách(các kiểu, {"khai": khai, "mô đun": tên mô đun,
                        "chuẩn": tên mô đun + "::" + khai["tên"], "runtime": khai["tên"]});
                    biên dịch sổ thêm tên(trực, khai["tên"], mã định danh, tên mô đun);
                    biên dịch sổ thêm tên(thấy, khai["tên"], mã định danh, tên mô đun);
                    phạm vi = lấy từ điển(khai, "phạm vi", "");
                    nếu (phạm vi != "riêng tư" && phạm vi != "bảo vệ") {
                        biên dịch sổ thêm tên(xuất, khai["tên"], mã định danh, tên mô đun);
                    };
                };
            };
            lặp(j = 0; j < máy ảo lấy độ dài(cạnh); j++) {
                e = cạnh[j];
                nếu (e["nguồn"] != tên mô đun) { bỏ qua; };
                phụ = biên dịch sổ tìm mô đun(mô đun, e["đích"]);
                bề mặt = lấy từ điển(phụ, "kiểu xuất", []);
                lặp(k = 0; k < máy ảo lấy độ dài(bề mặt); k++) {
                    tên = bề mặt[k]["tên"];
                    nếu (e["bí danh"] != "") { tên = e["bí danh"] + "." + tên; };
                    biên dịch sổ thêm tên(thấy, tên, bề mặt[k]["id"], tên mô đun);
                    nếu (e["tái xuất"]) {
                        biên dịch sổ thêm tên(xuất, tên, bề mặt[k]["id"], tên mô đun);
                    };
                };
            };
            mục["kiểu trực tiếp"] = trực;
            mục["kiểu nhìn thấy"] = thấy;
            mục["kiểu xuất"] = xuất;
        };
        sổ["kiểu"] = các kiểu;
    };

    hàm riêng tư chuẩn hóa() {
        sổ = mình.sổ;
        các kiểu = sổ["kiểu"];
        mô đun = sổ["mô đun"];
        // Quan hệ kế thừa được phân giải trong module khai báo kiểu.
        lặp(i = 0; i < máy ảo lấy độ dài(các kiểu); i++) {
            bản = các kiểu[i];
            mục = biên dịch sổ tìm mô đun(mô đun, bản["mô đun"]);
            khai = biên dịch kiểu sao(bản["khai"], bản["chuẩn"]);
            cha = lấy từ điển(khai, "lớp cha", "");
            nếu (cha != "") {
                mã định danh = biên dịch kiểu tìm(mục["kiểu nhìn thấy"], cha);
                nếu (mã định danh < 0) { ném "biên dịch kiểu: thiếu lớp cha '" + cha + "'"; };
                khai["lớp cha"] = các kiểu[mã định danh]["chuẩn"];
            };
            quan hệ = "triển khai";
            nếu (khai["loại"] == "giao diện") { quan hệ = "giao diện cha"; };
            danh sách giao diện = lấy từ điển(khai, quan hệ, []);
            mới = [];
            lặp(j = 0; j < máy ảo lấy độ dài(danh sách giao diện); j++) {
                mã định danh = biên dịch kiểu tìm(mục["kiểu nhìn thấy"], danh sách giao diện[j]);
                nếu (mã định danh < 0) { ném "biên dịch kiểu: thiếu giao diện '" + danh sách giao diện[j] + "'"; };
                máy ảo thêm cuối danh sách(mới, các kiểu[mã định danh]["chuẩn"]);
            };
            khai[quan hệ] = mới;
            bản["chuẩn hóa"] = khai;
        };
    };

    hàm công khai đăng ký() {
        mình.gom kiểu();
        mình.chuẩn hóa();
    };

    hàm công khai tất cả() {
        trả về lấy từ điển(mình.sổ, "kiểu", []);
    };

    hàm công khai cây(tên mô đun) {
        sổ = mình.sổ;
        cây mô đun = biên dịch sổ cây mô đun(mình.đồ thị, tên mô đun);
        kết quả = biên dịch kiểu sao(cây mô đun, "");
        ngoài = [];
        các kiểu = mình.tất cả();
        lặp(i = 0; i < máy ảo lấy độ dài(các kiểu); i++) {
            máy ảo thêm cuối danh sách(ngoài, các kiểu[i]["chuẩn hóa"]);
        };
        mục = biên dịch sổ tìm mô đun(sổ["mô đun"], tên mô đun);
        thấy = lấy từ điển(mục, "kiểu nhìn thấy", []);
        lặp(i = 0; i < máy ảo lấy độ dài(thấy); i++) {
            bản = các kiểu[thấy[i]["id"]];
            nếu (bản["mô đun"] != tên mô đun) {
                máy ảo thêm cuối danh sách(ngoài, biên dịch kiểu sao(bản["chuẩn hóa"], thấy[i]["tên"]));
            };
        };
        kết quả["kiểu ngoài"] = ngoài;
        trả về kết quả;
    };

    hàm công khai lớp chạy(mô đun) {
        kết quả = [];
        thấy = lấy từ điển(mô đun, "kiểu nhìn thấy", []);
        các kiểu = mình.tất cả();
        lặp(i = 0; i < máy ảo lấy độ dài(thấy); i++) {
            bản = các kiểu[thấy[i]["id"]];
            nếu (bản["khai"]["loại"] == "lớp") {
                máy ảo thêm cuối danh sách(kết quả, {"tên": thấy[i]["tên"], "runtime": bản["runtime"]});
            };
        };
        trả về kết quả;
    };
};
