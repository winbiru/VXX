// loongarch64: phát byte mã máy kiến trúc riêng.
// Các phép chưa hỗ trợ phải ném lỗi tại bộ chọn lowering, không phát mã sai.
nhập gói/biên dịch/mã máy nền;

// Lớp sở hữu toàn bộ thuật toán của mô-đun; các hàm bên dưới chỉ giữ API cũ.
lớp công khai Bộ Phát LOONGARCH64 {
    hàm công khai khởi tạo() {};

    hàm công khai biên dịch mã máy phát loongarch64(loại, hằng, thấp, cao, ít, hệ_điều_hành) {
        ra = [];
        nếu (loại == "hằng") {
                        phần_cao = (hằng - (hằng % 4096)) / 4096;
                        nếu (hằng < 0 && (hằng % 4096) != 0) { phần_cao -= 1; };
                        nếu (phần_cao < 0) { phần_cao += 1048576; };
                        biên dịch mã máy thêm word(ra, biên dịch mã máy word hex("14000004") + phần_cao * 32, ít);
                        biên dịch mã máy thêm word(ra, biên dịch mã máy word hex("03800084") + (hằng % 4096 + 4096) % 4096 * 1024, ít);
                    } hoặc {
                        nếu (loại == "cộng") { biên dịch mã máy thêm hex(ra, "00101484", ít); }
                        hoặc { biên dịch mã máy thêm hex(ra, "00111484", ít); };
                    };
                    biên dịch mã máy thêm hex(ra, "4c000020", ít);
        trả về ra;
    };
};


hàm công khai biên dịch mã máy phát loongarch64(loại, hằng, thấp, cao, ít, hệ_điều_hành) {
    __vpp_adapter = Bộ Phát LOONGARCH64();
    trả về __vpp_adapter.biên dịch mã máy phát loongarch64(loại, hằng, thấp, cao, ít, hệ_điều_hành);
};
