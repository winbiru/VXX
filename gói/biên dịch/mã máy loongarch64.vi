// loongarch64: phát byte mã máy kiến trúc riêng.
// Các phép chưa hỗ trợ phải ném lỗi tại bộ chọn lowering, không phát mã sai.
nhập gói.biên dịch.mã máy nền.biên dịch mã máy từ máy thập lục phân;
nhập gói.biên dịch.mã máy nền.biên dịch mã máy thêm từ máy;
nhập gói.biên dịch.mã máy nền.biên dịch mã máy thêm thập lục phân;

// Lớp sở hữu toàn bộ thuật toán của mô-đun; các hàm bên dưới chỉ giữ API cũ.
lớp công khai Bộ Phát LOONGARCH64 {
    hàm công khai khởi tạo() {};

    hàm công khai biên dịch mã máy phát loongarch64(loại, hằng, thấp, cao, ít, hệ điều hành) {
        ra = [];
        nếu (loại == "hằng") {
                        phần cao = (hằng - (hằng % 4096)) / 4096;
                        nếu (hằng < 0 && (hằng % 4096) != 0) { phần cao -= 1; };
                        nếu (phần cao < 0) { phần cao += 1048576; };
                        biên dịch mã máy thêm từ máy(ra, biên dịch mã máy từ máy thập lục phân("14000004") + phần cao * 32, ít);
                        biên dịch mã máy thêm từ máy(ra, biên dịch mã máy từ máy thập lục phân("03800084") + (hằng % 4096 + 4096) % 4096 * 1024, ít);
                    } hoặc {
                        nếu (loại == "cộng") { biên dịch mã máy thêm thập lục phân(ra, "00101484", ít); }
                        hoặc { biên dịch mã máy thêm thập lục phân(ra, "00111484", ít); };
                    };
                    biên dịch mã máy thêm thập lục phân(ra, "4c000020", ít);
        trả về ra;
    };
};


hàm công khai biên dịch mã máy phát loongarch64(loại, hằng, thấp, cao, ít, hệ điều hành) {
    bộ chuyển tiếp = Bộ Phát LOONGARCH64();
    trả về bộ chuyển tiếp.biên dịch mã máy phát loongarch64(loại, hằng, thấp, cao, ít, hệ điều hành);
};
