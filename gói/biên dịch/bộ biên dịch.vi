// Một phiên phân tích giữ snapshot dùng chung cho mọi phép truy vấn.
// Mỗi phiên phân tích một lần; API hàm tự do ở chính.vi vẫn tương thích.
nhập gói.bộ sưu tập.từ điển.lấy từ điển;
nhập gói.biên dịch.kết quả.biên dịch snapshot nội bộ;
nhập gói.biên dịch.mã lệnh.biên dịch thống kê mã thao tác từ mã trung gian;
nhập gói.biên dịch.cây cú pháp.Bộ Chỉ Mục Khai Báo;
nhập gói.biên dịch.nút cú pháp.*;

lớp công khai Bộ Biên Dịch {
    hàm công khai khởi tạo(mã nguồn, thư mục) {
        mình.snapshot = biên dịch snapshot nội bộ(mã nguồn, thư mục);
        mình.chỉ mục khai báo = rỗng;
    };

    hàm công khai kiểm tra() {
        kết quả = mình.snapshot;
        trả về {
            "hợp lệ": lấy từ điển(kết quả, "hợp lệ", 0),
            "lỗi": lấy từ điển(kết quả, "lỗi", ""),
            "lệnh": lấy từ điển(kết quả, "lệnh", 0)
        };
    };

    hàm công khai phân tích() {
        kết quả = mình.snapshot;
        nếu (!lấy từ điển(kết quả, "hợp lệ", 0)) {
            ném lấy từ điển(kết quả, "lỗi", "biên dịch thất bại");
        };
        trả về kết quả;
    };

    hàm công khai mã trung gian() {
        trả về lấy từ điển(mình.phân tích(), "bytecode", []);
    };

    hàm công khai mã trung gian hàm() {
        trả về lấy từ điển(mình.phân tích(), "hàm", []);
    };

    hàm công khai cây cú pháp() {
        trả về lấy từ điển(mình.phân tích(), "cây cú pháp", []);
    };

    hàm công khai thống kê() {
        kết quả = mình.phân tích();
        trả về {
            "token": lấy từ điển(kết quả, "token", 0),
            "từ tố": lấy từ điển(kết quả, "token", 0),
            "ký hiệu": lấy từ điển(kết quả, "ký hiệu", 0),
            "phạm vi": lấy từ điển(kết quả, "phạm vi", 0),
            "tham chiếu": lấy từ điển(kết quả, "tham chiếu", 0),
            "lệnh": lấy từ điển(kết quả, "lệnh", 0),
            "mô đun": lấy từ điển(kết quả, "mô đun", 0)
        };
    };

    hàm công khai tìm khai báo(tên) {
        nếu (loại của(tên) != "chuỗi") { ném "biên dịch: tên phải là chuỗi"; };
        nếu (mình.chỉ mục khai báo == rỗng) {
            mình.chỉ mục khai báo = Bộ Chỉ Mục Khai Báo(mình.cây cú pháp());
        };
        chỉ mục = mình.chỉ mục khai báo;
        trả về chỉ mục.tìm(tên);
    };

    hàm công khai thống kê mã thao tác() {
        trả về biên dịch thống kê mã thao tác từ mã trung gian(mình.mã trung gian());
    };
};
