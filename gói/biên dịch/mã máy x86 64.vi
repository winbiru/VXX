// x86_64: phát byte mã máy kiến trúc riêng.
// Các phép chưa hỗ trợ phải ném lỗi tại bộ chọn lowering, không phát mã sai.
nhập gói/biên dịch/mã máy nền;

// Lớp sở hữu toàn bộ thuật toán của mô-đun; các hàm bên dưới chỉ giữ API cũ.
lớp công khai Bộ Phát x86 sáu mươi tư {
    hàm công khai khởi tạo() {};

    hàm công khai biên dịch mã máy phát x86 sáu mươi tư(loại, hằng, thấp, cao, ít, hệ điều hành) {
        ra = [];
        nếu (loại == "hằng") {
                        máy ảo thêm cuối danh sách(ra, 184);
                        biên dịch mã máy thêm từ máy(ra, hằng, đúng);
                    } hoặc {
                        nếu (hệ điều hành == "windows") {
                            nếu (loại == "cộng") { ra = [137, 200, 1, 208]; }
                            hoặc { ra = [137, 200, 41, 208]; };
                        } hoặc {
                            nếu (loại == "cộng") { ra = [137, 248, 1, 240]; }
                            hoặc { ra = [137, 248, 41, 240]; };
                        };
                    };
                    máy ảo thêm cuối danh sách(ra, 195);
        trả về ra;
    };

    // Backend MachineOpcode i32 thuần V++, tương ứng với emitX86_64Function C++.
    // Hàm nhận IR đã qua semantic binding + CFG/depth validation.
    hàm riêng tư biên dịch mã máy x86 sáu mươi tư bộ nhớ(ra, tải, thanh ghi, ô nhớ) {
        nếu (thanh ghi < 0 || thanh ghi > 7 || ô nhớ < 0 || ô nhớ > 134217724) {
            ném "x86_64: thanh ghi hoặc frame slot không hợp lệ";
        };
        nếu (tải) { máy ảo thêm cuối danh sách(ra, 139); } hoặc { máy ảo thêm cuối danh sách(ra, 137); };
        máy ảo thêm cuối danh sách(ra, 133 + thanh ghi * 8);
        biên dịch mã máy thêm từ máy(ra, -4 * (ô nhớ + 1), đúng);
    };

    hàm riêng tư biên dịch mã máy x86 sáu mươi tư thành ghi đối số(i, windows) {
        nếu (i < 0 || (windows && i >= 4) || (!windows && i >= 6)) {
            ném "x86_64: chỉ tham số truyền thanh ghi dùng helper này";
        };
        nếu (windows) {
            thành ghi = [1, 2, 0, 1];
            trả về thành ghi[i];
        };
        thành ghi = [7, 6, 2, 1, 0, 1];
        trả về thành ghi[i];
    };

    hàm riêng tư biên dịch mã máy x86 sáu mươi tư nhị phân(ra, mã thao tác, d, ô nhớ) {
        nếu (d < 2) { ném "x86 binary stack underflow"; };
        mình.biên dịch mã máy x86 sáu mươi tư bộ nhớ(ra, đúng, 0, ô nhớ + d - 2);
        mình.biên dịch mã máy x86 sáu mươi tư bộ nhớ(ra, đúng, 1, ô nhớ + d - 1);
        chọn (mã thao tác) {
            ca "Add": { máy ảo thêm cuối danh sách(ra, 1); máy ảo thêm cuối danh sách(ra, 200); }
            ca "Sub": { máy ảo thêm cuối danh sách(ra, 41); máy ảo thêm cuối danh sách(ra, 200); }
            ca "Mul": { máy ảo thêm cuối danh sách(ra, 15); máy ảo thêm cuối danh sách(ra, 175); máy ảo thêm cuối danh sách(ra, 193); }
            ca "Div": { mình.biên dịch mã máy x86 sáu mươi tư chia dư(ra, sai); }
            ca "Mod": { mình.biên dịch mã máy x86 sáu mươi tư chia dư(ra, đúng); }
            ca "Equal": { mình.biên dịch mã máy x86 sáu mươi tư số sánh(ra, 148); }
            ca "NotEqual": { mình.biên dịch mã máy x86 sáu mươi tư số sánh(ra, 149); }
            ca "Less": { mình.biên dịch mã máy x86 sáu mươi tư số sánh(ra, 156); }
            ca "LessEqual": { mình.biên dịch mã máy x86 sáu mươi tư số sánh(ra, 158); }
            ca "Greater": { mình.biên dịch mã máy x86 sáu mươi tư số sánh(ra, 159); }
            ca "GreaterEqual": { mình.biên dịch mã máy x86 sáu mươi tư số sánh(ra, 157); }
            mặc định: { ném "x86_64: opcode nhị phân C++ chưa định nghĩa: " + mã thao tác; }
        };
        mình.biên dịch mã máy x86 sáu mươi tư bộ nhớ(ra, sai, 0, ô nhớ + d - 2);
    };

    hàm riêng tư biên dịch mã máy x86 sáu mươi tư chia dư(ra, lấy dư) {
        // Signed i32, kết quả chia 0 là -1 như ASM runtime.
        // idiv r/m64 tránh #DE ở INT32_MIN / -1; lấy 32 bit thấp của thương/dư.
        // test ecx,ecx; jne calculate; mov eax,-1; jmp done;
        // calculate: movsxd rax,eax; cqo; movsxd rcx,ecx; idiv rcx;
        //            (mod: mov eax,edx)
        bước nhảy = 11;
        nếu (lấy dư) { bước nhảy = 13; };
        mã chia = [133, 201, 117, 7, 184, 255, 255, 255, 255, 235, bước nhảy,
                    72, 99, 192, 72, 153, 72, 99, 201, 72, 247, 249];
        nếu (lấy dư) {
            máy ảo thêm cuối danh sách(mã chia, 137);
            máy ảo thêm cuối danh sách(mã chia, 208);
        };
        lặp (k = 0; k < máy ảo lấy độ dài(mã chia); k++) {
            máy ảo thêm cuối danh sách(ra, mã chia[k]);
        };
    };

    hàm riêng tư biên dịch mã máy x86 sáu mươi tư số sánh(ra, cc) {
        // cmp eax,ecx; setcc al; movzx eax,al.
        máy ảo thêm cuối danh sách(ra, 57); máy ảo thêm cuối danh sách(ra, 200);
        máy ảo thêm cuối danh sách(ra, 15); máy ảo thêm cuối danh sách(ra, cc); máy ảo thêm cuối danh sách(ra, 192);
        máy ảo thêm cuối danh sách(ra, 15); máy ảo thêm cuối danh sách(ra, 182); máy ảo thêm cuối danh sách(ra, 192);
    };

    hàm công khai biên dịch mã máy phát x86 sáu mươi tư hàm(danh sách hàm biểu diễn trung gian, hệ điều hành = "linux") {
        tham số = danh sách hàm biểu diễn trung gian["parameterCount"];
        ô nhớ = danh sách hàm biểu diễn trung gian["slotCount"];
        sâu nhất = danh sách hàm biểu diễn trung gian["maxStackDepth"];
        lệnh = danh sách hàm biểu diễn trung gian["instructions"];
        nếu (tham số < 0 || ô nhớ < tham số || ô nhớ < 0 ||
            sâu nhất < 0 || ô nhớ + sâu nhất > 134217711 || máy ảo lấy độ dài(lệnh) == 0) {
            ném "x86_64 machine IR/frame không hợp lệ";
        };
        windows = hệ điều hành == "windows";
        khung = 4 * (ô nhớ + sâu nhất);
        nếu (windows) { khung += 32; };
        khung = ((khung + 15) / 16) * 16;
        ra = [85, 72, 137, 229]; // push rbp; mov rbp,rsp
        nếu (khung > 0) {
            máy ảo thêm cuối danh sách(ra, 72); máy ảo thêm cuối danh sách(ra, 129); máy ảo thêm cuối danh sách(ra, 236);
            biên dịch mã máy thêm từ máy(ra, khung, đúng);
        };
        số thanh ghi = 6;
        nếu (windows) { số thanh ghi = 4; };
        lặp (i = 0; i < tham số; i++) {
            nếu (i < số thanh ghi) {
                thanh ghi = mình.biên dịch mã máy x86 sáu mươi tư thành ghi đối số(i, windows);
                nếu ((windows && i >= 2) || (!windows && i >= 4)) { máy ảo thêm cuối danh sách(ra, 68); };
                mình.biên dịch mã máy x86 sáu mươi tư bộ nhớ(ra, sai, thanh ghi, i);
            } hoặc {
                độ lệch = 16 + (i - số thanh ghi) * 8;
                nếu (windows) { độ lệch += 32; };
                máy ảo thêm cuối danh sách(ra, 139); máy ảo thêm cuối danh sách(ra, 133);
                biên dịch mã máy thêm từ máy(ra, độ lệch, đúng);
                mình.biên dịch mã máy x86 sáu mươi tư bộ nhớ(ra, sai, 0, i);
            };
        };

        vá nhánh = [];
        vị trí lệnh = [];
        tái định vị = [];
        lặp (i = 0; i < máy ảo lấy độ dài(lệnh); i++) {
            máy ảo thêm cuối danh sách(vị trí lệnh, máy ảo lấy độ dài(ra));
            mã phép toán = lệnh[i];
            mã = mã phép toán["opcode"];
            d = mã phép toán["depthBefore"];
            số = mã phép toán["operand"];
            nếu (d < 0 || d > sâu nhất) { ném "x86_64: độ sâu stack không hợp lệ"; };
            chọn (mã) {
                ca "PushConstant": {
                    nếu (d >= sâu nhất) { ném "x86 eval stack overflow"; };
                    biên dịch mã máy trả về(mã phép toán["immediate"]);
                    máy ảo thêm cuối danh sách(ra, 184);
                    biên dịch mã máy thêm từ máy(ra, mã phép toán["immediate"], đúng);
                    mình.biên dịch mã máy x86 sáu mươi tư bộ nhớ(ra, sai, 0, ô nhớ + d);
                }
                ca "LoadSlot": {
                    nếu (số < 0 || số >= ô nhớ || d >= sâu nhất) { ném "x86 load slot ngoài frame"; };
                    mình.biên dịch mã máy x86 sáu mươi tư bộ nhớ(ra, đúng, 0, số);
                    mình.biên dịch mã máy x86 sáu mươi tư bộ nhớ(ra, sai, 0, ô nhớ + d);
                }
                ca "StoreSlot": {
                    nếu (số < 0 || số >= ô nhớ || d == 0) { ném "x86 store slot ngoài frame"; };
                    mình.biên dịch mã máy x86 sáu mươi tư bộ nhớ(ra, đúng, 0, ô nhớ + d - 1);
                    mình.biên dịch mã máy x86 sáu mươi tư bộ nhớ(ra, sai, 0, số);
                }
                ca "Drop": {
                    nếu (d == 0) { ném "x86 eval stack underflow"; };
                }
                ca "Add": { mình.biên dịch mã máy x86 sáu mươi tư nhị phân(ra, mã, d, ô nhớ); }
                ca "Sub": { mình.biên dịch mã máy x86 sáu mươi tư nhị phân(ra, mã, d, ô nhớ); }
                ca "Mul": { mình.biên dịch mã máy x86 sáu mươi tư nhị phân(ra, mã, d, ô nhớ); }
                ca "Div": { mình.biên dịch mã máy x86 sáu mươi tư nhị phân(ra, mã, d, ô nhớ); }
                ca "Mod": { mình.biên dịch mã máy x86 sáu mươi tư nhị phân(ra, mã, d, ô nhớ); }
                ca "Equal": { mình.biên dịch mã máy x86 sáu mươi tư nhị phân(ra, mã, d, ô nhớ); }
                ca "NotEqual": { mình.biên dịch mã máy x86 sáu mươi tư nhị phân(ra, mã, d, ô nhớ); }
                ca "Less": { mình.biên dịch mã máy x86 sáu mươi tư nhị phân(ra, mã, d, ô nhớ); }
                ca "LessEqual": { mình.biên dịch mã máy x86 sáu mươi tư nhị phân(ra, mã, d, ô nhớ); }
                ca "Greater": { mình.biên dịch mã máy x86 sáu mươi tư nhị phân(ra, mã, d, ô nhớ); }
                ca "GreaterEqual": { mình.biên dịch mã máy x86 sáu mươi tư nhị phân(ra, mã, d, ô nhớ); }
                ca "BranchZero": {
                    nếu (d == 0 || số < 0 || số >= máy ảo lấy độ dài(lệnh)) { ném "x86 branch không hợp lệ"; };
                    mình.biên dịch mã máy x86 sáu mươi tư bộ nhớ(ra, đúng, 0, ô nhớ + d - 1);
                    máy ảo thêm cuối danh sách(ra, 133); máy ảo thêm cuối danh sách(ra, 192); // test eax,eax
                    máy ảo thêm cuối danh sách(ra, 15); máy ảo thêm cuối danh sách(ra, 132);   // je rel32
                    máy ảo thêm cuối danh sách(vá nhánh, {"vị trí": máy ảo lấy độ dài(ra), "đích": số});
                    biên dịch mã máy thêm từ máy(ra, 0, đúng);
                }
                ca "Jump": {
                    nếu (số < 0 || số >= máy ảo lấy độ dài(lệnh)) { ném "x86 jump không hợp lệ"; };
                    máy ảo thêm cuối danh sách(ra, 233); // jmp rel32
                    máy ảo thêm cuối danh sách(vá nhánh, {"vị trí": máy ảo lấy độ dài(ra), "đích": số});
                    biên dịch mã máy thêm từ máy(ra, 0, đúng);
                }
                ca "Call": {
                    nếu (số < 0 || d < số || mã phép toán["symbol"] == "") {
                        ném "x86 call thiếu arguments/symbol";
                    };
                    vượt = số - số thanh ghi;
                    nếu (vượt < 0) { vượt = 0; };
                    kích cỡ = vượt * 8;
                    nếu (windows) { kích cỡ += 32; };
                    kích cỡ = ((kích cỡ + 15) / 16) * 16;
                    nếu (kích cỡ > 0) {
                        máy ảo thêm cuối danh sách(ra, 72); máy ảo thêm cuối danh sách(ra, 129); máy ảo thêm cuối danh sách(ra, 236);
                        biên dịch mã máy thêm từ máy(ra, kích cỡ, đúng);
                    };
                    lặp (n = số thanh ghi; n < số; n++) {
                        mình.biên dịch mã máy x86 sáu mươi tư bộ nhớ(ra, đúng, 0, ô nhớ + d - số + n);
                        máy ảo thêm cuối danh sách(ra, 137); máy ảo thêm cuối danh sách(ra, 132); máy ảo thêm cuối danh sách(ra, 36);
                        độ lệch = (n - số thanh ghi) * 8;
                        nếu (windows) { độ lệch += 32; };
                        biên dịch mã máy thêm từ máy(ra, độ lệch, đúng);
                    };
                    trực tiếp = số;
                    nếu (trực tiếp > số thanh ghi) { trực tiếp = số thanh ghi; };
                    lặp (n = 0; n < trực tiếp; n++) {
                        thanh ghi = mình.biên dịch mã máy x86 sáu mươi tư thành ghi đối số(n, windows);
                        nếu ((windows && n >= 2) || (!windows && n >= 4)) { máy ảo thêm cuối danh sách(ra, 68); };
                        mình.biên dịch mã máy x86 sáu mươi tư bộ nhớ(ra, đúng, thanh ghi, ô nhớ + d - số + n);
                    };
                    máy ảo thêm cuối danh sách(ra, 232); // call rel32
                    máy ảo thêm cuối danh sách(tái định vị, {"offset": máy ảo lấy độ dài(ra), "symbol": mã phép toán["symbol"]});
                    biên dịch mã máy thêm từ máy(ra, 0, đúng);
                    nếu (kích cỡ > 0) {
                        máy ảo thêm cuối danh sách(ra, 72); máy ảo thêm cuối danh sách(ra, 129); máy ảo thêm cuối danh sách(ra, 196);
                        biên dịch mã máy thêm từ máy(ra, kích cỡ, đúng);
                    };
                    mình.biên dịch mã máy x86 sáu mươi tư bộ nhớ(ra, sai, 0, ô nhớ + d - số);
                }
                ca "Return": {
                    nếu (d == 0) { ném "x86 return không có giá trị"; };
                    mình.biên dịch mã máy x86 sáu mươi tư bộ nhớ(ra, đúng, 0, ô nhớ + d - 1);
                    máy ảo thêm cuối danh sách(ra, 201); máy ảo thêm cuối danh sách(ra, 195); // leave; ret
                }
                ca "Trap": { máy ảo thêm cuối danh sách(ra, 15); máy ảo thêm cuối danh sách(ra, 11); } // ud2
                mặc định: { ném "x86_64 MachineOpcode C++ chưa định nghĩa: " + mã; }
            };
        };
        lặp (i = 0; i < máy ảo lấy độ dài(vá nhánh); i++) {
            f = vá nhánh[i];
            chênh lệch = vị trí lệnh[f["đích"]] - (f["vị trí"] + 4);
            nếu (chênh lệch < -2147483647 - 1 || chênh lệch > 2147483647) {
                ném "x86 branch vượt quá rel32";
            };
            các byte = [];
            biên dịch mã máy thêm từ máy(các byte, chênh lệch, đúng);
            lặp (n = 0; n < 4; n++) { ra[f["vị trí"] + n] = các byte[n]; };
        };
        trả về {"bytes": ra, "relocations": tái định vị};
    };
};


hàm công khai biên dịch mã máy phát x86 sáu mươi tư(loại, hằng, thấp, cao, ít, hệ điều hành) {
    bộ chuyển tiếp = Bộ Phát x86 sáu mươi tư();
    trả về bộ chuyển tiếp.biên dịch mã máy phát x86 sáu mươi tư(loại, hằng, thấp, cao, ít, hệ điều hành);
};

hàm công khai biên dịch mã máy phát x86 sáu mươi tư hàm(danh sách hàm biểu diễn trung gian, hệ điều hành = "linux") {
    bộ chuyển tiếp = Bộ Phát x86 sáu mươi tư();
    trả về bộ chuyển tiếp.biên dịch mã máy phát x86 sáu mươi tư hàm(danh sách hàm biểu diễn trung gian, hệ điều hành);
};
