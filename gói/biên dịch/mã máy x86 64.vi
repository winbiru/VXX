// x86_64: phát byte mã máy kiến trúc riêng.
// Các phép chưa hỗ trợ phải ném lỗi tại bộ chọn lowering, không phát mã sai.
nhập gói.biên dịch.mã máy nền.biên dịch mã máy thêm từ máy;
nhập gói.biên dịch.mã máy nền.biên dịch mã máy chuẩn hóa CFG;

// Lớp sở hữu toàn bộ thuật toán của mô-đun; các hàm bên dưới chỉ giữ API cũ.
lớp công khai Bộ Phát x86 sáu mươi tư {
    hàm công khai khởi tạo() {};

    hàm công khai biên dịch mã máy phát x86 sáu mươi tư(loại, hằng, thấp, cao, ít, hệ điều hành) {
        ra = [];
        nếu (loại == "hằng") {
                        bỏ kết quả = máy ảo thêm cuối danh sách(ra, 184);
                        bỏ kết quả = biên dịch mã máy thêm từ máy(ra, hằng, đúng);
                    } hoặc {
                        nếu (hệ điều hành == "windows") {
                            nếu (loại == "cộng") { ra = [137, 200, 1, 208]; }
                            hoặc { ra = [137, 200, 41, 208]; };
                        } hoặc {
                            nếu (loại == "cộng") { ra = [137, 248, 1, 240]; }
                            hoặc { ra = [137, 248, 41, 240]; };
                        };
                    };
                    bỏ kết quả = máy ảo thêm cuối danh sách(ra, 195);
        trả về ra;
    };

    // Discard unused results from emit helpers to keep the dynamic stack bounded.
    // Backend MachineOpcode i32 thuần V++, tương ứng với emitX86_64Function C++.
    // Hàm tự kiểm tra CFG/depth, kể cả khi được gọi trực tiếp.
    hàm riêng tư biên dịch mã máy x86 sáu mươi tư bộ nhớ(ra, tải, thanh ghi, ô nhớ) {
        nếu (thanh ghi < 0 || thanh ghi > 7 || ô nhớ < 0 || ô nhớ > 134217724) {
            ném "x86_64: thanh ghi hoặc frame slot không hợp lệ";
        };
        nếu (tải) { bỏ kết quả = máy ảo thêm cuối danh sách(ra, 139); } hoặc { bỏ kết quả = máy ảo thêm cuối danh sách(ra, 137); };
        bỏ kết quả = máy ảo thêm cuối danh sách(ra, 133 + thanh ghi * 8);
        bỏ kết quả = biên dịch mã máy thêm từ máy(ra, -4 * (ô nhớ + 1), đúng);
    };

    hàm riêng tư biên dịch mã máy x86 sáu mươi tư thành ghi đối số(i, windows) {
        nếu (i < 0 || (windows && i >= 4) || (!windows && i >= 6)) {
            ném "x86_64: chỉ tham số truyền thanh ghi dùng helper này";
        };
        nếu (windows) {
            thành ghi = [1, 2, 0, 1];
            trả về thành ghi[i];
        };
        thành ghi = [7, 6, 2, 1, 0, 1];
        trả về thành ghi[i];
    };

    hàm riêng tư biên dịch mã máy x86 sáu mươi tư nhị phân(ra, mã thao tác, d, ô nhớ) {
        nếu (d < 2) { ném "x86 binary stack underflow"; };
        bỏ kết quả = mình.biên dịch mã máy x86 sáu mươi tư bộ nhớ(ra, đúng, 0, ô nhớ + d - 2);
        bỏ kết quả = mình.biên dịch mã máy x86 sáu mươi tư bộ nhớ(ra, đúng, 1, ô nhớ + d - 1);
        chọn (mã thao tác) {
            ca 4: { bỏ kết quả = máy ảo thêm cuối danh sách(ra, 1); bỏ kết quả = máy ảo thêm cuối danh sách(ra, 200); }
            ca 5: { bỏ kết quả = máy ảo thêm cuối danh sách(ra, 41); bỏ kết quả = máy ảo thêm cuối danh sách(ra, 200); }
            ca 6: { bỏ kết quả = máy ảo thêm cuối danh sách(ra, 15); bỏ kết quả = máy ảo thêm cuối danh sách(ra, 175); bỏ kết quả = máy ảo thêm cuối danh sách(ra, 193); }
            ca 20: { bỏ kết quả = máy ảo thêm cuối danh sách(ra, 33); bỏ kết quả = máy ảo thêm cuối danh sách(ra, 200); }
            ca 21: { bỏ kết quả = máy ảo thêm cuối danh sách(ra, 9); bỏ kết quả = máy ảo thêm cuối danh sách(ra, 200); }
            ca 22: { bỏ kết quả = máy ảo thêm cuối danh sách(ra, 49); bỏ kết quả = máy ảo thêm cuối danh sách(ra, 200); }
            ca 23: { bỏ kết quả = máy ảo thêm cuối danh sách(ra, 211); bỏ kết quả = máy ảo thêm cuối danh sách(ra, 224); }
            ca 24: { bỏ kết quả = máy ảo thêm cuối danh sách(ra, 211); bỏ kết quả = máy ảo thêm cuối danh sách(ra, 248); }
            ca 7: { bỏ kết quả = mình.biên dịch mã máy x86 sáu mươi tư chia dư(ra, sai); }
            ca 8: { bỏ kết quả = mình.biên dịch mã máy x86 sáu mươi tư chia dư(ra, đúng); }
            ca 9: { bỏ kết quả = mình.biên dịch mã máy x86 sáu mươi tư số sánh(ra, 148); }
            ca 10: { bỏ kết quả = mình.biên dịch mã máy x86 sáu mươi tư số sánh(ra, 149); }
            ca 11: { bỏ kết quả = mình.biên dịch mã máy x86 sáu mươi tư số sánh(ra, 156); }
            ca 12: { bỏ kết quả = mình.biên dịch mã máy x86 sáu mươi tư số sánh(ra, 158); }
            ca 13: { bỏ kết quả = mình.biên dịch mã máy x86 sáu mươi tư số sánh(ra, 159); }
            ca 14: { bỏ kết quả = mình.biên dịch mã máy x86 sáu mươi tư số sánh(ra, 157); }
            mặc định: { ném "x86_64: opcode nhị phân C++ chưa định nghĩa: " + thành chuỗi(mã thao tác); }
        };
        bỏ kết quả = mình.biên dịch mã máy x86 sáu mươi tư bộ nhớ(ra, sai, 0, ô nhớ + d - 2);
    };

    hàm riêng tư biên dịch mã máy x86 sáu mươi tư chia dư(ra, lấy dư) {
        // Signed i32, kết quả chia 0 là -1 như ASM runtime.
        // idiv r/m64 tránh #DE ở INT32_MIN / -1; lấy 32 bit thấp của thương/dư.
        // test ecx,ecx; jne calculate; mov eax,-1; jmp done;
        // calculate: movsxd rax,eax; cqo; movsxd rcx,ecx; idiv rcx;
        //            (mod: mov eax,edx)
        bước nhảy = 11;
        nếu (lấy dư) { bước nhảy = 13; };
        mã chia = [133, 201, 117, 7, 184, 255, 255, 255, 255, 235, bước nhảy,
                    72, 99, 192, 72, 153, 72, 99, 201, 72, 247, 249];
        nếu (lấy dư) {
            bỏ kết quả = máy ảo thêm cuối danh sách(mã chia, 137);
            bỏ kết quả = máy ảo thêm cuối danh sách(mã chia, 208);
        };
        số byte chia = máy ảo lấy độ dài(mã chia);
        lặp (k = 0; k < số byte chia; k += 1) {
            bỏ kết quả = máy ảo thêm cuối danh sách(ra, mã chia[k]);
        };
    };

    hàm riêng tư biên dịch mã máy x86 sáu mươi tư số sánh(ra, cc) {
        // cmp eax,ecx; setcc al; movzx eax,al.
        bỏ kết quả = máy ảo thêm cuối danh sách(ra, 57); bỏ kết quả = máy ảo thêm cuối danh sách(ra, 200);
        bỏ kết quả = máy ảo thêm cuối danh sách(ra, 15); bỏ kết quả = máy ảo thêm cuối danh sách(ra, cc); bỏ kết quả = máy ảo thêm cuối danh sách(ra, 192);
        bỏ kết quả = máy ảo thêm cuối danh sách(ra, 15); bỏ kết quả = máy ảo thêm cuối danh sách(ra, 182); bỏ kết quả = máy ảo thêm cuối danh sách(ra, 192);
    };

    hàm công khai biên dịch mã máy phát x86 sáu mươi tư hàm(danh sách hàm biểu diễn trung gian, hệ điều hành = "linux") {
        tham số = danh sách hàm biểu diễn trung gian["parameterCount"];
        ô nhớ = danh sách hàm biểu diễn trung gian["slotCount"];
        sâu nhất = danh sách hàm biểu diễn trung gian["maxStackDepth"];
        lệnh = danh sách hàm biểu diễn trung gian["instructions"];
        số lệnh = máy ảo lấy độ dài(lệnh);
        nếu (tham số < 0 || ô nhớ < tham số || ô nhớ < 0 ||
            sâu nhất < 0 || ô nhớ + sâu nhất > 134217711 || số lệnh == 0) {
            ném "x86_64 machine IR/frame không hợp lệ";
        };
        chuẩn = biên dịch mã máy chuẩn hóa CFG(danh sách hàm biểu diễn trung gian);
        mã lệnh = chuẩn["opcodes"];
        hằng lệnh = chuẩn["immediates"];
        toán hạng lệnh = chuẩn["operands"];
        độ sâu lệnh = chuẩn["depths"];
        ký hiệu lệnh = chuẩn["symbols"];
        windows = hệ điều hành == "windows";
        khung = 4 * (ô nhớ + sâu nhất);
        nếu (windows) { khung += 32; };
        khung = ((khung + 15) / 16) * 16;
        ra = [85, 72, 137, 229]; // push rbp; mov rbp,rsp
        nếu (khung > 0) {
            bỏ kết quả = máy ảo thêm cuối danh sách(ra, 72); bỏ kết quả = máy ảo thêm cuối danh sách(ra, 129); bỏ kết quả = máy ảo thêm cuối danh sách(ra, 236);
            bỏ kết quả = biên dịch mã máy thêm từ máy(ra, khung, đúng);
        };
        số thanh ghi = 6;
        nếu (windows) { số thanh ghi = 4; };
        lặp (i = 0; i < tham số; i += 1) {
            nếu (i < số thanh ghi) {
                thanh ghi = mình.biên dịch mã máy x86 sáu mươi tư thành ghi đối số(i, windows);
                nếu ((windows && i >= 2) || (!windows && i >= 4)) { bỏ kết quả = máy ảo thêm cuối danh sách(ra, 68); };
                bỏ kết quả = mình.biên dịch mã máy x86 sáu mươi tư bộ nhớ(ra, sai, thanh ghi, i);
            } hoặc {
                độ lệch = 16 + (i - số thanh ghi) * 8;
                nếu (windows) { độ lệch += 32; };
                bỏ kết quả = máy ảo thêm cuối danh sách(ra, 139); bỏ kết quả = máy ảo thêm cuối danh sách(ra, 133);
                bỏ kết quả = biên dịch mã máy thêm từ máy(ra, độ lệch, đúng);
                bỏ kết quả = mình.biên dịch mã máy x86 sáu mươi tư bộ nhớ(ra, sai, 0, i);
            };
        };

        vá nhánh = [];
        vị trí lệnh = [];
        tái định vị = [];
        lặp (i = 0; i < số lệnh; i += 1) {
            bỏ kết quả = máy ảo thêm cuối danh sách(vị trí lệnh, máy ảo lấy độ dài(ra));
            trang = i >> 11; vị trí = i & 2047;
            mã = mã lệnh[trang][vị trí];
            d = độ sâu lệnh[trang][vị trí];
            số = toán hạng lệnh[trang][vị trí];
            nếu (d < 0 || d > sâu nhất) { ném "x86_64: độ sâu stack không hợp lệ"; };
            chọn (mã) {
                ca 0: {
                    nếu (d >= sâu nhất) { ném "x86 eval stack overflow"; };
                    // Chỉ cần kiểm tra i32; kết quả {lo, hi} trước đây bị bỏ đi.
                    hằng = hằng lệnh[trang][vị trí];
                    nếu (hằng < -2147483647 - 1 || hằng > 2147483647) {
                        ném "mã máy V++: hằng nằm ngoài i32";
                    };
                    bỏ kết quả = máy ảo thêm cuối danh sách(ra, 184);
                    bỏ kết quả = biên dịch mã máy thêm từ máy(ra, hằng, đúng);
                    bỏ kết quả = mình.biên dịch mã máy x86 sáu mươi tư bộ nhớ(ra, sai, 0, ô nhớ + d);
                }
                ca 1: {
                    nếu (số < 0 || số >= ô nhớ || d >= sâu nhất) { ném "x86 load slot ngoài frame"; };
                    bỏ kết quả = mình.biên dịch mã máy x86 sáu mươi tư bộ nhớ(ra, đúng, 0, số);
                    bỏ kết quả = mình.biên dịch mã máy x86 sáu mươi tư bộ nhớ(ra, sai, 0, ô nhớ + d);
                }
                ca 2: {
                    nếu (số < 0 || số >= ô nhớ || d == 0) { ném "x86 store slot ngoài frame"; };
                    bỏ kết quả = mình.biên dịch mã máy x86 sáu mươi tư bộ nhớ(ra, đúng, 0, ô nhớ + d - 1);
                    bỏ kết quả = mình.biên dịch mã máy x86 sáu mươi tư bộ nhớ(ra, sai, 0, số);
                }
                ca 3: {
                    nếu (d == 0) { ném "x86 eval stack underflow"; };
                }
                ca 4: { bỏ kết quả = mình.biên dịch mã máy x86 sáu mươi tư nhị phân(ra, mã, d, ô nhớ); }
                ca 5: { bỏ kết quả = mình.biên dịch mã máy x86 sáu mươi tư nhị phân(ra, mã, d, ô nhớ); }
                ca 6: { bỏ kết quả = mình.biên dịch mã máy x86 sáu mươi tư nhị phân(ra, mã, d, ô nhớ); }
                ca 20: { bỏ kết quả = mình.biên dịch mã máy x86 sáu mươi tư nhị phân(ra, mã, d, ô nhớ); }
                ca 21: { bỏ kết quả = mình.biên dịch mã máy x86 sáu mươi tư nhị phân(ra, mã, d, ô nhớ); }
                ca 22: { bỏ kết quả = mình.biên dịch mã máy x86 sáu mươi tư nhị phân(ra, mã, d, ô nhớ); }
                ca 23: { bỏ kết quả = mình.biên dịch mã máy x86 sáu mươi tư nhị phân(ra, mã, d, ô nhớ); }
                ca 24: { bỏ kết quả = mình.biên dịch mã máy x86 sáu mươi tư nhị phân(ra, mã, d, ô nhớ); }
                ca 7: { bỏ kết quả = mình.biên dịch mã máy x86 sáu mươi tư nhị phân(ra, mã, d, ô nhớ); }
                ca 8: { bỏ kết quả = mình.biên dịch mã máy x86 sáu mươi tư nhị phân(ra, mã, d, ô nhớ); }
                ca 9: { bỏ kết quả = mình.biên dịch mã máy x86 sáu mươi tư nhị phân(ra, mã, d, ô nhớ); }
                ca 10: { bỏ kết quả = mình.biên dịch mã máy x86 sáu mươi tư nhị phân(ra, mã, d, ô nhớ); }
                ca 11: { bỏ kết quả = mình.biên dịch mã máy x86 sáu mươi tư nhị phân(ra, mã, d, ô nhớ); }
                ca 12: { bỏ kết quả = mình.biên dịch mã máy x86 sáu mươi tư nhị phân(ra, mã, d, ô nhớ); }
                ca 13: { bỏ kết quả = mình.biên dịch mã máy x86 sáu mươi tư nhị phân(ra, mã, d, ô nhớ); }
                ca 14: { bỏ kết quả = mình.biên dịch mã máy x86 sáu mươi tư nhị phân(ra, mã, d, ô nhớ); }
                ca 15: {
                    nếu (d == 0 || số < 0 || số >= số lệnh) { ném "x86 branch không hợp lệ"; };
                    bỏ kết quả = mình.biên dịch mã máy x86 sáu mươi tư bộ nhớ(ra, đúng, 0, ô nhớ + d - 1);
                    bỏ kết quả = máy ảo thêm cuối danh sách(ra, 133); bỏ kết quả = máy ảo thêm cuối danh sách(ra, 192); // test eax,eax
                    bỏ kết quả = máy ảo thêm cuối danh sách(ra, 15); bỏ kết quả = máy ảo thêm cuối danh sách(ra, 132);   // je rel32
                    bỏ kết quả = máy ảo thêm cuối danh sách(vá nhánh, {"vị trí": máy ảo lấy độ dài(ra), "đích": số});
                    bỏ kết quả = biên dịch mã máy thêm từ máy(ra, 0, đúng);
                }
                ca 16: {
                    nếu (số < 0 || số >= số lệnh) { ném "x86 jump không hợp lệ"; };
                    bỏ kết quả = máy ảo thêm cuối danh sách(ra, 233); // jmp rel32
                    bỏ kết quả = máy ảo thêm cuối danh sách(vá nhánh, {"vị trí": máy ảo lấy độ dài(ra), "đích": số});
                    bỏ kết quả = biên dịch mã máy thêm từ máy(ra, 0, đúng);
                }
                ca 17: {
                    nếu (số < 0 || d < số || ký hiệu lệnh[trang][vị trí] == "") {
                        ném "x86 call thiếu arguments/symbol";
                    };
                    vượt = số - số thanh ghi;
                    nếu (vượt < 0) { vượt = 0; };
                    kích cỡ = vượt * 8;
                    nếu (windows) { kích cỡ += 32; };
                    kích cỡ = ((kích cỡ + 15) / 16) * 16;
                    nếu (kích cỡ > 0) {
                        bỏ kết quả = máy ảo thêm cuối danh sách(ra, 72); bỏ kết quả = máy ảo thêm cuối danh sách(ra, 129); bỏ kết quả = máy ảo thêm cuối danh sách(ra, 236);
                        bỏ kết quả = biên dịch mã máy thêm từ máy(ra, kích cỡ, đúng);
                    };
                    lặp (n = số thanh ghi; n < số; n += 1) {
                        bỏ kết quả = mình.biên dịch mã máy x86 sáu mươi tư bộ nhớ(ra, đúng, 0, ô nhớ + d - số + n);
                        bỏ kết quả = máy ảo thêm cuối danh sách(ra, 137); bỏ kết quả = máy ảo thêm cuối danh sách(ra, 132); bỏ kết quả = máy ảo thêm cuối danh sách(ra, 36);
                        độ lệch = (n - số thanh ghi) * 8;
                        nếu (windows) { độ lệch += 32; };
                        bỏ kết quả = biên dịch mã máy thêm từ máy(ra, độ lệch, đúng);
                    };
                    trực tiếp = số;
                    nếu (trực tiếp > số thanh ghi) { trực tiếp = số thanh ghi; };
                    lặp (n = 0; n < trực tiếp; n += 1) {
                        thanh ghi = mình.biên dịch mã máy x86 sáu mươi tư thành ghi đối số(n, windows);
                        nếu ((windows && n >= 2) || (!windows && n >= 4)) { bỏ kết quả = máy ảo thêm cuối danh sách(ra, 68); };
                        bỏ kết quả = mình.biên dịch mã máy x86 sáu mươi tư bộ nhớ(ra, đúng, thanh ghi, ô nhớ + d - số + n);
                    };
                    bỏ kết quả = máy ảo thêm cuối danh sách(ra, 232); // call rel32
                    bỏ kết quả = máy ảo thêm cuối danh sách(tái định vị, {"offset": máy ảo lấy độ dài(ra), "symbol": ký hiệu lệnh[trang][vị trí]});
                    bỏ kết quả = biên dịch mã máy thêm từ máy(ra, 0, đúng);
                    nếu (kích cỡ > 0) {
                        bỏ kết quả = máy ảo thêm cuối danh sách(ra, 72); bỏ kết quả = máy ảo thêm cuối danh sách(ra, 129); bỏ kết quả = máy ảo thêm cuối danh sách(ra, 196);
                        bỏ kết quả = biên dịch mã máy thêm từ máy(ra, kích cỡ, đúng);
                    };
                    bỏ kết quả = mình.biên dịch mã máy x86 sáu mươi tư bộ nhớ(ra, sai, 0, ô nhớ + d - số);
                }
                ca 18: {
                    nếu (d == 0) { ném "x86 return không có giá trị"; };
                    bỏ kết quả = mình.biên dịch mã máy x86 sáu mươi tư bộ nhớ(ra, đúng, 0, ô nhớ + d - 1);
                    bỏ kết quả = máy ảo thêm cuối danh sách(ra, 201); bỏ kết quả = máy ảo thêm cuối danh sách(ra, 195); // leave; ret
                }
                ca 19: { bỏ kết quả = máy ảo thêm cuối danh sách(ra, 15); bỏ kết quả = máy ảo thêm cuối danh sách(ra, 11); } // ud2
                mặc định: { ném "x86_64 MachineOpcode C++ chưa định nghĩa: " + thành chuỗi(mã); }
            };
        };
        số nhánh = máy ảo lấy độ dài(vá nhánh);
        lặp (i = 0; i < số nhánh; i += 1) {
            f = vá nhánh[i];
            chênh lệch = vị trí lệnh[f["đích"]] - (f["vị trí"] + 4);
            nếu (chênh lệch < -2147483647 - 1 || chênh lệch > 2147483647) {
                ném "x86 branch vượt quá rel32";
            };
            vị trí = f["vị trí"];
            lặp (n = 0; n < 4; n += 1) { ra[vị trí + n] = (chênh lệch >> (n * 8)) & 255; };
        };
        trả về {"bytes": ra, "relocations": tái định vị};
    };
};


hàm công khai biên dịch mã máy phát x86 sáu mươi tư(loại, hằng, thấp, cao, ít, hệ điều hành) {
    bộ chuyển tiếp = Bộ Phát x86 sáu mươi tư();
    trả về bộ chuyển tiếp.biên dịch mã máy phát x86 sáu mươi tư(loại, hằng, thấp, cao, ít, hệ điều hành);
};

hàm công khai biên dịch mã máy phát x86 sáu mươi tư hàm(danh sách hàm biểu diễn trung gian, hệ điều hành = "linux") {
    bộ chuyển tiếp = Bộ Phát x86 sáu mươi tư();
    trả về bộ chuyển tiếp.biên dịch mã máy phát x86 sáu mươi tư hàm(danh sách hàm biểu diễn trung gian, hệ điều hành);
};
