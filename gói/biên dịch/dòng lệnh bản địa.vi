hàm biên dịch asm chương trình(dây, bộ ba, compiler) {
    // executeArtifact của native host dùng entrypoint này. Đưa Machine IR
    // thẳng xuống assembler; vẫn cho phép so sánh với byte encoder cũ.
    trả về sinh asm chương trình(dây, bộ ba, compiler, rỗng,
        đọc biến môi trường("VPP_AOT_ASM_DIRECT", "1") != "0");
};

hàm biên dịch trước nguồn tệp(đường, thư viện) {
