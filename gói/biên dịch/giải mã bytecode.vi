// Phân giải nhãn StringPool theo cùng quy ước operand của Stage 0.
hàm biên dịch nhãn mã thao tác(lệnh, bể chuỗi) {
    mã = lệnh[0];
    chỉ mục = -1;
    nếu (mã == biên dịch mã thao tác("OP_HAM") ||
        mã == biên dịch mã thao tác("OP_PARAM_MAC_DINH")) {
        chỉ mục = lệnh[1];
    } hoặc nếu (mã == biên dịch mã thao tác("OP_CHUOI") ||
        mã == biên dịch mã thao tác("OP_BIEN_SO_FLOAT") ||
        mã == biên dịch mã thao tác("OP_MAP_LITERAL")) {
        chỉ mục = lệnh[2];
    } hoặc nếu (mã == biên dịch mã thao tác("OP_GOI") && lệnh[2] < 0) {
        chỉ mục = -lệnh[2] - 1;
    };
    nếu (chỉ mục >= 0 && chỉ mục < máy ảo lấy độ dài(bể chuỗi)) {
        trả về " bể chuỗi=\"" + bể chuỗi[chỉ mục] + "\"";
    };
    trả về "";
};

// Định dạng từng opcode tương thích với --giải-mã của bootstrap C++.
hàm công khai biên dịch giải mã bytecode(bytecode, bể chuỗi) {
    các dòng = [];
    lặp (i = 0; i < máy ảo lấy độ dài(bytecode); i++) {
        lệnh = bytecode[i];
        vị trí = thành chuỗi(i);
        nếu (máy ảo lấy độ dài(vị trí) < 4) { vị trí = " " + vị trí; };
        nếu (máy ảo lấy độ dài(vị trí) < 4) { vị trí = " " + vị trí; };
        nếu (máy ảo lấy độ dài(vị trí) < 4) { vị trí = " " + vị trí; };
        dòng = vị trí + "  " + biên dịch tên mã thao tác(lệnh[0]) +
            " toán hạng=" + thành chuỗi(lệnh[1]) +
            " chỉ số=" + thành chuỗi(lệnh[2]) +
            " giá trị=" + thành chuỗi(lệnh[3]) +
            biên dịch nhãn mã thao tác(lệnh, bể chuỗi) + "\n";
        máy ảo thêm cuối danh sách(các dòng, dòng);
    };
    trả về biên dịch lắp ráp nối các phần(các dòng);
};
