// Lexer viết bằng V++: bước đầu của compiler tự lưu trữ.
// Vị trí/cột dùng byte UTF-8 như SourceSpan của compiler bootstrap.
// Cả vị trí theo Unicode code point được giữ trong các trường "... ký tự".
nhập gói.lõi.bảng mã.bảng mã unicode tám bit độ dài đoạn;
nhập gói.lõi.chuyển kiểu.thành chuỗi;
nhập gói.lõi.chuyển kiểu.loại của;
nhập gói.bộ sưu tập.từ điển.lấy từ điển;
nhập gói.bộ sưu tập.từ điển.có khóa;
nhập gói.bộ sưu tập.từ điển.khóa từ điển;

// Mỗi phiên giữ nguồn và cache token thô/token đã hợp nhất riêng.
// Các phương thức nhận nguồn trực tiếp bên dưới vẫn giữ API cũ.
lớp công khai Bộ Tách Từ Vựng {
    hàm công khai khởi tạo(mã nguồn = "") {
        mình.làm mới(mã nguồn);
    };

    hàm công khai làm mới(mã nguồn) {
        nếu (loại của(mã nguồn) != "chuỗi") {
            ném "biên dịch từ vựng: mã nguồn phải là chuỗi";
        };
        mình.nguồn = mã nguồn;
        mình.từ tố thô = rỗng;
        mình.từ tố đã ghép = rỗng;
        // A token is classified many times per source, so reuse one keyword
        // index instead of checking every keyword with sequential compares.
        mình.bảng từ khóa = {
            "nếu": đúng, "hoặc": đúng, "lặp": đúng, "khi": đúng,
            "hàm": đúng, "gọi": đúng, "biến": đúng, "in": đúng,
            "dừng": đúng, "thoát": đúng, "chọn": đúng, "ca": đúng,
            "đúng": đúng, "sai": đúng, "rỗng": đúng, "ném": đúng,
            "thử": đúng, "nhập": đúng, "lớp": đúng, "chuyển": đúng,
            "mặc định": đúng, "trả về": đúng, "bỏ qua": đúng,
            "khởi tạo": đúng, "điều kiện": đúng, "cập nhật": đúng,
            "kiểm tra sau": đúng, "bắt lỗi": đúng, "trường hợp": đúng,
            "giao diện": đúng, "kế thừa": đúng, "triển khai": đúng,
            "công khai": đúng, "riêng tư": đúng, "bảo vệ": đúng,
            "ngoại thư viện": đúng, "ngoại hàm": đúng,
            "ký hiệu": đúng, "khả năng": đúng
        };
        trả về mình;
    };

    hàm công khai từ tố thô() {
        nếu (mình.từ tố thô == rỗng) {
            mình.từ tố thô = mình.biên dịch từ tố hóa thô(mình.nguồn);
        };
        trả về mình.từ tố thô;
    };

    hàm công khai từ tố() {
        nếu (mình.từ tố đã ghép == rỗng) {
            mình.từ tố đã ghép = mình.hợp nhất từ tố(mình.từ tố thô());
        };
        trả về mình.từ tố đã ghép;
    };

    hàm riêng tư biên dịch từ vựng ký tự(các ký tự, vị trí) {
        nếu (vị trí < 0 || vị trí >= máy ảo lấy độ dài(các ký tự)) { trả về ""; };
        trả về các ký tự[vị trí];
    };

    hàm riêng tư biên dịch từ vựng trắng(c) {
        // Chuỗi escape \v / \f không được V++ diễn giải thành ký tự điều khiển:
        // Hai byte ASCII 11 và 12 nằm giữa LF (10) và CR (13).
        // So sánh chuỗi UTF-8 trực tiếp, tránh giải mã Unicode ở mỗi ký tự.
        nếu (c == " " || c == "\n" || c == "\r" || c == "\t") { trả về đúng; };
        trả về c > "\n" && c < "\r";
    };

    hàm riêng tư biên dịch từ vựng ngăn cách(c) {
        trả về c == "\"" || c == "'" || c == "+" || c == "-" ||
            c == "*" || c == "/" || c == "(" || c == ")" ||
            c == "{" || c == "}" || c == "[" || c == "]" ||
            c == ";" || c == "," || c == "<" || c == ">" ||
            c == "=" || c == "!" || c == ":";
    };

    hàm riêng tư biên dịch từ vựng hai toán tử(s) {
        trả về s == "==" || s == "!=" || s == "<=" || s == ">=" ||
            s == "&&" || s == "||" || s == "++" || s == "--" ||
            s == "+=" || s == "-=" || s == "*=" || s == "/=" || s == "%=";
    };

    hàm riêng tư biên dịch từ vựng chữ số(c) {
        nếu (c == "") { trả về sai; };
        // Cả UTF-8 của ký tự phi ASCII đều nằm ngoài khoảng byte '0'..'9'.
        trả về c >= "0" && c <= "9";
    };

    hàm riêng tư biên dịch từ vựng số(s) {
        nếu (s == "") { trả về ""; };
        dấu chấm = 0;
        lặp(i = 0; i < máy ảo lấy độ dài(s); i++) {
            c = s[i];
            nếu (c == ".") {
                dấu chấm += 1;
            } hoặc {
                nếu (!mình.biên dịch từ vựng chữ số(c)) { trả về ""; };
            };
        };
        nếu (dấu chấm == 0) { trả về "số nguyên"; };
        nếu (dấu chấm == 1) { trả về "số thực"; };
        trả về "";
    };

    hàm riêng tư biên dịch từ vựng phân loại(s) {
        n = máy ảo lấy độ dài(s);
        nếu (n >= 2) {
            nếu ((s[0] == "\"" && s[n - 1] == "\"") ||
                (s[0] == "'" && s[n - 1] == "'")) { trả về "chuỗi"; };
        };
        // Most tokens are identifiers/keywords. Only numbers (and the
        // historically accepted dot token) need numeric classification.
        số = "";
        nếu (n > 0 && (s[0] == "." || (s[0] >= "0" && s[0] <= "9"))) {
            số = mình.biên dịch từ vựng số(s);
        };
        nếu (số != "") { trả về số; };
        nếu (mình.biên dịch từ vựng hai toán tử(s) || s == "+" || s == "-" ||
            s == "*" || s == "/" || s == "%" || s == "=" ||
            s == "!" || s == "<" || s == ">") { trả về "toán tử"; };
        nếu (s == "(" || s == ")" || s == "{" || s == "}" ||
            s == "[" || s == "]" || s == ";" || s == "," || s == ":") {
            trả về "dấu câu";
        };
        nếu (máy ảo có khóa từ điển(mình.bảng từ khóa, s)) { trả về "từ khóa"; };
        trả về "định danh";
    };

    hàm riêng tư biên dịch từ vựng từ tố(giá trị, dòng, cột, bắt đầu, kết thúc,
                               cột ký tự, bắt đầu ký tự, kết thúc ký tự) {
        trả về {
            "loại": mình.biên dịch từ vựng phân loại(giá trị),
            "giá trị": giá trị,
            "dòng": dòng,
            "cột": cột,
            "vị trí": bắt đầu,
            "kết thúc": kết thúc,
            "cột ký tự": cột ký tự,
            "vị trí ký tự": bắt đầu ký tự,
            "kết thúc ký tự": kết thúc ký tự
        };
    };

    hàm riêng tư biên dịch từ vựng lỗi(loại lỗi, dòng, cột) {
        ném "biên dịch từ vựng: " + loại lỗi + " tại dòng " +
            thành chuỗi(dòng) + ", cột " + thành chuỗi(cột);
    };

    // Copy each source byte once. Building a token by repeatedly appending
    // immutable strings performs quadratic copying for long identifiers and
    // string literals, while byte spans preserve UTF-8 and escape spelling.
    hàm riêng tư biên dịch từ vựng đoạn(các byte, bắt đầu, kết thúc) {
        đoạn = [];
        lặp(j = bắt đầu; j < kết thúc; j++) {
            máy ảo thêm cuối danh sách(đoạn, các byte[j]);
        };
        trả về chuỗi từ byte máy ảo(đoạn);
    };

    // Lex UTF-8 bằng các code point: không tách đôi ký tự tiếng Việt.
    // Chưa dùng trong bootstrap C++; API này là pass độc lập có thể kiểm thử.
    hàm công khai biên dịch từ tố hóa thô(mã nguồn) {
        nếu (loại của(mã nguồn) != "chuỗi") {
            ném "biên dịch từ vựng: mã nguồn phải là chuỗi";
        };
        // Không lấy chỉ số Unicode từ đầu chuỗi cho từng ký tự: cách đó phải
        // quét lại toàn bộ prefix và làm thời gian lexer tăng theo bình phương.
        // Duyệt UTF-8 đúng một lượt rồi giữ bảng code point cho các pass sau.
        các byte = chuỗi thành byte máy ảo(mã nguồn);
        // The source byte length is immutable throughout tokenization.
        số byte = máy ảo lấy độ dài(các byte);
        ký tự = [];
        mã ký tự cơ bản = [];
        lặp(i = 0; i < 128; i++) { máy ảo thêm cuối danh sách(mã ký tự cơ bản, chuỗi từ byte máy ảo([i])); };
        vị trí byte = [0];
        cột byte = [1];
        cột hiện tại = 1;
        vị trí = 0;
        khi (vị trí < số byte) {
            bước = 1;
            c = "";
            nếu (các byte[vị trí] < 128) {
                c = mã ký tự cơ bản[các byte[vị trí]];
            } hoặc {
                bước = bảng mã unicode tám bit độ dài đoạn(các byte, vị trí);
                nếu (bước < 1) { ném "biên dịch từ vựng: mã nguồn UTF-8 không hợp lệ"; };
                đoạn = [];
                lặp(j = 0; j < bước; j++) { máy ảo thêm cuối danh sách(đoạn, các byte[vị trí + j]); };
                c = chuỗi từ byte máy ảo(đoạn);
            };
            máy ảo thêm cuối danh sách(ký tự, c);
            vị trí += bước;
            nếu (c == "\n") { cột hiện tại = 1; }
            hoặc { cột hiện tại += bước; };
            máy ảo thêm cuối danh sách(vị trí byte, vị trí);
            máy ảo thêm cuối danh sách(cột byte, cột hiện tại);
        };
        n = máy ảo lấy độ dài(ký tự);
        kết quả = [];
        i = 0;
        dòng = 1;
        cột = 1;
        khi (i < n) {
            c = ký tự[i];
            tiếp = "";
            nếu (i + 1 < n) { tiếp = ký tự[i + 1]; };
            // UTF-8 continuation/leading bytes are >= 128. All whitespace
            // accepted by the previous helper is ASCII (9..13 or 32).
            // Read the existing byte-offset table instead of calling a V++
            // method and comparing several strings for every code point.
            mã ASCII = các byte[vị trí byte[i]];
            nếu (mã ASCII == 32 || (mã ASCII >= 9 && mã ASCII <= 13)) {
                nếu (c == "\n") { dòng += 1; cột = 1; }
                hoặc { cột += 1; };
                i += 1;
            } hoặc {
                nếu (c == "/" && tiếp == "/") {
                    i += 2;
                    cột += 2;
                    khi (i < n) {
                        nếu (ký tự[i] == "\n") { thoát; };
                        i += 1;
                        cột += 1;
                    };
                } hoặc {
                    nếu (c == "/" && tiếp == "*") {
                        đầu dòng = dòng;
                        đầu cột = cột;
                        i += 2;
                        cột += 2;
                        đóng = sai;
                        khi (i < n && !đóng) {
                            a = ký tự[i];
                            tiếp = "";
                            nếu (i + 1 < n) { tiếp = ký tự[i + 1]; };
                            nếu (a == "*" && tiếp == "/") {
                                i += 2;
                                cột += 2;
                                đóng = đúng;
                            } hoặc {
                                nếu (a == "\n") { dòng += 1; cột = 1; }
                                hoặc { cột += 1; };
                                i += 1;
                            };
                        };
                        nếu (!đóng) { mình.biên dịch từ vựng lỗi("chú thích khối chưa đóng", đầu dòng, đầu cột); };
                    } hoặc {
                        đầu = i;
                        đầu dòng = dòng;
                        đầu cột = cột;
                        giá trị = "";
                        nếu (c == "\"" || c == "'") {
                            nháy = c;
                            i += 1;
                            cột += 1;
                            đóng = sai;
                            khi (i < n && !đóng) {
                                a = ký tự[i];
                                nếu (a == "\n") {
                                    mình.biên dịch từ vựng lỗi("chuỗi chưa đóng", đầu dòng, đầu cột);
                                };
                                nếu (a == "\\" && i + 1 < n) {
                                    i += 2;
                                    cột += 2;
                                } hoặc {
                                    i += 1;
                                    cột += 1;
                                    nếu (a == nháy) { đóng = đúng; };
                                };
                            };
                            nếu (!đóng) { mình.biên dịch từ vựng lỗi("chuỗi chưa đóng", đầu dòng, đầu cột); };
                            giá trị = mình.biên dịch từ vựng đoạn(các byte, vị trí byte[đầu], vị trí byte[i]);
                        } hoặc {
                            // Recognize the thirteen two-byte operators by
                            // their ASCII bytes. Create the token string only
                            // when a valid operator has actually been found.
                            đôi = sai;
                            nếu (i + 1 < n) {
                                mã đầu = các byte[vị trí byte[i]];
                                nếu (mã đầu == 33 || mã đầu == 37 || mã đầu == 38 ||
                                    (mã đầu >= 42 && mã đầu <= 45) || mã đầu == 47 ||
                                    (mã đầu >= 60 && mã đầu <= 62) || mã đầu == 124) {
                                    mã sau = các byte[vị trí byte[i + 1]];
                                    nếu (mã sau == 61 && (mã đầu == 33 || mã đầu == 37 ||
                                        mã đầu == 42 || mã đầu == 43 || mã đầu == 45 ||
                                        mã đầu == 47 || (mã đầu >= 60 && mã đầu <= 62))) {
                                        đôi = đúng;
                                    };
                                    nếu (mã sau == mã đầu && (mã đầu == 38 || mã đầu == 43 ||
                                        mã đầu == 45 || mã đầu == 124)) { đôi = đúng; };
                                };
                            };
                            nếu (đôi) {
                                giá trị = c + ký tự[i + 1];
                                i += 2;
                                cột += 2;
                            } hoặc {
                                // Exactly the delimiters recognized by the
                                // original helper; '%' and '.' are not added.
                                nếu (mã ASCII == 34 || mã ASCII == 39 ||
                                    mã ASCII == 43 || mã ASCII == 45 || mã ASCII == 42 ||
                                    mã ASCII == 47 || mã ASCII == 40 || mã ASCII == 41 ||
                                    mã ASCII == 123 || mã ASCII == 125 ||
                                    mã ASCII == 91 || mã ASCII == 93 ||
                                    mã ASCII == 59 || mã ASCII == 44 ||
                                    mã ASCII == 60 || mã ASCII == 62 ||
                                    mã ASCII == 61 || mã ASCII == 33 || mã ASCII == 58) {
                                    giá trị = c;
                                    i += 1;
                                    cột += 1;
                                } hoặc {
                                    khi (i < n) {
                                        a = ký tự[i];
                                        mã quét = các byte[vị trí byte[i]];
                                        nếu (mã quét == 32 || (mã quét >= 9 && mã quét <= 13) ||
                                            mã quét == 34 || mã quét == 39 ||
                                            mã quét == 43 || mã quét == 45 || mã quét == 42 ||
                                            mã quét == 47 || mã quét == 40 || mã quét == 41 ||
                                            mã quét == 123 || mã quét == 125 ||
                                            mã quét == 91 || mã quét == 93 ||
                                            mã quét == 59 || mã quét == 44 ||
                                            mã quét == 60 || mã quét == 62 ||
                                            mã quét == 61 || mã quét == 33 || mã quét == 58) {
                                            thoát;
                                        };
                                        i += 1;
                                        cột += 1;
                                    };
                                    giá trị = mình.biên dịch từ vựng đoạn(các byte, vị trí byte[đầu], vị trí byte[i]);
                                };
                            };
                        };
                        máy ảo thêm cuối danh sách(kết quả, mình.biên dịch từ vựng từ tố(
                            giá trị, đầu dòng, cột byte[đầu],
                            vị trí byte[đầu], vị trí byte[i], đầu cột, đầu, i
                        ));
                    };
                };
            };
        };
        trả về kết quả;
    };

    // Hợp nhất từ khóa nhiều âm tiết theo cùng thứ tự lexer C++.
    hàm công khai biên dịch từ tố hóa(mã nguồn) {
        thô = mình.biên dịch từ tố hóa thô(mã nguồn);
        trả về mình.hợp nhất từ tố(thô);
    };

    hàm riêng tư hợp nhất từ tố(thô) {
        kết quả = [];
        cụm ba = ["kiểm tra sau", "ngoại thư viện"];
        cụm hai = ["mặc định", "trường hợp", "trả về", "bỏ qua",
            "khởi tạo", "điều kiện", "cập nhật", "bắt lỗi", "giao diện",
            "kế thừa", "triển khai", "công khai", "riêng tư", "bảo vệ",
            "ngoại hàm", "ký hiệu", "khả năng"];
        tiền tố = {"kiểm": đúng, "ngoại": đúng, "mặc": đúng,
            "trường": đúng, "trả": đúng, "bỏ": đúng, "khởi": đúng,
            "điều": đúng, "cập": đúng, "bắt": đúng, "giao": đúng,
            "kế": đúng, "triển": đúng, "công": đúng, "riêng": đúng,
            "bảo": đúng, "ký": đúng, "khả": đúng};
        i = 0;
        khi (i < máy ảo lấy độ dài(thô)) {
            đầu = thô[i];
            chuỗi ghép = lấy từ điển(đầu, "giá trị", "");
            bước = 1;
            nếu (máy ảo có khóa từ điển(tiền tố, chuỗi ghép) && i + 2 < máy ảo lấy độ dài(thô)) {
                lượt thử ba = chuỗi ghép + " " + lấy từ điển(thô[i + 1], "giá trị", "") +
                    " " + lấy từ điển(thô[i + 2], "giá trị", "");
                lặp(j = 0; j < máy ảo lấy độ dài(cụm ba); j++) {
                    nếu (lượt thử ba == cụm ba[j]) { chuỗi ghép = lượt thử ba; bước = 3; thoát; };
                };
            };
            nếu (bước == 1 && máy ảo có khóa từ điển(tiền tố, chuỗi ghép) && i + 1 < máy ảo lấy độ dài(thô)) {
                lượt thử hai = chuỗi ghép + " " + lấy từ điển(thô[i + 1], "giá trị", "");
                lặp(j = 0; j < máy ảo lấy độ dài(cụm hai); j++) {
                    nếu (lượt thử hai == cụm hai[j]) { chuỗi ghép = lượt thử hai; bước = 2; thoát; };
                };
            };
            nếu (bước == 1) {
                // Token thô đã có phân loại và span chính xác. Giữ nguyên
                // bản ghi để khỏi tạo map và phân loại lại mỗi token.
                máy ảo thêm cuối danh sách(kết quả, đầu);
            } hoặc {
                cuối = thô[i + bước - 1];
                máy ảo thêm cuối danh sách(kết quả, mình.biên dịch từ vựng từ tố(
                    chuỗi ghép,
                    lấy từ điển(đầu, "dòng", 1), lấy từ điển(đầu, "cột", 1),
                    lấy từ điển(đầu, "vị trí", 0), lấy từ điển(cuối, "kết thúc", 0),
                    lấy từ điển(đầu, "cột ký tự", 1),
                    lấy từ điển(đầu, "vị trí ký tự", 0),
                    lấy từ điển(cuối, "kết thúc ký tự", 0)
                ));
            };
            i += bước;
        };
        trả về kết quả;
    };
};


hàm công khai biên dịch từ tố hóa thô(mã nguồn) {
    bộ tách = Bộ Tách Từ Vựng(mã nguồn);
    trả về bộ tách.từ tố thô();
};

hàm công khai biên dịch từ tố hóa(mã nguồn) {
    bộ tách = Bộ Tách Từ Vựng(mã nguồn);
    trả về bộ tách.từ tố();
};
