// Bộ ghi object tự chủ bằng V++: ELF32/64, Mach-O64, COFF.
// Hợp đồng byte/section/symbol/relocation tương ứng src/native/object_writer.cpp.
// Dùng các word signed i32 để tránh tràn số khi ghi header unsigned 32-bit.
nhập gói.biên dịch.mã máy nền.biên dịch mã máy từ máy thập lục phân;
nhập gói.biên dịch.mã máy nền.biên dịch mã máy ký hiệu hợp lệ;
nhập gói.lõi.bảng mã.mã điểm unicode;

hàm công khai biên dịch đối tượng số(ra, số, rộng, ít) {
    nếu (rộng != 1 && rộng != 2 && rộng != 4) { ném "object: độ rộng số chưa hỗ trợ"; };
    tạm = [];
    lặp (i = 0; i < rộng; i++) {
        byte = số % 256;
        nếu (byte < 0) { byte += 256; };
        máy ảo thêm cuối danh sách(tạm, byte);
        số = (số - byte) / 256;
    };
    lặp (i = 0; i < rộng; i++) {
        nếu (ít) { máy ảo thêm cuối danh sách(ra, tạm[i]); }
        hoặc { máy ảo thêm cuối danh sách(ra, tạm[rộng - i - 1]); };
    };
};

hàm công khai biên dịch đối tượng u64(ra, thấp, cao, ít) {
    nếu (ít) {
        biên dịch đối tượng số(ra, thấp, 4, đúng);
        biên dịch đối tượng số(ra, cao, 4, đúng);
    } hoặc {
        biên dịch đối tượng số(ra, cao, 4, sai);
        biên dịch đối tượng số(ra, thấp, 4, sai);
    };
};

hàm công khai biên dịch đối tượng từ máy(ra, số, rộng, ít) {
    nếu (rộng == 4) { biên dịch đối tượng số(ra, số, 4, ít); }
    hoặc nếu (rộng == 8) { biên dịch đối tượng u64(ra, số, 0, ít); }
    hoặc { ném "object: word size không hợp lệ"; };
};

hàm công khai biên dịch đối tượng nối(ra, dữ liệu) {
    lặp (i = 0; i < máy ảo lấy độ dài(dữ liệu); i++) { máy ảo thêm cuối danh sách(ra, dữ liệu[i]); };
};

hàm công khai biên dịch đối tượng tên(ra, tên) {
    vị trí = máy ảo lấy độ dài(ra);
    lặp (i = 0; i < máy ảo lấy độ dài(tên); i++) {
        mã = mã điểm unicode(tên[i]);
        nếu (mã < 1 || mã > 127) { ném "object: tên symbol/section phải là ASCII"; };
        máy ảo thêm cuối danh sách(ra, mã);
    };
    máy ảo thêm cuối danh sách(ra, 0);
    trả về vị trí;
};

hàm công khai biên dịch đối tượng cố định(ra, tên, rộng) {
    nếu (máy ảo lấy độ dài(tên) > rộng) { ném "object: chuỗi cố định quá dài"; };
    lặp (i = 0; i < rộng; i++) {
        nếu (i < máy ảo lấy độ dài(tên)) { máy ảo thêm cuối danh sách(ra, mã điểm unicode(tên[i])); }
        hoặc { máy ảo thêm cuối danh sách(ra, 0); };
    };
};

hàm công khai biên dịch đối tượng canh(ra, số) {
    nếu (số <= 0) { ném "object: alignment không hợp lệ"; };
    lặp (i = 0; i < số; i++) {
        nếu (máy ảo lấy độ dài(ra) % số == 0) { thoát; };
        máy ảo thêm cuối danh sách(ra, 0);
    };
};

hàm công khai biên dịch đối tượng vá(ra, vị trí, số, rộng, ít) {
    tạm = [];
    biên dịch đối tượng từ máy(tạm, số, rộng, ít);
    nếu (vị trí < 0 || vị trí + rộng > máy ảo lấy độ dài(ra)) { ném "object: patch ngoài buffer"; };
    lặp (i = 0; i < rộng; i++) { ra[vị trí + i] = tạm[i]; };
};

hàm công khai biên dịch đối tượng ký hiệu(tên) {
    nếu (!biên dịch mã máy ký hiệu hợp lệ(tên)) {
        ném "tên symbol native không hợp lệ: " + tên;
    };
};

hàm công khai biên dịch đối tượng kiểm tra(mã, tên, tái định vị) {
    biên dịch đối tượng ký hiệu(tên);
    nếu (máy ảo lấy độ dài(mã) == 0) { ném "không có mã máy để xuất object"; };
    lặp (i = 0; i < máy ảo lấy độ dài(mã); i++) {
        nếu (mã[i] < 0 || mã[i] > 255) { ném "object: byte ngoài u8"; };
    };
    lặp (i = 0; i < máy ảo lấy độ dài(tái định vị); i++) {
        r = tái định vị[i];
        biên dịch đối tượng ký hiệu(r["symbol"]);
        nếu (r["offset"] < 0 || r["offset"] + 4 > máy ảo lấy độ dài(mã)) {
            ném "native object relocation offset không hợp lệ";
        };
    };
};

hàm công khai biên dịch đối tượng elf thông tin(kiến trúc) {
    chọn (kiến trúc) {
        ca "x86_64": { trả về {"machine": 62, "small": sai, "little": đúng, "align": 1}; }
        ca "aarch64": { trả về {"machine": 183, "small": sai, "little": đúng, "align": 4}; }
        ca "riscv64": { trả về {"machine": 243, "small": sai, "little": đúng, "align": 4}; }
        ca "armv7": { trả về {"machine": 40, "small": đúng, "little": đúng, "align": 4}; }
        ca "i386": { trả về {"machine": 3, "small": đúng, "little": đúng, "align": 1}; }
        ca "powerpc": { trả về {"machine": 20, "small": đúng, "little": sai, "align": 4}; }
        ca "powerpc64": { trả về {"machine": 21, "small": sai, "little": sai, "align": 4}; }
        ca "powerpc64le": { trả về {"machine": 21, "small": sai, "little": đúng, "align": 4}; }
        ca "mips": { trả về {"machine": 8, "small": đúng, "little": sai, "align": 4}; }
        ca "mipsel": { trả về {"machine": 8, "small": đúng, "little": đúng, "align": 4}; }
        ca "mips64": { trả về {"machine": 8, "small": sai, "little": sai, "align": 4}; }
        ca "mips64el": { trả về {"machine": 8, "small": sai, "little": đúng, "align": 4}; }
        ca "loongarch64": { trả về {"machine": 258, "small": sai, "little": đúng, "align": 4}; }
        ca "s390x": { trả về {"machine": 22, "small": sai, "little": sai, "align": 4}; }
        ca "sparc": { trả về {"machine": 2, "small": đúng, "little": sai, "align": 4}; }
        ca "sparc64": { trả về {"machine": 43, "small": sai, "little": sai, "align": 4}; }
        mặc định: { ném "ELF machine chưa được đăng ký: " + kiến trúc; }
    };
};

hàm công khai biên dịch đối tượng elf mục(ra, tên, loại, cờ, độ lệch, dài, liên kết, thông tin, căn, kích thước mục, rộng, ít) {
    biên dịch đối tượng số(ra, tên, 4, ít);
    biên dịch đối tượng số(ra, loại, 4, ít);
    biên dịch đối tượng từ máy(ra, cờ, rộng, ít);
    biên dịch đối tượng từ máy(ra, 0, rộng, ít);
    biên dịch đối tượng từ máy(ra, độ lệch, rộng, ít);
    biên dịch đối tượng từ máy(ra, dài, rộng, ít);
    biên dịch đối tượng số(ra, liên kết, 4, ít);
    biên dịch đối tượng số(ra, thông tin, 4, ít);
    biên dịch đối tượng từ máy(ra, căn, rộng, ít);
    biên dịch đối tượng từ máy(ra, kích thước mục, rộng, ít);
};

hàm công khai biên dịch đối tượng elf(kiến trúc, abi, mã, tên, tái định vị) {
    k = biên dịch đối tượng elf thông tin(kiến trúc);
    bé = k["small"];
    ít = k["little"];
    rộng = 8;
    phần đầu = 64;
    mục kích cỡ = 64;
    mục ký hiệu kích cỡ = 24;
    nếu (bé) { rộng = 4; phần đầu = 52; mục kích cỡ = 40; mục ký hiệu kích cỡ = 16; };
    ppc v1 = kiến trúc == "powerpc64";
    có tái định vị = máy ảo lấy độ dài(tái định vị) > 0;
    nếu (có tái định vị && kiến trúc != "x86_64" && kiến trúc != "aarch64") {
        ném "ELF external CALL chỉ hỗ trợ x86_64/AArch64";
    };
    ra = [127, 69, 76, 70];
    nếu (bé) { máy ảo thêm cuối danh sách(ra, 1); } hoặc { máy ảo thêm cuối danh sách(ra, 2); };
    nếu (ít) { máy ảo thêm cuối danh sách(ra, 1); } hoặc { máy ảo thêm cuối danh sách(ra, 2); };
    máy ảo thêm cuối danh sách(ra, 1); máy ảo thêm cuối danh sách(ra, 0); máy ảo thêm cuối danh sách(ra, 0);
    lặp (i = 0; i < 7; i++) { máy ảo thêm cuối danh sách(ra, 0); };
    biên dịch đối tượng số(ra, 1, 2, ít);
    biên dịch đối tượng số(ra, k["machine"], 2, ít);
    biên dịch đối tượng số(ra, 1, 4, ít);
    biên dịch đối tượng từ máy(ra, 0, rộng, ít);
    biên dịch đối tượng từ máy(ra, 0, rộng, ít);
    phân đoạn vá = máy ảo lấy độ dài(ra);
    biên dịch đối tượng từ máy(ra, 0, rộng, ít);
    cờ = 0;
    nếu (kiến trúc == "armv7") {
        cờ = 83886080;
        nếu (abi == "gnueabihf" || abi == "musleabihf") { cờ += 1024; };
    };
    nếu (kiến trúc == "riscv64") { cờ = 4; };
    nếu (kiến trúc == "loongarch64") { cờ = 3; };
    nếu (ppc v1) { cờ = 1; };
    nếu (kiến trúc == "powerpc64le") { cờ = 2; };
    biên dịch đối tượng số(ra, cờ, 4, ít);
    biên dịch đối tượng số(ra, phần đầu, 2, ít);
    biên dịch đối tượng số(ra, 0, 2, ít);
    biên dịch đối tượng số(ra, 0, 2, ít);
    biên dịch đối tượng số(ra, mục kích cỡ, 2, ít);
    n = 5;
    chuỗi tên phân đoạn chỉ mục = 4;
    nếu (có tái định vị) { n = 6; chuỗi tên phân đoạn chỉ mục = 5; };
    nếu (ppc v1) { n = 7; chuỗi tên phân đoạn chỉ mục = 6; };
    biên dịch đối tượng số(ra, n, 2, ít);
    biên dịch đối tượng số(ra, chuỗi tên phân đoạn chỉ mục, 2, ít);
    nếu (máy ảo lấy độ dài(ra) != phần đầu) { ném "ELF header size không khớp"; };

    biên dịch đối tượng canh(ra, k["align"]);
    văn bản độ dời = máy ảo lấy độ dài(ra);
    biên dịch đối tượng nối(ra, mã);
    biên dịch đối tượng canh(ra, rộng);
    opd độ dời = 0;
    tái định vị bổ sung độ dời = 0;
    nếu (ppc v1) {
        opd độ dời = máy ảo lấy độ dài(ra);
        lặp (i = 0; i < 3; i++) { biên dịch đối tượng u64(ra, 0, 0, ít); };
        tái định vị bổ sung độ dời = máy ảo lấy độ dài(ra);
        biên dịch đối tượng u64(ra, 0, 0, ít);
        biên dịch đối tượng u64(ra, 38, 1, ít);
        biên dịch đối tượng u64(ra, 0, 0, ít);
        // ELFv1 .opd cần relocation thứ hai R_PPC64_TOC tại offset 8.
        biên dịch đối tượng u64(ra, 8, 0, ít);
        biên dịch đối tượng u64(ra, 51, 0, ít);
        biên dịch đối tượng u64(ra, 0, 0, ít);
    };
    văn bản tái định vị bổ sung độ dời = 0;
    nếu (có tái định vị) {
        văn bản tái định vị bổ sung độ dời = máy ảo lấy độ dài(ra);
        lặp (i = 0; i < máy ảo lấy độ dài(tái định vị); i++) {
            r = tái định vị[i];
            biên dịch đối tượng u64(ra, r["offset"], 0, ít);
            loại = 4;
            nếu (kiến trúc == "aarch64") { loại = 283; };
            biên dịch đối tượng u64(ra, loại, 2 + i, ít);
            số hạng cộng = 0;
            nếu (kiến trúc == "x86_64") { số hạng cộng = -4; };
            cao = 0;
            nếu (số hạng cộng < 0) { cao = -1; };
            biên dịch đối tượng u64(ra, số hạng cộng, cao, ít);
        };
    };
    mục ký hiệu độ dời = máy ảo lấy độ dài(ra);
    lặp (i = 0; i < mục ký hiệu kích cỡ; i++) { máy ảo thêm cuối danh sách(ra, 0); };
    nếu (ppc v1) {
        biên dịch đối tượng số(ra, 0, 4, ít);
        máy ảo thêm cuối danh sách(ra, 3); máy ảo thêm cuối danh sách(ra, 0);
        biên dịch đối tượng số(ra, 1, 2, ít);
        biên dịch đối tượng u64(ra, 0, 0, ít);
        biên dịch đối tượng u64(ra, 0, 0, ít);
    };
    nếu (bé) {
        biên dịch đối tượng số(ra, 1, 4, ít);
        biên dịch đối tượng số(ra, 0, 4, ít);
        biên dịch đối tượng số(ra, máy ảo lấy độ dài(mã), 4, ít);
        máy ảo thêm cuối danh sách(ra, 18); máy ảo thêm cuối danh sách(ra, 0);
        biên dịch đối tượng số(ra, 1, 2, ít);
    } hoặc {
        biên dịch đối tượng số(ra, 1, 4, ít);
        máy ảo thêm cuối danh sách(ra, 18); máy ảo thêm cuối danh sách(ra, 0);
        nơi = 1;
        nếu (ppc v1) { nơi = 2; };
        biên dịch đối tượng số(ra, nơi, 2, ít);
        biên dịch đối tượng u64(ra, 0, 0, ít);
        dài = máy ảo lấy độ dài(mã);
        nếu (ppc v1) { dài = 24; };
        biên dịch đối tượng u64(ra, dài, 0, ít);
    };
    các chuỗi = [0];
    biên dịch đối tượng tên(các chuỗi, tên);
    lặp (i = 0; i < máy ảo lấy độ dài(tái định vị); i++) {
        tên độ lệch = biên dịch đối tượng tên(các chuỗi, tái định vị[i]["symbol"]);
        biên dịch đối tượng số(ra, tên độ lệch, 4, ít);
        máy ảo thêm cuối danh sách(ra, 18); máy ảo thêm cuối danh sách(ra, 0);
        biên dịch đối tượng số(ra, 0, 2, ít);
        biên dịch đối tượng u64(ra, 0, 0, ít);
        biên dịch đối tượng u64(ra, 0, 0, ít);
    };
    chuỗi độ dời = máy ảo lấy độ dài(ra);
    biên dịch đối tượng nối(ra, các chuỗi);
    tên mục = [0];
    văn bản tên định danh = biên dịch đối tượng tên(tên mục, ".text");
    opd tên định danh = 0;
    tái định vị bổ sung tên định danh = 0;
    nếu (ppc v1) {
        opd tên định danh = biên dịch đối tượng tên(tên mục, ".opd");
        tái định vị bổ sung tên định danh = biên dịch đối tượng tên(tên mục, ".rela.opd");
    };
    văn bản tái định vị bổ sung tên định danh = 0;
    nếu (có tái định vị) { văn bản tái định vị bổ sung tên định danh = biên dịch đối tượng tên(tên mục, ".rela.text"); };
    mục ký hiệu tên định danh = biên dịch đối tượng tên(tên mục, ".symtab");
    chuỗi tên định danh = biên dịch đối tượng tên(tên mục, ".strtab");
    chuỗi tên phân đoạn tên định danh = biên dịch đối tượng tên(tên mục, ".shstrtab");
    chuỗi tên phân đoạn độ dời = máy ảo lấy độ dài(ra);
    biên dịch đối tượng nối(ra, tên mục);
    biên dịch đối tượng canh(ra, rộng);
    độ lệch tiêu đề phân đoạn = máy ảo lấy độ dài(ra);
    biên dịch đối tượng vá(ra, phân đoạn vá, độ lệch tiêu đề phân đoạn, rộng, ít);
    biên dịch đối tượng elf mục(ra, 0, 0, 0, 0, 0, 0, 0, 0, 0, rộng, ít);
    biên dịch đối tượng elf mục(ra, văn bản tên định danh, 1, 6, văn bản độ dời, máy ảo lấy độ dài(mã), 0, 0, k["align"], 0, rộng, ít);
    nếu (ppc v1) {
        biên dịch đối tượng elf mục(ra, opd tên định danh, 1, 3, opd độ dời, 24, 0, 0, 8, 0, rộng, ít);
        biên dịch đối tượng elf mục(ra, tái định vị bổ sung tên định danh, 4, 0, tái định vị bổ sung độ dời, 48, 4, 2, 8, 24, rộng, ít);
    };
    nếu (có tái định vị) {
        biên dịch đối tượng elf mục(ra, văn bản tái định vị bổ sung tên định danh, 4, 0, văn bản tái định vị bổ sung độ dời,
            máy ảo lấy độ dài(tái định vị) * 24, 3, 1, 8, 24, rộng, ít);
    };
    n các ký hiệu = 2 + máy ảo lấy độ dài(tái định vị);
    chuỗi chỉ mục = 3;
    thông tin = 1;
    nếu (có tái định vị) { chuỗi chỉ mục = 4; };
    nếu (ppc v1) { chuỗi chỉ mục = 5; n các ký hiệu = 3; thông tin = 2; };
    biên dịch đối tượng elf mục(ra, mục ký hiệu tên định danh, 2, 0, mục ký hiệu độ dời,
        n các ký hiệu * mục ký hiệu kích cỡ, chuỗi chỉ mục, thông tin, rộng, mục ký hiệu kích cỡ, rộng, ít);
    biên dịch đối tượng elf mục(ra, chuỗi tên định danh, 3, 0, chuỗi độ dời, máy ảo lấy độ dài(các chuỗi), 0, 0, 1, 0, rộng, ít);
    biên dịch đối tượng elf mục(ra, chuỗi tên phân đoạn tên định danh, 3, 0, chuỗi tên phân đoạn độ dời, máy ảo lấy độ dài(tên mục), 0, 0, 1, 0, rộng, ít);
    nếu (máy ảo lấy độ dài(ra) != độ lệch tiêu đề phân đoạn + n * mục kích cỡ) { ném "ELF section table size không khớp"; };
    trả về ra;
};

hàm công khai biên dịch đối tượng macho(kiến trúc, mã, tên, tái định vị) {
    bộ xử lý trung tâm = 0;
    subtype = 0;
    nếu (kiến trúc == "aarch64") { bộ xử lý trung tâm = 16777228; }
    hoặc nếu (kiến trúc == "x86_64") { bộ xử lý trung tâm = 16777223; subtype = 3; }
    hoặc { ném "Mach-O chỉ hỗ trợ arm64 và x86_64"; };
    văn bản độ dời = 232;
    tái định vị độ dời = ((văn bản độ dời + máy ảo lấy độ dài(mã) + 3) / 4) * 4;
    mục ký hiệu độ dời = ((tái định vị độ dời + máy ảo lấy độ dài(tái định vị) * 8 + 7) / 8) * 8;
    các tên định danh = [0];
    biên dịch đối tượng tên(các tên định danh, "_" + tên);
    tên các độ lệch = [];
    lặp (i = 0; i < máy ảo lấy độ dài(tái định vị); i++) {
        máy ảo thêm cuối danh sách(tên các độ lệch, biên dịch đối tượng tên(các tên định danh, "_" + tái định vị[i]["symbol"]));
    };
    chuỗi độ dời = mục ký hiệu độ dời + 16 * (1 + máy ảo lấy độ dài(tái định vị));
    ra = [];
    biên dịch đối tượng số(ra, biên dịch mã máy từ máy thập lục phân("feedfacf"), 4, đúng);
    biên dịch đối tượng số(ra, bộ xử lý trung tâm, 4, đúng);
    biên dịch đối tượng số(ra, subtype, 4, đúng);
    biên dịch đối tượng số(ra, 1, 4, đúng);
    biên dịch đối tượng số(ra, 3, 4, đúng);
    biên dịch đối tượng số(ra, 200, 4, đúng);
    biên dịch đối tượng số(ra, 8192, 4, đúng);
    biên dịch đối tượng số(ra, 0, 4, đúng);
    biên dịch đối tượng số(ra, 25, 4, đúng);
    biên dịch đối tượng số(ra, 152, 4, đúng);
    biên dịch đối tượng cố định(ra, "__TEXT", 16);
    biên dịch đối tượng u64(ra, 0, 0, đúng);
    biên dịch đối tượng u64(ra, máy ảo lấy độ dài(mã), 0, đúng);
    biên dịch đối tượng u64(ra, văn bản độ dời, 0, đúng);
    biên dịch đối tượng u64(ra, máy ảo lấy độ dài(mã), 0, đúng);
    biên dịch đối tượng số(ra, 7, 4, đúng);
    biên dịch đối tượng số(ra, 5, 4, đúng);
    biên dịch đối tượng số(ra, 1, 4, đúng);
    biên dịch đối tượng số(ra, 0, 4, đúng);
    biên dịch đối tượng cố định(ra, "__text", 16);
    biên dịch đối tượng cố định(ra, "__TEXT", 16);
    biên dịch đối tượng u64(ra, 0, 0, đúng);
    biên dịch đối tượng u64(ra, máy ảo lấy độ dài(mã), 0, đúng);
    biên dịch đối tượng số(ra, văn bản độ dời, 4, đúng);
    căn = 0;
    nếu (kiến trúc == "aarch64") { căn = 2; };
    biên dịch đối tượng số(ra, căn, 4, đúng);
    r độ dời = 0;
    nếu (máy ảo lấy độ dài(tái định vị) > 0) { r độ dời = tái định vị độ dời; };
    biên dịch đối tượng số(ra, r độ dời, 4, đúng);
    biên dịch đối tượng số(ra, máy ảo lấy độ dài(tái định vị), 4, đúng);
    biên dịch đối tượng số(ra, biên dịch mã máy từ máy thập lục phân("80000400"), 4, đúng);
    lặp (i = 0; i < 3; i++) { biên dịch đối tượng số(ra, 0, 4, đúng); };
    biên dịch đối tượng số(ra, 2, 4, đúng);
    biên dịch đối tượng số(ra, 24, 4, đúng);
    biên dịch đối tượng số(ra, mục ký hiệu độ dời, 4, đúng);
    biên dịch đối tượng số(ra, 1 + máy ảo lấy độ dài(tái định vị), 4, đúng);
    biên dịch đối tượng số(ra, chuỗi độ dời, 4, đúng);
    biên dịch đối tượng số(ra, máy ảo lấy độ dài(các tên định danh), 4, đúng);
    biên dịch đối tượng số(ra, 50, 4, đúng);
    biên dịch đối tượng số(ra, 24, 4, đúng);
    biên dịch đối tượng số(ra, 1, 4, đúng);
    phiên bản = 659200;
    nếu (kiến trúc == "aarch64") { phiên bản = 720896; };
    biên dịch đối tượng số(ra, phiên bản, 4, đúng);
    biên dịch đối tượng số(ra, 0, 4, đúng);
    biên dịch đối tượng số(ra, 0, 4, đúng);
    nếu (máy ảo lấy độ dài(ra) != văn bản độ dời) { ném "Mach-O header size không khớp"; };
    biên dịch đối tượng nối(ra, mã);
    biên dịch đối tượng canh(ra, 4);
    lặp (i = 0; i < máy ảo lấy độ dài(tái định vị); i++) {
        biên dịch đối tượng số(ra, tái định vị[i]["offset"], 4, đúng);
        biên dịch đối tượng số(ra, (i + 1) + 16777216 + 67108864 + 134217728 + 536870912, 4, đúng);
    };
    biên dịch đối tượng canh(ra, 8);
    nếu (máy ảo lấy độ dài(ra) != mục ký hiệu độ dời) { ném "Mach-O symbol alignment không khớp"; };
    biên dịch đối tượng số(ra, 1, 4, đúng);
    máy ảo thêm cuối danh sách(ra, 15); máy ảo thêm cuối danh sách(ra, 1);
    biên dịch đối tượng số(ra, 0, 2, đúng);
    biên dịch đối tượng u64(ra, 0, 0, đúng);
    lặp (i = 0; i < máy ảo lấy độ dài(tên các độ lệch); i++) {
        biên dịch đối tượng số(ra, tên các độ lệch[i], 4, đúng);
        máy ảo thêm cuối danh sách(ra, 1); máy ảo thêm cuối danh sách(ra, 0);
        biên dịch đối tượng số(ra, 0, 2, đúng);
        biên dịch đối tượng u64(ra, 0, 0, đúng);
    };
    biên dịch đối tượng nối(ra, các tên định danh);
    trả về ra;
};

hàm công khai biên dịch đối tượng coff tên(ra, các chuỗi, tên) {
    nếu (máy ảo lấy độ dài(tên) <= 8) { biên dịch đối tượng cố định(ra, tên, 8); }
    hoặc {
        biên dịch đối tượng số(ra, 0, 4, đúng);
        biên dịch đối tượng số(ra, 4 + máy ảo lấy độ dài(các chuỗi), 4, đúng);
        biên dịch đối tượng tên(các chuỗi, tên);
    };
};

hàm công khai biên dịch đối tượng coff(kiến trúc, mã, tên, tái định vị) {
    machine = 0;
    đã xuất = tên;
    nếu (kiến trúc == "x86_64") { machine = 34404; }
    hoặc nếu (kiến trúc == "i386") { machine = 332; đã xuất = "_" + tên; }
    hoặc { ném "COFF chỉ hỗ trợ i386 và x86_64"; };
    nếu (máy ảo lấy độ dài(tái định vị) > 0 && kiến trúc != "x86_64") {
        ném "COFF external CALL chỉ hỗ trợ x86_64";
    };
    văn bản độ dời = 60;
    tái định vị độ dời = văn bản độ dời + máy ảo lấy độ dài(mã);
    mục ký hiệu độ dời = ((tái định vị độ dời + máy ảo lấy độ dài(tái định vị) * 10 + 3) / 4) * 4;
    ra = [];
    biên dịch đối tượng số(ra, machine, 2, đúng);
    biên dịch đối tượng số(ra, 1, 2, đúng);
    biên dịch đối tượng số(ra, 0, 4, đúng);
    biên dịch đối tượng số(ra, mục ký hiệu độ dời, 4, đúng);
    biên dịch đối tượng số(ra, 1 + máy ảo lấy độ dài(tái định vị), 4, đúng);
    biên dịch đối tượng số(ra, 0, 2, đúng);
    biên dịch đối tượng số(ra, 0, 2, đúng);
    biên dịch đối tượng cố định(ra, ".text", 8);
    biên dịch đối tượng số(ra, 0, 4, đúng);
    biên dịch đối tượng số(ra, 0, 4, đúng);
    biên dịch đối tượng số(ra, máy ảo lấy độ dài(mã), 4, đúng);
    biên dịch đối tượng số(ra, văn bản độ dời, 4, đúng);
    r độ dời = 0;
    nếu (máy ảo lấy độ dài(tái định vị) > 0) { r độ dời = tái định vị độ dời; };
    biên dịch đối tượng số(ra, r độ dời, 4, đúng);
    biên dịch đối tượng số(ra, 0, 4, đúng);
    biên dịch đối tượng số(ra, máy ảo lấy độ dài(tái định vị), 2, đúng);
    biên dịch đối tượng số(ra, 0, 2, đúng);
    biên dịch đối tượng số(ra, 1610612768, 4, đúng);
    biên dịch đối tượng nối(ra, mã);
    lặp (i = 0; i < máy ảo lấy độ dài(tái định vị); i++) {
        biên dịch đối tượng số(ra, tái định vị[i]["offset"], 4, đúng);
        biên dịch đối tượng số(ra, i + 1, 4, đúng);
        biên dịch đối tượng số(ra, 4, 2, đúng);
    };
    biên dịch đối tượng canh(ra, 4);
    nếu (máy ảo lấy độ dài(ra) != mục ký hiệu độ dời) { ném "COFF symbol alignment không khớp"; };
    các chuỗi = [];
    biên dịch đối tượng coff tên(ra, các chuỗi, đã xuất);
    biên dịch đối tượng số(ra, 0, 4, đúng);
    biên dịch đối tượng số(ra, 1, 2, đúng);
    biên dịch đối tượng số(ra, 32, 2, đúng);
    máy ảo thêm cuối danh sách(ra, 2); máy ảo thêm cuối danh sách(ra, 0);
    lặp (i = 0; i < máy ảo lấy độ dài(tái định vị); i++) {
        biên dịch đối tượng coff tên(ra, các chuỗi, tái định vị[i]["symbol"]);
        biên dịch đối tượng số(ra, 0, 4, đúng);
        biên dịch đối tượng số(ra, 0, 2, đúng);
        biên dịch đối tượng số(ra, 32, 2, đúng);
        máy ảo thêm cuối danh sách(ra, 2); máy ảo thêm cuối danh sách(ra, 0);
    };
    biên dịch đối tượng số(ra, 4 + máy ảo lấy độ dài(các chuỗi), 4, đúng);
    biên dịch đối tượng nối(ra, các chuỗi);
    trả về ra;
};

// Public API. Không thay đổi format trên mỗi kiến trúc; lỗi chưa hỗ trợ ném ra.
hàm công khai biên dịch đối tượng(kiến trúc, hệ điều hành, abi, mã, tên, tái định vị) {
    biên dịch đối tượng kiểm tra(mã, tên, tái định vị);
    chọn (hệ điều hành) {
        ca "linux": { trả về biên dịch đối tượng elf(kiến trúc, abi, mã, tên, tái định vị); }
        ca "macos": { trả về biên dịch đối tượng macho(kiến trúc, mã, tên, tái định vị); }
        ca "windows": { trả về biên dịch đối tượng coff(kiến trúc, mã, tên, tái định vị); }
        mặc định: { ném "hệ điều hành không có object writer V++: " + hệ điều hành; }
    };
};
