// Bảng ABI duy nhất cho các primitive lõi được phép gọi trực tiếp từ mã nguồn.
// ID phải giữ ổn định vì bytecode bootstrap lưu ID này trong OP_GOI_LOI_BAN_DIA.
hàm công khai biên dịch ABI lõi bản địa(tên) {
    nếu (tên == "byte mới") { trả về {"id": 0, "symbol": "vpp_native_bytes_new", "arity": 0}; };
    nếu (tên == "byte dài") { trả về {"id": 1, "symbol": "vpp_native_bytes_length", "arity": 1}; };
    nếu (tên == "byte lấy") { trả về {"id": 2, "symbol": "vpp_native_bytes_get", "arity": 2}; };
    nếu (tên == "byte thêm") { trả về {"id": 3, "symbol": "vpp_native_bytes_append", "arity": 2}; };
    nếu (tên == "byte đẩy số nguyên ba mươi hai bit") { trả về {"id": 4, "symbol": "vpp_native_bytes_push_i32", "arity": 2}; };
    nếu (tên == "byte đọc số nguyên ba mươi hai bit") { trả về {"id": 5, "symbol": "vpp_native_bytes_load_i32", "arity": 2}; };
    nếu (tên == "byte ghi số nguyên ba mươi hai bit") { trả về {"id": 6, "symbol": "vpp_native_bytes_store_i32", "arity": 3}; };
    nếu (tên == "byte làm rỗng") { trả về {"id": 7, "symbol": "vpp_native_bytes_clear", "arity": 1}; };
    nếu (tên == "byte nối") { trả về {"id": 8, "symbol": "vpp_native_bytes_concat", "arity": 2}; };
    nếu (tên == "byte bằng") { trả về {"id": 9, "symbol": "vpp_native_bytes_equal", "arity": 2}; };
    nếu (tên == "byte hủy") { trả về {"id": 10, "symbol": "vpp_native_bytes_free", "arity": 1}; };
    nếu (tên == "đối số đếm") { trả về {"id": 11, "symbol": "vpp_native_argc", "arity": 0}; };
    nếu (tên == "đối số lấy") { trả về {"id": 12, "symbol": "vpp_native_argv", "arity": 1}; };
    nếu (tên == "tệp mở đọc") { trả về {"id": 13, "symbol": "vpp_native_file_open_read", "arity": 1}; };
    nếu (tên == "tệp đọc khối") { trả về {"id": 14, "symbol": "vpp_native_file_read_block", "arity": 2}; };
    nếu (tên == "tệp đóng") { trả về {"id": 15, "symbol": "vpp_native_file_close", "arity": 1}; };
    nếu (tên == "liên kết macho") { trả về {"id": 16, "symbol": "vpp_native_link_macho", "arity": 3}; };
    nếu (tên == "liên kết đối tượng") { trả về {"id": 17, "symbol": "vpp_native_link_macho_modules", "arity": 3}; };
    nếu (tên == "bộ nhớ đệm đọc") { trả về {"id": 18, "symbol": "vpp_native_cache_read", "arity": 2}; };
    nếu (tên == "bộ nhớ đệm ghi") { trả về {"id": 19, "symbol": "vpp_native_cache_write", "arity": 2}; };
    nếu (tên == "byte cắt") { trả về {"id": 20, "symbol": "vpp_native_bytes_slice", "arity": 3}; };
    nếu (tên == "byte tìm") { trả về {"id": 21, "symbol": "vpp_native_bytes_find", "arity": 2}; };
    nếu (tên == "byte in") { trả về {"id": 22, "symbol": "vpp_native_bytes_print", "arity": 1}; };
    nếu (tên == "tệp mở ghi") { trả về {"id": 23, "symbol": "vpp_native_file_open_write", "arity": 1}; };
    nếu (tên == "tệp ghi khối") { trả về {"id": 24, "symbol": "vpp_native_file_write_block", "arity": 2}; };
    nếu (tên == "máy đọc byte") { trả về {"id": 25, "symbol": "vpp_native_memory_read_byte", "arity": 1}; };
    nếu (tên == "máy ghi byte") { trả về {"id": 26, "symbol": "vpp_native_memory_write_byte", "arity": 2}; };
    nếu (tên == "máy đọc số nguyên ba mươi hai bit") { trả về {"id": 27, "symbol": "vpp_native_memory_read_i32", "arity": 1}; };
    nếu (tên == "máy ghi số nguyên ba mươi hai bit") { trả về {"id": 28, "symbol": "vpp_native_memory_write_i32", "arity": 2}; };
    nếu (tên == "máy gắn địa chỉ") { trả về {"id": 29, "symbol": "vpp_native_memory_bind", "arity": 2}; };
    nếu (tên == "máy mở") { trả về {"id": 30, "symbol": "vpp_native_os_open", "arity": 2}; };
    nếu (tên == "máy đọc") { trả về {"id": 31, "symbol": "vpp_native_os_read", "arity": 3}; };
    nếu (tên == "máy ghi") { trả về {"id": 32, "symbol": "vpp_native_os_write", "arity": 3}; };
    nếu (tên == "máy đóng") { trả về {"id": 33, "symbol": "vpp_native_os_close", "arity": 1}; };
    nếu (tên == "máy lỗi") { trả về {"id": 34, "symbol": "vpp_native_os_errno", "arity": 0}; };
    nếu (tên == "máy đối số dài") { trả về {"id": 35, "symbol": "vpp_native_os_argument_length", "arity": 1}; };
    nếu (tên == "máy đối số byte") { trả về {"id": 36, "symbol": "vpp_native_os_argument_byte", "arity": 2}; };
    nếu (tên == "máy chia số nguyên ba mươi hai bit") { trả về {"id": 37, "symbol": "vpp_native_i32_div", "arity": 2}; };
    nếu (tên == "môi trường thực thi nguồn") { trả về {"id": 38, "symbol": "vpp_native_runtime_module_path", "arity": 0}; };
    nếu (tên == "đọc số") { trả về {"id": 40, "symbol": "vpp_native_read_i32", "arity": 0}; };
    nếu (tên == "trạng thái đọc") { trả về {"id": 41, "symbol": "vpp_native_read_status", "arity": 0}; };
    nếu (tên == "tệp đọc byte") { trả về {"id": 42, "symbol": "vpp_native_file_read_byte", "arity": 1}; };
    nếu (tên == "tệp ghi byte") { trả về {"id": 43, "symbol": "vpp_native_file_write_byte", "arity": 2}; };
    nếu (tên == "máy thư mục nhà") { trả về {"id": 44, "symbol": "vpp_native_os_home", "arity": 1}; };
    nếu (tên == "máy thư mục hiện hành") { trả về {"id": 45, "symbol": "vpp_native_os_cwd", "arity": 1}; };
    nếu (tên == "máy tạm mở") { trả về {"id": 46, "symbol": "vpp_native_os_mkstemp", "arity": 1}; };
    nếu (tên == "máy đổi tên") { trả về {"id": 47, "symbol": "vpp_native_os_rename", "arity": 2}; };
    nếu (tên == "máy khởi chạy clang") { trả về {"id": 48, "symbol": "vpp_native_os_spawn_clang", "arity": 1}; };
    nếu (tên == "máy đợi") { trả về {"id": 49, "symbol": "vpp_native_os_waitpid", "arity": 2}; };
    nếu (tên == "máy thông tin tệp") { trả về {"id": 50, "symbol": "vpp_native_os_stat", "arity": 2}; };
    nếu (tên == "máy thông tin liên kết") { trả về {"id": 51, "symbol": "vpp_native_os_lstat", "arity": 2}; };
    nếu (tên == "máy quyền chạy") { trả về {"id": 52, "symbol": "vpp_native_os_access_exec", "arity": 1}; };
    nếu (tên == "máy xóa") { trả về {"id": 53, "symbol": "vpp_native_os_unlink", "arity": 1}; };
    nếu (tên == "máy giá trị môi trường lấy") { trả về {"id": 54, "symbol": "vpp_native_os_env_copy", "arity": 2}; };
    nếu (tên == "máy tệp thực thi lấy") { trả về {"id": 55, "symbol": "vpp_native_os_executable_path", "arity": 1}; };
    nếu (tên == "máy tạo thư mục") { trả về {"id": 56, "symbol": "vpp_native_os_mkdir", "arity": 1}; };
    nếu (tên == "máy thông tin tệp mở") { trả về {"id": 57, "symbol": "vpp_native_os_fstat", "arity": 2}; };
    nếu (tên == "máy sha bắt đầu") { trả về {"id": 58, "symbol": "vpp_native_sha_begin", "arity": 0}; };
    nếu (tên == "máy sha nạp") { trả về {"id": 59, "symbol": "vpp_native_sha_update", "arity": 2}; };
    nếu (tên == "máy sha kết") { trả về {"id": 60, "symbol": "vpp_native_sha_end", "arity": 1}; };
    nếu (tên == "máy báo cáo bộ nhớ đệm") { trả về {"id": 61, "symbol": "vpp_native_os_register_cache_report", "arity": 0}; };
    nếu (tên == "máy đặt quyền tệp mở") { trả về {"id": 78, "symbol": "vpp_native_os_fchmod", "arity": 2}; };
    trả về rỗng;
};
