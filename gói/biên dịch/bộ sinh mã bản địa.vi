// Một target ABI dùng chung cho phát mã lá, Machine IR và ghi object.
// Encoder/writer thuần được giữ nguyên để bảo toàn byte và relocation.
nhập gói/biên dịch/đích;
nhập gói/biên dịch/mã máy;
nhập gói/biên dịch/đối tượng;

lớp công khai Bộ Sinh Mã Bản Địa {
    hàm công khai khởi tạo(triple) { mình.đích = biên dịch phân tích đích(triple); };
    hàm công khai triple() { trả về biên dịch triple chuẩn(mình.đích); };
    hàm công khai lá(loại, hằng = 0) {
        đích = mình.đích;
        trả về biên dịch mã máy lá(đích["kiến trúc"], loại, hằng, đích["hệ điều hành"]);
    };
    hàm công khai hàm máy(hàm_ir) {
        đích = mình.đích;
        trả về biên dịch mã máy hàm(đích["kiến trúc"], hàm_ir, đích["hệ điều hành"]);
    };
    hàm công khai object(mã, tên, tái_định_vị = rỗng) {
        nếu (tái_định_vị == rỗng) { tái_định_vị = []; };
        đích = mình.đích;
        trả về biên dịch object(đích["kiến trúc"], đích["hệ điều hành"],
            đích["ABI"], mã, tên, tái_định_vị);
    };
};
