// Một target ABI dùng chung cho phát mã lá, Machine IR và ghi object.
// Encoder/writer thuần được giữ nguyên để bảo toàn byte và relocation.
nhập gói/biên dịch/đích;
nhập gói/biên dịch/mã máy;
nhập gói/biên dịch/đối tượng;

lớp công khai Bộ Sinh Mã Máy {
    hàm công khai khởi tạo(bộ ba) { mình.đích = biên dịch phân tích đích(bộ ba); };
    hàm công khai bộ ba() { trả về biên dịch bộ ba chuẩn(mình.đích); };
    hàm công khai lá(loại, hằng = 0) {
        đích = mình.đích;
        trả về biên dịch mã máy lá(đích["kiến trúc"], loại, hằng, đích["hệ điều hành"]);
    };
    hàm công khai hàm máy(danh sách hàm biểu diễn trung gian) {
        đích = mình.đích;
        trả về biên dịch mã máy hàm(đích["kiến trúc"], danh sách hàm biểu diễn trung gian, đích["hệ điều hành"]);
    };
    hàm công khai đối tượng(mã, tên, tái định vị = rỗng) {
        nếu (tái định vị == rỗng) { tái định vị = []; };
        đích = mình.đích;
        trả về biên dịch đối tượng(đích["kiến trúc"], đích["hệ điều hành"],
            đích["ABI"], mã, tên, tái định vị);
    };
};
