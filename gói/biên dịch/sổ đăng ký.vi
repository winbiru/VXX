// Sổ hàm tự chủ. Function ID và StringPool dùng chung trên toàn phiên;
// bảng slot là trạng thái riêng của từng emitter, không được nối giữa module.
// API đồ thị lập symbol/exports cho emitter + linker V++; loader tại bộ nạp.vi.
nhập gói/biên dịch/đồ thị mô đun;
nhập gói/bộ sưu tập/từ điển;

// Thuật toán không giữ trạng thái dùng hàm cấp mô-đun.
hàm công khai biên dịch sổ lưu chuỗi(sổ, tên) {
    vùng chứa = sổ["chuỗi"];
    // Index chỉ là cache; thứ tự chèn vào pool vẫn quyết định StringPool ABI.
    nếu (máy ảo có khóa từ điển(sổ, "chỉ mục chuỗi")) {
        tra cứu = sổ["chỉ mục chuỗi"];
        nếu (máy ảo có khóa từ điển(tra cứu, tên)) { trả về tra cứu[tên]; };
        mã định danh = máy ảo lấy độ dài(vùng chứa);
        máy ảo thêm cuối danh sách(vùng chứa, tên);
        tra cứu[tên] = mã định danh;
        trả về mã định danh;
    };
    lặp(i = 0; i < máy ảo lấy độ dài(vùng chứa); i++) {
        nếu (vùng chứa[i] == tên) { trả về i; };
    };
    mã định danh = máy ảo lấy độ dài(vùng chứa);
    máy ảo thêm cuối danh sách(vùng chứa, tên);
    trả về mã định danh;
};

// Một tên chỉ được ánh xạ tới một function ID trong cùng một phạm vi.
// Nhập lại cùng một hàm qua hai đường dẫn tương đương là thao tác idempotent.
hàm công khai biên dịch sổ thêm tên(bảng, tên, mã định danh, phạm vi) {
    nếu (tên == "") { ném "biên dịch sổ: tên hàm rỗng trong '" + phạm vi + "'"; };
    lặp(i = 0; i < máy ảo lấy độ dài(bảng); i++) {
        nếu (bảng[i]["tên"] == tên) {
            nếu (bảng[i]["id"] == mã định danh) { trả về sai; };
            ném "biên dịch sổ: xung đột tên '" + tên + "' trong '" + phạm vi + "'";
        };
    };
    máy ảo thêm cuối danh sách(bảng, {"tên": tên, "id": mã định danh});
    trả về đúng;
};

hàm công khai biên dịch sổ cấp hàm(sổ, mô đun, tên) {
    mã định danh = máy ảo lấy độ dài(sổ["hàm"]);
    // Function ID đã xác định khi dựng đồ thị. Với emitter đa mô-đun,
    // StringPool được cấp khi gặp predeclare thực tế của từng module.
    tên chỉ mục = -1;
    nếu (!lấy từ điển(sổ, "hoãn chuỗi", sai)) {
        tên chỉ mục = biên dịch sổ lưu chuỗi(sổ, tên);
    };
    máy ảo thêm cuối danh sách(sổ["hàm"], {"id": mã định danh, "tên": tên, "tên index": tên chỉ mục,
                      "tên chạy": tên, "tên index runtime": tên chỉ mục,
                      "mô đun": mô đun});
    nếu (máy ảo có khóa từ điển(sổ, "chỉ mục hàm")) {
        tra cứu = sổ["chỉ mục hàm"];
        nếu (!máy ảo có khóa từ điển(tra cứu, mô đun)) { tra cứu[mô đun] = {}; };
        theo mô đun = tra cứu[mô đun];
        // Khi có khai báo trùng, hàm tìm cũ luôn chọn ID đầu tiên.
        nếu (!máy ảo có khóa từ điển(theo mô đun, tên)) { theo mô đun[tên] = mã định danh; };
    };
    trả về mã định danh;
};

hàm công khai biên dịch sổ tìm mô đun(các mô đun, định danh) {
    lặp(i = 0; i < máy ảo lấy độ dài(các mô đun); i++) {
        nếu (các mô đun[i]["định danh"] == định danh) {
            trả về các mô đun[i];
        };
    };
    ném "biên dịch sổ: chưa đăng ký mô-đun phụ thuộc '" + định danh + "'";
};

hàm công khai biên dịch sổ cây mô đun(đồ thị, định danh) {
    nếu (định danh == đồ thị["điểm vào"]) {
        trả về đồ thị["cây điểm vào"];
    };
    các mô đun = đồ thị["mô đun"];
    lặp(i = 0; i < máy ảo lấy độ dài(các mô đun); i++) {
        nếu (các mô đun[i]["định danh"] == định danh) {
            trả về các mô đun[i]["cây"];
        };
    };
    ném "biên dịch sổ: thiếu AST cho '" + định danh + "'";
};

// C++ emitClassWithSuperclass cấp ID từng method khi gặp lớp (cha trước con).
// Khai trước mọi hàm global, nhưng không khai trước method của lớp đứng sau import.
hàm riêng tư biên dịch sổ cấp lớp duyệt(sổ, định danh, câu lệnh, tên lớp, đã lớp, đang lớp) {
    lặp(i = 0; i < máy ảo lấy độ dài(đã lớp); i++) {
        nếu (đã lớp[i] == tên lớp) { trả về đúng; };
    };
    lặp(i = 0; i < máy ảo lấy độ dài(đang lớp); i++) {
        nếu (đang lớp[i] == tên lớp) {
            ném "biên dịch sổ: chu trình kế thừa lớp '" + tên lớp + "'";
        };
    };
    khai = rỗng;
    lặp(i = 0; i < máy ảo lấy độ dài(câu lệnh); i++) {
        nếu (lấy từ điển(câu lệnh[i], "loại", "") == "lớp" &&
            câu lệnh[i]["tên"] == tên lớp) {
            khai = câu lệnh[i];
            thoát;
        };
    };
    nếu (khai == rỗng) {
        ném "biên dịch sổ: không tìm thấy lớp '" + tên lớp + "'";
    };
    máy ảo thêm cuối danh sách(đang lớp, tên lớp);
    kiểu lớp cha = lấy từ điển(khai, "lớp cha", "");
    nếu (kiểu lớp cha != "") {
        lặp(i = 0; i < máy ảo lấy độ dài(câu lệnh); i++) {
            nếu (lấy từ điển(câu lệnh[i], "loại", "") == "lớp" && câu lệnh[i]["tên"] == kiểu lớp cha) {
                biên dịch sổ cấp lớp duyệt(sổ, định danh, câu lệnh, kiểu lớp cha, đã lớp, đang lớp);
                thoát;
            };
        };
    };
    phương thức = lấy từ điển(khai, "phương thức", []);
    lặp(i = 0; i < máy ảo lấy độ dài(phương thức); i++) {
        biên dịch sổ cấp hàm(sổ, định danh, tên lớp + "." + phương thức[i]["tên"]);
    };
    máy ảo xóa vị trí danh sách(đang lớp, máy ảo lấy độ dài(đang lớp) - 1);
    máy ảo thêm cuối danh sách(đã lớp, tên lớp);
    trả về đúng;
};

// C++ predeclare hàm toàn cục trước. Sau đó xử lý các lớp/import theo đúng
// thứ tự câu lệnh để method trước import được cấp ID trước hàm dependency.
hàm công khai biên dịch sổ cấp hàm duyệt(sổ, đồ thị, định danh) {
    đã cấp = sổ["đã cấp"];
    lặp(i = 0; i < máy ảo lấy độ dài(đã cấp); i++) {
        nếu (đã cấp[i] == định danh) { trả về đúng; };
    };
    máy ảo thêm cuối danh sách(đã cấp, định danh);
    cây = biên dịch sổ cây mô đun(đồ thị, định danh);
    câu lệnh = lấy từ điển(cây, "câu lệnh", []);
    lặp(i = 0; i < máy ảo lấy độ dài(câu lệnh); i++) {
        nếu (lấy từ điển(câu lệnh[i], "loại", "") == "hàm") {
            biên dịch sổ cấp hàm(sổ, định danh, câu lệnh[i]["tên"]);
        };
    };
    đã lớp = [];
    đang lớp = [];
    cạnh = đồ thị["cạnh"];
    lặp(i = 0; i < máy ảo lấy độ dài(câu lệnh); i++) {
        mục = câu lệnh[i];
        loại = lấy từ điển(mục, "loại", "");
        nếu (loại == "lớp") {
            biên dịch sổ cấp lớp duyệt(sổ, định danh, câu lệnh,
                mục["tên"], đã lớp, đang lớp);
        };
        nếu (loại == "nhập") {
            đích = biên dịch đồ thị tìm đích(đồ thị, định danh, mục["đích"]);
            lặp(j = 0; j < máy ảo lấy độ dài(cạnh); j++) {
                nếu (cạnh[j]["nguồn"] == định danh &&
                    cạnh[j]["đích"] == đích &&
                    cạnh[j]["hành động"] == "load") {
                    biên dịch sổ cấp hàm duyệt(sổ, đồ thị, đích);
                    thoát;
                };
            };
        };
    };
    trả về đúng;
};

hàm công khai biên dịch sổ tìm hàm trực tiếp(sổ, mô đun, tên) {
    nếu (máy ảo có khóa từ điển(sổ, "chỉ mục hàm")) {
        tra cứu = sổ["chỉ mục hàm"];
        nếu (máy ảo có khóa từ điển(tra cứu, mô đun)) {
            theo mô đun = tra cứu[mô đun];
            nếu (máy ảo có khóa từ điển(theo mô đun, tên)) { trả về theo mô đun[tên]; };
        };
    };
    các hàm = sổ["hàm"];
    lặp(i = 0; i < máy ảo lấy độ dài(các hàm); i++) {
        nếu (các hàm[i]["mô đun"] == mô đun &&
            các hàm[i]["tên"] == tên) {
            trả về các hàm[i]["id"];
        };
    };
    ném "biên dịch sổ: thiếu function ID của '" + mô đun + "." + tên + "'";
};

hàm công khai biên dịch sổ đổi tên chạy(sổ, mã định danh, tên) {
    nếu (mã định danh < 0 || mã định danh >= máy ảo lấy độ dài(sổ["hàm"])) {
        ném "biên dịch sổ: function ID bí danh không hợp lệ";
    };
    chỉ số = biên dịch sổ lưu chuỗi(sổ, tên);
    khai = sổ["hàm"][mã định danh];
    khai["tên chạy"] = tên;
    khai["tên index runtime"] = chỉ số;
    sổ["hàm"][mã định danh] = khai;
};

hàm công khai biên dịch sổ đăng ký mô đun(sổ, đồ thị, định danh) {
    lặp(i = 0; i < máy ảo lấy độ dài(sổ["mô đun"]); i++) {
        nếu (sổ["mô đun"][i]["định danh"] == định danh) {
            ném "biên dịch sổ: đăng ký mô-đun lặp '" + định danh + "'";
        };
    };
    cây = biên dịch sổ cây mô đun(đồ thị, định danh);
    câu lệnh = lấy từ điển(cây, "câu lệnh", []);
    trực tiếp = [];
    xuất = [];
    nhìn thấy = [];

    // Mỗi module giữ tập tên riêng; hai module có thể khai cùng tên,
    // nhưng ID luôn duy nhất trong registry dùng chung.
    lặp(i = 0; i < máy ảo lấy độ dài(câu lệnh); i++) {
        nếu (lấy từ điển(câu lệnh[i], "loại", "") == "hàm") {
            tên = lấy từ điển(câu lệnh[i], "tên", "");
            lặp(j = 0; j < máy ảo lấy độ dài(trực tiếp); j++) {
                nếu (trực tiếp[j]["tên"] == tên) {
                    ném "biên dịch sổ: trùng hàm '" + tên + "' trong '" + định danh + "'";
                };
            };
            mã định danh = biên dịch sổ tìm hàm trực tiếp(sổ, định danh, tên);
            biên dịch sổ thêm tên(trực tiếp, tên, mã định danh, định danh);
            biên dịch sổ thêm tên(nhìn thấy, tên, mã định danh, định danh);
            // Parser bootstrap hiện chỉ nhận hàm mặc định (public).
            biên dịch sổ thêm tên(xuất, tên, mã định danh, định danh);
        };
    };

    cạnh = đồ thị["cạnh"];
    lặp(i = 0; i < máy ảo lấy độ dài(cạnh); i++) {
        e = cạnh[i];
        nếu (e["nguồn"] == định danh) {
            phụ thuộc = biên dịch sổ tìm mô đun(sổ["mô đun"], e["đích"]);
            tên tiền tố = lấy từ điển(e, "bí danh", "");
            các mục xuất = phụ thuộc["xuất"];
            lặp(j = 0; j < máy ảo lấy độ dài(các mục xuất); j++) {
                tên = các mục xuất[j]["tên"];
                nếu (tên tiền tố != "") { tên = tên tiền tố + "." + tên; };
                mã định danh = các mục xuất[j]["id"];
                biên dịch sổ thêm tên(nhìn thấy, tên, mã định danh, định danh);
                nếu (lấy từ điển(e, "tái xuất", sai)) {
                    biên dịch sổ thêm tên(xuất, tên, mã định danh, định danh);
                };
            };
            // Compiler C++ áp bí danh sau khi phát xong module phụ thuộc.
            // Metadata tên chạy tách khỏi tên khai báo/OP_HAM nguyên gốc.
            nếu (tên tiền tố != "" && e["hành động"] == "load" &&
                !lấy từ điển(sổ, "hoãn chuỗi", sai)) {
                trực phụ = phụ thuộc["trực tiếp"];
                lặp(j = 0; j < máy ảo lấy độ dài(trực phụ); j++) {
                    biên dịch sổ đổi tên chạy(sổ, trực phụ[j]["id"],
                        tên tiền tố + "." + trực phụ[j]["tên"]);
                };
                lặp(j = 0; j < máy ảo lấy độ dài(các mục xuất); j++) {
                    biên dịch sổ đổi tên chạy(sổ, các mục xuất[j]["id"],
                        tên tiền tố + "." + các mục xuất[j]["tên"]);
                };
            };
        };
    };
    máy ảo thêm cuối danh sách(sổ["mô đun"], {"định danh": định danh, "trực tiếp": trực tiếp,
                           "nhìn thấy": nhìn thấy, "xuất": xuất});
};

// Giữ hợp đồng hàm tự do để emitter/linker hiện có không phải thay đổi.
hàm công khai biên dịch đăng ký hàm IR thuần(biểu diễn trung gian) {
    bộ = Bộ Đăng Ký Hàm();
    trả về bộ.đăng ký IR(biểu diễn trung gian);
};

hàm công khai biên dịch đăng ký hàm đồ thị nền(đồ thị, hoãn chuỗi) {
    bộ = Bộ Đăng Ký Hàm(hoãn chuỗi);
    trả về bộ.đăng ký đồ thị(đồ thị);
};

// Khi liên kết đồ thị, hoãn StringPool để cấp theo thứ tự import của C++.
hàm công khai biên dịch đăng ký hàm đồ thị hoãn chuỗi(đồ thị) {
    trả về biên dịch đăng ký hàm đồ thị nền(đồ thị, đúng);
};

// Bài kiểm thử registry riêng tiếp tục có chỉ số StringPool sẵn.
hàm công khai biên dịch đăng ký hàm đồ thị thuần(đồ thị) {
    trả về biên dịch đăng ký hàm đồ thị nền(đồ thị, sai);
};

// Mỗi phiên sở hữu Function ID, StringPool, slots và bảng ký hiệu riêng.
// Các helper cấp phát giữ thứ tự predeclare của emitter C++ và dữ liệu ABI cũ.
lớp công khai Bộ Đăng Ký Hàm {
    hàm công khai khởi tạo(hoãn chuỗi = sai) {
        mình.hoãn chuỗi = hoãn chuỗi;
        mình.sổ = {};
        mình.các ô nhớ = [];
        mình.tên đã khai = [];
    };

    hàm riêng tư chuẩn bị IR() {
        mình.sổ = {"hàm": [], "chuỗi": [],
                    "chỉ mục hàm": {}, "chỉ mục chuỗi": {}};
        mình.các ô nhớ = [];
        mình.tên đã khai = [];
    };

    hàm riêng tư khai hàm IR(tên) {
        nếu (tên == "") { ném "biên dịch sổ: tên hàm rỗng"; };
        lặp(j = 0; j < máy ảo lấy độ dài(mình.tên đã khai); j++) {
            nếu (mình.tên đã khai[j] == tên) {
                ném "biên dịch sổ: trùng khai báo hàm '" + tên + "'";
            };
        };
        mã định danh = biên dịch sổ cấp hàm(mình.sổ, "", tên);
        nếu (mã định danh != máy ảo lấy độ dài(mình.các ô nhớ)) { ném "biên dịch sổ: function ID không liên tiếp"; };
        máy ảo thêm cuối danh sách(mình.các ô nhớ, tên);
        máy ảo thêm cuối danh sách(mình.tên đã khai, tên);
    };

    // ID liên tiếp 0..N-1 theo Emitter::predeclareFunctions.
    hàm công khai đăng ký IR(biểu diễn trung gian) {
        nếu (lấy từ điển(biểu diễn trung gian, "loại", "") != "chương trình IR") {
            ném "biên dịch sổ: cần chương trình IR";
        };
        mình.chuẩn bị IR();
        danh sách hàm biểu diễn trung gian = lấy từ điển(biểu diễn trung gian, "hàm", []);
        lặp(i = 0; i < máy ảo lấy độ dài(danh sách hàm biểu diễn trung gian); i++) {
            // Method được cấp ID khi lớp thực sự được phát, giống C++.
            nếu (!lấy từ điển(danh sách hàm biểu diễn trung gian[i], "phương thức", sai)) {
                mình.khai hàm IR(lấy từ điển(danh sách hàm biểu diễn trung gian[i], "tên", ""));
            };
        };
        mình.sổ["slots"] = mình.các ô nhớ;
        mình.sổ["hàm đã khai"] = mình.tên đã khai;
        trả về mình.sổ;
    };

    // Graph đã giải chu trình, sử dụng postorder và khai trước global.
    hàm công khai đăng ký đồ thị(đồ thị) {
        nếu (lấy từ điển(đồ thị, "loại", "") != "đồ thị mô đun V++") {
            ném "biên dịch sổ: cần đồ thị mô đun V++";
        };
        mình.sổ = {"loại": "sổ hàm V++", "hàm": [], "chuỗi": [],
                    "chỉ mục hàm": {}, "chỉ mục chuỗi": {},
                    "mô đun": [], "đã cấp": [], "hoãn chuỗi": mình.hoãn chuỗi};
        mình.các ô nhớ = [];
        mình.tên đã khai = [];
        thứ tự = đồ thị["thứ tự khởi tạo"];
        nếu (máy ảo lấy độ dài(thứ tự) != máy ảo lấy độ dài(đồ thị["mô đun"])) {
            ném "biên dịch sổ: số mô-đun khác thứ tự khởi tạo";
        };
        biên dịch sổ cấp hàm duyệt(mình.sổ, đồ thị, đồ thị["điểm vào"]);
        lặp(i = 0; i < máy ảo lấy độ dài(thứ tự); i++) {
            biên dịch sổ đăng ký mô đun(mình.sổ, đồ thị, thứ tự[i]);
        };
        biên dịch sổ đăng ký mô đun(mình.sổ, đồ thị, đồ thị["điểm vào"]);
        trả về mình.sổ;
    };

    hàm công khai kết quả() { trả về mình.sổ; };

    hàm công khai tìm hàm(mô đun, tên) {
        trả về biên dịch sổ tìm hàm trực tiếp(mình.sổ, mô đun, tên);
    };

    hàm công khai tìm mô đun(định danh) {
        trả về biên dịch sổ tìm mô đun(mình.sổ["mô đun"], định danh);
    };
};

