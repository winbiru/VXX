// Kiểm tra ngữ nghĩa trên AST thuần V++ của parser chương trình.
// Chưa suy luận kiểu hoặc phân giải tên ngoài phạm vi khai báo cục bộ.
nhập gói.biên dịch.chương trình.biên dịch phân tích chương trình thuần;
nhập gói.biên dịch.biểu thức.biên dịch biểu thức là phép gán;
nhập gói.bộ sưu tập.từ điển.lấy từ điển;
nhập gói.lõi.bảng mã.mã điểm unicode;
nhập gói.lõi.chuyển kiểu.thành chuỗi;

// Lớp sở hữu toàn bộ thuật toán của mô-đun; các hàm bên dưới chỉ giữ API cũ.
lớp công khai Bộ Kiểm Tra Ngữ Nghĩa {
    hàm công khai khởi tạo() {};

    hàm riêng tư biên dịch ngữ nghĩa chứa(tập, tên) {
        lặp(i = 0; i < máy ảo lấy độ dài(tập); i++) {
            nếu (tập[i] == tên) { trả về đúng; };
        };
        trả về sai;
    };

    // Vị trí khai báo được parser giữ theo byte UTF-8 (cùng SourceSpan C++).
    // Đính vị trí của lần khai báo thứ hai vào lỗi, không suy đoán từ tên
    // (tên có thể xuất hiện trong comment hoặc string literal).
    hàm riêng tư biên dịch ngữ nghĩa lỗi khai báo(mục, thông báo) {
        ném thông báo + " tại dòng " +
            thành chuỗi(lấy từ điển(mục, "dòng", 1)) + ", cột " +
            thành chuỗi(lấy từ điển(mục, "cột", 1));
    };

    // Bảng kiểu của một đơn vị biên dịch. Việc phân giải kiểu từ module nhập
    // sẽ được thực hiện ở bước linker khi compiler tự chủ hỗ trợ OOP đa module.
    hàm riêng tư biên dịch ngữ nghĩa tìm kiểu(các lệnh, tên) {
        lặp(i = 0; i < máy ảo lấy độ dài(các lệnh); i++) {
            mục = các lệnh[i];
            loại = lấy từ điển(mục, "loại", "");
            nếu ((loại == "lớp" || loại == "giao diện") && mục["tên"] == tên) {
                trả về mục;
            };
        };
        trả về rỗng;
    };

    // Duyệt đường kế thừa chỉ qua các kiểu khai báo trong cùng AST. Dùng đường
    // đi riêng cho mỗi nhánh để phát hiện vòng A->B->A mà vẫn cho phép hình thoi
    // hợp lệ ở cây kế thừa giao diện.
    hàm riêng tư biên dịch ngữ nghĩa kiểm tra chu trình kiểu(các lệnh, tên, đường đi) {
        nếu (mình.biên dịch ngữ nghĩa chứa(đường đi, tên)) {
            ném "biên dịch ngữ nghĩa: chu trình kế thừa tại '" + tên + "'";
        };
        mục = mình.biên dịch ngữ nghĩa tìm kiểu(các lệnh, tên);
        nếu (mục == rỗng) { trả về đúng; };
        đường mới = [];
        lặp(i = 0; i < máy ảo lấy độ dài(đường đi); i++) {
            máy ảo thêm cuối danh sách(đường mới, đường đi[i]);
        };
        máy ảo thêm cuối danh sách(đường mới, tên);
        nếu (mục["loại"] == "lớp") {
            cha = lấy từ điển(mục, "lớp cha", "");
            nếu (cha != "") {
                mình.biên dịch ngữ nghĩa kiểm tra chu trình kiểu(các lệnh, cha, đường mới);
            };
        } hoặc {
            cha = lấy từ điển(mục, "giao diện cha", []);
            lặp(i = 0; i < máy ảo lấy độ dài(cha); i++) {
                mình.biên dịch ngữ nghĩa kiểm tra chu trình kiểu(các lệnh, cha[i], đường mới);
            };
        };
        trả về đúng;
    };

    hàm riêng tư biên dịch ngữ nghĩa kiểm tra quan hệ kiểu(các lệnh) {
        lặp(i = 0; i < máy ảo lấy độ dài(các lệnh); i++) {
            mục = các lệnh[i];
            loại = lấy từ điển(mục, "loại", "");
            nếu (loại == "lớp") {
                cha = lấy từ điển(mục, "lớp cha", "");
                nếu (cha != "") {
                    khai báo cha = mình.biên dịch ngữ nghĩa tìm kiểu(các lệnh, cha);
                    nếu (khai báo cha == rỗng) {
                        ném "biên dịch ngữ nghĩa: lớp cha chưa khai báo '" + cha + "'";
                    };
                    nếu (khai báo cha["loại"] != "lớp") {
                        ném "biên dịch ngữ nghĩa: lớp cha chưa khai báo '" + cha + "'";
                    };
                };
            };
            nếu (loại == "lớp" || loại == "giao diện") {
                danh sách giao diện = [];
                nếu (loại == "lớp") {
                    danh sách giao diện = lấy từ điển(mục, "triển khai", []);
                } hoặc {
                    danh sách giao diện = lấy từ điển(mục, "giao diện cha", []);
                };
                lặp(j = 0; j < máy ảo lấy độ dài(danh sách giao diện); j++) {
                    tên giao diện = danh sách giao diện[j];
                    khai báo giao diện = mình.biên dịch ngữ nghĩa tìm kiểu(các lệnh, tên giao diện);
                    nếu (khai báo giao diện == rỗng) {
                        ném "biên dịch ngữ nghĩa: giao diện chưa khai báo '" + tên giao diện + "'";
                    };
                    nếu (khai báo giao diện["loại"] != "giao diện") {
                        ném "biên dịch ngữ nghĩa: giao diện chưa khai báo '" + tên giao diện + "'";
                    };
                };
            };
        };
        lặp(i = 0; i < máy ảo lấy độ dài(các lệnh); i++) {
            mục = các lệnh[i];
            loại = lấy từ điển(mục, "loại", "");
            nếu (loại == "lớp" || loại == "giao diện") {
                mình.biên dịch ngữ nghĩa kiểm tra chu trình kiểu(các lệnh, mục["tên"], []);
            };
        };
        trả về đúng;
    };

    // Kiểm tra hợp đồng và ghi đè trước khi hạ OOP xuống IR.
    hàm riêng tư biên dịch ngữ nghĩa tìm phương thức(các lệnh, tên kiểu, tên) {
        kiểu = mình.biên dịch ngữ nghĩa tìm kiểu(các lệnh, tên kiểu);
        nếu (kiểu == rỗng) { trả về rỗng; };
        các hàm = lấy từ điển(kiểu, "phương thức", []);
        lặp(i = 0; i < máy ảo lấy độ dài(các hàm); i++) {
            nếu (các hàm[i]["tên"] == tên) { trả về các hàm[i]; };
        };
        cha = lấy từ điển(kiểu, "lớp cha", "");
        nếu (cha == "") { trả về rỗng; };
        trả về mình.biên dịch ngữ nghĩa tìm phương thức(các lệnh, cha, tên);
    };

    hàm riêng tư biên dịch ngữ nghĩa kiểm tra hợp đồng(các lệnh, tên lớp, danh sách giao diện) {
        kiểu = mình.biên dịch ngữ nghĩa tìm kiểu(các lệnh, danh sách giao diện);
        nếu (kiểu == rỗng) { trả về đúng; };
        cha = lấy từ điển(kiểu, "giao diện cha", []);
        lặp(i = 0; i < máy ảo lấy độ dài(cha); i++) {
            mình.biên dịch ngữ nghĩa kiểm tra hợp đồng(các lệnh, tên lớp, cha[i]);
        };
        cần = lấy từ điển(kiểu, "phương thức", []);
        lặp(i = 0; i < máy ảo lấy độ dài(cần); i++) {
            thực hiện = mình.biên dịch ngữ nghĩa tìm phương thức(các lệnh, tên lớp, cần[i]["tên"]);
            nếu (thực hiện == rỗng) {
                ném "biên dịch ngữ nghĩa: lớp '" + tên lớp + "' thiếu phương thức '" + cần[i]["tên"] + "'";
            };
            nếu (máy ảo lấy độ dài(thực hiện["tham số"]) != máy ảo lấy độ dài(cần[i]["tham số"])) {
                ném "biên dịch ngữ nghĩa: số tham số triển khai không khớp '" + cần[i]["tên"] + "'";
            };
            phạm vi = lấy từ điển(thực hiện, "phạm vi", "");
            nếu (phạm vi == "riêng tư" || phạm vi == "bảo vệ") {
                ném "biên dịch ngữ nghĩa: phương thức triển khai phải công khai '" + cần[i]["tên"] + "'";
            };
        };
        trả về đúng;
    };

    hàm riêng tư biên dịch ngữ nghĩa hạng truy cập(phạm vi) {
        nếu (phạm vi == "riêng tư") { trả về 0; };
        nếu (phạm vi == "bảo vệ") { trả về 1; };
        trả về 2;
    };

    hàm riêng tư biên dịch ngữ nghĩa kiểm tra OOP(các lệnh) {
        lặp(i = 0; i < máy ảo lấy độ dài(các lệnh); i++) {
            mục lớp = các lệnh[i];
            nếu (lấy từ điển(mục lớp, "loại", "") != "lớp") { bỏ qua; };
            các giao diện = lấy từ điển(mục lớp, "triển khai", []);
            lặp(j = 0; j < máy ảo lấy độ dài(các giao diện); j++) {
                mình.biên dịch ngữ nghĩa kiểm tra hợp đồng(các lệnh, mục lớp["tên"], các giao diện[j]);
            };
            cha = lấy từ điển(mục lớp, "lớp cha", "");
            nếu (cha == "") { bỏ qua; };
            phương thức = lấy từ điển(mục lớp, "phương thức", []);
            lặp(j = 0; j < máy ảo lấy độ dài(phương thức); j++) {
                con = phương thức[j];
                nếu (con["tên"] == "khởi tạo") { bỏ qua; };
                gốc dữ liệu = mình.biên dịch ngữ nghĩa tìm phương thức(các lệnh, cha, con["tên"]);
                nếu (gốc dữ liệu == rỗng) { bỏ qua; };
                nếu (lấy từ điển(gốc dữ liệu, "phạm vi", "") == "riêng tư") { bỏ qua; };
                nếu (máy ảo lấy độ dài(con["tham số"]) != máy ảo lấy độ dài(gốc dữ liệu["tham số"]) ||
                    mình.biên dịch ngữ nghĩa hạng truy cập(lấy từ điển(con, "phạm vi", "")) <
                    mình.biên dịch ngữ nghĩa hạng truy cập(lấy từ điển(gốc dữ liệu, "phạm vi", ""))) {
                    ném "biên dịch ngữ nghĩa: ghi đè không tương thích '" + con["tên"] + "'";
                };
            };
        };
        trả về đúng;
    };

    // Phép kiểm tra hợp đồng FFI phía frontend V++ tương ứng với
    // parseForeignAbiType và bufferExtents trong semantic.cpp. Backend FFI
    // bytecode vẫn chưa được hạ ở đường self-host.
    hàm riêng tư biên dịch ngữ nghĩa kiểu ABI(kiểu) {
        hợp lệ = ["rỗng", "void", "i32", "u32", "i64", "u64", "f64",
            "c_chuỗi", "c_đệm_ra", "c_đệm_vào", "c_tệp", "c_thư_mục",
            "c_mục_thư_mục", "c_cờ_con_trỏ", "c_dns", "c_socket"];
        trả về mình.biên dịch ngữ nghĩa chứa(hợp lệ, kiểu);
    };

    hàm riêng tư biên dịch ngữ nghĩa kiểm tra FFI(mục) {
        nếu (lấy từ điển(mục, "abi", "c") != "c") {
            ném "biên dịch ngữ nghĩa: FFI hiện chỉ hỗ trợ abi 'c'";
        };
        kiểu trả về = lấy từ điển(mục, "kiểu trả về", "");
        nếu (!mình.biên dịch ngữ nghĩa kiểu ABI(kiểu trả về) ||
            kiểu trả về == "c_đệm_ra" || kiểu trả về == "c_đệm_vào") {
            ném "biên dịch ngữ nghĩa: kiểu ABI trả về chưa hỗ trợ '" + kiểu trả về + "'";
        };
        tham số = lấy từ điển(mục, "tham số", []);
        tên đã có = [];
        lặp(i = 0; i < máy ảo lấy độ dài(tham số); i++) {
            p = tham số[i];
            tên = p["tên"];
            kiểu = p["kiểu"];
            chiều dài = lấy từ điển(p, "độ dài", "");
            nếu (mình.biên dịch ngữ nghĩa chứa(tên đã có, tên)) {
                ném "biên dịch ngữ nghĩa: trùng tham số FFI '" + tên + "'";
            };
            máy ảo thêm cuối danh sách(tên đã có, tên);
            nếu (!mình.biên dịch ngữ nghĩa kiểu ABI(kiểu) || kiểu == "rỗng" || kiểu == "void") {
                ném "biên dịch ngữ nghĩa: kiểu ABI tham số chưa hỗ trợ '" + kiểu + "'";
            };
            là đệm = kiểu == "c_đệm_ra" || kiểu == "c_đệm_vào";
            nếu (!là đệm && chiều dài != "") {
                ném "biên dịch ngữ nghĩa: chỉ tham số đệm FFI được khai báo độ dài";
            };
            nếu (là đệm) {
                nếu (chiều dài == "") {
                    ném "biên dịch ngữ nghĩa: đệm FFI phải khai báo độ dài";
                };
                mã đầu = mã điểm unicode(chiều dài[0]);
                nếu (mã đầu >= 48 && mã đầu <= 57) {
                    độ dài = 0;
                    lặp(j = 0; j < máy ảo lấy độ dài(chiều dài); j++) {
                        mã = mã điểm unicode(chiều dài[j]);
                        nếu (mã < 48 || mã > 57) {
                            ném "biên dịch ngữ nghĩa: độ dài đệm FFI cố định không hợp lệ";
                        };
                        độ dài = độ dài * 10 + mã - 48;
                        nếu (độ dài > 65536) {
                            ném "biên dịch ngữ nghĩa: độ dài đệm FFI tối đa 65536";
                        };
                    };
                    nếu (độ dài == 0) {
                        ném "biên dịch ngữ nghĩa: độ dài đệm FFI phải dương";
                    };
                } hoặc {
                    tham chiếu = -1;
                    lặp(j = 0; j < máy ảo lấy độ dài(tham số); j++) {
                        nếu (tham số[j]["tên"] == chiều dài) {
                            nếu (tham chiếu >= 0) {
                                ném "biên dịch ngữ nghĩa: tham chiếu độ dài đệm FFI trùng";
                            };
                            tham chiếu = j;
                        };
                    };
                    nếu (tham chiếu < 0 || tham chiếu == i) {
                        ném "biên dịch ngữ nghĩa: tham chiếu độ dài đệm FFI không hợp lệ";
                    };
                    kiểu dài = tham số[tham chiếu]["kiểu"];
                    nếu (kiểu dài != "i32" && kiểu dài != "u32" &&
                        kiểu dài != "i64" && kiểu dài != "u64") {
                        ném "biên dịch ngữ nghĩa: độ dài đệm FFI phải tham chiếu kiểu số nguyên";
                    };
                };
            };
        };
        trả về đúng;
    };

    hàm riêng tư biên dịch ngữ nghĩa biểu thức(cây) {
        nếu (cây == rỗng) { trả về đúng; };
        loại = lấy từ điển(cây, "loại", "");
        nếu (loại == "hằng" || loại == "tên") { trả về đúng; };
        nếu (loại == "hàm ẩn danh") {
            // Thân closure có phạm vi hàm riêng, kể cả khi nằm trong vòng lặp.
            khai = {"loại": "hàm", "tham số": cây["tham số"],
                "mặc định tham số": cây["mặc định tham số"], "thân": cây["thân"]};
            mình.biên dịch ngữ nghĩa câu lệnh(khai, sai, sai, sai);
            mình.biên dịch ngữ nghĩa kiểm tra khai báo biến(khai, [], []);
            trả về đúng;
        };
        nếu (loại == "danh sách") {
            phần tử = lấy từ điển(cây, "phần tử", []);
            lặp(i = 0; i < máy ảo lấy độ dài(phần tử); i++) {
                mình.biên dịch ngữ nghĩa biểu thức(phần tử[i]);
            };
            trả về đúng;
        };
        nếu (loại == "từ điển") {
            mục = lấy từ điển(cây, "mục", []);
            lặp(i = 0; i < máy ảo lấy độ dài(mục); i++) {
                khóa = mục[i]["khóa"];
                nếu (lấy từ điển(khóa, "loại", "") != "tên" &&
                    !(lấy từ điển(khóa, "loại", "") == "hằng" &&
                      lấy từ điển(khóa, "kiểu", "") == "chuỗi")) {
                    ném "biên dịch ngữ nghĩa: khóa từ điển phải là chuỗi hoặc tên";
                };
                mình.biên dịch ngữ nghĩa biểu thức(mục[i]["giá trị"]);
            };
            trả về đúng;
        };
        nếu (loại == "một ngôi") {
            mình.biên dịch ngữ nghĩa biểu thức(lấy từ điển(cây, "toán hạng", rỗng));
            trả về đúng;
        };
        nếu (loại == "hai ngôi") {
            trái = lấy từ điển(cây, "trái", rỗng);
            toán tử = lấy từ điển(cây, "toán tử", "");
            nếu (biên dịch biểu thức là phép gán(toán tử) &&
                lấy từ điển(trái, "loại", "") != "tên" &&
                lấy từ điển(trái, "loại", "") != "chỉ số" &&
                lấy từ điển(trái, "loại", "") != "thành viên") {
                ném "biên dịch ngữ nghĩa: vế trái phép gán phải là tên, chỉ số hoặc thành viên";
            };
            mình.biên dịch ngữ nghĩa biểu thức(trái);
            mình.biên dịch ngữ nghĩa biểu thức(lấy từ điển(cây, "phải", rỗng));
            trả về đúng;
        };
        nếu (loại == "gọi") {
            mình.biên dịch ngữ nghĩa biểu thức(lấy từ điển(cây, "hàm", rỗng));
            đối số = lấy từ điển(cây, "đối số", []);
            lặp(i = 0; i < máy ảo lấy độ dài(đối số); i++) {
                mình.biên dịch ngữ nghĩa biểu thức(đối số[i]);
            };
            trả về đúng;
        };
        nếu (loại == "chỉ số") {
            mình.biên dịch ngữ nghĩa biểu thức(lấy từ điển(cây, "đối tượng", rỗng));
            mình.biên dịch ngữ nghĩa biểu thức(lấy từ điển(cây, "chỉ số", rỗng));
            trả về đúng;
        };
        nếu (loại == "thành viên") {
            mình.biên dịch ngữ nghĩa biểu thức(lấy từ điển(cây, "đối tượng", rỗng));
            trả về đúng;
        };
        nếu (loại == "cập nhật") {
            đích = lấy từ điển(cây, "đối tượng", rỗng);
            nếu (lấy từ điển(đích, "loại", "") != "tên" &&
                lấy từ điển(đích, "loại", "") != "chỉ số" &&
                lấy từ điển(đích, "loại", "") != "thành viên") {
                ném "biên dịch ngữ nghĩa: ++/-- cần tên, chỉ số hoặc thành viên";
            };
            mình.biên dịch ngữ nghĩa biểu thức(đích);
            trả về đúng;
        };
        ném "biên dịch ngữ nghĩa: biểu thức chưa hỗ trợ '" + loại + "'";
    };

    hàm riêng tư biên dịch ngữ nghĩa câu lệnh(nút, trong hàm, trong lặp, trong chọn) {
        loại = lấy từ điển(nút, "loại", "");
        nếu (loại == "trống" || loại == "nhập") { trả về đúng; };
        nếu (loại == "ngoại hàm" || loại == "ngoại thư viện") {
            nếu (trong hàm) { ném "biên dịch ngữ nghĩa: khai báo FFI trong hàm"; };
            trả về đúng;
        };
        nếu (loại == "lớp" || loại == "giao diện") {
            nếu (trong hàm) { ném "biên dịch ngữ nghĩa: khai báo lớp/giao diện trong hàm"; };
            nếu (loại == "lớp" && lấy từ điển(nút, "lớp cha", "") == nút["tên"]) {
                ném "biên dịch ngữ nghĩa: lớp không được kế thừa chính nó";
            };
            tham chiếu = [];
            nếu (loại == "giao diện") {
                tham chiếu = lấy từ điển(nút, "giao diện cha", []);
            } hoặc {
                tham chiếu = lấy từ điển(nút, "triển khai", []);
            };
            đã tham chiếu = [];
            lặp(i = 0; i < máy ảo lấy độ dài(tham chiếu); i++) {
                nếu (loại == "giao diện" && tham chiếu[i] == nút["tên"]) {
                    ném "biên dịch ngữ nghĩa: giao diện không được kế thừa chính nó";
                };
                nếu (mình.biên dịch ngữ nghĩa chứa(đã tham chiếu, tham chiếu[i])) {
                    ném "biên dịch ngữ nghĩa: trùng giao diện '" + tham chiếu[i] + "'";
                };
                máy ảo thêm cuối danh sách(đã tham chiếu, tham chiếu[i]);
            };
            phương thức = lấy từ điển(nút, "phương thức", []);
            đã khai báo = [];
            lặp(i = 0; i < máy ảo lấy độ dài(phương thức); i++) {
                tên = phương thức[i]["tên"];
                nếu (mình.biên dịch ngữ nghĩa chứa(đã khai báo, tên)) {
                    ném "biên dịch ngữ nghĩa: trùng phương thức '" + tên + "'";
                };
                máy ảo thêm cuối danh sách(đã khai báo, tên);
                nếu (loại == "lớp") {
                    mình.biên dịch ngữ nghĩa câu lệnh(phương thức[i], sai, sai, sai);
                } hoặc {
                    phạm vi = lấy từ điển(phương thức[i], "phạm vi", "");
                    nếu (phạm vi == "bảo vệ" || phạm vi == "riêng tư") {
                        ném "biên dịch ngữ nghĩa: phương thức giao diện phải công khai";
                    };
                    tham số = lấy từ điển(phương thức[i], "tham số", []);
                    tên tham số = [];
                    lặp(j = 0; j < máy ảo lấy độ dài(tham số); j++) {
                        nếu (mình.biên dịch ngữ nghĩa chứa(tên tham số, tham số[j])) {
                            ném "biên dịch ngữ nghĩa: trùng tham số '" + tham số[j] + "'";
                        };
                        máy ảo thêm cuối danh sách(tên tham số, tham số[j]);
                    };
                };
            };
            trả về đúng;
        };
        nếu (loại == "hàm") {
            nếu (trong hàm) { ném "biên dịch ngữ nghĩa: không hỗ trợ khai báo hàm lồng nhau"; };
            tham số = lấy từ điển(nút, "tham số", []);
            mặc định = lấy từ điển(nút, "mặc định tham số", []);
            đã khai báo = [];
            lặp(i = 0; i < máy ảo lấy độ dài(tham số); i++) {
                nếu (mình.biên dịch ngữ nghĩa chứa(đã khai báo, tham số[i])) {
                    ném "biên dịch ngữ nghĩa: trùng tham số '" + tham số[i] + "'";
                };
                máy ảo thêm cuối danh sách(đã khai báo, tham số[i]);
                nếu (i < máy ảo lấy độ dài(mặc định)) {
                    nếu (mặc định[i] != rỗng) { mình.biên dịch ngữ nghĩa biểu thức(mặc định[i]); };
                };
            };
            mình.biên dịch ngữ nghĩa câu lệnh(lấy từ điển(nút, "thân", {}), đúng, sai, sai);
            trả về đúng;
        };
        nếu (loại == "khối") {
            câu lệnh = lấy từ điển(nút, "câu lệnh", []);
            lặp(i = 0; i < máy ảo lấy độ dài(câu lệnh); i++) {
                mình.biên dịch ngữ nghĩa câu lệnh(câu lệnh[i], trong hàm, trong lặp, trong chọn);
            };
            trả về đúng;
        };
        nếu (loại == "trả về") {
            nếu (!trong hàm) { ném "biên dịch ngữ nghĩa: trả về ngoài hàm"; };
            mình.biên dịch ngữ nghĩa biểu thức(lấy từ điển(nút, "biểu thức", rỗng));
            trả về đúng;
        };
        nếu (loại == "in" || loại == "biểu thức") {
            mình.biên dịch ngữ nghĩa biểu thức(lấy từ điển(nút, "biểu thức", rỗng));
            trả về đúng;
        };
        nếu (loại == "biến") {
            mình.biên dịch ngữ nghĩa biểu thức(lấy từ điển(nút, "giá trị", rỗng));
            trả về đúng;
        };
        nếu (loại == "nếu") {
            mình.biên dịch ngữ nghĩa biểu thức(lấy từ điển(nút, "điều kiện", rỗng));
            mình.biên dịch ngữ nghĩa câu lệnh(lấy từ điển(nút, "thân", {}), trong hàm, trong lặp, trong chọn);
            nhánh khác = lấy từ điển(nút, "nhánh khác", rỗng);
            nếu (nhánh khác != rỗng) {
                mình.biên dịch ngữ nghĩa câu lệnh(nhánh khác, trong hàm, trong lặp, trong chọn);
            };
            trả về đúng;
        };
        nếu (loại == "lặp") {
            mình.biên dịch ngữ nghĩa biểu thức(lấy từ điển(nút, "khởi tạo", rỗng));
            mình.biên dịch ngữ nghĩa biểu thức(lấy từ điển(nút, "điều kiện", rỗng));
            mình.biên dịch ngữ nghĩa biểu thức(lấy từ điển(nút, "cập nhật", rỗng));
            mình.biên dịch ngữ nghĩa câu lệnh(lấy từ điển(nút, "thân", {}), trong hàm, đúng, trong chọn);
            trả về đúng;
        };
        nếu (loại == "chọn") {
            mình.biên dịch ngữ nghĩa biểu thức(lấy từ điển(nút, "biểu thức", rỗng));
            các nhánh = lấy từ điển(nút, "nhánh", []);
            đã mặc định = sai;
            lặp(i = 0; i < máy ảo lấy độ dài(các nhánh); i++) {
                nhánh = các nhánh[i];
                nếu (nhánh["loại"] == "mặc định") {
                    nếu (đã mặc định) { ném "biên dịch ngữ nghĩa: trùng mặc định trong chọn"; };
                    đã mặc định = đúng;
                } hoặc {
                    nhãn = lấy từ điển(nhánh, "nhãn", rỗng);
                    kiểu = lấy từ điển(nhãn, "loại", "");
                    nếu (kiểu == "hằng") {
                        loại hằng = lấy từ điển(nhãn, "kiểu", "");
                        nếu (loại hằng != "số nguyên" && loại hằng != "chuỗi") {
                            ném "biên dịch ngữ nghĩa: nhãn ca chỉ nhận số nguyên, chuỗi hoặc tên";
                        };
                    } hoặc {
                        nếu (kiểu != "tên") {
                            ném "biên dịch ngữ nghĩa: nhãn ca không hợp lệ";
                        };
                    };
                    mình.biên dịch ngữ nghĩa biểu thức(nhãn);
                };
                mình.biên dịch ngữ nghĩa câu lệnh(nhánh["thân"], trong hàm, trong lặp, đúng);
            };
            trả về đúng;
        };
        nếu (loại == "thử") {
            mình.biên dịch ngữ nghĩa câu lệnh(nút["thân"], trong hàm, trong lặp, trong chọn);
            mình.biên dịch ngữ nghĩa câu lệnh(nút["bắt"], trong hàm, trong lặp, trong chọn);
            trả về đúng;
        };
        nếu (loại == "ném") {
            mình.biên dịch ngữ nghĩa biểu thức(lấy từ điển(nút, "biểu thức", rỗng));
            trả về đúng;
        };
        nếu (loại == "thoát" || loại == "bỏ qua") {
            nếu (!trong lặp && !(loại == "thoát" && trong chọn)) {
                ném "biên dịch ngữ nghĩa: '" + loại + "' ở ngoài vòng lặp";
            };
            trả về đúng;
        };
        ném "biên dịch ngữ nghĩa: câu lệnh chưa hỗ trợ '" + loại + "'";
    };

    // C++ SemanticBuilder::buildStatement/addSymbol dùng một bảng khai báo biến
    // cho toàn bộ thân hàm (kể cả các khối nếu/lặp), và một bảng riêng ở global.
    // Tham số cùng chia sẻ bảng tên của hàm; mỗi hàm có bảng riêng.
    hàm riêng tư biên dịch ngữ nghĩa kiểm tra khai báo biến(nút, tên đã khai báo, các hàm) {
        loại = lấy từ điển(nút, "loại", "");
        nếu (loại == "hàm") {
            tên trong hàm = [];
            tham số = lấy từ điển(nút, "tham số", []);
            lặp(i = 0; i < máy ảo lấy độ dài(tham số); i++) {
                máy ảo thêm cuối danh sách(tên trong hàm, tham số[i]);
            };
            mình.biên dịch ngữ nghĩa kiểm tra khai báo biến(
                lấy từ điển(nút, "thân", {}), tên trong hàm, các hàm);
            // C++ đăng ký các khai báo biến trước khi duyệt phép gán. Vì vậy
            // biến cục bộ có thể che tên hàm dù được khai báo ở cuối thân hàm.
            mình.biên dịch ngữ nghĩa kiểm tra gán hàm câu lệnh(
                lấy từ điển(nút, "thân", {}), các hàm, tên trong hàm);
            trả về đúng;
        };
        nếu (loại == "biến") {
            tên = lấy từ điển(nút, "tên", "");
            nếu (mình.biên dịch ngữ nghĩa chứa(tên đã khai báo, tên)) {
                ném "biên dịch ngữ nghĩa: trùng khai báo '" + tên + "'";
            };
            máy ảo thêm cuối danh sách(tên đã khai báo, tên);
            trả về đúng;
        };
        nếu (loại == "khối") {
            các lệnh = lấy từ điển(nút, "câu lệnh", []);
            lặp(i = 0; i < máy ảo lấy độ dài(các lệnh); i++) {
                mình.biên dịch ngữ nghĩa kiểm tra khai báo biến(các lệnh[i], tên đã khai báo, các hàm);
            };
            trả về đúng;
        };
        nếu (loại == "nếu") {
            mình.biên dịch ngữ nghĩa kiểm tra khai báo biến(
                lấy từ điển(nút, "thân", {}), tên đã khai báo, các hàm);
            nhánh khác = lấy từ điển(nút, "nhánh khác", rỗng);
            nếu (nhánh khác != rỗng) {
                mình.biên dịch ngữ nghĩa kiểm tra khai báo biến(nhánh khác, tên đã khai báo, các hàm);
            };
            trả về đúng;
        };
        nếu (loại == "lặp") {
            mình.biên dịch ngữ nghĩa kiểm tra khai báo biến(
                lấy từ điển(nút, "thân", {}), tên đã khai báo, các hàm);
        };
        nếu (loại == "chọn") {
            nhánh = lấy từ điển(nút, "nhánh", []);
            lặp(i = 0; i < máy ảo lấy độ dài(nhánh); i++) {
                mình.biên dịch ngữ nghĩa kiểm tra khai báo biến(nhánh[i]["thân"], tên đã khai báo, các hàm);
            };
        };
        nếu (loại == "thử") {
            mình.biên dịch ngữ nghĩa kiểm tra khai báo biến(nút["thân"], tên đã khai báo, các hàm);
            mình.biên dịch ngữ nghĩa kiểm tra khai báo biến(nút["bắt"], tên đã khai báo, các hàm);
        };
        trả về đúng;
    };

    // Semantic C++ cấm ghi vào tên hàm (Assignment/CompoundAssignment/Postfix)
    // vì tên hàm được resolve thành function ID, không phải slot biến VM.
    // Hai bảng tên riêng thể hiện lexical lookup: parameter/local che hàm global.
    hàm riêng tư biên dịch ngữ nghĩa kiểm tra đích gán hàm(đích, các hàm, tên cục bộ) {
        nếu (lấy từ điển(đích, "loại", "") != "tên") { trả về đúng; };
        tên = lấy từ điển(đích, "giá trị", "");
        nếu (mình.biên dịch ngữ nghĩa chứa(các hàm, tên) &&
            !mình.biên dịch ngữ nghĩa chứa(tên cục bộ, tên)) {
            ném "biên dịch ngữ nghĩa: không thể gán vào tên hàm '" + tên + "'";
        };
        trả về đúng;
    };

    hàm riêng tư biên dịch ngữ nghĩa kiểm tra gán hàm biểu thức(cây, các hàm, tên cục bộ) {
        nếu (cây == rỗng) { trả về đúng; };
        loại = lấy từ điển(cây, "loại", "");
        nếu (loại == "hằng" || loại == "tên") { trả về đúng; };
        nếu (loại == "hàm ẩn danh") {
            tên trong hàm = [];
            tham số = cây["tham số"];
            lặp(i = 0; i < máy ảo lấy độ dài(tham số); i++) {
                máy ảo thêm cuối danh sách(tên trong hàm, tham số[i]);
            };
            mình.biên dịch ngữ nghĩa kiểm tra khai báo biến(cây["thân"], tên trong hàm, các hàm);
            lặp(i = 0; i < máy ảo lấy độ dài(tên cục bộ); i++) {
                nếu (!mình.biên dịch ngữ nghĩa chứa(tên trong hàm, tên cục bộ[i])) {
                    máy ảo thêm cuối danh sách(tên trong hàm, tên cục bộ[i]);
                };
            };
            mình.biên dịch ngữ nghĩa kiểm tra gán hàm câu lệnh(cây["thân"], các hàm, tên trong hàm);
            trả về đúng;
        };
        nếu (loại == "hai ngôi") {
            trái = lấy từ điển(cây, "trái", rỗng);
            nếu (biên dịch biểu thức là phép gán(lấy từ điển(cây, "toán tử", ""))) {
                mình.biên dịch ngữ nghĩa kiểm tra đích gán hàm(trái, các hàm, tên cục bộ);
            };
            mình.biên dịch ngữ nghĩa kiểm tra gán hàm biểu thức(trái, các hàm, tên cục bộ);
            mình.biên dịch ngữ nghĩa kiểm tra gán hàm biểu thức(
                lấy từ điển(cây, "phải", rỗng), các hàm, tên cục bộ);
            trả về đúng;
        };
        nếu (loại == "cập nhật") {
            đích = lấy từ điển(cây, "đối tượng", rỗng);
            mình.biên dịch ngữ nghĩa kiểm tra đích gán hàm(đích, các hàm, tên cục bộ);
            mình.biên dịch ngữ nghĩa kiểm tra gán hàm biểu thức(đích, các hàm, tên cục bộ);
            trả về đúng;
        };
        nếu (loại == "một ngôi") {
            mình.biên dịch ngữ nghĩa kiểm tra gán hàm biểu thức(
                lấy từ điển(cây, "toán hạng", rỗng), các hàm, tên cục bộ);
            trả về đúng;
        };
        nếu (loại == "gọi") {
            mình.biên dịch ngữ nghĩa kiểm tra gán hàm biểu thức(
                lấy từ điển(cây, "hàm", rỗng), các hàm, tên cục bộ);
            đối số = lấy từ điển(cây, "đối số", []);
            lặp(i = 0; i < máy ảo lấy độ dài(đối số); i++) {
                mình.biên dịch ngữ nghĩa kiểm tra gán hàm biểu thức(đối số[i], các hàm, tên cục bộ);
            };
            trả về đúng;
        };
        nếu (loại == "chỉ số") {
            mình.biên dịch ngữ nghĩa kiểm tra gán hàm biểu thức(
                lấy từ điển(cây, "đối tượng", rỗng), các hàm, tên cục bộ);
            mình.biên dịch ngữ nghĩa kiểm tra gán hàm biểu thức(
                lấy từ điển(cây, "chỉ số", rỗng), các hàm, tên cục bộ);
            trả về đúng;
        };
        nếu (loại == "thành viên") {
            mình.biên dịch ngữ nghĩa kiểm tra gán hàm biểu thức(
                lấy từ điển(cây, "đối tượng", rỗng), các hàm, tên cục bộ);
            trả về đúng;
        };
        nếu (loại == "danh sách") {
            phần tử = lấy từ điển(cây, "phần tử", []);
            lặp(i = 0; i < máy ảo lấy độ dài(phần tử); i++) {
                mình.biên dịch ngữ nghĩa kiểm tra gán hàm biểu thức(phần tử[i], các hàm, tên cục bộ);
            };
            trả về đúng;
        };
        nếu (loại == "từ điển") {
            các mục = lấy từ điển(cây, "mục", []);
            lặp(i = 0; i < máy ảo lấy độ dài(các mục); i++) {
                mình.biên dịch ngữ nghĩa kiểm tra gán hàm biểu thức(
                    các mục[i]["giá trị"], các hàm, tên cục bộ);
            };
            trả về đúng;
        };
        ném "biên dịch ngữ nghĩa: biểu thức chưa hỗ trợ '" + loại + "'";
    };

    hàm riêng tư biên dịch ngữ nghĩa kiểm tra gán hàm câu lệnh(nút, các hàm, tên cục bộ) {
        loại = lấy từ điển(nút, "loại", "");
        nếu (loại == "hàm") { trả về đúng; };
        nếu (loại == "khối") {
            các lệnh = lấy từ điển(nút, "câu lệnh", []);
            lặp(i = 0; i < máy ảo lấy độ dài(các lệnh); i++) {
                mình.biên dịch ngữ nghĩa kiểm tra gán hàm câu lệnh(
                    các lệnh[i], các hàm, tên cục bộ);
            };
        };
        nếu (loại == "biến") {
            mình.biên dịch ngữ nghĩa kiểm tra gán hàm biểu thức(
                lấy từ điển(nút, "giá trị", rỗng), các hàm, tên cục bộ);
        };
        nếu (loại == "biểu thức" || loại == "in" || loại == "ném" || loại == "trả về") {
            mình.biên dịch ngữ nghĩa kiểm tra gán hàm biểu thức(
                lấy từ điển(nút, "biểu thức", rỗng), các hàm, tên cục bộ);
        };
        nếu (loại == "nếu") {
            mình.biên dịch ngữ nghĩa kiểm tra gán hàm biểu thức(
                lấy từ điển(nút, "điều kiện", rỗng), các hàm, tên cục bộ);
            mình.biên dịch ngữ nghĩa kiểm tra gán hàm câu lệnh(
                lấy từ điển(nút, "thân", {}), các hàm, tên cục bộ);
            nhánh khác = lấy từ điển(nút, "nhánh khác", rỗng);
            nếu (nhánh khác != rỗng) {
                mình.biên dịch ngữ nghĩa kiểm tra gán hàm câu lệnh(
                    nhánh khác, các hàm, tên cục bộ);
            };
        };
        nếu (loại == "lặp") {
            mình.biên dịch ngữ nghĩa kiểm tra gán hàm biểu thức(
                lấy từ điển(nút, "khởi tạo", rỗng), các hàm, tên cục bộ);
            mình.biên dịch ngữ nghĩa kiểm tra gán hàm biểu thức(
                lấy từ điển(nút, "điều kiện", rỗng), các hàm, tên cục bộ);
            mình.biên dịch ngữ nghĩa kiểm tra gán hàm biểu thức(
                lấy từ điển(nút, "cập nhật", rỗng), các hàm, tên cục bộ);
            mình.biên dịch ngữ nghĩa kiểm tra gán hàm câu lệnh(
                lấy từ điển(nút, "thân", {}), các hàm, tên cục bộ);
        };
        nếu (loại == "chọn") {
            mình.biên dịch ngữ nghĩa kiểm tra gán hàm biểu thức(
                lấy từ điển(nút, "biểu thức", rỗng), các hàm, tên cục bộ);
            nhánh = lấy từ điển(nút, "nhánh", []);
            lặp(i = 0; i < máy ảo lấy độ dài(nhánh); i++) {
                mình.biên dịch ngữ nghĩa kiểm tra gán hàm câu lệnh(
                    nhánh[i]["thân"], các hàm, tên cục bộ);
            };
        };
        nếu (loại == "thử") {
            mình.biên dịch ngữ nghĩa kiểm tra gán hàm câu lệnh(nút["thân"], các hàm, tên cục bộ);
            mình.biên dịch ngữ nghĩa kiểm tra gán hàm câu lệnh(nút["bắt"], các hàm, tên cục bộ);
        };
        trả về đúng;
    };

    // C++ đăng ký bí danh nhập trong SymbolSpace::Module của từng lexical scope.
    // Mỗi khối có một bảng bí danh riêng, độc lập với bảng tên hàm/biến.
    hàm riêng tư biên dịch ngữ nghĩa kiểm tra bí danh câu lệnh(nút) {
        loại = lấy từ điển(nút, "loại", "");
        nếu (loại == "khối") {
            mình.biên dịch ngữ nghĩa kiểm tra bí danh danh sách(lấy từ điển(nút, "câu lệnh", []));
        };
        nếu (loại == "hàm" || loại == "lặp") {
            mình.biên dịch ngữ nghĩa kiểm tra bí danh câu lệnh(lấy từ điển(nút, "thân", {}));
        };
        nếu (loại == "nếu") {
            mình.biên dịch ngữ nghĩa kiểm tra bí danh câu lệnh(lấy từ điển(nút, "thân", {}));
            nhánh khác = lấy từ điển(nút, "nhánh khác", rỗng);
            nếu (nhánh khác != rỗng) {
                mình.biên dịch ngữ nghĩa kiểm tra bí danh câu lệnh(nhánh khác);
            };
        };
        nếu (loại == "chọn") {
            các nhánh = lấy từ điển(nút, "nhánh", []);
            lặp(i = 0; i < máy ảo lấy độ dài(các nhánh); i++) {
                mình.biên dịch ngữ nghĩa kiểm tra bí danh câu lệnh(các nhánh[i]["thân"]);
            };
        };
        nếu (loại == "thử") {
            mình.biên dịch ngữ nghĩa kiểm tra bí danh câu lệnh(nút["thân"]);
            mình.biên dịch ngữ nghĩa kiểm tra bí danh câu lệnh(nút["bắt"]);
        };
        trả về đúng;
    };

    hàm riêng tư biên dịch ngữ nghĩa kiểm tra bí danh danh sách(các lệnh) {
        đã khai báo = [];
        lặp(i = 0; i < máy ảo lấy độ dài(các lệnh); i++) {
            mục = các lệnh[i];
            nếu (lấy từ điển(mục, "loại", "") == "nhập") {
                bí danh = lấy từ điển(mục, "bí danh", "");
                nếu (bí danh != "") {
                    nếu (mình.biên dịch ngữ nghĩa chứa(đã khai báo, bí danh)) {
                        ném "biên dịch ngữ nghĩa: trùng bí danh nhập '" + bí danh + "'";
                    };
                    máy ảo thêm cuối danh sách(đã khai báo, bí danh);
                };
            };
            mình.biên dịch ngữ nghĩa kiểm tra bí danh câu lệnh(mục);
        };
        trả về đúng;
    };

    hàm công khai biên dịch kiểm tra ngữ nghĩa thuần(cây) {
        nếu (lấy từ điển(cây, "loại", "") != "chương trình") {
            ném "biên dịch ngữ nghĩa: cần AST chương trình";
        };
        câu lệnh = lấy từ điển(cây, "câu lệnh", []);
        danh sách hàm đã khai báo = [];
        kiểu đã khai báo = [];
        thư viện đã khai báo = [];
        ngoại đã khai báo = [];
        lặp(i = 0; i < máy ảo lấy độ dài(câu lệnh); i++) {
            mục = câu lệnh[i];
            loại = lấy từ điển(mục, "loại", "");
            nếu (loại == "lớp" || loại == "giao diện") {
                tên kiểu = mục["tên"];
                nếu (mình.biên dịch ngữ nghĩa chứa(kiểu đã khai báo, tên kiểu)) {
                    mình.biên dịch ngữ nghĩa lỗi khai báo(mục,
                        "biên dịch ngữ nghĩa: trùng khai báo kiểu '" + tên kiểu + "'");
                };
                máy ảo thêm cuối danh sách(kiểu đã khai báo, tên kiểu);
            };
            nếu (loại == "ngoại thư viện") {
                nếu (mình.biên dịch ngữ nghĩa chứa(thư viện đã khai báo, mục["tên"])) {
                    mình.biên dịch ngữ nghĩa lỗi khai báo(mục,
                        "biên dịch ngữ nghĩa: trùng thư viện FFI '" + mục["tên"] + "'");
                };
                máy ảo thêm cuối danh sách(thư viện đã khai báo, mục["tên"]);
            };
            nếu (loại == "ngoại hàm") {
                nếu (mình.biên dịch ngữ nghĩa chứa(ngoại đã khai báo, mục["tên"])) {
                    mình.biên dịch ngữ nghĩa lỗi khai báo(mục,
                        "biên dịch ngữ nghĩa: trùng ngoại hàm '" + mục["tên"] + "'");
                };
                máy ảo thêm cuối danh sách(ngoại đã khai báo, mục["tên"]);
                mình.biên dịch ngữ nghĩa kiểm tra FFI(mục);
            };
            nếu (lấy từ điển(mục, "loại", "") == "hàm") {
                tên = lấy từ điển(mục, "tên", "");
                nếu (mình.biên dịch ngữ nghĩa chứa(danh sách hàm đã khai báo, tên)) {
                    mình.biên dịch ngữ nghĩa lỗi khai báo(mục,
                        "biên dịch ngữ nghĩa: trùng khai báo hàm '" + tên + "'");
                };
                máy ảo thêm cuối danh sách(danh sách hàm đã khai báo, tên);
            };
            mình.biên dịch ngữ nghĩa câu lệnh(mục, sai, sai, sai);
        };
        lặp(i = 0; i < máy ảo lấy độ dài(câu lệnh); i++) {
            mục = câu lệnh[i];
            nếu (lấy từ điển(mục, "loại", "") == "ngoại hàm" &&
                !mình.biên dịch ngữ nghĩa chứa(thư viện đã khai báo, mục["thư viện"])) {
                ném "biên dịch ngữ nghĩa: thư viện FFI chưa khai báo '" + mục["thư viện"] + "'";
            };
        };
        môi trường kiểu = [];
        lặp(i = 0; i < máy ảo lấy độ dài(câu lệnh); i++) { máy ảo thêm cuối danh sách(môi trường kiểu, câu lệnh[i]); };
        ngoài = lấy từ điển(cây, "kiểu ngoài", []);
        lặp(i = 0; i < máy ảo lấy độ dài(ngoài); i++) { máy ảo thêm cuối danh sách(môi trường kiểu, ngoài[i]); };
        mình.biên dịch ngữ nghĩa kiểm tra quan hệ kiểu(môi trường kiểu);
        mình.biên dịch ngữ nghĩa kiểm tra OOP(môi trường kiểu);
        tên toàn cục = [];
        lặp(i = 0; i < máy ảo lấy độ dài(danh sách hàm đã khai báo); i++) {
            máy ảo thêm cuối danh sách(tên toàn cục, danh sách hàm đã khai báo[i]);
        };
        lặp(i = 0; i < máy ảo lấy độ dài(câu lệnh); i++) {
            mình.biên dịch ngữ nghĩa kiểm tra khai báo biến(
                câu lệnh[i], tên toàn cục, danh sách hàm đã khai báo);
            // Thân hàm dùng bảng tên local đã thu thập ở nhánh "hàm" bên trên.
            nếu (lấy từ điển(câu lệnh[i], "loại", "") != "hàm") {
                mình.biên dịch ngữ nghĩa kiểm tra gán hàm câu lệnh(
                    câu lệnh[i], danh sách hàm đã khai báo, []);
            };
        };
        mình.biên dịch ngữ nghĩa kiểm tra bí danh danh sách(câu lệnh);
        trả về đúng;
    };

    // Điểm vào bootstrap cho parser + semantic V++, chưa sinh IR/bytecode.
    hàm công khai biên dịch phân tích ngữ nghĩa thuần(mã nguồn) {
        cây = biên dịch phân tích chương trình thuần(mã nguồn);
        mình.biên dịch kiểm tra ngữ nghĩa thuần(cây);
        trả về cây;
    };
};


hàm công khai biên dịch kiểm tra ngữ nghĩa thuần(cây) {
    bộ chuyển tiếp = Bộ Kiểm Tra Ngữ Nghĩa();
    trả về bộ chuyển tiếp.biên dịch kiểm tra ngữ nghĩa thuần(cây);
};

hàm công khai biên dịch phân tích ngữ nghĩa thuần(mã nguồn) {
    bộ chuyển tiếp = Bộ Kiểm Tra Ngữ Nghĩa();
    trả về bộ chuyển tiếp.biên dịch phân tích ngữ nghĩa thuần(mã nguồn);
};
