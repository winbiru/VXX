// Thực thi AST trực tiếp trong tiến trình V++ đang chạy.
// Parser là bước duy nhất trước khi chạy. Không sinh IR, bytecode hoặc mã máy.
nhập gói.biên dịch.chương trình.biên dịch phân tích chương trình thuần;
nhập gói.biên dịch.chương trình.biên dịch hạ hằng độc lập;
nhập gói.biên dịch.nguồn tệp.Bộ Nạp Nguồn;
nhập gói.biên dịch.hằng mô đun.biên dịch hạ hằng đồ thị;
nhập gói.biên dịch.sổ đăng ký.biên dịch đăng ký hàm đồ thị hoãn chuỗi;
nhập gói.biên dịch.kiểu mô đun.Bộ Đăng Ký Kiểu;
nhập gói.lõi.chuyển kiểu.thành số nguyên;
nhập gói.lõi.chuyển kiểu.thành số thực;
nhập gói.lõi.chuyển kiểu.thành chuỗi;
nhập gói.lõi.toán học.làm tròn xuống;
nhập gói.lõi.toán học.làm tròn lên;
nhập gói.bộ sưu tập.từ điển.lấy từ điển;

lớp công khai Bộ Thông Dịch {
    hàm công khai khởi tạo() {
        mình.toàn cục = mình.phạm vi mới(rỗng);
    };

    hàm riêng tư phạm vi mới(cha, ranh giới hàm = sai) {
        trả về {"giá trị": {}, "bất biến": {}, "cha": cha, "ranh giới hàm": ranh giới hàm};
    };

    hàm riêng tư phạm vi tìm(môi trường, tên) {
        hiện tại = môi trường;
        khi (hiện tại != rỗng) {
            nếu (máy ảo có khóa từ điển(hiện tại["giá trị"], tên)) { trả về hiện tại; };
            hiện tại = hiện tại["cha"];
        };
        trả về rỗng;
    };

    hàm riêng tư lấy biến(môi trường, tên) {
        phạm vi = mình.phạm vi tìm(môi trường, tên);
        // Các slot i32 chưa được ghi có giá trị mặc định 0 trong runtime.
        nếu (phạm vi == rỗng) { trả về 0; };
        trả về phạm vi["giá trị"][tên];
    };

    hàm riêng tư đặt biến(môi trường, tên, giá trị, khai báo = sai, bất biến = sai) {
        phạm vi = môi trường;
        nếu (!khai báo) {
            tìm = mình.phạm vi tìm(môi trường, tên);
            nếu (tìm != rỗng) { phạm vi = tìm; }
            hoặc {
                // Gán biến mới trong khối thuộc phạm vi hàm gần nhất.
                hiện tại = môi trường;
                khi (hiện tại != rỗng) {
                    phạm vi = hiện tại;
                    nếu (hiện tại["ranh giới hàm"]) { thoát; };
                    hiện tại = hiện tại["cha"];
                };
            };
        };
        nếu (máy ảo có khóa từ điển(phạm vi["bất biến"], tên)) {
            ném "thông dịch: không thể gán lại hằng '" + tên + "'";
        };
        phạm vi["giá trị"][tên] = giá trị;
        nếu (bất biến) { phạm vi["bất biến"][tên] = đúng; };
        trả về giá trị;
    };

    hàm riêng tư chuỗi literal(văn bản) {
        nguồn = chuỗi thành byte máy ảo(văn bản);
        ra = [];
        n = máy ảo lấy độ dài(nguồn);
        lặp(i = 1; i < n - 1; i++) {
            c = nguồn[i];
            nếu (c == 92 && i + 1 < n - 1) {
                i++;
                c = nguồn[i];
                nếu (c == 110) { c = 10; }
                hoặc nếu (c == 114) { c = 13; }
                hoặc nếu (c == 116) { c = 9; }
                hoặc nếu (c == 48) { c = 0; };
            };
            máy ảo thêm cuối danh sách(ra, c);
        };
        trả về chuỗi từ byte máy ảo(ra);
    };

    hàm riêng tư hằng(nút) {
        loại = nút["kiểu"];
        s = nút["giá trị"];
        nếu (loại == "số nguyên") { trả về thành số nguyên(s); };
        nếu (loại == "số thực") { trả về thành số thực(s); };
        nếu (loại == "chuỗi") { trả về mình.chuỗi literal(s); };
        nếu (s == "đúng") { trả về đúng; };
        nếu (s == "sai") { trả về sai; };
        nếu (s == "rỗng") { trả về rỗng; };
        ném "thông dịch: hằng chưa hỗ trợ '" + s + "'";
    };

    hàm riêng tư phép toán(toán tử, trái, phải) {
        chọn (toán tử) {
            ca "+": { trả về trái + phải; }
            ca "-": { trả về trái - phải; }
            ca "*": { trả về trái * phải; }
            ca "/": { trả về trái / phải; }
            ca "%": { trả về trái % phải; }
            ca "==": { trả về trái == phải; }
            ca "!=": { trả về trái != phải; }
            ca "<": { trả về trái < phải; }
            ca "<=": { trả về trái <= phải; }
            ca ">": { trả về trái > phải; }
            ca ">=": { trả về trái >= phải; }
            ca "&": { trả về trái & phải; }
            ca "|": { trả về trái | phải; }
            ca "^": { trả về trái ^ phải; }
            ca "<<": { trả về trái << phải; }
            ca ">>": { trả về trái >> phải; }
            mặc định: { ném "thông dịch: toán tử chưa hỗ trợ '" + toán tử + "'"; }
        };
    };

    // Lexer có thể gộp `đối_tượng.trường` thành một tên duy nhất.
    hàm riêng tư tách tên(tên) {
        lặp(i = 1; i < máy ảo lấy độ dài(tên) - 1; i++) {
            nếu (tên[i] == ".") {
                trả về {"nhận": máy ảo cắt chuỗi(tên, 0, i),
                    "tên": máy ảo cắt chuỗi(tên, i + 1, máy ảo lấy độ dài(tên) - i - 1)};
            };
        };
        trả về rỗng;
    };

    hàm riêng tư tìm phương thức(lớp, tên) {
        hiện tại = lớp;
        khi (hiện tại != rỗng) {
            các hàm = hiện tại["lớp thông dịch"]["phương thức"];
            lặp(i = 0; i < máy ảo lấy độ dài(các hàm); i++) {
                nếu (các hàm[i]["tên"] == tên) {
                    trả về {"hàm": các hàm[i], "lớp": hiện tại};
                };
            };
            hiện tại = hiện tại["lớp cha thông dịch"];
        };
        trả về rỗng;
    };

    hàm riêng tư đọc thành viên(đối tượng, tên, gọi = sai) {
        nếu (máy ảo lấy loại(đối tượng) != "từ điển") {
            ném "thông dịch: không thể truy cập thành viên '" + tên + "'";
        };
        cặp = mình.tách tên(tên);
        nếu (cặp != rỗng) {
            trả về mình.đọc thành viên(mình.đọc thành viên(đối tượng, cặp["nhận"]), cặp["tên"], gọi);
        };
        nếu (máy ảo có khóa từ điển(đối tượng, "gốc thông dịch")) {
            phương thức = mình.tìm phương thức(đối tượng["gốc thông dịch"], tên);
            nếu (phương thức == rỗng) { ném "thông dịch: phương thức lớp cha không tồn tại '" + tên + "'"; };
            trả về {"hàm thông dịch": phương thức["hàm"],
                "môi trường": phương thức["lớp"]["môi trường"],
                "nhận": đối tượng["đối tượng thông dịch"], "lớp hiện tại": phương thức["lớp"]};
        };
        nếu (máy ảo có khóa từ điển(đối tượng, "đối tượng thông dịch")) {
            // Vị trí gọi ưu tiên phương thức khi tên phương thức trùng tên trường.
            nếu (gọi) {
                phương thức = mình.tìm phương thức(đối tượng["đối tượng thông dịch"], tên);
                nếu (phương thức != rỗng) {
                    trả về {"hàm thông dịch": phương thức["hàm"],
                        "môi trường": phương thức["lớp"]["môi trường"],
                        "nhận": đối tượng, "lớp hiện tại": phương thức["lớp"]};
                };
            };
            trường = đối tượng["trường"];
            nếu (máy ảo có khóa từ điển(trường, tên)) { trả về trường[tên]; };
            phương thức = mình.tìm phương thức(đối tượng["đối tượng thông dịch"], tên);
            nếu (phương thức == rỗng) { ném "thông dịch: thành viên chưa khai báo '" + tên + "'"; };
            trả về {"hàm thông dịch": phương thức["hàm"],
                "môi trường": phương thức["lớp"]["môi trường"],
                "nhận": đối tượng, "lớp hiện tại": phương thức["lớp"]};
        };
        nếu (máy ảo có khóa từ điển(đối tượng, "lớp thông dịch")) {
            phương thức = mình.tìm phương thức(đối tượng, tên);
            nếu (phương thức == rỗng) { ném "thông dịch: phương thức lớp không tồn tại '" + tên + "'"; };
            trả về {"hàm thông dịch": phương thức["hàm"],
                "môi trường": phương thức["lớp"]["môi trường"],
                "nhận": đối tượng, "lớp hiện tại": phương thức["lớp"]};
        };
        trả về đối tượng[tên];
    };

    hàm riêng tư phương thức ngầm(môi trường, tên) {
        phạm vi = mình.phạm vi tìm(môi trường, "mình");
        nếu (phạm vi == rỗng) { trả về rỗng; };
        nhận = phạm vi["giá trị"]["mình"];
        nếu (máy ảo lấy loại(nhận) != "từ điển") { trả về rỗng; };
        kiểu nhận = rỗng;
        nếu (máy ảo có khóa từ điển(nhận, "đối tượng thông dịch")) {
            kiểu nhận = nhận["đối tượng thông dịch"];
        } hoặc nếu (máy ảo có khóa từ điển(nhận, "lớp thông dịch")) {
            kiểu nhận = nhận;
        };
        nếu (kiểu nhận == rỗng) { trả về rỗng; };
        phương thức = mình.tìm phương thức(kiểu nhận, tên);
        nếu (phương thức == rỗng) { trả về rỗng; };
        trả về {"hàm thông dịch": phương thức["hàm"],
            "môi trường": phương thức["lớp"]["môi trường"],
            "nhận": nhận, "lớp hiện tại": phương thức["lớp"]};
    };

    hàm riêng tư ghi thành viên(đối tượng, tên, giá trị) {
        nếu (máy ảo lấy loại(đối tượng) != "từ điển") {
            ném "thông dịch: không thể gán thành viên '" + tên + "'";
        };
        cặp = mình.tách tên(tên);
        nếu (cặp != rỗng) {
            trả về mình.ghi thành viên(mình.đọc thành viên(đối tượng, cặp["nhận"]), cặp["tên"], giá trị);
        };
        nếu (máy ảo có khóa từ điển(đối tượng, "đối tượng thông dịch")) {
            đối tượng["trường"][tên] = giá trị;
        } hoặc { đối tượng[tên] = giá trị; };
        trả về giá trị;
    };

    hàm riêng tư đọc tên(môi trường, tên, gọi = sai) {
        phạm vi = mình.phạm vi tìm(môi trường, tên);
        nếu (phạm vi != rỗng) { trả về phạm vi["giá trị"][tên]; };
        cặp = mình.tách tên(tên);
        nếu (cặp != rỗng) {
            trả về mình.đọc thành viên(mình.đọc tên(môi trường, cặp["nhận"]), cặp["tên"], gọi);
        };
        trả về 0;
    };

    hàm riêng tư đọc đích(nút, môi trường) {
        loại = nút["loại"];
        nếu (loại == "tên") { trả về mình.đọc tên(môi trường, nút["giá trị"]); };
        nếu (loại == "thành viên") {
            trả về mình.đọc thành viên(mình.biểu thức(nút["đối tượng"], môi trường), nút["tên"]);
        };
        nếu (loại == "chỉ số") {
            gốc = mình.biểu thức(nút["đối tượng"], môi trường);
            chỉ số = mình.biểu thức(nút["chỉ số"], môi trường);
            trả về gốc[chỉ số];
        };
        ném "thông dịch: vế trái phép gán chưa hỗ trợ";
    };

    hàm riêng tư ghi đích(nút, môi trường, giá trị) {
        loại = nút["loại"];
        nếu (loại == "tên") {
            tên = nút["giá trị"];
            nếu (mình.phạm vi tìm(môi trường, tên) == rỗng) {
                cặp = mình.tách tên(tên);
                nếu (cặp != rỗng) {
                    trả về mình.ghi thành viên(mình.đọc tên(môi trường, cặp["nhận"]), cặp["tên"], giá trị);
                };
            };
            trả về mình.đặt biến(môi trường, tên, giá trị);
        };
        nếu (loại == "thành viên") {
            trả về mình.ghi thành viên(mình.biểu thức(nút["đối tượng"], môi trường), nút["tên"], giá trị);
        };
        nếu (loại == "chỉ số") {
            gốc = mình.biểu thức(nút["đối tượng"], môi trường);
            chỉ số = mình.biểu thức(nút["chỉ số"], môi trường);
            gốc[chỉ số] = giá trị;
            trả về giá trị;
        };
        ném "thông dịch: đích phép gán chưa hỗ trợ";
    };

    // Giữ đối tượng và chỉ số của vế trái trước khi thực thi vế phải.
    // Các biểu thức có tác dụng phụ trong đích gán chỉ được đánh giá một lần.
    hàm riêng tư giữ đích(nút, môi trường) {
        loại = nút["loại"];
        nếu (loại == "tên") {
            tên = nút["giá trị"];
            nếu (mình.phạm vi tìm(môi trường, tên) == rỗng) {
                cặp = mình.tách tên(tên);
                nếu (cặp != rỗng) {
                    trả về {"loại": "thành viên", "nhận": mình.đọc tên(môi trường, cặp["nhận"]),
                        "tên": cặp["tên"]};
                };
            };
            trả về {"loại": "tên", "tên": tên, "môi trường": môi trường};
        };
        nếu (loại == "thành viên") {
            trả về {"loại": "thành viên", "nhận": mình.biểu thức(nút["đối tượng"], môi trường),
                "tên": nút["tên"]};
        };
        nếu (loại == "chỉ số") {
            trả về {"loại": "chỉ số", "nhận": mình.biểu thức(nút["đối tượng"], môi trường),
                "chỉ số": mình.biểu thức(nút["chỉ số"], môi trường)};
        };
        ném "thông dịch: đích phép gán chưa hỗ trợ";
    };

    hàm riêng tư đọc đích giữ(đích) {
        nếu (đích["loại"] == "tên") {
            trả về mình.đọc tên(đích["môi trường"], đích["tên"]);
        };
        nếu (đích["loại"] == "thành viên") {
            trả về mình.đọc thành viên(đích["nhận"], đích["tên"]);
        };
        trả về đích["nhận"][đích["chỉ số"]];
    };

    hàm riêng tư ghi đích giữ(đích, giá trị) {
        nếu (đích["loại"] == "tên") {
            trả về mình.đặt biến(đích["môi trường"], đích["tên"], giá trị);
        };
        nếu (đích["loại"] == "thành viên") {
            trả về mình.ghi thành viên(đích["nhận"], đích["tên"], giá trị);
        };
        đích["nhận"][đích["chỉ số"]] = giá trị;
        trả về giá trị;
    };

    hàm riêng tư gọi hàm(hàm nguồn, đối số) {
        nếu (máy ảo lấy loại(hàm nguồn) != "từ điển") {
            ném "thông dịch: đối tượng không thể gọi như hàm";
        };
        nếu (!máy ảo có khóa từ điển(hàm nguồn, "hàm thông dịch") &&
            !máy ảo có khóa từ điển(hàm nguồn, "lớp thông dịch")) {
            ném "thông dịch: đối tượng không thể gọi như hàm";
        };
        nếu (máy ảo có khóa từ điển(hàm nguồn, "lớp thông dịch")) {
            thể hiện = {"đối tượng thông dịch": hàm nguồn, "trường": {}};
            khởi tạo = mình.tìm phương thức(hàm nguồn, "khởi tạo");
            nếu (khởi tạo == rỗng) {
                nếu (máy ảo lấy độ dài(đối số) != 0) { ném "thông dịch: lớp không có hàm khởi tạo"; };
            } hoặc {
                mình.gọi hàm({"hàm thông dịch": khởi tạo["hàm"],
                    "môi trường": khởi tạo["lớp"]["môi trường"],
                    "nhận": thể hiện, "lớp hiện tại": khởi tạo["lớp"]}, đối số);
            };
            trả về thể hiện;
        };
        nút = hàm nguồn["hàm thông dịch"];
        môi trường = mình.phạm vi mới(hàm nguồn["môi trường"], đúng);
        nếu (máy ảo có khóa từ điển(hàm nguồn, "nhận")) {
            mình.đặt biến(môi trường, "mình", hàm nguồn["nhận"], đúng);
            cha kiểu = hàm nguồn["lớp hiện tại"]["lớp cha thông dịch"];
            nếu (cha kiểu != rỗng) {
                mình.đặt biến(môi trường, "gốc", {"gốc thông dịch": cha kiểu,
                    "đối tượng thông dịch": hàm nguồn["nhận"]}, đúng);
            };
        };
        tham số = nút["tham số"];
        mặc định = nút["mặc định tham số"];
        nếu (máy ảo lấy độ dài(đối số) > máy ảo lấy độ dài(tham số)) {
            ném "thông dịch: quá nhiều đối số của hàm '" + nút["tên"] + "'";
        };
        lặp(i = 0; i < máy ảo lấy độ dài(tham số); i++) {
            giá trị = rỗng;
            nếu (i < máy ảo lấy độ dài(đối số)) { giá trị = đối số[i]; }
            hoặc nếu (mặc định[i] != rỗng) { giá trị = mình.biểu thức(mặc định[i], môi trường); }
            hoặc { ném "thông dịch: thiếu đối số của hàm '" + nút["tên"] + "'"; };
            mình.đặt biến(môi trường, tham số[i], giá trị, đúng);
        };
        kết quả = mình.câu lệnh(nút["thân"], môi trường);
        nếu (kết quả["luồng"] == "trả về") { trả về kết quả["giá trị"]; };
        nếu (kết quả["luồng"] != "") { ném "thông dịch: điều khiển luồng ngoài vòng lặp"; };
        trả về rỗng;
    };

