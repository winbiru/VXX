    hàm riêng tư biểu thức(nút, môi trường) {
        nếu (nút == rỗng) { trả về rỗng; };
        loại = nút["loại"];
        nếu (loại == "hằng") { trả về mình.hằng(nút); };
        nếu (loại == "tên") { trả về mình.đọc tên(môi trường, nút["giá trị"]); };
        nếu (loại == "thành viên") { trả về mình.đọc đích(nút, môi trường); };
        nếu (loại == "hàm ẩn danh") { trả về {"hàm thông dịch": nút, "môi trường": môi trường}; };
        nếu (loại == "danh sách") {
            ra = [];
            phần tử = nút["phần tử"];
            lặp(i = 0; i < máy ảo lấy độ dài(phần tử); i++) {
                máy ảo thêm cuối danh sách(ra, mình.biểu thức(phần tử[i], môi trường));
            };
            trả về ra;
        };
        nếu (loại == "từ điển") {
            ra = {};
            mục = nút["mục"];
            lặp(i = 0; i < máy ảo lấy độ dài(mục); i++) {
                khóa = mục[i]["khóa"];
                tên = "";
                nếu (khóa["loại"] == "tên") { tên = khóa["giá trị"]; }
                hoặc { tên = mình.biểu thức(khóa, môi trường); };
                ra[tên] = mình.biểu thức(mục[i]["giá trị"], môi trường);
            };
            trả về ra;
        };
        nếu (loại == "chỉ số") { trả về mình.đọc đích(nút, môi trường); };
        nếu (loại == "một ngôi") {
            // Giá trị i32 nhỏ nhất chỉ biểu diễn được khi lấy dấu âm trước literal.
            nếu (nút["toán tử"] == "-" && nút["toán hạng"]["loại"] == "hằng" &&
                nút["toán hạng"]["giá trị"] == "2147483648") {
                trả về -2147483647 - 1;
            };
            x = mình.biểu thức(nút["toán hạng"], môi trường);
            chọn (nút["toán tử"]) {
                ca "!": { trả về !x; }
                ca "-": { trả về -x; }
                ca "+": { trả về +x; }
                ca "~": { trả về ~x; }
                mặc định: { ném "thông dịch: toán tử một ngôi chưa hỗ trợ"; }
            };
        };
        nếu (loại == "cập nhật") {
            đích giữ = mình.giữ đích(nút["đối tượng"], môi trường);
            x = mình.đọc đích giữ(đích giữ);
            giá trị = rỗng;
            nếu (nút["toán tử"] == "++") { giá trị = x + 1; }
            hoặc nếu (nút["toán tử"] == "--") { giá trị = x - 1; }
            hoặc { ném "thông dịch: phép cập nhật chưa hỗ trợ"; };
            // ++/-- ghi i32, cắt phần thập phân về phía 0 và tràn vòng 32 bit.
            nếu (máy ảo lấy loại(giá trị) == "số thực") {
                nếu (giá trị < 0.0) { giá trị = làm tròn lên(giá trị); }
                hoặc { giá trị = làm tròn xuống(giá trị); };
                nếu (máy ảo lấy loại(giá trị) == "số thực") {
                    nếu (giá trị >= 2147483648.0) { giá trị -= 4294967296.0; }
                    hoặc nếu (giá trị < -2147483648.0) { giá trị += 4294967296.0; };
                    giá trị = thành số nguyên(giá trị);
                };
            };
            mình.ghi đích giữ(đích giữ, giá trị);
            trả về x;
        };
        nếu (loại == "hai ngôi") {
            toán tử = nút["toán tử"];
            trái = nút["trái"];
            phải = nút["phải"];
            // Toán tử logic V++ đánh giá cả hai vế, kể cả khi vế trái đã quyết định kết quả.
            nếu (toán tử == "&&") {
                a = mình.biểu thức(trái, môi trường);
                b = mình.biểu thức(phải, môi trường);
                trả về !!a && !!b;
            };
            nếu (toán tử == "||") {
                a = mình.biểu thức(trái, môi trường);
                b = mình.biểu thức(phải, môi trường);
                trả về !!a || !!b;
            };
            nếu (toán tử == "=" || toán tử == "+=" || toán tử == "-=" ||
                toán tử == "*=" || toán tử == "/=" || toán tử == "%=" ||
                toán tử == "&=" || toán tử == "|=" || toán tử == "^=" ||
                toán tử == "<<=" || toán tử == ">>=") {
                a = rỗng;
                đích giữ = rỗng;
                nếu (toán tử != "=") {
                    đích giữ = mình.giữ đích(trái, môi trường);
                    a = mình.đọc đích giữ(đích giữ);
                };
                b = mình.biểu thức(phải, môi trường);
                nếu (toán tử != "=") {
                    phép = toán tử[0];
                    nếu (toán tử == "<<=") { phép = "<<"; };
                    nếu (toán tử == ">>=") { phép = ">>"; };
                    b = mình.phép toán(phép, a, b);
                };
                nếu (toán tử == "=") { trả về mình.ghi đích(trái, môi trường, b); };
                trả về mình.ghi đích giữ(đích giữ, b);
            };
            a = mình.biểu thức(trái, môi trường);
            b = mình.biểu thức(phải, môi trường);
            trả về mình.phép toán(toán tử, a, b);
        };
        nếu (loại == "gọi") {
            đích = nút["hàm"];
            đối số = [];
            tham số = nút["đối số"];
            lặp(i = 0; i < máy ảo lấy độ dài(tham số); i++) {
                máy ảo thêm cuối danh sách(đối số, mình.biểu thức(tham số[i], môi trường));
            };
            nếu (đích["loại"] == "tên") {
                tên đích = đích["giá trị"];
                // Hàm nội tại bộ() ưu tiên cú pháp gọi, kể cả khi có biến tên bộ.
                nếu (tên đích == "bộ") { trả về mình.gọi nội tại(tên đích, đối số); };
                phạm vi tên = mình.phạm vi tìm(môi trường, tên đích);
                nếu (phạm vi tên != rỗng) {
                    trả về mình.gọi hàm(phạm vi tên["giá trị"][tên đích], đối số);
                } hoặc {
                    tên ghép = mình.tách tên(tên đích);
                    nếu (tên ghép == rỗng) {
                        phương thức = mình.phương thức ngầm(môi trường, tên đích);
                        nếu (phương thức != rỗng) {
                            trả về mình.gọi hàm(phương thức, đối số);
                        };
                        trả về mình.gọi nội tại(tên đích, đối số);
                    };
                };
            };
            callee = rỗng;
            nếu (đích["loại"] == "tên") {
                callee = mình.đọc tên(môi trường, đích["giá trị"], đúng);
            } hoặc nếu (đích["loại"] == "thành viên") {
                callee = mình.đọc thành viên(mình.biểu thức(đích["đối tượng"], môi trường),
                    đích["tên"], đúng);
            } hoặc {
                callee = mình.biểu thức(đích, môi trường);
            };
            trả về mình.gọi hàm(callee, đối số);
        };
        ném "thông dịch: biểu thức chưa hỗ trợ '" + loại + "'";
    };

    hàm riêng tư bình thường() { trả về {"luồng": "", "giá trị": rỗng}; };

    hàm riêng tư câu lệnh(nút, môi trường) {
        nếu (nút == rỗng) { trả về mình.bình thường(); };
        loại = nút["loại"];
        nếu (loại == "khối" || loại == "chương trình") {
            phạm vi = môi trường;
            nếu (loại == "khối") { phạm vi = mình.phạm vi mới(môi trường); };
            các câu = nút["câu lệnh"];
            // Đăng ký ràng buộc trong cùng phạm vi trước khi chạy câu lệnh.
            // Biến đọc trước câu khai báo dùng slot cục bộ mặc định là 0.
            lặp(i = 0; i < máy ảo lấy độ dài(các câu); i++) {
                câu = các câu[i];
                nếu (câu["loại"] == "biến") {
                    mình.đặt biến(phạm vi, câu["tên"], 0, đúng);
                } hoặc nếu (câu["loại"] == "hàm") {
                    mình.đặt biến(phạm vi, câu["tên"], {"hàm thông dịch": câu, "môi trường": phạm vi}, đúng);
                } hoặc nếu (câu["loại"] == "lớp") {
                    mình.đặt biến(phạm vi, câu["tên"], {"lớp thông dịch": câu,
                        "môi trường": phạm vi, "lớp cha thông dịch": rỗng}, đúng);
                } hoặc nếu (câu["loại"] == "giao diện") {
                    // Giao diện cung cấp tên kiểu cho các module nhập nó.
                    mình.đặt biến(phạm vi, câu["tên"], {"giao diện thông dịch": câu}, đúng);
                };
            };
            // Giải quyết lớp cha sau khi đăng ký hết các kiểu cùng phạm vi.
            lặp(i = 0; i < máy ảo lấy độ dài(các câu); i++) {
                câu = các câu[i];
                nếu (câu["loại"] == "lớp" && câu["lớp cha"] != "") {
                    mình.lấy biến(phạm vi, câu["tên"])["lớp cha thông dịch"] =
                        mình.đọc tên(phạm vi, câu["lớp cha"]);
                };
            };
            lặp(i = 0; i < máy ảo lấy độ dài(các câu); i++) {
                câu = các câu[i];
                nếu (câu["loại"] != "hàm" && câu["loại"] != "lớp") {
                    kết quả = mình.câu lệnh(câu, phạm vi);
                    nếu (kết quả["luồng"] != "") { trả về kết quả; };
                };
            };
            trả về mình.bình thường();
        };
        nếu (loại == "trống" || loại == "hàm" || loại == "lớp" ||
            loại == "giao diện" || loại == "nhập") { trả về mình.bình thường(); };
        nếu (loại == "biến") {
            mình.đặt biến(môi trường, nút["tên"], mình.biểu thức(nút["giá trị"], môi trường), đúng,
                lấy từ điển(nút, "bất biến", sai));
            trả về mình.bình thường();
        };
        nếu (loại == "biểu thức") { mình.biểu thức(nút["biểu thức"], môi trường); trả về mình.bình thường(); };
        nếu (loại == "in") { in mình.biểu thức(nút["biểu thức"], môi trường); trả về mình.bình thường(); };
        nếu (loại == "trả về") {
            giá trị = 0;
            nếu (nút["biểu thức"] != rỗng) { giá trị = mình.biểu thức(nút["biểu thức"], môi trường); };
            trả về {"luồng": "trả về", "giá trị": giá trị};
        };
        nếu (loại == "bỏ qua" || loại == "thoát") { trả về {"luồng": loại, "giá trị": rỗng}; };
        nếu (loại == "ném") { ném mình.biểu thức(nút["biểu thức"], môi trường); };
        nếu (loại == "nếu") {
            nếu (mình.biểu thức(nút["điều kiện"], môi trường)) { trả về mình.câu lệnh(nút["thân"], môi trường); };
            trả về mình.câu lệnh(nút["nhánh khác"], môi trường);
        };
        nếu (loại == "lặp") {
            nếu (nút["khởi tạo"] != rỗng) { mình.biểu thức(nút["khởi tạo"], môi trường); };
            khi (đúng) {
                nếu (nút["điều kiện"] != rỗng) {
                    nếu (!mình.biểu thức(nút["điều kiện"], môi trường)) { thoát; };
                };
                kết quả = mình.câu lệnh(nút["thân"], môi trường);
                nếu (kết quả["luồng"] == "trả về") { trả về kết quả; };
                nếu (kết quả["luồng"] == "thoát") { thoát; };
                nếu (nút["cập nhật"] != rỗng) { mình.biểu thức(nút["cập nhật"], môi trường); };
            };
            trả về mình.bình thường();
        };
        nếu (loại == "chọn") {
            giá trị = mình.biểu thức(nút["biểu thức"], môi trường);
            các nhánh = nút["nhánh"];
            mặc định = rỗng;
            lặp(i = 0; i < máy ảo lấy độ dài(các nhánh); i++) {
                nhánh = các nhánh[i];
                nếu (nhánh["loại"] == "mặc định") { mặc định = nhánh["thân"]; }
                hoặc nếu (thành chuỗi(giá trị) == thành chuỗi(mình.biểu thức(nhánh["nhãn"], môi trường))) {
                    kết quả = mình.câu lệnh(nhánh["thân"], môi trường);
                    nếu (kết quả["luồng"] == "thoát") { trả về mình.bình thường(); };
                    trả về kết quả;
                };
            };
            kết quả = mình.câu lệnh(mặc định, môi trường);
            nếu (kết quả["luồng"] == "thoát") { trả về mình.bình thường(); };
            trả về kết quả;
        };
        nếu (loại == "thử") {
            thử { trả về mình.câu lệnh(nút["thân"], môi trường); }
            bắt lỗi(e) {
                phạm vi = mình.phạm vi mới(môi trường);
                nếu (nút["biến lỗi"] != "") { mình.đặt biến(phạm vi, nút["biến lỗi"], e, đúng); };
                trả về mình.câu lệnh(nút["bắt"], phạm vi);
            };
        };
        ném "thông dịch: câu lệnh chưa hỗ trợ '" + loại + "'";
    };

    // Thứ tự khởi tạo và giải quyết đường import dùng chung Bộ Nạp Nguồn.
    // Mỗi module có scope riêng, các hàm nhập giữ closure trên scope đó.
    hàm riêng tư nhập từ đồ thị(đồ thị, đường, môi trường, phạm vi mô đun) {
        cạnh = đồ thị["cạnh"];
        lặp(i = 0; i < máy ảo lấy độ dài(cạnh); i++) {
            mục = cạnh[i];
            nếu (mục["nguồn"] != đường) { bỏ qua; };
            xuất = phạm vi mô đun[mục["đích"]]["giá trị"];
            bí danh = mục["bí danh"];
            tên nhập = lấy từ điển(mục, "tên nhập", "*");
            nếu (bí danh != "" && (tên nhập == "" || tên nhập == "*")) {
                mình.đặt biến(môi trường, bí danh, xuất, đúng);
                bỏ qua;
            };
            nếu (tên nhập != "" && tên nhập != "*") {
                nếu (!máy ảo có khóa từ điển(xuất, tên nhập)) {
                    ném "thông dịch: không có tên nhập '" + tên nhập + "'";
                };
                tên đích = tên nhập;
                nếu (bí danh != "") { tên đích = bí danh; };
                mình.đặt biến(môi trường, tên đích, xuất[tên nhập], đúng);
            } hoặc {
                các tên = máy ảo liệt kê khóa từ điển(xuất);
                lặp(j = 0; j < máy ảo lấy độ dài(các tên); j++) {
                    tên = các tên[j];
                    mình.đặt biến(môi trường, tên, xuất[tên], đúng);
                };
            };
        };
    };

    hàm công khai chạy(nguồn, tệp = "", thư viện = "") {
        cây = biên dịch phân tích chương trình thuần(nguồn);
        nếu (tệp != "") {
            đồ thị = Bộ Nạp Nguồn(thư viện).đồ thị(tệp, nguồn, cây);
            biên dịch hạ hằng đồ thị(đồ thị);
            nếu (máy ảo lấy độ dài(đồ thị["ô nhớ hằng"]) > 0) {
                sổ = biên dịch đăng ký hàm đồ thị hoãn chuỗi(đồ thị);
                Bộ Đăng Ký Kiểu(sổ, đồ thị).đăng ký();
            };
            cây = đồ thị["cây điểm vào"];
            các mô đun = đồ thị["mô đun"];
            các phạm vi = {};
            các cây = {};
            gốc = đồ thị["điểm vào"];
            các phạm vi[gốc] = mình.toàn cục;
            lặp(i = 0; i < máy ảo lấy độ dài(các mô đun); i++) {
                mục = các mô đun[i];
                các phạm vi[mục["định danh"]] = mình.phạm vi mới(rỗng);
                các cây[mục["định danh"]] = mục["cây"];
            };
            thứ tự = đồ thị["thứ tự khởi tạo"];
            lặp(i = 0; i < máy ảo lấy độ dài(thứ tự); i++) {
                đường = thứ tự[i];
                mình.nhập từ đồ thị(đồ thị, đường, các phạm vi[đường], các phạm vi);
                mình.câu lệnh(các cây[đường], các phạm vi[đường]);
            };
            mình.nhập từ đồ thị(đồ thị, gốc, mình.toàn cục, các phạm vi);
        } hoặc {
            biên dịch hạ hằng độc lập(cây);
        };
        mình.câu lệnh(cây, mình.toàn cục);
        phạm vi chính = mình.phạm vi tìm(mình.toàn cục, "chính");
        nếu (phạm vi chính == rỗng) {
            phạm vi lớp = mình.phạm vi tìm(mình.toàn cục, "Chính");
            nếu (phạm vi lớp != rỗng) {
                lớp_điểm_vào = phạm vi lớp["giá trị"]["Chính"];
                thể_hiện_chính = mình.gọi hàm(lớp_điểm_vào, []);
                phương_thức_chạy = mình.đọc thành viên(thể_hiện_chính, "chạy", đúng);
                kết quả = mình.gọi hàm(phương_thức_chạy, []);
                nếu (kết quả == rỗng) { trả về 0; };
                nếu (máy ảo lấy loại(kết quả) != "số nguyên") {
                    ném "thông dịch: Chính.chạy phải trả về số nguyên hoặc rỗng";
                };
                trả về kết quả;
            };
            // Cho phép chương trình script có lệnh trực tiếp ở top-level.
            trả về 0;
        };
        kết quả = mình.gọi hàm(phạm vi chính["giá trị"]["chính"], []);
        nếu (kết quả == rỗng) { trả về 0; };
        nếu (máy ảo lấy loại(kết quả) != "số nguyên") {
            ném "thông dịch: hàm chính phải trả về số nguyên hoặc rỗng";
        };
        trả về kết quả;
    };
};

hàm công khai thông dịch nguồn(nguồn, tệp = "", thư viện = "") {
    bộ = Bộ Thông Dịch();
    trả về bộ.chạy(nguồn, tệp, thư viện);
};
