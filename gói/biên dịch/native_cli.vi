// Full-language compiler entry points for the native process ABI.
// The existing parser, semantics, OOP/closure IR and bytecode emitter are reused.
nhập gói/biên dịch/trình điều khiển;
nhập gói/biên dịch/nguồn tệp;
nhập gói/biên dịch/bộ nạp;
nhập gói/biên dịch/artifact;

hàm aot_compile_source(đường, thư_viện) {
    trả về biên dịch nguồn tệp tự chủ(đường, thư_viện);
};
hàm aot_artifact_wire(artifact) {
    trả về biên dịch nạp artifact(artifact);
};
hàm aot_bytecode_cli(đường, thư_viện, đầu_ra) {
    trả về biên dịch cli(đường, thư_viện, "build", đầu_ra);
};
hàm chính() {};
