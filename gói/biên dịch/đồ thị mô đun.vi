// Đồ thị phụ thuộc local-source thuần V++ để chuẩn bị linker nhiều mô-đun.
// Bộ dựng nhận nguồn đã nạp theo identity POSIX tương đối đã chuẩn hóa.
// Chưa đụng tới function ID, StringPool, namespace hay bytecode relocation.
nhập gói/biên dịch/chương trình;
nhập gói/bộ sưu tập/từ điển;

// Các phép xử lý đồ thị thuần dùng hàm cấp mô-đun.
// Chuẩn hóa lexical, không gọi filesystem. Khóa trong `nguồn` và import
// phải thuộc cùng một gốc logic, không thoát lên trên gốc đó.
hàm công khai biên dịch đồ thị chuẩn đường(đường) {
    nếu (loại của(đường) != "chuỗi") {
        ném "biên dịch đồ thị: cần đường dẫn tương đối không rỗng";
    };
    nếu (đường == "") {
        ném "biên dịch đồ thị: cần đường dẫn tương đối không rỗng";
    };
    nếu (đường[0] == "/") {
        ném "biên dịch đồ thị: cần đường dẫn tương đối không rỗng";
    };
    phần = [];
    mục = "";
    lặp(i = 0; i <= máy ảo lấy độ dài(đường); i++) {
        ký tự = "/";
        nếu (i < máy ảo lấy độ dài(đường)) { ký tự = đường[i]; };
        nếu (ký tự == "\\") {
            ném "biên dịch đồ thị: chưa hỗ trợ dấu phân cách Windows";
        };
        nếu (ký tự == "/") {
            nếu (mục == "..") {
                nếu (máy ảo lấy độ dài(phần) == 0) {
                    ném "biên dịch đồ thị: đường dẫn thoát khỏi gốc nguồn '" + đường + "'";
                };
                máy ảo xóa vị trí danh sách(phần, máy ảo lấy độ dài(phần) - 1);
            } hoặc {
                nếu (mục != "" && mục != ".") { máy ảo thêm cuối danh sách(phần, mục); };
            };
            mục = "";
        } hoặc {
            mục += ký tự;
        };
    };
    nếu (máy ảo lấy độ dài(phần) == 0) {
        ném "biên dịch đồ thị: đường dẫn không xác định mô-đun '" + đường + "'";
    };
    kết quả = phần[0];
    lặp(i = 1; i < máy ảo lấy độ dài(phần); i++) { kết quả += "/" + phần[i]; };
    trả về kết quả;
};

hàm công khai biên dịch đồ thị đích nhập(nguồn nhập, đích) {
    // Import tương đối được giải từ thư mục CHỨA module importer.
    // Mỗi module được coi là tệp không đuôi .vi trong graph in-memory.
    cha = "";
    lặp(i = 0; i < máy ảo lấy độ dài(nguồn nhập); i++) {
        nếu (nguồn nhập[i] == "/") {
            cha = "";
            lặp(j = 0; j < i; j++) { cha += nguồn nhập[j]; };
        };
    };
    nếu (cha == "") { trả về biên dịch đồ thị chuẩn đường(đích); };
    trả về biên dịch đồ thị chuẩn đường(cha + "/" + đích);
};

// Đồ thị nguồn tệp đã phân giải import bằng filesystem. Emitter phải dùng
// đúng identity đó, kể cả khi import được tìm ở thư mục tổ tiên/VPP_HOME.
hàm công khai biên dịch đồ thị tìm đích(đồ thị, nguồn nhập, đích) {
    nếu (lấy từ điển(đồ thị, "nguồn tệp", sai)) {
        cạnh = đồ thị["cạnh"];
        lặp(i = 0; i < máy ảo lấy độ dài(cạnh); i++) {
            nếu (cạnh[i]["nguồn"] == nguồn nhập && cạnh[i]["yêu cầu"] == đích) {
                trả về cạnh[i]["đích"];
            };
        };
        ném "biên dịch đồ thị: chưa phân giải import '" + đích + "'";
    };
    trả về biên dịch đồ thị đích nhập(nguồn nhập, đích);
};

hàm công khai biên dịch đồ thị quét nhập(cây) {
    các phần nhập = [];
    lệnh = lấy từ điển(cây, "câu lệnh", []);
    lặp(i = 0; i < máy ảo lấy độ dài(lệnh); i++) {
        nếu (lấy từ điển(lệnh[i], "loại", "") == "nhập") {
            máy ảo thêm cuối danh sách(các phần nhập, lệnh[i]);
        };
    };
    trả về các phần nhập;
};

hàm công khai biên dịch đồ thị chu trình(ngăn, lặp lại) {
    bắt đầu = -1;
    lặp(i = 0; i < máy ảo lấy độ dài(ngăn); i++) {
        nếu (ngăn[i] == lặp lại) { bắt đầu = i; };
    };
    kết quả = "";
    lặp(i = bắt đầu; i < máy ảo lấy độ dài(ngăn); i++) {
        nếu (kết quả != "") { kết quả += " -> "; };
        kết quả += ngăn[i];
    };
    trả về kết quả + " -> " + lặp lại;
};

hàm công khai biên dịch đồ thị duyệt(trạng thái, nguồn nhập, spec) {
    bộ dựng = Bộ Dựng Đồ Thị Mô Đun(trạng thái);
    trả về bộ dựng.duyệt(nguồn nhập, spec);
};

// `nguồn`: map định danh POSIX -> mã nguồn V++ (không có hậu tố .vi).
// `điểm_vào`: định danh module gốc; các module trong `mô đun` không gồm gốc.
// Trả cả cạnh import trùng để phục vụ alias / re-export ở linker về sau.
hàm công khai biên dịch dựng đồ thị nguồn thuần(điểm vào, nguồn) {
    bộ dựng = Bộ Dựng Đồ Thị Mô Đun({"nguồn": nguồn});
    trả về bộ dựng.dựng(điểm vào);
};

// Một đối tượng quản lý toàn bộ trạng thái DFS của một lần dựng đồ thị.
// API hàm tự do phía dưới được giữ để tương thích với các trình liên kết cũ.
lớp công khai Bộ Dựng Đồ Thị Mô Đun {
    hàm công khai khởi tạo(trạng thái) {
        mình.trạng thái = trạng thái;
    };

    hàm công khai duyệt(nguồn nhập, spec) {
    trạng thái = mình.trạng thái;
    đích = biên dịch đồ thị đích nhập(nguồn nhập, spec["đích"]);
    nguồn = trạng thái["nguồn"];
    nếu (!máy ảo có khóa từ điển(nguồn, đích)) {
        ném "biên dịch đồ thị: không tìm thấy nguồn mô-đun '" + đích + "'";
    };
    trạng thái đích = lấy từ điển(trạng thái["đã thăm"], đích, 0);
    nếu (trạng thái đích == 1) {
        ném "biên dịch đồ thị: import vòng " +
            biên dịch đồ thị chu trình(trạng thái["ngăn"], đích);
    };
    hành động = "load";
    nếu (trạng thái đích == 2) { hành động = "duplicate_no_op"; };
    máy ảo thêm cuối danh sách(trạng thái["cạnh"], {"nguồn": nguồn nhập, "đích": đích,
         "bí danh": lấy từ điển(spec, "bí danh", ""),
         "tái xuất": lấy từ điển(spec, "tái xuất", sai),
         "hành động": hành động});
    nếu (trạng thái đích == 2) { trả về đúng; };
    trạng thái["đã thăm"][đích] = 1;
    máy ảo thêm cuối danh sách(trạng thái["ngăn"], đích);
    cây = biên dịch phân tích chương trình thuần(nguồn[đích]);
    máy ảo thêm cuối danh sách(trạng thái["mô đun"], {"định danh": đích, "cây": cây});
    các phần nhập = biên dịch đồ thị quét nhập(cây);
    lặp(i = 0; i < máy ảo lấy độ dài(các phần nhập); i++) {
        mình.duyệt(đích, các phần nhập[i]);
    };
    máy ảo xóa vị trí danh sách(trạng thái["ngăn"], máy ảo lấy độ dài(trạng thái["ngăn"]) - 1);
    trạng thái["đã thăm"][đích] = 2;
    // Postorder: initializer của dependency phải đi trước importer.
    máy ảo thêm cuối danh sách(trạng thái["thứ tự khởi tạo"], đích);
    trả về đúng;
    };

    hàm công khai dựng(điểm vào) {
        nguồn = mình.trạng thái["nguồn"];
        nếu (loại của(nguồn) != "từ điển") {
            ném "biên dịch đồ thị: cần bảng nguồn mô-đun";
        };
        gốc dữ liệu = biên dịch đồ thị chuẩn đường(điểm vào);
        nếu (!máy ảo có khóa từ điển(nguồn, gốc dữ liệu)) {
            ném "biên dịch đồ thị: không tìm thấy nguồn gốc '" + gốc dữ liệu + "'";
        };
        cây = biên dịch phân tích chương trình thuần(nguồn[gốc dữ liệu]);
        mình.trạng thái = {"nguồn": nguồn, "đã thăm": {}, "ngăn": [],
                            "mô đun": [], "cạnh": [], "thứ tự khởi tạo": []};
        trạng thái = mình.trạng thái;
        trạng thái["đã thăm"][gốc dữ liệu] = 1;
        máy ảo thêm cuối danh sách(trạng thái["ngăn"], gốc dữ liệu);
        các phần nhập = biên dịch đồ thị quét nhập(cây);
        lặp(i = 0; i < máy ảo lấy độ dài(các phần nhập); i++) {
            mình.duyệt(gốc dữ liệu, các phần nhập[i]);
        };
        trả về {"loại": "đồ thị mô đun V++", "điểm vào": gốc dữ liệu,
                "cây điểm vào": cây, "mô đun": trạng thái["mô đun"],
                "cạnh": trạng thái["cạnh"],
                "thứ tự khởi tạo": trạng thái["thứ tự khởi tạo"]};
    };
};

