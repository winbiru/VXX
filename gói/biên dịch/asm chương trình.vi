// AOT đầy đủ: mã thao tác ABI -> mã máy trung gian -> byte và bản vá -> ASM.
// Không gọi compiler/encoder C++; runtime động được gọi qua symbol ABI.
nhập gói.biên dịch.mã thao tác.biên dịch mã thao tác;
nhập gói.biên dịch.mã máy.biên dịch mã máy hàm;
nhập gói.biên dịch.mã máy nền.biên dịch mã máy lệnh;
nhập gói.biên dịch.lắp ráp.biên dịch lắp ráp nối các phần;
nhập gói.biên dịch.lắp ráp.biên dịch lắp ráp mã máy;
nhập gói.biên dịch.lắp ráp.biên dịch lắp ráp đầu;
nhập gói.biên dịch.đích.biên dịch phân tích đích;
nhập gói.biên dịch.sản phẩm biên dịch.Bộ Mã Hóa Sản Phẩm Biên Dịch;
nhập gói.bộ sưu tập.từ điển.lấy từ điển;
nhập gói.biên dịch.asm vô hộp.*;
nhập gói.biên dịch.đo hiệu năng.*;
nhập gói.lõi.chuyển kiểu.thành chuỗi;

hàm công khai biên dịch asm tên nội tại() {
    // BEGIN native intrinsic opcodes: đối chiếu bởi vpp-opcode-abi.
    trả về [
        "OP_VM_BIEN_DICH_PHAN_TICH", "OP_VM_BYTECODE_CHAY", "OP_NATIVE_ARTIFACT_CHAY", "OP_VM_DNS_PHAN_GIAI",
        "OP_VM_DOC_BIEN_MOI_TRUONG", "OP_VM_DONG_HO_DIA_PHUONG", "OP_VM_DONG_HO_UTC", "OP_VM_DUONG_DAN_TON_TAI",
        "OP_VM_IO_DOC_BYTES", "OP_VM_IO_DOC_FILE", "OP_VM_IO_GHI_BYTES", "OP_VM_IO_GHI_FILE",
        "OP_VM_IO_GHI_TIEP_FILE", "OP_VM_KICH_BAN_CHAY", "OP_VM_LA_TEP", "OP_VM_LA_THU_MUC_KHONG_THEO_LIEN_KET",
        "OP_VM_LA_THU_MUC", "OP_VM_LIET_KE_THU_MUC", "OP_VM_NGAU_NHIEN_BAO_MAT_BYTES", "OP_VM_NGU_MILI_GIAY",
        "OP_VM_SO_THUC_BITS", "OP_VM_SOCKET_CHAP_NHAN", "OP_VM_SOCKET_DAT_TIMEOUT", "OP_VM_SOCKET_DONG",
        "OP_VM_SOCKET_GUI", "OP_VM_SOCKET_NHAN", "OP_VM_SOCKET_PHAN_GIAI", "OP_VM_SOCKET_TCP_LANG_NGHE",
        "OP_VM_SOCKET_TCP_MO", "OP_VM_SOCKET_TLS_NANG_CAP", "OP_VM_SOCKET_UDP_MO", "OP_VM_TAO_THU_MUC",
        "OP_VM_TEN_NEN_TANG", "OP_VM_THOI_GIAN_DON_DIEU_MS", "OP_VM_TIEN_TRINH_CHAY", "OP_VM_XOA_DUONG_DAN",
        "OP_VM_THREAD_SPAWN", "OP_VM_THREAD_WAIT", "OP_VM_THREAD_CANCEL", "OP_VM_THREAD_STATUS",
        "OP_VM_THREAD_PARK", "OP_VM_TUPLE_FROM_LIST", "OP_VM_TYPE_OF", "OP_VM_IDENTITY_HASH",
        "OP_VM_LENGTH", "OP_VM_LIST_APPEND", "OP_VM_LIST_REMOVE", "OP_VM_MAP_HAS",
        "OP_VM_MAP_REMOVE", "OP_VM_MAP_KEYS", "OP_VM_STRING_BYTES", "OP_VM_STRING_FROM_BYTES",
        "OP_VM_FLOAT_FROM_BITS", "OP_VM_MACHINE_FILE_OPEN", "OP_VM_MACHINE_FILE_READ", "OP_VM_MACHINE_FILE_WRITE",
        "OP_VM_MACHINE_FILE_CLOSE", "OP_VM_MACHINE_FILE_SEEK", "OP_VM_MACHINE_FILE_TELL", "OP_VM_MACHINE_FILE_ERROR",
        "OP_VM_MACHINE_FILE_REMOVE", "OP_VM_MACHINE_PROCESS_PID", "OP_VM_MACHINE_PROCESS_PPID", "OP_VM_MACHINE_PROCESS_UID",
        "OP_VM_MACHINE_PROCESS_EUID", "OP_VM_MACHINE_PROCESS_GID", "OP_VM_MACHINE_PROCESS_EGID", "OP_VM_MACHINE_TIME_SLEEP",
        "OP_VM_MACHINE_TIME_MONOTONIC", "OP_VM_MACHINE_TIME_REALTIME", "OP_VM_MACHINE_ENTROPY_READ", "OP_VM_MACHINE_ENV_GET",
        "OP_VM_MACHINE_TIME_LOCAL", "OP_VM_MACHINE_DIR_MKDIR", "OP_VM_MACHINE_DIR_REMOVE", "OP_VM_MACHINE_DIR_OPEN",
        "OP_VM_MACHINE_DIR_NEXT", "OP_VM_MACHINE_DIR_CLOSE", "OP_VM_MACHINE_PATH_KIND", "OP_VM_MACHINE_SOCKET_KIND",
        "OP_VM_MACHINE_SOCKET_CLOSE", "OP_VM_MACHINE_SOCKET_TIMEOUT", "OP_VM_MACHINE_SOCKET_SEND", "OP_VM_MACHINE_SOCKET_RECV",
        "OP_VM_MACHINE_SOCKET_ACCEPT", "OP_VM_MACHINE_SOCKET_LISTEN", "OP_VM_MACHINE_SOCKET_CONNECT", "OP_VM_MACHINE_PROCESS_NEW",
        "OP_VM_MACHINE_PROCESS_ARG", "OP_VM_MACHINE_PROCESS_COMMAND_LINE", "OP_VM_MACHINE_PROCESS_ENV", "OP_VM_MACHINE_PROCESS_START",
        "OP_VM_MACHINE_PROCESS_POLL", "OP_VM_MACHINE_PROCESS_READ", "OP_VM_MACHINE_PROCESS_WAIT", "OP_VM_MACHINE_PROCESS_ERROR",
        "OP_VM_MACHINE_PROCESS_CLOSE", "OP_VM_MACHINE_RESOLVE_OPEN", "OP_VM_MACHINE_RESOLVE_NEXT", "OP_VM_MACHINE_RESOLVE_CLOSE",
        "OP_VM_MACHINE_TLS_UPGRADE", "OP_VM_MACHINE_TLS_SEND", "OP_VM_MACHINE_TLS_RECV",
        "OP_VM_STRING_SLICE", "OP_VM_STRING_REPLACE_EXACT", "OP_VM_STRING_BYTE_SLICE"
    ];
    // END native intrinsic opcodes.
};

hàm riêng tư biên dịch asm bảng mã() {
    tên = ["OP_HAM", "OP_NEU", "OP_DIEU_KIEN", "OP_LAP", "OP_CAP_NHAT",
        "OP_DONG_LENH", "OP_MO_NGOAC", "OP_DONG_NGOAC", "OP_MO_KHOI", "OP_DONG_KHOI",
        "OP_BIEN_SO", "OP_TEN_BIEN_ID", "OP_TEN_BIEN_GIA_TRI", "OP_CHUOI", "OP_BIEN_SO_FLOAT",
        "OP_RONG_GIA_TRI", "OP_DUNG_GIA_TRI", "OP_SAI_GIA_TRI", "OP_KHOI_TAO", "OP_GAN",
        "OP_PARAM", "OP_PARAM_MAC_DINH", "OP_CONG_MOT", "OP_TRU_MOT", "OP_CONG", "OP_TRU",
        "OP_NHAN", "OP_CHIA", "OP_MODULO", "OP_BIT_VA", "OP_BIT_HOAC", "OP_BIT_XOR", "OP_DICH_TRAI", "OP_DICH_PHAI", "OP_Logic_VA", "OP_Logic_HOAC", "OP_SO_SANH_BANG",
        "OP_KHAC_BANG", "OP_LON_HON", "OP_NHO_HON", "OP_LON_HON_HOAC_BANG", "OP_NHO_HON_HOAC_BANG",
        "OP_KHONG", "OP_PHU_DINH", "OP_LIST_LITERAL", "OP_MAP_LITERAL", "OP_DOC_CHI_SO", "OP_GAN_CHI_SO",
        "OP_GOI", "OP_GOI_LOI_BAN_DIA", "OP_GOI_GIAN_TIEP", "OP_TAO_DONG_BAO", "OP_TAO_LOP", "OP_THEM_PHUONG_THUC",
        "OP_TAO_DOI_TUONG", "OP_DOC_THUOC_TINH", "OP_GAN_THUOC_TINH", "OP_GOI_PHUONG_THUC",
        "OP_IN", "OP_TRA_VE", "OP_DUNG_CHUONG_TRINH", "OP_JUMP", "OP_JUMP_IF_FALSE", "OP_BO_QUA",
        "OP_THOAT", "OP_CHON", "OP_CA", "OP_MAC_DINH", "OP_KET_THUC_CHUYEN", "OP_THU",
        "OP_THU_KET_THUC", "OP_BAT_LOI", "OP_NEM", "OP_FFI_CALL"];
    bảng = {};
    lặp(i = 0; i < độ dài(tên); i++) { bảng["" + biên dịch mã thao tác(tên[i])] = tên[i]; };
    nội tại = biên dịch asm tên nội tại();
    lặp(i = 0; i < độ dài(nội tại); i++) { bảng["" + biên dịch mã thao tác(nội tại[i])] = "intrinsic"; };
    trả về bảng;
};

// Chỉ nhận hàm có tham số bắt buộc, không đọc ô ngoài và trả về đúng
// một biểu thức i32 thuần. Hàm con phải được chứng minh ở lượt trước;
// lời gọi đệ quy và lời gọi có kiểu động giữ nguyên đường runtime.
hàm riêng tư biên dịch asm hàm i32(mã, bảng, đã chứng minh) {
    nếu (độ dài(mã) == 0) { trả về rỗng; };
    nếu (lấy từ điển(bảng, "" + mã[0][0], "") != "OP_MO_KHOI") { trả về rỗng; };
    ô tham số = [];
    i = 1;
    // Các khai báo cục bộ có thể xuất hiện trước phần khai báo tham số.
    khi (i < độ dài(mã)) {
        nếu (lấy từ điển(bảng, "" + mã[i][0], "") != "OP_KHOI_TAO") { thoát; };
        nếu (i + 1 < độ dài(mã)) {
            nếu (lấy từ điển(bảng, "" + mã[i + 1][0], "") == "OP_PARAM") { thoát; };
        };
        i += 1;
    };
    khi (i + 1 < độ dài(mã)) {
        nếu (lấy từ điển(bảng, "" + mã[i][0], "") != "OP_KHOI_TAO" ||
            lấy từ điển(bảng, "" + mã[i + 1][0], "") != "OP_PARAM") { thoát; };
        ô = mã[i][2];
        nếu (ô < 0 || mã[i + 1][2] != ô ||
            mã[i + 1][3] != độ dài(ô tham số) || độ dài(ô tham số) >= 4) { trả về rỗng; };
        lặp(j = 0; j < độ dài(ô tham số); j++) {
            nếu (ô tham số[j] == ô) { trả về rỗng; };
        };
        máy ảo thêm cuối danh sách(ô tham số, ô);
        i += 2;
    };
    lệnh = [];
    sâu = 0;
    sâu nhất = 0;
    đã trả = sai;
    // Biến đếm mới giữ đúng vị trí sau danh sách tham số khi hạ vòng lặp.
    lặp(vị trí = i; vị trí < độ dài(mã); vị trí++) {
        tên = lấy từ điển(bảng, "" + mã[vị trí][0], "");
        nếu (đã trả) {
            nếu (tên != "OP_DONG_KHOI" && tên != "OP_DONG_LENH") { trả về rỗng; };
            bỏ qua;
        };
        nếu (tên == "OP_MO_KHOI" || tên == "OP_DONG_KHOI" || tên == "OP_DONG_LENH") { bỏ qua; };
        phép = "";
        hằng = 0;
        ô = 0;
        ký hiệu = "";
        nếu (tên == "OP_BIEN_SO") {
            phép = "PushConstant";
            hằng = mã[vị trí][1];
            sâu += 1;
        } hoặc nếu (tên == "OP_TEN_BIEN_GIA_TRI") {
            lặp(j = 0; j < độ dài(ô tham số); j++) {
                nếu (ô tham số[j] == mã[vị trí][2]) { ô = j; phép = "LoadSlot"; thoát; };
            };
            nếu (phép == "") { trả về rỗng; };
            sâu += 1;
        } hoặc nếu (tên == "OP_CONG" || tên == "OP_TRU" || tên == "OP_NHAN" ||
            tên == "OP_BIT_VA" || tên == "OP_BIT_HOAC" || tên == "OP_BIT_XOR" ||
            tên == "OP_DICH_TRAI" || tên == "OP_DICH_PHAI") {
            nếu (sâu < 2) { trả về rỗng; };
            phép = biên dịch asm phép i32 thuần(tên);
            sâu -= 1;
        } hoặc nếu (tên == "OP_GOI") {
            dạng con = lấy từ điển(đã chứng minh, "" + mã[vị trí][2], rỗng);
            số đối số = mã[vị trí][1];
            // Toán tử logic của bytecode đánh giá cả hai phía: phải kiểm tra
            // dữ liệu hàm con trước khi đọc danh sách ô tham số.
            nếu (dạng con == rỗng) { trả về rỗng; };
            nếu (số đối số < 0 || sâu < số đối số) { trả về rỗng; };
            nếu (số đối số != độ dài(dạng con["ô"])) { trả về rỗng; };
            phép = "Call";
            ô = số đối số;
            ký hiệu = "vpp_aot_i32_" + mã[vị trí][2];
            sâu = sâu - số đối số + 1;
        } hoặc nếu (tên == "OP_TRA_VE" && sâu == 1) {
            phép = "Return";
            sâu -= 1;
            đã trả = đúng;
        } hoặc { trả về rỗng; };
        trước = sâu;
        nếu (phép == "PushConstant" || phép == "LoadSlot") { trước -= 1; };
        nếu (phép == "Add" || phép == "Sub" || phép == "Mul" ||
            phép == "BitAnd" || phép == "BitOr" || phép == "BitXor" ||
            phép == "ShiftLeft" || phép == "ShiftRight" || phép == "Return") { trước += 1; };
        nếu (phép == "Call") { trước = sâu + ô - 1; };
        máy ảo thêm cuối danh sách(lệnh, biên dịch mã máy lệnh(phép, hằng, ô, trước, ký hiệu));
        nếu (sâu > sâu nhất) { sâu nhất = sâu; };
        nếu (độ dài(lệnh) > 128) { trả về rỗng; };
    };
    nếu (!đã trả) { trả về rỗng; };
    trả về {"ô": ô tham số, "máy": {"parameterCount": độ dài(ô tham số),
        "slotCount": độ dài(ô tham số), "maxStackDepth": sâu nhất, "instructions": lệnh}};
};

hàm riêng tư biên dịch asm phép i32 thuần(tên) {
    chọn(tên) {
        ca "OP_CONG": { trả về "Add"; }
        ca "OP_TRU": { trả về "Sub"; }
        ca "OP_NHAN": { trả về "Mul"; }
        ca "OP_BIT_VA": { trả về "BitAnd"; }
        ca "OP_BIT_HOAC": { trả về "BitOr"; }
        ca "OP_BIT_XOR": { trả về "BitXor"; }
        ca "OP_DICH_TRAI": { trả về "ShiftLeft"; }
        ca "OP_DICH_PHAI": { trả về "ShiftRight"; }
    };
    trả về "";
};

lớp công khai Bộ Hạ ASM Động {
    hàm công khai khởi tạo(lệnh, bảng, bảng i32, id hàm = -1) {
        mình.nguồn = lệnh;
        mình.bảng = bảng;
        mình.bảng i32 = bảng i32;
        mình.id hàm = id hàm;
        mình.ô receiver = {};
        mình.ô nội tuyến = {};
        lặp(i = 0; i < độ dài(lệnh); i++) {
            nếu (lấy từ điển(bảng, "" + lệnh[i][0], "") == "OP_PARAM" && lệnh[i][3] == -1 && lệnh[i][2] >= 0) {
                mình.ô receiver["" + lệnh[i][2]] = đúng;
            };
        };
        // Local bind đúng một lần trong phần mở đầu hàm có vị trí ổn định
        // trong 16 ô nội tuyến của runtime. Nếu hàm tạo closure, giữ đường
        // động vì một ô có thể được nâng lên heap ở giữa luồng chạy.
        nếu (id hàm >= 0) {
            có closure = sai;
            số lần khởi tạo = {};
            lặp(i = 0; i < độ dài(lệnh); i++) {
                tên lệnh = lấy từ điển(bảng, "" + lệnh[i][0], "");
                nếu (tên lệnh == "OP_TAO_DONG_BAO") { có closure = đúng; };
                nếu (tên lệnh == "OP_KHOI_TAO" && lệnh[i][2] >= 0) {
                    khóa ô = "" + lệnh[i][2];
                    số lần khởi tạo[khóa ô] = lấy từ điển(số lần khởi tạo, khóa ô, 0) + 1;
                };
            };
            nếu (!có closure) {
                trường khóa = [15, 43, 40, 44, 47, 50, 53, 56, 60, 63, 66, 69, 72, 75, 78, 81];
                lệch ô = [144, 152, 164, 180, 192, 204, 216, 228,
                    244, 256, 268, 280, 292, 304, 316, 328];
                vị trí = 0;
                nếu (độ dài(lệnh) > 0 && lấy từ điển(bảng, "" + lệnh[0][0], "") == "OP_MO_KHOI") {
                    vị trí = 1;
                };
                thứ tự = 0;
                khi (vị trí < độ dài(lệnh) && thứ tự < 16) {
                    nếu (lấy từ điển(bảng, "" + lệnh[vị trí][0], "") != "OP_KHOI_TAO") { thoát; };
                    ô = lệnh[vị trí][2];
                    nếu (ô >= 0 && lấy từ điển(số lần khởi tạo, "" + ô, 0) == 1) {
                        mình.ô nội tuyến["" + ô] = [trường khóa[thứ tự], lệch ô[thứ tự]];
                    };
                    bước = 1;
                    nếu (vị trí + 1 < độ dài(lệnh) && lệnh[vị trí + 1][2] == ô) {
                        tên sau = lấy từ điển(bảng, "" + lệnh[vị trí + 1][0], "");
                        nếu (tên sau == "OP_PARAM" || tên sau == "OP_PARAM_MAC_DINH") { bước = 2; };
                    };
                    thứ tự += 1;
                    vị trí += bước;
                };
            };
        };
        mình.lệnh = [];
        mình.sâu = 0;
        mình.sâu nhất = 0;
        mình.vị trí = [];
        mình.vá = [];
        mình.lỗi = [];
        mình.trả = [];
        mình.chuyển = [];
        mình.bắt = [];
        mình.đích nhánh = [];
        mình.số ô = 2;
        mình.dự phòng đến = 0;
    };
    hàm riêng tư phát(mã, hằng = 0, ô = 0, ký hiệu = "") {
        máy ảo thêm cuối danh sách(mình.lệnh, biên dịch mã máy lệnh(mã, hằng, ô, mình.sâu, ký hiệu));
        nếu (mã == "PushConstant" || mã == "LoadSlot") { mình.sâu = mình.sâu + 1; }
        hoặc nếu (mã == "Call") { mình.sâu = mình.sâu - ô + 1; }
        hoặc nếu (mã == "Drop" || mã == "BranchZero" || mã == "Return" ||
            mã == "Add" || mã == "Sub" || mã == "Mul" || mã == "Equal" ||
            mã == "BitAnd" || mã == "BitOr" || mã == "BitXor" || mã == "ShiftLeft" || mã == "ShiftRight" ||
            mã == "NotEqual" || mã == "Less" || mã == "LessEqual" ||
            mã == "Greater" || mã == "GreaterEqual") { mình.sâu = mình.sâu - 1; };
        nếu (mình.sâu < 0) { ném "AOT V++: stack lowering không hợp lệ"; };
        nếu (mình.sâu > mình.sâu nhất) { mình.sâu nhất = mình.sâu; };
    };
    hàm riêng tư gọi thô(tên, đối số = rỗng) {
        nếu (đối số == rỗng) { đối số = []; };
        mình.phát("LoadSlot", 0, 0);
        lặp(i = 0; i < độ dài(đối số); i++) { mình.phát("PushConstant", đối số[i]); };
        mình.phát("Call", 0, độ dài(đối số) + 1, "vpp_native_dynamic_" + tên);
    };
    hàm riêng tư gọi(tên, đối số = rỗng) {
        mình.gọi thô(tên, đối số);
        nếu (tên == "condition" || tên == "case" || tên == "default") {
            mình.phát("StoreSlot", 0, 1);
            mình.phát("Drop");
            mình.gọi thô("failed");
        };
        thành công = độ dài(mình.lệnh);
        mình.phát("BranchZero");
        máy ảo thêm cuối danh sách(mình.lỗi, độ dài(mình.lệnh));
        mình.phát("Jump");
        mình.lệnh[thành công]["operand"] = độ dài(mình.lệnh);
    };
    // Đích thực tế và đối số vẫn được kiểm tra tại thời điểm gọi.
    // Bộ chọn trả 0 để giữ nguyên stack và chạy đường động khi không khớp.
    hàm riêng tư gọi vô hộp(v, phương thức) {
        // Bootstrap/compiler phải giữ đúng ABI và mã máy của backend C++.
        // Các selector này chỉ thuộc đường tối ưu của chương trình AOT thường.
        nếu (lấy từ điển(mình.bảng i32, "compiler", sai)) { trả về sai; };
        số = v[1];
        nếu (số < 0 || số > 4) { trả về sai; };
        nếu (phương thức) {
            nếu (!lấy từ điển(mình.bảng i32, "method:" + v[2], sai)) { trả về sai; };
            mình.gọi thô("method_id", [v[2], số, v[3]]);
            mình.phát("StoreSlot", 0, 1); mình.phát("Drop");
            mình.gọi thô("failed");
            hợp lệ = độ dài(mình.lệnh); mình.phát("BranchZero");
            máy ảo thêm cuối danh sách(mình.lỗi, độ dài(mình.lệnh)); mình.phát("Jump");
            mình.lệnh[hợp lệ]["operand"] = độ dài(mình.lệnh);
        };
        mình.phát("LoadSlot", 0, 0);
        nếu (phương thức) { mình.phát("LoadSlot", 0, 1); }
        hoặc { mình.phát("PushConstant", 0); };
        hậu tố = "i"; nếu (phương thức) { hậu tố = "m"; };
        mình.phát("Call", 0, 2, "vpp_aot_fast_" + hậu tố + số);
        mình.phát("StoreSlot", 0, 1); mình.phát("Drop");
        mình.phát("LoadSlot", 0, 1);
        chậm = độ dài(mình.lệnh); mình.phát("BranchZero");
        mình.phát("LoadSlot", 0, 1); mình.phát("PushConstant", 1); mình.phát("Equal");
        máy ảo thêm cuối danh sách(mình.lỗi, độ dài(mình.lệnh)); mình.phát("BranchZero");
        xong = độ dài(mình.lệnh); mình.phát("Jump");
        mình.lệnh[chậm]["operand"] = độ dài(mình.lệnh);
        nếu (phương thức) { mình.gọi("method", [v[2], số, v[3]]); }
        hoặc { mình.gọi("indirect", [số]); };
        mình.lệnh[xong]["operand"] = độ dài(mình.lệnh);
        trả về đúng;
    };
    // Gọi qua một biến local: selector đọc callable trực tiếp từ slot. Đường
    // i32 vẫn được thử trước, còn fallback dùng indirect_slot để tránh tạo
    // giá trị callee tạm trên stack.
    hàm riêng tư gọi gián tiếp qua ô(từ) {
        nếu (từ + 1 >= độ dài(mình.nguồn)) { trả về 0; };
        nếu (lấy từ điển(mình.bảng i32, "compiler", sai)) { trả về 0; };
        lệnh gọi = mình.nguồn[từ + 1];
        nếu (lấy từ điển(mình.bảng, "" + lệnh gọi[0], "") != "OP_GOI_GIAN_TIEP" ||
            mình.đích nhánh[từ + 1] != 0) { trả về 0; };
        số = lệnh gọi[1]; ô = mình.nguồn[từ][2];
        nếu (số >= 0 && số <= 4) {
            mình.phát("LoadSlot", 0, 0); mình.phát("PushConstant", ô);
            mình.phát("Call", 0, 2, "vpp_aot_fast_s" + số);
            mình.phát("StoreSlot", 0, 1); mình.phát("Drop");
            mình.phát("LoadSlot", 0, 1);
            chậm = độ dài(mình.lệnh); mình.phát("BranchZero");
            mình.phát("LoadSlot", 0, 1); mình.phát("PushConstant", 1); mình.phát("Equal");
            máy ảo thêm cuối danh sách(mình.lỗi, độ dài(mình.lệnh)); mình.phát("BranchZero");
            xong = độ dài(mình.lệnh); mình.phát("Jump");
            mình.lệnh[chậm]["operand"] = độ dài(mình.lệnh);
            mình.gọi("indirect_slot", [ô, số]);
            mình.lệnh[xong]["operand"] = độ dài(mình.lệnh);
        } hoặc {
            mình.gọi("indirect_slot", [ô, số]);
        };
        máy ảo thêm cuối danh sách(mình.vị trí, mình.vị trí[từ]);
        trả về 2;
    };
    // Gọi thẳng private method của chính lớp đang thực thi. Function id đã
    // được chứng minh từ OP_THEM_PHUONG_THUC; receiver vẫn được truyền để
    // giữ đúng `mình`, quyền truy cập, GC và ngữ nghĩa khung gọi.
    hàm riêng tư gọi phương thức riêng tư trực tiếp(từ) {
        nếu (lấy từ điển(mình.bảng i32, "compiler", sai)) { trả về 0; };
        nếu (mình.id hàm < 0 || từ >= độ dài(mình.nguồn)) { trả về 0; };
        chủ = lấy từ điển(mình.bảng i32, "owner:" + mình.id hàm, -1);
        nếu (chủ < 0) { trả về 0; };
        nhận = mình.nguồn[từ];
        nếu (lấy từ điển(mình.bảng, "" + nhận[0], "") != "OP_TEN_BIEN_GIA_TRI") { trả về 0; };
        nếu (!lấy từ điển(mình.ô receiver, "" + nhận[2], sai)) { trả về 0; };
        lặp(số = 0; số <= 2; số++) {
            vị trí gọi = từ + 1 + số;
            nếu (vị trí gọi >= độ dài(mình.nguồn)) { thoát; };
            liền mạch = đúng;
            lặp(j = từ + 1; j <= vị trí gọi; j++) {
                nếu (mình.đích nhánh[j] != 0) { liền mạch = sai; };
            };
            nếu (!liền mạch) { bỏ qua; };
            lệnh gọi = mình.nguồn[vị trí gọi];
            nếu (lấy từ điển(mình.bảng, "" + lệnh gọi[0], "") != "OP_GOI_PHUONG_THUC" ||
                lệnh gọi[1] != số || lệnh gọi[3] != 0) { bỏ qua; };
            tên_phương_thức = lệnh gọi[2];
            bị_che = sai;
            số_lớp = lấy từ điển(mình.bảng i32, "số_lớp", 0);
            lặp(k = 0; k < số_lớp; k++) {
                ứng_viên = lấy từ điển(mình.bảng i32, "lớp:" + k, -1);
                nếu (ứng_viên == chủ ||
                    !lấy từ điển(mình.bảng i32,
                        "khai_báo_phương_thức:" + ứng_viên + ":" + tên_phương_thức, sai)) {
                    bỏ qua;
                };
                cha_lớp = lấy từ điển(mình.bảng i32, "cha:" + ứng_viên, -1);
                lặp(bước = 0; bước < số_lớp && cha_lớp >= 0; bước++) {
                    nếu (cha_lớp == chủ) { bị_che = đúng; thoát; };
                    cha_lớp = lấy từ điển(mình.bảng i32, "cha:" + cha_lớp, -1);
                };
                nếu (bị_che) { thoát; };
            };
            nếu (bị_che) { bỏ qua; };
            đích = lấy từ điển(mình.bảng i32,
                "private_method:" + chủ + ":" + tên_phương_thức, -1);
            nếu (đích < 0) { bỏ qua; };
            đối số = [0, 0];
            loại = 0;
            đơn giản = đúng;
            lặp(j = 0; j < số; j++) {
                tham số = mình.nguồn[từ + 1 + j];
                tên = lấy từ điển(mình.bảng, "" + tham số[0], "");
                kiểu = 0;
                nếu (tên == "OP_BIEN_SO") { đối số[j] = tham số[1]; }
                hoặc nếu (tên == "OP_TEN_BIEN_GIA_TRI") { kiểu = 1; đối số[j] = tham số[2]; }
                hoặc nếu (tên == "OP_CHUOI") { kiểu = 2; đối số[j] = tham số[2]; }
                hoặc { đơn giản = sai; };
                loại = loại | (kiểu << (j * 2));
            };
            nếu (!đơn giản) { bỏ qua; };
            mình.gọi("method_direct_small", [đích, nhận[2], số, đối số[0], đối số[1], loại]);
            lặp(j = từ + 1; j <= vị trí gọi; j++) {
                máy ảo thêm cuối danh sách(mình.vị trí, mình.vị trí[từ]);
            };
            trả về vị trí gọi - từ + 1;
        };
        trả về 0;
    };
    hàm riêng tư nhảy(đích, từ) {
        nếu (đích < 0 || đích > độ dài(mình.nguồn)) { ném "AOT V++: invalid branch target"; };
        nếu (đích <= từ) { mình.gọi("safepoint"); };
        máy ảo thêm cuối danh sách(mình.vá, [độ dài(mình.lệnh), đích]);
        mình.phát("Jump");
    };
    hàm riêng tư điều kiện(đích) {
        mình.phát("LoadSlot", 0, 1);
        máy ảo thêm cuối danh sách(mình.vá, [độ dài(mình.lệnh), đích]);
        mình.phát("BranchZero");
    };
    hàm riêng tư đích tiếp tục(từ) {
        sâu = 0;
        nguồn = mình.nguồn;
        lặp(i = từ + 1; i < độ dài(nguồn); i++) {
            tên = lấy từ điển(mình.bảng, "" + nguồn[i][0], "");
            nếu (tên == "OP_LAP") { sâu += 1; };
            nếu (tên == "OP_CAP_NHAT") {
                nếu (sâu == 0) { trả về i; };
                sâu -= 1;
            };
        };
        ném "AOT V++: continue outside loop";
    };
    // Bytecode có thể được nhảy đến từ nơi khác, kể cả nhánh bắt lỗi.
    // Không được gộp qua bất kỳ điểm vào nào của đồ thị điều khiển.
    hàm riêng tư đánh dấu đích nhánh() {
        nguồn = mình.nguồn;
        lặp(j = 0; j <= độ dài(nguồn); j++) { máy ảo thêm cuối danh sách(mình.đích nhánh, 0); };
        lặp(j = 0; j < độ dài(nguồn); j++) {
            v = nguồn[j];
            tên = lấy từ điển(mình.bảng, "" + v[0], "");
            đích = -1;
            nếu (tên == "OP_JUMP" || tên == "OP_JUMP_IF_FALSE" || tên == "OP_THOAT" ||
                tên == "OP_THU" || tên == "OP_THU_KET_THUC" || tên == "OP_CHON") { đích = v[1]; }
            hoặc nếu (tên == "OP_CA" || tên == "OP_MAC_DINH") { đích = v[3]; }
            hoặc nếu (tên == "OP_BO_QUA") { đích = mình.đích tiếp tục(j); };
            nếu (đích >= 0 && đích <= độ dài(nguồn)) { mình.đích nhánh[đích] = 1; };
            nếu (tên == "OP_BAT_LOI") { mình.đích nhánh[j] = 1; };
        };
    };
    hàm riêng tư phép toán gộp(tên) {
        trả về tên == "OP_CONG" || tên == "OP_TRU" || tên == "OP_NHAN";
    };
    // Pure i32/bool constant folding; integer arithmetic follows the VM's
    // wrapping i32 semantics. Division is excluded because it can throw.
    hàm riêng tư gập hằng i32(tên, a, b) {
        nếu (tên == "OP_CONG") { trả về [đúng, a + b]; };
        nếu (tên == "OP_TRU") { trả về [đúng, a - b]; };
        nếu (tên == "OP_NHAN") { trả về [đúng, a * b]; };
        nếu (tên == "OP_SO_SANH_BANG") { trả về [đúng, a == b]; };
        nếu (tên == "OP_KHAC_BANG") { trả về [đúng, a != b]; };
        nếu (tên == "OP_LON_HON") { trả về [đúng, a > b]; };
        nếu (tên == "OP_NHO_HON") { trả về [đúng, a < b]; };
        nếu (tên == "OP_LON_HON_HOAC_BANG") { trả về [đúng, a >= b]; };
        nếu (tên == "OP_NHO_HON_HOAC_BANG") { trả về [đúng, a <= b]; };
        nếu (tên == "OP_Logic_VA") { trả về [đúng, a != 0 && b != 0]; };
        nếu (tên == "OP_Logic_HOAC") { trả về [đúng, a != 0 || b != 0]; };
        trả về [sai, 0];
    };
    hàm riêng tư phép so sánh gộp(tên) {
        trả về tên == "OP_SO_SANH_BANG" || tên == "OP_KHAC_BANG" || tên == "OP_LON_HON" ||
            tên == "OP_NHO_HON" || tên == "OP_LON_HON_HOAC_BANG" || tên == "OP_NHO_HON_HOAC_BANG";
    };
    hàm riêng tư so sánh rồi nhảy(tên, đối số, đích) {
        // Kết quả ABI: 0=sai, 1=đúng, 2=lỗi; mọi lỗi đi qua catch.
        mình.gọi thô(tên, đối số);
        mình.phát("StoreSlot", 0, 1);
        mình.phát("Drop");
        mình.phát("LoadSlot", 0, 1);
        mình.phát("PushConstant", 2);
        mình.phát("Equal");
        thành công = độ dài(mình.lệnh);
        mình.phát("BranchZero");
        máy ảo thêm cuối danh sách(mình.lỗi, độ dài(mình.lệnh));
        mình.phát("Jump");
        mình.lệnh[thành công]["operand"] = độ dài(mình.lệnh);
        mình.điều kiện(đích);
    };
    hàm riêng tư so sánh tập số nguyên(từ, số) {
        cuối = từ + 4 * số - 1;
        nếu (số < 2 || số > 4 || cuối >= độ dài(mình.nguồn)) { trả về rỗng; };
        lặp(j = từ + 1; j <= cuối; j++) {
            nếu (mình.đích nhánh[j] != 0) { trả về rỗng; };
        };
        đầu = mình.nguồn[từ];
        nếu (lấy từ điển(mình.bảng, "" + đầu[0], "") != "OP_TEN_BIEN_GIA_TRI") { trả về rỗng; };
        ô = đầu[2];
        giá trị = [0, 0, 0, 0];
        v1 = mình.nguồn[từ + 1]; v2 = mình.nguồn[từ + 2];
        nếu (lấy từ điển(mình.bảng, "" + v1[0], "") != "OP_BIEN_SO" ||
            lấy từ điển(mình.bảng, "" + v2[0], "") != "OP_SO_SANH_BANG") { trả về rỗng; };
        giá trị[0] = v1[1];
        lặp(k = 1; k < số; k++) {
            gốc = từ + 4 * k - 1;
            a = mình.nguồn[gốc]; b = mình.nguồn[gốc + 1];
            c = mình.nguồn[gốc + 2]; d = mình.nguồn[gốc + 3];
            nếu (lấy từ điển(mình.bảng, "" + a[0], "") != "OP_TEN_BIEN_GIA_TRI" || a[2] != ô ||
                lấy từ điển(mình.bảng, "" + b[0], "") != "OP_BIEN_SO" ||
                lấy từ điển(mình.bảng, "" + c[0], "") != "OP_SO_SANH_BANG" ||
                lấy từ điển(mình.bảng, "" + d[0], "") != "OP_Logic_HOAC") { trả về rỗng; };
            giá trị[k] = b[1];
        };
        lệnh nhảy = mình.nguồn[cuối];
        nếu (lấy từ điển(mình.bảng, "" + lệnh nhảy[0], "") != "OP_JUMP_IF_FALSE") { trả về rỗng; };
        trả về [số, ô, giá trị[0], giá trị[1], giá trị[2], giá trị[3], lệnh nhảy[1], cuối - từ];
    };
    // Vòng tạo danh sách: list thêm (base + i). Giữ bytecode gốc làm
    // đường dự phòng nếu ô biến đổi kiểu hoặc container không còn là list.
    hàm riêng tư vòng thêm danh sách(từ) {
        nguồn = mình.nguồn;
        nếu (từ + 16 > độ dài(nguồn)) { trả về [sai]; };
        mẫu = ["OP_DIEU_KIEN", "OP_TEN_BIEN_GIA_TRI", "OP_BIEN_SO", "OP_NHO_HON",
            "OP_JUMP_IF_FALSE", "OP_MO_KHOI", "OP_TEN_BIEN_GIA_TRI",
            "OP_TEN_BIEN_GIA_TRI", "OP_TEN_BIEN_GIA_TRI", "OP_CONG",
            "intrinsic", "OP_DONG_KHOI", "OP_CAP_NHAT",
            "OP_TEN_BIEN_ID", "OP_CONG_MOT", "OP_JUMP"];
        lặp(j = 0; j < 16; j++) {
            nếu (lấy từ điển(mình.bảng, "" + nguồn[từ + j][0], "") != mẫu[j]) { trả về [sai]; };
            nếu (j == 10 && nguồn[từ + j][0] != biên dịch mã thao tác("OP_VM_LIST_APPEND")) { trả về [sai]; };
            nếu (j > 0 && mình.đích nhánh[từ + j] != 0) { trả về [sai]; };
        };
        bộ đếm = nguồn[từ + 1][2];
        danh sách = nguồn[từ + 6][2];
        cơ sở = nguồn[từ + 7][2];
        nếu (bộ đếm < 0 || danh sách < 0 || cơ sở < 0 ||
            nguồn[từ + 8][2] != bộ đếm || nguồn[từ + 13][2] != bộ đếm ||
            nguồn[từ + 4][1] != từ + 16 || nguồn[từ + 15][1] != từ) { trả về [sai]; };
        trả về [đúng, bộ đếm, nguồn[từ + 2][1], danh sách, cơ sở, từ + 16];
    };
    // Vòng lọc số nguyên: nếu list[i] % D == E thì sum += list[i].
    // Chỉ nhận đúng hình bytecode để không thay đổi thứ tự đánh giá.
    hàm riêng tư vòng lọc tổng danh sách(từ) {
        nguồn = mình.nguồn;
        nếu (từ + 29 > độ dài(nguồn)) { trả về [sai]; };
        mẫu = ["OP_DIEU_KIEN", "OP_TEN_BIEN_GIA_TRI", "OP_BIEN_SO", "OP_NHO_HON",
            "OP_JUMP_IF_FALSE", "OP_MO_KHOI", "OP_NEU", "OP_TEN_BIEN_GIA_TRI",
            "OP_TEN_BIEN_GIA_TRI", "OP_DOC_CHI_SO", "OP_BIEN_SO", "OP_MODULO",
            "OP_BIEN_SO", "OP_SO_SANH_BANG", "OP_JUMP_IF_FALSE", "OP_MO_KHOI",
            "OP_TEN_BIEN_GIA_TRI", "OP_TEN_BIEN_GIA_TRI", "OP_TEN_BIEN_GIA_TRI",
            "OP_DOC_CHI_SO", "OP_CONG", "OP_TEN_BIEN_ID", "OP_GAN",
            "OP_DONG_KHOI", "OP_DONG_KHOI", "OP_CAP_NHAT", "OP_TEN_BIEN_ID",
            "OP_CONG_MOT", "OP_JUMP"];
        lặp(j = 0; j < 29; j++) {
            nếu (lấy từ điển(mình.bảng, "" + nguồn[từ + j][0], "") != mẫu[j]) { trả về [sai]; };
            // từ+24 là đích nội bộ của nhánh if sai.
            nếu (j > 0 && j != 24 && mình.đích nhánh[từ + j] != 0) { trả về [sai]; };
        };
        bộ đếm = nguồn[từ + 1][2];
        danh sách = nguồn[từ + 7][2];
        tổng = nguồn[từ + 16][2];
        nếu (bộ đếm < 0 || danh sách < 0 || tổng < 0 ||
            nguồn[từ + 8][2] != bộ đếm ||
            nguồn[từ + 17][2] != danh sách || nguồn[từ + 18][2] != bộ đếm ||
            nguồn[từ + 21][2] != tổng || nguồn[từ + 26][2] != bộ đếm ||
            nguồn[từ + 4][1] != từ + 29 || nguồn[từ + 14][1] != từ + 24 ||
            nguồn[từ + 28][1] != từ) { trả về [sai]; };
        trả về [đúng, bộ đếm, nguồn[từ + 2][1], danh sách, tổng,
            nguồn[từ + 10][1], nguồn[từ + 12][1], từ + 29];
    };
    // Nhận dạng một danh sách cục bộ chỉ dùng để chuyển dãy (base + i)
