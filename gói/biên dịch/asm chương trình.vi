                    t2 = lấy từ điển(mình.bảng, "" + a2[0], "");
                    t3 = lấy từ điển(mình.bảng, "" + a3[0], "");
                    t4 = lấy từ điển(mình.bảng, "" + a4[0], "");
                    t5 = lấy từ điển(mình.bảng, "" + a5[0], "");
                    t6 = lấy từ điển(mình.bảng, "" + a6[0], "");
                    t7 = lấy từ điển(mình.bảng, "" + a7[0], "");
                    t8 = lấy từ điển(mình.bảng, "" + a8[0], "");
                    t9 = lấy từ điển(mình.bảng, "" + a9[0], "");
                    t10 = lấy từ điển(mình.bảng, "" + a10[0], "");
                    t11 = lấy từ điển(mình.bảng, "" + a11[0], "");
                    cùng chỉ số = sai;
