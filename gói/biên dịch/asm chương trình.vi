        };
        lặp(i = 0; i < độ dài(mình.lỗi); i++) { mình.lệnh[mình.lỗi[i]]["operand"] = lỗi; };
        lặp(i = 0; i < độ dài(mình.trả); i++) { mình.lệnh[mình.trả[i]]["operand"] = xong; };
        trả về {"parameterCount": 1, "slotCount": mình.số ô, "maxStackDepth": mình.sâu nhất, "instructions": mình.lệnh};
    };
};

// Quote theo byte UTF-8, không theo số ký tự. Octal đủ ba chữ số giữ cả
// NUL, dấu nháy, dấu gạch chéo và chữ số đứng ngay sau escape.
hàm riêng tư biên dịch asm nháy(văn bản) {
    các byte = chuỗi thành byte máy ảo(văn bản);
    bảng = "01234567";
    ra = "\"";
    lặp(i = 0; i < độ dài(các byte); i++) {
        b = các byte[i];
        nếu (b == 34 || b == 92) { ra += "\\" + chuỗi từ byte máy ảo([b]); }
        hoặc nếu (b >= 32 && b < 127) { ra += chuỗi từ byte máy ảo([b]); }
        hoặc { ra += "\\" + bảng[b / 64] + bảng[(b / 8) % 8] + bảng[b % 8]; };
    };
    trả về ra + "\"";
};

hàm riêng tư biên dịch asm thân(lệnh, tên, đích, bảng, bảng i32, id hàm = -1, thống kê = rỗng, bảng byte = rỗng, bảng hex = rỗng, bộ đệm = rỗng) {
    bắt đầu bước = 0;
    nếu (thống kê != rỗng) { bắt đầu bước = biên dịch hồ sơ bắt đầu("asm"); };
    hạ = Bộ Hạ ASM Động(lệnh, bảng, bảng i32, id hàm);
    máy = hạ.hạ();
    khóa = "";
    nếu (bộ đệm != rỗng) {
        // Machine IR do lowerer vừa tạo chỉ chứa i32 và symbol ASCII ABI.
        // Biểu diễn đầy đủ giữ cả function/string IDs, nhánh, frame, target
        // và relocation; không dùng tên hàm hay đường nguồn làm cache key.
        khóa = đích["kiến trúc"] + "/" + đích["hệ điều hành"] + "/" + thành chuỗi(máy);
        thân cũ = lấy từ điển(bộ đệm["thân"], khóa, rỗng);
        nếu (thân cũ != rỗng) {
            bộ đệm["trúng"] = bộ đệm["trúng"] + 1;
            nếu (thống kê != rỗng) {
                thống kê["lower_ms"] = thống kê["lower_ms"] + biên dịch hồ sơ bắt đầu("asm") - bắt đầu bước;
                thống kê["count"] = thống kê["count"] + 1;
            };
            trả về biên dịch lắp ráp đầu(đích["hệ điều hành"], tên) + thân cũ;
        };
        bộ đệm["trượt"] = bộ đệm["trượt"] + 1;
    };
    nếu (thống kê != rỗng) {
        thống kê["lower_ms"] = thống kê["lower_ms"] + biên dịch hồ sơ bắt đầu("asm") - bắt đầu bước;
        bắt đầu bước = biên dịch hồ sơ bắt đầu("asm");
    };
    phát = biên dịch mã máy hàm(đích["kiến trúc"], máy, đích["hệ điều hành"]);
    nếu (thống kê != rỗng) {
        thống kê["machine_ms"] = thống kê["machine_ms"] + biên dịch hồ sơ bắt đầu("asm") - bắt đầu bước;
        bắt đầu bước = biên dịch hồ sơ bắt đầu("asm");
    };
    kết quả = biên dịch lắp ráp mã máy(đích["kiến trúc"], đích["hệ điều hành"], tên, phát, bảng byte, bảng hex, bộ đệm == rỗng);
    nếu (bộ đệm != rỗng) {
        kích cỡ = độ dài(khóa) + độ dài(kết quả);
        // Giới hạn phiên batch ở 64 MiB; giải phóng cả map khi đầy.
        nếu (bộ đệm["byte"] + kích cỡ > 67108864) {
            bộ đệm["thân"] = {}; bộ đệm["byte"] = 0;
        };
        nếu (kích cỡ <= 67108864) {
            bộ đệm["thân"][khóa] = kết quả;
            bộ đệm["byte"] = bộ đệm["byte"] + kích cỡ;
        };
        kết quả = biên dịch lắp ráp đầu(đích["hệ điều hành"], tên) + kết quả;
    };
    nếu (thống kê != rỗng) {
        thống kê["assemble_ms"] = thống kê["assemble_ms"] + biên dịch hồ sơ bắt đầu("asm") - bắt đầu bước;
        thống kê["count"] = thống kê["count"] + 1;
    };
    trả về kết quả;
};

hàm công khai biên dịch asm chương trình(dây, bộ ba, compiler = sai, bộ đệm = rỗng) {
    đường hồ sơ = biên dịch hồ sơ đường();
    bắt đầu = biên dịch hồ sơ bắt đầu(đường hồ sơ);
    codec = Bộ Mã Hóa Sản Phẩm Biên Dịch(rỗng);
    codec.kiểm tra dây(dây, "bytecode V++ đồ thị đã liên kết");
    đích = biên dịch phân tích đích(bộ ba);
    nếu (đích["kiến trúc"] != "aarch64" && đích["kiến trúc"] != "x86_64") {
        ném "AOT V++: cần target aarch64/x86_64";
    };
    bảng = biên dịch asm bảng mã();
    các hàm = dây[2];
    khởi tạo = dây[3];
    chuỗi = dây[1];
    ngoại = [];
    nếu (độ dài(dây) == 5) { ngoại = dây[4]; };
    // Dùng các phần thay vì nối lại toàn bộ assembly khi thêm từng hàm.
    phần = [];
    // Chuỗi decimal cho các byte dùng lại ở mọi thân hàm trong một lần biên dịch.
    bảng byte = [];
    lặp(i = 0; i < 256; i++) { máy ảo thêm cuối danh sách(bảng byte, "" + i); };
    bảng hex = rỗng;
    nếu (đích["kiến trúc"] == "aarch64" && đích["hệ điều hành"] == "macos") {
        bảng hex = [];
        chữ hex = "0123456789abcdef";
        lặp(i = 0; i < 256; i++) {
            máy ảo thêm cuối danh sách(bảng hex, chữ hex[i / 16] + chữ hex[i % 16]);
        };
    };
    bảng i32 = {};
    // Runtime bootstrap của compiler không mang runtime VM AOT đầy đủ.
    // Không để peephole AOT của chương trình tự áp dụng lên compiler và tạo
    // phụ thuộc vòng vào các helper động chỉ tồn tại khi chạy chương trình.
    bảng i32["compiler"] = compiler;
    // Phân tích theo các lớp phụ thuộc; chu trình không có hàm lá sẽ
    // không bao giờ được chuyên biệt hóa, tránh đệ quy native không giới hạn.
    lặp(lượt = 0; lượt < độ dài(các hàm); lượt++) {
        thêm mới = 0;
        lặp(i = 0; i < độ dài(các hàm); i++) {
            nếu (các hàm[i][1] >= 0 && lấy từ điển(bảng i32, "" + i, rỗng) == rỗng) {
                dạng = biên dịch asm hàm i32(các hàm[i][2], bảng, bảng i32);
                nếu (dạng == rỗng) { dạng = biên dịch asm hàm vô hộp(các hàm[i][2], bảng, chuỗi, sai); };
                nếu (dạng != rỗng) { bảng i32["" + i] = dạng; thêm mới += 1; };
            };
        };
        nếu (thêm mới == 0) { thoát; };
    };
    biên dịch hồ sơ ghi(đường hồ sơ, "asm.specialize", bắt đầu);
    bắt đầu = biên dịch hồ sơ bắt đầu(đường hồ sơ);
    nhanh = {};
    lặp(i = 0; i < độ dài(các hàm); i++) {
        dạng = lấy từ điển(bảng i32, "" + i, rỗng);
        ký hiệu = "vpp_aot_i32_" + i;
        nếu (dạng == rỗng) {
            dạng = biên dịch asm hàm vô hộp(các hàm[i][2], bảng, chuỗi, đúng);
            ký hiệu = "vpp_aot_ascii_" + i;
        };
        nếu (dạng != rỗng) {
            nếu (lấy từ điển(dạng, "dùng", -1) < 0) {
                dùng = 0; lệnh máy = dạng["máy"]["instructions"];
                lặp(j = 0; j < độ dài(lệnh máy); j++) {
                    nếu (lệnh máy[j]["opcode"] == "LoadSlot") { dùng = dùng | (1 << lệnh máy[j]["operand"]); };
                };
                dạng["dùng"] = dùng; dạng["ascii"] = sai;
            };
            dạng["ký hiệu"] = ký hiệu; nhanh["" + i] = dạng;
            phát = biên dịch mã máy hàm(đích["kiến trúc"], dạng["máy"], đích["hệ điều hành"]);
            máy ảo thêm cuối danh sách(phần, biên dịch lắp ráp mã máy(đích["kiến trúc"],
                đích["hệ điều hành"], ký hiệu, phát, bảng byte, bảng hex));
        };
    };
    // Chỉ thử bộ chọn ở tên phương thức có ít nhất một thân hàm đã chứng minh.
    mã đăng ký = [dây[0]];
    lặp(i = 0; i < độ dài(khởi tạo); i++) { máy ảo thêm cuối danh sách(mã đăng ký, khởi tạo[i][1]); };
    lặp(i = 0; i < độ dài(các hàm); i++) { máy ảo thêm cuối danh sách(mã đăng ký, các hàm[i][2]); };
    số_lớp = 0;
    lặp(i = 0; i < độ dài(mã đăng ký); i++) {
        mã = mã đăng ký[i];
        lặp(j = 0; j < độ dài(mã); j++) {
            tên_đăng_ký = lấy từ điển(bảng, "" + mã[j][0], "");
            nếu (tên_đăng_ký == "OP_TAO_LOP") {
                lớp_id = mã[j][2];
                nếu (!lấy từ điển(bảng i32, "lớp_đã_gặp:" + lớp_id, sai)) {
                    bảng i32["lớp_đã_gặp:" + lớp_id] = đúng;
                    bảng i32["lớp:" + số_lớp] = lớp_id;
                    số_lớp += 1;
                };
                cha_lớp = -1;
                nếu (mã[j][3] > 0) { cha_lớp = mã[j][3] - 1; };
                bảng i32["cha:" + lớp_id] = cha_lớp;
            };
            nếu (tên_đăng_ký == "OP_THEM_PHUONG_THUC") {
                chủ = mã[j][1]; nếu (chủ < 0) { chủ = 0 - chủ - 1; };
                id gốc = mã[j][3];
                id = id gốc; nếu (id < 0) { id = 0 - id - 1; };
                bảng i32["owner:" + id] = chủ;
                bảng i32["khai_báo_phương_thức:" + chủ + ":" + mã[j][2]] = đúng;
                nếu (id gốc < 0) {
                    bảng i32["private_method:" + chủ + ":" + mã[j][2]] = id;
                };
                dạng phương thức = lấy từ điển(nhanh, "" + id, rỗng);
                nếu (dạng phương thức != rỗng) {
                    bảng i32["method:" + mã[j][2]] = đúng;
                    nếu (lấy từ điển(dạng phương thức, "ascii", sai) && độ dài(dạng phương thức["ô"]) == 1) {
                        bảng i32["method_ascii:" + mã[j][2]] = đúng;
                    };
                };
            };
        };
    };
    bảng i32["số_lớp"] = số_lớp;
    nếu (!compiler) {
        lặp(số = 0; số <= 4; số++) {
            ids = [];
            lặp(i = 0; i < độ dài(các hàm); i++) {
                dạng = lấy từ điển(nhanh, "" + i, rỗng);
                nếu (dạng != rỗng) { nếu (độ dài(dạng["ô"]) == số) { máy ảo thêm cuối danh sách(ids, i); }; };
            };
            lặp(chế độ = 0; chế độ < 2; chế độ++) {
                máy chọn = biên dịch asm bộ chọn vô hộp(ids, nhanh, số, chế độ);
                phát = biên dịch mã máy hàm(đích["kiến trúc"], máy chọn, đích["hệ điều hành"]);
                hậu tố = "i"; nếu (chế độ == 1) { hậu tố = "m"; };
                máy ảo thêm cuối danh sách(phần, biên dịch lắp ráp mã máy(đích["kiến trúc"],
                    đích["hệ điều hành"], "vpp_aot_fast_" + hậu tố + số, phát, bảng byte, bảng hex));
            };
            máy chọn ô = biên dịch asm bộ chọn vô hộp(ids, nhanh, số, sai, đúng);
            phát ô = biên dịch mã máy hàm(đích["kiến trúc"], máy chọn ô, đích["hệ điều hành"]);
            máy ảo thêm cuối danh sách(phần, biên dịch lắp ráp mã máy(đích["kiến trúc"],
                đích["hệ điều hành"], "vpp_aot_fast_s" + số, phát ô, bảng byte, bảng hex));
        };
        ids ascii = [];
        lặp(i = 0; i < độ dài(các hàm); i++) {
            dạng = lấy từ điển(nhanh, "" + i, rỗng);
            // V++ hiện đánh giá cả hai vế &&. Tách kiểm tra rỗng để không gọi
            // lấy từ điển trên một hàm không có specialization.
            nếu (dạng != rỗng) {
                nếu (lấy từ điển(dạng, "ascii", sai) && độ dài(dạng["ô"]) == 1) {
                    máy ảo thêm cuối danh sách(ids ascii, i);
                };
            };
        };
        máy chọn ascii = biên dịch asm bộ chọn ascii chỉ số(ids ascii, nhanh);
        phát ascii = biên dịch mã máy hàm(đích["kiến trúc"], máy chọn ascii, đích["hệ điều hành"]);
        máy ảo thêm cuối danh sách(phần, biên dịch lắp ráp mã máy(đích["kiến trúc"],
            đích["hệ điều hành"], "vpp_aot_fast_ascii_index_m1", phát ascii, bảng byte, bảng hex));
    };
    biên dịch hồ sơ ghi(đường hồ sơ, "asm.fast_paths", bắt đầu);
    bắt đầu = biên dịch hồ sơ bắt đầu(đường hồ sơ);
    thống kê = rỗng;
    nếu (đường hồ sơ != "") {
        thống kê = {"lower_ms": 0, "machine_ms": 0, "assemble_ms": 0, "count": 0};
    };
    lặp(i = 0; i < độ dài(các hàm); i++) {
        hạ trước = 0; máy trước = 0; lắp ráp trước = 0;
        nếu (thống kê != rỗng) {
            hạ trước = thống kê["lower_ms"];
            máy trước = thống kê["machine_ms"];
            lắp ráp trước = thống kê["assemble_ms"];
        };
        máy ảo thêm cuối danh sách(phần, biên dịch asm thân(các hàm[i][2], "vpp_aot_function_" + i, đích, bảng, bảng i32, i, thống kê, bảng byte, bảng hex, bộ đệm));
        nếu (thống kê != rỗng) {
            tên = "<anonymous>";
            nếu (các hàm[i][1] >= 0) { tên = chuỗi[các hàm[i][1]]; };
            biên dịch hồ sơ ghi thân(đường hồ sơ, i, tên,
                thống kê["lower_ms"] - hạ trước,
                thống kê["machine_ms"] - máy trước,
                thống kê["assemble_ms"] - lắp ráp trước);
        };
    };
    lặp(i = 0; i < độ dài(khởi tạo); i++) {
        máy ảo thêm cuối danh sách(phần, biên dịch asm thân(khởi tạo[i][1], "vpp_aot_init_" + i, đích, bảng, bảng i32, -1, thống kê, bảng byte, bảng hex, bộ đệm));
    };
    máy ảo thêm cuối danh sách(phần, biên dịch asm thân(dây[0], "vpp_aot_entry", đích, bảng, bảng i32, -1, thống kê, bảng byte, bảng hex, bộ đệm));
    nếu (thống kê != rỗng) {
        biên dịch hồ sơ ghi số(đường hồ sơ, "asm.body.count", thống kê["count"]);
        biên dịch hồ sơ ghi số(đường hồ sơ, "asm.body.lower_ms", thống kê["lower_ms"]);
        biên dịch hồ sơ ghi số(đường hồ sơ, "asm.body.machine_ms", thống kê["machine_ms"]);
        biên dịch hồ sơ ghi số(đường hồ sơ, "asm.body.assemble_ms", thống kê["assemble_ms"]);
        nếu (bộ đệm != rỗng) {
            biên dịch hồ sơ ghi số(đường hồ sơ, "asm.cache.hits", bộ đệm["trúng"]);
            biên dịch hồ sơ ghi số(đường hồ sơ, "asm.cache.misses", bộ đệm["trượt"]);
            biên dịch hồ sơ ghi số(đường hồ sơ, "asm.cache.bytes", bộ đệm["byte"]);
        };
    };
    biên dịch hồ sơ ghi(đường hồ sơ, "asm.functions", bắt đầu);
    bắt đầu = biên dịch hồ sơ bắt đầu(đường hồ sơ);
    tiền tố = "";
    meta = ".section .data.rel.ro,\"aw\",@progbits\n";
    nếu (đích["hệ điều hành"] == "macos") { tiền tố = "_"; meta = ".section __DATA,__const\n"; };
    nếu (đích["hệ điều hành"] == "windows") { meta = ".section .rdata,\"dr\"\n"; };
    lặp(i = 0; i < độ dài(chuỗi); i++) {
        meta += ".Laot_string_" + i + ": .asciz " + biên dịch asm nháy(chuỗi[i]) + "\n";
        nếu (i % 32 == 31) { máy ảo thêm cuối danh sách(phần, meta); meta = ""; };
    };
    meta += ".p2align 3\n.Laot_strings:\n";
    lặp(i = 0; i < độ dài(chuỗi); i++) {
        meta += ".quad .Laot_string_" + i + "," + độ dài(chuỗi thành byte máy ảo(chuỗi[i])) + "\n";
        nếu (i % 32 == 31) { máy ảo thêm cuối danh sách(phần, meta); meta = ""; };
    };
    meta += ".p2align 3\n.Laot_functions:\n";
    lặp(i = 0; i < độ dài(các hàm); i++) {
        cần = 0; tối đa = 0;
        mã = các hàm[i][2];
        lặp(j = 0; j < độ dài(mã); j++) {
            tên = lấy từ điển(bảng, "" + mã[j][0], "");
            nếu ((tên == "OP_PARAM" || tên == "OP_PARAM_MAC_DINH") && mã[j][3] >= 0) {
                nếu (tối đa < mã[j][3] + 1) { tối đa = mã[j][3] + 1; };
                nếu (tên == "OP_PARAM" && cần < mã[j][3] + 1) { cần = mã[j][3] + 1; };
            };
        };
        meta += ".long " + các hàm[i][1] + "," + cần + "," + tối đa + ",0\n.quad " + tiền tố + "vpp_aot_function_" + i + "\n";
        nếu (i % 32 == 31) { máy ảo thêm cuối danh sách(phần, meta); meta = ""; };
    };
    meta += ".Laot_initializers:\n";
    lặp(i = 0; i < độ dài(khởi tạo); i++) { meta += ".quad " + tiền tố + "vpp_aot_init_" + i + "\n"; };
    lặp(i = 0; i < độ dài(ngoại); i++) {
        d = ngoại[i];
        meta += ".Laot_foreign_lib_" + i + ":.asciz " + biên dịch asm nháy(d[1]) + "\n.Laot_foreign_sym_" + i + ":.asciz " + biên dịch asm nháy(d[2]) +
            "\n.Laot_foreign_abi_" + i + ":.asciz " + biên dịch asm nháy(d[6]) + "\n.Laot_foreign_cap_" + i + ":.asciz " + biên dịch asm nháy(d[7]) +
            "\n.p2align 3\n.Laot_foreign_params_" + i + ":\n";
        lặp(j = 0; j < độ dài(d[3]); j++) { meta += ".long " + d[3][j] + "\n"; };
        meta += ".p2align 3\n.Laot_foreign_extents_" + i + ":\n";
        lặp(j = 0; j < độ dài(d[4]); j++) {
            e = d[4][j];
            meta += ".quad " + e[0] + "\n.long " + e[1] + ",0\n.quad " + e[2] + "\n";
        };
    };
    meta += ".p2align 3\n.Laot_foreign:\n";
    lặp(i = 0; i < độ dài(ngoại); i++) {
        d = ngoại[i];
        meta += ".long " + d[0] + "," + d[5] + "\n.quad .Laot_foreign_lib_" + i + ",.Laot_foreign_sym_" + i +
            ",.Laot_foreign_abi_" + i + ",.Laot_foreign_cap_" + i + "\n.quad " + độ dài(d[3]) + ",.Laot_foreign_params_" + i +
            "," + độ dài(d[4]) + ",.Laot_foreign_extents_" + i + "\n";
    };
    meta += ".p2align 3\n.Laot_i32_functions:\n";
    lặp(i = 0; i < độ dài(các hàm); i++) {
        dạng = lấy từ điển(nhanh, "" + i, rỗng);
        nếu (dạng == rỗng) {
            meta += ".quad 0\n.long 0,0\n";
        } hoặc nếu (lấy từ điển(dạng, "ascii", sai)) {
            meta += ".quad 0\n.long 0,0\n";
        } hoặc {
            meta += ".quad " + tiền tố + dạng["ký hiệu"] + "\n.long " +
                độ dài(dạng["ô"]) + "," + lấy từ điển(dạng, "dùng", 0) + "\n";
        };
    };
    cờ = 0;
    nếu (compiler) { cờ = 1; };
    meta += ".p2align 3\n" + tiền tố + "vpp_aot_spec:\n.quad " + độ dài(chuỗi) + ",.Laot_strings," + độ dài(các hàm) + ",.Laot_functions," +
        độ dài(khởi tạo) + ",.Laot_initializers," + tiền tố + "vpp_aot_entry\n.long " + cờ + ",1\n.quad " + độ dài(ngoại) + ",.Laot_foreign\n.quad " +
        độ dài(các hàm) + ",.Laot_i32_functions\n";
    máy ảo thêm cuối danh sách(phần, meta + "\n#define VPP_NATIVE_DYNAMIC_RUNTIME 1\n#include \"common/vpp_aot_dynamic_runtime.inc\"\n");
    kết quả = biên dịch lắp ráp nối các phần(phần);
    biên dịch hồ sơ ghi(đường hồ sơ, "asm.metadata", bắt đầu);
    trả về kết quả;
};
