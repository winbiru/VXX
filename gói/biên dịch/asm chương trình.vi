            };
            nếu (tên == "OP_TEN_BIEN_GIA_TRI" && i + 4 < độ dài(nguồn)) {
                nếu (mình.đích nhánh[i + 1] == 0 && mình.đích nhánh[i + 2] == 0 &&
                    mình.đích nhánh[i + 3] == 0 && mình.đích nhánh[i + 4] == 0) {
