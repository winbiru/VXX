                        (tên phải == "OP_TEN_BIEN_GIA_TRI" || tên phải == "OP_CHUOI") &&
                        (tên so == "OP_SO_SANH_BANG" || tên so == "OP_KHAC_BANG")) {
                        mặt nạ = 0; số = chỉ số[1];
                        nếu (tên chỉ số == "OP_TEN_BIEN_GIA_TRI") { mặt nạ += 1; số = chỉ số[2]; };
                        nếu (tên phải == "OP_TEN_BIEN_GIA_TRI") { mặt nạ += 2; };
                        nếu (tên so == "OP_KHAC_BANG") { mặt nạ += 4; };
                        mình.gọi("index_equal", [v[2], số, phải[2], mặt nạ]);
                        lặp(j = 0; j < 4; j++) { máy ảo thêm cuối danh sách(mình.vị trí, mình.vị trí[i]); };
                        i += 4; bỏ qua;
                    };
                };
            };
            // Đọc chỉ số trực tiếp từ ô biến, bỏ hai lần đẩy giá trị động.
            // Chỉ gộp khi không có nhánh vào giữa ba lệnh nguồn.
            nếu (tên == "OP_TEN_BIEN_GIA_TRI" && i + 5 < độ dài(nguồn)) {
                liền mạch = đúng;
                lặp(j = 1; j <= 5; j++) { nếu (mình.đích nhánh[i + j] != 0) { liền mạch = sai; }; };
                nếu (liền mạch) {
                    chỉ số = nguồn[i + 1]; đọc = nguồn[i + 2]; phải = nguồn[i + 3];
                    so = nguồn[i + 4]; lệnh nhảy = nguồn[i + 5];
                    tên chỉ số = lấy từ điển(mình.bảng, "" + chỉ số[0], "");
                    tên đọc = lấy từ điển(mình.bảng, "" + đọc[0], "");
                    tên phải = lấy từ điển(mình.bảng, "" + phải[0], "");
                    tên so = lấy từ điển(mình.bảng, "" + so[0], "");
                    tên nhảy = lấy từ điển(mình.bảng, "" + lệnh nhảy[0], "");
                    nếu ((tên chỉ số == "OP_TEN_BIEN_GIA_TRI" || tên chỉ số == "OP_BIEN_SO") &&
                        tên đọc == "OP_DOC_CHI_SO" && tên phải == "OP_BIEN_SO" &&
                        mình.phép so sánh gộp(tên so) && tên nhảy == "OP_JUMP_IF_FALSE") {
                        số = chỉ số[1]; là ô = 0;
                        nếu (tên chỉ số == "OP_TEN_BIEN_GIA_TRI") { số = chỉ số[2]; là ô = 1; };
                        mình.so sánh rồi nhảy("index_compare_integer",
                            [v[2], số, là ô, phải[1], so[0]], lệnh nhảy[1]);
                        lặp(j = 0; j < 5; j++) { máy ảo thêm cuối danh sách(mình.vị trí, mình.vị trí[i]); };
                        i += 5; bỏ qua;
                    };
                };
            };
            nếu (tên == "OP_TEN_BIEN_GIA_TRI" && i + 2 < độ dài(nguồn)) {
                nếu (mình.đích nhánh[i + 1] == 0 && mình.đích nhánh[i + 2] == 0) {
                    chỉ số = nguồn[i + 1]; đọc = nguồn[i + 2];
                    tên chỉ số = lấy từ điển(mình.bảng, "" + chỉ số[0], "");
                    tên đọc = lấy từ điển(mình.bảng, "" + đọc[0], "");
                    nếu (tên đọc == "OP_DOC_CHI_SO") {
                        nếu (tên chỉ số == "OP_TEN_BIEN_GIA_TRI") {
                            mình.gọi("index_slot", [v[2], chỉ số[2], 1]);
                        } hoặc nếu (tên chỉ số == "OP_BIEN_SO") {
