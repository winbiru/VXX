                        } hoặc nếu (tên chỉ số == "OP_CHUOI") {
                            mình.gọi("index_string_slot", [v[2], chỉ số[2]]);
                        };
                        nếu (tên chỉ số == "OP_TEN_BIEN_GIA_TRI" || tên chỉ số == "OP_BIEN_SO" ||
                            tên chỉ số == "OP_CHUOI") {
                            máy ảo thêm cuối danh sách(mình.vị trí, mình.vị trí[i]);
                            máy ảo thêm cuối danh sách(mình.vị trí, mình.vị trí[i]);
                            i += 2; bỏ qua;
                        };
                    };
                };
            };
            nếu (i >= mình.dự phòng đến && (tên == "OP_BIEN_SO" || tên == "OP_TEN_BIEN_GIA_TRI")) {
                cuối = mình.cuối biểu thức i32(i);
                nếu (cuối > i) { mình.phát biểu thức i32(i, cuối); };
            };
            nếu (tên == "OP_DIEU_KIEN") {
                vòng gọi = mình.vòng gập gọi i32(i);
                nếu (vòng gọi[0]) {
                    gói vòng = vòng gọi[7] * 65536 + vòng gọi[8];
                    mình.gọi thô("indirect_i32_fold_loop", [vòng gọi[1], vòng gọi[2],
                        vòng gọi[3], vòng gọi[4], vòng gọi[5], vòng gọi[6], gói vòng]);
                    mình.phát("StoreSlot", 0, 1);
                    mình.phát("Drop");
                    mình.phát("LoadSlot", 0, 1);
                    mình.phát("PushConstant", 2);
                    mình.phát("Equal");
                    hợp lệ vòng gọi = độ dài(mình.lệnh);
                    mình.phát("BranchZero");
                    máy ảo thêm cuối danh sách(mình.lỗi, độ dài(mình.lệnh));
                    mình.phát("Jump");
                    mình.lệnh[hợp lệ vòng gọi]["operand"] = độ dài(mình.lệnh);
                    mình.phát("LoadSlot", 0, 1);
                    máy ảo thêm cuối danh sách(mình.vá, [độ dài(mình.lệnh), vòng gọi[9]]);
                    mình.phát("BranchZero");
                    // Guard chỉ thử một lần. Nếu callee/kiểu không phù hợp,
                    // cạnh lùi của vòng đi thẳng vào bytecode gốc.
                    mình.vị trí[i] = độ dài(mình.lệnh);
                };
            };
            // Gọi trực tiếp với một hoặc hai hằng/ô biến: truyền đối số
            // dưới dạng i32 trong thanh ghi, không đẩy rồi lấy khỏi stack.
            // Chỉ gộp khi không có nhánh nhảy vào giữa chuỗi bytecode.
            nếu (tên == "OP_BIEN_SO" || tên == "OP_TEN_BIEN_GIA_TRI") {
                đầu = v[1]; mặt nạ = 0;
                nếu (tên == "OP_TEN_BIEN_GIA_TRI") { đầu = v[2]; mặt nạ = 1; };
                nếu (i + 1 < độ dài(nguồn)) {
                    sau = nguồn[i + 1];
                    tên sau = lấy từ điển(mình.bảng, "" + sau[0], "");
                    nếu (mình.đích nhánh[i + 1] == 0 && tên sau == "OP_GOI" && sau[1] == 1) {
                        mình.gọi("call_small", [sau[2], 1, đầu, 0, mặt nạ]);
                        máy ảo thêm cuối danh sách(mình.vị trí, mình.vị trí[i]);
                        i += 1; bỏ qua;
                    };
                };
                nếu (i + 2 < độ dài(nguồn)) {
                    giữa = nguồn[i + 1]; sau = nguồn[i + 2];
                    tên giữa = lấy từ điển(mình.bảng, "" + giữa[0], "");
                    tên sau = lấy từ điển(mình.bảng, "" + sau[0], "");
                    nếu (mình.đích nhánh[i + 1] == 0 && mình.đích nhánh[i + 2] == 0 &&
                        (tên giữa == "OP_BIEN_SO" || tên giữa == "OP_TEN_BIEN_GIA_TRI") &&
                        tên sau == "OP_GOI" && sau[1] == 2) {
                        thứ hai = giữa[1];
                        nếu (tên giữa == "OP_TEN_BIEN_GIA_TRI") { thứ hai = giữa[2]; mặt nạ += 2; };
                        mình.gọi("call_small", [sau[2], 2, đầu, thứ hai, mặt nạ]);
                        máy ảo thêm cuối danh sách(mình.vị trí, mình.vị trí[i]);
                        máy ảo thêm cuối danh sách(mình.vị trí, mình.vị trí[i]);
                        i += 2; bỏ qua;
                    };
                };
            };
            nếu (tên == "OP_DIEU_KIEN") {
                vòng dãy = mình.vòng dãy lọc tổng i32(i);
                nếu (vòng dãy[0]) {
                    // 0=đã tính xong, 1=chạy bytecode gốc, 2=bắt lỗi.
                    mình.gọi thô("range_mod_sum_i32_loop", [vòng dãy[1], vòng dãy[2],
                        vòng dãy[3], vòng dãy[4], vòng dãy[5]]);
                    mình.phát("StoreSlot", 0, 1);
                    mình.phát("Drop");
                    mình.phát("LoadSlot", 0, 1);
                    mình.phát("PushConstant", 2);
                    mình.phát("Equal");
                    thành công dãy = độ dài(mình.lệnh);
                    mình.phát("BranchZero");
                    máy ảo thêm cuối danh sách(mình.lỗi, độ dài(mình.lệnh));
                    mình.phát("Jump");
                    mình.lệnh[thành công dãy]["operand"] = độ dài(mình.lệnh);
                    mình.phát("LoadSlot", 0, 1);
                    máy ảo thêm cuối danh sách(mình.vá, [độ dài(mình.lệnh), vòng dãy[6]]);
                    mình.phát("BranchZero");
                };
                vòng danh sách = mình.vòng thêm danh sách(i);
                kiểu danh sách = "list_append_i32_loop";
                đối số danh sách = [];
                đích danh sách = -1;
                nếu (vòng danh sách[0]) {
                    đối số danh sách = [vòng danh sách[1], vòng danh sách[2],
                        vòng danh sách[3], vòng danh sách[4],
                        !mình.bỏ kết quả đếm(vòng danh sách[5])];
                    đích danh sách = vòng danh sách[5];
                } hoặc {
                    vòng danh sách = mình.vòng lọc tổng danh sách(i);
                    kiểu danh sách = "list_mod_sum_loop";
                    nếu (vòng danh sách[0]) {
                        đối số danh sách = [vòng danh sách[1], vòng danh sách[2],
                            vòng danh sách[3], vòng danh sách[4], vòng danh sách[5],
                            vòng danh sách[6], !mình.bỏ kết quả đếm(vòng danh sách[7])];
                        đích danh sách = vòng danh sách[7];
                    };
                };
                nếu (vòng danh sách[0]) {
                    // 0=đã chạy hết vòng, 1=quay lại bytecode, 2=bắt lỗi.
                    mình.gọi thô(kiểu danh sách, đối số danh sách);
                    mình.phát("StoreSlot", 0, 1);
                    mình.phát("Drop");
                    mình.phát("LoadSlot", 0, 1);
                    mình.phát("PushConstant", 2);
                    mình.phát("Equal");
                    thành công danh sách = độ dài(mình.lệnh);
                    mình.phát("BranchZero");
                    máy ảo thêm cuối danh sách(mình.lỗi, độ dài(mình.lệnh));
                    mình.phát("Jump");
                    mình.lệnh[thành công danh sách]["operand"] = độ dài(mình.lệnh);
                    mình.phát("LoadSlot", 0, 1);
                    máy ảo thêm cuối danh sách(mình.vá, [độ dài(mình.lệnh), đích danh sách]);
                    mình.phát("BranchZero");
                    mình.vị trí[i] = độ dài(mình.lệnh);
                };
            };
            nếu (tên == "OP_DIEU_KIEN") {
                vòng = mình.vòng đếm vô hộp(i);
                kiểu vòng = "counted_scalar_loop";
                nếu (!vòng[0]) {
                    vòng = mình.vòng đếm đơn giản(i);
                    kiểu vòng = "simple_scalar_loop";
                };
                nếu (!vòng[0]) {
                    vòng = mình.vòng đếm cộng hai biến(i);
                    kiểu vòng = "numeric_add_loop";
                };
                nếu (vòng[0]) {
                    nếu (mình.bỏ kết quả đếm(vòng[6])) { kiểu vòng += "_tail"; };
                    // 0=thành công, 1=quay lại bytecode, 2=bắt lỗi.
                    mình.gọi thô(kiểu vòng, [vòng[1], vòng[2], vòng[3], vòng[4], vòng[5]]);
                    mình.phát("StoreSlot", 0, 1);
                    mình.phát("Drop");
                    mình.phát("LoadSlot", 0, 1);
                    mình.phát("PushConstant", 2);
                    mình.phát("Equal");
                    thành công = độ dài(mình.lệnh);
                    mình.phát("BranchZero");
                    máy ảo thêm cuối danh sách(mình.lỗi, độ dài(mình.lệnh));
                    mình.phát("Jump");
                    mình.lệnh[thành công]["operand"] = độ dài(mình.lệnh);
                    mình.phát("LoadSlot", 0, 1);
                    máy ảo thêm cuối danh sách(mình.vá, [độ dài(mình.lệnh), vòng[6]]);
                    mình.phát("BranchZero");
                    // Nhánh quay lại luôn chạy bytecode gốc, tránh thử lại
                    // guard nếu giá trị đã đổi kiểu trong cùng một vòng.
                    mình.vị trí[i] = độ dài(mình.lệnh);
                };
            };
            nếu (tên == "OP_BIEN_SO" && i + 2 < độ dài(nguồn)) {
                nếu (mình.đích nhánh[i + 1] == 0 && mình.đích nhánh[i + 2] == 0) {
                    v2 = nguồn[i + 1]; v3 = nguồn[i + 2];
                    t2 = lấy từ điển(mình.bảng, "" + v2[0], "");
                    t3 = lấy từ điển(mình.bảng, "" + v3[0], "");
                    nếu (t2 == "OP_BIEN_SO") {
                        kết quả = mình.gập hằng i32(t3, v[1], v2[1]);
                        nếu (kết quả[0]) {
                            mình.gọi("integer", [kết quả[1]]);
                            máy ảo thêm cuối danh sách(mình.vị trí, mình.vị trí[i]);
                            máy ảo thêm cuối danh sách(mình.vị trí, mình.vị trí[i]);
                            i += 2; bỏ qua;
                        };
                    };
                };
            };
            // Khi biết đích gán và hằng i32, không tạo giá trị trung gian
            // trên stack. Các đích nhảy vào giữa phải giữ mã gốc.
            nếu (tên == "OP_BIEN_SO" && i + 2 < độ dài(nguồn)) {
                v2 = nguồn[i + 1]; v3 = nguồn[i + 2];
                nếu (mình.đích nhánh[i + 1] == 0 && mình.đích nhánh[i + 2] == 0 &&
                    lấy từ điển(mình.bảng, "" + v2[0], "") == "OP_TEN_BIEN_ID" &&
                    lấy từ điển(mình.bảng, "" + v3[0], "") == "OP_GAN") {
                    mình.gọi("store_integer", [v2[2], v[1]]);
                    máy ảo thêm cuối danh sách(mình.vị trí, mình.vị trí[i]);
                    máy ảo thêm cuối danh sách(mình.vị trí, mình.vị trí[i]);
                    i += 2; bỏ qua;
                };
            };
            // 0 - x; trả về: bỏ giá trị tạm và phép trừ động.
            nếu (tên == "OP_BIEN_SO" && v[1] == 0 && i + 3 < độ dài(nguồn)) {
                v2 = nguồn[i + 1]; v3 = nguồn[i + 2]; v4 = nguồn[i + 3];
                nếu (mình.đích nhánh[i + 1] == 0 && mình.đích nhánh[i + 2] == 0 &&
                    mình.đích nhánh[i + 3] == 0 &&
                    lấy từ điển(mình.bảng, "" + v2[0], "") == "OP_TEN_BIEN_GIA_TRI" &&
                    lấy từ điển(mình.bảng, "" + v3[0], "") == "OP_TRU" &&
                    lấy từ điển(mình.bảng, "" + v4[0], "") == "OP_TRA_VE") {
                    mình.gọi("return_negated_slot", [v2[2]]);
                    máy ảo thêm cuối danh sách(mình.trả, độ dài(mình.lệnh));
                    mình.phát("Jump");
                    lặp(j = 0; j < 3; j++) { máy ảo thêm cuối danh sách(mình.vị trí, mình.vị trí[i]); };
                    i += 3; bỏ qua;
                };
            };
            // V++ đánh giá cả hai vế &&, nên tách kiểm tra độ dài trước
            // khi đọc nguồn[i + 1] (kể cả khi i là lệnh cuối).
            nếu (tên == "OP_BIEN_SO" || tên == "OP_TEN_BIEN_GIA_TRI") {
              nếu (i + 1 < độ dài(nguồn)) {
                nếu (mình.đích nhánh[i + 1] == 0 &&
                    lấy từ điển(mình.bảng, "" + nguồn[i + 1][0], "") == "OP_TRA_VE") {
                    nếu (tên == "OP_BIEN_SO") {
                        mình.gọi("return_integer", [v[1]]);
                    } hoặc {
                        mình.gọi("return_slot", [v[2]]);
                    };
                    máy ảo thêm cuối danh sách(mình.trả, độ dài(mình.lệnh));
                    mình.phát("Jump");
                    máy ảo thêm cuối danh sách(mình.vị trí, mình.vị trí[i]);
                    i += 1; bỏ qua;
                };
              };
            };
            // Loop-carried scalar: x = x +/- hằng hoặc x = a op b.
            // Một ABI call thực hiện luôn phép toán và ghi ô nhớ; runtime
            // vẫn kiểm tra kiểu động và dùng đường dự phòng khi cần.
            nếu (tên == "OP_TEN_BIEN_GIA_TRI" && i + 4 < độ dài(nguồn)) {
                v2 = nguồn[i + 1]; v3 = nguồn[i + 2]; v4 = nguồn[i + 3]; v5 = nguồn[i + 4];
                t2 = lấy từ điển(mình.bảng, "" + v2[0], "");
                t3 = lấy từ điển(mình.bảng, "" + v3[0], "");
                t4 = lấy từ điển(mình.bảng, "" + v4[0], "");
                t5 = lấy từ điển(mình.bảng, "" + v5[0], "");
                nếu (mình.đích nhánh[i + 1] == 0 && mình.đích nhánh[i + 2] == 0 &&
                    mình.đích nhánh[i + 3] == 0 && mình.đích nhánh[i + 4] == 0 &&
                    mình.phép toán gộp(t3) && t4 == "OP_TEN_BIEN_ID" && t5 == "OP_GAN") {
                    nếu (t2 == "OP_BIEN_SO") {
                        mình.gọi("update_integer_slot", [v[2], v2[1], v3[0], v4[2]]);
                        lặp(j = 0; j < 4; j++) { máy ảo thêm cuối danh sách(mình.vị trí, mình.vị trí[i]); };
                        i += 4; bỏ qua;
                    };
                    nếu (t2 == "OP_TEN_BIEN_GIA_TRI") {
                        mình.gọi("update_numeric_slots", [v[2], v2[2], v3[0], v4[2]]);
                        lặp(j = 0; j < 4; j++) { máy ảo thêm cuối danh sách(mình.vị trí, mình.vị trí[i]); };
                        i += 4; bỏ qua;
                    };
                };
            };
            nếu (tên == "OP_TEN_BIEN_ID") {
              nếu (i + 1 < độ dài(nguồn)) {
                nếu (mình.đích nhánh[i + 1] == 0) {
                    t2 = lấy từ điển(mình.bảng, "" + nguồn[i + 1][0], "");
                    nếu (t2 == "OP_GAN") {
                        mình.gọi("assign_slot", [v[2]]);
                        máy ảo thêm cuối danh sách(mình.vị trí, mình.vị trí[i]);
                        i += 1; bỏ qua;
                    };
                    nếu (t2 == "OP_CONG_MOT" || t2 == "OP_TRU_MOT") {
                        delta = 1;
                        nếu (t2 == "OP_TRU_MOT") { delta = -1; };
                        mình.gọi("increment_slot", [v[2], delta]);
                        máy ảo thêm cuối danh sách(mình.vị trí, mình.vị trí[i]);
                        i += 1; bỏ qua;
                    };
                };
              };
            };
            // V++ đánh giá cả hai vế &&. Phải kiểm tra giới hạn trong
            // một khối riêng trước khi đọc ba phần tử kế tiếp.
            nếu (tên == "OP_TEN_BIEN_GIA_TRI" && i + 7 < độ dài(nguồn)) {
              hợp lệ = đúng;
              lặp(j = 1; j <= 7; j++) {
                  nếu (mình.đích nhánh[i + j] != 0) { hợp lệ = sai; };
              };
              nếu (hợp lệ) {
                v2 = nguồn[i + 1]; v3 = nguồn[i + 2]; v4 = nguồn[i + 3];
                v5 = nguồn[i + 4]; v6 = nguồn[i + 5]; v7 = nguồn[i + 6]; v8 = nguồn[i + 7];
                t2 = lấy từ điển(mình.bảng, "" + v2[0], "");
                t3 = lấy từ điển(mình.bảng, "" + v3[0], "");
                t4 = lấy từ điển(mình.bảng, "" + v4[0], "");
                t5 = lấy từ điển(mình.bảng, "" + v5[0], "");
                t6 = lấy từ điển(mình.bảng, "" + v6[0], "");
                t7 = lấy từ điển(mình.bảng, "" + v7[0], "");
                t8 = lấy từ điển(mình.bảng, "" + v8[0], "");
                nếu (t2 == "OP_BIEN_SO" && t3 == "OP_LON_HON_HOAC_BANG" &&
                    t4 == "OP_TEN_BIEN_GIA_TRI" && v4[2] == v[2] &&
                    t5 == "OP_BIEN_SO" && t6 == "OP_NHO_HON_HOAC_BANG" &&
                    t7 == "OP_Logic_VA" && t8 == "OP_JUMP_IF_FALSE") {
                    mình.so sánh rồi nhảy("compare_integer_range", [v[2], v2[1], v5[1]], v8[1]);
                    lặp(j = 0; j < 7; j++) { máy ảo thêm cuối danh sách(mình.vị trí, mình.vị trí[i]); };
                    i += 7; bỏ qua;
                };
              };
            };
            // Mẫu x < thấp || x > cao xuất hiện dày trong bộ phân tích số.
            // Đường dự phòng runtime vẫn đánh giá đủ hai vế theo ngữ nghĩa V++.
            nếu (tên == "OP_TEN_BIEN_GIA_TRI" && i + 7 < độ dài(nguồn)) {
              liền mạch = đúng;
              lặp(j = 1; j <= 7; j++) { nếu (mình.đích nhánh[i + j] != 0) { liền mạch = sai; }; };
              nếu (liền mạch) {
                v2 = nguồn[i + 1]; v3 = nguồn[i + 2]; v4 = nguồn[i + 3];
                v5 = nguồn[i + 4]; v6 = nguồn[i + 5]; v7 = nguồn[i + 6]; v8 = nguồn[i + 7];
                t2 = lấy từ điển(mình.bảng, "" + v2[0], "");
                t3 = lấy từ điển(mình.bảng, "" + v3[0], "");
                t4 = lấy từ điển(mình.bảng, "" + v4[0], "");
                t5 = lấy từ điển(mình.bảng, "" + v5[0], "");
                t6 = lấy từ điển(mình.bảng, "" + v6[0], "");
                t7 = lấy từ điển(mình.bảng, "" + v7[0], "");
                t8 = lấy từ điển(mình.bảng, "" + v8[0], "");
                nếu (t2 == "OP_BIEN_SO" && t3 == "OP_NHO_HON" &&
                    t4 == "OP_TEN_BIEN_GIA_TRI" && v4[2] == v[2] &&
