                        t5 == "OP_TEN_BIEN_GIA_TRI" && a5[2] == v[2] && cùng chỉ số &&
                        t7 == "OP_DOC_CHI_SO" && t8 == "OP_BIEN_SO" && t9 == "OP_LON_HON" &&
                        t10 == "OP_Logic_HOAC" && t11 == "OP_JUMP_IF_FALSE") {
                        số = a1[1]; là ô = 0;
                        nếu (t1 == "OP_TEN_BIEN_GIA_TRI") { số = a1[2]; là ô = 1; };
                        mình.so sánh rồi nhảy("index_compare_integer_outside_range",
                            [v[2], số, là ô, a3[1], a8[1]], a11[1]);
                        lặp(j = 0; j < 11; j++) { máy ảo thêm cuối danh sách(mình.vị trí, mình.vị trí[i]); };
                        i += 11; bỏ qua;
                    };
                };
            };
            // Gộp cùng một container[index] == a || container[index] == b.
            nếu (tên == "OP_TEN_BIEN_GIA_TRI" && i + 11 < độ dài(nguồn)) {
                liền mạch = đúng;
                lặp(j = 1; j <= 11; j++) { nếu (mình.đích nhánh[i + j] != 0) { liền mạch = sai; }; };
                nếu (liền mạch) {
                    a1 = nguồn[i + 1]; a2 = nguồn[i + 2]; a3 = nguồn[i + 3]; a4 = nguồn[i + 4];
                    a5 = nguồn[i + 5]; a6 = nguồn[i + 6]; a7 = nguồn[i + 7]; a8 = nguồn[i + 8];
                    a9 = nguồn[i + 9]; a10 = nguồn[i + 10]; a11 = nguồn[i + 11];
