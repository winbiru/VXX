    // lại nguyên bytecode từ đầu vòng.
    hàm riêng tư vòng gập gọi i32(từ) {
        nguồn = mình.nguồn;
        nếu (từ + 25 > độ dài(nguồn)) { trả về [sai]; };
        mẫu = ["OP_DIEU_KIEN", "OP_TEN_BIEN_GIA_TRI", "OP_TEN_BIEN_GIA_TRI", "OP_NHO_HON",
            "OP_JUMP_IF_FALSE", "OP_MO_KHOI", "OP_TEN_BIEN_GIA_TRI", "OP_TEN_BIEN_GIA_TRI",
            "OP_TEN_BIEN_GIA_TRI", "OP_BIEN_SO", "OP_MODULO", "OP_CONG",
            "OP_TEN_BIEN_GIA_TRI", "OP_TEN_BIEN_GIA_TRI", "OP_GOI_GIAN_TIEP", "OP_BIEN_SO",
            "OP_MODULO", "OP_CONG", "OP_TEN_BIEN_ID", "OP_GAN", "OP_DONG_KHOI", "OP_CAP_NHAT",
            "OP_TEN_BIEN_ID", "OP_CONG_MOT", "OP_JUMP"];
