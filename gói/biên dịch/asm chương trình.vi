                    nếu (t1 == "OP_TEN_BIEN_GIA_TRI" && t6 == "OP_TEN_BIEN_GIA_TRI" && a1[2] == a6[2]) { cùng chỉ số = đúng; };
                    nếu ((t1 == "OP_BIEN_SO" || t1 == "OP_TEN_BIEN_GIA_TRI") &&
                        t2 == "OP_DOC_CHI_SO" && t3 == "OP_BIEN_SO" && t4 == "OP_SO_SANH_BANG" &&
                        t5 == "OP_TEN_BIEN_GIA_TRI" && a5[2] == v[2] && cùng chỉ số &&
                        t7 == "OP_DOC_CHI_SO" && t8 == "OP_BIEN_SO" && t9 == "OP_SO_SANH_BANG" &&
                        t10 == "OP_Logic_HOAC" && t11 == "OP_JUMP_IF_FALSE") {
                        số = a1[1]; là ô = 0;
                        nếu (t1 == "OP_TEN_BIEN_GIA_TRI") { số = a1[2]; là ô = 1; };
                        mình.so sánh rồi nhảy("index_compare_integer_pair",
                            [v[2], số, là ô, a3[1], a8[1]], a11[1]);
                        lặp(j = 0; j < 11; j++) { máy ảo thêm cuối danh sách(mình.vị trí, mình.vị trí[i]); };
                        i += 11; bỏ qua;
                    };
