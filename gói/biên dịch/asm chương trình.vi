        tên = lấy từ điển(mình.bảng, "" + nguồn[i][0], "");
        sau = lấy từ điển(mình.bảng, "" + nguồn[i + 1][0], "");
        nếu ((tên != "OP_TEN_BIEN_GIA_TRI" && tên != "OP_BIEN_SO") ||
            sau != "OP_TRA_VE") { trả về sai; };
        lặp(j = đích + 1; j <= i + 1; j++) {
            nếu (mình.đích nhánh[j] != 0) { trả về sai; };
