                        tên chia == "OP_BIEN_SO" && tên modulo == "OP_MODULO" &&
                        tên phải == "OP_BIEN_SO" &&
                        (tên so == "OP_SO_SANH_BANG" || tên so == "OP_KHAC_BANG")) {
                        mặt nạ = 0; số = chỉ số[1];
                        nếu (tên chỉ số == "OP_TEN_BIEN_GIA_TRI") { mặt nạ += 1; số = chỉ số[2]; };
                        nếu (tên so == "OP_KHAC_BANG") { mặt nạ += 2; };
                        mình.gọi("index_mod_equal", [v[2], số, chia[1], phải[1], mặt nạ]);
                        lặp(j = 0; j < 6; j++) { máy ảo thêm cuối danh sách(mình.vị trí, mình.vị trí[i]); };
                        i += 6; bỏ qua;
                    };
                };
            };
            nếu (tên == "OP_TEN_BIEN_GIA_TRI" && i + 4 < độ dài(nguồn)) {
                // container[index] -> ô đích: giữ phần tử i32 ở dạng thô.
                // Mẫu này phải chạy trước index_slot + assign_slot để tránh
                // biến cục bộ quay lại đường giá trị động ngay trong parser.
                liền mạch = đúng;
                lặp(j = 1; j <= 4; j++) { nếu (mình.đích nhánh[i + j] != 0) { liền mạch = sai; }; };
                nếu (liền mạch) {
                    chỉ số = nguồn[i + 1]; đọc = nguồn[i + 2]; đích = nguồn[i + 3]; gán = nguồn[i + 4];
                    tên chỉ số = lấy từ điển(mình.bảng, "" + chỉ số[0], "");
                    tên đọc = lấy từ điển(mình.bảng, "" + đọc[0], "");
                    tên đích = lấy từ điển(mình.bảng, "" + đích[0], "");
                    tên gán = lấy từ điển(mình.bảng, "" + gán[0], "");
                    nếu ((tên chỉ số == "OP_TEN_BIEN_GIA_TRI" || tên chỉ số == "OP_BIEN_SO") &&
                        tên đọc == "OP_DOC_CHI_SO" && tên đích == "OP_TEN_BIEN_ID" && tên gán == "OP_GAN") {
                        số = chỉ số[1]; là ô = 0;
                        nếu (tên chỉ số == "OP_TEN_BIEN_GIA_TRI") { số = chỉ số[2]; là ô = 1; };
                        mình.gọi("index_store_slot", [v[2], số, là ô, đích[2]]);
                        lặp(j = 0; j < 4; j++) { máy ảo thêm cuối danh sách(mình.vị trí, mình.vị trí[i]); };
                        i += 4; bỏ qua;
                    };
                };
            };
            // container[index] = source op hằng: bỏ stack và binary động khi
            // source vẫn là i32; runtime giữ đường dự phòng cho kiểu động.
            nếu (tên == "OP_TEN_BIEN_GIA_TRI" && i + 5 < độ dài(nguồn)) {
                liền mạch = đúng;
                lặp(j = 1; j <= 5; j++) { nếu (mình.đích nhánh[i + j] != 0) { liền mạch = sai; }; };
                nếu (liền mạch) {
                    v2 = nguồn[i + 1]; v3 = nguồn[i + 2]; v4 = nguồn[i + 3];
                    v5 = nguồn[i + 4]; v6 = nguồn[i + 5];
                    t2 = lấy từ điển(mình.bảng, "" + v2[0], "");
                    t3 = lấy từ điển(mình.bảng, "" + v3[0], "");
                    t4 = lấy từ điển(mình.bảng, "" + v4[0], "");
                    t5 = lấy từ điển(mình.bảng, "" + v5[0], "");
                    t6 = lấy từ điển(mình.bảng, "" + v6[0], "");
                    nếu (t2 == "OP_BIEN_SO" && t3 == "OP_TEN_BIEN_GIA_TRI" &&
                        t4 == "OP_BIEN_SO" && mình.phép toán gộp(t5) &&
                        t6 == "OP_GAN_CHI_SO") {
                        mình.gọi("index_store_integer_op", [v[2], v2[1], v3[2], v4[1], v5[0]]);
                        lặp(j = 0; j < 5; j++) { máy ảo thêm cuối danh sách(mình.vị trí, mình.vị trí[i]); };
                        i += 5; bỏ qua;
                    };
                };
            };
            // Gộp cùng một container[index] < thấp || container[index] > cao.
            nếu (tên == "OP_TEN_BIEN_GIA_TRI" && i + 11 < độ dài(nguồn)) {
                liền mạch = đúng;
                lặp(j = 1; j <= 11; j++) { nếu (mình.đích nhánh[i + j] != 0) { liền mạch = sai; }; };
                nếu (liền mạch) {
                    a1 = nguồn[i + 1]; a2 = nguồn[i + 2]; a3 = nguồn[i + 3]; a4 = nguồn[i + 4];
                    a5 = nguồn[i + 5]; a6 = nguồn[i + 6]; a7 = nguồn[i + 7]; a8 = nguồn[i + 8];
                    a9 = nguồn[i + 9]; a10 = nguồn[i + 10]; a11 = nguồn[i + 11];
                    t1 = lấy từ điển(mình.bảng, "" + a1[0], "");
                    t2 = lấy từ điển(mình.bảng, "" + a2[0], "");
                    t3 = lấy từ điển(mình.bảng, "" + a3[0], "");
                    t4 = lấy từ điển(mình.bảng, "" + a4[0], "");
                    t5 = lấy từ điển(mình.bảng, "" + a5[0], "");
                    t6 = lấy từ điển(mình.bảng, "" + a6[0], "");
                    t7 = lấy từ điển(mình.bảng, "" + a7[0], "");
                    t8 = lấy từ điển(mình.bảng, "" + a8[0], "");
                    t9 = lấy từ điển(mình.bảng, "" + a9[0], "");
                    t10 = lấy từ điển(mình.bảng, "" + a10[0], "");
                    t11 = lấy từ điển(mình.bảng, "" + a11[0], "");
                    cùng chỉ số = sai;
                    nếu (t1 == "OP_BIEN_SO" && t6 == "OP_BIEN_SO" && a1[1] == a6[1]) { cùng chỉ số = đúng; };
                    nếu (t1 == "OP_TEN_BIEN_GIA_TRI" && t6 == "OP_TEN_BIEN_GIA_TRI" && a1[2] == a6[2]) { cùng chỉ số = đúng; };
                    nếu ((t1 == "OP_BIEN_SO" || t1 == "OP_TEN_BIEN_GIA_TRI") &&
