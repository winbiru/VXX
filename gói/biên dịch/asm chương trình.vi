            cuối += 1;
        };
        nếu (cuối >= độ dài(nguồn) || mình.đích nhánh[cuối] != 0 && cuối > từ) { trả về 0; };
        v = nguồn[cuối];
        nếu (lấy từ điển(mình.bảng, "" + v[0], "") != "OP_GOI" || v[1] != cuối - từ) { trả về 0; };
        dạng = lấy từ điển(mình.bảng i32, "" + v[2], rỗng);
        nếu (dạng == rỗng) { trả về 0; };
        nếu (độ dài(dạng["ô"]) != cuối - từ) { trả về 0; };
        dự phòng = [];
        đã kiểm = {};
        lặp(j = từ; j < cuối; j++) {
            nếu (lấy từ điển(mình.bảng, "" + nguồn[j][0], "") == "OP_TEN_BIEN_GIA_TRI") {
                nếu (nguồn[j][2] < 0) { trả về 0; };
                khóa = "" + nguồn[j][2];
                nếu (lấy từ điển(đã kiểm, khóa, 0) != 0) { bỏ qua; };
                đã kiểm[khóa] = 1;
                mình.gọi thô("is_i32", [nguồn[j][2]]);
                máy ảo thêm cuối danh sách(dự phòng, độ dài(mình.lệnh));
                mình.phát("BranchZero");
            };
        };
        lặp(j = từ; j < cuối; j++) {
            nếu (lấy từ điển(mình.bảng, "" + nguồn[j][0], "") == "OP_BIEN_SO") {
                mình.phát("PushConstant", nguồn[j][1]);
            } hoặc { mình.gọi thô("read_i32", [nguồn[j][2]]); };
        };
        mình.phát("Call", 0, cuối - từ, "vpp_aot_i32_" + v[2]);
        nếu (mình.số ô < 3) { mình.số ô = 3; };
        mình.phát("StoreSlot", 0, 2);
        mình.phát("Drop");
        mình.phát("LoadSlot", 0, 0);
        mình.phát("LoadSlot", 0, 2);
        mình.phát("Call", 0, 2, "vpp_native_dynamic_integer");
        thành công = độ dài(mình.lệnh); mình.phát("BranchZero");
        máy ảo thêm cuối danh sách(mình.lỗi, độ dài(mình.lệnh)); mình.phát("Jump");
        mình.lệnh[thành công]["operand"] = độ dài(mình.lệnh);
        nếu (độ dài(dự phòng) > 0) {
            bỏ chậm = độ dài(mình.lệnh); mình.phát("Jump");
            lặp(j = 0; j < độ dài(dự phòng); j++) {
                mình.lệnh[dự phòng[j]]["operand"] = độ dài(mình.lệnh);
            };
            số = cuối - từ;
            đối số = [0, 0, 0, 0];
            mặt nạ = 0;
            lặp(j = 0; j < số; j++) {
                nếu (lấy từ điển(mình.bảng, "" + nguồn[từ + j][0], "") == "OP_TEN_BIEN_GIA_TRI") {
                    mặt nạ += 1 << j;
                    đối số[j] = nguồn[từ + j][2];
                } hoặc { đối số[j] = nguồn[từ + j][1]; };
            };
            nếu (số <= 2) {
                mình.gọi("call_small", [v[2], số, đối số[0], đối số[1], mặt nạ]);
            } hoặc {
                mình.gọi("call_quad", [v[2], số, đối số[0], đối số[1], đối số[2], đối số[3], mặt nạ]);
            };
            mình.lệnh[bỏ chậm]["operand"] = độ dài(mình.lệnh);
        };
        lặp(j = từ + 1; j <= cuối; j++) { máy ảo thêm cuối danh sách(mình.vị trí, mình.vị trí[từ]); };
        trả về cuối - từ + 1;
    };
    // Nhận chuỗi hậu tố thuần, gồm cả lời gọi i32 lồng nhau. Chọn lời gọi
    // ngoài cùng có đủ đối số, không vượt điểm vào nhánh hoặc hàm chưa chứng minh.
    // Guard mọi ô trước khi đọc; đổi kiểu thì phát lại đúng thứ tự bytecode.
    hàm riêng tư gọi i32 biểu thức(từ) {
        nguồn = mình.nguồn;
        nếu (từ >= độ dài(nguồn)) { trả về 0; };
        tên đầu = lấy từ điển(mình.bảng, "" + nguồn[từ][0], "");
        nếu (tên đầu != "OP_BIEN_SO" && tên đầu != "OP_TEN_BIEN_GIA_TRI") {
            nếu (tên đầu != "OP_GOI" || nguồn[từ][1] != 0) { trả về 0; };
            đầu = lấy từ điển(mình.bảng i32, "" + nguồn[từ][2], rỗng);
            // Toán tử || của bytecode đánh giá cả hai phía: kiểm tra
            // giá trị rỗng riêng trước khi truy cập trường của hàm.
            nếu (đầu == rỗng) { trả về 0; };
            nếu (độ dài(đầu["ô"]) != 0) { trả về 0; };
        };
        cuối = từ; sâu = 0; phép = 0; ứng viên = -1;
        khi (cuối < độ dài(nguồn) && cuối < từ + 24) {
            nếu (cuối > từ && mình.đích nhánh[cuối] != 0) { thoát; };
            v = nguồn[cuối];
            tên = lấy từ điển(mình.bảng, "" + v[0], "");
            nếu (tên == "OP_BIEN_SO" || tên == "OP_TEN_BIEN_GIA_TRI") {
                nếu (tên == "OP_TEN_BIEN_GIA_TRI" && v[2] < 0) { thoát; };
                sâu += 1;
            } hoặc nếu (mình.phép i32 thuần(tên) != "" && sâu >= 2) {
                sâu -= 1; phép += 1;
            } hoặc nếu (tên == "OP_GOI" && v[1] >= 0 && v[1] <= 4) {
                con = lấy từ điển(mình.bảng i32, "" + v[2], rỗng);
                nếu (con == rỗng) { thoát; };
                nếu (độ dài(con["ô"]) != v[1] || sâu < v[1]) { thoát; };
                // Tiếp tục quét để ưu tiên lời gọi cha bao lấy các hàm con.
                nếu (sâu == v[1] && phép > 0) { ứng viên = cuối; };
                sâu = sâu - v[1] + 1;
                phép += 1;
            } hoặc { thoát; };
            nếu (sâu > 8) { trả về 0; };
            cuối += 1;
        };
        nếu (ứng viên < 0) { trả về 0; };
        cuối = ứng viên;
        lời gọi = nguồn[cuối];
        nếu (lấy từ điển(mình.bảng, "" + lời gọi[0], "") != "OP_GOI" ||
            lời gọi[1] < 0 || lời gọi[1] > 4) { trả về 0; };
        dạng = lấy từ điển(mình.bảng i32, "" + lời gọi[2], rỗng);
        nếu (dạng == rỗng) { trả về 0; };
        nếu (độ dài(dạng["ô"]) != lời gọi[1]) { trả về 0; };
        biến các ô = []; biến ô = {};
        lặp(j = từ; j < cuối; j++) {
            nếu (lấy từ điển(mình.bảng, "" + nguồn[j][0], "") == "OP_TEN_BIEN_GIA_TRI") {
                khóa = "" + nguồn[j][2];
                nếu (lấy từ điển(ô, khóa, -1) < 0) {
                    ô[khóa] = độ dài(các ô) + 2;
                    máy ảo thêm cuối danh sách(các ô, nguồn[j][2]);
                };
            };
        };
        // Ô sau cache dành riêng cho kết quả native trước khi đóng hộp.
        ô kết quả = độ dài(các ô) + 2;
        nếu (mình.số ô < ô kết quả + 1) { mình.số ô = ô kết quả + 1; };
        dự phòng = [];
        lặp(j = 0; j < độ dài(các ô); j++) {
            mình.gọi thô("is_i32", [các ô[j]]);
            máy ảo thêm cuối danh sách(dự phòng, độ dài(mình.lệnh));
            mình.phát("BranchZero");
        };
        // Một lần đọc cho mỗi biến; các lần dùng tiếp theo lấy ô máy.
        lặp(j = 0; j < độ dài(các ô); j++) {
            mình.gọi thô("read_i32", [các ô[j]]);
            mình.phát("StoreSlot", 0, j + 2);
            mình.phát("Drop");
        };
        lặp(j = từ; j < cuối; j++) {
            v = nguồn[j];
            tên = lấy từ điển(mình.bảng, "" + v[0], "");
            nếu (tên == "OP_BIEN_SO") { mình.phát("PushConstant", v[1]); }
            hoặc nếu (tên == "OP_TEN_BIEN_GIA_TRI") { mình.phát("LoadSlot", 0, ô["" + v[2]]); }
            hoặc nếu (tên == "OP_GOI") { mình.phát("Call", 0, v[1], "vpp_aot_i32_" + v[2]); }
            hoặc { mình.phát(mình.phép i32 thuần(tên)); };
        };
        mình.phát("Call", 0, lời gọi[1], "vpp_aot_i32_" + lời gọi[2]);
        mình.phát("StoreSlot", 0, ô kết quả); mình.phát("Drop");
        mình.phát("LoadSlot", 0, 0); mình.phát("LoadSlot", 0, ô kết quả);
        mình.phát("Call", 0, 2, "vpp_native_dynamic_integer");
        thành công = độ dài(mình.lệnh); mình.phát("BranchZero");
        máy ảo thêm cuối danh sách(mình.lỗi, độ dài(mình.lệnh)); mình.phát("Jump");
        mình.lệnh[thành công]["operand"] = độ dài(mình.lệnh);
        bỏ chậm = độ dài(mình.lệnh); mình.phát("Jump");
        lặp(j = 0; j < độ dài(dự phòng); j++) {
            mình.lệnh[dự phòng[j]]["operand"] = độ dài(mình.lệnh);
        };
        lặp(j = từ; j < cuối; j++) {
            v = nguồn[j];
            tên = lấy từ điển(mình.bảng, "" + v[0], "");
            nếu (tên == "OP_BIEN_SO") { mình.gọi("integer", [v[1]]); }
            hoặc nếu (tên == "OP_TEN_BIEN_GIA_TRI") { mình.gọi("load", [v[2]]); }
            hoặc nếu (tên == "OP_GOI") { mình.gọi("call", [v[2], v[1]]); }
            hoặc { mình.gọi("binary", [v[0]]); };
        };
        mình.gọi("call", [lời gọi[2], lời gọi[1]]);
        mình.lệnh[bỏ chậm]["operand"] = độ dài(mình.lệnh);
        lặp(j = từ + 1; j <= cuối; j++) {
            máy ảo thêm cuối danh sách(mình.vị trí, mình.vị trí[từ]);
        };
        trả về cuối - từ + 1;
    };
    hàm công khai hạ() {
        nguồn = mình.nguồn;
        mình.đánh dấu đích nhánh();
        lặp(i = 0; i < độ dài(nguồn); i++) {
            máy ảo thêm cuối danh sách(mình.vị trí, độ dài(mình.lệnh));
            v = nguồn[i];
            tên = lấy từ điển(mình.bảng, "" + v[0], "");
            đã gọi = mình.gọi phương thức riêng tư trực tiếp(i);
            nếu (đã gọi > 0) { i += đã gọi - 1; bỏ qua; };
            đã gọi = mình.gọi i32 biểu thức(i);
            nếu (đã gọi > 0) { i += đã gọi - 1; bỏ qua; };
            đã gọi = mình.gọi i32 trực tiếp(i);
            nếu (đã gọi > 0) { i += đã gọi - 1; bỏ qua; };
            nếu (tên == "OP_TEN_BIEN_GIA_TRI") {
                đã gọi = mình.gọi gián tiếp qua ô(i);
                nếu (đã gọi > 0) { i += đã gọi - 1; bỏ qua; };
            };
            // Gán từ ô sang ô không cần stack động hoặc đóng hộp i32.
            // Nhánh vào giữa ba lệnh vẫn chạy đúng từng lệnh nguồn.
            nếu (tên == "OP_TEN_BIEN_GIA_TRI" && i + 2 < độ dài(nguồn)) {
                đích gán = nguồn[i + 1]; phép gán = nguồn[i + 2];
                nếu (mình.đích nhánh[i + 1] == 0 && mình.đích nhánh[i + 2] == 0 &&
                    lấy từ điển(mình.bảng, "" + đích gán[0], "") == "OP_TEN_BIEN_ID" &&
                    lấy từ điển(mình.bảng, "" + phép gán[0], "") == "OP_GAN") {
                    mình.gọi("copy_slot", [v[2], đích gán[2]]);
                    máy ảo thêm cuối danh sách(mình.vị trí, mình.vị trí[i]);
                    máy ảo thêm cuối danh sách(mình.vị trí, mình.vị trí[i]);
                    i += 2; bỏ qua;
                };
            };
            // Gộp x = x op danh_sách[i], với op là cộng, trừ hoặc nhân.
            nếu (tên == "OP_TEN_BIEN_GIA_TRI" && i + 6 < độ dài(nguồn)) {
                liền mạch = đúng;
                lặp(j = 1; j <= 6; j++) { nếu (mình.đích nhánh[i + j] != 0) { liền mạch = sai; }; };
                nếu (liền mạch) {
                    v2 = nguồn[i + 1]; v3 = nguồn[i + 2]; v4 = nguồn[i + 3];
                    v5 = nguồn[i + 4]; v6 = nguồn[i + 5]; v7 = nguồn[i + 6];
                    phép = lấy từ điển(mình.bảng, "" + v5[0], "");
                    nếu (lấy từ điển(mình.bảng, "" + v2[0], "") == "OP_TEN_BIEN_GIA_TRI" &&
                        lấy từ điển(mình.bảng, "" + v3[0], "") == "OP_TEN_BIEN_GIA_TRI" &&
                        lấy từ điển(mình.bảng, "" + v4[0], "") == "OP_DOC_CHI_SO" &&
                        (phép == "OP_CONG" || phép == "OP_TRU" || phép == "OP_NHAN") &&
                        lấy từ điển(mình.bảng, "" + v6[0], "") == "OP_TEN_BIEN_ID" && v6[2] == v[2] &&
                        lấy từ điển(mình.bảng, "" + v7[0], "") == "OP_GAN") {
                        mình.gọi("index_update", [v[2], v2[2], v3[2], v5[0]]);
                        lặp(j = 0; j < 6; j++) { máy ảo thêm cuối danh sách(mình.vị trí, mình.vị trí[i]); };
                        i += 6; bỏ qua;
                    };
                };
            };
            // Gộp danh_sách, số_a, số_b, cộng, thêm_cuối thành một ABI.
            // Không gộp nếu một nhánh có thể đi vào giữa chuỗi bytecode.
            nếu (!lấy từ điển(mình.bảng i32, "compiler", sai) &&
                tên == "OP_TEN_BIEN_GIA_TRI" && i + 4 < độ dài(nguồn)) {
                nếu (mình.đích nhánh[i + 1] == 0 && mình.đích nhánh[i + 2] == 0 &&
                    mình.đích nhánh[i + 3] == 0 && mình.đích nhánh[i + 4] == 0) {
                    v2 = nguồn[i + 1]; v3 = nguồn[i + 2]; v4 = nguồn[i + 3]; v5 = nguồn[i + 4];
                    t2 = lấy từ điển(mình.bảng, "" + v2[0], "");
                    t3 = lấy từ điển(mình.bảng, "" + v3[0], "");
                    t4 = lấy từ điển(mình.bảng, "" + v4[0], "");
                    nếu (v[2] >= 0 && t2 == "OP_TEN_BIEN_GIA_TRI" &&
                        t3 == "OP_TEN_BIEN_GIA_TRI" && t4 == "OP_CONG" &&
                        v2[2] >= 0 && v3[2] >= 0 &&
                        v5[0] == biên dịch mã thao tác("OP_VM_LIST_APPEND")) {
                        mình.gọi("list_append_add", [v[2], v2[2], v3[2]]);
                        lặp(j = 0; j < 4; j++) {
                            máy ảo thêm cuối danh sách(mình.vị trí, mình.vị trí[i]);
                        };
                        i += 4; bỏ qua;
                    };
                };
            };
            // receiver.method(source[index]) với method một tham số đã được
            // chứng minh chỉ đọc một byte ASCII: giữ receiver trên stack,
            // đọc byte trực tiếp từ source/index và gọi hàm native vô hộp.
            // Nếu guard không khớp, chạy lại đúng đường index + method động.
            nếu (!lấy từ điển(mình.bảng i32, "compiler", sai) &&
                tên == "OP_TEN_BIEN_GIA_TRI" && i + 4 < độ dài(nguồn)) {
                liền mạch = đúng;
                lặp(j = 1; j <= 4; j++) { nếu (mình.đích nhánh[i + j] != 0) { liền mạch = sai; }; };
                nếu (liền mạch) {
                    nguồn chữ = nguồn[i + 1]; chỉ số chữ = nguồn[i + 2];
                    đọc chữ = nguồn[i + 3]; lệnh phương thức = nguồn[i + 4];
                    nếu (lấy từ điển(mình.bảng, "" + nguồn chữ[0], "") == "OP_TEN_BIEN_GIA_TRI" &&
                        lấy từ điển(mình.bảng, "" + chỉ số chữ[0], "") == "OP_TEN_BIEN_GIA_TRI" &&
                        lấy từ điển(mình.bảng, "" + đọc chữ[0], "") == "OP_DOC_CHI_SO" &&
                        lấy từ điển(mình.bảng, "" + lệnh phương thức[0], "") == "OP_GOI_PHUONG_THUC" &&
                        lệnh phương thức[1] == 1 &&
                        lấy từ điển(mình.bảng i32, "method_ascii:" + lệnh phương thức[2], sai)) {
                        // Đánh giá receiver trước source/index đúng thứ tự bytecode gốc.
                        mình.gọi("load", [v[2]]);
                        mình.phát("LoadSlot", 0, 0);
                        mình.phát("PushConstant", lệnh phương thức[2]);
                        mình.phát("PushConstant", lệnh phương thức[3]);
                        mình.phát("PushConstant", nguồn chữ[2]);
                        mình.phát("PushConstant", chỉ số chữ[2]);
                        mình.phát("Call", 0, 5, "vpp_aot_fast_ascii_index_m1");
                        mình.phát("StoreSlot", 0, 1); mình.phát("Drop");
                        mình.phát("LoadSlot", 0, 1);
                        chậm chữ = độ dài(mình.lệnh); mình.phát("BranchZero");
                        mình.phát("LoadSlot", 0, 1); mình.phát("PushConstant", 1); mình.phát("Equal");
                        máy ảo thêm cuối danh sách(mình.lỗi, độ dài(mình.lệnh)); mình.phát("BranchZero");
                        xong chữ = độ dài(mình.lệnh); mình.phát("Jump");
                        mình.lệnh[chậm chữ]["operand"] = độ dài(mình.lệnh);
                        // Receiver vẫn còn trên stack khi selector trả 0.
                        mình.gọi("index_slot", [nguồn chữ[2], chỉ số chữ[2], 1]);
                        mình.gọi("method", [lệnh phương thức[2], 1, lệnh phương thức[3]]);
                        mình.lệnh[xong chữ]["operand"] = độ dài(mình.lệnh);
                        lặp(j = 0; j < 4; j++) { máy ảo thêm cuối danh sách(mình.vị trí, mình.vị trí[i]); };
                        i += 4; bỏ qua;
                    };
                };
            };
            // So sánh ký tự ngay tại vùng UTF-8, tránh cấp phát chuỗi con.
            // Gộp luôn điều kiện lọc và phép cộng cùng phần tử. Mẫu này
            // xuất hiện ở vòng lọc danh sách nóng; không có điểm vào giữa
            // chuỗi và nhánh sai phải đi thẳng qua thân if.
            nếu (tên == "OP_TEN_BIEN_GIA_TRI" && i + 16 < độ dài(nguồn)) {
                liền mạch = đúng;
                lặp(j = 1; j <= 16; j++) { nếu (mình.đích nhánh[i + j] != 0) { liền mạch = sai; }; };
                nếu (liền mạch) {
                    chỉ số = nguồn[i + 1]; đọc = nguồn[i + 2]; chia = nguồn[i + 3];
                    modulo = nguồn[i + 4]; phải = nguồn[i + 5]; so = nguồn[i + 6]; lệnh rẽ = nguồn[i + 7];
                    mở = nguồn[i + 8]; đích = nguồn[i + 9]; nguồn lại = nguồn[i + 10];
                    chỉ số lại = nguồn[i + 11]; đọc lại = nguồn[i + 12]; cộng = nguồn[i + 13];
                    id đích = nguồn[i + 14]; gán = nguồn[i + 15]; đóng = nguồn[i + 16];
                    nếu (lấy từ điển(mình.bảng, "" + chỉ số[0], "") == "OP_TEN_BIEN_GIA_TRI" &&
                        lấy từ điển(mình.bảng, "" + đọc[0], "") == "OP_DOC_CHI_SO" &&
                        lấy từ điển(mình.bảng, "" + chia[0], "") == "OP_BIEN_SO" &&
                        lấy từ điển(mình.bảng, "" + modulo[0], "") == "OP_MODULO" &&
                        lấy từ điển(mình.bảng, "" + phải[0], "") == "OP_BIEN_SO" &&
                        lấy từ điển(mình.bảng, "" + so[0], "") == "OP_SO_SANH_BANG" &&
                        lấy từ điển(mình.bảng, "" + lệnh rẽ[0], "") == "OP_JUMP_IF_FALSE" && lệnh rẽ[1] == i + 17 &&
                        lấy từ điển(mình.bảng, "" + mở[0], "") == "OP_MO_KHOI" &&
                        lấy từ điển(mình.bảng, "" + đích[0], "") == "OP_TEN_BIEN_GIA_TRI" &&
                        lấy từ điển(mình.bảng, "" + nguồn lại[0], "") == "OP_TEN_BIEN_GIA_TRI" && nguồn lại[2] == v[2] &&
                        lấy từ điển(mình.bảng, "" + chỉ số lại[0], "") == "OP_TEN_BIEN_GIA_TRI" && chỉ số lại[2] == chỉ số[2] &&
                        lấy từ điển(mình.bảng, "" + đọc lại[0], "") == "OP_DOC_CHI_SO" &&
                        lấy từ điển(mình.bảng, "" + cộng[0], "") == "OP_CONG" &&
                        lấy từ điển(mình.bảng, "" + id đích[0], "") == "OP_TEN_BIEN_ID" && id đích[2] == đích[2] &&
                        lấy từ điển(mình.bảng, "" + gán[0], "") == "OP_GAN" &&
                        lấy từ điển(mình.bảng, "" + đóng[0], "") == "OP_DONG_KHOI") {
                        mình.gọi("index_mod_add_if_equal", [v[2], chỉ số[2], đích[2], chia[1], phải[1]]);
                        lặp(j = 0; j < 16; j++) { máy ảo thêm cuối danh sách(mình.vị trí, mình.vị trí[i]); };
                        i += 16; bỏ qua;
                    };
                };
            };
            // Gộp danh_sách[i] % hằng == hằng để không dựng giá trị modulo
            // và kết quả so sánh động trong vòng lặp lọc số nguyên.
            nếu (tên == "OP_TEN_BIEN_GIA_TRI" && i + 6 < độ dài(nguồn)) {
                liền mạch = đúng;
                lặp(j = 1; j <= 6; j++) { nếu (mình.đích nhánh[i + j] != 0) { liền mạch = sai; }; };
                nếu (liền mạch) {
                    chỉ số = nguồn[i + 1]; đọc = nguồn[i + 2]; chia = nguồn[i + 3];
                    modulo = nguồn[i + 4]; phải = nguồn[i + 5]; so = nguồn[i + 6];
                    tên chỉ số = lấy từ điển(mình.bảng, "" + chỉ số[0], "");
                    tên đọc = lấy từ điển(mình.bảng, "" + đọc[0], "");
                    tên chia = lấy từ điển(mình.bảng, "" + chia[0], "");
                    tên modulo = lấy từ điển(mình.bảng, "" + modulo[0], "");
                    tên phải = lấy từ điển(mình.bảng, "" + phải[0], "");
                    tên so = lấy từ điển(mình.bảng, "" + so[0], "");
                    nếu (tên đọc == "OP_DOC_CHI_SO" &&
