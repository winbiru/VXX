// Một nguồn, nhiều truy vấn; mỗi pass chỉ chạy khi cần kết quả của nó.
// Không gọi compiler snapshot C++; lexer/parser/IR/emitter đều là V++.
nhập gói.biên dịch.từ vựng.biên dịch từ tố hóa;
nhập gói.biên dịch.chương trình.Bộ Phân Tích Cú Pháp;
nhập gói.biên dịch.ngữ nghĩa.biên dịch kiểm tra ngữ nghĩa thuần;
nhập gói.biên dịch.biểu diễn trung gian.biên dịch hạ IR từ cây thuần;
nhập gói.biên dịch.phát mã.biên dịch phát mã trung gian từ IR thuần;

lớp công khai Bộ Biên Dịch Tự Chủ {
    hàm công khai khởi tạo(mã nguồn) { mình.làm mới(mã nguồn); };

    hàm công khai làm mới(mã nguồn) {
        nếu (loại của(mã nguồn) != "chuỗi") { ném "biên dịch từ vựng: mã nguồn phải là chuỗi"; };
        mình.nguồn = mã nguồn;
        mình.các từ tố = rỗng;
        mình.cây = rỗng;
        mình.đã kiểm tra = sai;
        mình.biểu diễn trung gian = rỗng;
        mình.mã = rỗng;
        trả về mình;
    };

    hàm công khai từ tố() {
        nếu (mình.các từ tố == rỗng) { mình.các từ tố = biên dịch từ tố hóa(mình.nguồn); };
        trả về mình.các từ tố;
    };

    hàm công khai cây cú pháp() {
        nếu (mình.cây == rỗng) {
            bộ = Bộ Phân Tích Cú Pháp(mình.nguồn, mình.từ tố());
            mình.cây = bộ.phân tích();
        };
        trả về mình.cây;
    };

    hàm công khai kiểm tra() {
        nếu (!mình.đã kiểm tra) {
            biên dịch kiểm tra ngữ nghĩa thuần(mình.cây cú pháp());
            mình.đã kiểm tra = đúng;
        };
        trả về đúng;
    };

    hàm công khai hạ IR() {
        nếu (mình.biểu diễn trung gian == rỗng) {
            mình.biểu diễn trung gian = biên dịch hạ IR từ cây thuần(mình.cây cú pháp(), sai);
            mình.đã kiểm tra = đúng;
        };
        trả về mình.biểu diễn trung gian;
    };

    hàm công khai mã trung gian() {
        nếu (mình.mã == rỗng) { mình.mã = biên dịch phát mã trung gian từ IR thuần(mình.hạ IR()); };
        trả về mình.mã;
    };
};
