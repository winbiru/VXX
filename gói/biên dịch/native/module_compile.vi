// Two-pass native module compilation.
// Every source unit is lexed and parsed separately. Pass 1 registers all
// function signatures; pass 2 lowers each body into its own IR segment.
// Registry entries: [i32 byte_length, i32 arity, UTF-8 name bytes].
// Function IDs and code sections remain in dependency-first module order.

// Read one packed source module, returning next archive offset.
hàm mc_read_unit(archive, offset, source) {
    nếu (offset < 0) { trả về -1; };
    nếu (offset + 4 > byte_dài(archive)) { trả về -1; };
    biến length = byte_đọc_i32(archive, offset);
    nếu (length <= 0) { trả về -1; };
    nếu (length > byte_dài(archive) - offset - 4) { trả về -1; };
    nếu (byte_làm_rỗng(source) != 0) { trả về -1; };
    lặp (i = offset + 4; i < offset + 4 + length; i++) {
        nếu (byte_thêm(source, byte_lấy(archive, i)) != 0) { trả về -1; };
    };
    trả về offset + 4 + length;
};

// The global registry predeclares all signatures before any body is parsed.
// entry is a single i32, initially -1, which tracks the unique main function.
hàm mc_collect_unit(src, tokens, registry, functions, entry) {
    lặp (i = 0; i < tok_count(tokens); i++) {
        nếu (tok_equals(src, tokens, i, "hàm") == 1) {
            biến arity = p_header_arity(src, tokens, i);
            nếu (arity < 0) { trả về -1; };
            nếu (p_registry_id(src, tokens, i + 1, registry) >= 0) { trả về -1; };
            biến start = tok_field(tokens, i + 1, 0);
            biến end = tok_field(tokens, i + 1, 1);
            biến length = end - start;
            nếu (length <= 0) { trả về -1; };
            nếu (byte_dài(functions) > 1048576 - 24) { trả về -1; };
            nếu (tok_equals(src, tokens, i + 1, "chính") == 1) {
                nếu (arity != 0) { trả về -1; };
                nếu (byte_đọc_i32(entry, 0) >= 0) { trả về -1; };
                biến id = 0;
                lặp (record = 0; record < byte_dài(functions); record = record + 24) {
                    id = id + 1;
                };
                nếu (byte_ghi_i32(entry, 0, id) != 0) { trả về -1; };
            };
            nếu (byte_đẩy_i32(registry, length) != 0) { trả về -1; };
            nếu (byte_đẩy_i32(registry, arity) != 0) { trả về -1; };
            lặp (j = start; j < end; j++) {
                nếu (byte_thêm(registry, byte_lấy(src, j)) != 0) { trả về -1; };
            };
            nếu (byte_đẩy_i32(functions, i) != 0) { trả về -1; };
            nếu (byte_đẩy_i32(functions, start) != 0) { trả về -1; };
            nếu (byte_đẩy_i32(functions, end) != 0) { trả về -1; };
            nếu (byte_đẩy_i32(functions, -1) != 0) { trả về -1; };
            nếu (byte_đẩy_i32(functions, -1) != 0) { trả về -1; };
            nếu (byte_đẩy_i32(functions, arity) != 0) { trả về -1; };
        };
    };
    trả về 0;
};

// Parse this module's bodies and attach their local IR to the program table.
// first_function is the global function ID of this module's first declaration.
hàm mc_compile_unit(src, tokens, registry, ir, functions, first_function) {
    biến cursor = 0;
    biến id = first_function;
    lặp (i = 0; i < tok_count(tokens); i++) {
        nếu (cursor == tok_count(tokens)) { trả về id; };
        nếu (id * 24 >= byte_dài(functions)) { trả về -1; };
        biến state = byte_mới();
        biến unit = byte_mới();
        nếu (state <= 0) { trả về -1; };
        nếu (unit <= 0) { byte_hủy(state); trả về -1; };
        biến status = 0;
        nếu (byte_đẩy_i32(state, cursor) != 0) { status = -1; };
        nếu (byte_đẩy_i32(state, 0) != 0) { status = -1; };
        nếu (byte_đẩy_i32(state, 0) != 0) { status = -1; };
        nếu (byte_đẩy_i32(state, 0) != 0) { status = -1; };
        nếu (byte_đẩy_i32(state, registry) != 0) { status = -1; };
        biến next = -1;
        nếu (status == 0) { next = pg_body(src, tokens, state, unit); };
        nếu (next <= cursor) { status = -1; };
        nếu (byte_dài(unit) <= 0) { status = -1; };
        nếu (status == 0) {
            biến begin = byte_dài(ir);
            nếu (byte_nối(ir, unit) != 0) { status = -1; }
            hoặc {
                nếu (byte_ghi_i32(functions, id * 24 + 12, begin) != 0) { status = -1; };
                nếu (byte_ghi_i32(functions, id * 24 + 16, byte_dài(unit)) != 0) { status = -1; };
            };
        };
        byte_hủy(state);
        byte_hủy(unit);
        nếu (status != 0) { trả về -1; };
        cursor = next;
        id = id + 1;
    };
    nếu (cursor != tok_count(tokens)) { trả về -1; };
    trả về id;
};

// Returns the unique main function ID + 1, or -1 on error.
// registry is returned in global function-ID order; module_ends contains the
// exclusive function-ID boundary of each source unit in archive order.
hàm mc_compile_modules(archive, ir, functions, registry, module_ends) {
    biến src = byte_mới();
    biến tokens = byte_mới();
    biến entry = byte_mới();
    biến status = 0;
    nếu (src <= 0) { status = -1; };
    nếu (tokens <= 0) { status = -1; };
    nếu (registry <= 0) { status = -1; };
    nếu (module_ends <= 0) { status = -1; };
    nếu (entry <= 0) { status = -1; };
    nếu (status == 0) {
        nếu (byte_làm_rỗng(ir) != 0) { status = -1; };
        nếu (byte_làm_rỗng(functions) != 0) { status = -1; };
        nếu (byte_làm_rỗng(registry) != 0) { status = -1; };
        nếu (byte_làm_rỗng(module_ends) != 0) { status = -1; };
        nếu (byte_đẩy_i32(entry, -1) != 0) { status = -1; };
    };
    biến offset = 0;
    nếu (status == 0) {
        lặp (i = 0; i < byte_dài(archive); i++) {
            nếu (offset == byte_dài(archive)) { thoát; };
            biến next_source = mc_read_unit(archive, offset, src);
            nếu (next_source < 0) { status = -1; thoát; };
            nếu (lex_tokenize(src, tokens) <= 0) { status = -1; thoát; };
            nếu (mc_collect_unit(src, tokens, registry, functions, entry) != 0) {
                status = -1;
                thoát;
            };
            biến registered_count = 0;
            lặp (record = 0; record < byte_dài(functions); record = record + 24) {
                registered_count = registered_count + 1;
            };
            nếu (byte_đẩy_i32(module_ends, registered_count) != 0) {
                status = -1;
                thoát;
            };
            offset = next_source;
        };
    };
    nếu (status == 0) {
        nếu (offset != byte_dài(archive)) { status = -1; };
        nếu (byte_đọc_i32(entry, 0) < 0) { status = -1; };
    };
    biến function_id = 0;
    biến module_index = 0;
    offset = 0;
    nếu (status == 0) {
        lặp (i = 0; i < byte_dài(archive); i++) {
            nếu (offset == byte_dài(archive)) { thoát; };
            biến next_code = mc_read_unit(archive, offset, src);
            nếu (next_code < 0) { status = -1; thoát; };
            biến last = byte_đọc_i32(module_ends, module_index);
            function_id = nc_compile_unit(src, tokens, registry, ir, functions,
                function_id, last, byte_đọc_i32(entry, 0));
            nếu (function_id < 0) { status = -1; thoát; };
            nếu (function_id != last) { status = -1; thoát; };
            module_index = module_index + 4;
            offset = next_code;
        };
    };
    nếu (status == 0) {
        nếu (offset != byte_dài(archive)) { status = -1; };
        nếu (function_id * 24 != byte_dài(functions)) { status = -1; };
    };
    biến result = -1;
    nếu (status == 0) { result = byte_đọc_i32(entry, 0) + 1; };
    nếu (src > 0) { byte_hủy(src); };
    nếu (tokens > 0) { byte_hủy(tokens); };
    nếu (entry > 0) { byte_hủy(entry); };
    nếu (result < 0) {
        byte_làm_rỗng(ir);
        byte_làm_rỗng(functions);
        byte_làm_rỗng(registry);
        byte_làm_rỗng(module_ends);
    };
    trả về result;
};
