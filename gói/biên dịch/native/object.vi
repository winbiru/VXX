hàm obj_i32(out, value) {
    trả về byte_đẩy_i32(out, value);
};

hàm obj_u64(out, low) {
    nếu (obj_i32(out, low) != 0) { trả về -1; };
    trả về obj_i32(out, 0);
};

// Consumes the given UTF-8 string handle; names in this writer are ASCII.
hàm obj_name(out, name, width) {
    biến n = byte_dài(name);
    nếu (n < 0) { byte_hủy(name); trả về -1; };
    nếu (n > width) { byte_hủy(name); trả về -1; };
    biến result = 0;
    lặp (i = 0; i < width; i++) {
        biến ch = 0;
        nếu (i < n) { ch = byte_lấy(name, i); };
        nếu (byte_thêm(out, ch) != 0) { result = -1; thoát; };
    };
    byte_hủy(name);
    trả về result;
};

hàm obj_pad(out, target) {
    lặp (i = byte_dài(out); i < target; i++) {
        nếu (byte_thêm(out, 0) != 0) { trả về -1; };
    };
    trả về 0;
};

// Closed runtime symbol table; indexes must agree with p_native_id.
hàm obj_native_name(id) {
    nếu (id == 0) { trả về "_vpp_native_bytes_new"; };
    nếu (id == 1) { trả về "_vpp_native_bytes_length"; };
    nếu (id == 2) { trả về "_vpp_native_bytes_get"; };
    nếu (id == 3) { trả về "_vpp_native_bytes_append"; };
    nếu (id == 4) { trả về "_vpp_native_bytes_push_i32"; };
    nếu (id == 5) { trả về "_vpp_native_bytes_load_i32"; };
    nếu (id == 6) { trả về "_vpp_native_bytes_store_i32"; };
    nếu (id == 7) { trả về "_vpp_native_bytes_clear"; };
    nếu (id == 8) { trả về "_vpp_native_bytes_concat"; };
    nếu (id == 9) { trả về "_vpp_native_bytes_equal"; };
    nếu (id == 10) { trả về "_vpp_native_bytes_free"; };
    nếu (id == 11) { trả về "_vpp_native_argc"; };
    nếu (id == 12) { trả về "_vpp_native_argv"; };
    nếu (id == 13) { trả về "_vpp_native_file_open_read"; };
    nếu (id == 14) { trả về "_vpp_native_file_read_block"; };
    nếu (id == 15) { trả về "_vpp_native_file_close"; };
    nếu (id == 16) { trả về "_vpp_native_link_macho"; };
    nếu (id == 17) { trả về "_vpp_native_link_macho_modules"; };
    nếu (id == 18) { trả về "_vpp_native_cache_read"; };
    nếu (id == 19) { trả về "_vpp_native_cache_write"; };
    nếu (id == 20) { trả về "_vpp_native_bytes_slice"; };
    nếu (id == 21) { trả về "_vpp_native_bytes_find"; };
    nếu (id == 22) { trả về "_vpp_native_bytes_print"; };
    nếu (id == 23) { trả về "_vpp_native_file_open_write"; };
    nếu (id == 24) { trả về "_vpp_native_file_write_block"; };
    nếu (id == 25) { trả về "_vpp_native_memory_read_byte"; };
    nếu (id == 26) { trả về "_vpp_native_memory_write_byte"; };
    nếu (id == 27) { trả về "_vpp_native_memory_read_i32"; };
    nếu (id == 28) { trả về "_vpp_native_memory_write_i32"; };
    nếu (id == 29) { trả về "_vpp_native_memory_bind"; };
    nếu (id == 30) { trả về "_vpp_native_os_open"; };
    nếu (id == 31) { trả về "_vpp_native_os_read"; };
    nếu (id == 32) { trả về "_vpp_native_os_write"; };
    nếu (id == 33) { trả về "_vpp_native_os_close"; };
    nếu (id == 34) { trả về "_vpp_native_os_errno"; };
    nếu (id == 35) { trả về "_vpp_native_os_argument_length"; };
    nếu (id == 36) { trả về "_vpp_native_os_argument_byte"; };
    nếu (id == 37) { trả về "_vpp_native_i32_div"; };
    nếu (id == 38) { trả về "_vpp_native_runtime_module_path"; };
    nếu (id == 39) { trả về "_vpp_native_print_i32"; };
    nếu (id == 40) { trả về "_vpp_native_read_i32"; };
    nếu (id == 41) { trả về "_vpp_native_read_status"; };
    nếu (id == 42) { trả về "_vpp_native_file_read_byte"; };
    nếu (id == 43) { trả về "_vpp_native_file_write_byte"; };
    nếu (id == 44) { trả về "_vpp_native_os_home"; };
    nếu (id == 45) { trả về "_vpp_native_os_cwd"; };
    nếu (id == 46) { trả về "_vpp_native_os_mkstemp"; };
    nếu (id == 47) { trả về "_vpp_native_os_rename"; };
    nếu (id == 48) { trả về "_vpp_native_os_spawn_clang"; };
    nếu (id == 49) { trả về "_vpp_native_os_waitpid"; };
    nếu (id == 50) { trả về "_vpp_native_os_stat"; };
    nếu (id == 51) { trả về "_vpp_native_os_lstat"; };
    nếu (id == 52) { trả về "_vpp_native_os_access_exec"; };
    nếu (id == 53) { trả về "_vpp_native_os_unlink"; };
