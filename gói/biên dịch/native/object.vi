    nếu (id == 55) { trả về "_vpp_native_os_executable_path"; };
    nếu (id == 56) { trả về "_vpp_native_os_mkdir"; };
    nếu (id == 57) { trả về "_vpp_native_os_fstat"; };
    nếu (id == 58) { trả về "_vpp_native_sha_begin"; };
    nếu (id == 59) { trả về "_vpp_native_sha_update"; };
    nếu (id == 60) { trả về "_vpp_native_sha_end"; };
    nếu (id == 61) { trả về "_vpp_native_os_register_cache_report"; };
    trả về "";
};

hàm obj_native_used(external_calls, id) {
    nếu (external_calls <= 0) { trả về 0; };
    lặp (off = 0; off < byte_dài(external_calls); off = off + 8) {
        nếu (byte_đọc_i32(external_calls, off + 4) == id) { trả về 1; };
    };
    trả về 0;
};

hàm obj_native_index(external_calls, id) {
    biến index = 1; // _main occupies symbol index 0.
    lặp (i = 0; i < id; i++) {
        nếu (obj_native_used(external_calls, i) == 1) { index = index + 1; };
    };
    trả về index;
};

// Returns byte length, or -1 with output cleared. One owned code buffer and
// a separate output buffer are required. Mach-O layout uses offsets relative
// to the beginning of the object (the linker's ordinary MH_OBJECT contract).
hàm obj_macho_arm64_at(code, object, entry_offset, external_calls) {
    nếu (code == object) { trả về -1; };
    nếu (byte_dài(object) < 0) { trả về -1; };
    nếu (byte_làm_rỗng(object) != 0) { trả về -1; };
    biến n = byte_dài(code);
    nếu (n <= 0) { trả về -1; };
    nếu (n > 1048200) { trả về -1; };
    nếu (entry_offset < 0) { trả về -1; };
    nếu (entry_offset >= n) { trả về -1; };
    lặp (i = 0; i < entry_offset; i = i + 4) {
        nếu (i + 4 > entry_offset) { trả về -1; };
    };
    lặp (i = 0; i < n; i = i + 4) { nếu (i + 4 > n) { trả về -1; }; };
    biến reloc_count = 0;
    nếu (external_calls > 0) {
        nếu (byte_dài(external_calls) < 0) { trả về -1; };
        lặp (i = 0; i < byte_dài(external_calls); i = i + 8) {
            nếu (i + 8 > byte_dài(external_calls)) { trả về -1; };
            biến checked_offset = byte_đọc_i32(external_calls, i);
            biến checked_id = byte_đọc_i32(external_calls, i + 4);
            nếu (checked_offset < 0) { trả về -1; };
            nếu (checked_offset + 4 > n) { trả về -1; };
            nếu (checked_id < 0) { trả về -1; };
            nếu (checked_id > 61) { trả về -1; };
            reloc_count = reloc_count + 1;
        };
    };
    biến symbols = 1;
    biến string_size = 7; // \0_main\0
    lặp (id = 0; id < 62; id++) {
        nếu (obj_native_used(external_calls, id) == 1) {
            biến symbol_name = obj_native_name(id);
            string_size = string_size + byte_dài(symbol_name) + 1;
            byte_hủy(symbol_name);
            symbols = symbols + 1;
        };
    };
    biến reloc_offset = 208;
    lặp (i = 0; i < n; i = i + 8) { reloc_offset = reloc_offset + 8; };
    biến symoff = reloc_offset + reloc_count * 8;
    biến stroff = symoff + symbols * 16;
    nếu (stroff + string_size > 1048576) { trả về -1; };

    // mach_header_64: MH_MAGIC_64, CPU_TYPE_ARM64, subtype ALL, MH_OBJECT.
    obj_i32(object, -17958193);
    obj_i32(object, 16777228);
    obj_i32(object, 0);
    obj_i32(object, 1);
    obj_i32(object, 2);     // ncmds
    obj_i32(object, 176);   // sizeofcmds
    obj_i32(object, 0);
    obj_i32(object, 0);

    // segment_command_64 (72 bytes), with one section_64 (80 bytes).
    obj_i32(object, 25);   // LC_SEGMENT_64
    obj_i32(object, 152);
    nếu (obj_name(object, "", 16) != 0) { byte_làm_rỗng(object); trả về -1; };
    obj_u64(object, 0);     // vmaddr
    obj_u64(object, n);     // vmsize
    obj_u64(object, 208);   // fileoff
    obj_u64(object, n);     // filesize
    obj_i32(object, 7);     // maxprot RWX
    obj_i32(object, 5);     // initprot RX
    obj_i32(object, 1);     // nsects
    obj_i32(object, 0);

    nếu (obj_name(object, "__text", 16) != 0) { byte_làm_rỗng(object); trả về -1; };
    nếu (obj_name(object, "__TEXT", 16) != 0) { byte_làm_rỗng(object); trả về -1; };
    obj_u64(object, 0);     // addr
    obj_u64(object, n);     // size
    obj_i32(object, 208);   // offset
    obj_i32(object, 2);     // align 2**2
    nếu (reloc_count > 0) { obj_i32(object, reloc_offset); }
    hoặc { obj_i32(object, 0); };
    obj_i32(object, reloc_count);
    obj_i32(object, -2147482624); // S_REGULAR | PURE_INSTRUCTIONS | SOME_INSTRUCTIONS
    obj_i32(object, 0);
    obj_i32(object, 0);
    obj_i32(object, 0);

    // symtab_command (24 bytes).
    obj_i32(object, 2);     // LC_SYMTAB
    obj_i32(object, 24);
    obj_i32(object, symoff);
    obj_i32(object, symbols);
    obj_i32(object, stroff);
    obj_i32(object, string_size);

    nếu (byte_dài(object) != 208) { byte_làm_rỗng(object); trả về -1; };
    nếu (byte_nối(object, code) != 0) { byte_làm_rỗng(object); trả về -1; };
    nếu (obj_pad(object, reloc_offset) != 0) { byte_làm_rỗng(object); trả về -1; };
    // ARM64_RELOC_BRANCH26 (type 2, pcrel 1, length 2, extern 1).
    lặp (i = 0; i < reloc_count * 8; i = i + 8) {
        biến off = byte_đọc_i32(external_calls, i);
        biến id = byte_đọc_i32(external_calls, i + 4);
        nếu (obj_i32(object, off) != 0) { byte_làm_rỗng(object); trả về -1; };
        nếu (obj_i32(object, 754974720 + obj_native_index(external_calls, id)) != 0) {
            byte_làm_rỗng(object); trả về -1;
        };
    };
    nếu (obj_pad(object, symoff) != 0) { byte_làm_rỗng(object); trả về -1; };
    // nlist_64: strx, N_SECT|N_EXT, section index, desc, value.
    obj_i32(object, 1);
    byte_thêm(object, 15);
    byte_thêm(object, 1);
    byte_thêm(object, 0);
    byte_thêm(object, 0);
    obj_u64(object, entry_offset);
    // N_UNDF | N_EXT symbols for the linked native runtime.
    biến strx = 7;
    lặp (id = 0; id < 62; id++) {
        nếu (obj_native_used(external_calls, id) == 1) {
            biến record_name = obj_native_name(id);
            biến record_size = byte_dài(record_name);
            obj_i32(object, strx);
            byte_thêm(object, 1);
            byte_thêm(object, 0);
            byte_thêm(object, 0);
            byte_thêm(object, 0);
            obj_u64(object, 0);
            strx = strx + record_size + 1;
            byte_hủy(record_name);
        };
    };
    byte_thêm(object, 0);
    nếu (obj_name(object, "_main", 5) != 0) { byte_làm_rỗng(object); trả về -1; };
    byte_thêm(object, 0);
    lặp (id = 0; id < 62; id++) {
        nếu (obj_native_used(external_calls, id) == 1) {
            biến name = obj_native_name(id);
            biến size = byte_dài(name);
            nếu (obj_name(object, name, size) != 0) { byte_làm_rỗng(object); trả về -1; };
            nếu (byte_thêm(object, 0) != 0) { byte_làm_rỗng(object); trả về -1; };
        };
    };
    nếu (byte_dài(object) != stroff + string_size) {
        byte_làm_rỗng(object);
        trả về -1;
    };
    trả về byte_dài(object);
};

// Preserve the original entry-at-zero API for standalone codegen fixtures.
hàm obj_macho_arm64(code, object) {
    trả về obj_macho_arm64_at(code, object, 0, 0);
};

// Executable compiled from V++ source. Only the initial build uses Stage 0.
// The file -> frontend -> i32 IR -> ARM64 machine code -> Mach-O path below
// executes entirely inside the native V++ executable.
