// Link CALL instructions inside one Mach-O __text section. The only public
// symbol is _main, which may occur at any declaration-order function ID.
hàm cgp_patch_calls(code, starts, relocations, external_calls) {
    biến count = byte_dài(starts);
    lặp (i = 0; i < byte_dài(relocations); i = i + 8) {
        biến from = byte_đọc_i32(relocations, i);
        biến fn = byte_đọc_i32(relocations, i + 4);
        nếu (from < 0) { trả về -1; };
        nếu (from + 4 > byte_dài(code)) { trả về -1; };
        nếu (fn < 0) {
            nếu (fn < -62) { trả về -1; };
            nếu (byte_đẩy_i32(external_calls, from) != 0) { trả về -1; };
            nếu (byte_đẩy_i32(external_calls, -fn - 1) != 0) { trả về -1; };
            bỏ qua;
        };
        nếu (fn * 4 >= count) { trả về -1; };
        biến to = byte_đọc_i32(starts, fn * 4);
        biến delta = 0;
        lặp (pos = from; pos < to; pos = pos + 4) { delta = delta + 1; };
        lặp (pos = from; pos > to; pos = pos - 4) { delta = delta - 1; };
        nếu (delta < -33554432) { trả về -1; };
        nếu (delta > 33554431) { trả về -1; };
        nếu (delta < 0) { delta = delta + 67108864; };
        nếu (byte_ghi_i32(code, from, -1811939328 + delta) != 0) { trả về -1; };
    };
    trả về 0;
};

// Concatenates independently validated function machine-code bodies.
// Function IR branch offsets remain local; BL targets are patched globally.
// Returns the _main byte offset + 1 (zero on failure is therefore reserved).
hàm cgp_emit_entry(ir, functions, code, entry_id, external_calls) {
    nếu (code == ir) { trả về -1; };
    nếu (code == functions) { trả về -1; };
    nếu (byte_làm_rỗng(code) != 0) { trả về -1; };
    nếu (byte_làm_rỗng(external_calls) != 0) { trả về -1; };
    biến table_size = byte_dài(functions);
    nếu (table_size < 24) { trả về -1; };
    biến starts = byte_mới();
    biến relocations = byte_mới();
    biến unit = byte_mới();
    biến machine = byte_mới();
    biến calls = byte_mới();
    biến status = 0;
    biến entry_offset = -1;
    nếu (starts <= 0) { status = -1; };
    nếu (relocations <= 0) { status = -1; };
    nếu (unit <= 0) { status = -1; };
    nếu (machine <= 0) { status = -1; };
    nếu (calls <= 0) { status = -1; };
    nếu (status == 0) {
        biến next_ir = 0;
        lặp (record = 0; record < table_size; record = record + 24) {
            nếu (record + 24 > table_size) { status = -1; thoát; };
            biến ir_start = byte_đọc_i32(functions, record + 12);
            biến ir_size = byte_đọc_i32(functions, record + 16);
            nếu (ir_start != next_ir) { status = -1; thoát; };
            nếu (ir_size < 8) { status = -1; thoát; };
            nếu (ir_start + ir_size > byte_dài(ir)) { status = -1; thoát; };
            nếu (byte_làm_rỗng(unit) != 0) { status = -1; thoát; };
            nếu (byte_làm_rỗng(calls) != 0) { status = -1; thoát; };
            lặp (off = ir_start; off < ir_start + ir_size; off = off + 1) {
                nếu (byte_thêm(unit, byte_lấy(ir, off)) != 0) { status = -1; thoát; };
            };
            nếu (status < 0) { thoát; };
            biến start = byte_dài(code);
            nếu (byte_đẩy_i32(starts, start) != 0) { status = -1; thoát; };
            nếu (cg_emit_internal(unit, machine, calls) <= 0) { status = -1; thoát; };
            lặp (offset = 0; offset < byte_dài(calls); offset = offset + 8) {
                nếu (byte_đẩy_i32(relocations, start + byte_đọc_i32(calls, offset)) != 0) { status = -1; thoát; };
                nếu (byte_đẩy_i32(relocations, byte_đọc_i32(calls, offset + 4)) != 0) { status = -1; thoát; };
            };
            nếu (status < 0) { thoát; };
            nếu (byte_nối(code, machine) != 0) { status = -1; thoát; };
            next_ir = ir_start + ir_size;
        };
        nếu (next_ir != byte_dài(ir)) { status = -1; };
        nếu (status == 0) { status = cgp_patch_calls(code, starts, relocations, external_calls); };
        nếu (status == 0) {
            nếu (entry_id < 0) { status = -1; };
            nếu (entry_id * 4 >= byte_dài(starts)) { status = -1; };
            nếu (status == 0) { entry_offset = byte_đọc_i32(starts, entry_id * 4); };
        };
    };
    nếu (starts > 0) { byte_hủy(starts); };
    nếu (relocations > 0) { byte_hủy(relocations); };
    nếu (unit > 0) { byte_hủy(unit); };
    nếu (machine > 0) { byte_hủy(machine); };
    nếu (calls > 0) { byte_hủy(calls); };
    nếu (status != 0) { byte_làm_rỗng(code); byte_làm_rỗng(external_calls); trả về -1; };
    trả về entry_offset + 1;
};

// In a separately compiled module local function calls can be patched
// immediately. Cross-module CALLs retain BRANCH26 relocations and their
// global function IDs for the Mach-O symbol table.
hàm cgp_patch_module_calls(code, starts, calls, first, last, imports, native_calls) {
    lặp (i = 0; i < byte_dài(calls); i = i + 8) {
        biến from = byte_đọc_i32(calls, i);
        biến target = byte_đọc_i32(calls, i + 4);
        nếu (from < 0) { trả về -1; };
        nếu (from + 4 > byte_dài(code)) { trả về -1; };
        nếu (target < 0) {
            nếu (target < -62) { trả về -1; };
            nếu (byte_đẩy_i32(native_calls, from) != 0) { trả về -1; };
            nếu (byte_đẩy_i32(native_calls, -target - 1) != 0) { trả về -1; };
        } hoặc nếu (target < first) {
            nếu (byte_đẩy_i32(imports, from) != 0) { trả về -1; };
            nếu (byte_đẩy_i32(imports, target) != 0) { trả về -1; };
        } hoặc nếu (target >= last) {
            nếu (byte_đẩy_i32(imports, from) != 0) { trả về -1; };
            nếu (byte_đẩy_i32(imports, target) != 0) { trả về -1; };
        } hoặc {
            biến to = byte_đọc_i32(starts, (target - first) * 4);
            biến delta = 0;
            lặp (pos = from; pos < to; pos = pos + 4) { delta = delta + 1; };
            lặp (pos = from; pos > to; pos = pos - 4) { delta = delta - 1; };
            nếu (delta < -33554432) { trả về -1; };
            nếu (delta > 33554431) { trả về -1; };
            nếu (delta < 0) { delta = delta + 67108864; };
            nếu (byte_ghi_i32(code, from, -1811939328 + delta) != 0) { trả về -1; };
        };
    };
    trả về 0;
};

// Exposes local starts to the module object writer. Calls outside [first,last)
// remain relocation records instead of being patched into a common text blob.
hàm cgp_emit_module(ir, functions, code, first, last, starts, imports, native_calls) {
    nếu (code == ir) { trả về -1; };
    nếu (first < 0) { trả về -1; };
    nếu (last <= first) { trả về -1; };
    biến total = 0;
    lặp (record = 0; record < byte_dài(functions); record = record + 24) {
        nếu (record + 24 > byte_dài(functions)) { trả về -1; };
        total = total + 1;
    };
    nếu (last > total) { trả về -1; };
    nếu (byte_làm_rỗng(code) != 0) { trả về -1; };
    nếu (byte_làm_rỗng(starts) != 0) { trả về -1; };
    nếu (byte_làm_rỗng(imports) != 0) { trả về -1; };
    nếu (byte_làm_rỗng(native_calls) != 0) { trả về -1; };
    biến unit = byte_mới();
    biến machine = byte_mới();
    biến calls = byte_mới();
    biến relocations = byte_mới();
    biến status = 0;
    nếu (unit <= 0) { status = -1; };
    nếu (machine <= 0) { status = -1; };
    nếu (calls <= 0) { status = -1; };
    nếu (relocations <= 0) { status = -1; };
    nếu (status == 0) {
        lặp (fn = first; fn < last; fn++) {
            biến ir_start = byte_đọc_i32(functions, fn * 24 + 12);
            biến ir_size = byte_đọc_i32(functions, fn * 24 + 16);
            nếu (ir_size < 8) { status = -1; thoát; };
            nếu (ir_start < 0) { status = -1; thoát; };
            nếu (ir_start + ir_size > byte_dài(ir)) { status = -1; thoát; };
            nếu (byte_làm_rỗng(unit) != 0) { status = -1; thoát; };
            nếu (byte_làm_rỗng(calls) != 0) { status = -1; thoát; };
            lặp (off = ir_start; off < ir_start + ir_size; off++) {
                nếu (byte_thêm(unit, byte_lấy(ir, off)) != 0) { status = -1; thoát; };
            };
            nếu (status < 0) { thoát; };
            biến start = byte_dài(code);
            nếu (byte_đẩy_i32(starts, start) != 0) { status = -1; thoát; };
            nếu (cg_emit_internal(unit, machine, calls) <= 0) { status = -1; thoát; };
            lặp (offset = 0; offset < byte_dài(calls); offset = offset + 8) {
                nếu (byte_đẩy_i32(relocations, start + byte_đọc_i32(calls, offset)) != 0) { status = -1; thoát; };
                nếu (byte_đẩy_i32(relocations, byte_đọc_i32(calls, offset + 4)) != 0) { status = -1; thoát; };
            };
            nếu (status < 0) { thoát; };
            nếu (byte_nối(code, machine) != 0) { status = -1; thoát; };
        };
        nếu (status == 0) { status = cgp_patch_module_calls(code, starts, relocations, first, last, imports, native_calls); };
    };
    nếu (unit > 0) { byte_hủy(unit); };
    nếu (machine > 0) { byte_hủy(machine); };
    nếu (calls > 0) { byte_hủy(calls); };
    nếu (relocations > 0) { byte_hủy(relocations); };
    nếu (status != 0) { byte_làm_rỗng(code); trả về -1; };
    trả về 1;
};
