// Native module loader for the self-hosted i32 compiler.
// Supported source form: leading `nhập tên[/tên]*;` declarations.
// Paths are relative to the importing file; imports are compiled once in
// dependency-first order. The current subset uses a single function namespace.

// Seen table records: i32 path_length, i32 state (1 visiting, 2 done), bytes.
// Return 0 for missing, 1 for an active dependency, 2 for completed.
hàm nm_seen(table, path) {
    biến length = byte_dài(path);
    lặp (offset = 0; offset < byte_dài(table); offset = offset) {
        nếu (offset + 8 > byte_dài(table)) { trả về -1; };
        biến size = byte_đọc_i32(table, offset);
        nếu (size <= 0) { trả về -1; };
        nếu (size > byte_dài(table) - offset - 8) { trả về -1; };
        nếu (size == length) {
            biến equal = 1;
            lặp (i = 0; i < size; i++) {
                nếu (byte_lấy(table, offset + 8 + i) != byte_lấy(path, i)) {
                    equal = 0;
                    thoát;
                };
            };
            nếu (equal == 1) { trả về byte_đọc_i32(table, offset + 4); };
        };
        offset = offset + 8 + size;
    };
    trả về 0;
};

// Build path from the importer's directory and unqualified import tokens.
// Only identifiers and '/' separators are accepted (no '.', '..', aliases,
// or absolute imports); the .vi suffix is inferred.
// Returns token index after ';', or -1 if the directive is malformed.
hàm nm_import_path(path, src, tokens, start, child) {
    nếu (byte_làm_rỗng(child) != 0) { trả về -1; };
    biến last_slash = -1;
    lặp (i = 0; i < byte_dài(path); i++) {
        nếu (byte_lấy(path, i) == 47) { last_slash = i; };
    };
    lặp (i = 0; i <= last_slash; i++) {
        nếu (byte_thêm(child, byte_lấy(path, i)) != 0) { trả về -1; };
    };
    biến cursor = start;
    lặp (n = 0; n < tok_count(tokens); n++) {
        nếu (p_identifier(src, tokens, cursor) != 1) { trả về -1; };
        biến first = tok_field(tokens, cursor, 0);
        biến end = tok_field(tokens, cursor, 1);
        lặp (i = first; i < end; i++) {
            nếu (byte_thêm(child, byte_lấy(src, i)) != 0) { trả về -1; };
        };
        cursor = cursor + 1;
        nếu (tok_equals(src, tokens, cursor, ";") == 1) {
            biến suffix = ".vi";
            biến status = byte_nối(child, suffix);
            byte_hủy(suffix);
            nếu (status != 0) { trả về -1; };
            trả về cursor + 1;
        };
        nếu (tok_equals(src, tokens, cursor, "/") != 1) { trả về -1; };
        nếu (byte_thêm(child, 47) != 0) { trả về -1; };
        cursor = cursor + 1;
    };
    trả về -1;
};

// Recursively collect independent module payloads using the native lexer.
// Import-only files are allowed. Source and token handles remain local to
// their recursion frame. Cycles, missing modules and malformed imports fail.
hàm nm_load(path, combined, table, depth) {
    nếu (depth >= 12) { trả về -1; };
    biến state = nm_seen(table, path);
    nếu (state == 2) { trả về 0; };
    nếu (state != 0) { trả về -1; };
    biến mark = byte_dài(table);
    nếu (byte_đẩy_i32(table, byte_dài(path)) != 0) { trả về -1; };
    nếu (byte_đẩy_i32(table, 1) != 0) { trả về -1; };
    lặp (i = 0; i < byte_dài(path); i++) {
        nếu (byte_thêm(table, byte_lấy(path, i)) != 0) { trả về -1; };
    };
    biến source = byte_mới();
    biến tokens = byte_mới();
    biến child = byte_mới();
    biến status = 0;
    nếu (source <= 0) { status = -1; };
    nếu (tokens <= 0) { status = -1; };
    nếu (child <= 0) { status = -1; };
    nếu (status == 0) {
        nếu (native_read_source(path, source) <= 0) { status = -1; };
    };
    nếu (status == 0) {
        nếu (lex_tokenize(source, tokens) < 0) { status = -1; };
    };
    biến cursor = 0;
    nếu (status == 0) {
        lặp (i = 0; i < tok_count(tokens); i++) {
            nếu (tok_equals(source, tokens, cursor, "nhập") != 1) { thoát; };
            biến next = nm_import_path(path, source, tokens, cursor + 1, child);
            nếu (next < 0) { status = -1; thoát; };
            nếu (nm_load(child, combined, table, depth + 1) != 0) {
                status = -1;
                thoát;
            };
            cursor = next;
        };
    };
    nếu (status == 0) {
        nếu (cursor < tok_count(tokens)) {
            biến start = tok_field(tokens, cursor, 0);
            // Wire format: [i32 source_length, source_bytes] per module.
            // The parser now lexes each payload independently.
            nếu (byte_đẩy_i32(combined, byte_dài(source) - start) != 0) { status = -1; };
            nếu (status == 0) {
                lặp (i = start; i < byte_dài(source); i++) {
                    nếu (byte_thêm(combined, byte_lấy(source, i)) != 0) {
                        status = -1;
                        thoát;
                    };
                };
            };
        };
    };
    nếu (status == 0) {
        nếu (byte_ghi_i32(table, mark + 4, 2) != 0) { status = -1; };
    };
    nếu (source > 0) { byte_hủy(source); };
    nếu (tokens > 0) { byte_hủy(tokens); };
    nếu (child > 0) { byte_hủy(child); };
    trả về status;
};

hàm nm_prepare(path, combined) {
    nếu (byte_làm_rỗng(combined) != 0) { trả về -1; };
    biến table = byte_mới();
    nếu (table <= 0) { trả về -1; };
    biến runtime = runtime_nguồn();
    biến status = -1;
    nếu (runtime > 0) {
        status = nm_load(runtime, combined, table, 0);
        byte_hủy(runtime);
        nếu (status == 0) { status = nm_load(path, combined, table, 0); };
    };
    byte_hủy(table);
    nếu (status != 0) { byte_làm_rỗng(combined); trả về -1; };
    nếu (byte_dài(combined) <= 0) { trả về -1; };
    trả về byte_dài(combined);
};
