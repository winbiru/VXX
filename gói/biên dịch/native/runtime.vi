// Native runtime algorithms. Only máy_* operations cross the machine/OS ABI.
// Arena: counter at 0, input status at 8, 64 byte records at 16 (32 bytes
// each), 64 file records at 2064 (16 bytes each), scratch at 3104, cache
// record header at 3200 (16 bytes), digest at 3216 (32 bytes), cache hex
// at 3248 (65 bytes), linker argv table in dedicated high arena region, wait status
// at 3360 (4 bytes), Darwin stat scratch at 3376 and 3584 (208 bytes
// each), payloads at 4096. Pointers in byte
// records are bound as full-width 64-bit addresses.
// Handles encode a monotonically increasing generation and a 7-bit slot tag.
hàm rt_handle(tag) {
    biến generation = máy_đọc_i32(0);
    nếu (generation == 0) { generation = 1; };
    nếu (generation < 1) { trả về -1; };
    nếu (generation >= 16777215) { trả về -1; };
    nếu (máy_ghi_i32(0, generation + 1) != 0) { trả về -1; };
    trả về generation * 128 + tag;
};

hàm rt_bytes_slot(handle) {
    nếu (handle <= 0) { trả về -1; };
    biến slot = handle - máy_chia_i32(handle, 128) * 128;
    nếu (slot >= 64) { trả về -1; };
    nếu (máy_đọc_i32(16 + slot * 32) != handle) { trả về -1; };
    trả về slot;
};

hàm rt_payload(slot) { trả về 4096 + slot * 1048592; };

hàm rt_bytes_reserve(handle, extra) {
    biến slot = rt_bytes_slot(handle);
    nếu (slot < 0) { trả về -1; };
    nếu (extra < 0) { trả về -1; };
    biến record = 16 + slot * 32;
    biến length = máy_đọc_i32(record + 16);
    nếu (extra > 1048576 - length) { trả về -1; };
    biến required = length + extra + 1;
    biến capacity = máy_đọc_i32(record + 24);
    lặp (i = 0; capacity < required; i++) {
        nếu (capacity > 524288) { capacity = 1048577; }
        hoặc { capacity = capacity * 2; };
    };
    trả về máy_ghi_i32(record + 24, capacity);
};

hàm rt_bytes_new() {
    lặp (slot = 0; slot < 64; slot++) {
        biến record = 16 + slot * 32;
        nếu (máy_đọc_i32(record) == 0) {
            nếu (máy_gắn_địa_chỉ(record + 8, rt_payload(slot)) != 0) { trả về -1; };
            biến handle = rt_handle(slot);
            nếu (handle <= 0) { trả về -1; };
            máy_ghi_i32(record + 16, 0);
            máy_ghi_i32(record + 20, 0);
            máy_ghi_i32(record + 24, 1);
            máy_ghi_i32(record + 28, 0);
            máy_ghi_byte(rt_payload(slot), 0);
            máy_ghi_i32(record, handle);
            trả về handle;
        };
    };
    trả về -1;
};

hàm rt_bytes_length(handle) {
    biến slot = rt_bytes_slot(handle);
    nếu (slot < 0) { trả về -1; };
    trả về máy_đọc_i32(16 + slot * 32 + 16);
};

hàm rt_bytes_get(handle, index) {
    biến slot = rt_bytes_slot(handle);
    nếu (slot < 0) { trả về -1; };
    nếu (index < 0) { trả về -1; };
    nếu (index >= máy_đọc_i32(32 + slot * 32)) { trả về -1; };
    trả về máy_đọc_byte(rt_payload(slot) + index);
};

hàm rt_bytes_append(handle, value) {
    nếu (value < 0) { trả về -1; };
    nếu (value > 255) { trả về -1; };
    nếu (rt_bytes_reserve(handle, 1) != 0) { trả về -1; };
    biến slot = rt_bytes_slot(handle);
    biến record = 32 + slot * 32;
    biến length = máy_đọc_i32(record);
    máy_ghi_byte(rt_payload(slot) + length, value);
    máy_ghi_byte(rt_payload(slot) + length + 1, 0);
    trả về máy_ghi_i32(record, length + 1);
};

hàm rt_bytes_concat(destination, source) {
    biến src = rt_bytes_slot(source);
    nếu (src < 0) { trả về -1; };
    biến count = máy_đọc_i32(32 + src * 32);
    nếu (rt_bytes_reserve(destination, count) != 0) { trả về -1; };
    biến dst = rt_bytes_slot(destination);
    biến length = máy_đọc_i32(32 + dst * 32);
    lặp (i = 0; i < count; i++) {
        máy_ghi_byte(rt_payload(dst) + length + i, máy_đọc_byte(rt_payload(src) + i));
    };
    máy_ghi_byte(rt_payload(dst) + length + count, 0);
    trả về máy_ghi_i32(32 + dst * 32, length + count);
};

hàm rt_bytes_equal(left, right) {
    biến a = rt_bytes_slot(left);
    biến b = rt_bytes_slot(right);
    nếu (a < 0) { trả về -1; };
    nếu (b < 0) { trả về -1; };
    biến length = máy_đọc_i32(32 + a * 32);
    nếu (length != máy_đọc_i32(32 + b * 32)) { trả về 0; };
    lặp (i = 0; i < length; i++) {
        nếu (máy_đọc_byte(rt_payload(a) + i) != máy_đọc_byte(rt_payload(b) + i)) { trả về 0; };
    };
    trả về 1;
};

hàm rt_bytes_slice(handle, start, count) {
    biến slot = rt_bytes_slot(handle);
    nếu (slot < 0) { trả về -1; };
    nếu (start < 0) { trả về -1; };
    nếu (count < 0) { trả về -1; };
    biến length = máy_đọc_i32(32 + slot * 32);
    nếu (start > length) { trả về -1; };
    nếu (count > length - start) { trả về -1; };
    biến result = rt_bytes_new();
    nếu (result <= 0) { trả về -1; };
    biến dst = rt_bytes_slot(result);
    nếu (rt_bytes_reserve(result, count) != 0) { rt_bytes_free(result); trả về -1; };
    lặp (i = 0; i < count; i++) {
        máy_ghi_byte(rt_payload(dst) + i, máy_đọc_byte(rt_payload(slot) + start + i));
    };
    máy_ghi_byte(rt_payload(dst) + count, 0);
    máy_ghi_i32(32 + dst * 32, count);
    trả về result;
};

hàm rt_bytes_find(handle, needle) {
    biến src = rt_bytes_slot(handle);
    biến pattern = rt_bytes_slot(needle);
    nếu (src < 0) { trả về -2; };
    nếu (pattern < 0) { trả về -2; };
    biến count = máy_đọc_i32(32 + pattern * 32);
    biến length = máy_đọc_i32(32 + src * 32);
    nếu (count == 0) { trả về 0; };
    lặp (i = 0; i <= length - count; i++) {
        biến equal = 1;
        lặp (j = 0; j < count; j++) {
            nếu (máy_đọc_byte(rt_payload(src) + i + j) != máy_đọc_byte(rt_payload(pattern) + j)) {
                equal = 0; thoát;
            };
        };
        nếu (equal == 1) { trả về i; };
    };
    trả về -1;
};

hàm rt_bytes_clear(handle) {
    biến slot = rt_bytes_slot(handle);
    nếu (slot < 0) { trả về -1; };
    máy_ghi_byte(rt_payload(slot), 0);
    trả về máy_ghi_i32(32 + slot * 32, 0);
};

hàm rt_bytes_push_i32(handle, value) {
    nếu (rt_bytes_reserve(handle, 4) != 0) { trả về -1; };
    biến slot = rt_bytes_slot(handle);
    biến length = máy_đọc_i32(32 + slot * 32);
    máy_ghi_i32(rt_payload(slot) + length, value);
    máy_ghi_byte(rt_payload(slot) + length + 4, 0);
    trả về máy_ghi_i32(32 + slot * 32, length + 4);
};

hàm rt_bytes_load_i32(handle, offset) {
    biến length = rt_bytes_length(handle);
    nếu (offset < 0) { trả về -1; };
    nếu (offset > length - 4) { trả về -1; };
    trả về máy_đọc_i32(rt_payload(rt_bytes_slot(handle)) + offset);
};

hàm rt_bytes_store_i32(handle, offset, value) {
    biến length = rt_bytes_length(handle);
    nếu (offset < 0) { trả về -1; };
    nếu (offset > length - 4) { trả về -1; };
    trả về máy_ghi_i32(rt_payload(rt_bytes_slot(handle)) + offset, value);
};

hàm rt_bytes_free(handle) {
    biến slot = rt_bytes_slot(handle);
    nếu (slot < 0) { trả về -1; };
    lặp (i = 0; i < 32; i = i + 4) { máy_ghi_i32(16 + slot * 32 + i, 0); };
    trả về 0;
};

hàm rt_write_all(fd, offset, length) {
    biến done = 0;
    lặp (i = 0; done < length; i++) {
        biến count = máy_ghi(fd, offset + done, length - done);
        nếu (count < 0) {
            nếu (máy_lỗi() == 4) { bỏ qua; };
            trả về -1;
        };
        nếu (count == 0) { trả về -1; };
        done = done + count;
    };
    trả về done;
};

hàm rt_bytes_print(handle) {
    biến slot = rt_bytes_slot(handle);
    nếu (slot < 0) { trả về -1; };
    trả về rt_write_all(1, rt_payload(slot), máy_đọc_i32(32 + slot * 32));
};

hàm rt_argv(index) {
    biến length = máy_đối_số_dài(index);
    nếu (length < 0) { trả về -1; };
    biến result = rt_bytes_new();
    nếu (result <= 0) { trả về -1; };
    nếu (rt_bytes_reserve(result, length) != 0) { rt_bytes_free(result); trả về -1; };
    biến slot = rt_bytes_slot(result);
    lặp (i = 0; i < length; i++) { máy_ghi_byte(rt_payload(slot) + i, máy_đối_số_byte(index, i)); };
    máy_ghi_byte(rt_payload(slot) + length, 0);
    máy_ghi_i32(32 + slot * 32, length);
    trả về result;
};

// Resolve the native library in V++ itself. The machine boundary only copies
// VPP_HOME / getcwd bytes into an arena buffer; it never returns a pointer as
// i32. Use the normal V++ file API to check candidate source paths.
hàm rt_os_path(kind) {
    biến result = rt_bytes_new();
    nếu (result <= 0) { trả về -1; };
    biến slot = rt_bytes_slot(result);
    biến count = -1;
    nếu (kind == 0) { count = máy_home(rt_payload(slot)); }
    hoặc { count = máy_cwd(rt_payload(slot)); };
    nếu (count <= 0) { rt_bytes_free(result); trả về -1; };
    nếu (count >= 4096) { rt_bytes_free(result); trả về -1; };
    nếu (rt_bytes_reserve(result, count) != 0) { rt_bytes_free(result); trả về -1; };
    máy_ghi_i32(32 + slot * 32, count);
    trả về result;
};

hàm rt_runtime_candidate(root, suffix) {
    biến candidate = rt_bytes_new();
    nếu (candidate <= 0) { trả về -1; };
    biến ok = rt_bytes_concat(candidate, root);
    biến length = rt_bytes_length(root);
    nếu (length <= 0) { ok = -1; };
    nếu (ok == 0) {
        nếu (rt_bytes_get(root, length - 1) != 47) {
            nếu (rt_bytes_append(candidate, 47) != 0) { ok = -1; };
        };
    };
    nếu (ok == 0) {
        nếu (rt_bytes_concat(candidate, suffix) != 0) { ok = -1; };
    };
    nếu (rt_bytes_length(candidate) >= 4096) { ok = -1; };
    nếu (ok == 0) {
        // O_NONBLOCK (Darwin = 4) prevents a malicious FIFO in VPP_HOME
        // from hanging runtime discovery. Regular files read as usual.
        biến file = rt_file_open(candidate, 4);
        nếu (file > 0) {
            // A directory is not a valid runtime module. Read one byte to
            // reject non-files before passing the candidate to the loader.
            biến ch = rt_file_read_byte(file);
            biến closed = rt_file_close(file);
            nếu (ch >= 0) {
                nếu (closed == 0) { trả về candidate; };
            };
        };
    };
    rt_bytes_free(candidate);
    trả về -1;
};

// The caller chooses one of two trusted in-tree runtime files. Keep the
// same VPP_HOME/ancestor search for the runtime module and linker resources.
// Return an owned path handle (or -1), never a truncated machine pointer.
hàm rt_runtime_file_path(kind) {
    biến suffix = -1;
    nếu (kind == 0) { suffix = "gói/biên dịch/native/runtime.vi"; }
    hoặc nếu (kind == 1) { suffix = "scripts/ASM/vpp_aot_primitives_aarch64.S"; }
    ; // The C implementation is only a legacy Stage 0 fallback.
    nếu (suffix <= 0) { trả về -1; };
    biến home = rt_os_path(0);
    nếu (home > 0) {
        nếu (rt_bytes_get(home, 0) == 47) {
            biến result = rt_runtime_candidate(home, suffix);
            rt_bytes_free(home);
            nếu (result > 0) { rt_bytes_free(suffix); trả về result; };
        } hoặc { rt_bytes_free(home); };
    };
    biến directory = rt_os_path(1);
    nếu (directory <= 0) { rt_bytes_free(suffix); trả về -1; };
    lặp (depth = 0; depth < 128; depth++) {
        biến candidate = rt_runtime_candidate(directory, suffix);
        nếu (candidate > 0) {
            rt_bytes_free(directory);
            rt_bytes_free(suffix);
            trả về candidate;
        };
        biến last_slash = -1;
        lặp (i = 0; i < rt_bytes_length(directory); i++) {
            nếu (rt_bytes_get(directory, i) == 47) { last_slash = i; };
        };
        nếu (last_slash <= 0) {
            nếu (rt_bytes_length(directory) == 1) { thoát; };
            nếu (rt_bytes_clear(directory) != 0) { thoát; };
            nếu (rt_bytes_append(directory, 47) != 0) { thoát; };
        } hoặc {
            biến parent = rt_bytes_slice(directory, 0, last_slash);
            nếu (parent <= 0) { thoát; };
            rt_bytes_free(directory);
            directory = parent;
        };
    };
    rt_bytes_free(directory);
    rt_bytes_free(suffix);
    trả về -1;
};

hàm rt_runtime_module_path() { trả về rt_runtime_file_path(0); };

// Read the Mach-O symtab within one object of a packed object archive.
// Values on disk are u32; negative i32 values can never represent a valid
// offset/length in the bounded (1 MiB) V++ byte arena.
hàm rt_object_name_matches(archive, offset, available, expected) {
    biến count = rt_bytes_length(expected);
    nếu (count < 0) { trả về 0; };
    nếu (count >= available) { trả về 0; };
    lặp (i = 0; i < count; i++) {
        nếu (rt_bytes_get(archive, offset + i) != rt_bytes_get(expected, i)) { trả về 0; };
    };
    nếu (rt_bytes_get(archive, offset + count) != 0) { trả về 0; };
    trả về 1;
};

hàm rt_object_service_name(archive, offset, available) {
    biến name = "_vpp_native_cache_read";
    nếu (name <= 0) { trả về -1; };
    nếu (rt_object_name_matches(archive, offset, available, name) == 1) {
        rt_bytes_free(name); trả về 1;
    };
    rt_bytes_free(name);
    name = "_vpp_native_cache_write";
    nếu (name <= 0) { trả về -1; };
    nếu (rt_object_name_matches(archive, offset, available, name) == 1) {
        rt_bytes_free(name); trả về 1;
    };
    rt_bytes_free(name);
    name = "_vpp_native_link_macho";
    nếu (name <= 0) { trả về -1; };
    nếu (rt_object_name_matches(archive, offset, available, name) == 1) {
        rt_bytes_free(name); trả về 1;
    };
    rt_bytes_free(name);
    name = "_vpp_native_link_macho_modules";
    nếu (name <= 0) { trả về -1; };
    biến result = rt_object_name_matches(archive, offset, available, name);
    rt_bytes_free(name);
    trả về result;
};

// 1: references compiler services, 0: assembly/OS only, -1: corrupt Mach-O.
// C supplies the archive handle and the object's byte range. All reads are
// bounded by the object itself, even when the archive contains later modules.
hàm rt_object_services(archive, start, length) {
    biến total = rt_bytes_length(archive);
    nếu (start < 0) { trả về -1; };
    nếu (length < 32) { trả về -1; };
    nếu (total < 0) { trả về -1; };
    nếu (start > total - length) { trả về -1; };
    biến commands = rt_bytes_load_i32(archive, start + 16);
    nếu (commands < 0) { trả về -1; };
    nếu (commands > máy_chia_i32(length - 32, 8)) { trả về -1; };
    biến offset = 32;
    biến needs_services = 0;
    lặp (command = 0; command < commands; command++) {
        nếu (offset > length - 8) { trả về -1; };
        biến kind = rt_bytes_load_i32(archive, start + offset);
        biến size = rt_bytes_load_i32(archive, start + offset + 4);
        nếu (size < 8) { trả về -1; };
        nếu (size > length - offset) { trả về -1; };
        nếu (kind == 2) {
            nếu (size < 24) { trả về -1; };
            biến symbols = rt_bytes_load_i32(archive, start + offset + 8);
            biến count = rt_bytes_load_i32(archive, start + offset + 12);
            biến strings = rt_bytes_load_i32(archive, start + offset + 16);
            biến string_size = rt_bytes_load_i32(archive, start + offset + 20);
            nếu (symbols < 0) { trả về -1; };
            nếu (count < 0) { trả về -1; };
            nếu (strings < 0) { trả về -1; };
            nếu (string_size < 0) { trả về -1; };
            nếu (symbols > length) { trả về -1; };
            nếu (count > máy_chia_i32(length - symbols, 16)) { trả về -1; };
            nếu (strings > length) { trả về -1; };
            nếu (string_size > length - strings) { trả về -1; };
            lặp (i = 0; i < count; i++) {
                biến symbol = symbols + i * 16;
                biến type = rt_bytes_get(archive, start + symbol + 4);
                biến bits = type - máy_chia_i32(type, 16) * 16;
                nếu (bits >= 2) { bỏ qua; };
                biến name_offset = rt_bytes_load_i32(archive, start + symbol);
                nếu (name_offset < 0) { trả về -1; };
                nếu (name_offset >= string_size) { trả về -1; };
                biến name_start = start + strings + name_offset;
                biến available = string_size - name_offset;
                biến terminated = 0;
                lặp (j = 0; j < available; j++) {
                    nếu (rt_bytes_get(archive, name_start + j) == 0) {
                        terminated = 1; thoát;
                    };
                };
                nếu (terminated == 0) { trả về -1; };
                biến service = rt_object_service_name(archive, name_start, available);
                nếu (service < 0) { trả về -1; };
                nếu (service > 0) { needs_services = 1; };
            };
        };
        offset = offset + size;
    };
    trả về needs_services;
};

// A packed linker archive stores [u32 object length][MH_OBJECT bytes]...
// Return the validated object length at the prefix, or -1. This function
// bounds every read by the actual archive and rejects non-ARM64 Mach-O files.
hàm rt_object_archive_entry(archive, offset) {
    biến total = rt_bytes_length(archive);
    nếu (total < 0) { trả về -1; };
    nếu (offset < 0) { trả về -1; };
    nếu (offset > total - 4) { trả về -1; };
    biến length = rt_bytes_load_i32(archive, offset);
    nếu (length < 232) { trả về -1; };
    nếu (length > total - offset - 4) { trả về -1; };
    biến start = offset + 4;
    // MH_MAGIC_64 (little-endian), CPU_TYPE_ARM64 and MH_OBJECT.
    nếu (rt_bytes_get(archive, start) != 207) { trả về -1; };
    nếu (rt_bytes_get(archive, start + 1) != 250) { trả về -1; };
    nếu (rt_bytes_get(archive, start + 2) != 237) { trả về -1; };
    nếu (rt_bytes_get(archive, start + 3) != 254) { trả về -1; };
    nếu (rt_bytes_load_i32(archive, start + 4) != 16777228) { trả về -1; };
    nếu (rt_bytes_load_i32(archive, start + 12) != 1) { trả về -1; };
    trả về length;
};

// Validates the entire archive, including each Mach-O symbol table. The
// packed result is (count * 2 + needs_compiler_services), or -1 on error.
// With <= 1 MiB archives and 232-byte minimum objects, this fits in i32.
hàm rt_object_archive_summary(archive) {
    biến total = rt_bytes_length(archive);
    nếu (total < 5) { trả về -1; };
    biến offset = 0;
    biến count = 0;
    biến needs_services = 0;
    lặp (i = 0; offset < total; i++) {
        biến length = rt_object_archive_entry(archive, offset);
        nếu (length < 0) { trả về -1; };
        biến services = rt_object_services(archive, offset + 4, length);
        nếu (services < 0) { trả về -1; };
        nếu (services > 0) { needs_services = 1; };
        count = count + 1;
        offset = offset + length + 4;
    };
    nếu (count == 0) { trả về -1; };
    nếu (offset != total) { trả về -1; };
    trả về count * 2 + needs_services;
};

// Wrap a single Mach-O object using the same [u32 length][body] wire format
// as the multi-module linker. Return an owned archive handle or -1. The
// downstream archive validator checks its Mach-O framing and symbols.
hàm rt_link_archive_single(object) {
    biến length = rt_bytes_length(object);
    nếu (length < 232) { trả về -1; };
    nếu (length > 1048572) { trả về -1; };
    biến archive = rt_bytes_new();
    nếu (archive <= 0) { trả về -1; };
    nếu (rt_bytes_push_i32(archive, length) != 0) {
        rt_bytes_free(archive);
        trả về -1;
    };
    nếu (rt_bytes_concat(archive, object) != 0) {
        rt_bytes_free(archive);
        trả về -1;
    };
    trả về archive;
};

// Build the mkstemp pathname in V++. index == -1 selects the executable;
// nonnegative indexes select object files.
// The destination is a separate reusable bytes handle, with a trailing NUL.
hàm rt_link_valid_path(handle, maximum) {
    biến length = rt_bytes_length(handle);
