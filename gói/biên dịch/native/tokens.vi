// Buffer token native: i32 count, rồi (i32 start, i32 end, i32 kind)*count.
// Offset byte UTF-8, không cấp phát chuỗi/token trên heap cho từng từ.
// Chỉ dùng với ABI native và lexer.vi (nối file nguồn khi chưa hỗ trợ import).

hàm tok_count(tokens) {
    biến n = byte_dài(tokens);
    nếu (n < 4) { trả về -1; };
    biến count = byte_đọc_i32(tokens, 0);
    nếu (count < 0) { trả về -1; };
    nếu (count > 87381) { trả về -1; };
    nếu (n != 4 + count * 12) { trả về -1; };
    trả về count;
};

// field: 0 start, 1 end, 2 loại (theo lex_kind).
hàm tok_field(tokens, index, field) {
    biến count = tok_count(tokens);
    nếu (count < 0) { trả về -1; };
    nếu (index < 0) { trả về -1; };
    nếu (index >= count) { trả về -1; };
    nếu (field < 0) { trả về -1; };
    nếu (field > 2) { trả về -1; };
    trả về byte_đọc_i32(tokens, 4 + index * 12 + field * 4);
};

// Không tin token buffer do caller truyền vào: kiểm tra đủ source span,
// loại token, thứ tự và cả trivia (khoảng trắng/chú thích) giữa các token.
// Thành công trả số token, lỗi trả -1.
hàm tok_validate(src, tokens) {
    biến length = byte_dài(src);
    biến count = tok_count(tokens);
    nếu (length < 0) { trả về -1; };
    nếu (count < 0) { trả về -1; };
    biến cursor = 0;
    lặp (i = 0; i < count; i++) {
        biến start = tok_field(tokens, i, 0);
        biến end = tok_field(tokens, i, 1);
        biến kind = tok_field(tokens, i, 2);
        nếu (start != lex_skip(src, cursor)) { trả về -1; };
        nếu (end <= start) { trả về -1; };
        nếu (end > length) { trả về -1; };
        nếu (kind < 1) { trả về -1; };
        nếu (kind > 6) { trả về -1; };
        nếu (lex_kind(src, start, end) != kind) { trả về -1; };
        cursor = end;
    };
    nếu (lex_skip(src, cursor) != length) { trả về -1; };
    trả về count;
};

// Thành công trả số token >=0; lỗi trả -1 và xóa toàn bộ kết quả.
hàm lex_tokenize(src, tokens) {
    nếu (byte_dài(src) < 0) { trả về -1; };
    nếu (byte_dài(tokens) < 0) { trả về -1; };
    nếu (src == tokens) { trả về -1; };
    nếu (byte_làm_rỗng(tokens) != 0) { trả về -1; };
    nếu (byte_đẩy_i32(tokens, 0) != 0) { trả về -1; };
    biến count = 0;
    biến pos = 0;
    lặp (loop = 0; loop < 87382; loop++) {
        pos = lex_skip(src, pos);
        nếu (pos < 0) { byte_làm_rỗng(tokens); trả về -1; };
        nếu (pos == byte_dài(src)) {
            nếu (byte_ghi_i32(tokens, 0, count) != 0) {
                byte_làm_rỗng(tokens);
                trả về -1;
            };
            trả về count;
        };
        biến end = lex_end(src, pos);
        nếu (end <= pos) { byte_làm_rỗng(tokens); trả về -1; };
        biến kind = lex_kind(src, pos, end);
        nếu (kind < 1) { byte_làm_rỗng(tokens); trả về -1; };
        nếu (byte_đẩy_i32(tokens, pos) != 0) { byte_làm_rỗng(tokens); trả về -1; };
        nếu (byte_đẩy_i32(tokens, end) != 0) { byte_làm_rỗng(tokens); trả về -1; };
        nếu (byte_đẩy_i32(tokens, kind) != 0) { byte_làm_rỗng(tokens); trả về -1; };
        pos = end;
        count = count + 1;
    };
    byte_làm_rỗng(tokens);
    trả về -1;
};

// So token với literal UTF-8. Hàm này SỞ HỮU và hủy expected.
// Điều này tránh rò handle khi truyền thẳng "hàm"/"biến"/"chính".
hàm tok_equals(src, tokens, index, expected) {
    biến start = tok_field(tokens, index, 0);
    biến end = tok_field(tokens, index, 1);
    biến len = byte_dài(expected);
    biến equal = 1;
    nếu (start < 0) { equal = 0; };
    nếu (end - start != len) { equal = 0; };
    nếu (len < 0) { equal = 0; };
    nếu (equal == 1) {
        lặp (i = 0; i < len; i++) {
            nếu (byte_lấy(src, start + i) != byte_lấy(expected, i)) {
                equal = 0;
                thoát;
            };
        };
    };
    nếu (byte_hủy(expected) != 0) { trả về -1; };
    trả về equal;
};
