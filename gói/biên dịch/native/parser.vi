        postfix = 1;
    }
    hoặc nếu (p_take(src, tokens, state, "--") == 1) {
        compound = 5;
        postfix = 1;
    }
    hoặc { trả về -1; };
    nếu (compound != 0) {
        nếu (p_emit(ir, 2, assign_slot) != 0) { trả về -1; };
    };
    nếu (postfix == 1) {
        nếu (p_emit(ir, 1, 1) != 0) { trả về -1; };
    } hoặc {
        nếu (p_expression(src, tokens, state, ir) != 0) { trả về -1; };
    };
    nếu (compound != 0) {
        nếu (p_emit(ir, compound, 0) != 0) { trả về -1; };
    };
    nếu (p_take(src, tokens, state, ";") != 1) { trả về -1; };
    trả về p_emit(ir, 3, assign_slot);
};

hàm p_body(src, tokens, state, ir) {
    nếu (p_take(src, tokens, state, "hàm") != 1) { trả về -1; };
    nếu (p_take(src, tokens, state, "chính") != 1) { trả về -1; };
    nếu (p_take(src, tokens, state, "(") != 1) { trả về -1; };
    nếu (p_take(src, tokens, state, ")") != 1) { trả về -1; };
    nếu (p_take(src, tokens, state, "{") != 1) { trả về -1; };
    lặp (i = 0; i < tok_count(tokens); i++) {
        biến cursor = byte_đọc_i32(state, 0);
        nếu (cursor >= tok_count(tokens)) { trả về -1; };
        nếu (p_take(src, tokens, state, "}") == 1) {
            nếu (byte_đọc_i32(state, 8) != 1) { trả về -1; };
            // Dấu ; sau khai báo hàm là tùy chọn.
            p_take(src, tokens, state, ";");
            nếu (byte_đọc_i32(state, 0) != tok_count(tokens)) { trả về -1; };
            trả về byte_dài(ir);
        };
        nếu (byte_đọc_i32(state, 8) != 0) { trả về -1; };
        nếu (p_statement(src, tokens, state, ir) != 0) { trả về -1; };
    };
    trả về -1;
};

// IR đích phải có handle riêng. Thành công: số byte IR; lỗi: -1,
// luôn xóa IR nếu parse/semantic thất bại, tránh sinh artifact dang dở.
hàm p_compile(src, tokens, ir) {
    nếu (byte_dài(src) < 0) { trả về -1; };
    nếu (byte_dài(ir) < 0) { trả về -1; };
    nếu (ir == src) { trả về -1; };
    nếu (ir == tokens) { trả về -1; };
    nếu (byte_làm_rỗng(ir) != 0) { trả về -1; };
    nếu (tok_validate(src, tokens) < 0) { trả về -1; };
    biến state = byte_mới();
    nếu (state <= 0) { trả về -1; };
    biến ready = 0;
    nếu (byte_đẩy_i32(state, 0) == 0) { ready = ready + 1; };
    nếu (byte_đẩy_i32(state, 0) == 0) { ready = ready + 1; };
    nếu (byte_đẩy_i32(state, 0) == 0) { ready = ready + 1; };
    nếu (byte_đẩy_i32(state, 0) == 0) { ready = ready + 1; };
    nếu (byte_đẩy_i32(state, 0) == 0) { ready = ready + 1; };
    biến result = -1;
    nếu (ready == 5) { result = p_body(src, tokens, state, ir); };
    byte_hủy(state);
    nếu (result < 0) { byte_làm_rỗng(ir); };
    trả về result;
};
