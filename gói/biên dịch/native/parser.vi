// Parser/semantic và IR tuyến tính native cho tập con hàm chính() i32.
// Ngữ pháp: hàm chính() { (biến tên = expr; | tên = expr; | nếu ...)* trả về expr; };
// expr: i32, đúng/sai, tên đã khai báo, dấu ngoặc, unary -/+/!, +, -, *, /, %, so sánh.
// Câu lệnh và bước cập nhật vòng lặp hỗ trợ =, +=, -=, *=, /=, %=; biến cục bộ
// cũng có thể dùng ++/--. Các phép tính dùng opcode IR i32 hiện có.
// IR là dãy (i32 opcode, i32 operand) dùng stack, có thể tự chạy bằng V++.
// op: 1 PUSH, 2 LOAD, 3 STORE, 4 ADD, 5 SUB, 6 MUL, 7 RET, 8 NEG,
// 9 JZ (pop), 10 JMP; 11 EQ, 12 NE, 13 LT, 14 LE, 15 GT, 16 GE;
// 25 NOT, 26 DIV (signed i32), 27 MOD (signed i32). Chia cho 0 là lỗi.
// Đích JZ/JMP là byte offset (bội của 8) trong buffer IR.
// parser state: cursor, số biến, return-flag, loop-depth,
//               (start,end) * số biến.

hàm p_take(src, tokens, state, expected) {
    biến cursor = byte_đọc_i32(state, 0);
    biến matched = tok_equals(src, tokens, cursor, expected);
    nếu (matched == 1) { byte_ghi_i32(state, 0, cursor + 1); };
    trả về matched;
};

hàm p_emit(ir, op, operand) {
    nếu (byte_dài(ir) > 1048568) { trả về -1; };
    nếu (byte_đẩy_i32(ir, op) != 0) { trả về -1; };
    nếu (byte_đẩy_i32(ir, operand) != 0) { trả về -1; };
    trả về 0;
};

// Symbol lookup: same UTF-8 byte span, no name allocation.
hàm p_symbol(src, tokens, state, index) {
    biến start = tok_field(tokens, index, 0);
    biến end = tok_field(tokens, index, 1);
    nếu (start < 0) { trả về -1; };
    biến count = byte_đọc_i32(state, 4);
    lặp (i = 0; i < count; i++) {
        biến begin = byte_đọc_i32(state, 20 + i * 8);
        biến finish = byte_đọc_i32(state, 24 + i * 8);
        nếu (begin < 0) { bỏ qua; };
        biến same = 1;
        nếu (end - start != finish - begin) { same = 0; };
        nếu (same == 1) {
            lặp (j = 0; j < end - start; j++) {
                nếu (byte_lấy(src, start + j) != byte_lấy(src, begin + j)) {
                    same = 0;
                    thoát;
                };
            };
        };
        nếu (same == 1) { trả về i; };
    };
    trả về -1;
};

// Parse i32 không dấu, báo lỗi trước khi overflow.
hàm p_number(src, start, end) {
    nếu (start < 0) { trả về -1; };
    nếu (end <= start) { trả về -1; };
    biến value = 0;
    lặp (i = start; i < end; i++) {
        biến digit = byte_lấy(src, i) - 48;
        nếu (digit < 0) { trả về -1; };
        nếu (digit > 9) { trả về -1; };
        nếu (value > 214748364) { trả về -1; };
        nếu (value == 214748364) {
            nếu (digit > 7) { trả về -1; };
        };
        value = value * 10 + digit;
    };
    trả về value;
};

// Một định danh trong tập con native phải là chuỗi UTF-8 bắt đầu bằng
// chữ cái hoặc dấu gạch dưới; dấu chấm/số ở đầu và từ khóa bị từ chối.
hàm p_identifier(src, tokens, index) {
    nếu (tok_field(tokens, index, 2) != 1) { trả về 0; };
    biến start = tok_field(tokens, index, 0);
    biến end = tok_field(tokens, index, 1);
    nếu (start < 0) { trả về 0; };
    biến first = byte_lấy(src, start);
    nếu (first >= 48) { nếu (first <= 57) { trả về 0; }; };
    lặp (i = start; i < end; i++) {
        biến ch = byte_lấy(src, i);
        nếu (ch < 128) {
            biến valid = 0;
            nếu (ch >= 65) { nếu (ch <= 90) { valid = 1; }; };
            nếu (ch >= 97) { nếu (ch <= 122) { valid = 1; }; };
            nếu (ch >= 48) { nếu (ch <= 57) { valid = 1; }; };
            nếu (ch == 95) { valid = 1; };
            nếu (valid == 0) { trả về 0; };
        };
    };
    nếu (tok_equals(src, tokens, index, "hàm") == 1) { trả về 0; };
    nếu (tok_equals(src, tokens, index, "biến") == 1) { trả về 0; };
    nếu (tok_equals(src, tokens, index, "trả") == 1) { trả về 0; };
    nếu (tok_equals(src, tokens, index, "về") == 1) { trả về 0; };
    nếu (tok_equals(src, tokens, index, "nếu") == 1) { trả về 0; };
    nếu (tok_equals(src, tokens, index, "lặp") == 1) { trả về 0; };
    nếu (tok_equals(src, tokens, index, "đúng") == 1) { trả về 0; };
    nếu (tok_equals(src, tokens, index, "sai") == 1) { trả về 0; };
    nếu (tok_equals(src, tokens, index, "rỗng") == 1) { trả về 0; };
    trả về 1;
};

// Name matching keeps all function references in UTF-8 source byte spans.
hàm p_same_token(src, tokens, a_index, b_index) {
    biến a = tok_field(tokens, a_index, 0);
    biến a_end = tok_field(tokens, a_index, 1);
    biến b = tok_field(tokens, b_index, 0);
    biến b_end = tok_field(tokens, b_index, 1);
    nếu (a < 0) { trả về 0; };
    nếu (b < 0) { trả về 0; };
    nếu (a_end - a != b_end - b) { trả về 0; };
    lặp (i = 0; i < a_end - a; i++) {
        nếu (byte_lấy(src, a + i) != byte_lấy(src, b + i)) { trả về 0; };
    };
    trả về 1;
};

// The machine runtime owns the entire vpp_native_* symbol namespace.
// Reject declarations at the V++ frontend so user objects cannot shadow
// ASM primitives when the native linker resolves external symbols.
hàm p_reserved_abi_name(src, tokens, index) {
    biến start = tok_field(tokens, index, 0);
    biến end = tok_field(tokens, index, 1);
    nếu (start < 0) { trả về 0; };
    nếu (end - start < 11) { trả về 0; };
    biến prefix = "vpp_native_";
    biến matched = 1;
    lặp (i = 0; i < 11; i++) {
        nếu (byte_lấy(src, start + i) != byte_lấy(prefix, i)) {
            matched = 0;
            thoát;
        };
    };
    byte_hủy(prefix);
    trả về matched;
};

// Return the number of i32 parameters in a function header.
// The first parameter starts at declaration token + 3.
hàm p_header_arity(src, tokens, fn_token) {
    nếu (p_identifier(src, tokens, fn_token + 1) != 1) { trả về -1; };
    nếu (p_native_id(src, tokens, fn_token + 1) >= 0) { trả về -1; };
    nếu (p_reserved_abi_name(src, tokens, fn_token + 1) == 1) { trả về -1; };
    nếu (tok_equals(src, tokens, fn_token + 2, "(") != 1) { trả về -1; };
    biến cursor = fn_token + 3;
    biến n = 0;
    nếu (tok_equals(src, tokens, cursor, ")") == 1) {
        nếu (tok_equals(src, tokens, cursor + 1, "{") == 1) { trả về 0; };
        trả về -1;
    };
    lặp (k = 0; k < tok_count(tokens); k++) {
        nếu (p_identifier(src, tokens, cursor) != 1) { trả về -1; };
        n = n + 1;
        cursor = cursor + 1;
        nếu (tok_equals(src, tokens, cursor, ")") == 1) {
            nếu (tok_equals(src, tokens, cursor + 1, "{") == 1) { trả về n; };
            trả về -1;
        };
        nếu (tok_equals(src, tokens, cursor, ",") != 1) { trả về -1; };
        cursor = cursor + 1;
    };
    trả về -1;
};

// Function IDs follow declaration order; calls may reference later functions.
// CALL's function ID and CALL_ARITY's argument count are separate IR fields,
// so the argument count is not limited by bit packing.
hàm p_function_id(src, tokens, name_index) {
    biến count = 0;
    lặp (i = 0; i < tok_count(tokens); i++) {
        nếu (tok_equals(src, tokens, i, "hàm") == 1) {
            biến arity = p_header_arity(src, tokens, i);
            nếu (arity >= 0) {
                nếu (p_same_token(src, tokens, name_index, i + 1) == 1) {
                    trả về count;
                };
                count = count + 1;
            };
        };
    };
    trả về -1;
};

hàm p_function_arity(src, tokens, function_id) {
    biến count = 0;
    lặp (i = 0; i < tok_count(tokens); i++) {
        nếu (tok_equals(src, tokens, i, "hàm") == 1) {
            biến arity = p_header_arity(src, tokens, i);
            nếu (arity >= 0) {
                nếu (count == function_id) { trả về arity; };
                count = count + 1;
            };
        };
    };
    trả về -1;
};

// Shared signature lookup belongs to the parser so standalone parser and
// codegen users do not depend on the module compilation driver.
// Registry records are [i32 byte_length, i32 arity, UTF-8 name bytes].
hàm p_registry_id(src, tokens, name_index, registry) {
    biến start = tok_field(tokens, name_index, 0);
    biến end = tok_field(tokens, name_index, 1);
    nếu (start < 0) { trả về -1; };
    biến index = 0;
    lặp (offset = 0; offset < byte_dài(registry); offset = offset) {
        nếu (offset + 8 > byte_dài(registry)) { trả về -1; };
        biến length = byte_đọc_i32(registry, offset);
        nếu (length <= 0) { trả về -1; };
        nếu (length > byte_dài(registry) - offset - 8) { trả về -1; };
        nếu (length == end - start) {
            biến match = 1;
            lặp (i = 0; i < length; i++) {
                nếu (byte_lấy(src, start + i) != byte_lấy(registry, offset + 8 + i)) {
                    match = 0;
                    thoát;
                };
            };
            nếu (match == 1) { trả về index; };
        };
        offset = offset + 8 + length;
        index = index + 1;
    };
    trả về -1;
};

hàm p_registry_arity(registry, function_id) {
    nếu (function_id < 0) { trả về -1; };
    biến index = 0;
    lặp (offset = 0; offset < byte_dài(registry); offset = offset) {
        nếu (offset + 8 > byte_dài(registry)) { trả về -1; };
        biến length = byte_đọc_i32(registry, offset);
        nếu (length <= 0) { trả về -1; };
        nếu (length > byte_dài(registry) - offset - 8) { trả về -1; };
        nếu (index == function_id) { trả về byte_đọc_i32(registry, offset + 4); };
        offset = offset + 8 + length;
        index = index + 1;
    };
    trả về -1;
};

// IDs of the closed native runtime ABI. A negative CALL operand encodes
// -(id + 1); nonnegative operands continue to name user-defined functions.
// Keep this table in the same order as obj_native_name in object.vi.
hàm p_native_id(src, tokens, cursor) {
    nếu (tok_equals(src, tokens, cursor, "byte_mới") == 1) { trả về 0; };
    nếu (tok_equals(src, tokens, cursor, "byte_dài") == 1) { trả về 1; };
    nếu (tok_equals(src, tokens, cursor, "byte_lấy") == 1) { trả về 2; };
    nếu (tok_equals(src, tokens, cursor, "byte_thêm") == 1) { trả về 3; };
    nếu (tok_equals(src, tokens, cursor, "byte_đẩy_i32") == 1) { trả về 4; };
    nếu (tok_equals(src, tokens, cursor, "byte_đọc_i32") == 1) { trả về 5; };
    nếu (tok_equals(src, tokens, cursor, "byte_ghi_i32") == 1) { trả về 6; };
    nếu (tok_equals(src, tokens, cursor, "byte_làm_rỗng") == 1) { trả về 7; };
    nếu (tok_equals(src, tokens, cursor, "byte_nối") == 1) { trả về 8; };
    nếu (tok_equals(src, tokens, cursor, "byte_bằng") == 1) { trả về 9; };
    nếu (tok_equals(src, tokens, cursor, "byte_hủy") == 1) { trả về 10; };
    nếu (tok_equals(src, tokens, cursor, "đối_số_đếm") == 1) { trả về 11; };
    nếu (tok_equals(src, tokens, cursor, "đối_số_lấy") == 1) { trả về 12; };
    nếu (tok_equals(src, tokens, cursor, "tệp_mở_đọc") == 1) { trả về 13; };
    nếu (tok_equals(src, tokens, cursor, "tệp_đọc_khối") == 1) { trả về 14; };
    nếu (tok_equals(src, tokens, cursor, "tệp_đóng") == 1) { trả về 15; };
    nếu (tok_equals(src, tokens, cursor, "liên_kết_macho") == 1) { trả về 16; };
    nếu (tok_equals(src, tokens, cursor, "liên_kết_đối_tượng") == 1) { trả về 17; };
    nếu (tok_equals(src, tokens, cursor, "cache_đọc") == 1) { trả về 18; };
    nếu (tok_equals(src, tokens, cursor, "cache_ghi") == 1) { trả về 19; };
    nếu (tok_equals(src, tokens, cursor, "byte_cắt") == 1) { trả về 20; };
    nếu (tok_equals(src, tokens, cursor, "byte_tìm") == 1) { trả về 21; };
    nếu (tok_equals(src, tokens, cursor, "byte_in") == 1) { trả về 22; };
    nếu (tok_equals(src, tokens, cursor, "tệp_mở_ghi") == 1) { trả về 23; };
    nếu (tok_equals(src, tokens, cursor, "tệp_ghi_khối") == 1) { trả về 24; };
    nếu (tok_equals(src, tokens, cursor, "máy_đọc_byte") == 1) { trả về 25; };
    nếu (tok_equals(src, tokens, cursor, "máy_ghi_byte") == 1) { trả về 26; };
    nếu (tok_equals(src, tokens, cursor, "máy_đọc_i32") == 1) { trả về 27; };
    nếu (tok_equals(src, tokens, cursor, "máy_ghi_i32") == 1) { trả về 28; };
    nếu (tok_equals(src, tokens, cursor, "máy_gắn_địa_chỉ") == 1) { trả về 29; };
    nếu (tok_equals(src, tokens, cursor, "máy_mở") == 1) { trả về 30; };
    nếu (tok_equals(src, tokens, cursor, "máy_đọc") == 1) { trả về 31; };
    nếu (tok_equals(src, tokens, cursor, "máy_ghi") == 1) { trả về 32; };
    nếu (tok_equals(src, tokens, cursor, "máy_đóng") == 1) { trả về 33; };
    nếu (tok_equals(src, tokens, cursor, "máy_lỗi") == 1) { trả về 34; };
    nếu (tok_equals(src, tokens, cursor, "máy_đối_số_dài") == 1) { trả về 35; };
    nếu (tok_equals(src, tokens, cursor, "máy_đối_số_byte") == 1) { trả về 36; };
    nếu (tok_equals(src, tokens, cursor, "máy_chia_i32") == 1) { trả về 37; };
    nếu (tok_equals(src, tokens, cursor, "runtime_nguồn") == 1) { trả về 38; };
    nếu (tok_equals(src, tokens, cursor, "in_số") == 1) { trả về 39; };
    nếu (tok_equals(src, tokens, cursor, "đọc_số") == 1) { trả về 40; };
    nếu (tok_equals(src, tokens, cursor, "trạng_thái_đọc") == 1) { trả về 41; };
    nếu (tok_equals(src, tokens, cursor, "tệp_đọc_byte") == 1) { trả về 42; };
    nếu (tok_equals(src, tokens, cursor, "tệp_ghi_byte") == 1) { trả về 43; };
    nếu (tok_equals(src, tokens, cursor, "máy_home") == 1) { trả về 44; };
    nếu (tok_equals(src, tokens, cursor, "máy_cwd") == 1) { trả về 45; };
    nếu (tok_equals(src, tokens, cursor, "máy_tạm_mở") == 1) { trả về 46; };
    nếu (tok_equals(src, tokens, cursor, "máy_đổi_tên") == 1) { trả về 47; };
    nếu (tok_equals(src, tokens, cursor, "máy_khởi_chạy_clang") == 1) { trả về 48; };
    nếu (tok_equals(src, tokens, cursor, "máy_đợi") == 1) { trả về 49; };
    nếu (tok_equals(src, tokens, cursor, "máy_stat") == 1) { trả về 50; };
    nếu (tok_equals(src, tokens, cursor, "máy_lstat") == 1) { trả về 51; };
    nếu (tok_equals(src, tokens, cursor, "máy_quyền_chạy") == 1) { trả về 52; };
    nếu (tok_equals(src, tokens, cursor, "máy_xóa") == 1) { trả về 53; };
    nếu (tok_equals(src, tokens, cursor, "máy_env_lấy") == 1) { trả về 54; };
    nếu (tok_equals(src, tokens, cursor, "máy_exe_lấy") == 1) { trả về 55; };
    nếu (tok_equals(src, tokens, cursor, "máy_mkdir") == 1) { trả về 56; };
    nếu (tok_equals(src, tokens, cursor, "máy_fstat") == 1) { trả về 57; };
    nếu (tok_equals(src, tokens, cursor, "máy_sha_bắt_đầu") == 1) { trả về 58; };
    nếu (tok_equals(src, tokens, cursor, "máy_sha_nạp") == 1) { trả về 59; };
    nếu (tok_equals(src, tokens, cursor, "máy_sha_kết") == 1) { trả về 60; };
    nếu (tok_equals(src, tokens, cursor, "máy_báo_cáo_cache") == 1) { trả về 61; };
    trả về -1;
};

hàm p_native_arity(id) {
    nếu (id == 0) { trả về 0; };
    nếu (id == 1) { trả về 1; };
    nếu (id == 2) { trả về 2; };
    nếu (id == 3) { trả về 2; };
    nếu (id == 4) { trả về 2; };
    nếu (id == 5) { trả về 2; };
    nếu (id == 6) { trả về 3; };
    nếu (id == 7) { trả về 1; };
    nếu (id == 8) { trả về 2; };
    nếu (id == 9) { trả về 2; };
    nếu (id == 10) { trả về 1; };
    nếu (id == 11) { trả về 0; };
    nếu (id == 12) { trả về 1; };
    nếu (id == 13) { trả về 1; };
    nếu (id == 14) { trả về 2; };
    nếu (id == 15) { trả về 1; };
    nếu (id == 16) { trả về 3; };
    nếu (id == 17) { trả về 3; };
    nếu (id == 18) { trả về 2; };
    nếu (id == 19) { trả về 2; };
    nếu (id == 20) { trả về 3; };
    nếu (id == 21) { trả về 2; };
    nếu (id == 22) { trả về 1; };
    nếu (id == 23) { trả về 1; };
    nếu (id == 24) { trả về 2; };
    nếu (id == 25) { trả về 1; };
    nếu (id == 26) { trả về 2; };
    nếu (id == 27) { trả về 1; };
    nếu (id == 28) { trả về 2; };
    nếu (id == 29) { trả về 2; };
    nếu (id == 30) { trả về 2; };
    nếu (id == 31) { trả về 3; };
    nếu (id == 32) { trả về 3; };
    nếu (id == 33) { trả về 1; };
    nếu (id == 34) { trả về 0; };
    nếu (id == 35) { trả về 1; };
    nếu (id == 36) { trả về 2; };
    nếu (id == 37) { trả về 2; };
    nếu (id == 38) { trả về 0; };
    nếu (id == 39) { trả về 1; };
    nếu (id == 40) { trả về 0; };
    nếu (id == 41) { trả về 0; };
    nếu (id == 42) { trả về 1; };
    nếu (id == 43) { trả về 2; };
    nếu (id == 44) { trả về 1; };
    nếu (id == 45) { trả về 1; };
    nếu (id == 46) { trả về 1; };
    nếu (id == 47) { trả về 2; };
    nếu (id == 48) { trả về 1; };
    nếu (id == 49) { trả về 2; };
    nếu (id == 50) { trả về 2; };
    nếu (id == 51) { trả về 2; };
    nếu (id == 52) { trả về 1; };
    nếu (id == 53) { trả về 1; };
    nếu (id == 54) { trả về 2; };
    nếu (id == 55) { trả về 1; };
    nếu (id == 56) { trả về 1; };
    nếu (id == 57) { trả về 2; };
    nếu (id == 58) { trả về 0; };
    nếu (id == 59) { trả về 2; };
    nếu (id == 60) { trả về 1; };
    nếu (id == 61) { trả về 0; };
    trả về -1;
};

hàm p_primary(src, tokens, state, ir) {
    biến cursor = byte_đọc_i32(state, 0);
    biến kind = tok_field(tokens, cursor, 2);
    nếu (tok_equals(src, tokens, cursor, "đúng") == 1) {
        byte_ghi_i32(state, 0, cursor + 1);
        trả về p_emit(ir, 1, 1);
    };
    nếu (tok_equals(src, tokens, cursor, "sai") == 1) {
        byte_ghi_i32(state, 0, cursor + 1);
        trả về p_emit(ir, 1, 0);
    };
    nếu (kind == 2) {
        biến value = p_number(src, tok_field(tokens, cursor, 0), tok_field(tokens, cursor, 1));
        nếu (value < 0) { trả về -1; };
        byte_ghi_i32(state, 0, cursor + 1);
        trả về p_emit(ir, 1, value);
    };
    nếu (kind == 4) {
        biến begin = tok_field(tokens, cursor, 0) + 1;
        biến end = tok_field(tokens, cursor, 1) - 1;
        byte_ghi_i32(state, 0, cursor + 1);
