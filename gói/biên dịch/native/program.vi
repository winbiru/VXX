// Multiple i32 functions. Each body keeps its own IR and
// local variable slots. Function table records are six i32 values:
// declaration token, name start/end (source bytes), IR start/length, arity.
hàm pg_collect(src, tokens, functions) {
    biến entry_count = 0;
    lặp (i = 0; i < tok_count(tokens); i++) {
        nếu (tok_equals(src, tokens, i, "hàm") == 1) {
            biến arity = p_header_arity(src, tokens, i);
            nếu (arity < 0) { trả về -1; };
            biến name_start = tok_field(tokens, i + 1, 0);
            biến name_end = tok_field(tokens, i + 1, 1);
            biến count = 0;
            lặp (k = 0; k < byte_dài(functions); k = k + 24) {
                nếu (p_same_token(src, tokens, i + 1,
                        byte_đọc_i32(functions, k) + 1) == 1) { trả về -1; };
                count = count + 1;
            };
            // Function count is bounded by the byte-buffer capacity, not
            // an arbitrary small limit. The table uses 24 bytes per entry.
            nếu (byte_dài(functions) > 1048576 - 24) { trả về -1; };
            nếu (tok_equals(src, tokens, i + 1, "chính") == 1) {
                nếu (arity != 0) { trả về -1; };
                entry_count = entry_count + 1;
                nếu (entry_count > 1) { trả về -1; };
            };
            nếu (byte_đẩy_i32(functions, i) != 0) { trả về -1; };
            nếu (byte_đẩy_i32(functions, name_start) != 0) { trả về -1; };
            nếu (byte_đẩy_i32(functions, name_end) != 0) { trả về -1; };
            nếu (byte_đẩy_i32(functions, -1) != 0) { trả về -1; };
            nếu (byte_đẩy_i32(functions, -1) != 0) { trả về -1; };
            nếu (byte_đẩy_i32(functions, arity) != 0) { trả về -1; };
        };
    };
    nếu (byte_dài(functions) < 24) { trả về -1; };
    nếu (entry_count != 1) { trả về -1; };
    trả về byte_dài(functions);
};

// Object writer needs the declaration-order ID of the entrypoint. Calls
// retain declaration-order IDs even when 'chính' is in the middle or end.
hàm pg_entry(src, tokens, functions) {
    biến id = 0;
    lặp (record = 0; record < byte_dài(functions); record = record + 24) {
        biến declaration = byte_đọc_i32(functions, record);
        nếu (tok_equals(src, tokens, declaration + 1, "chính") == 1) { trả về id; };
        id = id + 1;
    };
    trả về -1;
};

hàm pg_body(src, tokens, state, ir) {
    nếu (p_take(src, tokens, state, "hàm") != 1) { trả về -1; };
    biến name_index = byte_đọc_i32(state, 0);
    nếu (p_identifier(src, tokens, name_index) != 1) { trả về -1; };
    byte_ghi_i32(state, 0, name_index + 1);
    nếu (p_take(src, tokens, state, "(") != 1) { trả về -1; };
    biến arg = 0;
    lặp (i = 0; i < tok_count(tokens); i++) {
        biến cursor = byte_đọc_i32(state, 0);
        nếu (tok_equals(src, tokens, cursor, ")") == 1) { thoát; };
        nếu (p_identifier(src, tokens, cursor) != 1) { trả về -1; };
        nếu (p_symbol(src, tokens, state, cursor) >= 0) { trả về -1; };
        nếu (p_emit(ir, 18, arg) != 0) { trả về -1; }; // ARG from incoming stack
        nếu (p_emit(ir, 3, arg) != 0) { trả về -1; };
        nếu (byte_đẩy_i32(state, tok_field(tokens, cursor, 0)) != 0) { trả về -1; };
        nếu (byte_đẩy_i32(state, tok_field(tokens, cursor, 1)) != 0) { trả về -1; };
        arg = arg + 1;
        byte_ghi_i32(state, 4, arg);
        byte_ghi_i32(state, 0, cursor + 1);
        nếu (tok_equals(src, tokens, cursor + 1, ")") == 1) { thoát; };
        nếu (p_take(src, tokens, state, ",") != 1) { trả về -1; };
    };
    nếu (p_take(src, tokens, state, ")") != 1) { trả về -1; };
    nếu (p_take(src, tokens, state, "{") != 1) { trả về -1; };
    lặp (i = 0; i < tok_count(tokens); i++) {
        nếu (p_take(src, tokens, state, "}") == 1) {
            nếu (byte_đọc_i32(state, 8) != 1) { trả về -1; };
            p_take(src, tokens, state, ";");
            trả về byte_đọc_i32(state, 0);
        };
        nếu (byte_đọc_i32(state, 8) != 0) { trả về -1; };
        nếu (byte_đọc_i32(state, 0) >= tok_count(tokens)) { trả về -1; };
        nếu (p_statement(src, tokens, state, ir) != 0) { trả về -1; };
    };
    trả về -1;
};

// No output on failure. IR branch offsets are relative to each function.
hàm pg_compile(src, tokens, ir, functions) {
    nếu (src == tokens) { trả về -1; };
    nếu (ir == functions) { trả về -1; };
    nếu (ir == src) { trả về -1; };
    nếu (ir == tokens) { trả về -1; };
    nếu (functions == src) { trả về -1; };
    nếu (functions == tokens) { trả về -1; };
    nếu (byte_làm_rỗng(ir) != 0) { trả về -1; };
    nếu (byte_làm_rỗng(functions) != 0) { trả về -1; };
    nếu (tok_validate(src, tokens) < 0) { trả về -1; };
    biến status = pg_collect(src, tokens, functions);
    nếu (status > 0) {
        biến cursor = 0;
        biến count = 0;
        lặp (record = 0; record < byte_dài(functions); record = record + 24) {
            nếu (cursor != byte_đọc_i32(functions, record)) { status = -1; thoát; };
            biến state = byte_mới();
            biến unit = byte_mới();
            nếu (state <= 0) { status = -1; thoát; };
            nếu (unit <= 0) { byte_hủy(state); status = -1; thoát; };
            byte_đẩy_i32(state, cursor);
            byte_đẩy_i32(state, 0);
            byte_đẩy_i32(state, 0);
            byte_đẩy_i32(state, 0);
            byte_đẩy_i32(state, 0);
            biến next = pg_body(src, tokens, state, unit);
            nếu (next < 0) { status = -1; }
            hoặc {
                nếu (byte_dài(unit) <= 0) { status = -1; }
                hoặc {
                    biến start = byte_dài(ir);
                    nếu (byte_nối(ir, unit) != 0) { status = -1; }
                    hoặc {
                        byte_ghi_i32(functions, record + 12, start);
                        byte_ghi_i32(functions, record + 16, byte_dài(unit));
                        cursor = next;
                    };
                };
            };
            byte_hủy(state);
            byte_hủy(unit);
            nếu (status < 0) { thoát; };
            count = count + 1;
        };
        nếu (cursor != tok_count(tokens)) { status = -1; };
    };
    nếu (status < 0) {
        byte_làm_rỗng(ir);
        byte_làm_rỗng(functions);
        trả về -1;
    };
    trả về byte_dài(ir);
};
