hàm native_read_source(path, source) {
    biến file = tệp_mở_đọc(path);
    nếu (file <= 0) { trả về -1; };
    biến complete = 0;
    lặp (i = 0; i < 300; i++) {
        biến count = tệp_đọc_khối(file, source);
        nếu (count < 0) { thoát; };
        nếu (count == 0) { complete = 1; thoát; };
    };
    nếu (tệp_đóng(file) != 0) { trả về -1; };
    nếu (complete != 1) { trả về -1; };
    trả về byte_dài(source);
};

// The self-host executable discovers Linux from procfs. This works for the
// Stage 0 bootstrap and every later generation without a VM/platform API.
hàm native_is_linux() {
    biến path = "/proc/self/exe";
    biến handle = tệp_mở_đọc(path);
    byte_hủy(path);
    nếu (handle <= 0) { trả về 0; };
    tệp_đóng(handle);
    trả về 1;
};

hàm native_build(source_path, executable_path) {
    biến linux = native_is_linux();
    biến source = byte_mới();
    biến ir = byte_mới();
    biến functions = byte_mới();
    biến code = byte_mới();
    biến object = byte_mới();
    biến external_calls = byte_mới();
    biến registry = byte_mới();
    biến module_ends = byte_mới();
    biến starts = byte_mới();
    biến imports = byte_mới();
    biến object_archive = byte_mới();
    biến unit_source = byte_mới();
    nếu (source <= 0) { trả về 11; };
    nếu (ir <= 0) { trả về 11; };
    nếu (functions <= 0) { trả về 11; };
    nếu (code <= 0) { trả về 11; };
    nếu (object <= 0) { trả về 11; };
    nếu (external_calls <= 0) { trả về 11; };
    nếu (registry <= 0) { trả về 11; };
    nếu (module_ends <= 0) { trả về 11; };
    nếu (starts <= 0) { trả về 11; };
    nếu (imports <= 0) { trả về 11; };
    nếu (object_archive <= 0) { trả về 11; };
    nếu (unit_source <= 0) { trả về 11; };

    biến status = 0;
    biến entry_id = -1;
    nếu (nm_prepare(source_path, source) <= 0) { status = 12; };
    nếu (status == 0) {
        entry_id = mc_compile_modules(source, ir, functions, registry, module_ends) - 1;
        nếu (entry_id < 0) { status = 14; };
    };
    nếu (status == 0) {
        biến first = 0;
        biến source_offset = 0;
        lặp (unit = 0; unit < byte_dài(module_ends); unit = unit + 4) {
            biến last = byte_đọc_i32(module_ends, unit);
            nếu (last < first) { status = 14; thoát; };
            source_offset = mc_read_unit(source, source_offset, unit_source);
            nếu (source_offset < 0) { status = 14; thoát; };
            nếu (last > first) {
                biến format = 2;
                nếu (linux == 1) { format = 3; };
                biến key = nc_key(format, unit_source, registry, first, last, entry_id);
                biến cached = 0;
                nếu (key > 0) { cached = cache_đọc(key, object); };
                nếu (cached != 1) {
                    biến generated = -1;
                    nếu (linux == 1) {
                        generated = xgp_emit_module(ir, functions, code, first, last, starts, imports, external_calls);
                    } hoặc {
                        generated = cgp_emit_module(ir, functions, code, first, last, starts, imports, external_calls);
                    };
                    nếu (generated <= 0) {
                        status = 15;
                    }
                    hoặc {
                        biến emitted = -1;
                        nếu (linux == 1) {
                            emitted = elf_module(code, object, starts, registry, first, last, entry_id, imports, external_calls);
                        } hoặc {
                            emitted = om_macho_module(code, object, starts, registry, first, last, entry_id, imports, external_calls);
                        };
                        nếu (emitted <= 0) {
                            status = 16;
                        };
                    };
                    nếu (status == 0) {
                        nếu (key > 0) { cache_ghi(key, object); };
                    };
                };
                nếu (key > 0) { byte_hủy(key); };
                nếu (status != 0) { thoát; };
                nếu (byte_đẩy_i32(object_archive, byte_dài(object)) != 0) { status = 16; thoát; };
                nếu (byte_nối(object_archive, object) != 0) { status = 16; thoát; };
            };
            first = last;
        };
        nếu (byte_dài(object_archive) <= 0) { status = 16; };
    };
    nếu (status == 0) {
        nếu (liên_kết_đối_tượng(object_archive, executable_path, source_path) != 0) { status = 17; };
    };

    byte_hủy(source);
    byte_hủy(ir);
    byte_hủy(functions);
    byte_hủy(code);
    byte_hủy(object);
    byte_hủy(external_calls);
    byte_hủy(registry);
    byte_hủy(module_ends);
    byte_hủy(starts);
    byte_hủy(imports);
    byte_hủy(object_archive);
    byte_hủy(unit_source);
    trả về status;
};

hàm chính() {
    nếu (đối_số_đếm() != 5) { trả về 2; };
    biến command = đối_số_lấy(1);
    biến source = đối_số_lấy(2);
    biến option = đối_số_lấy(3);
    biến output = đối_số_lấy(4);
    nếu (command <= 0) { trả về 2; };
    nếu (source <= 0) { trả về 2; };
    nếu (option <= 0) { trả về 2; };
    nếu (output <= 0) { trả về 2; };
    biến build_literal = "build";
    biến option_literal = "-o";
    biến good = 1;
    nếu (byte_bằng(command, build_literal) != 1) { good = 0; };
    nếu (byte_bằng(option, option_literal) != 1) { good = 0; };
    biến result = 2;
    nếu (good == 1) { result = native_build(source, output); };
    byte_hủy(build_literal);
    byte_hủy(option_literal);
    byte_hủy(command);
    byte_hủy(source);
    byte_hủy(option);
    byte_hủy(output);
    trả về result;
};

