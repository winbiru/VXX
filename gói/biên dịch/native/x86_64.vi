// Standalone Linux x86-64 System V lowering for the validated i32 IR.
// Internal V++ calls and C runtime calls share the SysV register/stack ABI.
// CALL fixups point to the rel32 field (immediately after opcode E8).
hàm xg_byte(out, value) { trả về byte_thêm(out, value); };

hàm xg_imm(out, value) { trả về byte_đẩy_i32(out, value); };

hàm xg_frame(out, amount, subtract) {
    nếu (amount == 0) { trả về 0; };
    nếu (xg_byte(out, 72) != 0) { trả về -1; };
    nếu (xg_byte(out, 129) != 0) { trả về -1; };
    nếu (subtract == 1) {
        nếu (xg_byte(out, 236) != 0) { trả về -1; };
    } hoặc {
        nếu (xg_byte(out, 196) != 0) { trả về -1; };
    };
    trả về xg_imm(out, amount);
};

// slot N is [rbp - 4*(N+1)]. Registers: eax=0, ecx=1, edx=2,
// esi=6, edi=7, r8d=8, r9d=9. Always use signed disp32.
hàm xg_memory(out, reg, slot, load) {
    nếu (slot < 0) { trả về -1; };
    nếu (slot > 260000) { trả về -1; };
    nếu (reg >= 8) { nếu (xg_byte(out, 68) != 0) { trả về -1; }; };
    biến opcode = 137;
    nếu (load == 1) { opcode = 139; };
    nếu (xg_byte(out, opcode) != 0) { trả về -1; };
    biến encoding = reg;
    nếu (reg >= 8) { encoding = reg - 8; };
    nếu (xg_byte(out, 133 + encoding * 8) != 0) { trả về -1; };
    trả về xg_imm(out, -4 * (slot + 1));
};

hàm xg_load(out, reg, slot) { trả về xg_memory(out, reg, slot, 1); };
hàm xg_store(out, reg, slot) { trả về xg_memory(out, reg, slot, 0); };

hàm xg_arg_reg(index) {
    nếu (index == 0) { trả về 7; };
    nếu (index == 1) { trả về 6; };
    nếu (index == 2) { trả về 2; };
    nếu (index == 3) { trả về 1; };
    nếu (index == 4) { trả về 8; };
    nếu (index == 5) { trả về 9; };
    trả về -1;
};

// Incoming stack args start at [rbp+16]. The caller reserves 8 bytes each.
hàm xg_load_param(out, index) {
    nếu (index < 6) {
        biến reg = xg_arg_reg(index);
        nếu (reg >= 8) { nếu (xg_byte(out, 68) != 0) { trả về -1; }; };
        nếu (xg_byte(out, 137) != 0) { trả về -1; };
        biến encoding = reg;
        nếu (reg >= 8) { encoding = reg - 8; };
        trả về xg_byte(out, 192 + encoding * 8); // mov eax, arg register
    };
    nếu (xg_byte(out, 139) != 0) { trả về -1; };
    nếu (xg_byte(out, 133) != 0) { trả về -1; };
    trả về xg_imm(out, 16 + 8 * (index - 6));
};

hàm xg_call(out, calls, target) {
    nếu (xg_byte(out, 232) != 0) { trả về -1; };
    nếu (xg_imm(calls, byte_dài(out)) != 0) { trả về -1; };
    nếu (xg_imm(calls, target) != 0) { trả về -1; };
    trả về xg_imm(out, 0);
};

// Displacements are signed 32-bit and relative to the byte after rel32.
hàm xg_patch_branches(ir, code, offsets, fixups) {
    lặp (i = 0; i < byte_dài(fixups); i = i + 8) {
        biến from = byte_đọc_i32(fixups, i);
        biến target = byte_đọc_i32(fixups, i + 4);
        nếu (cg_branch_target(ir, target) != 1) { trả về -1; };
        // Each instruction owns eight bytes in offsets; the IR byte offset
        // is therefore a direct index without division in the bootstrap IR.
        biến to = byte_đọc_i32(offsets, target);
        nếu (byte_ghi_i32(code, from, to - from - 4) != 0) { trả về -1; };
    };
    trả về 0;
};

hàm xg_emit_internal(ir, code, calls) {
    nếu (ir == code) { trả về -1; };
    nếu (byte_làm_rỗng(code) != 0) { trả về -1; };
    biến frame = cg_frame(ir);
    nếu (frame < 0) { trả về -1; };
    biến slots = cg_slots(ir);
    biến depth = 0;
    biến offsets = byte_mới();
    biến fixups = byte_mới();
    nếu (offsets <= 0) { trả về -1; };
    nếu (fixups <= 0) { byte_hủy(offsets); trả về -1; };
    biến status = xg_byte(code, 85); // push rbp
    nếu (status == 0) { status = xg_byte(code, 72); };
    nếu (status == 0) { status = xg_byte(code, 137); };
    nếu (status == 0) { status = xg_byte(code, 229); }; // mov rbp,rsp
    nếu (status == 0) { status = xg_frame(code, frame, 1); };
    biến pending = -1;
    lặp (pc = 0; pc < byte_dài(ir); pc = pc + 8) {
        nếu (status != 0) { thoát; };
        nếu (xg_imm(offsets, byte_dài(code)) != 0) { status = -1; thoát; };
        nếu (xg_imm(offsets, 0) != 0) { status = -1; thoát; };
        biến op = byte_đọc_i32(ir, pc);
        biến arg = byte_đọc_i32(ir, pc + 4);
        biến offset = slots + depth;
        nếu (op == 1) {
            status = xg_byte(code, 184); // mov eax, imm32
            nếu (status == 0) { status = xg_imm(code, arg); };
            nếu (status == 0) { status = xg_store(code, 0, offset); };
            depth = depth + 1;
        }
        hoặc nếu (op == 2) {
            status = xg_load(code, 0, arg);
            nếu (status == 0) { status = xg_store(code, 0, offset); };
            depth = depth + 1;
        }
        hoặc nếu (op == 3) {
            depth = depth - 1;
            status = xg_load(code, 0, slots + depth);
            nếu (status == 0) { status = xg_store(code, 0, arg); };
        }
        hoặc nếu (cg_binary(op) == 1) {
            depth = depth - 1;
            status = xg_load(code, 0, slots + depth - 1);
            nếu (status == 0) { status = xg_load(code, 1, slots + depth); };
            nếu (status == 0) {
                nếu (op == 4) { status = xg_byte(code, 1); };
                nếu (op == 5) { status = xg_byte(code, 41); };
                nếu (op == 6) {
                    status = xg_byte(code, 15);
                    nếu (status == 0) { status = xg_byte(code, 175); };
                };
                nếu (op == 26) {
                    // Signed 64-bit IDIV keeps INT32_MIN / -1 defined as
                    // wrapped i32, matching AArch64 SDIV. Zero traps in IDIV.
                    status = xg_byte(code, 72); // movsxd rax,eax
                    nếu (status == 0) { status = xg_byte(code, 99); };
                    nếu (status == 0) { status = xg_byte(code, 192); };
                    nếu (status == 0) { status = xg_byte(code, 72); }; // cqo
                    nếu (status == 0) { status = xg_byte(code, 153); };
                    nếu (status == 0) { status = xg_byte(code, 72); }; // movsxd rcx,ecx
                    nếu (status == 0) { status = xg_byte(code, 99); };
                    nếu (status == 0) { status = xg_byte(code, 201); };
                    nếu (status == 0) { status = xg_byte(code, 72); }; // idiv rcx
                    nếu (status == 0) { status = xg_byte(code, 247); };
                    nếu (status == 0) { status = xg_byte(code, 249); };
                };
                nếu (op == 27) {
                    status = xg_byte(code, 72); // movsxd rax,eax
                    nếu (status == 0) { status = xg_byte(code, 99); };
                    nếu (status == 0) { status = xg_byte(code, 192); };
                    nếu (status == 0) { status = xg_byte(code, 72); }; // cqo
                    nếu (status == 0) { status = xg_byte(code, 153); };
                    nếu (status == 0) { status = xg_byte(code, 72); }; // movsxd rcx,ecx
                    nếu (status == 0) { status = xg_byte(code, 99); };
                    nếu (status == 0) { status = xg_byte(code, 201); };
                    nếu (status == 0) { status = xg_byte(code, 72); }; // idiv rcx
                    nếu (status == 0) { status = xg_byte(code, 247); };
                    nếu (status == 0) { status = xg_byte(code, 249); };
                    nếu (status == 0) { status = xg_byte(code, 137); }; // mov eax,edx
                    nếu (status == 0) { status = xg_byte(code, 208); };
                };
                nếu (op <= 6) {
                    biến modrm = 200; // add/sub eax,ecx
                    nếu (op == 6) { modrm = 193; }; // imul eax,ecx
                    nếu (status == 0) { status = xg_byte(code, modrm); };
                };
                nếu (op >= 11) { nếu (op <= 16) {
                    status = xg_byte(code, 57); // cmp eax,ecx
                    nếu (status == 0) { status = xg_byte(code, 200); };
                    nếu (status == 0) { status = xg_byte(code, 15); };
                    biến condition = 148;
                    nếu (op == 12) { condition = 149; };
                    nếu (op == 13) { condition = 156; };
                    nếu (op == 14) { condition = 158; };
                    nếu (op == 15) { condition = 159; };
                    nếu (op == 16) { condition = 157; };
                    nếu (status == 0) { status = xg_byte(code, condition); };
                    nếu (status == 0) { status = xg_byte(code, 192); };
                    nếu (status == 0) { status = xg_byte(code, 15); };
                    nếu (status == 0) { status = xg_byte(code, 182); };
                    nếu (status == 0) { status = xg_byte(code, 192); };
                }; };
            };
            nếu (status == 0) { status = xg_store(code, 0, slots + depth - 1); };
        }
        hoặc nếu (op == 8) {
            status = xg_load(code, 0, slots + depth - 1);
            nếu (status == 0) { status = xg_byte(code, 247); };
            nếu (status == 0) { status = xg_byte(code, 216); };
            nếu (status == 0) { status = xg_store(code, 0, slots + depth - 1); };
        }
        hoặc nếu (op == 25) {
            // test eax,eax; sete al; movzx eax,al
            status = xg_load(code, 0, slots + depth - 1);
            nếu (status == 0) { status = xg_byte(code, 133); };
            nếu (status == 0) { status = xg_byte(code, 192); };
            nếu (status == 0) { status = xg_byte(code, 15); };
            nếu (status == 0) { status = xg_byte(code, 148); };
            nếu (status == 0) { status = xg_byte(code, 192); };
            nếu (status == 0) { status = xg_byte(code, 15); };
            nếu (status == 0) { status = xg_byte(code, 182); };
            nếu (status == 0) { status = xg_byte(code, 192); };
            nếu (status == 0) { status = xg_store(code, 0, slots + depth - 1); };
        }
        hoặc nếu (op == 7) {
            status = xg_load(code, 0, slots + depth - 1);
            nếu (status == 0) { status = xg_byte(code, 201); }; // leave
            nếu (status == 0) { status = xg_byte(code, 195); }; // ret
            depth = 0;
        }
        hoặc nếu (op == 18) {
            status = xg_load_param(code, arg);
            nếu (status == 0) { status = xg_store(code, 0, offset); };
            depth = depth + 1;
        }
        hoặc nếu (op == 19) { pending = arg; }
        hoặc nếu (op == 22) {
            nếu (calls <= 0) { status = -1; };
            nếu (status == 0) { status = xg_call(code, calls, -1); };
            nếu (status == 0) { status = xg_store(code, 0, offset); };
            depth = depth + 1;
        }
        hoặc nếu (op == 23) {
            nếu (calls <= 0) { status = -1; };
            nếu (status == 0) { status = xg_load(code, 7, slots + depth - 1); };
            nếu (status == 0) { status = xg_byte(code, 190); }; // mov esi,imm32
            nếu (status == 0) { status = xg_imm(code, arg); };
            nếu (status == 0) { status = xg_call(code, calls, -4); };
        }
        hoặc nếu (op == 24) { depth = depth - 1; }
        hoặc nếu (op == 17) {
            nếu (calls <= 0) { status = -1; };
            biến extra = pending - 6;
            nếu (extra < 0) { extra = 0; };
            biến outgoing = 0;
            // Round outgoing stack arguments to a 16-byte boundary.
            lặp (k = 0; k < extra; k = k + 2) { outgoing = outgoing + 16; };
            nếu (status == 0) { status = xg_frame(code, outgoing, 1); };
            lặp (j = 6; j < pending; j++) {
                nếu (status != 0) { thoát; };
                status = xg_load(code, 0, slots + depth - pending + j);
                nếu (status == 0) { status = xg_byte(code, 137); };
                nếu (status == 0) { status = xg_byte(code, 132); };
                nếu (status == 0) { status = xg_byte(code, 36); };
                nếu (status == 0) { status = xg_imm(code, (j - 6) * 8); };
            };
            biến regcount = pending;
            nếu (regcount > 6) { regcount = 6; };
            lặp (j = 0; j < regcount; j++) {
                nếu (status != 0) { thoát; };
                status = xg_load(code, xg_arg_reg(j), slots + depth - pending + j);
            };
            nếu (status == 0) { status = xg_call(code, calls, arg); };
            nếu (status == 0) { status = xg_frame(code, outgoing, 0); };
            depth = depth - pending + 1;
            nếu (status == 0) { status = xg_store(code, 0, slots + depth - 1); };
            pending = -1;
        }
        hoặc nếu (op == 9) {
            depth = depth - 1;
            status = xg_load(code, 0, slots + depth);
            nếu (status == 0) { status = xg_byte(code, 133); };
            nếu (status == 0) { status = xg_byte(code, 192); }; // test eax,eax
            nếu (status == 0) { status = xg_byte(code, 15); };
            nếu (status == 0) { status = xg_byte(code, 132); }; // je rel32
            nếu (status == 0) { status = xg_imm(fixups, byte_dài(code)); };
            nếu (status == 0) { status = xg_imm(fixups, arg); };
            nếu (status == 0) { status = xg_imm(code, 0); };
        }
        hoặc nếu (op == 10) {
            status = xg_byte(code, 233); // jmp rel32
            nếu (status == 0) { status = xg_imm(fixups, byte_dài(code)); };
            nếu (status == 0) { status = xg_imm(fixups, arg); };
            nếu (status == 0) { status = xg_imm(code, 0); };
        };
    };
    nếu (status == 0) { status = xg_patch_branches(ir, code, offsets, fixups); };
    byte_hủy(offsets);
    byte_hủy(fixups);
    nếu (status != 0) { byte_làm_rỗng(code); trả về -1; };
    trả về byte_dài(code);
};
