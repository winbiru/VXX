        nếu (vm_get(frame, 60) == slot + 1) { trả về frame + 244; };
        nếu (vm_get(frame, 63) == slot + 1) { trả về frame + 256; };
        nếu (vm_get(frame, 66) == slot + 1) { trả về frame + 268; };
        nếu (vm_get(frame, 69) == slot + 1) { trả về frame + 280; };
        nếu (vm_get(frame, 72) == slot + 1) { trả về frame + 292; };
        nếu (vm_get(frame, 75) == slot + 1) { trả về frame + 304; };
        nếu (vm_get(frame, 78) == slot + 1) { trả về frame + 316; };
        nếu (vm_get(frame, 81) == slot + 1) { trả về frame + 328; };
        biến cached = vm_get(frame, 10);
        nếu (cached != 0 && vm_get(frame, 32) == slot) { trả về cached; };
        cached = vm_get(frame, 12);
        nếu (cached != 0 && vm_get(frame, 33) == slot) { trả về cached; };
        cached = vm_get(frame, 13);
        nếu (cached != 0 && vm_get(frame, 34) == slot) { trả về cached; };
        cached = vm_get(frame, 14);
        nếu (cached != 0 && vm_get(frame, 35) == slot) { trả về cached; };
    };
