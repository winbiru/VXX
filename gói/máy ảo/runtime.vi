hàm vm_load_slot(state, frame, slot) {
    biến cell = vm_cell(state, frame, slot, 0);
    nếu (cell == 0) {
        cell = vm_alloc(16, 1); nếu (cell == 0) { trả về 0; }; vm_set(cell, 0, 10); vm_set(cell, 1, vm_int(0));
        vm_map_put(vm_get(state, 4), vm_int(slot), cell);
    };
    // Ô i32 nội tuyến chỉ được đóng hộp khi đi qua đường giá trị động.
    nếu (vm_get(cell, 0) == 12) {
