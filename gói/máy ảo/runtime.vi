// i32 truyền bằng thanh ghi sẽ ở dạng thô trong ô khung. Trì hoãn vm_int
// cho đến khi giá trị phải thoát ra đường động hoặc bị closure bắt giữ.
hàm vm_bind_i32(frame, slot, number) {
    nếu (slot >= 0 && slot < 32767 && vm_get(frame, 9) == 0 && vm_get(frame, 3) == 0) {
