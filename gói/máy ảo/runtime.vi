// Runtime policy: cells, scopes, arity, closure capture, classes, visibility,
// exception unwinding and explicit guest frames are implemented in V++.
hàm vm_host_cached(state, index) {
    biến strings = vm_get(state, 0);
    nếu (index < 0 || index >= vm_get(strings, 1)) { vm_error(12); trả về -1; };
    biến cache = vm_get(state, 10);
    biến entry = vm_get(cache, index);
    nếu (entry == 0) {
        entry = vm_host_name(vm_at(strings, index)) + 2;
        vm_set(cache, index, entry);
    };
    trả về entry - 2;
};
hàm vm_empty_args() {
    // Tái sử dụng danh sách tham số rỗng. Ô 4112 trong bộ đệm i32 được GC theo dõi.
    biến cache = vm_get(4198464, 17);
    nếu (cache == 0) {
        vm_int(0);
        cache = vm_get(4198464, 17);
        nếu (cache == 0) { trả về 0; };
    };
    biến empty = vm_get(cache, 4112);
    nếu (empty == 0) {
        empty = vm_vector(4);
        vm_set(cache, 4112, empty);
    };
    trả về empty;
};
hàm vm_take(stack, count) {
    biến n = vm_get(stack, 1);
    nếu (count < 0 || count > n) { trả về vm_error(5); };
    nếu (count == 0) { trả về vm_empty_args(); };
    biến args = vm_vector(4); biến start = n - count;
    biến data = vm_get(stack, 3);
    // Keep arguments reachable from the stack while vm_append may allocate.
    lặp(i = start; i < n; i++) { vm_append(args, vm_get(data, i)); };
    lặp(i = start; i < n; i++) { vm_set(data, i, 0); };
    vm_set(stack, 1, start);
    trả về args;
};
hàm vm_frame_init(frame, code, args, receiver, owner, captures, global) {
    // Ô 10, 12, 13, 14 giữ bốn ô biến; ô 32..35 giữ khóa của từng khung.
    // Không ghi khóa vào ô biến: closure có thể dùng chung ô giữa các khung.
    // Khung khởi tạo vẫn dùng ô 10 để giữ đối tượng đang dựng (loại khung 2).
    // Gộp khung, ngăn xếp bốn phần tử, bốn đối số và các ô cục bộ nóng.
    // Ba khóa nằm trực tiếp ở [15], [43] và [40]. Không cần dịch bit.
    // [36..37], [38..39] và [41..42] giữ kiểu và giá trị từng ô.
    // Tách hẳn khỏi dữ liệu ngăn xếp [20..23] và đối số [28..31].
    // [44..46] là khóa, kiểu và giá trị ô cục bộ thứ tư.
    // Khung 336 byte được GC quét, kể cả khi tái sử dụng. Mười sáu ô nội tuyến
    // giữ biến cục bộ nóng trên khung thay vì tạo scope/cell heap.
    biến stack = frame + 64;
    biến direct_args = frame + 96;
    // [20..23] nằm trọn trong khung. Tránh cấp phát bộ đệm khi biểu thức
    // gọi gián tiếp hoặc dựng tham số cần giữ 3–4 giá trị cùng lúc.
    máy ghi số nguyên ba mươi hai bit(frame + 64, 4);
    máy ghi số nguyên ba mươi hai bit(frame + 72, 4);
    máy ghi số nguyên ba mươi hai bit(frame + 76, stack + 16);
    // [28..31] chứa bốn giá trị; không cần cấp phát danh sách đối số 3–4 phần tử.
    máy ghi số nguyên ba mươi hai bit(frame + 96, 4);
    máy ghi số nguyên ba mươi hai bit(frame + 104, 4);
    máy ghi số nguyên ba mươi hai bit(frame + 108, direct_args + 16);
    // Chỉ tạo bảng phạm vi khi hàm thật sự khai báo hoặc bắt giữ biến.
    // Địa chỉ của từng trường đã biết tại lúc biên dịch; ghi thẳng bằng ASM
    // để bỏ lớp gọi vm_set và phép nhân chỉ số trên mỗi lần vào hàm.
    máy ghi số nguyên ba mươi hai bit(frame, code);
    máy ghi số nguyên ba mươi hai bit(frame + 8, stack);
    máy ghi số nguyên ba mươi hai bit(frame + 16, args);
    máy ghi số nguyên ba mươi hai bit(frame + 20, receiver);
    máy ghi số nguyên ba mươi hai bit(frame + 24, owner);
    // Exception handlers and switch contexts are rare: allocate on first use.
    máy ghi số nguyên ba mươi hai bit(frame + 36, global);
    nếu (captures != 0 && vm_get(captures, 1) > 0) {
        vm_set(frame, 3, vm_vector(5));
        lặp(i = 0; i < vm_get(captures, 1); i = i + 2) { vm_map_put(vm_get(frame, 3), vm_at(captures, i), vm_at(captures, i + 1)); };
    };
    trả về frame;
};
hàm vm_frame(code, args, receiver, owner, captures, global) {
    biến frame = vm_alloc(336, 1); nếu (frame == 0) { trả về 0; };
    trả về vm_frame_init(frame, code, args, receiver, owner, captures, global);
};
// Xóa toàn bộ khung tái sử dụng, kể cả tham chiếu cũ mà GC có thể quét.
// Một lần xóa vùng nhớ tránh hàng chục lời gọi ghi i32 ở đường gọi nóng.
hàm vm_frame_reuse(frame, code, args, receiver, owner, captures) {
    máy xóa vùng nhớ(frame, 336);
    trả về vm_frame_init(frame, code, args, receiver, owner, captures, 0);
};
hàm vm_slot_cache_put(frame, slot, cell) {
    nếu (slot < 0 || cell == 0 || vm_get(frame, 9) != 0) { trả về 0; };
    nếu (vm_get(frame, 10) == cell && vm_get(frame, 32) == slot) { trả về 0; };
    biến old = vm_get(frame, 10);
    biến second = vm_get(frame, 12);
    biến third = vm_get(frame, 13);
    biến old_slot = vm_get(frame, 32);
    biến second_slot = vm_get(frame, 33);
    biến third_slot = vm_get(frame, 34);
    nếu (old_slot == slot) { old = 0; old_slot = -1; };
    nếu (second_slot == slot) { second = 0; second_slot = -1; };
    nếu (third_slot == slot) { third = 0; third_slot = -1; };
    vm_set(frame, 14, third);
    vm_set(frame, 35, third_slot);
    vm_set(frame, 13, second);
    vm_set(frame, 34, second_slot);
    vm_set(frame, 12, old);
    vm_set(frame, 33, old_slot);
    vm_set(frame, 10, cell);
    vm_set(frame, 32, slot);
    trả về 0;
};
// Bỏ ô tham số nội tuyến khi cùng slot được khai báo lại trong phạm vi.
// Tránh để đường đọc nhanh trả về giá trị đã bị che bởi ô mới.
hàm vm_drop_inline(frame, slot) {
    nếu (vm_get(frame, 15) == slot + 1) {
        vm_set(frame, 15, 0); vm_set(frame, 36, 0); vm_set(frame, 37, 0);
    } hoặc nếu (vm_get(frame, 43) == slot + 1) {
        vm_set(frame, 43, 0); vm_set(frame, 38, 0); vm_set(frame, 39, 0);
    } hoặc nếu (vm_get(frame, 40) == slot + 1) {
        vm_set(frame, 40, 0); vm_set(frame, 41, 0); vm_set(frame, 42, 0);
    } hoặc nếu (vm_get(frame, 44) == slot + 1) {
        vm_set(frame, 44, 0); vm_set(frame, 45, 0); vm_set(frame, 46, 0);
    } hoặc nếu (vm_get(frame, 47) == slot + 1) {
        vm_set(frame, 47, 0); vm_set(frame, 48, 0); vm_set(frame, 49, 0);
    } hoặc nếu (vm_get(frame, 50) == slot + 1) {
        vm_set(frame, 50, 0); vm_set(frame, 51, 0); vm_set(frame, 52, 0);
    } hoặc nếu (vm_get(frame, 53) == slot + 1) {
        vm_set(frame, 53, 0); vm_set(frame, 54, 0); vm_set(frame, 55, 0);
    } hoặc nếu (vm_get(frame, 56) == slot + 1) {
        vm_set(frame, 56, 0); vm_set(frame, 57, 0); vm_set(frame, 58, 0);
    } hoặc nếu (vm_get(frame, 60) == slot + 1) {
        vm_set(frame, 60, 0); vm_set(frame, 61, 0); vm_set(frame, 62, 0);
    } hoặc nếu (vm_get(frame, 63) == slot + 1) {
        vm_set(frame, 63, 0); vm_set(frame, 64, 0); vm_set(frame, 65, 0);
    } hoặc nếu (vm_get(frame, 66) == slot + 1) {
        vm_set(frame, 66, 0); vm_set(frame, 67, 0); vm_set(frame, 68, 0);
    } hoặc nếu (vm_get(frame, 69) == slot + 1) {
        vm_set(frame, 69, 0); vm_set(frame, 70, 0); vm_set(frame, 71, 0);
    } hoặc nếu (vm_get(frame, 72) == slot + 1) {
        vm_set(frame, 72, 0); vm_set(frame, 73, 0); vm_set(frame, 74, 0);
    } hoặc nếu (vm_get(frame, 75) == slot + 1) {
        vm_set(frame, 75, 0); vm_set(frame, 76, 0); vm_set(frame, 77, 0);
    } hoặc nếu (vm_get(frame, 78) == slot + 1) {
        vm_set(frame, 78, 0); vm_set(frame, 79, 0); vm_set(frame, 80, 0);
    } hoặc nếu (vm_get(frame, 81) == slot + 1) {
        vm_set(frame, 81, 0); vm_set(frame, 82, 0); vm_set(frame, 83, 0);
    };
    trả về 0;
};
hàm vm_cell(state, frame, slot, create) {
