            nếu (scope == 0) { trả về 0; };
            vm_set(frame, 3, scope);
        };
        vm_map_put(scope, vm_int(slot), cell);
        nếu (vm_get(frame, 9) != 1) { is_local = 1; };
    };
    nếu (is_local) { vm_slot_cache_put(frame, slot, cell); };
    trả về cell;
