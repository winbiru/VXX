        nếu (vm_get(frame, 15) == slot + 1) { trả về frame + 144; };
        nếu (vm_get(frame, 43) == slot + 1) { trả về frame + 152; };
        nếu (vm_get(frame, 40) == slot + 1) { trả về frame + 164; };
        nếu (vm_get(frame, 44) == slot + 1) { trả về frame + 180; };
        nếu (vm_get(frame, 47) == slot + 1) { trả về frame + 192; };
        nếu (vm_get(frame, 50) == slot + 1) { trả về frame + 204; };
        nếu (vm_get(frame, 53) == slot + 1) { trả về frame + 216; };
