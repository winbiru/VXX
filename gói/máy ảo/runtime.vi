hàm vm_store(state, frame, slot, value) {
    biến cell = vm_cell(state, frame, slot, 1); nếu (cell == 0) { trả về 0; };
    vm_set(cell, 1, value);
    nếu (vm_get(cell, 0) == 12) { vm_set(cell, 0, 10); };
    trả về 0;
};
hàm vm_bind(frame, slot, value) {
    biến scope = vm_get(frame, 3);
    nếu (scope == 0) {
        scope = vm_vector(5);
        nếu (scope == 0) { trả về 0; };
        vm_set(frame, 3, scope);
    };
    biến cell = vm_alloc(16, 1); nếu (cell == 0) { trả về 0; }; vm_set(cell, 0, 10); vm_set(cell, 1, value);
    vm_map_put(scope, vm_int(slot), cell);
    vm_drop_inline(frame, slot);
    vm_slot_cache_put(frame, slot, cell); trả về 0;
};
