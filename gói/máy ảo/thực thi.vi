    // Load the cells directly; vm_get is a separate V++ function call.
    khi (máy đọc số nguyên ba mươi hai bit(frames + 4) > 0 &&
         máy đọc số nguyên ba mươi hai bit(4198468) == 0) {
        nếu (profiling) { vm_step(state, frames); } hoặc { vm_step_body(state, frames); };
