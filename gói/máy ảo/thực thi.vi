        // V++ provider, so its retry/failover policy can close the socket and
        // try another server. Keep malformed arguments/OOM fatal, and keep
        // the main guest's existing machine-error contract unchanged.
        nếu (vm_get(4198464, 1) == 20 && state == vm_get(4198464, 4)) {
            vm_set(4198464, 1, 0);
            vm_throw(state, vm_literal("DNS: OS transport failed"));
        };
        nếu (profiling) {
            profile_steps = profile_steps + 1;
            nếu (profile_steps >= 250000) {
                biến current = 0; biến location = 0;
                nếu (vm_get(frames, 1) > 0) {
                    biến frame = vm_at(frames, vm_get(frames, 1) - 1);
                    current = vm_get(frame, 11); location = vm_get(frame, 1);
