        vm_append(vm_get(state, 6), vm_frame(vm_at(initializers, i), vm_empty_args(), 0, 0, 0, 1)); vm_execute(state);
        nếu (vm_get(4198464, 1) != 0) { trả về 0; };
    };
    vm_append(vm_get(state, 6), vm_frame(vm_get(state, 3), vm_empty_args(), 0, 0, 0, 1)); trả về vm_execute(state);
};
