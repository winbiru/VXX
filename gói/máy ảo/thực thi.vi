                biến message = vm_concat(vm_literal("vm-profile: steps=250000 function="), vm_integer_text(current));
                message = vm_concat(message, vm_concat(vm_literal(" pc="), vm_integer_text(location)));
                message = vm_concat(message, vm_concat(vm_literal(" allocations="), vm_integer_text(vm_get(4198464, 14))));
                message = vm_concat(message, vm_concat(vm_literal(" gc="), vm_integer_text(vm_get(4198464, 15))));
                message = vm_concat(message, vm_concat(vm_literal(" free-list-probes="), vm_integer_text(vm_get(4198464, 16))));
