// Native i32 V++ only: every memory access is an ASM primitive.
// Reserve byte slots 4..63. The byte/file runtime keeps slots 0..3.
// Header at 4198464; allocation-start bitmap below 8388608;
// nonmoving managed heap [8388608,67000000). No C/C++ allocator.
hàm vm_get(p, i) { trả về máy đọc số nguyên ba mươi hai bit(p + i * 4); };
hàm vm_set(p, i, v) { trả về máy ghi số nguyên ba mươi hai bit(p + i * 4, v); };
// 128-byte gap before allocation bitmap: four independent CPU timers
// (start timespec, accumulated seconds/nanoseconds, call count) plus one
// shared end timespec. Each 64-bit tv_nsec has an unused high i32 word;
// we use it as recursion depth. All timestamp reads use the low 32 bits.
// This records each scope's inclusive thread CPU time once per outer call,
// even when profiling recursively invokes the same scope.
// Scope 0=vm_alloc, 1=vm_binary, 2=vm_invoke, 3=vm_step.
hàm vm_profile_begin(scope) {
    nếu (vm_get(4198464, 12) != 1) { trả về 0; };
    nếu (scope < 0 || scope >= 4) { trả về -1; };
    biến start = 4198592 + scope * 28;
    biến depth = vm_get(start, 3);
    nếu (depth > 0) {
        nếu (depth >= 4096) { trả về -1; };
        vm_set(start, 3, depth + 1);
        trả về 0;
    };
    nếu (máy đồng hồ CPU thô(start) != 0) { trả về -1; };
    vm_set(start, 3, 1);
    trả về 0;
};
hàm vm_profile_end(scope) {
    nếu (vm_get(4198464, 12) != 1) { trả về 0; };
    nếu (scope < 0 || scope >= 4) { trả về -1; };
    biến start = 4198592 + scope * 28;
    biến depth = vm_get(start, 3);
    nếu (depth <= 0) { trả về -1; };
    vm_set(start, 3, depth - 1);
    vm_set(start, 6, vm_get(start, 6) + 1);
    nếu (depth != 1) { trả về 0; };
    nếu (máy đồng hồ CPU thô(4198704) != 0) { trả về -1; };
    biến seconds = vm_get(4198704, 0) - vm_get(start, 0);
    biến nanos = vm_get(4198704, 2) - vm_get(start, 2);
    nếu (nanos < 0) { seconds = seconds - 1; nanos = nanos + 1000000000; };
    nếu (seconds >= 0) {
        nanos = nanos + vm_get(start, 5);
        nếu (nanos >= 1000000000) { nanos = nanos - 1000000000; seconds = seconds + 1; };
        vm_set(start, 4, vm_get(start, 4) + seconds);
        vm_set(start, 5, nanos);
    };
    trả về 0;
};
hàm vm_profile_report() {
    nếu (vm_get(4198464, 12) != 1) { trả về 0; };
    lặp(scope = 0; scope < 4; scope++) {
        biến start = 4198592 + scope * 28;
        biến line = vm_concat(vm_literal("VPP_VM_CPU_PROFILE scope="), vm_integer_text(scope));
        line = vm_concat(line, vm_concat(vm_literal(" calls="), vm_integer_text(vm_get(start, 6))));
        line = vm_concat(line, vm_concat(vm_literal(" cpu_seconds="), vm_integer_text(vm_get(start, 4))));
        line = vm_concat(line, vm_concat(vm_literal(" cpu_nanoseconds="), vm_integer_text(vm_get(start, 5))));
        vm_write(2, vm_concat(line, vm_literal("\n")));
    };
    // Số liệu cấp phát và thu gom giúp xác định nút thắt của runtime AOT.
    biến line = vm_literal("VPP_VM_ALLOC allocations=");
    line = vm_concat(line, vm_integer_text(vm_get(4198464, 14)));
    line = vm_concat(line, vm_literal(" collections="));
    line = vm_concat(line, vm_integer_text(vm_get(4198464, 15)));
    line = vm_concat(line, vm_literal(" free_probes="));
    line = vm_concat(line, vm_integer_text(vm_get(4198464, 16)));
    vm_write(2, vm_concat(line, vm_literal("\n")));
    biến state = vm_get(4198464, 2);
    biến bộ đếm = 0;
    nếu (state != 0) { bộ đếm = vm_get(state, 17); };
    nếu (bộ đếm != 0) {
        lặp(op = 0; op <= 217; op++) {
            biến calls = vm_get(bộ đếm, op);
            nếu (calls > 0) {
                biến dòng = vm_concat(vm_literal("VPP_VM_BINARY_OP op="), vm_integer_text(op));
                dòng = vm_concat(dòng, vm_concat(vm_literal(" calls="), vm_integer_text(calls)));
                vm_write(2, vm_concat(dòng, vm_literal("\n")));
            };
        };
    };
    biến theo hàm = 0;
    nếu (state != 0) { theo hàm = vm_get(state, 18); };
    nếu (theo hàm != 0) {
        lặp(id = 231; id <= 247; id++) {
            lặp(op = 0; op <= 217; op++) {
                biến calls = vm_get(theo hàm, (id - 231) * 218 + op);
                nếu (calls > 0) {
                    biến dòng = vm_concat(vm_literal("VPP_VM_BINARY_FN fn="), vm_integer_text(id));
                    dòng = vm_concat(dòng, vm_concat(vm_literal(" op="), vm_integer_text(op)));
                    dòng = vm_concat(dòng, vm_concat(vm_literal(" calls="), vm_integer_text(calls)));
                    vm_write(2, vm_concat(dòng, vm_literal("\n")));
                };
            };
        };
    };
    biến chẩn đoán = 0;
    nếu (state != 0) { chẩn đoán = vm_get(state, 19); };
    nếu (chẩn đoán != 0) {
        biến dòng = vm_literal("VPP_AOT_HELPER_PROFILE update_integer_fallback=");
        dòng = vm_concat(dòng, vm_integer_text(vm_get(chẩn đoán, 0)));
        dòng = vm_concat(dòng, vm_literal(" source_not_i32="));
        dòng = vm_concat(dòng, vm_integer_text(vm_get(chẩn đoán, 1)));
        dòng = vm_concat(dòng, vm_literal(" target_missing="));
        dòng = vm_concat(dòng, vm_integer_text(vm_get(chẩn đoán, 2)));
        dòng = vm_concat(dòng, vm_literal(" compare_and_fallback="));
        dòng = vm_concat(dòng, vm_integer_text(vm_get(chẩn đoán, 3)));
        dòng = vm_concat(dòng, vm_literal(" left_not_i32="));
        dòng = vm_concat(dòng, vm_integer_text(vm_get(chẩn đoán, 4)));
        dòng = vm_concat(dòng, vm_literal(" right_not_i32="));
        dòng = vm_concat(dòng, vm_integer_text(vm_get(chẩn đoán, 5)));
        dòng = vm_concat(dòng, vm_literal(" guard_not_i32="));
        dòng = vm_concat(dòng, vm_integer_text(vm_get(chẩn đoán, 6)));
        vm_write(2, vm_concat(dòng, vm_literal("\n")));
    };
    trả về 0;
};
hàm vm_error(code) {
    nếu (vm_get(4198464, 1) == 0) {
        vm_set(4198464, 1, code);
        vm_set(4198464, 5, vm_get(4198464, 13));
    };
    trả về 0;
};
// Chẩn đoán lỗi dung lượng không dùng heap đang cạn. Vùng tạm stat 3376
// chỉ được ghi sau lỗi không thể bắt (mã 1), không qua safepoint.
hàm vm_capacity_text(handle) {
    biến n = byte dài(handle);
    nếu (n > 0 && n <= 208) {
        lặp(i = 0; i < n; i++) { máy ghi byte(3376 + i, byte lấy(handle, i)); };
        máy ghi(2, 3376, n);
    };
    byte hủy(handle);
    trả về 0;
};
hàm vm_capacity_number(n) {
    // Giữ số âm để không tràn khi n = INT32_MIN.
    biến âm = n < 0;
    nếu (n > 0) { n = 0 - n; };
    biến at = 3392;
    khi (đúng) {
        biến q = máy chia số nguyên ba mươi hai bit(n, 10);
        at = at - 1;
        máy ghi byte(at, 48 + q * 10 - n);
        n = q;
        nếu (n == 0) { thoát; };
    };
    nếu (âm) { at = at - 1; máy ghi byte(at, 45); };
    máy ghi(2, at, 3392 - at);
    trả về 0;
};
hàm vm_capacity_error(reason, requested, limit) {
    nếu (vm_get(4198464, 1) != 0) { trả về 0; };
    vm_error(1);
    biến end = vm_get(4198464, 0);
    biến free = 67000000 - end;
    biến largest = free;
    biến p = 8388608;
    khi (p < end) {
        biến size = vm_get(p, 0);
        nếu (size < 32 || size > end - p) { thoát; };
        nếu (vm_get(p, 1) == -1) {
            free += size;
            nếu (size > largest) { largest = size; };
        };
        p += size;
    };
    vm_capacity_text("VPP_VM_CAPACITY reason="); vm_capacity_number(reason);
    vm_capacity_text(" requested="); vm_capacity_number(requested);
    vm_capacity_text(" limit="); vm_capacity_number(limit);
    vm_capacity_text(" free="); vm_capacity_number(free);
    vm_capacity_text(" largest="); vm_capacity_number(largest);
    vm_capacity_text(" since_gc="); vm_capacity_number(vm_get(4198464, 9));
    biến state = vm_get(4198464, 2);
    nếu (state != 0) {
        biến frames = vm_get(state, 6);
        nếu (frames != 0 && vm_get(frames, 1) > 0) {
            biến frame = vm_get(vm_get(frames, 3), vm_get(frames, 1) - 1);
            vm_capacity_text(" frame="); vm_capacity_number(vm_get(frame, 11));
            biến stack = vm_get(frame, 2);
            nếu (stack != 0) { vm_capacity_text(" stack="); vm_capacity_number(vm_get(stack, 1)); };
        };
    };
    vm_capacity_text("\n");
    trả về 0;
};
hàm vm_init() {
    lặp(i = 4; i < 64; i++) { vm_set(16 + i * 32, 0, -1); };
    lặp(i = 0; i < 32; i++) { vm_set(4198464, i, 0); };
    lặp(i = 0; i < 32; i++) { vm_set(4198592, i, 0); };
    vm_set(4198464, 0, 8388608);
    trả về 0;
};
hàm vm_free_bucket(size) {
    nếu (size <= 32) { trả về 0; };
    nếu (size <= 48) { trả về 1; };
    nếu (size <= 64) { trả về 2; };
    nếu (size <= 96) { trả về 3; };
    nếu (size <= 128) { trả về 4; };
    nếu (size <= 192) { trả về 5; };
    nếu (size <= 256) { trả về 6; };
    nếu (size <= 512) { trả về 7; };
    nếu (size <= 1024) { trả về 8; };
    trả về 9;
};
hàm vm_free_push(p) {
    biến bucket = 19 + vm_free_bucket(vm_get(p, 0));
    vm_set(p, 3, vm_get(4198464, bucket));
    vm_set(4198464, bucket, p);
    trả về 0;
};
hàm vm_alloc(bytes, scan) {
    nếu (vm_get(4198464, 12) != 1) { trả về vm_alloc_body(bytes, scan); };
    vm_profile_begin(0);
    biến result = vm_alloc_body(bytes, scan);
    vm_profile_end(0);
    trả về result;
};
hàm vm_alloc_body(bytes, scan) {
    nếu (bytes < 0 || bytes > 31000000) { trả về vm_capacity_error(1, bytes, 31000000); };
    biến size = máy chia số nguyên ba mươi hai bit(bytes + 31, 16) * 16;
    biến end = vm_get(4198464, 0);
    // Segregate free blocks by size; the lexer makes millions of tiny
    // allocations, which should not traverse large fragmented free blocks.
    biến p = 0;
    biến bucket = vm_free_bucket(size);
    khi (bucket < 10 && p == 0) {
        biến slot = 19 + bucket;
        biến candidate = vm_get(4198464, slot);
        biến previous = 0;
        khi (candidate != 0) {
            nếu (vm_get(4198464, 12) == 1) { vm_set(4198464, 16, vm_get(4198464, 16) + 1); };
            biến n = vm_get(candidate, 0);
            nếu (n >= size) {
                biến next = vm_get(candidate, 3);
                nếu (previous == 0) { vm_set(4198464, slot, next); }
                hoặc { vm_set(previous, 3, next); };
                p = candidate;
                nếu (n - size >= 32) {
                    biến rest = candidate + size;
                    vm_set(rest, 0, n - size); vm_set(rest, 1, -1);
                    vm_free_push(rest);
                } hoặc { size = n; };
                thoát;
            };
            previous = candidate; candidate = vm_get(candidate, 3);
        };
        bucket = bucket + 1;
    };
    nếu (p == 0) { p = end; };
    nếu (p == end) {
        nếu (size > 67000000 - end) { trả về vm_capacity_error(2, size, 67000000 - end); };
        vm_set(4198464, 0, end + size);
        // Vùng cấp phát tuần tự chưa từng sử dụng; hệ điều hành đã đặt về 0.
        // Chỉ xóa nội dung khi tái sử dụng vùng đã được thu gom.
    } hoặc {
        lặp(i = 16; i < size; i = i + 4) { máy ghi số nguyên ba mươi hai bit(p + i, 0); };
    };
    vm_set(p, 0, size); vm_set(p, 1, scan); vm_set(p, 2, 0); vm_set(p, 3, 0);
    máy ghi byte(4198720 + máy chia số nguyên ba mươi hai bit(p + 16 - 8388608, 16), 1);
    vm_set(4198464, 9, vm_get(4198464, 9) + size);
    nếu (vm_get(4198464, 12) == 1) { vm_set(4198464, 14, vm_get(4198464, 14) + 1); };
    trả về p + 16;
};
hàm vm_mark(p, epoch) {
    nếu (p < 8388624 || p >= vm_get(4198464, 0)) { trả về 0; };
    nếu (p - máy chia số nguyên ba mươi hai bit(p, 16) * 16 != 0) { trả về 0; };
    nếu (máy đọc byte(4198720 + máy chia số nguyên ba mươi hai bit(p - 8388608, 16)) != 1) { trả về 0; };
    nếu (vm_get(p - 16, 2) == epoch) { trả về 0; };
    vm_set(p - 16, 2, epoch);
    // Field 3 links the pending mark stack. Slot 11 is reserved for GC.
    // Live blocks do not use the allocator's free-list link.
    vm_set(p - 16, 3, vm_get(4198464, 11));
    vm_set(4198464, 11, p);
    trả về 1;
};
// Collection only runs between guest instructions, with the whole guest
// state rooted. Temporary values inside a helper never cross a collection.
hàm vm_collect(root) {
    nếu (vm_get(4198464, 12) == 1) { vm_set(4198464, 15, vm_get(4198464, 15) + 1); };
    biến epoch = vm_get(4198464, 6) + 1;
    nếu (epoch <= 0) { epoch = 1; };
    vm_set(4198464, 6, epoch);
    vm_set(4198464, 11, 0);
    vm_mark(root, epoch);
    // Nested V++ providers share the arena, but have independent guest
    // stacks. Keep both program states and the executable path rooted.
    vm_mark(vm_get(4198464, 2), epoch);
    vm_mark(vm_get(4198464, 4), epoch);
    vm_mark(vm_get(4198464, 10), epoch);
    vm_mark(vm_get(4198464, 3), epoch);
    vm_mark(vm_get(4198464, 7), epoch);
    vm_mark(vm_get(4198464, 17), epoch);
    vm_mark(vm_get(4198464, 18), epoch);
    biến end = vm_get(4198464, 0);
    // Trace each reachable block once, independent of reference-chain depth.
    // Header links avoid allocating temporary guest objects during GC.
    khi (vm_get(4198464, 11) != 0) {
        biến object = vm_get(4198464, 11);
        biến header = object - 16;
        vm_set(4198464, 11, vm_get(header, 3));
        vm_set(header, 3, 0);
        biến kiểu quét = vm_get(header, 1);
        // Chuỗi ngắn có vùng UTF-8 nội tuyến. Chỉ ô v[3] có thể giữ
        // con trỏ tới bảng chỉ mục UTF-8; các byte chuỗi không phải con trỏ.
        nếu (kiểu quét == 2) {
            vm_mark(vm_get(object, 3), epoch);
        } hoặc nếu (kiểu quét == 1) {
            lặp(i = 16; i < vm_get(header, 0); i = i + 4) {
                vm_mark(máy đọc số nguyên ba mươi hai bit(header + i), epoch);
            };
        };
    };
    biến p = 8388608;
    biến previous = 0;
    lặp(i = 19; i < 29; i++) { vm_set(4198464, i, 0); };
    khi (p < end) {
        biến size = vm_get(p, 0);
        nếu (vm_get(p, 2) != epoch || vm_get(p, 1) == -1) {
            máy ghi byte(4198720 + máy chia số nguyên ba mươi hai bit(p + 16 - 8388608, 16), 0);
            vm_set(p, 1, -1);
            nếu (previous != 0) { vm_set(previous, 0, vm_get(previous, 0) + size); }
            hoặc { previous = p; };
        } hoặc {
            nếu (previous != 0) { vm_free_push(previous); };
            previous = 0;
        };
        p = p + size;
    };
    nếu (previous != 0) { vm_free_push(previous); };
    vm_set(4198464, 9, 0);
    trả về 0;
};
