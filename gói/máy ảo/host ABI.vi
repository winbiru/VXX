// Host ABI policy in V++; raw memory, I/O and scalar f64 operations call ASM.
// No generic native dispatcher, C++ callback, libffi or bytecode bridge.
hàm vm_path_handle(s) {
    nếu (vm_tag(s) != 3 || vm_get(s, 1) < 1 || vm_get(s, 1) > 4095) { vm_error(2); trả về -1; };
    biến h = byte mới(); nếu (h <= 0) { vm_error(1); trả về -1; };
    lặp(i = 0; i < vm_get(s, 1); i++) {
        biến b = máy đọc byte(vm_get(s, 2) + i);
        nếu (b == 0) { byte hủy(h); vm_error(2); trả về -1; };
        byte thêm(h, b);
    };
    trả về h;
};
hàm vm_write(fd, s) {
    nếu (vm_tag(s) != 3) { trả về vm_error(2); };
    biến n = vm_get(s, 1); biến done = 0;
    khi (done < n) {
