    nếu (t == 4) { trả về vm_literal("danh sách"); }; nếu (t == 5) { trả về vm_literal("từ điển"); };
    nếu (t == 6) { trả về vm_literal("tuple"); }; nếu (t == 7) { trả về vm_literal("hàm"); };
    nếu (t == 8) { trả về vm_literal("lớp"); }; trả về vm_literal("đối tượng");
};
hàm vm_file_fd(token) {
    biến slot = thực thi tệp dữ liệu ô nhớ(token); nếu (slot < 0) { trả về -1; };
