    nếu (tag == 3) {
        // Lexer/source text is indexed by Unicode codepoint. Re-scanning the
        // prefix for every source[i] is quadratic; checkpoint every 64 chars.
        nếu (vm_get(container, 1) >= 128) {
            biến index = vm_get(container, 3);
            nếu (index <= 0) {
                biến capacity = máy chia số nguyên ba mươi hai bit(vm_get(container, 1), 64) + 1;
                index = vm_alloc(8 + capacity * 4, 0);
