    nếu (cache == 0) {
        cache = vm_alloc(512, 1);
        nếu (cache == 0) { trả về 0; };
        vm_set(4198464, 18, cache);
    };
    biến existing = vm_get(cache, ascii);
    nếu (existing != 0) { trả về existing; };
