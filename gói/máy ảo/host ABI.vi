hàm vm_utf8_width(s, at) {
    biến b = máy đọc byte(vm_get(s, 2) + at);
    nếu (b < 128) { trả về 1; }; nếu (b < 224) { trả về 2; }; nếu (b < 240) { trả về 3; }; trả về 4;
