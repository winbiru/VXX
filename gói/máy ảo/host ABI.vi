// Host ABI policy in V++; raw memory, I/O and scalar f64 operations call ASM.
// No generic native dispatcher, C++ callback, libffi or bytecode bridge.
hàm vm_path_handle(s) {
    nếu (vm_tag(s) != 3 || vm_get(s, 1) < 1 || vm_get(s, 1) > 4095) { vm_error(2); trả về -1; };
    biến h = byte mới(); nếu (h <= 0) { vm_error(1); trả về -1; };
    lặp(i = 0; i < vm_get(s, 1); i++) {
        biến b = máy đọc byte(vm_get(s, 2) + i);
        nếu (b == 0) { byte hủy(h); vm_error(2); trả về -1; };
        byte thêm(h, b);
    };
    trả về h;
};
hàm vm_write(fd, s) {
    nếu (vm_tag(s) != 3) { trả về vm_error(2); };
    biến n = vm_get(s, 1); biến done = 0;
    khi (done < n) {
        biến got = máy ghi(fd, vm_get(s, 2) + done, n - done);
        nếu (got < 0 && máy lỗi() == 4) { bỏ qua; };
        nếu (got <= 0) { trả về vm_error(20); };
        done = done + got;
    };
    trả về 0;
};
hàm vm_utf8_width_raw(data, n, at) {
    biến b = máy đọc byte(data + at);
    nếu (b < 128) { trả về 1; };
    // Byte sai là một đơn vị thô, cùng quy tắc với runtime bootstrap.
    // Không đọc byte tiếp diễn trước khi kiểm tra phần còn lại của chuỗi.
    nếu (b < 194 || b > 244 || at + 1 >= n) { trả về 1; };
    biến c = máy đọc byte(data + at + 1);
    nếu (c < 128 || c > 191) { trả về 1; };
    nếu (b < 224) { trả về 2; };
    nếu (at + 2 >= n || (b == 224 && c < 160) || (b == 237 && c > 159)) { trả về 1; };
    biến d = máy đọc byte(data + at + 2);
    nếu (d < 128 || d > 191) { trả về 1; };
    nếu (b < 240) { trả về 3; };
    nếu (at + 3 >= n || (b == 240 && c < 144) || (b == 244 && c > 143)) { trả về 1; };
    biến e = máy đọc byte(data + at + 3);
    nếu (e < 128 || e > 191) { trả về 1; };
    trả về 4;
};
hàm vm_utf8_width(s, at) {
    trả về vm_utf8_width_raw(vm_get(s, 2), vm_get(s, 1), at);
};
hàm vm_ascii_at(s, at) {
    // Source lexers repeatedly request one-character strings. Intern ASCII
    // codepoints, which are immutable value types in the VM, to avoid two
    // managed allocations (string + bytes) for each source[i] read.
    biến ascii = máy đọc byte(vm_get(s, 2) + at);
    // Byte UTF-8 sai cũng có độ rộng 1 nhưng không thuộc bảng ASCII 128 ô.
    nếu (ascii >= 128) { trả về vm_slice(s, at, 1); };
    biến cache = vm_get(4198464, 18);
    nếu (cache == 0) {
        cache = vm_alloc(512, 1);
        nếu (cache == 0) { trả về 0; };
        vm_set(4198464, 18, cache);
    };
    biến existing = vm_get(cache, ascii);
    nếu (existing != 0) { trả về existing; };
    biến value = vm_string(1);
    nếu (value == 0) { trả về 0; };
    máy ghi byte(vm_get(value, 2), ascii);
    vm_set(cache, ascii, value);
    trả về value;
};
// Quét UTF-8 theo từ i32 little-endian trên các đích AOT được hỗ trợ.
// Mỗi byte lỗi là một đơn vị; strict trả -1 ngay tại đơn vị lỗi.
// Không đọc quá cuối buffer; giữ đường scalar cho tối đa ba byte đuôi.
hàm vm_utf8_scan(data, bytes, strict) {
    biến at = 0; biến n = 0;
    khi (at < bytes) {
        biến width = 1;
        nếu (at <= bytes - 4) {
            biến word = máy đọc số nguyên ba mươi hai bit(data + at);
            nếu ((word & -2139062144) == 0) {
                biến prefix = 4;
                nếu (at <= bytes - 16) {
                    prefix = máy tiền tố ascii(data + at, bytes - at);
                    nếu (prefix < 4) { trả về -2; };
                };
                at = at + prefix; n = n + prefix;
                bỏ qua;
            };
            biến b = word & 255;
            nếu (b >= 128) {
                biến c = (word >> 8) & 255;
                nếu (b >= 194 && b <= 244 && c >= 128 && c <= 191) {
                    nếu (b < 224) { width = 2; }
                    hoặc nếu (!((b == 224 && c < 160) || (b == 237 && c > 159))) {
                        biến d = (word >> 16) & 255;
                        nếu (d >= 128 && d <= 191) {
                            nếu (b < 240) { width = 3; }
                            hoặc nếu (!((b == 240 && c < 144) || (b == 244 && c > 143))) {
                                biến e = (word >> 24) & 255;
                                nếu (e >= 128 && e <= 191) { width = 4; };
                            };
                        };
                    };
                };
                nếu (strict && width == 1) { trả về -1; };
            };
        } hoặc {
            width = vm_utf8_width_raw(data, bytes, at);
            nếu (strict && width == 1 && máy đọc byte(data + at) >= 128) { trả về -1; };
        };
        at = at + width; n = n + 1;
    };
    trả về n;
};
hàm vm_length(v) {
    biến tag = vm_tag(v);
    nếu (tag == 3) {
        biến cached = vm_get(v, 3);
        nếu (cached < -1) { trả về 0 - cached - 2; };
        nếu (cached > 0) { trả về vm_get(cached, 0); };
        biến n = vm_utf8_scan(vm_get(v, 2), vm_get(v, 1), 0);
        nếu (n < 0) { trả về vm_error(3); };
        vm_set(v, 3, 0 - n - 2);
        trả về n;
    };
    nếu (tag >= 4 && tag <= 6) {
        biến số phần tử = vm_get(v, 1);
        nếu (tag == 5) { số phần tử = máy chia số nguyên ba mươi hai bit(số phần tử, 2); };
        trả về số phần tử;
    };
    nếu (tag == 13) { trả về vm_get(v, 1); };
    vm_error(2); trả về 0;
};
// Đổi vị trí điểm mã thành vị trí byte. Tận dụng bảng chỉ mục khi đã có;
// chuỗi ASCII bỏ hoàn toàn vòng quét UTF-8.
hàm vm_utf8_offset(s, vị trí, số điểm) {
    biến byte_count = vm_get(s, 1);
    nếu (vị trí == số điểm) { trả về byte_count; };
    nếu (vm_get(s, 3) == 0 - byte_count - 2) { trả về vị trí; };
    biến index = vm_get(s, 3);
    biến offset = 0; biến current = 0;
    nếu (index > 0) {
        nếu (byte_count <= 1024) { trả về vm_get(index, 1 + vị trí); };
        biến block = máy chia số nguyên ba mươi hai bit(vị trí, 64);
        offset = vm_get(index, 1 + block);
        current = block * 64;
    };
    khi (current < vị trí) {
        offset = offset + vm_utf8_width(s, offset);
        current = current + 1;
    };
    trả về offset;
};
// Cắt cả đoạn trong một lần cấp phát, thay cho vòng nối từng ký tự.
hàm vm_cut(s, bắt đầu, số lượng) {
    nếu (vm_tag(s) != 3 || bắt đầu < 0 || số lượng < 0) { trả về vm_error(2); };
    biến n = vm_length(s);
    nếu (bắt đầu >= n || số lượng == 0) { trả về vm_string(0); };
    biến kết thúc = n;
    nếu (số lượng < n - bắt đầu) { kết thúc = bắt đầu + số lượng; };
    biến byte_đầu = vm_utf8_offset(s, bắt đầu, n);
    biến byte_cuối = vm_utf8_offset(s, kết thúc, n);
    trả về vm_slice(s, byte_đầu, byte_cuối - byte_đầu);
};
// Cắt trực tiếp theo byte cho dữ liệu mà tầng V++ đã kiểm tra biên UTF-8.
hàm vm_cut_byte(s, bắt đầu, số lượng) {
    nếu (vm_tag(s) != 3 || bắt đầu < 0 || số lượng < 0) { trả về vm_error(2); };
    biến n = vm_get(s, 1);
    nếu (bắt đầu >= n || số lượng == 0) { trả về vm_string(0); };
    nếu (số lượng > n - bắt đầu) { số lượng = n - bắt đầu; };
    trả về vm_slice(s, bắt đầu, số lượng);
};
// So khớp literal tại một biên UTF-8. Byte lỗi là một đơn vị thô nên
// điểm kết thúc cũng phải trùng đúng biên mà vm_utf8_width nhìn thấy.
hàm vm_thay_khớp(dữ liệu nguồn, n, dữ liệu mẫu, m, tại) {
    nếu (m <= 0 || tại < 0 || tại > n - m) { trả về 0; };
    biến i = 0;
    khi (i <= m - 4) {
        nếu (máy đọc số nguyên ba mươi hai bit(dữ liệu nguồn + tại + i) !=
            máy đọc số nguyên ba mươi hai bit(dữ liệu mẫu + i)) { trả về 0; };
        i = i + 4;
    };
    khi (i < m) {
        nếu (máy đọc byte(dữ liệu nguồn + tại + i) != máy đọc byte(dữ liệu mẫu + i)) { trả về 0; };
        i = i + 1;
    };
    biến kết thúc = tại + m; nếu (kết thúc == n) { trả về 1; };
    biến byte kế = máy đọc byte(dữ liệu nguồn + kết thúc);
    nếu (byte kế < 128 || byte kế > 191) { trả về 1; };
    biến p = tại;
    khi (p < kết thúc) {
        p = p + vm_utf8_width_raw(dữ liệu nguồn, n, p);
    };
    trả về p == kết thúc;
};
// Mọi byte ngoài 128..191 đều chỉ xuất hiện ở biên đơn vị UTF-8,
// kể cả byte đầu không hợp lệ. Quét i32 chỉ khi mẫu có tính chất này.
// Với byte tiếp diễn, vẫn bước theo bộ giải mã để không khớp giữa điểm mã.
hàm vm_thay_tìm(data, n, pattern, m, at, byte đầu, mask) {
    biến cuối = n - m;
    nếu (byte đầu < 128 || byte đầu > 191) {
        khi (at <= cuối) {
            khi (at <= cuối - 3) {
                biến x = máy đọc số nguyên ba mươi hai bit(data + at) ^ mask;
                nếu (((x - 16843009) & (x ^ -1) & -2139062144) != 0) { thoát; };
                at = at + 4;
            };
            khi (at <= cuối) {
                nếu (máy đọc byte(data + at) == byte đầu) { thoát; };
                at = at + 1;
                // Quay lại đường quét theo từ khi đã bỏ qua từ ứng viên.
                nếu (at <= cuối - 3) { thoát; };
            };
            nếu (at > cuối) { trả về n; };
            nếu (máy đọc byte(data + at) == byte đầu) {
                nếu (vm_thay_khớp(data, n, pattern, m, at)) { trả về at; };
                at = at + 1;
            };
        };
        trả về n;
    };
    khi (at <= cuối) {
        nếu (máy đọc byte(data + at) == byte đầu) {
            nếu (vm_thay_khớp(data, n, pattern, m, at)) { trả về at; };
        };
        at = at + vm_utf8_width_raw(data, n, at);
    };
    trả về n;
};
hàm vm_sao_chép_byte(đích, vị trí đích, nguồn, vị trí nguồn, số lượng) {
    biến dữ liệu đích = vm_get(đích, 2) + vị trí đích;
    biến dữ liệu nguồn = vm_get(nguồn, 2) + vị trí nguồn;
    nếu (máy sao chép vùng nhớ(dữ liệu đích, dữ liệu nguồn, số lượng) != 0) { vm_error(3); trả về vị trí đích; };
    trả về vị trí đích + số lượng;
};
// Thay literal không chồng lấp trong một lần cấp phát kết quả.
hàm vm_thay_chính_xác(nguồn, mẫu, thay) {
    nếu (vm_tag(nguồn) != 3 || vm_tag(mẫu) != 3 || vm_tag(thay) != 3) {
        trả về vm_error(2);
    };
    biến n = vm_get(nguồn, 1); biến m = vm_get(mẫu, 1); biến r = vm_get(thay, 1);
    biến kết quả = 0; biến ra = 0; biến vị trí = 0; biến rộng = 0;
    nếu (m == 0) {
        nếu (r == 0) { trả về nguồn; };
        biến số đơn vị = vm_length(nguồn); biến số khe = số đơn vị + 1;
        nếu (số khe > máy chia số nguyên ba mươi hai bit(16000000 - n, r)) {
            trả về vm_error(3);
        };
        kết quả = vm_string(n + số khe * r); nếu (kết quả == 0) { trả về 0; };
        vị trí = 0; ra = 0;
        ra = vm_sao_chép_byte(kết quả, ra, thay, 0, r);
        khi (vị trí < n) {
            rộng = vm_utf8_width(nguồn, vị trí);
            ra = vm_sao_chép_byte(kết quả, ra, nguồn, vị trí, rộng);
            ra = vm_sao_chép_byte(kết quả, ra, thay, 0, r);
            vị trí = vị trí + rộng;
        };
        trả về kết quả;
    };

    biến tổng = n; biến số khớp = 0;
    biến dữ liệu = vm_get(nguồn, 2);
    biến dữ liệu mẫu = vm_get(mẫu, 2);
    biến dữ liệu thay = vm_get(thay, 2);
    biến byte đầu = máy đọc byte(dữ liệu mẫu);
    biến mask = byte đầu * 16843009;
    vị trí = vm_thay_tìm(dữ liệu, n, dữ liệu mẫu, m, 0, byte đầu, mask);
    nếu (vị trí >= n) { trả về nguồn; };
    biến khớp đầu = vị trí;
    // Với chuỗi nhỏ không tăng kích thước, giới hạn cấp phát bằng độ dài
    // sau lần khớp đầu. Điền kết quả chỉ trong một lần quét, cập nhật
    // độ dài byte thật; phần nhớ dư tối đa 4096 byte, không ảnh hưởng GC.
    nếu (r <= m && n <= 4096 && (n <= 256 || r >= m - máy chia số nguyên ba mươi hai bit(m, 2))) {
        kết quả = vm_string(n - m + r); nếu (kết quả == 0) { trả về 0; };
        biến đích nhanh = vm_get(kết quả, 2);
        biến đầu nhanh = 0;
        khi (vị trí < n) {
            nếu (vị trí > đầu nhanh) {
                biến đoạn = vị trí - đầu nhanh;
                nếu (máy sao chép vùng nhớ(đích nhanh + ra, dữ liệu + đầu nhanh, đoạn) != 0) { trả về vm_error(3); };
                ra = ra + đoạn;
            };
            nếu (r > 0) {
                nếu (máy sao chép vùng nhớ(đích nhanh + ra, dữ liệu thay, r) != 0) { trả về vm_error(3); };
                ra = ra + r;
            };
            đầu nhanh = vị trí + m;
            vị trí = vm_thay_tìm(dữ liệu, n, dữ liệu mẫu, m, đầu nhanh, byte đầu, mask);
        };
        nếu (n > đầu nhanh) {
            nếu (máy sao chép vùng nhớ(đích nhanh + ra, dữ liệu + đầu nhanh, n - đầu nhanh) != 0) { trả về vm_error(3); };
            ra = ra + n - đầu nhanh;
        };
        máy ghi byte(đích nhanh + ra, 0);
        vm_set(kết quả, 1, ra);
        trả về kết quả;
    };
    khi (vị trí < n) {
        nếu (r >= m) {
            biến thêm = r - m;
            nếu (tổng > 16000000 - thêm) { trả về vm_error(3); };
            tổng = tổng + thêm;
        } hoặc { tổng = tổng - (m - r); };
        số khớp = số khớp + 1;
        vị trí = vm_thay_tìm(dữ liệu, n, dữ liệu mẫu, m, vị trí + m, byte đầu, mask);
    };
    nếu (số khớp == 0) { trả về nguồn; };

    kết quả = vm_string(tổng); nếu (kết quả == 0) { trả về 0; };
    biến đích = vm_get(kết quả, 2);
    ra = 0;
    biến đầu đoạn = 0;
    vị trí = khớp đầu;
    khi (số khớp > 0) {
        nếu (vị trí > đầu đoạn) {
            biến số lượng = vị trí - đầu đoạn;
            nếu (máy sao chép vùng nhớ(đích + ra, dữ liệu + đầu đoạn, số lượng) != 0) { trả về vm_error(3); };
            ra = ra + số lượng;
        };
        nếu (r > 0) {
            nếu (máy sao chép vùng nhớ(đích + ra, dữ liệu thay, r) != 0) { trả về vm_error(3); };
            ra = ra + r;
        };
        đầu đoạn = vị trí + m;
        số khớp = số khớp - 1;
        nếu (số khớp > 0) {
            vị trí = vm_thay_tìm(dữ liệu, n, dữ liệu mẫu, m, đầu đoạn, byte đầu, mask);
        };
    };
    nếu (n > đầu đoạn) {
        nếu (máy sao chép vùng nhớ(đích + ra, dữ liệu + đầu đoạn, n - đầu đoạn) != 0) { trả về vm_error(3); };
    };
    trả về kết quả;
};
hàm vm_index(container, key) {
    biến tag = vm_tag(container);
    nếu (tag == 5) { trả về vm_map_get(container, vm_text(key)); };
    nếu (vm_tag(key) != 1) { trả về vm_error(2); };
    trả về vm_index_i32(container, vm_number(key));
};
// Nhận chỉ số i32 thô từ AOT, tránh đóng hộp rồi giải hộp ở mỗi lần đọc.
hàm vm_index_i32(container, i) {
    biến tag = vm_tag(container);
    nếu (i < 0) { trả về vm_error(4); };
    nếu (tag == 4 || tag == 6) {
        nếu (i >= vm_get(container, 1)) { trả về vm_error(4); };
        trả về vm_get(vm_get(container, 3), i);
    };
    nếu (tag == 13) {
        nếu (i >= vm_get(container, 1)) { trả về vm_error(4); };
        trả về vm_int(máy đọc byte(vm_get(container, 2) + i));
    };
    nếu (tag == 3) {
        biến at = vm_char_offset(container, i);
        nếu (vm_get(4198464, 1) != 0) { trả về 0; };
        biến width = vm_utf8_width(container, at);
        nếu (width == 1) { trả về vm_ascii_at(container, at); };
        trả về vm_slice(container, at, width);
    };
    trả về vm_error(2);
};
// Xác định byte đầu của một điểm mã, không tạo chuỗi ký tự trung gian.
// Dùng chung cho lấy ký tự và so sánh trực tiếp trong AOT.
hàm vm_char_offset(s, i) {
    nếu (i < 0) { trả về vm_error(4); };
    biến bytes = vm_get(s, 1);
    nếu (vm_get(s, 3) == 0 - bytes - 2) {
        nếu (i >= bytes) { trả về vm_error(4); };
        trả về i;
    };
    // Chuỗi ngắn dùng chỉ mục đầy đủ; chuỗi dài dùng mốc mỗi 64 điểm mã.
    nếu (bytes >= 48) {
        biến index = vm_get(s, 3);
        biến dense = bytes <= 1024;
        nếu (index <= 0) {
            biến capacity = máy chia số nguyên ba mươi hai bit(bytes, 64) + 1;
            nếu (dense) { capacity = bytes + 1; };
            index = vm_alloc(8 + capacity * 4, 0);
            nếu (index == 0) { trả về 0; };
            biến vị_trí_quét = 0; biến điểm_mã = 0;
            khi (vị_trí_quét < bytes) {
                nếu (dense) { vm_set(index, 1 + điểm_mã, vị_trí_quét); }
