// Worker policy is V++; the machine boundary owns only threads and snapshots.
// 4198724 is the per-arena worker flag (4198720 is the embedded-root list).
hàm vm_worker_cancel_point() {
    nếu (vm_get(4198724, 0) != 0 && máy worker thô(5, 0, 0) == 1) { vm_error(24); trả về 1; };
    trả về 0;
};
hàm vm_worker_error(message) {
    nếu (vm_get(4198464, 1) == 0) {
        vm_set(4198464, 3, vm_literal(message)); vm_error(16);
    };
    trả về 0;
};
hàm vm_worker_callable(state, callable) {
    nếu (vm_tag(callable) == 7) { trả về vm_get(callable, 1); };
    nếu (vm_tag(callable) == 3) { trả về vm_find_function(state, callable); };
    nếu (vm_tag(callable) == 1) { trả về vm_number(callable); };
    trả về -1;
};
hàm vm_worker_spawn(state, callable, args) {
    nếu (máy worker thô(0, 0, 0) != 1) { trả về vm_worker_error("thread_vm_spawn: worker không được hỗ trợ"); };
    biến id = vm_worker_callable(state, callable);
    nếu (id < 0 || id >= vm_get(vm_get(state, 1), 1) || vm_tag(args) != 4) { trả về vm_worker_error("thread_vm_spawn: callback hoặc đối số không hợp lệ"); };
    biến bundle = vm_vector(4);
    vm_append(bundle, vm_get(state, 0)); vm_append(bundle, vm_get(state, 1)); vm_append(bundle, vm_get(state, 2));
    vm_append(bundle, vm_get(state, 4)); vm_append(bundle, vm_get(state, 5));
    vm_append(bundle, callable); vm_append(bundle, args); vm_append(bundle, vm_get(4198464, 10));
    biến packet = vm_worker_graph_pack(bundle, 20);
    nếu (packet == 0 || vm_worker_cancel_point()) { trả về 0; };
    biến handle = máy worker thô(1, packet, vm_get(packet, 1));
    nếu (handle <= 0) { trả về vm_worker_error("thread_vm_spawn: không thể tạo worker"); };
    trả về vm_int(handle);
};
// Decoder must not allocate across the input snapshot before it is consumed.
hàm vm_worker_prepare(packet, aot) {
    vm_init(); vm_set(4198724, 0, 1);
    vm_set(127000000, 0, 89000000);
    vm_set(4198464, 8, máy thư mục thô(6, 0, 0));
    nếu (vm_worker_cancel_point()) { trả về 0; };
    biến bundle = vm_worker_graph_unpack(packet, vm_get(packet, 1));
    nếu (bundle == 0 || vm_get(4198464, 1) != 0 || vm_tag(bundle) != 4 || vm_get(bundle, 1) != 8) { trả về 0; };
    vm_set(127000000, 0, 120000000);
    biến state = vm_alloc(88, 1); nếu (state == 0) { trả về 0; };
    vm_set(4198464, 2, state);
    vm_set(state, 0, vm_at(bundle, 0)); vm_set(state, 1, vm_at(bundle, 1)); vm_set(state, 2, vm_at(bundle, 2));
    vm_set(state, 4, vm_at(bundle, 3)); vm_set(state, 5, vm_at(bundle, 4));
    vm_set(state, 6, vm_vector(4)); vm_set(state, 8, bundle);
    vm_set(state, 10, vm_alloc((vm_get(vm_get(state, 0), 1) + 1) * 4, 0));
    nếu (aot) { vm_set(state, 16, vm_vector(4)); };
    vm_set(4198464, 10, vm_at(bundle, 7));
    nếu (vm_get(4198464, 1) != 0) { trả về 0; };
    trả về state;
};
hàm vm_worker_finish(state, result) {
    biến error = vm_get(4198464, 1); biến packet = 0;
    nếu (error == 0 && vm_worker_cancel_point() == 0) { packet = vm_worker_graph_pack(result, 0); }
    hoặc nếu (error == 16) {
        biến reason = vm_get(4198464, 3);
        vm_set(4198464, 1, 0); packet = vm_worker_graph_pack(vm_text(reason), 0);
    };
    nếu (vm_get(4198464, 1) != 0) { packet = 0; };
    vm_socket_close_all(state); vm_process_close_all(state); vm_dir_close_all(state);
    biến provider = vm_get(4198464, 4);
    vm_socket_close_all(provider); vm_process_close_all(provider); vm_dir_close_all(provider);
    nếu (packet == 0) { trả về -1; };
    nếu (error != 0) { trả về 0 - packet; };
