// Compare elapsed monotonic time using seconds and nanoseconds, without
// overflowing an i32 millisecond deadline. Clock buffers are reused.
hàm vm_worker_remaining(start, now, duration) {
    nếu (máy đồng hồ thô(0, now) != 0) { vm_error(20); trả về 0; };
    biến sec = vm_get(now, 0) - vm_get(start, 0);
    biến ns = vm_get(now, 2) - vm_get(start, 2);
    nếu (ns < 0) { sec = sec - 1; ns = ns + 1000000000; };
    nếu (sec < 0 || sec > máy chia số nguyên ba mươi hai bit(duration, 1000)) { trả về 0; };
    biến left = duration - sec * 1000 - máy chia số nguyên ba mươi hai bit(ns, 1000000);
    nếu (left < 0) { trả về 0; }; trả về left;
};
hàm vm_worker_pause(ms) {
    nếu (vm_get(4198724, 0) == 0) { trả về vm_worker_error("thread_vm_park: chỉ worker được phép nghỉ"); };
    nếu (ms < 0) { trả về vm_worker_error("thread_vm_park: thời gian không hợp lệ"); };
    biến start = vm_alloc(16, 0); biến now = vm_alloc(16, 0);
    nếu (start == 0 || now == 0) { trả về 0; };
    nếu (máy đồng hồ thô(0, start) != 0) { trả về vm_error(20); };
    biến left = ms;
    khi (left > 0 && vm_get(4198464, 1) == 0) {
        nếu (vm_worker_cancel_point()) { trả về 0; };
        biến slice = left; nếu (slice > 5) { slice = 5; };
        máy ngủ thô(slice); left = vm_worker_remaining(start, now, ms);
    };
    vm_worker_cancel_point(); trả về 0;
};
hàm vm_worker_copy(handle, source, length, dest, descriptor) {
    vm_set(descriptor, 0, source); vm_set(descriptor, 1, length); vm_set(descriptor, 2, dest);
    trả về máy worker thô(9, handle, descriptor);
};
hàm vm_worker_wait(handle, timeout) {
    nếu (timeout < -1) { trả về vm_worker_error("thread_vm_wait: thời gian không hợp lệ"); };
    nếu (handle == máy worker thô(4, 0, 0) && handle > 0) { trả về vm_worker_error("thread_vm_wait: worker không thể đợi chính mình"); };
    biến begin = máy worker thô(6, handle, 0);
    nếu (begin == -2) { trả về vm_worker_error("thread_vm_wait: phát hiện vòng đợi giữa các worker"); };
    nếu (begin != 0) { trả về vm_worker_error("thread_vm_wait: mã worker không hợp lệ"); };
    biến status = máy worker thô(2, handle, 0);
    biến start = vm_alloc(16, 0); biến now = vm_alloc(16, 0);
    nếu (start != 0 && now != 0 && timeout > 0 && máy đồng hồ thô(0, start) != 0) { vm_error(20); };
    biến left = timeout;
    khi (status == 0 && left != 0 && vm_get(4198464, 1) == 0) {
        nếu (vm_worker_cancel_point()) { thoát; };
        biến slice = 5; nếu (left > 0 && left < slice) { slice = left; };
        máy ngủ thô(slice);
        status = máy worker thô(2, handle, 0);
        nếu (timeout > 0) { left = vm_worker_remaining(start, now, timeout); };
    };
    máy worker thô(7, 0, 0);
    nếu (vm_worker_cancel_point() || vm_get(4198464, 1) != 0) { trả về 0; };
    nếu (status < 0) { trả về vm_worker_error("thread_vm_wait: mã worker không hợp lệ"); };
    biến result = 0; biến reason = vm_literal("");
    nếu (status == 1 || status == 3) {
        biến source = máy worker thô(8, handle, 0);
        nếu (status == 3 && source < -1) { source = 0 - source; };
        nếu (source >= 8388624 && source < 120000000) {
            biến descriptor = vm_alloc(12, 0); biến head = vm_alloc(16, 0);
            nếu (descriptor == 0 || head == 0) { trả về 0; };
            nếu (vm_worker_copy(handle, source, 16, head, descriptor) != 0) { trả về vm_error(22); };
            biến length = vm_get(head, 1);
            nếu (length < 16 || length > 31000000 || source > 120000000 - length) { trả về vm_error(22); };
            biến packet = vm_alloc(length, 0); nếu (packet == 0) { trả về 0; };
