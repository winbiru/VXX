    nếu (op == 140) {
        nếu (vm_tag(b) != 1) { trả về vm_worker_error("thread_vm_wait: cần timeout số nguyên"); };
        trả về vm_worker_wait(handle, vm_number(b));
    };
    biến result = -1;
    nếu (op == 141) { result = máy worker thô(3, handle, 0); }
