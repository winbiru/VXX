    };
    biến snapshot = vm_vector(4); vm_append(snapshot, vm_int(status)); vm_append(snapshot, result); vm_append(snapshot, reason);
    trả về snapshot;
};
hàm vm_worker_host(state, op, a, b) {
    nếu (vm_worker_cancel_point()) { trả về 0; };
    nếu (op == 139) { trả về vm_worker_spawn(state, a, b); };
    nếu (vm_tag(a) != 1) { trả về vm_worker_error("thread_vm: cần số nguyên"); };
    biến handle = vm_number(a);
