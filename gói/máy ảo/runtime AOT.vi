        // Lời gọi host vẫn tuân theo quy tắc đánh giá đối số cũ.
        nếu (count >= 1) {
            nếu (mask % 2 == 1) { aot_load(frame, first); }
            hoặc { aot_integer(frame, first); };
            nếu (aot_status()) { trả về 1; };
        };
        nếu (count == 2) {
            nếu (mask >= 2) { aot_load(frame, second); }
            hoặc { aot_integer(frame, second); };
            nếu (aot_status()) { trả về 1; };
        };
        trả về aot_call(frame, id, count);
    };
    biến args = frame + 96;
    máy ghi số nguyên ba mươi hai bit(args + 4, count);
