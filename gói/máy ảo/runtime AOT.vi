        nếu (count >= 1 && count <= 4) { aot_release_args(frame); };
        vm_error(13); trả về 1;
    };
    result = aot_invoke(id, args, 0, 0, 0);
    nếu (count >= 1 && count <= 4) { aot_release_args(frame); };
    trả về aot_push(frame, result);
};
// Callee nằm trong ô biến: đọc trực tiếp thay vì đẩy giá trị lên stack rồi
