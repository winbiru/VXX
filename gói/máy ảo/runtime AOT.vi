};
hàm aot_numeric_add_loop_body(frame, counter, bound, left, right, result, keep) {
    nếu (keep == 0 && vm_get(aot_stack(frame), 1) != 0) { trả về 1; };
    nếu (counter == result) { trả về 1; };
    biến state = aot_state();
    biến counter_cell = vm_cell(state, frame, counter, 0);
    nếu (aot_o_i32(counter_cell) == 0) { trả về 1; };
    biến first = aot_doc_i32(counter_cell);
    nếu (first >= bound) { trả về 0; };
    nếu (first < 0 && bound >= 0) { trả về 1; };
    biến remaining = bound - first;
    nếu (remaining > 1000000) { trả về 1; };
    nếu (remaining <= 0) { trả về 0; };
    biến left_cell = vm_cell(state, frame, left, 0);
    biến right_cell = vm_cell(state, frame, right, 0);
    biến result_cell = vm_cell(state, frame, result, 0);
    nếu (aot_o_i32(left_cell) == 0 || aot_o_i32(right_cell) == 0 || result_cell == 0 ||
        result_cell == counter_cell) { trả về 1; };
    biến left_number = aot_doc_i32(left_cell);
    biến right_number = aot_doc_i32(right_cell);
    biến number = 0;
    biến completed = 0;
    khi (completed < remaining) {
        biến count = remaining - completed;
        nếu (count > 4096) { count = 4096; };
        lặp(j = 0; j < count; j++) {
            biến induction = first + completed + j;
            biến a = left_number;
            biến b = right_number;
            nếu (left_cell == counter_cell) { a = induction; }
            hoặc nếu (left_cell == result_cell && completed + j > 0) { a = number; };
            nếu (right_cell == counter_cell) { b = induction; }
            hoặc nếu (right_cell == result_cell && completed + j > 0) { b = number; };
            number = a + b;
        };
        nếu (aot_ghi_i32(frame, result_cell, number)) { trả về 2; };
        nếu (aot_loop_counters(frame, counter_cell, first + completed, count, keep)) { trả về 2; };
        completed = completed + count;
    };
    trả về 0;
};
hàm aot_numeric_add_loop(frame, counter, bound, left, right, result) {
    trả về aot_numeric_add_loop_body(frame, counter, bound, left, right, result, 1);
};
hàm aot_numeric_add_loop_tail(frame, counter, bound, left, right, result) {
    trả về aot_numeric_add_loop_body(frame, counter, bound, left, right, result, 0);
};
// Chạy trọn vòng list thêm (base + i) sau một lần kiểm tra kiểu. Grow list
// được làm ngay tại đây theo đúng quy tắc vm_append, bỏ một lời gọi mỗi lượt.
hàm aot_list_append_i32_loop(frame, counter, bound, list_slot, base_slot, keep) {
    biến state = aot_state();
    biến counter_cell = vm_cell(state, frame, counter, 0);
    nếu (aot_o_i32(counter_cell) == 0) { trả về 1; };
    biến first = aot_doc_i32(counter_cell);
    nếu (first >= bound) { trả về 0; };
    nếu (first < 0 && bound >= 0) { trả về 1; };
    biến remaining = bound - first;
    nếu (remaining <= 0) { trả về 0; };
    nếu (remaining > 1000000) { trả về 1; };
    biến list_cell = vm_cell(state, frame, list_slot, 0);
    biến base_cell = vm_cell(state, frame, base_slot, 0);
    nếu (list_cell == 0 || base_cell == 0 || aot_o_i32(base_cell) == 0) { trả về 1; };
    biến list = vm_get(list_cell, 1);
    nếu (vm_tag(list) != 4) { trả về 1; };
    biến base = aot_doc_i32(base_cell);
    biến n = vm_get(list, 1);
    biến capacity = vm_get(list, 2);
    biến data = vm_get(list, 3);
    nếu (n < 0 || capacity <= 0 || n > capacity || data == 0) { trả về 1; };
    biến cache số = vm_get(4198464, 17);
    biến completed = 0;
    khi (completed < remaining) {
        biến count = remaining - completed;
        nếu (count > 4096) { count = 4096; };
        biến done = 0;
        lặp(j = 0; j < count; j++) {
            biến induction = first + completed + j;
            biến left = base;
            nếu (base_cell == counter_cell) { left = induction; };
            biến number = left + induction;
            biến phần tử vòng = 0;
            nếu (cache số != 0 && number >= -16 && number <= 4095) {
                phần tử vòng = vm_get(cache số, number + 16);
            };
            nếu (phần tử vòng == 0) {
                phần tử vòng = vm_int(number);
                nếu (cache số == 0 && number >= -16 && number <= 4095) {
                    cache số = vm_get(4198464, 17);
                };
            };
            nếu (aot_status()) {
                nếu (done > 0) { aot_loop_counters(frame, counter_cell, first + completed, done, keep); };
                trả về 2;
            };
            nếu (n == capacity) {
                capacity = capacity * 4;
                nếu (capacity > 2000000) {
                    vm_capacity_error(3, capacity, 2000000);
                    nếu (done > 0) { aot_loop_counters(frame, counter_cell, first + completed, done, keep); };
                    trả về 2;
                };
                biến raw = vm_alloc(capacity * 4, 1);
                nếu (raw == 0) {
                    nếu (done > 0) { aot_loop_counters(frame, counter_cell, first + completed, done, keep); };
                    trả về 2;
                };
                lặp(k = 0; k < n; k++) { vm_set(raw, k, vm_get(data, k)); };
                nếu (data == list + 16) {
                    vm_set(data, 0, 0); vm_set(data, 1, 0);
                };
                data = raw;
                vm_set(list, 2, capacity);
                vm_set(list, 3, data);
            };
            vm_set(data, n, phần tử vòng);
            n += 1;
            vm_set(list, 1, n);
            done += 1;
        };
        nếu (aot_loop_counters(frame, counter_cell, first + completed, count, keep)) { trả về 2; };
        completed += count;
    };
    trả về 0;
};
// Chạy trọn vòng lọc/tổng trên vùng list i32. Quét kiểu trước khi ghi để
// mọi trường hợp động vẫn quay lại bytecode mà chưa làm thay đổi trạng thái.
hàm aot_list_mod_sum_loop(frame, counter, bound, source_slot, target_slot, divisor, expected, keep) {
    biến state = aot_state();
    biến counter_cell = vm_cell(state, frame, counter, 0);
    nếu (aot_o_i32(counter_cell) == 0) { trả về 1; };
    biến first = aot_doc_i32(counter_cell);
    nếu (first >= bound) { trả về 0; };
    nếu (first < 0 || divisor == 0) { trả về 1; };
    biến remaining = bound - first;
    nếu (remaining <= 0) { trả về 0; };
    nếu (remaining > 1000000) { trả về 1; };
    biến source_cell = vm_cell(state, frame, source_slot, 0);
    biến target_cell = vm_cell(state, frame, target_slot, 0);
    nếu (source_cell == 0 || target_cell == 0 || target_cell == counter_cell ||
        aot_o_i32(target_cell) == 0) { trả về 1; };
    biến source = vm_get(source_cell, 1);
    biến kind = vm_tag(source);
    nếu (kind != 4 && kind != 6) { trả về 1; };
    nếu (bound > vm_get(source, 1)) { trả về 1; };
    biến data = vm_get(source, 3);
    lặp(j = first; j < bound; j++) {
        nếu (vm_tag(vm_get(data, j)) != 1) { trả về 1; };
    };
    biến number = aot_doc_i32(target_cell);
    biến completed = 0;
    khi (completed < remaining) {
        biến count = remaining - completed;
        nếu (count > 4096) { count = 4096; };
        lặp(j = 0; j < count; j++) {
            biến value = vm_get(vm_get(data, first + completed + j), 1);
            biến remainder = 0;
            nếu (value == -2147483648 && divisor == -1) { remainder = 0; }
            hoặc { remainder = value - máy chia số nguyên ba mươi hai bit(value, divisor) * divisor; };
            nếu (remainder == expected) { number = number + value; };
        };
        nếu (aot_ghi_i32(frame, target_cell, number)) { trả về 2; };
        nếu (aot_loop_counters(frame, counter_cell, first + completed, count, keep)) { trả về 2; };
        completed += count;
    };
    trả về 0;
};
// Dãy i32 không thoát: tính trực tiếp (base + i), lọc theo modulo và cộng
// vào tổng. Compiler chỉ gọi đường này khi list trung gian không còn được đọc.
hàm aot_range_mod_sum_i32_loop(frame, base_slot, target_slot, bound, divisor, expected) {
    nếu (bound < 0 || bound > 1000000 || divisor == 0) { trả về 1; };
    biến state = aot_state();
    biến base_cell = vm_cell(state, frame, base_slot, 0);
    biến target_cell = vm_cell(state, frame, target_slot, 0);
    nếu (base_cell == 0 || target_cell == 0 || base_cell == target_cell ||
        aot_o_i32(base_cell) == 0) { trả về 1; };
    biến base = aot_doc_i32(base_cell);
    biến total = 0;
    lặp(i = 0; i < bound; i++) {
        biến value = base + i;
        biến remainder = 0;
        nếu (value == -2147483648 && divisor == -1) { remainder = 0; }
        hoặc { remainder = value - máy chia số nguyên ba mươi hai bit(value, divisor) * divisor; };
        nếu (remainder == expected) { total = total + value; };
    };
    nếu (aot_ghi_i32(frame, target_cell, total)) { trả về 2; };
    trả về 0;
};
// Vòng gọi hàm i32 đã được compiler chứng minh có dạng checksum += fn(...) % n.
// Con trỏ hàm không đi qua giá trị V++; primitive ASM chỉ nhận mã hàm và hai i32.
hàm aot_indirect_i32_fold_loop(frame, counter, bound, checksum, callable, data, seed, packed) {
    biến stack = aot_stack(frame);
    nếu (vm_get(stack, 1) != 0) { trả về 1; };
    biến cycle = (packed >> 16) & 65535;
    biến divisor = packed & 65535;
    nếu (cycle <= 0 || divisor <= 0) { trả về 1; };

    biến state = aot_state();
    biến counter_cell = vm_cell(state, frame, counter, 0);
    biến bound_cell = vm_cell(state, frame, bound, 0);
    biến checksum_cell = vm_cell(state, frame, checksum, 0);
    biến callable_cell = vm_cell(state, frame, callable, 0);
    biến seed_cell = vm_cell(state, frame, seed, 0);
    nếu (counter_cell == 0 || bound_cell == 0 || checksum_cell == 0 ||
        callable_cell == 0 || seed_cell == 0) { trả về 1; };
    nếu (counter_cell == bound_cell || counter_cell == checksum_cell ||
        counter_cell == callable_cell || counter_cell == seed_cell ||
        checksum_cell == bound_cell || checksum_cell == callable_cell ||
        checksum_cell == seed_cell) { trả về 1; };
    nếu (aot_o_i32(counter_cell) == 0 || aot_o_i32(bound_cell) == 0 ||
        aot_o_i32(seed_cell) == 0) { trả về 1; };

    biến first = aot_doc_i32(counter_cell);
    biến limit = aot_doc_i32(bound_cell);
    // Giữ phép trừ trong miền i32 chắc chắn an toàn; các biên cực đoan về bytecode.
    nếu (first < -1000000000 || first > 1000000000 ||
        limit < -1000000000 || limit > 1000000000) { trả về 1; };
    biến iterations = limit - first;
    nếu (iterations <= 0) { trả về 0; };
    nếu (iterations > 100000000) { trả về 1; };

    biến callable_value = vm_get(callable_cell, 1);
    biến callee = -1;
    nếu (aot_o_i32(callable_cell)) { callee = aot_doc_i32(callable_cell); }
    hoặc nếu (vm_tag(callable_value) == 7) {
        biến captures = vm_get(callable_value, 2);
        nếu ((captures != 0 && vm_get(captures, 1) != 0) || vm_get(callable_value, 3) != 0) {
            trả về 1;
        };
        callee = vm_get(callable_value, 1);
    } hoặc nếu (vm_tag(callable_value) == 3) {
        callee = vm_find_function(state, callable_value);
    };
    nếu (callee < 0) { trả về 1; };
    nếu (máy aot thông tin(30, callee, 0) != 2) { trả về 1; };
    biến used_mask = máy aot thông tin(31, callee, 0);
    nếu (used_mask < 0) { trả về 1; };

    biến arg_data = 0;
    nếu ((used_mask & 2) != 0) {
        biến data_cell = vm_cell(state, frame, data, 0);
        nếu (data_cell == 0 || data_cell == counter_cell || data_cell == checksum_cell ||
            aot_o_i32(data_cell) == 0) { trả về 1; };
        arg_data = aot_doc_i32(data_cell);
    };

    biến checksum_value = vm_get(checksum_cell, 1);
    nếu (vm_tag(checksum_value) != 2) { trả về 1; };
    // Một cấp phát giữ hai f64 và cấu hình batch i32, không cấp phát trong vòng nóng.
    biến scratch = vm_alloc(56, 0);
    nếu (scratch == 0) { trả về 2; };
    biến total_value = scratch;
    biến delta_value = scratch + 16;
    biến fold_args = scratch + 32;
    vm_set(total_value, 0, 2); vm_set(total_value, 1, 0);
    vm_set(delta_value, 0, 2); vm_set(delta_value, 1, 0);
    máy thực từ nguyên(delta_value, 0);
    máy thực phép(total_value, checksum_value, delta_value);

    biến seed_value = aot_doc_i32(seed_cell);
    biến completed = 0;
    khi (completed < iterations) {
        biến count = iterations - completed;
        nếu (count > 4096) { count = 4096; };
        máy ghi số nguyên ba mươi hai bit(fold_args, first + completed);
        máy ghi số nguyên ba mươi hai bit(fold_args + 4, count);
        máy ghi số nguyên ba mươi hai bit(fold_args + 8, seed_value);
        máy ghi số nguyên ba mươi hai bit(fold_args + 12, arg_data);
        máy ghi số nguyên ba mươi hai bit(fold_args + 16, cycle);
        máy ghi số nguyên ba mươi hai bit(fold_args + 20, divisor);
        biến batch_total = máy aot gập i32(callee, fold_args);
        completed += count;
        máy thực từ nguyên(delta_value, batch_total);
        máy thực phép(total_value, total_value, delta_value);
        vm_set(checksum_cell, 1, total_value);
        nếu (aot_ghi_i32(frame, counter_cell, first + completed)) { trả về 2; };
        nếu (aot_safepoint(frame)) { trả về 2; };
    };
    trả về 0;
};
hàm aot_collection(frame, count, encoded, tag) {
    biến value = 0;
    nếu (encoded >= 0) { value = vm_decode_literal(vm_pool(aot_state(), encoded), tag); }
    hoặc {
        nếu (tag == 5) { count = count * 2; };
        biến items = vm_take(aot_stack(frame), count); value = vm_vector(tag);
        lặp(i = 0; i < count; i++) {
            nếu (tag == 5) {
                biến key = vm_at(items, i); i = i + 1;
                nếu (vm_tag(key) != 3) { vm_error(2); trả về 1; };
                vm_map_put(value, key, vm_at(items, i));
            } hoặc { vm_append(value, vm_at(items, i)); };
        };
    };
    trả về aot_push(frame, value);
};
hàm aot_list(frame, count, encoded) { trả về aot_collection(frame, count, encoded, 4); };
hàm aot_map(frame, count, encoded) { trả về aot_collection(frame, count, encoded, 5); };
hàm aot_index(frame) {
    biến stack = aot_stack(frame); biến key = vm_pop(stack); biến value = vm_pop(stack);
    trả về aot_push(frame, vm_index(value, key));
};
// Đọc trực tiếp từ ô chỉ số i32; khi kiểu đổi, giữ nguyên phép đọc động.
hàm aot_index_slot(frame, container_slot, index, is_slot) {
    biến container = vm_load_slot(aot_state(), frame, container_slot);
    biến has_i32 = is_slot == 0;
    biến number = index;
    nếu (is_slot != 0) {
        biến cell = vm_cell(aot_state(), frame, index, 0);
        nếu (aot_o_i32(cell)) { number = aot_doc_i32(cell); has_i32 = 1; };
    };
    nếu (has_i32) {
        biến kind = vm_tag(container);
        // Danh sách và bộ chứa cùng bố cục ô phần tử. Đọc thẳng từ
        // vùng dữ liệu khi chỉ số i32 đã được chứng minh tại lời gọi AOT.
        nếu (kind == 4 || kind == 6) {
            nếu (number < 0 || number >= vm_get(container, 1)) {
                vm_error(4);
                trả về 1;
            };
            trả về aot_push(frame, vm_get(vm_get(container, 3), number));
        };
        nếu (kind != 5) {
            trả về aot_push(frame, vm_index_i32(container, number));
        };
    };
    biến key = 0;
    nếu (is_slot != 0) { key = vm_load_slot(aot_state(), frame, index); }
    hoặc { key = vm_int(number); };
    trả về aot_push(frame, vm_index(container, key));
};
// Đọc container[index] và so sánh ngay với một hằng i32. Đường nóng của
// parser byte không tạo giá trị trung gian trên stack AOT và không gọi
// vm_binary khi phần tử, chỉ số và phép so sánh đều là số nguyên.
hàm aot_index_compare_integer(frame, container_slot, index, is_slot, immediate, op) {
    biến state = aot_state();
    biến container = vm_load_slot(state, frame, container_slot);
    nếu (aot_status()) { trả về 2; };
    biến has_i32 = is_slot == 0;
    biến number = index;
    biến key = 0;
    nếu (is_slot != 0) {
        biến cell = vm_cell(state, frame, index, 0);
        nếu (aot_o_i32(cell)) {
            number = aot_doc_i32(cell);
            has_i32 = 1;
        } hoặc {
            key = vm_load_slot(state, frame, index);
            nếu (aot_status()) { trả về 2; };
        };
    };
    nếu (has_i32) {
        biến kind = vm_tag(container);
        nếu (kind == 4 || kind == 6) {
            nếu (number < 0 || number >= vm_get(container, 1)) {
                vm_error(4);
                trả về 2;
            };
            biến value = vm_get(vm_get(container, 3), number);
            nếu (op >= 7 && op <= 12 && vm_tag(value) == 1) {
                trả về aot_compare_i32(vm_get(value, 1), immediate, op);
            };
            biến result = vm_binary(op, value, vm_int(immediate));
            nếu (aot_status()) { trả về 2; };
            trả về vm_truth(result);
        };
        nếu (kind == 13) {
            nếu (number < 0 || number >= vm_get(container, 1)) { vm_error(4); trả về 2; };
            nếu (op >= 7 && op <= 12) { trả về aot_compare_i32(máy đọc byte(vm_get(container, 2) + number), immediate, op); };
        };
    };
    nếu (key == 0) { key = vm_int(number); };
    biến value = vm_index(container, key);
    nếu (aot_status()) { trả về 2; };
    biến result = vm_binary(op, value, vm_int(immediate));
    nếu (aot_status()) { trả về 2; };
    trả về vm_truth(result);
};
// Gộp hai lần đọc cùng container[index] cho điều kiện ngoài khoảng.
// Đường nhanh chỉ đọc phần tử i32 một lần; đường động vẫn đánh giá eager.
hàm aot_index_compare_integer_outside_range(frame, container_slot, index, is_slot, low, high) {
    biến state = aot_state();
    biến container = vm_load_slot(state, frame, container_slot);
    nếu (aot_status()) { trả về 2; };
    biến has_i32 = is_slot == 0;
    biến number = index;
    biến key = 0;
    nếu (is_slot != 0) {
        biến cell = vm_cell(state, frame, index, 0);
        nếu (aot_o_i32(cell)) {
            number = aot_doc_i32(cell);
            has_i32 = 1;
        } hoặc {
            key = vm_load_slot(state, frame, index);
            nếu (aot_status()) { trả về 2; };
        };
    };
    nếu (has_i32) {
        biến kind = vm_tag(container);
        nếu (kind == 4 || kind == 6) {
            nếu (number < 0 || number >= vm_get(container, 1)) {
                vm_error(4);
                trả về 2;
            };
            biến value = vm_get(vm_get(container, 3), number);
            nếu (vm_tag(value) == 1) {
                biến x = vm_get(value, 1);
                trả về x < low || x > high;
            };
        };
        nếu (kind == 13) {
            nếu (number < 0 || number >= vm_get(container, 1)) { vm_error(4); trả về 2; };
            biến x = máy đọc byte(vm_get(container, 2) + number);
            trả về x < low || x > high;
        };
    };
    nếu (key == 0) { key = vm_int(number); };
    biến first_value = vm_index(container, key);
    nếu (aot_status()) { trả về 2; };
    biến lower = vm_binary(10, first_value, vm_int(low));
    nếu (aot_status()) { trả về 2; };
    biến second_value = vm_index(container, key);
    nếu (aot_status()) { trả về 2; };
    biến upper = vm_binary(9, second_value, vm_int(high));
    biến result = vm_binary(5, lower, upper);
    nếu (aot_status()) { trả về 2; };
    trả về vm_truth(result);
};
// So sánh cùng một phần tử với hai hằng số: x == a || x == b.
hàm aot_index_compare_integer_pair(frame, container_slot, index, is_slot, a, b) {
    biến state = aot_state();
    biến container = vm_load_slot(state, frame, container_slot);
    nếu (aot_status()) { trả về 2; };
    biến has_i32 = is_slot == 0;
    biến number = index;
    biến key = 0;
    nếu (is_slot != 0) {
        biến cell = vm_cell(state, frame, index, 0);
        nếu (aot_o_i32(cell)) {
            number = aot_doc_i32(cell);
            has_i32 = 1;
        } hoặc {
            key = vm_load_slot(state, frame, index);
            nếu (aot_status()) { trả về 2; };
        };
    };
    nếu (has_i32) {
        biến kind = vm_tag(container);
        nếu (kind == 4 || kind == 6) {
            nếu (number < 0 || number >= vm_get(container, 1)) {
                vm_error(4);
                trả về 2;
            };
            biến value = vm_get(vm_get(container, 3), number);
            nếu (vm_tag(value) == 1) {
                biến x = vm_get(value, 1);
                trả về x == a || x == b;
            };
        };
        nếu (kind == 13) {
            nếu (number < 0 || number >= vm_get(container, 1)) { vm_error(4); trả về 2; };
            biến x = máy đọc byte(vm_get(container, 2) + number);
            trả về x == a || x == b;
        };
    };
    nếu (key == 0) { key = vm_int(number); };
    biến first_value = vm_index(container, key);
    nếu (aot_status()) { trả về 2; };
    biến first = vm_binary(7, first_value, vm_int(a));
    nếu (aot_status()) { trả về 2; };
    biến second_value = vm_index(container, key);
    nếu (aot_status()) { trả về 2; };
    biến second = vm_binary(7, second_value, vm_int(b));
    biến result = vm_binary(5, first, second);
    nếu (aot_status()) { trả về 2; };
    trả về vm_truth(result);
};
// Gộp container[index] rồi gán vào một ô. Với phần tử i32, ghi thẳng số
// nguyên vào ô cục bộ để không tạo giá trị trung gian trên stack AOT.
hàm aot_index_store_slot(frame, container_slot, index, is_slot, target_slot) {
    biến state = aot_state();
    biến container = vm_load_slot(state, frame, container_slot);
    nếu (aot_status()) { trả về 1; };
    biến has_i32 = is_slot == 0;
    biến number = index;
    biến key = 0;
    nếu (is_slot != 0) {
        biến cell = vm_cell(state, frame, index, 0);
        nếu (aot_o_i32(cell)) {
            number = aot_doc_i32(cell);
            has_i32 = 1;
        } hoặc {
            key = vm_load_slot(state, frame, index);
            nếu (aot_status()) { trả về 1; };
        };
    };
    biến value = 0;
    nếu (has_i32) {
        biến kind = vm_tag(container);
        nếu (kind == 13) {
            nếu (number < 0 || number >= vm_get(container, 1)) { vm_error(4); trả về 1; };
            biến dest = vm_cell(state, frame, target_slot, 1);
            nếu (aot_status()) { trả về 1; };
            trả về aot_ghi_i32(frame, dest, máy đọc byte(vm_get(container, 2) + number));
        };
        nếu (kind == 4 || kind == 6) {
            nếu (number < 0 || number >= vm_get(container, 1)) {
                vm_error(4);
                trả về 1;
            };
            value = vm_get(vm_get(container, 3), number);
        } hoặc {
            nếu (kind == 5) {
                value = vm_index(container, vm_int(number));
            } hoặc {
                value = vm_index_i32(container, number);
            };
            nếu (aot_status()) { trả về 1; };
        };
    } hoặc {
        value = vm_index(container, key);
        nếu (aot_status()) { trả về 1; };
    };
    nếu (vm_tag(value) == 1) {
        biến dest = vm_cell(state, frame, target_slot, 1);
        nếu (aot_status()) { trả về 1; };
        trả về aot_ghi_i32(frame, dest, vm_get(value, 1));
    };
    vm_store(state, frame, target_slot, value);
    trả về aot_status();
};
// Gộp đọc container[ô + hằng], gán hoặc so sánh. Chỉ số i32 và byte
// của view giữ ở dạng thô; các kiểu động vẫn dùng vm_binary/vm_index.
// mode: 0 = push, 1 = store, 2 = compare (0/1/2 theo ABI nhánh).
hàm aot_index_offset(frame, container_slot, index_slot, offset, mode, argument, op) {
    biến error = 1;
    nếu (mode == 2) { error = 2; };
    biến state = aot_state();
    biến container = vm_load_slot(state, frame, container_slot);
    nếu (aot_status()) { trả về error; };
    biến cell = vm_cell(state, frame, index_slot, 0);
    biến number = 0; biến key = 0;
    biến raw = aot_o_i32(cell);
    nếu (raw) { number = aot_doc_i32(cell) + offset; }
    hoặc {
        biến source = vm_load_slot(state, frame, index_slot);
        nếu (aot_status()) { trả về error; };
        biến right = vm_int(offset);
        nếu (aot_status()) { trả về error; };
        key = vm_binary(0, source, right);
        nếu (aot_status()) { trả về error; };
    };
    biến value = 0;
    nếu (raw) {
        biến kind = vm_tag(container);
        nếu (kind == 13) {
            nếu (number < 0 || number >= vm_get(container, 1)) { vm_error(4); trả về error; };
            biến byte = máy đọc byte(vm_get(container, 2) + number);
            nếu (mode == 2) { trả về aot_compare_i32(byte, argument, op); };
            nếu (mode == 1) {
                biến dest = vm_cell(state, frame, argument, 1);
                nếu (aot_status()) { trả về error; };
                trả về aot_ghi_i32(frame, dest, byte);
            };
            trả về aot_push(frame, vm_int(byte));
        };
        nếu (kind == 5) {
            key = vm_int(number);
            nếu (aot_status()) { trả về error; };
            value = vm_index(container, key);
        } hoặc { value = vm_index_i32(container, number); };
    } hoặc { value = vm_index(container, key); };
    nếu (aot_status()) { trả về error; };
    nếu (mode == 2) {
        nếu (vm_tag(value) == 1) { trả về aot_compare_i32(vm_get(value, 1), argument, op); };
        biến right = vm_int(argument);
        nếu (aot_status()) { trả về error; };
        biến result = vm_binary(op, value, right);
        nếu (aot_status()) { trả về error; };
        trả về vm_truth(result);
    };
    nếu (mode == 1) {
        nếu (vm_tag(value) == 1) {
            biến dest = vm_cell(state, frame, argument, 1);
            nếu (aot_status()) { trả về error; };
            trả về aot_ghi_i32(frame, dest, vm_get(value, 1));
        };
        vm_store(state, frame, argument, value);
        trả về aot_status();
    };
    trả về aot_push(frame, value);
};
hàm aot_index_store_integer_op(frame, container_slot, index, source_slot, immediate, op) {
    biến state = aot_state();
    // Giữ đúng thứ tự bytecode: container, chỉ số, source, hằng, phép toán.
    biến container = vm_load_slot(state, frame, container_slot);
    nếu (aot_status()) { trả về 1; };
    biến key = vm_int(index);
    nếu (aot_status()) { trả về 1; };
    biến source_cell = vm_cell(state, frame, source_slot, 0);
    biến source = 0; biến number = 0; biến raw = aot_o_i32(source_cell);
    nếu (raw) { number = aot_doc_i32(source_cell); }
    hoặc { source = vm_load_slot(state, frame, source_slot); };
    nếu (aot_status()) { trả về 1; };
    biến right = vm_int(immediate);
    nếu (aot_status()) { trả về 1; };
    biến result = 0;
    nếu (raw && op >= 0 && op <= 2) {
        biến value = number + immediate;
        nếu (op == 1) { value = number - immediate; };
        nếu (op == 2) { value = number * immediate; };
        result = vm_int(value);
    } hoặc {
        nếu (raw) { source = vm_int(number); };
        nếu (aot_status()) { trả về 1; };
        result = vm_binary(op, source, right);
    };
    nếu (aot_status()) { trả về 1; };
    nếu (vm_tag(container) == 5) { vm_map_put(container, vm_text(key), result); }
    hoặc nếu (vm_tag(container) == 4 && vm_tag(key) == 1) { vm_put(container, vm_number(key), result); }
    hoặc { vm_error(2); };
    trả về aot_status();
};
// Gộp danh_sách[i] % hằng so_sánh hằng. Khi bộ chứa, chỉ số hoặc phần tử
// không còn là i32, chạy lại đúng đường động để giữ nguyên lỗi và thứ tự đánh giá.
hàm aot_index_mod_equal(frame, container_slot, index, divisor, expected, mask) {
    biến state = aot_state();
    biến container = vm_load_slot(state, frame, container_slot);
    nếu (aot_status()) { trả về 1; };
    biến number = index; biến raw_index = (mask & 1) == 0; biến key = 0;
    nếu ((mask & 1) != 0) {
        biến cell = vm_cell(state, frame, index, 0);
        nếu (aot_o_i32(cell)) { number = aot_doc_i32(cell); raw_index = đúng; }
        hoặc { key = vm_load_slot(state, frame, index); };
    };
    nếu (aot_status()) { trả về 1; };
    biến value = 0; biến kind = vm_tag(container);
    nếu (raw_index && (kind == 4 || kind == 6)) {
        nếu (number < 0 || number >= vm_get(container, 1)) { vm_error(4); trả về 1; };
        value = vm_get(vm_get(container, 3), number);
    } hoặc {
        nếu (raw_index) { key = vm_int(number); };
        value = vm_index(container, key);
        nếu (aot_status()) { trả về 1; };
    };
    nếu (vm_tag(value) == 1 && divisor != 0) {
        biến x = vm_get(value, 1); biến remainder = 0;
        nếu (x == -2147483648 && divisor == -1) { remainder = 0; }
        hoặc { remainder = x - máy chia số nguyên ba mươi hai bit(x, divisor) * divisor; };
        biến result = remainder == expected;
        nếu ((mask & 2) != 0) { result = !result; };
        trả về aot_push(frame, vm_int(result));
    };
    biến modulo = vm_binary(64, value, vm_int(divisor));
    nếu (aot_status()) { trả về 1; };
    biến operation = 7; nếu ((mask & 2) != 0) { operation = 8; };
    trả về aot_push(frame, vm_binary(operation, modulo, vm_int(expected)));
};
// Gộp điều kiện danh_sách[i] % C == E với tổng += danh_sách[i].
// Không đẩy boolean trung gian lên stack; đường động vẫn giữ đúng thứ tự
// đánh giá điều kiện rồi mới đọc/cập nhật ô tổng khi điều kiện đúng.
hàm aot_index_mod_add_if_equal(frame, container_slot, index_slot, target_slot, divisor, expected) {
    biến state = aot_state();
    biến container = vm_load_slot(state, frame, container_slot);
    nếu (aot_status()) { trả về 1; };
    biến key_cell = vm_cell(state, frame, index_slot, 0);
    biến value = 0; biến kind = vm_tag(container);
    nếu ((kind == 4 || kind == 6) && aot_o_i32(key_cell)) {
        biến at = aot_doc_i32(key_cell);
        nếu (at < 0 || at >= vm_get(container, 1)) { vm_error(4); trả về 1; };
        value = vm_get(vm_get(container, 3), at);
    } hoặc {
        biến key = vm_load_slot(state, frame, index_slot);
        nếu (aot_status()) { trả về 1; };
        value = vm_index(container, key);
        nếu (aot_status()) { trả về 1; };
    };
    biến equal = 0;
    nếu (vm_tag(value) == 1 && divisor != 0) {
        biến x = vm_get(value, 1); biến remainder = 0;
        nếu (x == -2147483648 && divisor == -1) { remainder = 0; }
        hoặc { remainder = x - máy chia số nguyên ba mươi hai bit(x, divisor) * divisor; };
        equal = remainder == expected;
    } hoặc {
        biến modulo = vm_binary(64, value, vm_int(divisor));
        nếu (aot_status()) { trả về 1; };
        biến result = vm_binary(7, modulo, vm_int(expected));
        nếu (aot_status()) { trả về 1; };
        equal = vm_truth(result);
    };
    nếu (!equal) { trả về 0; };
    trả về aot_index_update(frame, target_slot, container_slot, index_slot, 0);
};
// Khóa chuỗi từ pool đã là giá trị động hợp lệ, không cần stack trung gian.
hàm aot_index_string_slot(frame, container_slot, pool_index) {
    biến container = vm_load_slot(aot_state(), frame, container_slot);
    biến key = vm_pool(aot_state(), pool_index);
    nếu (vm_tag(container) == 5) { trả về aot_push(frame, vm_map_get(container, key)); };
    trả về aot_push(frame, vm_index(container, key));
};
// Bit 0: chỉ số là ô; bit 1: vế phải là ô; bit 2: so sánh khác.
// Giữ thứ tự đọc nguồn, chỉ số, kiểm tra biên rồi mới đọc vế phải.
hàm aot_index_equal(frame, source, index, other, mask) {
    biến state = aot_state();
    biến container = vm_load_slot(state, frame, source);
    nếu (aot_status()) { trả về 1; };
    biến number = index; biến raw = 1;
    nếu ((mask & 1) != 0) {
        biến cell = vm_cell(state, frame, index, 0);
        raw = aot_o_i32(cell);
        nếu (raw) { number = aot_doc_i32(cell); };
    };
    biến left = 0; biến at = 0; biến width = 0;
    biến text = vm_tag(container) == 3 && raw;
    nếu (text) {
        at = vm_char_offset(container, number);
        nếu (aot_status()) { trả về 1; };
        width = vm_utf8_width(container, at);
        // Cùng lỗi với vm_slice nếu chuỗi byte kết thúc giữa điểm mã.
        nếu (width > vm_get(container, 1) - at) { vm_error(3); trả về 1; };
    } hoặc {
        biến key = 0;
        nếu ((mask & 1) != 0) { key = vm_load_slot(state, frame, index); }
        hoặc { key = vm_int(index); };
        nếu (aot_status()) { trả về 1; };
        left = vm_index(container, key);
        nếu (aot_status()) { trả về 1; };
    };
    biến right = 0;
    nếu ((mask & 2) != 0) { right = vm_load_slot(state, frame, other); }
    hoặc { right = vm_pool(state, other); };
    nếu (aot_status()) { trả về 1; };
    biến equal = 0;
    nếu (text) {
        nếu (vm_tag(right) == 3 && vm_get(right, 1) == width) {
            equal = 1;
            biến a = vm_get(container, 2) + at; biến b = vm_get(right, 2);
            lặp(i = 0; i < width; i++) {
                nếu (máy đọc byte(a + i) != máy đọc byte(b + i)) { equal = 0; thoát; };
