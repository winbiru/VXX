// Fast path chỉ có receiver trên stack. Khi hàm ASCII trả i32, bỏ receiver
// và thay bằng kết quả động đúng như OP_GOI_PHUONG_THUC một đối số.
hàm aot_fast_receiver_result(frame, number) {
    biến value = vm_int(number);
    nếu (aot_status()) { trả về 1; };
    biến stack = aot_stack(frame);
    nếu (vm_get(stack, 1) < 1) { vm_error(5); trả về 1; };
    vm_pop(stack);
    trả về aot_push(frame, value);
};
hàm aot_fast_result(frame, count, number) {
    biến value = vm_int(number);
    nếu (aot_status()) { trả về 1; };
    biến stack = aot_stack(frame);
    lặp(i = 0; i <= count; i++) { vm_pop(stack); };
    trả về aot_push(frame, value);
};
hàm aot_fast_result_slot(frame, count, number) {
    biến value = vm_int(number);
    nếu (aot_status()) { trả về 1; };
    biến stack = aot_stack(frame);
    nếu (count < 0 || vm_get(stack, 1) < count) { vm_error(5); trả về 1; };
    lặp(i = 0; i < count; i++) { vm_pop(stack); };
    trả về aot_push(frame, value);
};
hàm aot_method_id(frame, name, count, super_call) {
    biến stack = aot_stack(frame); biến n = vm_get(stack, 1);
    nếu (count < 0 || n < count + 1) { trả về -1; };
    biến instance = vm_get(vm_get(stack, 3), n - count - 1);
    biến method = aot_probe_method(frame, instance, name, super_call);
    nếu (method == 0 || aot_status()) { trả về -1; };
    trả về vm_get(method, 0);
};
hàm aot_closure(frame, id, count) {
    biến ids = vm_take(aot_stack(frame), count); biến closure = vm_alloc(16, 1);
    nếu (closure == 0) { trả về 1; };
    vm_set(closure, 0, 7); vm_set(closure, 1, id); vm_set(closure, 2, vm_vector(5)); vm_set(closure, 3, vm_get(frame, 6));
    lặp(i = 0; i < count; i++) {
        biến slot = vm_at(ids, i);
        nếu (vm_tag(slot) != 1) { vm_error(2); trả về 1; };
        vm_map_put(vm_get(closure, 2), slot, vm_capture_cell(aot_state(), frame, vm_number(slot)));
    };
