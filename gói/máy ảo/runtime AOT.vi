            biến value = vm_get(vm_get(stack, 3), n - 1);
            vm_set(4198464, 13, op);
            biến độ dài giá trị = vm_int(vm_length(value));
            vm_pop(stack);
            trả về aot_push(frame, độ dài giá trị);
        };
