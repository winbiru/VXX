    nếu (aot_status()) { trả về 1; };
    biến args = aot_take_args(frame, count); biến id = -1;
    nếu (aot_status()) { trả về 1; };
    biến result = 0;
    nếu (vm_tag(callee) == 7) {
        result = aot_invoke(vm_get(callee, 1), args, 0, 0, callee);
        nếu (count >= 1 && count <= 4) { aot_release_args(frame); };
        nếu (aot_status()) { trả về 1; };
        trả về aot_push(frame, result);
    };
    nếu (vm_tag(callee) == 3) { id = vm_find_function(aot_state(), callee); }
    hoặc nếu (vm_tag(callee) == 1) { id = vm_number(callee); };
    nếu (id < 0) {
        nếu (count >= 1 && count <= 4) { aot_release_args(frame); };
        vm_error(13); trả về 1;
    };
    result = aot_invoke(id, args, 0, 0, 0);
    nếu (count >= 1 && count <= 4) { aot_release_args(frame); };
    nếu (aot_status()) { trả về 1; };
    trả về aot_push(frame, result);
};
// Các phép dò không lấy đối số khỏi stack. Nhánh chậm vẫn thấy dữ liệu gốc.
hàm aot_callee_id(frame) {
    biến stack = aot_stack(frame); biến n = vm_get(stack, 1);
    nếu (n < 1) { trả về -1; };
    biến value = vm_get(vm_get(stack, 3), n - 1);
    nếu (vm_tag(value) == 7 || vm_tag(value) == 1) { trả về vm_get(value, 1); };
    nếu (vm_tag(value) == 3) { trả về vm_find_function(aot_state(), value); };
    trả về -1;
};
hàm aot_callee_slot_id(frame, slot) {
    nếu (aot_status()) { trả về -1; };
    biến value = vm_load_slot(aot_state(), frame, slot);
    nếu (aot_status()) { trả về -1; };
    nếu (vm_tag(value) == 7 || vm_tag(value) == 1) { trả về vm_get(value, 1); };
    nếu (vm_tag(value) == 3) { trả về vm_find_function(aot_state(), value); };
    trả về -1;
};
hàm aot_fast_args(frame, count, mask, ascii, method) {
    nếu (aot_status()) { trả về 0; };
    biến stack = aot_stack(frame); biến n = vm_get(stack, 1);
    nếu (count < 0 || count > 4 || n < count + 1) { trả về 0; };
    biến data = vm_get(stack, 3); biến start = n - count - 1 + method;
    lặp(i = 0; i < count; i++) {
        nếu ((mask & (1 << i)) != 0) {
            biến value = vm_get(data, start + i);
            nếu (ascii) {
                nếu (vm_tag(value) != 3) { trả về 0; };
                nếu (vm_get(value, 1) != 1) { trả về 0; };
                nếu (máy đọc byte(vm_get(value, 2)) >= 128) { trả về 0; };
