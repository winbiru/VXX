    // Không có safepoint từ đây tới khi caller nhận giá trị trả về.
    máy xóa vùng nhớ(frame, 336);
    biến frame_count = vm_get(frames, 1);
    vm_set(vm_get(frames, 3), frame_count - 1, 0);
    vm_set(frames, 1, frame_count - 1);
    trả về result;
};
// Lời gọi trực tiếp dùng lại bốn ô đối số nằm trong khung của hàm gọi.
// Khi hàm con đang chạy, khung cha vẫn được giữ trên ngăn xếp khung GC.
hàm aot_take_args(frame, count) {
    nếu (count == 0 || count > 4 || count < 0) { trả về vm_take(aot_stack(frame), count); };
    biến stack = aot_stack(frame);
    biến n = vm_get(stack, 1);
    nếu (count > n) { vm_error(5); trả về 0; };
    biến args = frame + 96;
    biến data = vm_get(stack, 3);
    biến start = n - count;
    // Chuyển tham chiếu, không đóng hộp và không cấp phát danh sách mới.
    máy ghi số nguyên ba mươi hai bit(args, 4);
    máy ghi số nguyên ba mươi hai bit(args + 4, count);
    máy ghi số nguyên ba mươi hai bit(args + 8, 4);
    máy ghi số nguyên ba mươi hai bit(args + 12, args + 16);
    lặp(i = 0; i < count; i++) {
        máy ghi số nguyên ba mươi hai bit(args + 16 + i * 4, vm_get(data, start + i));
        vm_set(data, start + i, 0);
    };
    // Xóa ô từ lời gọi trước, tránh GC giữ tham chiếu không còn sống.
    lặp (i = count; i < 4; i++) { máy ghi số nguyên ba mươi hai bit(args + 16 + i * 4, 0); };
    vm_set(stack, 1, start);
    trả về args;
};
hàm aot_release_args(frame) {
    biến args = frame + 96;
    máy ghi số nguyên ba mươi hai bit(args + 4, 0);
    máy ghi số nguyên ba mươi hai bit(args + 8, 4);
    máy ghi số nguyên ba mươi hai bit(args + 16, 0);
    máy ghi số nguyên ba mươi hai bit(args + 20, 0);
    máy ghi số nguyên ba mươi hai bit(args + 24, 0);
    máy ghi số nguyên ba mươi hai bit(args + 28, 0);
    trả về 0;
};
// Hai đối số đơn giản được truyền trực tiếp bằng thanh ghi máy.
// Mặt nạ bit 0/1: đối số là ô biến; bit bằng 0: hằng i32.
// Đặt từng giá trị vào khung cha ngay khi đọc để GC luôn thấy tham chiếu.
hàm aot_call_small(frame, id, count, first, second, mask) {
