    nếu (base > 0) { parent = vm_map_get(classes, vm_pool(state, base - 1)); nếu (parent == 0) { vm_error(18); trả về 1; }; };
    biến klass = vm_alloc(16, 1); nếu (klass == 0) { trả về 1; };
    vm_set(klass, 0, 8); vm_set(klass, 1, key); vm_set(klass, 2, parent); vm_set(klass, 3, vm_vector(5));
    vm_map_put(classes, key, klass); trả về aot_status();
};
hàm aot_define_method(frame, owner, name, id) {
    biến visibility = 0;
    nếu (id < 0) { id = 0 - (id + 1); visibility = 1; }
    hoặc nếu (owner < 0) { owner = 0 - (owner + 1); visibility = 2; };
    biến klass = vm_map_get(vm_get(aot_state(), 5), vm_pool(aot_state(), owner));
    nếu (klass == 0) { vm_error(18); trả về 1; };
    biến method = vm_alloc(16, 1); nếu (method == 0) { trả về 1; };
    vm_set(method, 0, id); vm_set(method, 1, klass); vm_set(method, 2, visibility);
    vm_map_put(vm_get(klass, 3), vm_pool(aot_state(), name), method); trả về aot_status();
