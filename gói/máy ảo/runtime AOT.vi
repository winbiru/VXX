    biến functions = máy aot thông tin(1, 0, 0);
    lặp(i = 0; i < functions; i++) {
        biến fn = vm_alloc(16, 1); nếu (fn == 0) { trả về 1; };
        vm_set(fn, 0, máy aot thông tin(20, i, 0));
        vm_set(fn, 2, máy aot thông tin(21, i, 0)); vm_set(fn, 3, máy aot thông tin(22, i, 0));
        vm_append(vm_get(state, 1), fn);
    };
    // Chỉ đo khi được yêu cầu; không tính bước khởi tạo vào thống kê.
    biến profile_args = vm_vector(4);
    vm_append(profile_args, vm_literal("VPP_VM_PROFILE"));
    biến profile_value = vm_host(state, 177, profile_args);
    nếu (vm_tag(profile_value) == 3 && vm_equal(profile_value, vm_literal("1"))) {
        biến bộ đếm toán tử = vm_alloc(218 * 4, 0);
        nếu (bộ đếm toán tử == 0) { trả về 1; };
        biến bộ đếm hàm = vm_alloc(17 * 218 * 4, 0);
        nếu (bộ đếm hàm == 0) { trả về 1; };
        biến chẩn đoán helper = vm_alloc(8 * 4, 0);
        nếu (chẩn đoán helper == 0) { trả về 1; };
        vm_set(state, 17, bộ đếm toán tử);
        vm_set(state, 18, bộ đếm hàm);
        vm_set(state, 19, chẩn đoán helper);
        vm_set(4198464, 12, 1);
    };
    // Reject unavailable services before running any user initializer.
    nếu (máy aot thông tin(3, 0, 0) != 0 || máy aot thông tin(4, 0, 0) != 0) { vm_error(22); };
    lặp(i = 0; i < máy aot thông tin(2, 0, 0); i++) {
        nếu (aot_status()) { thoát; }; aot_region(1, i);
    };
    biến exit_code = 0;
    nếu (aot_status() == 0) { exit_code = aot_region(2, 0); };
    vm_socket_close_all(state); vm_process_close_all(state); vm_dir_close_all(state);
    vm_profile_report();
    nếu (aot_status()) {
        vm_write(2, vm_concat(vm_literal("V++ AOT runtime: error="), vm_integer_text(vm_get(4198464, 1))));
        vm_write(2, vm_concat(vm_literal(" opcode="), vm_integer_text(vm_get(4198464, 5))));
        vm_write(2, vm_literal("\n")); trả về 1;
    };
    trả về exit_code;
};
