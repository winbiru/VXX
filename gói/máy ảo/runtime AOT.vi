hàm aot_fast_arg(frame, count, index, ascii, method) {
    biến stack = aot_stack(frame);
    biến value = vm_get(vm_get(stack, 3), vm_get(stack, 1) - count - 1 + method + index);
    nếu (ascii) { trả về máy đọc byte(vm_get(value, 2)); };
    trả về vm_get(value, 1);
};
// Đọc trực tiếp đối số một ký tự ASCII từ source[index] mà không tạo
// giá trị chuỗi trung gian. 0..127 là byte hợp lệ, 128 yêu cầu chạy lại
// đường động, 129 là lỗi đã được ghi vào trạng thái VM.
hàm aot_ascii_index_arg(frame, source_slot, index_slot) {
    biến state = aot_state();
    biến source = vm_load_slot(state, frame, source_slot);
    nếu (aot_status()) { trả về 129; };
    biến cell = vm_cell(state, frame, index_slot, 0);
    nếu (aot_status()) { trả về 129; };
    nếu (vm_tag(source) != 3 || !aot_o_i32(cell)) { trả về 128; };
    biến at = vm_char_offset(source, aot_doc_i32(cell));
    nếu (aot_status()) { trả về 129; };
    biến width = vm_utf8_width(source, at);
    nếu (width > vm_get(source, 1) - at) { vm_error(3); trả về 129; };
    nếu (width != 1) { trả về 128; };
    biến byte = máy đọc byte(vm_get(source, 2) + at);
    nếu (byte >= 128) { trả về 128; };
    trả về byte;
};
// Receiver đã được đánh giá và nằm trên đỉnh stack. Dùng biến thể này cho
// peephole source[index] -> method(ascii) để không cần dựng đối số chuỗi.
hàm aot_probe_method(frame, instance, name, super_call) {
    nếu (vm_tag(instance) != 9) { trả về 0; };
    biến klass = vm_get(instance, 1); biến owner = vm_get(frame, 6);
    nếu (super_call) {
        nếu (owner == 0) { trả về 0; };
        klass = vm_get(owner, 2); nếu (klass == 0) { trả về 0; };
    };
    biến key = vm_pool(aot_state(), name);
    nếu (aot_status()) { trả về 0; };
    biến method = vm_resolve(klass, key);
    nếu (method == 0) { trả về 0; };
    biến allowed = vm_access(method, owner);
    nếu (allowed == 0 && owner != 0 && vm_get(method, 2) == 2) {
        nếu (vm_subclass(vm_get(instance, 1), owner) == 1 && vm_subclass(vm_get(method, 1), owner) == 1) {
            biến declaration = vm_resolve(owner, key);
            nếu (declaration != 0) { allowed = vm_access(declaration, owner); };
        };
    };
    nếu (allowed == 0) { trả về 0; };
    trả về method;
};
hàm aot_method_top_id(frame, name, super_call) {
    biến stack = aot_stack(frame); biến n = vm_get(stack, 1);
    nếu (n < 1) { trả về -1; };
    biến instance = vm_get(vm_get(stack, 3), n - 1);
    biến method = aot_probe_method(frame, instance, name, super_call);
    nếu (method == 0 || aot_status()) { trả về -1; };
    trả về vm_get(method, 0);
