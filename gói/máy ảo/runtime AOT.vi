        nếu (mask >= 2) {
            raw = raw + aot_arg_slot(frame, second, args + 20) * 2;
        } hoặc {
            máy ghi số nguyên ba mươi hai bit(args + 20, second); raw = raw + 2;
        };
    };
    nếu (aot_status()) { aot_release_args(frame); trả về 1; };
    nếu (raw != 0) { máy ghi số nguyên ba mươi hai bit(args + 8, 0 - raw - 1); };
    biến result = aot_invoke(id, args, 0, 0, 0);
    aot_release_args(frame);
    trả về aot_push(frame, result);
