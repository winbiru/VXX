        // vm_host chỉ đọc các tham số trong thời gian gọi, không giữ danh sách.
        biến host_args = aot_take_args(frame, count);
        nếu (aot_status()) { trả về 1; };
        nếu (op < 0) {
            nếu (count >= 1 && count <= 4) { aot_release_args(frame); };
            vm_error(13); trả về 1;
        };
        result = vm_host(state, op, host_args);
        nếu (count >= 1 && count <= 4) { aot_release_args(frame); };
    };
    trả về aot_push(frame, result);
};
// Lời gọi phương thức riêng tư đã được AOT chứng minh đích chính xác.
// Receiver và tối đa hai đối số đơn giản được đọc trực tiếp, bỏ tra tên
// phương thức và các lần chuyển ABI load riêng lẻ.
hàm aot_method_direct_small(frame, target, receiver_slot, count, first, second, kinds) {
    nếu (count < 0 || count > 2) { vm_error(5); trả về 1; };
    biến state = aot_state();
    biến instance = vm_load_slot(state, frame, receiver_slot);
    nếu (aot_status()) { trả về 1; };
    nếu (vm_tag(instance) != 9) { vm_error(18); trả về 1; };
    biến owner = vm_get(frame, 6);
    nếu (owner == 0) { vm_error(19); trả về 1; };
    nếu (vm_subclass(vm_get(instance, 1), owner) == 0) { vm_error(19); trả về 1; };
    lặp(i = 0; i < count; i++) {
        biến raw = first; nếu (i == 1) { raw = second; };
        biến kind = (kinds >> (i * 2)) & 3;
        biến value = 0;
        nếu (kind == 0) { value = vm_int(raw); }
        hoặc nếu (kind == 1) { value = vm_load_slot(state, frame, raw); }
        hoặc nếu (kind == 2) { value = vm_pool(state, raw); }
        hoặc { vm_error(2); trả về 1; };
        nếu (aot_status()) { trả về 1; };
        nếu (aot_push(frame, value)) { trả về 1; };
    };
    biến args = aot_take_args(frame, count);
    nếu (aot_status()) { trả về 1; };
    biến result = aot_invoke(target, args, instance, owner, 0);
    nếu (count >= 1 && count <= 2) { aot_release_args(frame); };
    nếu (aot_status()) { trả về 1; };
    trả về aot_push(frame, result);
};
hàm aot_indirect(frame, count) {
    biến stack = aot_stack(frame); biến callee = vm_pop(stack); biến args = aot_take_args(frame, count); biến id = -1;
    nếu (aot_status()) { trả về 1; };
    biến result = 0;
    nếu (vm_tag(callee) == 7) {
        result = aot_invoke(vm_get(callee, 1), args, 0, 0, callee);
        nếu (count >= 1 && count <= 4) { aot_release_args(frame); };
        trả về aot_push(frame, result);
    };
    nếu (vm_tag(callee) == 3) { id = vm_find_function(aot_state(), callee); }
