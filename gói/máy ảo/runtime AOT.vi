};
hàm aot_set_index(frame) {
    biến stack = aot_stack(frame); biến value = vm_pop(stack); biến key = vm_pop(stack); biến container = vm_pop(stack);
    nếu (vm_tag(container) == 5) { vm_map_put(container, vm_text(key), value); }
    hoặc nếu (vm_tag(container) == 4 && vm_tag(key) == 1) { vm_put(container, vm_number(key), value); }
    hoặc { vm_error(2); }; trả về aot_status();
};
hàm aot_invoke(id, args, receiver, owner, closure) {
