// ABI giá trị động cho AOT. Hàm và nhánh chạy bằng mã máy đã sinh.
// Dùng chung biểu diễn giá trị, bộ thu gom và ô biến của máy ảo V++.
nhập bộ nhớ.*;
nhập giá trị.*;
nhập máy hệ thống.*;
nhập thư mục máy.*;
nhập tiến trình máy.*;
nhập ổ cắm máy.*;
nhập phân giải máy.*;
nhập host ABI.*;
nhập nạp chương trình.*;
nhập runtime.*;

hàm aot_state() { trả về vm_get(4198464, 2); };
hàm aot_status() { trả về vm_get(4198464, 1) != 0; };
hàm aot_stack(frame) { trả về vm_get(frame, 2); };
hàm aot_push(frame, value) { vm_append(aot_stack(frame), value); trả về aot_status(); };
hàm aot_integer(frame, value) { trả về aot_push(frame, vm_int(value)); };
hàm aot_string(frame, index) { trả về aot_push(frame, vm_pool(aot_state(), index)); };
hàm aot_floating(frame, index) { trả về aot_push(frame, vm_scalar(100, vm_pool(aot_state(), index))); };
hàm aot_null(frame) { trả về aot_push(frame, 0); };
hàm aot_load(frame, slot) { trả về aot_push(frame, vm_load_slot(aot_state(), frame, slot)); };
// Đọc thẳng ô cục bộ khi compiler đã chứng minh vị trí binding đầu hàm.
// Guard khóa giữ đúng ngữ nghĩa nếu ô đã bị shadow/capture hoặc frame đổi loại.
hàm aot_load_inline(frame, slot, key_field, cell_offset) {
    nếu (vm_get(frame, 9) == 0 && vm_get(frame, key_field) == slot + 1) {
        biến cell = frame + cell_offset;
        biến value = vm_get(cell, 1);
        nếu (vm_get(cell, 0) == 12) { value = vm_int(value); };
        trả về aot_push(frame, value);
    };
    trả về aot_load(frame, slot);
};
// Đọc ô biến đúng một lần rồi ghi thẳng vào bộ đệm tham số.
// Trả về 1 khi chuyển được i32 thô, 0 khi giữ tham chiếu động.
hàm aot_arg_slot(frame, slot, place) {
    biến cell = vm_cell(aot_state(), frame, slot, 0);
    nếu (cell == 0) {
        máy ghi số nguyên ba mươi hai bit(place, vm_load_slot(aot_state(), frame, slot));
        trả về 0;
    };
    biến value = vm_get(cell, 1);
    nếu (vm_get(cell, 0) == 12) {
        máy ghi số nguyên ba mươi hai bit(place, value);
        trả về 1;
    };
    nếu (vm_tag(value) == 1) {
        máy ghi số nguyên ba mươi hai bit(place, vm_get(value, 1));
        trả về 1;
    };
    máy ghi số nguyên ba mươi hai bit(place, value);
    trả về 0;
};
// Giữ các điểm vào ABI cũ cho mã máy đã biên dịch từ trước.
// Đường gọi mới dùng aot_arg_slot để tránh tra ô biến hai lần.
hàm aot_is_i32(frame, slot) {
    trả về aot_o_i32(vm_cell(aot_state(), frame, slot, 0));
};
hàm aot_read_i32(frame, slot) {
    trả về aot_doc_i32(vm_cell(aot_state(), frame, slot, 0));
};
// Chỉ dùng sau khi đã xác định ô tồn tại. Kiểu 12 giữ i32 thô;
// kiểu 10 giữ tham chiếu đến giá trị động đã đóng hộp.
hàm aot_o_i32(cell) {
    nếu (cell == 0) { trả về 0; };
    nếu (vm_get(cell, 0) == 12) { trả về 1; };
    trả về vm_tag(vm_get(cell, 1)) == 1;
};
hàm aot_doc_i32(cell) {
    nếu (vm_get(cell, 0) == 12) { trả về vm_get(cell, 1); };
    trả về vm_get(vm_get(cell, 1), 1);
};
// Ô nằm trong khung không thoát ra ngoài: giữ kết quả trong i32 thô.
// Ô trên heap vẫn phải chứa tham chiếu để closure và GC đọc đúng kiểu.
hàm aot_ghi_i32(frame, cell, number) {
    nếu (cell == frame + 144 || cell == frame + 152 || cell == frame + 164 || cell == frame + 180 ||
        cell == frame + 192 || cell == frame + 204 || cell == frame + 216 || cell == frame + 228 ||
        cell == frame + 244 || cell == frame + 256 || cell == frame + 268 || cell == frame + 280 ||
        cell == frame + 292 || cell == frame + 304 || cell == frame + 316 || cell == frame + 328) {
        vm_set(cell, 0, 12);
        vm_set(cell, 1, number);
        trả về 0;
    };
    vm_set(cell, 1, vm_int(number));
    trả về aot_status();
};
hàm aot_initialize(frame, slot) {
    biến state = aot_state(); biến scope = vm_get(frame, 3);
    // Biến cục bộ thông thường dùng ô có sẵn trong khung. Nếu tám ô đã
    // được dùng hoặc slot khai báo lại, vm_bind_aot tự chuyển sang heap.
    // Khung toàn cục và khung constructor giữ đường khởi tạo hiện tại.
    nếu (vm_get(frame, 9) == 0 && scope == 0) {
        vm_bind_i32(frame, slot, 0);
        trả về aot_status();
    };
    nếu (vm_get(frame, 9) == 1) { scope = vm_get(state, 4); };
    nếu (vm_get(frame, 9) != 1 || vm_map_find_int(scope, slot) < 0) {
        nếu (scope == 0) { scope = vm_vector(5); vm_set(frame, 3, scope); };
        biến cell = vm_alloc(16, 1);
        nếu (cell == 0) { trả về 1; };
        vm_set(cell, 0, 10); vm_set(cell, 1, vm_int(0));
        vm_map_put(scope, vm_int(slot), cell);
        vm_drop_inline(frame, slot);
        nếu (vm_get(frame, 9) != 1) { vm_slot_cache_put(frame, slot, cell); };
    };
    trả về aot_status();
};
hàm aot_assign_slot(frame, slot) {
    vm_store(aot_state(), frame, slot, vm_pop(aot_stack(frame))); trả về aot_status();
};
// Sao chép i32 giữa hai ô bằng thanh ghi. Ô bị closure bắt giữ vẫn dùng
// giá trị đóng hộp; phép gán danh sách/đối tượng giữ nguyên tham chiếu.
hàm aot_copy_slot(frame, source, target) {
    biến state = aot_state();
    biến cell = vm_cell(state, frame, source, 0);
    nếu (aot_o_i32(cell)) {
        biến number = aot_doc_i32(cell);
        biến dest = vm_cell(state, frame, target, 1);
        nếu (aot_status()) { trả về 1; };
        trả về aot_ghi_i32(frame, dest, number);
    };
    biến value = vm_load_slot(state, frame, source);
    nếu (aot_status()) { trả về 1; };
    vm_store(state, frame, target, value);
    trả về aot_status();
};
// Cập nhật số bằng phần tử danh sách: giữ toán hạng i32 trong thanh ghi.
// Đường động giữ thứ tự đọc tổng, bộ chứa, chỉ số rồi mới thực hiện phép toán.
hàm aot_index_update(frame, target, source, index, op) {
    biến state = aot_state();
    biến cell = vm_cell(state, frame, target, 0);
    biến raw = aot_o_i32(cell); biến number = 0; biến left = 0;
    nếu (raw) { number = aot_doc_i32(cell); }
    hoặc { left = vm_load_slot(state, frame, target); };
    nếu (aot_status()) { trả về 1; };
    biến container = vm_load_slot(state, frame, source);
    nếu (aot_status()) { trả về 1; };
    biến key_cell = vm_cell(state, frame, index, 0);
    biến right = 0; biến kind = vm_tag(container);
    nếu ((kind == 4 || kind == 6) && aot_o_i32(key_cell)) {
        biến at = aot_doc_i32(key_cell);
        nếu (at < 0 || at >= vm_get(container, 1)) { vm_error(4); trả về 1; };
        right = vm_get(vm_get(container, 3), at);
    } hoặc {
        biến key = vm_load_slot(state, frame, index);
        nếu (aot_status()) { trả về 1; };
        right = vm_index(container, key);
        nếu (aot_status()) { trả về 1; };
    };
    nếu (raw && vm_tag(right) == 1 && op >= 0 && op <= 2) {
        biến value = vm_get(right, 1);
        nếu (op == 0) { number = number + value; }
        hoặc nếu (op == 1) { number = number - value; }
        hoặc { number = number * value; };
        trả về aot_ghi_i32(frame, cell, number);
    };
    nếu (raw) { left = vm_int(number); };
    biến result = vm_binary(op, left, right);
    nếu (aot_status()) { trả về 1; };
    vm_store(state, frame, target, result);
    trả về aot_status();
};
hàm aot_store_integer(frame, slot, value) {
    nếu (vm_get(frame, 9) == 0) {
        nếu (vm_get(frame, 15) == slot + 1) {
            vm_set(frame, 36, 12); vm_set(frame, 37, value); trả về 0;
        };
        nếu (vm_get(frame, 43) == slot + 1) {
            vm_set(frame, 38, 12); vm_set(frame, 39, value); trả về 0;
        };
        nếu (vm_get(frame, 40) == slot + 1) {
            vm_set(frame, 41, 12); vm_set(frame, 42, value); trả về 0;
        };
        nếu (vm_get(frame, 44) == slot + 1) {
            vm_set(frame, 45, 12); vm_set(frame, 46, value); trả về 0;
        };
        nếu (vm_get(frame, 47) == slot + 1) {
            vm_set(frame, 48, 12); vm_set(frame, 49, value); trả về 0;
        };
        nếu (vm_get(frame, 50) == slot + 1) {
            vm_set(frame, 51, 12); vm_set(frame, 52, value); trả về 0;
        };
        nếu (vm_get(frame, 53) == slot + 1) {
            vm_set(frame, 54, 12); vm_set(frame, 55, value); trả về 0;
        };
        nếu (vm_get(frame, 56) == slot + 1) {
            vm_set(frame, 57, 12); vm_set(frame, 58, value); trả về 0;
        };
        nếu (vm_get(frame, 60) == slot + 1) {
            vm_set(frame, 61, 12); vm_set(frame, 62, value); trả về 0;
        };
        nếu (vm_get(frame, 63) == slot + 1) {
            vm_set(frame, 64, 12); vm_set(frame, 65, value); trả về 0;
        };
        nếu (vm_get(frame, 66) == slot + 1) {
            vm_set(frame, 67, 12); vm_set(frame, 68, value); trả về 0;
        };
        nếu (vm_get(frame, 69) == slot + 1) {
            vm_set(frame, 70, 12); vm_set(frame, 71, value); trả về 0;
        };
        nếu (vm_get(frame, 72) == slot + 1) {
            vm_set(frame, 73, 12); vm_set(frame, 74, value); trả về 0;
        };
        nếu (vm_get(frame, 75) == slot + 1) {
            vm_set(frame, 76, 12); vm_set(frame, 77, value); trả về 0;
        };
        nếu (vm_get(frame, 78) == slot + 1) {
            vm_set(frame, 79, 12); vm_set(frame, 80, value); trả về 0;
        };
        nếu (vm_get(frame, 81) == slot + 1) {
            vm_set(frame, 82, 12); vm_set(frame, 83, value); trả về 0;
        };
    };
    vm_store(aot_state(), frame, slot, vm_int(value)); trả về aot_status();
};
hàm aot_assign(frame) {
    biến stack = aot_stack(frame); biến id = vm_pop(stack); biến value = vm_pop(stack);
    nếu (vm_tag(id) == 3 && vm_tag(value) == 1) { biến swap = id; id = value; value = swap; };
    nếu (vm_tag(id) != 1) { vm_error(2); trả về 1; };
    vm_store(aot_state(), frame, vm_number(id), value); trả về aot_status();
};
hàm aot_parameter(frame, slot, arg, default_index) {
    biến value = 0; biến args = vm_get(frame, 4);
    nếu (arg == -1) { value = vm_get(frame, 5); nếu (value == 0) { vm_error(18); }; }
    // Chỉ số đã được kiểm tra ở đây; đọc trực tiếp vùng đối số.
    hoặc nếu (arg >= 0 && arg < vm_get(args, 1)) {
        // Dấu âm của dung lượng đánh dấu đối số i32 thô. Chỉ lời gọi
        // trực tiếp dùng ABI này; mọi đường động vẫn truyền tham chiếu.
        biến cap = vm_get(args, 2);
        biến raw = 0 - cap - 1;
        // Một phép AND kiểm tra đúng bit của tham số, không chia dư
        // nhiều lần trong mỗi lần vào hàm có đối số i32.
        nếu (cap < 0 && arg < 4 && (raw & (1 << arg)) != 0) {
            vm_bind_i32(frame, slot, vm_get(vm_get(args, 3), arg));
            trả về aot_status();
        };
        value = vm_get(vm_get(args, 3), arg);
    }
    hoặc nếu (default_index >= 0) {
        biến encoded = vm_pool(aot_state(), default_index);
        nếu (vm_get(encoded, 1) < 2) { vm_error(10); trả về 1; };
        value = vm_scalar(máy đọc byte(vm_get(encoded, 2)), vm_slice(encoded, 2, vm_get(encoded, 1) - 2));
    } hoặc { vm_error(14); };
    nếu (aot_status() == 0) { vm_bind_aot(frame, slot, value); };
    trả về aot_status();
};
hàm aot_increment_slot(frame, slot, delta) {
    biến cell = vm_cell(aot_state(), frame, slot, 0);
    nếu (cell != 0 && vm_get(cell, 0) == 12) {
        biến number = vm_get(cell, 1) + delta;
        vm_set(cell, 1, number);
        trả về aot_push(frame, vm_int(number));
    };
    nếu (cell != 0 && vm_tag(vm_get(cell, 1)) == 1) {
        biến boxed_number = vm_int(vm_get(vm_get(cell, 1), 1) + delta);
        vm_set(cell, 1, boxed_number);
        trả về aot_push(frame, boxed_number);
    };
    biến value = vm_int(vm_number(vm_load_slot(aot_state(), frame, slot)) + delta);
    vm_store(aot_state(), frame, slot, value); trả về aot_push(frame, value);
};
hàm aot_increment(frame, delta) {
    biến id = vm_pop(aot_stack(frame));
    nếu (vm_tag(id) != 1) { vm_error(2); trả về 1; };
    trả về aot_increment_slot(frame, vm_number(id), delta);
};
// Compiler chỉ dùng khi đã chứng minh kết quả ++/-- không còn được đọc.
// Giữ nguyên conversion của increment_slot cho kiểu động và lỗi.
hàm aot_increment_slot_discard(frame, slot, delta) {
    biến cell = vm_cell(aot_state(), frame, slot, 0);
    nếu (cell != 0 && vm_get(cell, 0) == 12) {
        vm_set(cell, 1, vm_get(cell, 1) + delta);
        trả về aot_status();
    };
    nếu (aot_increment_slot(frame, slot, delta)) { trả về 1; };
    vm_pop(aot_stack(frame));
    trả về aot_status();
};
hàm aot_binary(frame, op) {
    // Phép cộng động có thể nối chuỗi lớn. Thu gom trước khi lấy
    // toán hạng khỏi stack, lúc toàn bộ giá trị vẫn có gốc GC.
    nếu (op == 0) { nếu (aot_safepoint(frame)) { trả về 1; }; };
    biến stack = aot_stack(frame); biến right = vm_pop(stack); biến left = vm_pop(stack);
    trả về aot_push(frame, vm_binary(op, left, right));
};
hàm aot_negate(frame) { trả về aot_push(frame, vm_int(vm_truth(vm_pop(aot_stack(frame))) == 0)); };
hàm aot_update_integer_slot(frame, source, immediate, op, target) {
    // Cộng/trừ/nhân i32 ngay trên ô biến, không dựng toán hạng tạm.
    nếu (op >= 0 && op <= 2) {
        biến state = aot_state();
        biến source_cell = vm_cell(state, frame, source, 0);
        nếu (aot_o_i32(source_cell)) {
            biến target_cell = source_cell;
            nếu (source != target) { target_cell = vm_cell(state, frame, target, 0); };
            nếu (target_cell != 0) {
                biến a = aot_doc_i32(source_cell);
                biến value = a + immediate;
                nếu (op == 1) { value = a - immediate; };
                nếu (op == 2) { value = a * immediate; };
                trả về aot_ghi_i32(frame, target_cell, value);
            };
            biến chẩn đoán = vm_get(state, 19);
            nếu (chẩn đoán != 0) { vm_set(chẩn đoán, 2, vm_get(chẩn đoán, 2) + 1); };
        } hoặc {
            biến chẩn đoán = vm_get(state, 19);
            nếu (chẩn đoán != 0) { vm_set(chẩn đoán, 1, vm_get(chẩn đoán, 1) + 1); };
        };
    };
    biến chẩn đoán = vm_get(aot_state(), 19);
    nếu (chẩn đoán != 0) { vm_set(chẩn đoán, 0, vm_get(chẩn đoán, 0) + 1); };
    nếu (op == 0) { nếu (aot_safepoint(frame)) { trả về 1; }; };
    biến result = vm_binary(op, vm_load_slot(aot_state(), frame, source), vm_int(immediate));
    vm_store(aot_state(), frame, target, result); trả về aot_status();
};
hàm aot_update_numeric_slots(frame, left, right, op, target) {
    nếu (op >= 0 && op <= 2) {
        biến state = aot_state();
        biến left_cell = vm_cell(state, frame, left, 0);
        biến right_cell = vm_cell(state, frame, right, 0);
        nếu (aot_o_i32(left_cell) && aot_o_i32(right_cell)) {
            biến target_cell = vm_cell(state, frame, target, 0);
            nếu (target_cell != 0) {
                biến a = aot_doc_i32(left_cell);
                biến b = aot_doc_i32(right_cell);
                biến value = a + b;
                nếu (op == 1) { value = a - b; };
                nếu (op == 2) { value = a * b; };
                trả về aot_ghi_i32(frame, target_cell, value);
            };
        };
    };
    nếu (op == 0) { nếu (aot_safepoint(frame)) { trả về 1; }; };
    biến result = vm_binary(op, vm_load_slot(aot_state(), frame, left), vm_load_slot(aot_state(), frame, right));
    vm_store(aot_state(), frame, target, result); trả về aot_status();
};
hàm aot_compare_i32(a, b, op) {
    nếu (op == 7) { trả về a == b; };
    nếu (op == 8) { trả về a != b; };
    nếu (op == 9) { trả về a > b; };
    nếu (op == 10) { trả về a < b; };
    nếu (op == 11) { trả về a >= b; };
    trả về a <= b;
};
// So sánh tên kiểu chuẩn với tag thật; giữ cách nạp ô chưa tồn tại.
hàm aot_compare_type_slot(frame, slot, kind, op) {
    nếu (aot_status()) { trả về 2; };
    biến state = aot_state();
    biến cell = vm_cell(state, frame, slot, 0);
    biến tag = 1;
    nếu (cell == 0) {
        tag = vm_tag(vm_load_slot(state, frame, slot));
    } hoặc nếu (vm_get(cell, 0) != 12) {
        tag = vm_tag(vm_get(cell, 1));
    };
    nếu (aot_status()) { trả về 2; };
    vm_set(4198464, 13, 145);
    nếu (tag == 11) { tag = 1; };
    nếu (tag == 13) { tag = 6; };
    nếu (tag < 0 || tag > 8) { tag = 9; };
    nếu (op == 8) { trả về tag != kind; };
    trả về tag == kind;
};
// Lời gọi tĩnh đã được chứng minh chỉ chuyển tiếp TYPE_OF. Giữ giới hạn
// khung của vm_invoke_body, kể cả việc đọc/tạo ô nguồn trước khi báo lỗi.
hàm aot_compare_type_forward_slot(frame, slot, kind, op) {
    nếu (aot_status()) { trả về 2; };
    biến state = aot_state();
    nếu (vm_get(vm_get(state, 6), 1) >= 4096) {
        vm_load_slot(state, frame, slot);
        nếu (!aot_status()) { vm_error(15); };
        trả về 2;
    };
    trả về aot_compare_type_slot(frame, slot, kind, op);
};
hàm aot_compare_integer_slot(frame, slot, immediate, op) {
    nếu (op >= 7 && op <= 12) {
        biến cell = vm_cell(aot_state(), frame, slot, 0);
        nếu (aot_o_i32(cell)) {
            trả về aot_compare_i32(aot_doc_i32(cell), immediate, op);
        };
    };
    biến result = vm_binary(op, vm_load_slot(aot_state(), frame, slot), vm_int(immediate));
    nếu (aot_status()) { trả về 2; }; trả về vm_truth(result);
};
hàm aot_compare_integer_range(frame, slot, low, high) {
    biến cell = vm_cell(aot_state(), frame, slot, 0);
    nếu (aot_o_i32(cell)) {
        biến value = aot_doc_i32(cell);
        trả về value >= low && value <= high;
    };
    // && của V++ đánh giá cả hai vế. Giữ đúng thứ tự bytecode ở đường động.
    biến value = vm_load_slot(aot_state(), frame, slot);
    biến lower = vm_binary(11, value, vm_int(low));
    biến upper = vm_binary(12, value, vm_int(high));
    biến result = vm_binary(4, lower, upper);
    nếu (aot_status()) { trả về 2; }; trả về vm_truth(result);
};
hàm aot_compare_integer_outside_range(frame, slot, low, high) {
    biến cell = vm_cell(aot_state(), frame, slot, 0);
    nếu (aot_o_i32(cell)) {
        biến value = aot_doc_i32(cell);
        trả về value < low || value > high;
    };
    // || của V++ đánh giá cả hai vế, nên đường động cũng phải thực hiện đủ hai phép so sánh.
    biến value = vm_load_slot(aot_state(), frame, slot);
    biến lower = vm_binary(10, value, vm_int(low));
    biến upper = vm_binary(9, value, vm_int(high));
    biến result = vm_binary(5, lower, upper);
    nếu (aot_status()) { trả về 2; }; trả về vm_truth(result);
};
hàm aot_compare_integer_or_range(frame, slot, first_value, low, high) {
    biến state = aot_state();
    biến cell = vm_cell(state, frame, slot, 0);
    nếu (aot_o_i32(cell)) {
        biến value = aot_doc_i32(cell);
        biến first = value == first_value;
        biến lower = value >= low;
        biến upper = value <= high;
        trả về first || (lower && upper);
    };
    // Đường động cũng thực hiện đủ ba phép so sánh trước && và ||.
    biến value = vm_load_slot(state, frame, slot);
    biến first = vm_binary(7, value, vm_int(first_value));
    biến lower = vm_binary(11, value, vm_int(low));
    biến upper = vm_binary(12, value, vm_int(high));
    biến inside = vm_binary(4, lower, upper);
    biến result = vm_binary(5, first, inside);
    nếu (aot_status()) { trả về 2; }; trả về vm_truth(result);
};
hàm aot_compare_integer_set(frame, slot, count, a, b, c, d) {
    biến cell = vm_cell(aot_state(), frame, slot, 0);
    nếu (aot_o_i32(cell)) {
        biến value = aot_doc_i32(cell);
        nếu (count == 2) { trả về value == a || value == b; };
        nếu (count == 3) { trả về value == a || value == b || value == c; };
        trả về value == a || value == b || value == c || value == d;
    };
    biến state = aot_state();
    biến value = vm_load_slot(state, frame, slot);
    biến result = vm_binary(7, value, vm_int(a));
    biến next = vm_binary(7, value, vm_int(b));
    result = vm_binary(5, result, next);
    nếu (count >= 3) {
        next = vm_binary(7, value, vm_int(c));
        result = vm_binary(5, result, next);
    };
    nếu (count >= 4) {
        next = vm_binary(7, value, vm_int(d));
        result = vm_binary(5, result, next);
    };
    nếu (aot_status()) { trả về 2; }; trả về vm_truth(result);
};
hàm aot_compare_integer_or_and(frame, slot, immediate, first_op, left, right, tail_op) {
    nếu (first_op >= 7 && first_op <= 12 && tail_op >= 7 && tail_op <= 12) {
        biến state = aot_state();
        biến slot_cell = vm_cell(state, frame, slot, 0);
        biến left_cell = vm_cell(state, frame, left, 0);
        biến right_cell = vm_cell(state, frame, right, 0);
        nếu (aot_o_i32(slot_cell) && aot_o_i32(left_cell) && aot_o_i32(right_cell)) {
            biến value = aot_doc_i32(slot_cell);
            biến first = aot_compare_i32(value, immediate, first_op);
            biến equal = value == immediate;
            biến tail = aot_compare_i32(aot_doc_i32(left_cell), aot_doc_i32(right_cell), tail_op);
            trả về first || (equal && tail);
        };
    };
    // V++ đánh giá eager: luôn thực hiện đủ ba phép so sánh rồi mới && và ||.
    biến state = aot_state();
    biến value = vm_load_slot(state, frame, slot);
    biến first = vm_binary(first_op, value, vm_int(immediate));
    biến equal = vm_binary(7, value, vm_int(immediate));
    biến tail = vm_binary(tail_op, vm_load_slot(state, frame, left), vm_load_slot(state, frame, right));
    biến both = vm_binary(4, equal, tail);
    biến result = vm_binary(5, first, both);
    nếu (aot_status()) { trả về 2; }; trả về vm_truth(result);
};
hàm aot_compare_numeric_slots(frame, left, right, op) {
    nếu (op >= 7 && op <= 12) {
        biến state = aot_state();
        biến left_cell = vm_cell(state, frame, left, 0);
        biến right_cell = vm_cell(state, frame, right, 0);
        nếu (aot_o_i32(left_cell) && aot_o_i32(right_cell)) {
            trả về aot_compare_i32(aot_doc_i32(left_cell),
                                   aot_doc_i32(right_cell), op);
        };
    };
    biến result = vm_binary(op, vm_load_slot(aot_state(), frame, left), vm_load_slot(aot_state(), frame, right));
    nếu (aot_status()) { trả về 2; }; trả về vm_truth(result);
};
hàm aot_compare_numeric_slots_and(frame, left, right, op, guard) {
    nếu (op >= 7 && op <= 12) {
        biến state = aot_state();
        biến left_cell = vm_cell(state, frame, left, 0);
        biến right_cell = vm_cell(state, frame, right, 0);
        biến guard_cell = vm_cell(state, frame, guard, 0);
        nếu (aot_o_i32(left_cell) && aot_o_i32(right_cell) && aot_o_i32(guard_cell)) {
            biến comparison = aot_compare_i32(aot_doc_i32(left_cell), aot_doc_i32(right_cell), op);
            trả về comparison && aot_doc_i32(guard_cell) != 0;
        };
        biến chẩn đoán = vm_get(state, 19);
        nếu (chẩn đoán != 0) {
            nếu (aot_o_i32(left_cell) == 0) { vm_set(chẩn đoán, 4, vm_get(chẩn đoán, 4) + 1); };
            nếu (aot_o_i32(right_cell) == 0) { vm_set(chẩn đoán, 5, vm_get(chẩn đoán, 5) + 1); };
            nếu (aot_o_i32(guard_cell) == 0) { vm_set(chẩn đoán, 6, vm_get(chẩn đoán, 6) + 1); };
        };
    };
    biến chẩn đoán = vm_get(aot_state(), 19);
    nếu (chẩn đoán != 0) { vm_set(chẩn đoán, 3, vm_get(chẩn đoán, 3) + 1); };
    biến state = aot_state();
    biến comparison = vm_binary(op, vm_load_slot(state, frame, left), vm_load_slot(state, frame, right));
    biến result = vm_binary(4, comparison, vm_load_slot(state, frame, guard));
    nếu (aot_status()) { trả về 2; }; trả về vm_truth(result);
};
hàm aot_not_slot_and(frame, left, right) {
    biến state = aot_state();
    biến left_cell = vm_cell(state, frame, left, 0);
    biến right_cell = vm_cell(state, frame, right, 0);
    nếu (aot_o_i32(left_cell) && aot_o_i32(right_cell)) {
        biến left_false = aot_doc_i32(left_cell) == 0;
        biến right_true = aot_doc_i32(right_cell) != 0;
        trả về left_false && right_true;
    };
    // Giữ thứ tự eager: tính truthiness vế trái rồi mới đọc vế phải.
    biến left_value = vm_load_slot(state, frame, left);
    nếu (aot_status()) { trả về 2; };
    biến left_false = vm_truth(left_value) == 0;
    nếu (aot_status()) { trả về 2; };
    biến right_value = vm_load_slot(state, frame, right);
    nếu (aot_status()) { trả về 2; };
    biến right_true = vm_truth(right_value) != 0;
    nếu (aot_status()) { trả về 2; };
    trả về left_false && right_true;
};
// Quy ước: 0 = đã chạy; 1 = dùng đường dự phòng; 2 = có lỗi.
// Chỉ kiểm tra kiểu và ô biến trước khi thay đổi trạng thái. Mỗi đợt ghi
// lại kết quả, giữ các giá trị do i++ đẩy lên ngăn xếp, rồi kiểm tra GC.
hàm aot_loop_counters(frame, cell, first, count, keep) {
    // Nhánh tối ưu chỉ dùng khi phân tích bytecode chứng minh kết quả i++
    // không được đọc trước khi hàm trả về một biểu thức tường minh.
    // Giữ nguyên giá trị ô đếm và điểm an toàn cho bộ thu gom.
    nếu (keep == 0) {
        nếu (aot_ghi_i32(frame, cell, first + count)) { trả về 2; };
        nếu (aot_safepoint(frame)) { trả về 2; };
        trả về 0;
    };
    biến stack = aot_stack(frame);
    // Cấp đủ chỗ cho cả đợt, tránh kiểm tra và gọi vm_append cho từng i++.
    // Duy trì giới hạn và cách tăng dung lượng của danh sách VM.
    biến old_count = vm_get(stack, 1);
    biến required = old_count + count;
    biến capacity = vm_get(stack, 2);
    nếu (required < old_count || required > 2000000) { vm_capacity_error(4, required, 2000000); trả về 2; };
    nếu (required > capacity) {
        khi (capacity < required) {
            capacity = capacity * 2 + 8;
            nếu (capacity > 2000000) { vm_capacity_error(4, capacity, 2000000); trả về 2; };
        };
        biến resized_data = vm_alloc(capacity * 4, 1);
        nếu (resized_data == 0) { trả về 2; };
        biến previous = vm_get(stack, 3);
        lặp(i = 0; i < old_count; i++) { vm_set(resized_data, i, vm_get(previous, i)); };
        // Giải phóng cả bốn ô nội tuyến cũ để GC không giữ tham chiếu thừa.
        nếu (previous == stack + 16) {
            vm_set(previous, 0, 0);
            vm_set(previous, 1, 0);
            vm_set(previous, 2, 0);
            vm_set(previous, 3, 0);
        };
        vm_set(stack, 2, capacity);
        vm_set(stack, 3, resized_data);
    };
    nếu (aot_ghi_i32(frame, cell, first + count)) { trả về 2; };
    biến data = vm_get(stack, 3);
    lặp(j = 1; j <= count; j++) {
        biến value = vm_int(first + j);
        nếu (aot_status()) { trả về 2; };
        vm_set(data, old_count + j - 1, value);
        vm_set(stack, 1, old_count + j);
    };
    nếu (aot_safepoint(frame)) { trả về 2; };
    trả về 0;
};
// Guard không tạo binding. Quét view sở hữu chuỗi và cursor i32 cục bộ,
// không gọi code người dùng, không cấp phát trong vòng nóng.
hàm aot_byte_scan_loop(frame, cursor, bound, source, range, forbidden) {
    nếu (aot_status()) { trả về 2; };
    nếu (vm_get(frame, 9) != 0 || vm_get(aot_stack(frame), 1) != 0) { trả về 1; };
    biến state = aot_state();
    biến cell = vm_cell(state, frame, cursor, 0);
    biến limit_cell = vm_cell(state, frame, bound, 0);
    biến source_cell = vm_cell(state, frame, source, 0);
    nếu (cell == 0 || limit_cell == 0 || source_cell == 0 ||
        cell == limit_cell || cell == source_cell || limit_cell == source_cell) { trả về 1; };
    nếu (aot_o_i32(cell) == 0 || aot_o_i32(limit_cell) == 0 ||
        vm_get(source_cell, 0) != 10) { trả về 1; };
    biến inline_cell = cell == frame + 144 || cell == frame + 152 || cell == frame + 164 || cell == frame + 180 ||
        cell == frame + 192 || cell == frame + 204 || cell == frame + 216 || cell == frame + 228 ||
        cell == frame + 244 || cell == frame + 256 || cell == frame + 268 || cell == frame + 280 ||
        cell == frame + 292 || cell == frame + 304 || cell == frame + 316 || cell == frame + 328;
    // Ô cục bộ nằm trên heap có thể được closure chia sẻ. Không có lời gọi
    // code người dùng trong vòng quét; vẫn giữ ô và giá trị đóng hộp khi ghi.
    nếu (inline_cell == 0) {
        biến scope = vm_get(frame, 3);
        nếu (scope == 0 || vm_get(cell, 0) != 10) { trả về 1; };
        nếu (vm_map_get_int(scope, cursor) != cell) { trả về 1; };
    };
    biến view = vm_get(source_cell, 1);
    nếu (vm_tag(view) != 13) { trả về 1; };
    biến first = aot_doc_i32(cell);
    biến last = aot_doc_i32(limit_cell);
    nếu (first < 0 || first > last || last > vm_get(view, 1)) { trả về 1; };
    biến data = vm_get(view, 2);
    biến low = range & 255;
    biến high = (range >> 8) & 255;
    biến x = forbidden & 511;
    biến y = (forbidden >> 9) & 511;
    biến pos = first;
    nếu (range < 0) {
        biến packed = -1 - range;
        low = packed & 255;
        high = (packed >> 8) & 255;
        x = forbidden & 255;
        y = (forbidden >> 8) & 255;
        khi (pos < last) {
            biến c = máy đọc byte(data + pos);
            nếu (c != low && c != high && c != x && c != y) { thoát; };
            pos = pos + 1;
        };
    } hoặc {
        khi (pos < last) {
            biến c = máy đọc byte(data + pos);
            nếu (c < low || c > high || c == x || c == y) { thoát; };
            pos = pos + 1;
        };
    };
    nếu (pos != first) {
        nếu (inline_cell) {
            vm_set(cell, 0, 12);
            vm_set(cell, 1, pos);
        } hoặc nếu (aot_ghi_i32(frame, cell, pos)) { trả về 2; };
        nếu (aot_safepoint(frame)) { trả về 2; };
    };
    trả về 0;
};
// Chỉ ghi lại ô cục bộ đã tồn tại. Ô closure trên heap giữ nguyên identity.
hàm aot_decimal_local(frame, slot, cell) {
    nếu (cell == 0) { trả về 0; };
    nếu (cell == frame + 144 || cell == frame + 152 || cell == frame + 164 || cell == frame + 180 ||
        cell == frame + 192 || cell == frame + 204 || cell == frame + 216 || cell == frame + 228 ||
        cell == frame + 244 || cell == frame + 256 || cell == frame + 268 || cell == frame + 280 ||
        cell == frame + 292 || cell == frame + 304 || cell == frame + 316 || cell == frame + 328) { trả về 1; };
    biến scope = vm_get(frame, 3);
    nếu (scope == 0 || vm_get(cell, 0) != 10) { trả về 0; };
    trả về vm_map_get_int(scope, slot) == cell;
};
// Vòng tích lũy thập phân âm có kiểm tra giới hạn i32. Giữ giá trị byte
// cuối và cờ tràn quan sát được; mọi guard hoàn tất trước lần ghi đầu.
hàm aot_decimal_scan_loop(frame, cursor, bound, source, digit, acc, flag, last_digit) {
    nếu (aot_status()) { trả về 2; };
    nếu (vm_get(frame, 9) != 0 || vm_get(aot_stack(frame), 1) != 0) { trả về 1; };
    biến state = aot_state();
    biến pc = vm_cell(state, frame, cursor, 0);
    biến bc = vm_cell(state, frame, bound, 0);
    nếu (aot_o_i32(pc) == 0 || aot_o_i32(bc) == 0) { trả về 1; };
    biến pos = aot_doc_i32(pc);
    biến end = aot_doc_i32(bc);
    nếu (pos >= end) { trả về 0; };
    biến sc = vm_cell(state, frame, source, 0);
    biến dc = vm_cell(state, frame, digit, 0);
    biến ac = vm_cell(state, frame, acc, 0);
    biến fc = vm_cell(state, frame, flag, 0);
    biến lc = vm_cell(state, frame, last_digit, 0);
    nếu (sc == 0 || vm_get(sc, 0) != 10 || aot_o_i32(dc) == 0 ||
        aot_o_i32(ac) == 0 || aot_o_i32(fc) == 0 || aot_o_i32(lc) == 0) { trả về 1; };
    nếu (pc == bc || pc == sc || pc == dc || pc == ac || pc == fc || pc == lc ||
        bc == sc || bc == dc || bc == ac || bc == fc || bc == lc ||
        sc == dc || sc == ac || sc == fc || sc == lc ||
        dc == ac || dc == fc || dc == lc || ac == fc || ac == lc || fc == lc) { trả về 1; };
    nếu (aot_decimal_local(frame, cursor, pc) == 0 || aot_decimal_local(frame, digit, dc) == 0 ||
        aot_decimal_local(frame, acc, ac) == 0 || aot_decimal_local(frame, flag, fc) == 0) { trả về 1; };
    biến view = vm_get(sc, 1);
    nếu (vm_tag(view) != 13) { trả về 1; };
    nếu (pos < 0 || end > vm_get(view, 1)) { trả về 1; };
    biến number = aot_doc_i32(ac);
    biến limit = aot_doc_i32(lc);
    nếu (number > 0 || limit < 0 || limit > 8) { trả về 1; };
    biến data = vm_get(view, 2);
    biến first = pos;
    biến d = 0;
    biến overflow = 0;
    biến scan_end = end;
    nếu (end - first > 4096) { scan_end = first + 4096; };
    khi (pos < scan_end) {
        d = máy đọc byte(data + pos);
        nếu (d < 48 || d > 57) { thoát; };
        d = d - 48;
        nếu (number < -214748364 || (number == -214748364 && d > limit)) {
            overflow = 1; thoát;
        };
        number = number * 10 - d;
        pos = pos + 1;
    };
    // Chưa ghi ô nào; fallback bắt đầu tại cursor gốc khi hết ngân sách.
    nếu (pos == scan_end && scan_end < end) { trả về 1; };
    nếu (aot_ghi_i32(frame, dc, d)) { trả về 2; };
    nếu (pos != first) {
        nếu (aot_ghi_i32(frame, ac, number)) { trả về 2; };
        nếu (aot_ghi_i32(frame, pc, pos)) { trả về 2; };
    };
    nếu (overflow) { nếu (aot_ghi_i32(frame, fc, 0)) { trả về 2; }; };
    nếu (aot_safepoint(frame)) { trả về 2; };
    trả về 0;
};
hàm aot_counted_scalar_loop_body(frame, counter, bound, value, step, threshold, keep) {
    nếu (keep == 0 && vm_get(aot_stack(frame), 1) != 0) { trả về 1; };
    nếu (counter == value) { trả về 1; };
    biến state = aot_state();
    biến counter_cell = vm_cell(state, frame, counter, 0);
    nếu (aot_o_i32(counter_cell) == 0) { trả về 1; };
    biến first = aot_doc_i32(counter_cell);
    nếu (first >= bound) { trả về 0; };
    // Phép trừ i32 có thể tràn khi khoảng lặp vượt quá 2^31 - 1.
    nếu (first < 0 && bound >= 0) { trả về 1; };
    biến remaining = bound - first;
    nếu (remaining > 1000000) { trả về 1; };
    nếu (remaining <= 0) { trả về 0; };
    biến value_cell = vm_cell(state, frame, value, 0);
    nếu (value_cell == counter_cell || aot_o_i32(value_cell) == 0) { trả về 1; };
    biến number = aot_doc_i32(value_cell);
    biến completed = 0;
    khi (completed < remaining) {
        biến count = remaining - completed;
        nếu (count > 4096) { count = 4096; };
        lặp(j = 0; j < count; j++) {
            number = number + step;
            nếu (number >= threshold) { number = number - threshold; };
        };
        nếu (aot_ghi_i32(frame, value_cell, number)) { trả về 2; };
        nếu (aot_loop_counters(frame, counter_cell, first + completed, count, keep)) { trả về 2; };
        completed = completed + count;
    };
    trả về 0;
};
hàm aot_counted_scalar_loop(frame, counter, bound, value, step, threshold) {
    trả về aot_counted_scalar_loop_body(frame, counter, bound, value, step, threshold, 1);
};
hàm aot_counted_scalar_loop_tail(frame, counter, bound, value, step, threshold) {
    trả về aot_counted_scalar_loop_body(frame, counter, bound, value, step, threshold, 0);
};
hàm aot_simple_scalar_loop_body(frame, counter, bound, value, operand, op, keep) {
    nếu (keep == 0 && vm_get(aot_stack(frame), 1) != 0) { trả về 1; };
    nếu (counter == value || (op != 0 && op != 1 && op != 2)) { trả về 1; };
    biến state = aot_state();
    biến counter_cell = vm_cell(state, frame, counter, 0);
    nếu (aot_o_i32(counter_cell) == 0) { trả về 1; };
    biến first = aot_doc_i32(counter_cell);
    nếu (first >= bound) { trả về 0; };
    nếu (first < 0 && bound >= 0) { trả về 1; };
    biến remaining = bound - first;
    nếu (remaining > 1000000) { trả về 1; };
    nếu (remaining <= 0) { trả về 0; };
    biến value_cell = vm_cell(state, frame, value, 0);
    nếu (value_cell == counter_cell || aot_o_i32(value_cell) == 0) { trả về 1; };
    biến number = aot_doc_i32(value_cell);
    biến completed = 0;
    khi (completed < remaining) {
        biến count = remaining - completed;
        nếu (count > 4096) { count = 4096; };
        nếu (op == 0) { number = number + operand * count; }
        hoặc nếu (op == 1) { number = number - operand * count; }
        hoặc {
            lặp(j = 0; j < count; j++) { number = number * operand; };
        };
        nếu (aot_ghi_i32(frame, value_cell, number)) { trả về 2; };
        nếu (aot_loop_counters(frame, counter_cell, first + completed, count, keep)) { trả về 2; };
        completed = completed + count;
    };
    trả về 0;
};
hàm aot_simple_scalar_loop(frame, counter, bound, value, operand, op) {
    trả về aot_simple_scalar_loop_body(frame, counter, bound, value, operand, op, 1);
};
hàm aot_simple_scalar_loop_tail(frame, counter, bound, value, operand, op) {
