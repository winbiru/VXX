// nằm trong khung cha. Bit i của mặt nạ cho biết đối số i là ô biến.
// Chỉ tạo giá trị động cho đối số không thể đọc thành i32 thô.
hàm aot_call_quad(frame, id, count, first, second, third, fourth, mask) {
    biến state = aot_state();
    nếu (id < 0 || id >= vm_get(vm_get(state, 1), 1)) {
        // Hàm host vẫn nhận giá trị động theo đúng thứ tự đánh giá.
        nếu (mask % 2 == 1) { aot_load(frame, first); }
        hoặc { aot_integer(frame, first); };
        nếu (aot_status()) { trả về 1; };
        nếu (mask % 4 >= 2) { aot_load(frame, second); }
        hoặc { aot_integer(frame, second); };
        nếu (aot_status()) { trả về 1; };
        nếu (mask % 8 >= 4) { aot_load(frame, third); }
        hoặc { aot_integer(frame, third); };
        nếu (aot_status()) { trả về 1; };
        nếu (count == 4) {
            nếu (mask >= 8) { aot_load(frame, fourth); }
            hoặc { aot_integer(frame, fourth); };
            nếu (aot_status()) { trả về 1; };
        };
        trả về aot_call(frame, id, count);
    };
    biến args = frame + 96;
    máy ghi số nguyên ba mươi hai bit(args + 4, count);
    biến raw = 0;
    nếu (mask % 2 == 1) {
        raw = aot_arg_slot(frame, first, args + 16);
    } hoặc {
        máy ghi số nguyên ba mươi hai bit(args + 16, first); raw = 1;
    };
    nếu (aot_status()) { aot_release_args(frame); trả về 1; };
    nếu (mask % 4 >= 2) {
        raw = raw + aot_arg_slot(frame, second, args + 20) * 2;
    } hoặc {
        máy ghi số nguyên ba mươi hai bit(args + 20, second); raw = raw + 2;
    };
    nếu (aot_status()) { aot_release_args(frame); trả về 1; };
    nếu (mask % 8 >= 4) {
        raw = raw + aot_arg_slot(frame, third, args + 24) * 4;
    } hoặc {
        máy ghi số nguyên ba mươi hai bit(args + 24, third); raw = raw + 4;
    };
    nếu (aot_status()) { aot_release_args(frame); trả về 1; };
    nếu (count == 4) {
        nếu (mask >= 8) {
            raw = raw + aot_arg_slot(frame, fourth, args + 28) * 8;
        } hoặc {
            máy ghi số nguyên ba mươi hai bit(args + 28, fourth); raw = raw + 8;
        };
        nếu (aot_status()) { aot_release_args(frame); trả về 1; };
    };
    nếu (raw != 0) { máy ghi số nguyên ba mươi hai bit(args + 8, 0 - raw - 1); };
    biến result = aot_invoke(id, args, 0, 0, 0);
    aot_release_args(frame);
    trả về aot_push(frame, result);
};
hàm aot_call(frame, id, count) {
    biến state = aot_state(); biến result = 0;
    nếu (id >= 0 && id < vm_get(vm_get(state, 1), 1)) {
        biến args = aot_take_args(frame, count);
        nếu (aot_status()) { trả về 1; };
        result = aot_invoke(id, args, 0, 0, 0);
        nếu (count >= 1 && count <= 4) { aot_release_args(frame); };
    }
    hoặc {
        biến name = id; nếu (id < 0) { name = 0 - id - 1; };
        biến op = vm_host_cached(state, name);
        biến stack = aot_stack(frame);
        biến n = vm_get(stack, 1);
        // Giữ các đối số trên stack đến khi thao tác xong để GC thấy gốc.
        // Cắt bỏ tạo danh sách đối số cho hai host gọi nhiều nhất.
        nếu (op == 148 && count == 2 && n >= 2) {
            biến data = vm_get(stack, 3);
            biến list = vm_get(data, n - 2);
            biến item = vm_get(data, n - 1);
            vm_set(4198464, 13, op);
            nếu (vm_tag(list) != 4) { vm_error(2); trả về 1; };
            vm_append(list, item);
            vm_pop(stack); vm_pop(stack);
            trả về aot_push(frame, 0);
        };
