hàm aot_construct(frame, name, count) {
    biến args = vm_take(aot_stack(frame), count); biến klass = vm_map_get(vm_get(aot_state(), 5), vm_pool(aot_state(), name));
    nếu (klass == 0) { vm_error(18); trả về 1; };
    biến instance = vm_alloc(16, 1); nếu (instance == 0) { trả về 1; };
    vm_set(instance, 0, 9); vm_set(instance, 1, klass); vm_set(instance, 2, vm_vector(5));
    biến constructor = vm_map_get(vm_get(klass, 3), vm_literal("khởi tạo"));
    nếu (constructor == 0) { nếu (count != 0) { vm_error(14); }; }
    hoặc {
        nếu (vm_access(constructor, vm_get(frame, 6)) == 0) { vm_error(19); trả về 1; };
