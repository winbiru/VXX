// Gợi ý dựa trên mã lỗi và opcode đã ghi nhận.
// 0: Xem ngoại lệ; dùng thử/bắt lỗi khi phù hợp.
// 1: Kiểm tra mã tiến trình và vòng đời tài nguyên.
// 2: Kiểm tra danh sách byte và giá trị từ 0 đến 255.
// 3: Kiểm tra số chia.
// 4: Kiểm tra giới hạn bộ nhớ và kích thước cấp phát.
// 5: Kiểm tra chỉ mục và kích thước dữ liệu.
// 6: Kiểm tra độ sâu đệ quy và chuỗi lời gọi.
nhập giải nén.*;

hàm chẩn đoán gợi ý lỗi(mã, thao tác) {
    biến mục = -1;
    nếu (mã == 16 && thao tác == 80) { mục = 0; };
    nếu (mã == 2 && thao tác == 202) { mục = 1; };
    nếu ((mã == 2 || mã == 16) && thao tác == 154) { mục = 2; };
    nếu (mã == 6) { mục = 3; };
    nếu (mã == 1) { mục = 4; };
    nếu (mã == 4) { mục = 5; };
    nếu (mã == 15) { mục = 6; };
    nếu (mục < 0) { trả về byte mới(); };
    biến bảng = byte mới();
    nếu (bảng <= 0) { trả về -1; };
    chẩn đoán nạp bảng(bảng, 1835358208, 1869049376, -1581645599, -513007511, 989890491, -1178377184, 2123630);
    chẩn đoán nạp bảng(bảng, -1142855564, -513658963, 1957673480, 1771504353, 1744857888, 1752178793, 18921923);
    chẩn đoán nạp bảng(bảng, 1889731360, 1766522926, -2084896543, 1920213101, 1828724833, 1948296131, 79356265);
    chẩn đoán nạp bảng(bảng, 29388479, 1752083651, -1015666656, -1308598112, -1849423616, -1648631552, -1015799703);
    chẩn đoán nạp bảng(bảng, 6914720, -1015450355, 124415658, -1067359228, -1581026555, 538994787, 1702132066);
    chẩn đoán nạp bảng(bảng, 1768359714, 10601220, -1950621429, -513772512, 807447483, 195102881, 892666930);
    chẩn đoán nạp bảng(bảng, -512553206, 1344311739, 1634297955, 543625674, 1761778451, -1581640480, -513662866);
    chẩn đoán nạp bảng(bảng, 546945872, -1692819346, -2073357694, 220245443, -1329174412, 1669334112, -1159634144);
    chẩn đoán nạp bảng(bảng, 448884901, 712286484, 532701978, 275587209, 1671805921, -513538351, 548391099);
    chẩn đoán nạp bảng(bảng, -2027945876, -2128541067, -1600581091, -495607271, 1897957150, 1652127172, 1969775393);
    chẩn đoán nạp bảng(bảng, 742402178, 1730248705, 1770896353, 46, 0, 0, 0);
    trả về chẩn đoán tra bảng(bảng, 294, 380, mục);
};
