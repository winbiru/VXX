// Module: dữ liệu.kết nối cơ sở dữ liệu
// Mục đích: cung cấp API cấu hình và thực thi truy vấn cho nhiều engine DB.
// Hỗ trợ hiện tại: MySQL, PostgreSQL, SQLite qua JDBC URL + driver class.

nhập gói.bộ sưu tập.từ điển.lấy từ điển;
nhập gói.lõi.chuyển kiểu.thành chuỗi;
nhập gói.văn bản.chuỗi.*;
nhập gói.hệ thống.tiến trình.chạy tiến trình;
nhập gói.hệ thống.nền tảng.tên nền tảng;

// Lớp sở hữu toàn bộ thuật toán của mô-đun; các hàm bên dưới chỉ giữ API cũ.
lớp công khai Trình Điều Khiển Cơ Sở Dữ Liệu {
    hàm công khai khởi tạo() {};

    hàm riêng tư cơ sở dữ liệu lỗi cấu hình(lý độ) {
        trả về {"ok": sai, "reason": lý độ};
    };

    hàm riêng tư cơ sở dữ liệu đọc số nguyên thập phân(văn bản) {
        nếu (văn bản == "") {
            trả về {"ok": sai, "value": 0};
        };
        dấu = 1;
        bắt đầu = 0;
        nếu (văn bản[0] == "-") {
            dấu = -1;
            bắt đầu = 1;
        } hoặc {
            nếu (văn bản[0] == "+") {
                bắt đầu = 1;
            };
        };
        nếu (bắt đầu >= máy ảo lấy độ dài(văn bản)) {
            trả về {"ok": sai, "value": 0};
        };
        giá trị = 0;
        chữ số = "0123456789";
        lặp(i = bắt đầu; i < máy ảo lấy độ dài(văn bản); i++) {
            số = tìm chuỗi chính xác(chữ số, văn bản[i], 0);
            nếu (số == rỗng) {
                trả về {"ok": sai, "value": 0};
            };
            giá trị = giá trị * 10 + số;
        };
        trả về {"ok": đúng, "value": giá trị * dấu};
    };

    hàm riêng tư cơ sở dữ liệu cấu hình giao vận tin cậy(địa chỉ kết nối cơ sở dữ liệu, tiền tố, bộ máy, cổng mặc định) {
        nếu (!bắt đầu bằng(địa chỉ kết nối cơ sở dữ liệu, tiền tố)) {
            trả về mình.cơ sở dữ liệu lỗi cấu hình("invalid-jdbc-prefix");
        };
        phần còn lại = con chuỗi(địa chỉ kết nối cơ sở dữ liệu, máy ảo lấy độ dài(tiền tố), máy ảo lấy độ dài(địa chỉ kết nối cơ sở dữ liệu));
        vị trí gạch = tìm chuỗi chính xác(phần còn lại, "/", 0);
        nếu (vị trí gạch == rỗng || vị trí gạch == 0) {
            trả về mình.cơ sở dữ liệu lỗi cấu hình("invalid-host-or-database");
        };

        máy đích cổng mạng = bỏ khoảng trắng(con chuỗi(phần còn lại, 0, vị trí gạch));
        phần cơ sở dữ liệu và truy vấn = con chuỗi(phần còn lại, vị trí gạch + 1, máy ảo lấy độ dài(phần còn lại));
        máy đích = máy đích cổng mạng;
        cổng = cổng mặc định;
        vị trí hai chấm = tìm chuỗi chính xác(máy đích cổng mạng, ":", 0);
        nếu (vị trí hai chấm != rỗng) {
            máy đích = bỏ khoảng trắng(con chuỗi(máy đích cổng mạng, 0, vị trí hai chấm));
            chữ cổng = bỏ khoảng trắng(con chuỗi(
                máy đích cổng mạng,
                vị trí hai chấm + 1,
                máy ảo lấy độ dài(máy đích cổng mạng)
            ));
            nếu (chữ cổng == "") {
                trả về mình.cơ sở dữ liệu lỗi cấu hình("invalid-port");
            };
            cổng đã đọc = mình.cơ sở dữ liệu đọc số nguyên thập phân(chữ cổng);
            nếu (!lấy từ điển(cổng đã đọc, "ok", sai)) {
                trả về mình.cơ sở dữ liệu lỗi cấu hình("invalid-port");
            };
            cổng = lấy từ điển(cổng đã đọc, "value", 0);
        };
        nếu (máy đích == "") {
            trả về mình.cơ sở dữ liệu lỗi cấu hình("missing-host");
        };

        cơ sở dữ liệu = phần cơ sở dữ liệu và truy vấn;
        truy vấn = "";
        vị trí hỏi = tìm chuỗi chính xác(phần cơ sở dữ liệu và truy vấn, "?", 0);
        nếu (vị trí hỏi != rỗng) {
            cơ sở dữ liệu = con chuỗi(phần cơ sở dữ liệu và truy vấn, 0, vị trí hỏi);
            truy vấn = con chuỗi(phần cơ sở dữ liệu và truy vấn, vị trí hỏi + 1, máy ảo lấy độ dài(phần cơ sở dữ liệu và truy vấn));
        };
        cơ sở dữ liệu = bỏ khoảng trắng(cơ sở dữ liệu);
        nếu (cơ sở dữ liệu == "") {
            trả về mình.cơ sở dữ liệu lỗi cấu hình("missing-database");
        };
        trả về {
            "ok": đúng,
            "engine": bộ máy,
            "host": máy đích,
            "port": cổng,
            "database": cơ sở dữ liệu,
            "path": "",
            "create": chứa chính xác(truy vấn, "createDatabaseIfNotExist=true")
        };
    };

    hàm công khai cơ sở dữ liệu phân tích cấu hình(tên lớp điều khiển, địa chỉ kết nối cơ sở dữ liệu) {
        nếu (bắt đầu bằng(địa chỉ kết nối cơ sở dữ liệu, "jdbc:mysql://") ||
            chứa chính xác(tên lớp điều khiển, "mysql")) {
            trả về mình.cơ sở dữ liệu cấu hình giao vận tin cậy(địa chỉ kết nối cơ sở dữ liệu, "jdbc:mysql://", "mysql", 3306);
        };
        nếu (bắt đầu bằng(địa chỉ kết nối cơ sở dữ liệu, "jdbc:postgresql://") ||
            chứa chính xác(tên lớp điều khiển, "postgresql")) {
            trả về mình.cơ sở dữ liệu cấu hình giao vận tin cậy(địa chỉ kết nối cơ sở dữ liệu, "jdbc:postgresql://", "postgresql", 5432);
        };
        nếu (bắt đầu bằng(địa chỉ kết nối cơ sở dữ liệu, "jdbc:sqlite:") ||
            chứa chính xác(tên lớp điều khiển, "sqlite")) {
            tiền tố = "jdbc:sqlite:";
            nếu (!bắt đầu bằng(địa chỉ kết nối cơ sở dữ liệu, tiền tố)) {
                trả về mình.cơ sở dữ liệu lỗi cấu hình("invalid-jdbc-prefix");
            };
            đường tệp = bỏ khoảng trắng(con chuỗi(địa chỉ kết nối cơ sở dữ liệu, máy ảo lấy độ dài(tiền tố), máy ảo lấy độ dài(địa chỉ kết nối cơ sở dữ liệu)));
            nếu (đường tệp == "") {
                trả về mình.cơ sở dữ liệu lỗi cấu hình("missing-sqlite-path");
            };
            trả về {
                "ok": đúng,
                "engine": "sqlite",
                "host": "",
                "port": 0,
                "database": "",
                "path": đường tệp,
                "create": sai
            };
        };
        trả về mình.cơ sở dữ liệu lỗi cấu hình("unsupported-driver");
    };

    hàm công khai cơ sở dữ liệu định danh an toàn(tên) {
        nếu (tên == "") { trả về sai; };
        lặp(i = 0; i < máy ảo lấy độ dài(tên); i++) {
            c = tên[i];
            hợp lệ = (c >= "a" && c <= "z") ||
                (c >= "A" && c <= "Z") ||
                (c >= "0" && c <= "9") ||
                c == "_";
            nếu (!hợp lệ) { trả về sai; };
        };
        trả về đúng;
    };

    hàm riêng tư cơ sở dữ liệu chuẩn hóa từ tố(thô, báo lỗi khi rỗng = đúng) {
        văn bản = bỏ khoảng trắng(thô);
        nếu (văn bản == "" && báo lỗi khi rỗng) {
            trả về "db-command-failed";
        };
        kết quả = "";
        lặp(i = 0; i < máy ảo lấy độ dài(văn bản); i++) {
            c = văn bản[i];
            nếu (c == "\n" || c == "\r" || c == "\t") {
                kết quả = kết quả + " ";
            } hoặc {
                nếu (c == "|") {
                    kết quả = kết quả + "/";
                } hoặc {
                    kết quả = kết quả + c;
                };
            };
        };
        trả về bỏ khoảng trắng(kết quả);
    };

    hàm riêng tư cơ sở dữ liệu lệnh máy khách(cấu hình, tên đăng nhập, mật khẩu, sql, dùng cơ sở dữ liệu) {
        tên đăng nhập = thành chuỗi(tên đăng nhập);
        mật khẩu = thành chuỗi(mật khẩu);
        sql = thành chuỗi(sql);
        bộ máy = lấy từ điển(cấu hình, "engine", "");
        nếu (bộ máy != "sqlite" && tên đăng nhập == "") {
            trả về {"ok": sai, "reason": "missing-username"};
        };
        máy đích = lấy từ điển(cấu hình, "host", "");
        cổng mạng = thành chuỗi(lấy từ điển(cấu hình, "port", 0));
        cơ sở dữ liệu = lấy từ điển(cấu hình, "database", "");
        nếu (bộ máy == "mysql") {
            đối số dòng lệnh = ["--protocol=TCP", "--batch", "--skip-column-names",
                "-h", máy đích, "-P", cổng mạng, "-u", tên đăng nhập];
            nếu (dùng cơ sở dữ liệu) {
                máy ảo thêm cuối danh sách(đối số dòng lệnh, "-D"); máy ảo thêm cuối danh sách(đối số dòng lệnh, cơ sở dữ liệu);
            };
            máy ảo thêm cuối danh sách(đối số dòng lệnh, "-e"); máy ảo thêm cuối danh sách(đối số dòng lệnh, sql);
            trả về {"ok": đúng, "chương trình": "mysql", "đối số": đối số dòng lệnh,
                "môi trường": {"MYSQL_PWD": mật khẩu},
                "dự phòng": "/opt/homebrew/opt/mysql-client/bin/mysql",
                "lỗi mở": "cannot-open-mysql-process"};
        };
        nếu (bộ máy == "postgresql") {
            nếu (!dùng cơ sở dữ liệu) { cơ sở dữ liệu = "postgres"; };
            trả về {"ok": đúng, "chương trình": "psql",
                "đối số": ["-h", máy đích, "-p", cổng mạng, "-U", tên đăng nhập,
                    "-d", cơ sở dữ liệu, "-At", "-c", sql],
                "môi trường": {"PGPASSWORD": mật khẩu},
                "dự phòng": "/opt/homebrew/bin/psql", "lỗi mở": "cannot-open-psql-process"};
        };
        nếu (bộ máy == "sqlite") {
            chương trình = "sqlite3";
            nếu (tên nền tảng() == "windows") { chương trình = "sqlite3.exe"; };
            trả về {"ok": đúng, "chương trình": chương trình,
                "đối số": [lấy từ điển(cấu hình, "path", ""), sql],
                "môi trường": {}, "dự phòng": "", "lỗi mở": "cannot-open-sqlite-process"};
        };
        trả về {"ok": sai, "reason": "unsupported-driver"};
    };

    // Chọn client, dựng argv/environment, dự phòng và diễn giải exit status đều ở V++.
    hàm riêng tư cơ sở dữ liệu chạy primitive(cấu hình, tên đăng nhập, mật khẩu, sql, dùng cơ sở dữ liệu) {
        lệnh = mình.cơ sở dữ liệu lệnh máy khách(cấu hình, tên đăng nhập, mật khẩu, sql, dùng cơ sở dữ liệu);
        nếu (!lấy từ điển(lệnh, "ok", sai)) {
            trả về {"ok": sai, "reason": lấy từ điển(lệnh, "reason", "db-command-failed"), "output": ""};
        };
        đối số dòng lệnh = lấy từ điển(lệnh, "đối số", []);
        giá trị môi trường = lấy từ điển(lệnh, "môi trường", {});
        thô = chạy tiến trình(lấy từ điển(lệnh, "chương trình", ""), đối số dòng lệnh, giá trị môi trường);
        nếu (!lấy từ điển(thô, "khởi chạy", sai)) {
            dự phòng = lấy từ điển(lệnh, "dự phòng", "");
            nếu (dự phòng != "" && tên nền tảng() == "macos") {
                thô = chạy tiến trình(dự phòng, đối số dòng lệnh, giá trị môi trường);
            };
        };
        nếu (!lấy từ điển(thô, "khởi chạy", sai)) {
            trả về {"ok": sai, "reason": lấy từ điển(lệnh, "lỗi mở", "db-command-failed"), "output": ""};
        };
        nếu (lấy từ điển(thô, "mã thoát", -1) != 0 || lấy từ điển(thô, "lỗi", "") != "") {
            lý độ = lấy từ điển(thô, "đầu ra", "");
            nếu (lý độ == "") { lý độ = lấy từ điển(thô, "lỗi", ""); };
            trả về {
                "ok": sai,
                "reason": mình.cơ sở dữ liệu chuẩn hóa từ tố(lý độ),
                "output": ""
            };
        };
        trả về {
            "ok": đúng,
            "reason": "",
            "output": mình.cơ sở dữ liệu chuẩn hóa từ tố(lấy từ điển(thô, "đầu ra", ""), sai)
        };
    };

    hàm riêng tư cơ sở dữ liệu chuẩn bị cơ sở dữ liệu(cấu hình, tên đăng nhập, mật khẩu) {
        bộ máy = lấy từ điển(cấu hình, "engine", "");
        nếu (bộ máy == "sqlite" || !lấy từ điển(cấu hình, "create", sai)) {
            trả về {"ok": đúng, "reason": "", "output": ""};
        };
        cơ sở dữ liệu = lấy từ điển(cấu hình, "database", "");
        nếu (!mình.cơ sở dữ liệu định danh an toàn(cơ sở dữ liệu)) {
            trả về {"ok": sai, "reason": "unsafe-database-name", "output": ""};
        };
        nếu (bộ máy == "mysql") {
            trả về mình.cơ sở dữ liệu chạy primitive(
                cấu hình,
                tên đăng nhập,
                mật khẩu,
                "CREATE DATABASE IF NOT EXISTS `" + cơ sở dữ liệu + "`;",
                sai
            );
        };
        kiểm tra = mình.cơ sở dữ liệu chạy primitive(
            cấu hình,
            tên đăng nhập,
            mật khẩu,
            "SELECT 1 FROM pg_database WHERE datname='" + cơ sở dữ liệu + "';",
            sai
        );
        nếu (!lấy từ điển(kiểm tra, "ok", sai)) { trả về kiểm tra; };
        nếu (lấy từ điển(kiểm tra, "output", "") == "1") { trả về kiểm tra; };
        trả về mình.cơ sở dữ liệu chạy primitive(
            cấu hình,
            tên đăng nhập,
            mật khẩu,
            "CREATE DATABASE \"" + cơ sở dữ liệu + "\";",
            sai
        );
    };

    hàm riêng tư cơ sở dữ liệu lỗi kết quả(lý độ) {
        trả về "DB_ERR|" + lý độ;
    };

    // JDBC, lựa chọn client, argv và policy kết nối ở V++; VM chỉ spawn executable.
    hàm công khai kết nối cơ sở dữ liệu(tên lớp điều khiển, địa chỉ kết nối cơ sở dữ liệu, tên đăng nhập, mật khẩu) {
        cấu hình = mình.cơ sở dữ liệu phân tích cấu hình(tên lớp điều khiển, địa chỉ kết nối cơ sở dữ liệu);
        nếu (!lấy từ điển(cấu hình, "ok", sai)) {
            trả về mình.cơ sở dữ liệu lỗi kết quả(lấy từ điển(cấu hình, "reason", "db-command-failed"));
        };
        bộ máy = lấy từ điển(cấu hình, "engine", "");
        nếu (bộ máy != "sqlite" && tên đăng nhập == "") {
            trả về mình.cơ sở dữ liệu lỗi kết quả("missing-username");
        };
        chuẩn bị = mình.cơ sở dữ liệu chuẩn bị cơ sở dữ liệu(cấu hình, tên đăng nhập, mật khẩu);
        nếu (!lấy từ điển(chuẩn bị, "ok", sai)) {
            trả về mình.cơ sở dữ liệu lỗi kết quả(lấy từ điển(chuẩn bị, "reason", "db-command-failed"));
        };
        kết quả = mình.cơ sở dữ liệu chạy primitive(cấu hình, tên đăng nhập, mật khẩu, "SELECT 1;", đúng);
        nếu (!lấy từ điển(kết quả, "ok", sai)) {
            trả về mình.cơ sở dữ liệu lỗi kết quả(lấy từ điển(kết quả, "reason", "db-command-failed"));
        };
        trả về "DB_OK|connected";
    };

    // SQL result contract cũng được dựng ở V++.
    hàm công khai truy vấn cơ sở dữ liệu(tên lớp điều khiển, địa chỉ kết nối cơ sở dữ liệu, tên đăng nhập, mật khẩu, sql) {
        cấu hình = mình.cơ sở dữ liệu phân tích cấu hình(tên lớp điều khiển, địa chỉ kết nối cơ sở dữ liệu);
        nếu (!lấy từ điển(cấu hình, "ok", sai)) {
            trả về mình.cơ sở dữ liệu lỗi kết quả(lấy từ điển(cấu hình, "reason", "db-command-failed"));
        };
        bộ máy = lấy từ điển(cấu hình, "engine", "");
        nếu (bộ máy != "sqlite" && tên đăng nhập == "") {
            trả về mình.cơ sở dữ liệu lỗi kết quả("missing-username");
        };
        kết quả = mình.cơ sở dữ liệu chạy primitive(cấu hình, tên đăng nhập, mật khẩu, sql, đúng);
        nếu (!lấy từ điển(kết quả, "ok", sai)) {
            trả về mình.cơ sở dữ liệu lỗi kết quả(lấy từ điển(kết quả, "reason", "db-command-failed"));
        };
        kết xuất = lấy từ điển(kết quả, "output", "");
        nếu (kết xuất == "") {
            trả về "DB_OK|affected=1";
        };
        trả về "DB_OK|" + kết xuất;
    };

    // Ghi chú hàm: ngắt kết nối logic ở tầng gói.
    hàm công khai ngắt kết nối cơ sở dữ liệu(tên lớp điều khiển, địa chỉ kết nối cơ sở dữ liệu, tên đăng nhập, mật khẩu) {
        trả về "DB_OK|disconnected";
    };

