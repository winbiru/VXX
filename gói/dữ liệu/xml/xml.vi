// vi.xml — XML cây đơn giản, không tải DOCTYPE/thực thể ngoài.
nhập gói/bộ sưu tập/từ điển;
nhập gói/bộ sưu tập/danh sách;
nhập gói/lõi/bảng mã;
nhập gói/lõi/toán học;
nhập gói/văn bản/chuỗi;

// Lớp sở hữu toàn bộ thuật toán của mô-đun; các hàm bên dưới chỉ giữ API cũ.
lớp riêng tư Xử Lý Nội Bộ Xml {
    hàm công khai khởi tạo() {};

    hàm công khai xml thoát(văn bản) {
        nếu (loại của(văn bản) != "chuỗi") {
            ném "xml thoát: văn bản phải là chuỗi";
        };

        kết quả = "";
        lặp(i = 0; i < máy ảo lấy độ dài(văn bản); i++) {
            c = văn bản[i];
            nếu (c == "&") {
                kết quả = kết quả + "&amp;";
            } hoặc {
                nếu (c == "<") {
                    kết quả = kết quả + "&lt;";
                } hoặc {
                    nếu (c == ">") {
                        kết quả = kết quả + "&gt;";
                    } hoặc {
                        kết quả = kết quả + c;
                    };
                };
            };
        };
        trả về kết quả;
    };

    hàm công khai xml phân tích(nội dung) {
        bộ nội bộ = Bộ Xử Lý XML();
        trả về bộ nội bộ.xml phân tích(nội dung);
    };

    hàm công khai xml tạo(nút) {
        bộ nội bộ = Bộ Xử Lý XML();
        trả về bộ nội bộ.xml tạo(nút);
    };
};

hàm công khai xml thoát(văn bản) {
    bộ xử lý = Xử Lý Nội Bộ Xml();
    trả về bộ xử lý.xml thoát(văn bản);
};

// Các thuật toán và trợ giúp nằm trong lớp nội bộ, không được xuất qua import.
lớp riêng tư Bộ Xử Lý XML {
    hàm công khai khởi tạo() {};

    // Escape riêng cho giá trị thuộc tính. Nội dung text không cần escape quote,
    // nhưng thuộc tính đặt trong dấu " nên phải giữ cả quote/apostrophe an toàn.
    hàm riêng tư xml thoát thuộc tính(văn bản) {
        nếu (loại của(văn bản) != "chuỗi") {
            ném "xml tạo: thuộc tính không hợp lệ";
        };

        kết quả = "";
        lặp(i = 0; i < máy ảo lấy độ dài(văn bản); i++) {
            c = văn bản[i];
            nếu (c == "&") {
                kết quả = kết quả + "&amp;";
            } hoặc {
                nếu (c == "<") {
                    kết quả = kết quả + "&lt;";
                } hoặc {
                    nếu (c == ">") {
                        kết quả = kết quả + "&gt;";
                    } hoặc {
                        nếu (c == "\"") {
                            kết quả = kết quả + "&quot;";
                        } hoặc {
                            nếu (c == "'") {
                                kết quả = kết quả + "&apos;";
                            } hoặc {
                                kết quả = kết quả + c;
                            };
                        };
                    };
                };
            };
        };
        trả về kết quả;
    };

    // Contract tên XML hiện tại của V++: ASCII chữ/số/_-.: hoặc bất kỳ code point
    // UTF-8 ngoài ASCII. Giữ đúng semantics native cũ thay vì áp XML Namespaces đầy đủ.
    hàm riêng tư xml tên hợp lệ(tên) {
        nếu (loại của(tên) != "chuỗi" || máy ảo lấy độ dài(tên) == 0) {
            trả về sai;
        };

        mã ký tự cơ bản hợp lệ = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-.:";
        lặp(i = 0; i < máy ảo lấy độ dài(tên); i++) {
            c = tên[i];
            hợp lệ = sai;
            lặp(j = 0; j < máy ảo lấy độ dài(mã ký tự cơ bản hợp lệ) && !hợp lệ; j++) {
                nếu (c == mã ký tự cơ bản hợp lệ[j]) {
                    hợp lệ = đúng;
                };
            };
            nếu (!hợp lệ) {
                các byte = mã hóa bảng mã(c, "UTF-8");
                nếu (máy ảo lấy độ dài(các byte) == 1) {
                    trả về sai;
                };
            };
        };
        trả về đúng;
    };

    hàm riêng tư xml là khoảng trắng(c) {
        trả về c == " " || c == "\t" || c == "\r" || c == "\n";
    };

    hàm riêng tư xml lỗi(trạng thái, thông báo) {
        vị trí = lấy từ điển(trạng thái, "vị trí", 0);
        ném "xml: " + thông báo + " tại vị trí " + thành chuỗi(vị trí);
    };

    hàm riêng tư xml bỏ khoảng trắng(trạng thái) {
        nội dung = lấy từ điển(trạng thái, "nội dung", "");
        vị trí = lấy từ điển(trạng thái, "vị trí", 0);
        n = máy ảo lấy độ dài(nội dung);
        đang bỏ = đúng;
        khi (vị trí < n && đang bỏ) {
            nếu (mình.xml là khoảng trắng(nội dung[vị trí])) {
                vị trí = vị trí + 1;
            } hoặc {
                đang bỏ = sai;
            };
        };
        đặt từ điển(trạng thái, "vị trí", vị trí);
    };

    hàm riêng tư xml bắt đầu tại(trạng thái, từ tố) {
        nội dung = lấy từ điển(trạng thái, "nội dung", "");
        vị trí = lấy từ điển(trạng thái, "vị trí", 0);
        m = máy ảo lấy độ dài(từ tố);
        nếu (vị trí + m > máy ảo lấy độ dài(nội dung)) {
            trả về sai;
        };
        trả về cắt chuỗi(nội dung, vị trí, m) == từ tố;
    };

    hàm riêng tư xml đọc tên(trạng thái) {
        nội dung = lấy từ điển(trạng thái, "nội dung", "");
        vị trí = lấy từ điển(trạng thái, "vị trí", 0);
        n = máy ảo lấy độ dài(nội dung);
        bắt đầu = vị trí;
        đang đọc = đúng;
        khi (vị trí < n && đang đọc) {
            c = nội dung[vị trí];
            nếu (mình.xml tên hợp lệ(c)) {
                vị trí = vị trí + 1;
            } hoặc {
                đang đọc = sai;
            };
        };
        nếu (vị trí == bắt đầu) {
            mình.xml lỗi(trạng thái, "thiếu tên");
        };
        đặt từ điển(trạng thái, "vị trí", vị trí);
        trả về cắt chuỗi(nội dung, bắt đầu, vị trí - bắt đầu);
    };

    hàm riêng tư xml thập lục phân nửa byte(c) {
        bảng chữ cái = "0123456789abcdef";
        chữ = chuỗi thường(c);
        kết quả = -1;
        lặp(i = 0; i < 16 && kết quả < 0; i++) {
            nếu (bảng chữ cái[i] == chữ) {
                kết quả = i;
            };
        };
        trả về kết quả;
    };

    hàm riêng tư xml ký tự mã(mã) {
        nếu (mã < 0 || mã > 1114111 || (mã >= 55296 && mã <= 57343)) {
            ném "xml: điểm mã Unicode không hợp lệ";
        };
        các byte = [];
        nếu (mã <= 127) {
            máy ảo thêm cuối danh sách(các byte, mã);
        } hoặc {
            nếu (mã <= 2047) {
                máy ảo thêm cuối danh sách(các byte, 192 + làm tròn xuống(mã / 64));
                máy ảo thêm cuối danh sách(các byte, 128 + mã % 64);
            } hoặc {
                nếu (mã <= 65535) {
                    máy ảo thêm cuối danh sách(các byte, 224 + làm tròn xuống(mã / 4096));
                    máy ảo thêm cuối danh sách(các byte, 128 + (làm tròn xuống(mã / 64) % 64));
                    máy ảo thêm cuối danh sách(các byte, 128 + mã % 64);
                } hoặc {
                    máy ảo thêm cuối danh sách(các byte, 240 + làm tròn xuống(mã / 262144));
                    máy ảo thêm cuối danh sách(các byte, 128 + (làm tròn xuống(mã / 4096) % 64));
                    máy ảo thêm cuối danh sách(các byte, 128 + (làm tròn xuống(mã / 64) % 64));
                    máy ảo thêm cuối danh sách(các byte, 128 + mã % 64);
                };
            };
        };
        trả về giải mã bảng mã(các byte, "UTF-8");
    };

    hàm riêng tư xml thực thể số(thực thể) {
        n = máy ảo lấy độ dài(thực thể);
        nếu (n < 2 || thực thể[0] != "#") {
            ném "xml: thực thể số không hợp lệ";
        };
        i = 1;
        cơ số = 10;
        nếu (i < n) {
            nếu (thực thể[i] == "x" || thực thể[i] == "X") {
                cơ số = 16;
                i = i + 1;
            };
        };
        nếu (i >= n) {
            ném "xml: thực thể số không hợp lệ";
        };
        giá trị = 0;
        hợp lệ = đúng;
        khi (i < n && hợp lệ) {
            chữ số = -1;
            nếu (cơ số == 16) {
                chữ số = mình.xml thập lục phân nửa byte(thực thể[i]);
            } hoặc {
                nếu (thực thể[i] >= "0" && thực thể[i] <= "9") {
                    chữ số = thành số nguyên(thực thể[i]);
                };
            };
            nếu (chữ số < 0) {
                hợp lệ = sai;
            } hoặc {
                giá trị = giá trị * cơ số + chữ số;
                nếu (giá trị > 1114111) {
                    hợp lệ = sai;
                };
            };
            i = i + 1;
        };
        nếu (!hợp lệ) {
            ném "xml: thực thể số không hợp lệ";
        };
        trả về mình.xml ký tự mã(giá trị);
    };

    hàm riêng tư xml giải thực thể(văn bản) {
        kết quả = "";
        i = 0;
        n = máy ảo lấy độ dài(văn bản);
        khi (i < n) {
            nếu (văn bản[i] != "&") {
                kết quả = kết quả + văn bản[i];
                i = i + 1;
            } hoặc {
                dấu chấm phẩy = tìm chuỗi chính xác(văn bản, ";", i + 1);
                nếu (dấu chấm phẩy == rỗng) {
                    ném "xml: thực thể chưa kết thúc";
                };
                thực thể = cắt chuỗi(văn bản, i + 1, dấu chấm phẩy - i - 1);
                nếu (thực thể == "amp") {
                    kết quả = kết quả + "&";
                } hoặc {
                    nếu (thực thể == "lt") {
                        kết quả = kết quả + "<";
                    } hoặc {
                        nếu (thực thể == "gt") {
                            kết quả = kết quả + ">";
                        } hoặc {
                            nếu (thực thể == "quot") {
                                kết quả = kết quả + "\"";
                            } hoặc {
                                nếu (thực thể == "apos") {
                                    kết quả = kết quả + "'";
                                } hoặc {
                                    nếu (máy ảo lấy độ dài(thực thể) > 0) {
                                        nếu (thực thể[0] == "#") {
                                            kết quả = kết quả + mình.xml thực thể số(thực thể);
                                        } hoặc {
                                            ném "xml: thực thể không được hỗ trợ: &" + thực thể + ";";
                                        };
                                    } hoặc {
                                        ném "xml: thực thể không được hỗ trợ: &;";
                                    };
                                };
                            };
                        };
                    };
                };
                i = dấu chấm phẩy + 1;
            };
        };
        trả về kết quả;
    };

    hàm riêng tư xml đọc thuộc tính có nháy(trạng thái) {
        nội dung = lấy từ điển(trạng thái, "nội dung", "");
        vị trí = lấy từ điển(trạng thái, "vị trí", 0);
        n = máy ảo lấy độ dài(nội dung);
        nếu (vị trí >= n) {
            mình.xml lỗi(trạng thái, "giá trị thuộc tính phải đặt trong dấu nháy");
        };
        nháy = nội dung[vị trí];
        nếu (nháy != "\"" && nháy != "'") {
            mình.xml lỗi(trạng thái, "giá trị thuộc tính phải đặt trong dấu nháy");
        };
        vị trí = vị trí + 1;
        bắt đầu = vị trí;
        đang đọc = đúng;
        khi (vị trí < n && đang đọc) {
            nếu (nội dung[vị trí] == nháy) {
                đang đọc = sai;
            } hoặc {
                vị trí = vị trí + 1;
            };
        };
        nếu (vị trí >= n) {
            đặt từ điển(trạng thái, "vị trí", vị trí);
            mình.xml lỗi(trạng thái, "thuộc tính chưa kết thúc");
        };
        đã mã hóa = cắt chuỗi(nội dung, bắt đầu, vị trí - bắt đầu);
        đặt từ điển(trạng thái, "vị trí", vị trí + 1);
        trả về mình.xml giải thực thể(đã mã hóa);
    };

    hàm riêng tư xml bỏ chú thích(trạng thái) {
        nội dung = lấy từ điển(trạng thái, "nội dung", "");
        vị trí = lấy từ điển(trạng thái, "vị trí", 0);
        kết thúc = tìm chuỗi chính xác(nội dung, "-->", vị trí + 4);
        nếu (kết thúc == rỗng) {
            mình.xml lỗi(trạng thái, "comment chưa kết thúc");
        };
        đặt từ điển(trạng thái, "vị trí", kết thúc + 3);
    };

    hàm riêng tư xml tạo nút phân tích cú pháp(tên, thuộc tính, nội dung, con) {
        trả về {
            "tên": tên,
            "thuộc tính": thuộc tính,
            "nội dung": nội dung,
            "con": con
        };
    };

    hàm riêng tư xml đọc phần tử(trạng thái, độ sâu) {
        nếu (độ sâu > 256) {
            ném "xml: cây vượt quá độ sâu 256";
        };
        nội dung = lấy từ điển(trạng thái, "nội dung", "");
        vị trí = lấy từ điển(trạng thái, "vị trí", 0);
        n = máy ảo lấy độ dài(nội dung);
        nếu (vị trí >= n) {
            mình.xml lỗi(trạng thái, "thiếu dấu <");
        };
        nếu (nội dung[vị trí] != "<") {
            mình.xml lỗi(trạng thái, "thiếu dấu <");
        };
        vị trí = vị trí + 1;
        đặt từ điển(trạng thái, "vị trí", vị trí);
        nếu (vị trí >= n) {
            mình.xml lỗi(trạng thái, "phần tử bắt đầu không hợp lệ");
        };
        c = nội dung[vị trí];
        nếu (c == "/" || c == "!" || c == "?") {
            mình.xml lỗi(trạng thái, "phần tử bắt đầu không hợp lệ");
        };

        tên = mình.xml đọc tên(trạng thái);
        thuộc tính = {};
        đã mở = sai;
        tự đóng = sai;
        khi (!đã mở && !tự đóng) {
            mình.xml bỏ khoảng trắng(trạng thái);
            vị trí = lấy từ điển(trạng thái, "vị trí", 0);
            nếu (vị trí >= n) {
                mình.xml lỗi(trạng thái, "phần tử chưa kết thúc");
            };
            nếu (mình.xml bắt đầu tại(trạng thái, "/>")) {
                đặt từ điển(trạng thái, "vị trí", vị trí + 2);
                tự đóng = đúng;
            } hoặc {
                nếu (nội dung[vị trí] == ">") {
                    đặt từ điển(trạng thái, "vị trí", vị trí + 1);
                    đã mở = đúng;
                } hoặc {
                    khóa = mình.xml đọc tên(trạng thái);
                    mình.xml bỏ khoảng trắng(trạng thái);
                    vị trí = lấy từ điển(trạng thái, "vị trí", 0);
                    nếu (vị trí >= n) {
                        mình.xml lỗi(trạng thái, "thiếu = sau thuộc tính");
                    };
                    nếu (nội dung[vị trí] != "=") {
                        mình.xml lỗi(trạng thái, "thiếu = sau thuộc tính");
                    };
                    đặt từ điển(trạng thái, "vị trí", vị trí + 1);
                    mình.xml bỏ khoảng trắng(trạng thái);
                    giá trị = mình.xml đọc thuộc tính có nháy(trạng thái);
                    đặt từ điển(thuộc tính, khóa, giá trị);
                };
            };
        };

        nếu (tự đóng) {
            trả về mình.xml tạo nút phân tích cú pháp(tên, thuộc tính, "", []);
        };

        văn bản = "";
        con = [];
        hoàn tất = sai;
        khi (!hoàn tất) {
            vị trí = lấy từ điển(trạng thái, "vị trí", 0);
            nếu (vị trí >= n) {
                mình.xml lỗi(trạng thái, "phần tử chưa đóng: " + tên);
            };

            nếu (mình.xml bắt đầu tại(trạng thái, "</")) {
                đặt từ điển(trạng thái, "vị trí", vị trí + 2);
                đóng = mình.xml đọc tên(trạng thái);
                mình.xml bỏ khoảng trắng(trạng thái);
                vị trí = lấy từ điển(trạng thái, "vị trí", 0);
                nếu (vị trí >= n) {
                    mình.xml lỗi(trạng thái, "thẻ đóng không hợp lệ");
                };
                nếu (nội dung[vị trí] != ">") {
                    mình.xml lỗi(trạng thái, "thẻ đóng không hợp lệ");
                };
                đặt từ điển(trạng thái, "vị trí", vị trí + 1);
                nếu (đóng != tên) {
                    mình.xml lỗi(trạng thái, "thẻ đóng không khớp " + tên);
                };
                hoàn tất = đúng;
            } hoặc {
                nếu (mình.xml bắt đầu tại(trạng thái, "<!--")) {
                    mình.xml bỏ chú thích(trạng thái);
                } hoặc {
                    nếu (mình.xml bắt đầu tại(trạng thái, "<![CDATA[")) {
                        kết thúc = tìm chuỗi chính xác(nội dung, "]]>", vị trí + 9);
                        nếu (kết thúc == rỗng) {
                            mình.xml lỗi(trạng thái, "CDATA chưa kết thúc");
                        };
                        văn bản = văn bản +
                            cắt chuỗi(nội dung, vị trí + 9, kết thúc - vị trí - 9);
                        đặt từ điển(trạng thái, "vị trí", kết thúc + 3);
                    } hoặc {
                        nếu (nội dung[vị trí] == "<") {
                            máy ảo thêm cuối danh sách(con, mình.xml đọc phần tử(trạng thái, độ sâu + 1));
                        } hoặc {
                            bắt đầu = vị trí;
                            đang đọc = đúng;
                            khi (vị trí < n && đang đọc) {
                                nếu (nội dung[vị trí] == "<") {
                                    đang đọc = sai;
                                } hoặc {
                                    vị trí = vị trí + 1;
                                };
                            };
                            đã mã hóa = cắt chuỗi(nội dung, bắt đầu, vị trí - bắt đầu);
                            văn bản = văn bản + mình.xml giải thực thể(đã mã hóa);
                            đặt từ điển(trạng thái, "vị trí", vị trí);
                        };
                    };
                };
            };
        };
        trả về mình.xml tạo nút phân tích cú pháp(tên, thuộc tính, văn bản, con);
    };

    hàm riêng tư xml tạo nội bộ(nút, độ sâu) {
        nếu (độ sâu > 256) {
            ném "xml: cây vượt quá độ sâu 256";
        };
        nếu (loại của(nút) != "từ điển") {
            ném "xml tạo: node phải là map";
        };

        tên = lấy từ điển(nút, "tên", rỗng);
        nếu (loại của(tên) != "chuỗi") {
            ném "xml tạo: node thiếu trường tên";
        };
        nếu (!mình.xml tên hợp lệ(tên)) {
            ném "xml tạo: tên phần tử không hợp lệ";
        };

        kết quả = "<" + tên;
        thuộc tính = lấy từ điển(nút, "thuộc tính", rỗng);
        nếu (thuộc tính != rỗng) {
            nếu (loại của(thuộc tính) != "từ điển") {
                ném "xml tạo: thuộc tính phải là map";
            };
            khóa = khóa từ điển(thuộc tính);
            lặp(i = 0; i < máy ảo lấy độ dài(khóa); i++) {
                tên thuộc tính = khóa[i];
                giá trị = lấy từ điển(thuộc tính, tên thuộc tính, rỗng);
                nếu (!mình.xml tên hợp lệ(tên thuộc tính) || loại của(giá trị) != "chuỗi") {
                    ném "xml tạo: thuộc tính không hợp lệ";
                };
                kết quả = kết quả + " " + tên thuộc tính + "=\"" +
                    mình.xml thoát thuộc tính(giá trị) + "\"";
            };
        };

        nội dung = lấy từ điển(nút, "nội dung", rỗng);
        nếu (nội dung == rỗng) {
            nội dung = "";
        } hoặc {
            nếu (loại của(nội dung) != "chuỗi") {
                ném "xml tạo: nội dung phải là chuỗi";
            };
        };

        con = lấy từ điển(nút, "con", rỗng);
        nếu (con == rỗng) {
            con = [];
        } hoặc {
            nếu (loại của(con) != "danh sách") {
                ném "xml tạo: con phải là danh sách";
            };
        };

        nếu (máy ảo lấy độ dài(nội dung) == 0 && máy ảo lấy độ dài(con) == 0) {
            trả về kết quả + "/>";
        };

        kết quả = kết quả + ">" + xml thoát(nội dung);
        lặp(i = 0; i < máy ảo lấy độ dài(con); i++) {
            kết quả = kết quả + mình.xml tạo nội bộ(con[i], độ sâu + 1);
        };
        trả về kết quả + "</" + tên + ">";
    };

    // Node trả về là map có các trường: tên, thuộc tính, nội dung, con.
    hàm công khai xml phân tích(nội dung) {
        nếu (loại của(nội dung) != "chuỗi") {
            ném "xml phân tích: nội dung phải là chuỗi";
        };
        nếu (chứa chính xác(nội dung, "<!DOCTYPE") ||
            chứa chính xác(nội dung, "<!ENTITY")) {
            ném "xml: DOCTYPE/thực thể ngoài bị vô hiệu hóa";
        };

        trạng thái = {"nội dung": nội dung, "vị trí": 0};
        mình.xml bỏ khoảng trắng(trạng thái);
        nếu (mình.xml bắt đầu tại(trạng thái, "<?xml")) {
            vị trí = lấy từ điển(trạng thái, "vị trí", 0);
            kết thúc = tìm chuỗi chính xác(nội dung, "?>", vị trí + 5);
            nếu (kết thúc == rỗng) {
                mình.xml lỗi(trạng thái, "khai báo XML chưa kết thúc");
            };
            đặt từ điển(trạng thái, "vị trí", kết thúc + 2);
            mình.xml bỏ khoảng trắng(trạng thái);
        };
        kết quả = mình.xml đọc phần tử(trạng thái, 0);
        mình.xml bỏ khoảng trắng(trạng thái);
        nếu (lấy từ điển(trạng thái, "vị trí", 0) != máy ảo lấy độ dài(nội dung)) {
            mình.xml lỗi(trạng thái, "dữ liệu dư sau phần tử gốc");
        };
        trả về kết quả;
    };

    hàm công khai xml tạo(nút) {
        trả về mình.xml tạo nội bộ(nút, 0);
    };
};

hàm công khai xml phân tích(nội dung) {
    bộ xử lý = Xử Lý Nội Bộ Xml();
    trả về bộ xử lý.xml phân tích(nội dung);
};

hàm công khai xml tạo(nút) {
    bộ xử lý = Xử Lý Nội Bộ Xml();
    trả về bộ xử lý.xml tạo(nút);
};
nhập gói/lõi/chuyển kiểu;
