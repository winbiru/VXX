// Thông số phân trang thuộc từng instance; helper gốc vẫn là API hàm.
nhập gói/dữ liệu/phân trang;

lớp công khai Bộ Phân Trang {
    hàm công khai khởi tạo(trang = 0, kích thước = 20) {
        mình.đặt trang(trang);
        mình.đặt kích thước(kích thước);
    };

    hàm công khai đặt trang(trang) {
        nếu (loại của(trang) != "số nguyên") { ném "phân trang: trang phải là số nguyên"; };
        mình.trang = trang hợp lệ(trang);
        trả về mình;
    };

    hàm công khai đặt kích thước(kích thước) {
        nếu (loại của(kích thước) != "số nguyên") {
            ném "phân trang: kích thước phải là số nguyên";
        };
        mình.kích thước = kích thước hợp lệ(kích thước);
        trả về mình;
    };

    hàm công khai số trang hiện tại() { trả về mình.trang; };
    hàm công khai số phần tử mỗi trang() { trả về mình.kích thước; };
    hàm công khai độ dời() { trả về độ dời dữ liệu(mình.trang, mình.kích thước); };
    hàm công khai tổng trang(tổng bản ghi) {
        trả về tổng số trang(tổng bản ghi, mình.kích thước);
    };
};
