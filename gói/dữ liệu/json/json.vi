// Module: mạng.json
// Mục đích: dựng, phân tích và tuần tự JSON an toàn, gồm object/array lồng nhau.

nhập gói.lõi.chuyển kiểu.*;
nhập gói.lõi.toán học.làm tròn xuống;
nhập gói.lõi.toán học.làm tròn;
nhập gói.bộ sưu tập.danh sách.thêm;
nhập gói.bộ sưu tập.từ điển.lấy từ điển;
nhập gói.bộ sưu tập.từ điển.đặt từ điển;
nhập gói.bộ sưu tập.từ điển.khóa từ điển;
nhập gói.lõi.bảng mã.bảng mã unicode tám bit độ dài đoạn;
nhập gói.lõi.bảng mã.mã hóa bảng mã;
nhập gói.lõi.bảng mã.giải mã bảng mã;
nhập gói.văn bản.chuỗi.độ dài;
nhập gói.văn bản.chuỗi.chuỗi thường;
nhập gói.văn bản.chuỗi.bỏ khoảng trắng;

// Lớp sở hữu toàn bộ thuật toán của mô-đun; các hàm bên dưới chỉ giữ API cũ.
lớp riêng tư Xử Lý Nội Bộ Json {
    hàm công khai khởi tạo() {};

    // Ghi chú hàm: escape một chuỗi UTF-8 hợp lệ theo JSON (quote, backslash và ký tự điều khiển).
    hàm công khai json thoát(giá trị) {
        văn bản = thành chuỗi(giá trị);
        kết quả = "";
        thập lục phân = "0123456789abcdef";

        lặp(i = 0; i < máy ảo lấy độ dài(văn bản); i++) {
            c = văn bản[i];
            nếu (c == "\"") {
                kết quả = kết quả + "\\\"";
            } hoặc {
                nếu (c == "\\") {
                    kết quả = kết quả + "\\\\";
                } hoặc {
                    // C0 control characters đều là một byte trong UTF-8. Dùng primitive
                    // bảng mã chỉ để lấy byte; quy tắc escape vẫn nằm hoàn toàn ở V++.
                    các byte = mã hóa bảng mã(c, "UTF-8");
                    nếu (máy ảo lấy độ dài(các byte) == 1 && các byte[0] < 32) {
                        mã = các byte[0];
                        nếu (mã == 8) {
                            kết quả = kết quả + "\\b";
                        } hoặc {
                            nếu (mã == 9) {
                                kết quả = kết quả + "\\t";
                            } hoặc {
                                nếu (mã == 10) {
                                    kết quả = kết quả + "\\n";
                                } hoặc {
                                    nếu (mã == 12) {
                                        kết quả = kết quả + "\\f";
                                    } hoặc {
                                        nếu (mã == 13) {
                                            kết quả = kết quả + "\\r";
                                        } hoặc {
                                            cao = 0;
                                            thấp = mã;
                                            nếu (thấp >= 16) {
                                                cao = 1;
                                                thấp = thấp - 16;
                                            };
                                            kết quả = kết quả + "\\u00" + thập lục phân[cao] + thập lục phân[thấp];
                                        };
                                    };
                                };
                            };
                        };
                    } hoặc {
                        kết quả = kết quả + c;
                    };
                };
            };
        };
        trả về kết quả;
    };

    // Ghi chú hàm: tạo literal JSON string, gồm cả dấu quote bao ngoài.
    hàm công khai json chuỗi(giá trị) {
        trả về "\"" + mình.json thoát(giá trị) + "\"";
    };

    hàm công khai json phân tích(nội dung) {
        bộ nội bộ = Bộ Xử Lý JSON();
        trả về bộ nội bộ.json phân tích(nội dung);
    };

    hàm công khai json tạo(giá trị) {
        bộ nội bộ = Bộ Xử Lý JSON();
        trả về bộ nội bộ.json tạo(giá trị);
    };

    // Ghi chú hàm: tạo một property JSON có giá trị chuỗi.
    hàm công khai json thuộc tính chuỗi(khóa, giá trị) {
        trả về mình.json chuỗi(khóa) + ":" + mình.json chuỗi(giá trị);
    };

    // Ghi chú hàm: tạo một property JSON với giá trị raw đã hợp lệ.
    hàm công khai json thuộc tính thô(khóa, giá trị raw) {
        trả về mình.json chuỗi(khóa) + ":" + giá trị raw;
    };

    // Ghi chú hàm: tạo object JSON rỗng.
    hàm công khai json đối tượng rỗng() {
        trả về "{}";
    };

    // Ghi chú hàm: tạo object JSON một property chuỗi.
    hàm công khai json đối tượng một chuỗi(khóa, giá trị) {
        trả về "{" + mình.json thuộc tính chuỗi(khóa, giá trị) + "}";
    };

    // Ghi chú hàm: tạo object JSON hai property chuỗi.
    hàm công khai json đối tượng hai chuỗi(khóa một, giá trị một, khóa hai, giá trị hai) {
        trả về "{" + mình.json thuộc tính chuỗi(khóa một, giá trị một) + "," + mình.json thuộc tính chuỗi(khóa hai, giá trị hai) + "}";
    };
};


hàm công khai json thoát(giá trị) {
    bộ chuyển tiếp = Xử Lý Nội Bộ Json();
    trả về bộ chuyển tiếp.json thoát(giá trị);
};

hàm công khai json chuỗi(giá trị) {
    bộ chuyển tiếp = Xử Lý Nội Bộ Json();
    trả về bộ chuyển tiếp.json chuỗi(giá trị);
};

// Các thuật toán và trợ giúp nằm trong lớp nội bộ, không được xuất qua import.
lớp riêng tư Bộ Xử Lý JSON {
    hàm công khai khởi tạo() {};

    // Bộ phân tích quét trực tiếp byte UTF-8 đã kiểm tra. Cú pháp JSON là ASCII,
    // nên vị trí byte tránh việc lập chỉ mục Unicode lặp lại trong mọi vòng nóng.
    // Chỉ dùng trên đường lỗi nên phép đếm điểm mã không ảnh hưởng đường nóng.
    // Nhờ vậy thông báo lỗi vẫn giữ vị trí ký tự như API trước đây.
    hàm riêng tư json vị trí ký tự(trạng thái) {
        các byte = trạng thái[3];
        giới hạn = trạng thái[1];
        vị trí byte = 0;
        vị trí ký tự = 0;
        n = máy ảo lấy độ dài(các byte);
        khi (vị trí byte < n && vị trí byte < giới hạn) {
            bước = 1;
            nếu (các byte[vị trí byte] >= 128) {
                bước = bảng mã unicode tám bit độ dài đoạn(các byte, vị trí byte);
                nếu (bước < 1) { bước = 1; };
            };
            vị trí byte += bước;
            vị trí ký tự += 1;
        };
        trả về vị trí ký tự;
    };

    hàm riêng tư json lỗi(trạng thái, thông báo) {
        vị trí = mình.json vị trí ký tự(trạng thái);
        ném "json phân tích: " + thông báo + " tại vị trí " + thành chuỗi(vị trí);
    };

    hàm riêng tư json bỏ khoảng trắng(trạng thái) {
        các byte = trạng thái[3];
        vị trí = trạng thái[1];
        n = máy ảo lấy độ dài(các byte);
        đang bỏ = đúng;
        khi (vị trí < n && đang bỏ) {
            c = các byte[vị trí];
            nếu (c == 32 || c == 9 || c == 13 || c == 10) {
                vị trí = vị trí + 1;
            } hoặc {
                đang bỏ = sai;
            };
        };
        trạng thái[1] = vị trí;
    };

    hàm riêng tư json đọc thập lục phân bốn chữ số(trạng thái) {
        các byte = trạng thái[3];
        vị trí = trạng thái[1];
        n = máy ảo lấy độ dài(các byte);
        nếu (vị trí + 4 > n) {
            mình.json lỗi(trạng thái, "escape Unicode thiếu chữ số");
        };
        giá trị = 0;
        hợp lệ = đúng;
        lặp(i = 0; i < 4 && hợp lệ; i++) {
            c = các byte[vị trí + i];
            nửa byte = -1;
            nếu (c >= 48 && c <= 57) {
                nửa byte = c - 48;
            } hoặc {
                nếu (c >= 97 && c <= 102) {
                    nửa byte = c - 87;
                } hoặc {
                    nếu (c >= 65 && c <= 70) {
                        nửa byte = c - 55;
                    };
                };
            };
            nếu (nửa byte < 0) {
                hợp lệ = sai;
            } hoặc {
                giá trị = giá trị * 16 + nửa byte;
            };
        };
        nếu (!hợp lệ) {
            mình.json lỗi(trạng thái, "escape Unicode không hợp lệ");
        };
        trạng thái[1] = vị trí + 4;
        trả về giá trị;
    };

    hàm riêng tư json ký tự mã(mã) {
        nếu (mã < 0 || mã > 1114111 || (mã >= 55296 && mã <= 57343)) {
            ném "json phân tích: code point Unicode không hợp lệ";
        };
        các byte = [];
        nếu (mã <= 127) {
            máy ảo thêm cuối danh sách(các byte, mã);
        } hoặc {
            nếu (mã <= 2047) {
                máy ảo thêm cuối danh sách(các byte, 192 + làm tròn xuống(mã / 64));
                máy ảo thêm cuối danh sách(các byte, 128 + mã % 64);
            } hoặc {
                nếu (mã <= 65535) {
                    máy ảo thêm cuối danh sách(các byte, 224 + làm tròn xuống(mã / 4096));
                    máy ảo thêm cuối danh sách(các byte, 128 + (làm tròn xuống(mã / 64) % 64));
                    máy ảo thêm cuối danh sách(các byte, 128 + mã % 64);
                } hoặc {
                    máy ảo thêm cuối danh sách(các byte, 240 + làm tròn xuống(mã / 262144));
                    máy ảo thêm cuối danh sách(các byte, 128 + (làm tròn xuống(mã / 4096) % 64));
                    máy ảo thêm cuối danh sách(các byte, 128 + (làm tròn xuống(mã / 64) % 64));
                    máy ảo thêm cuối danh sách(các byte, 128 + mã % 64);
                };
            };
        };
        trả về giải mã bảng mã(các byte, "UTF-8");
    };

    hàm riêng tư json đọc chuỗi(trạng thái) {
        nội dung = trạng thái[0];
        các byte = trạng thái[3];
        vị trí = trạng thái[1];
        n = máy ảo lấy độ dài(các byte);
        nếu (vị trí >= n) {
            mình.json lỗi(trạng thái, "thiếu chuỗi");
        };
        nếu (các byte[vị trí] != 34) {
            mình.json lỗi(trạng thái, "chuỗi phải bắt đầu bằng dấu nháy kép");
        };
        vị trí = vị trí + 1;
        trạng thái[1] = vị trí;

        // Chuỗi thông thường chỉ quét byte để tìm quote/backslash. Byte UTF-8
        // >= 128 không thể trùng ký tự cấu trúc ASCII nên không cần giải mã.
        bắt đầu = vị trí;
        đang quét = đúng;
        có thoát = sai;
        khi (vị trí < n && đang quét) {
            ký tự = các byte[vị trí];
            nếu (ký tự == 92) {
                có thoát = đúng;
                đang quét = sai;
            } hoặc {
                nếu (ký tự == 34) {
                    trạng thái[1] = vị trí + 1;
                    trả về mình.json đoạn nguồn(nội dung, bắt đầu, vị trí - bắt đầu);
                };
                nếu (ký tự < 32) {
                    trạng thái[1] = vị trí + 1;
                    mình.json lỗi(trạng thái, "chuỗi chứa ký tự điều khiển chưa escape");
                };
                vị trí = vị trí + 1;
            };
        };
        nếu (!có thoát) {
            trạng thái[1] = n;
            mình.json lỗi(trạng thái, "chuỗi chưa đóng");
        };
        vị trí = bắt đầu;
        trạng thái[1] = vị trí;

        kết quả = "";
        hoàn tất = sai;
        đầu đoạn = vị trí;
        khi (vị trí < n && !hoàn tất) {
            c = các byte[vị trí];
            nếu (c == 34) {
                nếu (vị trí > đầu đoạn) {
                    kết quả = kết quả + mình.json đoạn nguồn(nội dung, đầu đoạn, vị trí - đầu đoạn);
                };
                vị trí = vị trí + 1;
                trạng thái[1] = vị trí;
                hoàn tất = đúng;
            } hoặc {
                nếu (c == 92) {
                    nếu (vị trí > đầu đoạn) {
                        kết quả = kết quả + mình.json đoạn nguồn(nội dung, đầu đoạn, vị trí - đầu đoạn);
                    };
                    vị trí = vị trí + 1;
                    trạng thái[1] = vị trí;
                    nếu (vị trí >= n) {
                        mình.json lỗi(trạng thái, "escape chuỗi bị thiếu");
                    };
                    ký tự thoát = các byte[vị trí];
                    vị trí = vị trí + 1;
                    trạng thái[1] = vị trí;
                    nếu (ký tự thoát == 34 || ký tự thoát == 92 || ký tự thoát == 47) {
                        kết quả = kết quả + mình.json đoạn nguồn(nội dung, vị trí - 1, 1);
                    } hoặc {
                        nếu (ký tự thoát == 98) {
                            // Lexer V++ chưa hỗ trợ escape \b và \f trong literal.
                            kết quả = kết quả + chuỗi từ byte máy ảo([8]);
                        } hoặc {
                            nếu (ký tự thoát == 102) {
                                kết quả = kết quả + chuỗi từ byte máy ảo([12]);
                            } hoặc {
                                nếu (ký tự thoát == 110) {
                                    kết quả = kết quả + "\n";
                                } hoặc {
                                    nếu (ký tự thoát == 114) {
                                        kết quả = kết quả + "\r";
                                    } hoặc {
                                        nếu (ký tự thoát == 116) {
                                            kết quả = kết quả + "\t";
                                        } hoặc {
                                            nếu (ký tự thoát == 117) {
                                                đầu = mình.json đọc thập lục phân bốn chữ số(trạng thái);
                                                vị trí = trạng thái[1];
                                                nếu (đầu >= 55296 && đầu <= 56319) {
                                                    nếu (vị trí + 2 > n) {
                                                        mình.json lỗi(trạng thái, "surrogate cao thiếu surrogate thấp");
                                                    };
                                                    nếu (các byte[vị trí] != 92) {
                                                        mình.json lỗi(trạng thái, "surrogate cao thiếu surrogate thấp");
                                                    };
                                                    nếu (các byte[vị trí + 1] != 117) {
                                                        mình.json lỗi(trạng thái, "surrogate cao thiếu surrogate thấp");
                                                    };
                                                    trạng thái[1] = vị trí + 2;
                                                    thấp = mình.json đọc thập lục phân bốn chữ số(trạng thái);
                                                    nếu (thấp < 56320 || thấp > 57343) {
                                                        mình.json lỗi(trạng thái, "surrogate thấp không hợp lệ");
                                                    };
                                                    mã = 65536 + (đầu - 55296) * 1024 + (thấp - 56320);
                                                    kết quả = kết quả + mình.json ký tự mã(mã);
                                                } hoặc {
                                                    nếu (đầu >= 56320 && đầu <= 57343) {
                                                        mình.json lỗi(trạng thái, "surrogate thấp đứng một mình");
                                                    };
                                                    kết quả = kết quả + mình.json ký tự mã(đầu);
                                                };
                                                vị trí = trạng thái[1];
                                            } hoặc {
                                                mình.json lỗi(trạng thái, "escape chuỗi không hợp lệ");
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                    đầu đoạn = vị trí;
                } hoặc {
                    nếu (c < 32) {
                        trạng thái[1] = vị trí + 1;
                        mình.json lỗi(trạng thái, "chuỗi chứa ký tự điều khiển chưa escape");
                    };
                    vị trí = vị trí + 1;
                };
            };
        };
        nếu (!hoàn tất) {
            mình.json lỗi(trạng thái, "chuỗi chưa đóng");
        };
        trả về kết quả;
    };

    hàm riêng tư json đọc số(trạng thái) {
        nội dung = trạng thái[0];
        các byte = trạng thái[3];
        vị trí = trạng thái[1];
        n = máy ảo lấy độ dài(các byte);
        bắt đầu = vị trí;
        số thực = sai;

        âm = sai;
        số nguyên âm = 0;
        trong i32 = đúng;
        chữ số cuối = 7;

        nếu (các byte[vị trí] == 45) {
            âm = đúng;
            chữ số cuối = 8;
            vị trí = vị trí + 1;
        };
        nếu (vị trí >= n) {
            trạng thái[1] = vị trí;
            mình.json lỗi(trạng thái, "số thiếu chữ số");
        };

        nếu (các byte[vị trí] == 48) {
            vị trí = vị trí + 1;
        } hoặc {
            nếu (các byte[vị trí] < 49 || các byte[vị trí] > 57) {
                trạng thái[1] = vị trí;
                mình.json lỗi(trạng thái, "số không hợp lệ");
            };
            đang đọc = đúng;
            khi (vị trí < n && đang đọc) {
                c = các byte[vị trí];
                nếu (c >= 48 && c <= 57) {
                    chữ số = c - 48;
                    // Tích lũy số âm để giữ được -2147483648 mà không tràn.
                    nếu (trong i32) {
                        nếu (số nguyên âm < -214748364 ||
                            (số nguyên âm == -214748364 && chữ số > chữ số cuối)) {
                            trong i32 = sai;
                        } hoặc {
                            số nguyên âm = số nguyên âm * 10 - chữ số;
                        };
                    };
                    vị trí = vị trí + 1;
                } hoặc {
                    đang đọc = sai;
                };
            };
        };

        nếu (vị trí < n) {
            nếu (các byte[vị trí] == 46) {
                số thực = đúng;
                vị trí = vị trí + 1;
                nếu (vị trí >= n) {
                    trạng thái[1] = vị trí;
                    mình.json lỗi(trạng thái, "phần thập phân thiếu chữ số");
                };
                c = các byte[vị trí];
                nếu (c < 48 || c > 57) {
                    trạng thái[1] = vị trí;
                    mình.json lỗi(trạng thái, "phần thập phân thiếu chữ số");
                };
                đang đọc = đúng;
                khi (vị trí < n && đang đọc) {
                    c = các byte[vị trí];
                    nếu (c >= 48 && c <= 57) {
                        vị trí = vị trí + 1;
                    } hoặc {
                        đang đọc = sai;
                    };
                };
            };
        };

        nếu (vị trí < n) {
            nếu (các byte[vị trí] == 101 || các byte[vị trí] == 69) {
                số thực = đúng;
                vị trí = vị trí + 1;
                nếu (vị trí < n) {
                    nếu (các byte[vị trí] == 43 || các byte[vị trí] == 45) {
                        vị trí = vị trí + 1;
                    };
                };
                nếu (vị trí >= n) {
                    trạng thái[1] = vị trí;
                    mình.json lỗi(trạng thái, "số mũ thiếu chữ số");
                };
                c = các byte[vị trí];
                nếu (c < 48 || c > 57) {
                    trạng thái[1] = vị trí;
                    mình.json lỗi(trạng thái, "số mũ thiếu chữ số");
                };
                đang đọc = đúng;
                khi (vị trí < n && đang đọc) {
                    c = các byte[vị trí];
                    nếu (c >= 48 && c <= 57) {
                        vị trí = vị trí + 1;
                    } hoặc {
                        đang đọc = sai;
                    };
                };
            };
        };

        trạng thái[1] = vị trí;
        nếu (!số thực && trong i32) {
            nếu (âm) { trả về số nguyên âm; };
            trả về 0 - số nguyên âm;
        };
        văn bản = mình.json đoạn nguồn(nội dung, bắt đầu, vị trí - bắt đầu);
        nếu (số thực) {
            trả về thành số thực(văn bản);
        };
        // Opcode/slot/count của artifact đều là i32. Parse trực tiếp để không
        // chuyển hàng chục nghìn số nguyên qua binary64 rồi lại đổi về i32.
        // JSON integer ngoài biên i32 giữ cách biểu diễn số thực hiện hành.
        thử { trả về thành số nguyên(văn bản); }
        bắt lỗi(e) { };
        kết quả số = thành số thực(văn bản);
        nếu (kết quả số >= -2147483648.0 && kết quả số <= 2147483647.0) {
            trả về thành số nguyên(kết quả số);
        };
        trả về kết quả số;
    };

    hàm riêng tư json đọc mảng(trạng thái) {
        các byte = trạng thái[3];
        vị trí = trạng thái[1];
        n = máy ảo lấy độ dài(các byte);
        trạng thái[1] = vị trí + 1;
        mình.json bỏ khoảng trắng(trạng thái);
        vị trí = trạng thái[1];
        kết quả = [];

        nếu (vị trí < n) {
            nếu (các byte[vị trí] == 93) {
                trạng thái[1] = vị trí + 1;
                trả về kết quả;
            };
        };

        hoàn tất = sai;
        khi (!hoàn tất) {
            máy ảo thêm cuối danh sách(kết quả, mình.json đọc giá trị(trạng thái));
            mình.json bỏ khoảng trắng(trạng thái);
            vị trí = trạng thái[1];
            nếu (vị trí >= n) {
                mình.json lỗi(trạng thái, "mảng thiếu dấu ]");
            };
            c = các byte[vị trí];
            nếu (c == 93) {
                trạng thái[1] = vị trí + 1;
                hoàn tất = đúng;
            } hoặc {
                nếu (c != 44) {
                    mình.json lỗi(trạng thái, "mảng thiếu dấu phẩy");
                };
                trạng thái[1] = vị trí + 1;
                mình.json bỏ khoảng trắng(trạng thái);
            };
        };
        trả về kết quả;
    };

    hàm riêng tư json đọc đối tượng(trạng thái) {
        các byte = trạng thái[3];
        vị trí = trạng thái[1];
        n = máy ảo lấy độ dài(các byte);
        trạng thái[1] = vị trí + 1;
        mình.json bỏ khoảng trắng(trạng thái);
        vị trí = trạng thái[1];
        kết quả = {};

        nếu (vị trí < n) {
            nếu (các byte[vị trí] == 125) {
                trạng thái[1] = vị trí + 1;
                trả về kết quả;
            };
        };

        hoàn tất = sai;
        khi (!hoàn tất) {
            vị trí = trạng thái[1];
            nếu (vị trí >= n) {
                mình.json lỗi(trạng thái, "đối tượng thiếu khóa");
            };
            nếu (các byte[vị trí] != 34) {
                mình.json lỗi(trạng thái, "khóa đối tượng phải là chuỗi");
            };
            khóa = mình.json đọc chuỗi(trạng thái);
            mình.json bỏ khoảng trắng(trạng thái);

            vị trí = trạng thái[1];
            nếu (vị trí >= n) {
                mình.json lỗi(trạng thái, "đối tượng thiếu dấu hai chấm");
            };
            nếu (các byte[vị trí] != 58) {
                mình.json lỗi(trạng thái, "đối tượng thiếu dấu hai chấm");
            };
            trạng thái[1] = vị trí + 1;
            mình.json bỏ khoảng trắng(trạng thái);
            đặt từ điển(kết quả, khóa, mình.json đọc giá trị(trạng thái));
            mình.json bỏ khoảng trắng(trạng thái);

            vị trí = trạng thái[1];
            nếu (vị trí >= n) {
                mình.json lỗi(trạng thái, "đối tượng thiếu dấu }");
            };
            c = các byte[vị trí];
            nếu (c == 125) {
                trạng thái[1] = vị trí + 1;
                hoàn tất = đúng;
            } hoặc {
                nếu (c != 44) {
                    mình.json lỗi(trạng thái, "đối tượng thiếu dấu phẩy");
                };
                trạng thái[1] = vị trí + 1;
                mình.json bỏ khoảng trắng(trạng thái);
            };
        };
        trả về kết quả;
    };

    hàm riêng tư json đọc giá trị(trạng thái) {
        mình.json bỏ khoảng trắng(trạng thái);
        các byte = trạng thái[3];
        vị trí = trạng thái[1];
        n = máy ảo lấy độ dài(các byte);
        nếu (vị trí >= n) {
            mình.json lỗi(trạng thái, "thiếu giá trị");
        };

        c = các byte[vị trí];
        nếu (c == 34) {
            trả về mình.json đọc chuỗi(trạng thái);
        };
        nếu (c == 123) {
            trả về mình.json đọc đối tượng(trạng thái);
        };
        nếu (c == 91) {
            trả về mình.json đọc mảng(trạng thái);
        };
        nếu (c == 116) {
            nếu (vị trí + 4 <= n && các byte[vị trí + 1] == 114 &&
                các byte[vị trí + 2] == 117 && các byte[vị trí + 3] == 101) {
                trạng thái[1] = vị trí + 4;
                tạo boolean = trạng thái[2];
                nếu (tạo boolean != rỗng) { trả về tạo boolean(đúng); };
                trả về đúng;
            };
            mình.json lỗi(trạng thái, "literal không hợp lệ");
        };
        nếu (c == 102) {
            nếu (vị trí + 5 <= n && các byte[vị trí + 1] == 97 &&
                các byte[vị trí + 2] == 108 && các byte[vị trí + 3] == 115 &&
                các byte[vị trí + 4] == 101) {
                trạng thái[1] = vị trí + 5;
                tạo boolean = trạng thái[2];
                nếu (tạo boolean != rỗng) { trả về tạo boolean(sai); };
                trả về sai;
            };
            mình.json lỗi(trạng thái, "literal không hợp lệ");
        };
        nếu (c == 110) {
            nếu (vị trí + 4 <= n && các byte[vị trí + 1] == 117 &&
                các byte[vị trí + 2] == 108 && các byte[vị trí + 3] == 108) {
                trạng thái[1] = vị trí + 4;
                trả về rỗng;
            };
            mình.json lỗi(trạng thái, "literal không hợp lệ");
        };
        nếu (c == 45 || (c >= 48 && c <= 57)) {
            trả về mình.json đọc số(trạng thái);
        };
        mình.json lỗi(trạng thái, "giá trị không hợp lệ");
    };

    // Danh sách byte vừa dùng để kiểm tra UTF-8 vừa trở thành view nguồn của
    // parser, tránh cấp phát rồi bỏ đi trước khi lại lập chỉ mục chuỗi.
    hàm riêng tư json kiểm tra utf8(văn bản) {
        các byte = chuỗi thành byte máy ảo(văn bản);
        vị trí = 0;
        n = máy ảo lấy độ dài(các byte);
        khi (vị trí < n) {
            bước = 1;
            nếu (các byte[vị trí] >= 128) {
                bước = bảng mã unicode tám bit độ dài đoạn(các byte, vị trí);
                nếu (bước < 1) { ném "json phân tích: UTF-8 không hợp lệ"; };
            };
            vị trí += bước;
        };
        trả về các byte;
    };

    hàm riêng tư json đoạn nguồn(ký tự, vị trí, n) {
        trả về máy ảo cắt chuỗi theo byte(ký tự, vị trí, n);
    };

    hàm công khai json phân tích(nội dung) {
        nếu (loại của(nội dung) != "chuỗi") {
            ném "json phân tích: nội dung phải là chuỗi";
        };
        trả về mình.json phân tích với boolean(nội dung, rỗng);
    };

    // Hàm tạo tùy chọn giúp giữ riêng boolean JSON khi lược đồ dữ liệu cần
    // phân biệt true/false với số nguyên 1/0 thông thường của V++.
    hàm công khai json phân tích với boolean(nội dung, tạo boolean) {
        nếu (loại của(nội dung) != "chuỗi") { ném "json phân tích: nội dung phải là chuỗi"; };
        các byte = mình.json kiểm tra utf8(nội dung);
        // Bốn ô cố định: [chuỗi nguồn, vị trí byte, hàm tạo boolean, byte nguồn].
        trạng thái = [nội dung, 0, tạo boolean, các byte];
        kết quả = mình.json đọc giá trị(trạng thái);
        mình.json bỏ khoảng trắng(trạng thái);
        nếu (trạng thái[1] != máy ảo lấy độ dài(các byte)) {
            mình.json lỗi(trạng thái, "còn dữ liệu sau giá trị JSON");
        };
        trả về kết quả;
    };

    // Tuần tự map/list/tuple/scalar runtime thành JSON UTF-8 hợp lệ.
    // Khóa object được ghi theo thứ tự từ điển để output xác định giữa các nền tảng.
    hàm riêng tư json đang hoạt động(đang xử lý, giá trị) {
        lặp(i = 0; i < máy ảo lấy độ dài(đang xử lý); i++) {
            nếu (đang xử lý[i] == giá trị) {
                trả về đúng;
            };
        };
        trả về sai;
    };

    hàm riêng tư json tạo nội bộ(giá trị, đang xử lý) {
        kiểu = loại của(giá trị);

        nếu (kiểu == "số nguyên") {
            trả về thành chuỗi(giá trị);
        };
        nếu (kiểu == "số thực") {
            thô = thành chuỗi(giá trị);
            kiểm tra = chuỗi thường(thô);
            nếu (kiểm tra == "nan" || kiểm tra == "inf" || kiểm tra == "-inf" ||
                kiểm tra == "infinity" || kiểm tra == "-infinity") {
                ném "json tạo: JSON không hỗ trợ NaN hoặc vô cực";
            };
            trả về thô;
        };
        nếu (kiểu == "chuỗi") {
            trả về json chuỗi(giá trị);
        };
        nếu (kiểu == "rỗng") {
            trả về "null";
        };
        nếu (kiểu == "lớp" || kiểu == "đối tượng" || kiểu == "hàm") {
            ném "json tạo: không hỗ trợ lớp hoặc đối tượng runtime";
        };

        nếu (kiểu != "danh sách" && kiểu != "tuple" && kiểu != "từ điển") {
            ném "json tạo: không hỗ trợ lớp hoặc đối tượng runtime";
        };
        nếu (mình.json đang hoạt động(đang xử lý, giá trị)) {
            ném "json tạo: phát hiện collection tự tham chiếu";
        };
        máy ảo thêm cuối danh sách(đang xử lý, giá trị);

        kết quả = "";
        nếu (kiểu == "danh sách" || kiểu == "tuple") {
            kết quả = "[";
            lặp(i = 0; i < máy ảo lấy độ dài(giá trị); i++) {
                nếu (i > 0) {
                    kết quả = kết quả + ",";
                };
                kết quả = kết quả + mình.json tạo nội bộ(giá trị[i], đang xử lý);
            };
            kết quả = kết quả + "]";
        } hoặc {
            khóa = khóa từ điển(giá trị);
            kết quả = "{";
            lặp(i = 0; i < máy ảo lấy độ dài(khóa); i++) {
                nếu (i > 0) {
                    kết quả = kết quả + ",";
                };
                tên = khóa[i];
                kết quả = kết quả + json chuỗi(tên) + ":" +
                    mình.json tạo nội bộ(lấy từ điển(giá trị, tên, rỗng), đang xử lý);
            };
            kết quả = kết quả + "}";
        };

        máy ảo xóa vị trí danh sách(đang xử lý, máy ảo lấy độ dài(đang xử lý) - 1);
        trả về kết quả;
    };

    hàm công khai json tạo(giá trị) {
        trả về mình.json tạo nội bộ(giá trị, []);
    };
};

hàm công khai json phân tích(nội dung) {
    bộ chuyển tiếp = Xử Lý Nội Bộ Json();
    trả về bộ chuyển tiếp.json phân tích(nội dung);
};

hàm công khai json phân tích với boolean(nội dung, tạo boolean) {
    bộ chuyển tiếp = Bộ Xử Lý JSON();
    trả về bộ chuyển tiếp.json phân tích với boolean(nội dung, tạo boolean);
};

// Tài liệu giữ kết quả đã parse, nạp lỗi không làm mất tài liệu trước đó.
lớp công khai Tài Liệu JSON {
    hàm công khai khởi tạo(văn bản) { mình.nạp(văn bản); };
    hàm công khai nạp(văn bản) {
        mới = json phân tích(văn bản);
        mình.dữ liệu = mới;
        trả về mình;
    };
    hàm công khai giá trị() { trả về mình.dữ liệu; };
    hàm công khai văn bản() { trả về json tạo(mình.dữ liệu); };
    hàm công khai lấy(khóa, mặc định = rỗng) {
        nếu (loại của(mình.dữ liệu) != "từ điển") { ném "json: tài liệu không phải đối tượng"; };
        trả về lấy từ điển(mình.dữ liệu, khóa, mặc định);
    };
};

hàm công khai json tạo(giá trị) {
    bộ chuyển tiếp = Xử Lý Nội Bộ Json();
    trả về bộ chuyển tiếp.json tạo(giá trị);
};

hàm công khai json thuộc tính chuỗi(khóa, giá trị) {
    bộ chuyển tiếp = Xử Lý Nội Bộ Json();
    trả về bộ chuyển tiếp.json thuộc tính chuỗi(khóa, giá trị);
};

hàm công khai json thuộc tính thô(khóa, giá trị raw) {
    bộ chuyển tiếp = Xử Lý Nội Bộ Json();
    trả về bộ chuyển tiếp.json thuộc tính thô(khóa, giá trị raw);
};

hàm công khai json đối tượng rỗng() {
    bộ chuyển tiếp = Xử Lý Nội Bộ Json();
    trả về bộ chuyển tiếp.json đối tượng rỗng();
};

hàm công khai json đối tượng một chuỗi(khóa, giá trị) {
    bộ chuyển tiếp = Xử Lý Nội Bộ Json();
    trả về bộ chuyển tiếp.json đối tượng một chuỗi(khóa, giá trị);
};

hàm công khai json đối tượng hai chuỗi(khóa một, giá trị một, khóa hai, giá trị hai) {
    bộ chuyển tiếp = Xử Lý Nội Bộ Json();
    trả về bộ chuyển tiếp.json đối tượng hai chuỗi(khóa một, giá trị một, khóa hai, giá trị hai);
};
