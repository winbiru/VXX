hàm tập hợp(ds) {
    ném "stdlib: tập hợp native hook không khả dụng";
};

hàm hợp tập(a, b) {
    ném "stdlib: hợp tập native hook không khả dụng";
};

hàm giao tập(a, b) {
    ném "stdlib: giao tập native hook không khả dụng";
};

hàm rời nhau(a, b) {
    ném "stdlib: rời nhau native hook không khả dụng";
};
