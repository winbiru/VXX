// Ghi chú hàm: khởi động server theo thông tin do project truyền từ main.
hàm app chạy máy chủ từ cấu hình project(tên ứng dụng, cổng, đườngDẫnCấuHình, healthPath, loginPath, adminUsersPath, adminUsersSearchPath) {
    configPath = đườngDẫnCấuHình;
    nếu (configPath == "") {
        configPath = app đường dẫn cấu hình api project();
    };
    cổng chạy = cổng;
    nếu (cổng chạy == "") {
        cổng chạy = app cổng từ cấu hình(configPath);
    };

    jdbcUrl = app datasource url từ cấu hình(configPath);
    driver = app datasource driver từ cấu hình(configPath);
    username = app datasource username từ cấu hình(configPath);
    password = app datasource password từ cấu hình(configPath);
    authToken = app auth token từ cấu hình(configPath);
    refreshToken = app refresh token từ cấu hình(configPath);

    nếu (cổng chạy == "") {
        trả về "APP_ERR|missing-port";
    };
    nếu (jdbcUrl == "") {
        trả về "APP_ERR|missing-jdbc-url";
    };
    nếu (driver == "") {
        trả về "APP_ERR|missing-driver";
    };
    nếu (authToken == "") {
        trả về "APP_ERR|missing-auth-token";
    };
    nếu (refreshToken == "") {
        trả về "APP_ERR|missing-refresh-token";
    };
    nếu (healthPath == "") {
        trả về "APP_ERR|missing-route-health";
    };
    nếu (loginPath == "") {
        trả về "APP_ERR|missing-route-login";
    };
    nếu (adminUsersPath == "") {
        trả về "APP_ERR|missing-route-users";
    };
    nếu (adminUsersSearchPath == "") {
        trả về "APP_ERR|missing-route-users-search";
    };

    app in khởi động vpp(tên ứng dụng, cổng chạy, jdbcUrl);
    in app json health();
    app chạy máy chủ api(cổng chạy, driver, jdbcUrl, username, password, authToken, refreshToken, healthPath, loginPath, adminUsersPath, adminUsersSearchPath);
    app in tắt vpp(tên ứng dụng);
    trả về 0;
};
