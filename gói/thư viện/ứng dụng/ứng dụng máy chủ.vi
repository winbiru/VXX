// Module: thư viện.ứng dụng.ứng dụng máy chủ
// Mục đích: helper vòng đời ứng dụng và JSON contract kiểu V++.

nhập gói/thư viện/mạng/rest.vi;
nhập gói/thư viện/mạng/mạng web.vi;
nhập gói/thư viện/dữ liệu/kết nối cơ sở dữ liệu.vi;
nhập gói/thư viện/cấu hình/cấu hình.vi;

// Ghi chú hàm: in log khởi động ứng dụng kiểu V++.
hàm app in khởi động vpp(tên ứng dụng, cổng, datasource) {
    in ":: " + tên ứng dụng + " ::";
    in "(V++ style startup)";
    in "Datasource: " + datasource;
    in "Tomcat started on port(s): " + cổng + " (http) with context path ''";
    in "Started ApiProjectApplication in 0.000 seconds";
    in "Press Ctrl+C to stop";
    trả về 1;
};

// Ghi chú hàm: in log tắt ứng dụng kiểu V++.
hàm app in tắt vpp(tên ứng dụng) {
    in "Stopping " + tên ứng dụng;
    trả về 0;
};

// Ghi chú hàm: JSON health chuẩn actuator.
hàm app json health() {
    trả về rest json thành công object("UP", "{\"status\":\"UP\"}");
};

// Ghi chú hàm: JSON đăng nhập thành công với token JWT.
hàm app json login thành công(token, refreshToken) {
    trả về rest json thành công jwt("Đăng nhập thành công", token, refreshToken);
};

// Ghi chú hàm: JSON lỗi thiếu thông tin đăng nhập.
hàm app json missing credentials(requestId) {
    trả về rest json lỗi("missing-credentials", requestId);
};

// Ghi chú hàm: JSON lỗi thiếu token.
hàm app json missing token(requestId) {
    trả về rest json lỗi("missing-token", requestId);
};

// Ghi chú hàm: JSON lỗi token không hợp lệ.
hàm app json invalid token(requestId) {
    trả về rest json lỗi("invalid-token", requestId);
};

// Ghi chú hàm: JSON lỗi thiếu keyword tìm kiếm.
hàm app json missing keyword(requestId) {
    trả về rest json lỗi("missing-keyword", requestId);
};

// Ghi chú hàm: JSON lỗi thiếu username khi tạo user.
hàm app json missing username(requestId) {
    trả về rest json lỗi("missing-username", requestId);
};

// Ghi chú hàm: JSON lỗi user không tồn tại.
hàm app json user not found(requestId) {
    trả về rest json lỗi("user-not-found", requestId);
};

// Ghi chú hàm: JSON lỗi database chưa kết nối.
hàm app json db not connected(requestId) {
    trả về rest json lỗi("db-not-connected", requestId);
};

// Ghi chú hàm: JSON lỗi resource không tồn tại.
hàm app json not found(requestId) {
    trả về rest json lỗi("not-found", requestId);
};

// Ghi chú hàm: JSON danh sách users theo contract API project.
hàm app json users(requestId, usersJsonArray) {
    dataJson = "{\"requestId\":\"" + requestId + "\",\"users\":" + usersJsonArray + "}";
    trả về rest json thành công object("Thành công", dataJson);
};

// Ghi chú hàm: JSON thành công với value chuỗi theo contract cũ của api_project.
hàm app json value(message, requestId, value) {
    dataJson = "{\"requestId\":\"" + requestId + "\",\"value\":\"" + value + "\"}";
    trả về rest json thành công object(message, dataJson);
};

// Ghi chú hàm: JSON lỗi chuẩn có requestId.
hàm app json error(message, requestId) {
    trả về rest json lỗi(message, requestId);
};

// Ghi chú hàm: JSON tạo user thành công.
hàm app json created user(requestId) {
    trả về app json value("Tạo mới thành công", requestId, "created-user");
};

// Ghi chú hàm: JSON cập nhật user thành công.
hàm app json updated user(requestId) {
    trả về app json value("Thành công", requestId, "updated-user");
};

// Ghi chú hàm: JSON xóa user thành công.
hàm app json deleted user(requestId) {
    trả về app json value("Xóa thành công", requestId, "deleted");
};

// Ghi chú hàm: JSON kết quả bootstrap database.
hàm app json db bootstrap(result) {
    dataJson = "{\"requestId\":\"db-bootstrap\",\"result\":\"" + result + "\"}";
    trả về rest json thành công object("Khởi tạo kết nối", dataJson);
};

// Ghi chú hàm: JSON kết quả shutdown database.
hàm app json db shutdown(result) {
    dataJson = "{\"requestId\":\"db-shutdown\",\"result\":\"" + result + "\"}";
    trả về rest json thành công object("Đóng kết nối", dataJson);
};

// Ghi chú hàm: chuẩn bị DB schema + seed cho API trước khi mở server.
hàm app chuẩn bị dữ liệu api(driver, jdbcUrl, username, password) {
    connectRes = db_ket_noi(driver, jdbcUrl, username, password);
    nếu (connectRes != "DB_OK|connected") {
        trả về connectRes;
    };

    createRes = db_truy_van(
        driver,
        jdbcUrl,
        username,
        password,
        "CREATE TABLE IF NOT EXISTS users (id INT AUTO_INCREMENT PRIMARY KEY, username VARCHAR(120) UNIQUE, first_names VARCHAR(255), last_name VARCHAR(255), email VARCHAR(255), phone_number VARCHAR(50), city VARCHAR(100), country VARCHAR(100), is_active INT DEFAULT 1, created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP, updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP);"
    );
    nếu (createRes == "DB_ERR|not-connected") {
        trả về createRes;
    };

    countRes = db_truy_van(driver, jdbcUrl, username, password, "SELECT COUNT(*) FROM users;");
    nếu (countRes == "DB_OK|0") {
        seedRes = db_truy_van(
            driver,
            jdbcUrl,
            username,
            password,
            "INSERT INTO users(username, first_names, last_name, email, phone_number, city, country, is_active) VALUES ('an','An','Nguyen','an@example.com','0900000001','HCM','VN',1),('binh','Binh','Tran','binh@example.com','0900000002','HN','VN',1),('chi','Chi','Le','chi@example.com','0900000003','DN','VN',1);"
        );
        nếu (seedRes == "DB_ERR|not-connected") {
            trả về seedRes;
        };
    };

    trả về "DB_OK|prepared";
};

// Ghi chú hàm: chạy server HTTP native cho API project.
hàm app chạy máy chủ api(cổng, driver, jdbcUrl, username, password, authToken, refreshToken, healthPath, loginPath, adminUsersPath, adminUsersSearchPath) {
    prepRes = app chuẩn bị dữ liệu api(driver, jdbcUrl, username, password);
    nếu (prepRes == "DB_ERR|not-connected") {
        trả về prepRes;
    };

    serverId = mạng mở máy chủ api(cổng);
    lặp(i = 0; i < 2147483647; i = i + 1) {
        requestId = mạng lấy yêu cầu kế tiếp(serverId);
        nếu (requestId == "") {
            bỏ qua;
        };

        method = mạng method yêu cầu(requestId);
        path = mạng path yêu cầu(requestId);
        auth = mạng header yêu cầu(requestId, "authorization");
        expectedAuth = "Bearer " + authToken;
        adminUsersIdPrefix = adminUsersPath + "/";

        status = 200;
        response = app json not found(requestId);

        nếu (method == "GET") {
            nếu (path == healthPath) {
                status = 200;
                response = app json health();
            };
        };

        nếu (method == "POST") {
            nếu (path == loginPath) {
                usernameBody = mạng json field yêu cầu(requestId, "username");
                passwordBody = mạng json field yêu cầu(requestId, "password");
                missingCred = sai;
                nếu (usernameBody == "") {
                    missingCred = đúng;
                };
                nếu (passwordBody == "") {
                    missingCred = đúng;
                };
                nếu (missingCred) {
                    status = 400;
                    response = app json missing credentials(requestId);
                } hoặc {
                    status = 200;
                    response = app json login thành công(authToken, refreshToken);
                };
            };
        };

        protectedApi = sai;
        nếu (path == adminUsersPath) {
            protectedApi = đúng;
        };
        nếu (path == adminUsersSearchPath) {
            protectedApi = đúng;
        };
        nếu (mạng path suffix yêu cầu(requestId, adminUsersIdPrefix) != "") {
            protectedApi = đúng;
        };
        nếu (protectedApi) {
            nếu (auth == "") {
                status = 401;
                response = app json missing token(requestId);
            } hoặc {
                nếu (auth != expectedAuth) {
                    status = 401;
                    response = app json invalid token(requestId);
                };
            };
        };

        nếu (status == 200) {
            nếu (method == "GET") {
                nếu (path == adminUsersPath) {
                    rows = db_truy_van(driver, jdbcUrl, username, password, "SELECT username FROM users ORDER BY username;");
                    usersJson = "[]";
                    nếu (rows == "DB_OK|an binh chi") {
                        usersJson = "[\"an\",\"binh\",\"chi\"]";
                    };
                    nếu (rows == "DB_OK|binh chi") {
                        usersJson = "[\"binh\",\"chi\"]";
                    };
                    nếu (rows == "DB_OK|an binh") {
                        usersJson = "[\"an\",\"binh\"]";
                    };
                    nếu (rows == "DB_OK|an chi") {
                        usersJson = "[\"an\",\"chi\"]";
                    };
                    nếu (rows == "DB_OK|an") {
                        usersJson = "[\"an\"]";
                    };
                    nếu (rows == "DB_OK|binh") {
                        usersJson = "[\"binh\"]";
                    };
                    nếu (rows == "DB_OK|chi") {
                        usersJson = "[\"chi\"]";
                    };
                    nếu (rows == "DB_ERR|not-connected") {
                        status = 500;
                        response = app json db not connected(requestId);
                    } hoặc {
                        response = app json users(requestId, usersJson);
                    };
                };

                nếu (path == adminUsersSearchPath) {
                    keyword = mạng query param yêu cầu(requestId, "keyword");
                    nếu (keyword == "") {
                        status = 400;
                        response = app json missing keyword(requestId);
                    } hoặc {
                        sql = "SELECT username FROM users WHERE username LIKE '%" + keyword + "%' OR first_names LIKE '%" + keyword + "%' OR last_name LIKE '%" + keyword + "%' ORDER BY username;";
                        rows = db_truy_van(driver, jdbcUrl, username, password, sql);
                        usersJson = "[]";
                        nếu (rows == "DB_OK|an binh chi") {
                            usersJson = "[\"an\",\"binh\",\"chi\"]";
                        };
                        nếu (rows == "DB_OK|an") {
                            usersJson = "[\"an\"]";
                        };
                        nếu (rows == "DB_OK|binh") {
                            usersJson = "[\"binh\"]";
                        };
                        nếu (rows == "DB_OK|chi") {
                            usersJson = "[\"chi\"]";
                        };
                        nếu (rows == "DB_OK|binh chi") {
                            usersJson = "[\"binh\",\"chi\"]";
                        };
                        nếu (rows == "DB_ERR|not-connected") {
                            status = 500;
                            response = app json db not connected(requestId);
                        } hoặc {
                            response = app json users(requestId, usersJson);
                        };
                    };
                };
            };
        };

        nếu (status == 200) {
            nếu (method == "POST") {
                nếu (path == adminUsersPath) {
                    usernameNew = mạng json field yêu cầu(requestId, "username");
                    nếu (usernameNew == "") {
                        status = 400;
                        response = app json missing username(requestId);
                    } hoặc {
                        firstNames = mạng json field yêu cầu(requestId, "first_names");
                        lastName = mạng json field yêu cầu(requestId, "last_name");
                        email = mạng json field yêu cầu(requestId, "email");
                        sql = "INSERT INTO users(username, first_names, last_name, email, phone_number, city, country, is_active) VALUES ('" + usernameNew + "','" + firstNames + "','" + lastName + "','" + email + "','','','',1);";
                        dbRes = db_truy_van(driver, jdbcUrl, username, password, sql);
                        nếu (dbRes == "DB_ERR|not-connected") {
                            status = 500;
                            response = app json db not connected(requestId);
                        } hoặc {
                            status = 201;
                            response = app json created user(requestId);
                        };
                    };
                };
            };
        };

        idSuffix = mạng path suffix yêu cầu(requestId, adminUsersIdPrefix);
        nếu (status == 200) {
            nếu (idSuffix != "") {
                nếu (method == "DELETE") {
                    countRes = db_truy_van(driver, jdbcUrl, username, password, "SELECT COUNT(*) FROM users WHERE id=" + idSuffix + ";");
                    nếu (countRes == "DB_OK|0") {
                        status = 404;
                        response = app json user not found(requestId);
                    } hoặc {
                        delRes = db_truy_van(driver, jdbcUrl, username, password, "DELETE FROM users WHERE id=" + idSuffix + ";");
                        nếu (delRes == "DB_ERR|not-connected") {
                            status = 500;
                            response = app json db not connected(requestId);
                        } hoặc {
                            status = 200;
                            response = app json deleted user(requestId);
                        };
                    };
                };

                nếu (method == "PUT") {
                    countRes = db_truy_van(driver, jdbcUrl, username, password, "SELECT COUNT(*) FROM users WHERE id=" + idSuffix + ";");
                    nếu (countRes == "DB_OK|0") {
                        status = 404;
                        response = app json user not found(requestId);
                    } hoặc {
                        usernameNew = mạng json field yêu cầu(requestId, "username");
                        firstNames = mạng json field yêu cầu(requestId, "first_names");
                        lastName = mạng json field yêu cầu(requestId, "last_name");
                        email = mạng json field yêu cầu(requestId, "email");
                        sql = "UPDATE users SET username=IF('" + usernameNew + "'='',username,'" + usernameNew + "'),first_names=IF('" + firstNames + "'='',first_names,'" + firstNames + "'),last_name=IF('" + lastName + "'='',last_name,'" + lastName + "'),email=IF('" + email + "'='',email,'" + email + "') WHERE id=" + idSuffix + ";";
                        updRes = db_truy_van(driver, jdbcUrl, username, password, sql);
                        nếu (updRes == "DB_ERR|not-connected") {
                            status = 500;
                            response = app json db not connected(requestId);
                        } hoặc {
                            status = 200;
                            response = app json updated user(requestId);
                        };
                    };
                };
            };
        };

        mạng trả phản hồi(requestId, status, response);
    };

    mạng đóng máy chủ api(serverId);
    trả về "DB_OK|server-stopped";
};

// Ghi chú hàm: đường dẫn cấu hình mặc định cho api_project.
hàm app đường dẫn cấu hình api project() {
    candidate = "src/tests/api_project/application.properties";
    probe = đọc cấu hình khóa(candidate, "url", "");
    nếu (probe != "") {
        trả về candidate;
    };

    candidate = "api_project/application.properties";
    probe = đọc cấu hình khóa(candidate, "url", "");
    nếu (probe != "") {
        trả về candidate;
    };

    candidate = "application.properties";
    probe = đọc cấu hình khóa(candidate, "url", "");
    nếu (probe != "") {
        trả về candidate;
    };

    trả về "src/tests/api_project/application.properties";
};

// Ghi chú hàm: nạp cổng server từ properties.
hàm app cổng từ cấu hình(đường dẫn cấu hình) {
    value = đọc cấu hình khóa(đường dẫn cấu hình, "port", "");
    nếu (value != "") {
        trả về value;
    };
    value = đọc cấu hình khóa(đường dẫn cấu hình, "server.port", "");
    nếu (value != "") {
        trả về value;
    };
    value = đọc cấu hình khóa(đường dẫn cấu hình, "vpp.server.port", "");
    trả về value;
};

