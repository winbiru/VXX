// Module: thư viện.vào ra.nhật ký
// Mục đích: chuẩn hóa định dạng log theo mức thông tin/cảnh báo/lỗi.
// Ghi chú: cung cấp cả class `NhậtKý` và wrapper hàm mức module.

lớp công khai NhậtKý {
    // Ghi chú hàm: công khai ghi thông tin.
    hàm công khai ghi thông tin(msg) {
        in "[THÔNG TIN] " + msg;
        trả về 0;
    };

    // Ghi chú hàm: công khai ghi cảnh báo.
    hàm công khai ghi cảnh báo(msg) {
        in "[CẢNH BÁO] " + msg;
        trả về 0;
    };

    // Ghi chú hàm: công khai ghi lỗi.
    hàm công khai ghi lỗi(msg) {
        in "[LỖI] " + msg;
        trả về 0;
    };
};

// Ghi chú hàm: ghi thông tin.
hàm ghi thông tin(msg) {
    trả về NhậtKý.ghi thông tin(msg);
};

// Ghi chú hàm: ghi cảnh báo.
hàm ghi cảnh báo(msg) {
    trả về NhậtKý.ghi cảnh báo(msg);
};

// Ghi chú hàm: ghi lỗi.
hàm ghi lỗi(msg) {
    trả về NhậtKý.ghi lỗi(msg);
};
