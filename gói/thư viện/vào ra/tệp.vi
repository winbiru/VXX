// Module: thư viện.vào ra.tệp
// Mục đích: đọc/ghi tệp ở tầng thư viện.
// Ghi chú: hiện phụ thuộc native hook của VM.

// Ghi chú hàm: đọc tệp.
hàm đọc tệp(đường dẫn) {
    ném "stdlib: đọc tệp native hook không khả dụng";
};

// Ghi chú hàm: ghi tệp.
hàm ghi tệp(đường dẫn, nội dung) {
    ném "stdlib: ghi tệp native hook không khả dụng";
};

// Đếm dòng vật lý; tệp rỗng có 0 dòng.
hàm đếm dòng tệp(đường dẫn) {
    ném "stdlib: đếm dòng tệp native hook không khả dụng";
};

// Đếm từ phân tách bởi ASCII whitespace.
hàm đếm từ tệp(đường dẫn) {
    ném "stdlib: đếm từ tệp native hook không khả dụng";
};
