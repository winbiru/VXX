nhập gói.mạng.phân giải tên miền.*;
nhập gói.bộ sưu tập.từ điển.*;
nhập gói.hệ thống.môi trường.*;

// Fixture DNS RCODE/failover: kiểm tra retry và giữ lỗi có cấu trúc.
// Timeout lớn giúp phát hiện retry ngoài ý muốn qua tổng thời gian chạy.
hàm chính() {
    bộ = Bộ Phân Giải DNS();
    cổng = đọc biến môi trường("VPP_DNS_VI_PORT", "53");
    chế_độ = đọc biến môi trường("VPP_DNS_TEST_MODE", "");
    nếu (chế_độ == "bad_id") {
        đúng_loại = sai;
        thử {
            bộ.phân giải tên miền hỏi dự phòng("example.com", ["127.0.0.1", "127.0.0.2"], cổng, 1, 10000);
        } bắt lỗi(e) {
            nếu (loại của(e) == "từ điển") {
                đúng_loại = lấy từ điển(e, "loại", "") == "dns_giao_thức";
            };
        };
        in đúng_loại;
    } hoặc nếu (chế_độ == "rcode_retry") {
        // Máy chủ IPv4 trả SERVFAIL/REFUSED, IPv6 trả A hợp lệ.
        địa_chỉ = bộ.phân giải tên miền hỏi dự phòng(
            "example.com", ["127.0.0.1", "::1"], cổng, 1, 3000
        );
        in độ dài(địa_chỉ) == 1 && địa_chỉ[0] == "203.0.113.47";
    } hoặc nếu (chế_độ == "rcode_exhausted") {
        đúng_loại = sai;
        thử {
            bộ.phân giải tên miền hỏi dự phòng("example.com", ["127.0.0.1", "::1"], cổng, 1, 3000);
        } bắt lỗi(e) {
            nếu (loại của(e) == "từ điển") {
                đúng_loại = lấy từ điển(e, "loại", "") == "dns_rcode" &&
                    lấy từ điển(e, "mã", -1) == 5;
            };
        };
        in đúng_loại;
    } hoặc nếu (chế_độ == "formerr" || chế_độ == "notimp" || chế_độ == "unknown") {
        mã_mong_đợi = 1;
        nếu (chế_độ == "notimp") { mã_mong_đợi = 4; };
        nếu (chế_độ == "unknown") { mã_mong_đợi = 15; };
        đúng_loại = sai;
        thử {
            bộ.phân giải tên miền hỏi dự phòng("example.com", ["127.0.0.1", "127.0.0.2"], cổng, 1, 10000);
        } bắt lỗi(e) {
            nếu (loại của(e) == "từ điển") {
                đúng_loại = lấy từ điển(e, "loại", "") == "dns_rcode" &&
                    lấy từ điển(e, "mã", -1) == mã_mong_đợi;
            };
        };
        in đúng_loại;
    } hoặc {
        // NOERROR/ANCOUNT=0 và NXDOMAIN là kết quả hợp lệ, không retry.
        địa_chỉ = bộ.phân giải tên miền hỏi dự phòng(
            "example.com", ["127.0.0.1", "127.0.0.2"], cổng, 1, 10000
        );
        in độ dài(địa_chỉ) == 0;
    };
};
