nhập gói.chuẩn.chính.*;
hàm cp33 kiểm(nguồn, mẫu, thay, chuẩn, điểm mã) {
    a = chuỗi từ byte máy ảo(nguồn); b = chuỗi từ byte máy ảo(mẫu); c = chuỗi từ byte máy ảo(thay);
    kết quả = máy ảo thay chuỗi chính xác(a, b, c);
    nếu (kết quả != chuỗi từ byte máy ảo(chuẩn) || độ dài(kết quả) != điểm mã || độ dài(kết quả) != điểm mã) { ném "replace bytes"; };
    xem = máy ảo xem byte chuỗi(kết quả);
    nếu (máy ảo lấy độ dài(xem) != máy ảo lấy độ dài(chuẩn)) { ném "replace length"; };
    lặp(i = 0; i < máy ảo lấy độ dài(chuẩn); i++) { nếu (xem[i] != chuẩn[i]) { ném "replace view"; }; };
};
hàm cp33 lặp(s, n) {
    kết quả = "";
    khi (n > 0) {
        nếu (n % 2 == 1) { kết quả += s; };
        n = thành số nguyên(n / 2);
        nếu (n > 0) { s += s; };
    };
    trả về kết quả;
};
