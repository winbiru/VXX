nhập gói.lõi.số chính xác.*;
hàm chính() {
    in 1.5 + 2.25;
    in 5 / 2.0;
    in f32(16777217) == 16777216.0;
    in f32(16777219) == 16777220.0;
    in f32(-16777219) == -16777220.0;
    in f32(1.000000059604644775390625) == 1.0;
    in f32(1.000000178813934326171875) == 1.0000002384185791015625;
    in f64("1.25e2") == 125.0;
    nhỏ nhất = số thực từ bit máy ảo([0,0,0,0,0,0,160,54]);
    in f32(nhỏ nhất) == nhỏ nhất;
    in f32(nhỏ nhất / 2.0) == 0.0;
    in f32(nhỏ nhất * 1.5) == nhỏ nhất * 2.0;
    in f32(f64("1e39")) == số thực từ bit máy ảo([0,0,0,0,0,0,240,127]);
    // Arithmetic retains binary32 unless either operand is binary64.
    a = f32(16777216);
    in a + f32(1) == a;
    in a + 1 == a;
    in a + 1.0 == 16777217.0;
    in f64(a) + 1 == 16777217.0;
    âm không = số thực từ bit máy ảo([0,0,0,0,0,0,0,128]);
    in bit số thực máy ảo(f64(f32(âm không)))[7] == 128;
    nan = số thực từ bit máy ảo([1,0,0,0,0,0,240,127]);
    bit nan = bit số thực máy ảo(f64(f32(nan)));
    in bit nan[0] == 1 && bit nan[6] == 240 && bit nan[7] == 127;
    in f32(1) / f32(3) == 0.3333333432674407958984375;
    in f32(0.1) + f32(0.2) == 0.300000011920928955078125;
    in f32(nhỏ nhất) * f32(1.5) == nhỏ nhất * 2.0;
    in f32(nhỏ nhất) / f32(2) == 0.0;
    in f32(nhỏ nhất * 3.5) == nhỏ nhất * 4.0;
    in f32(-nhỏ nhất / 2.0) == 0.0;
    in bit số thực máy ảo(f32(-nhỏ nhất / 2.0))[7] == 128;
    in f32("3.4028234663852886e38") * f32(2) == số thực từ bit máy ảo([0,0,0,0,0,0,240,127]);
    in f32(1.5) < f32(2.0);
    in f32(1.5) >= 1;
    in máy ảo lấy loại(f32(1)) == "số thực";
    in f32(1.5);
    x = f32(1.5);
    x++;
    in x == 2.5;
    x--;
    in x == 1.5;
    in i8(42);
    in số nguyên lớn("999999999999999999999").cộng(số nguyên lớn("1")).chuỗi();
    in số nguyên lớn("-999999999999999999999").trừ(số nguyên lớn("1")).chuỗi();
    in số nguyên lớn("12345678901234567890").nhân(số nguyên lớn("9876543210")).chuỗi();
    in số nguyên lớn("-12345678901234567890").chia(số nguyên lớn("9876543210")).chuỗi();
    in số nguyên lớn("-12345678901234567890").chia dư(số nguyên lớn("9876543210")).chuỗi();
    in số thập phân("1").chia(số thập phân("3"), 12).chuỗi();
    in số thập phân("-0.01").chia(số thập phân("0.2"), 4).chuỗi();
    in số thập phân("0.001").chia(số thập phân("2")).chuỗi();
    thử { in số nguyên lớn("1").chia(số nguyên lớn("0")).chuỗi(); } bắt lỗi(e) { in "zero"; };
    in số thập phân("0.1").cộng(số thập phân("0.2")).chuỗi();
    in số thập phân("-1.25").nhân(số thập phân("0.08")).chuỗi();
    in số thập phân("0.001").trừ(số thập phân("0.002")).chuỗi();
    in số thập phân("-0.00").chuỗi();
    in số thập phân("1.000").so sánh(số thập phân("1"));
    in i8("-128");
    in i16("32767");
    in i32("-2147483648");
    in u8("255");
    in u16("65535");
    in u32("4294967295").chuỗi();
    in i64("-9223372036854775808").chuỗi();
    in u64("18446744073709551615").chuỗi();
    thử { in u8("256"); } bắt lỗi(e) { in "overflow"; };
    thử { in i64("9223372036854775808"); } bắt lỗi(e) { in "overflow"; };
    thử { in số nguyên lớn("1.1"); } bắt lỗi(e) { in "fraction"; };
    thử { in số thập phân("1.2.3"); } bắt lỗi(e) { in "invalid"; };
};
