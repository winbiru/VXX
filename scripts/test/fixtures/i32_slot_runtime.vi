hàm tính(x) {
    lặp(i = 0; i < 100000; i++) {
        x = x + 5000;
        x = x - 4999;
    };
    in x;
    in x < 120000;
    in x == 110000;
    x = 2147483647;
    x = x + 1;
    in x;
    x = x - 1;
    in x;
    x = 50000;
    x = x * 50000;
    in x;
    x = x + 5000;
    x = x + 5000;
    in x;
    x = 1.5;
    x = x + 5000;
    in x;
    x = "a";
    x = x + 5000;
    in x;
    in x == 5000;
};

hàm chính() {
    tính(10000);
    biến x = 50000;
    x = x + 5000;
    biến đọc = hàm() { trả về x; };
    x = x + 5000;
    in đọc();
};
