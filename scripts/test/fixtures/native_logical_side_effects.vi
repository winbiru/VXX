// Machine IR supports assignment expressions. Keep this regression separate
// from the control-flow fixture also compiled by the direct bytecode backend,
// whose assignments are statement-only.
hàm logic_vet(a, b) {
    biến dem = 0;
    biến x = a && (dem += 1);
    biến y = b || (dem += 2);
    trả về x * 100 + y * 10 + dem;
}
