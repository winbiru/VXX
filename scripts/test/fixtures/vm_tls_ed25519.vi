nhập gói.bảo mật.ed25519.Ed25519 VPP;

hàm tls ed hex(text) {
    bytes = chuỗi thành byte máy ảo(text);
    result = [];
    lặp(i = 0; i < độ dài(bytes); i = i + 2) {
        high = bytes[i] - 48; low = bytes[i + 1] - 48;
        nếu (high > 9) { high = bytes[i] - 87; };
        nếu (low > 9) { low = bytes[i + 1] - 87; };
        thêm(result, high * 16 + low);
    };
    trả về result;
};

hàm chính() {
    ed = Ed25519 VPP();
    // RFC 8032, section 7.1, first Ed25519 test vector.
    pk = tls ed hex("d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a");
    sig = tls ed hex("e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b");
    nếu (!ed.xác minh(pk, [], sig)) { ném "Ed25519 RFC 8032 verification failed"; };
    sig[0] = sig[0] ^ 1;
    nếu (ed.xác minh(pk, [], sig)) { ném "Ed25519 modified signature accepted"; };
    in "Ed25519 VPP RFC VECTOR OK";
};
