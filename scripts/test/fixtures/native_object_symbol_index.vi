// Exercise the actual ELF/COFF writers on the macOS host. The same
// synthetic module has repeated imports both before and after its local
// definitions, plus native ABI calls in a different order.
nhập gói.biên dịch.bản địa.môi trường thực thi.*;
nhập gói.biên dịch.bản địa.phân tích từ vựng.*;
nhập gói.biên dịch.bản địa.từ tố.*;
nhập gói.biên dịch.bản địa.phân tích cú pháp.*;
nhập gói.biên dịch.bản địa.chương trình.*;
nhập gói.biên dịch.bản địa.sinh mã.*;
nhập gói.biên dịch.bản địa.mã máy x86 64.*;
nhập gói.biên dịch.bản địa.sinh mã chương trình.*;
nhập gói.biên dịch.bản địa.đối tượng.*;
nhập gói.biên dịch.bản địa.đối tượng mô đun.*;
nhập gói.biên dịch.bản địa.trình liên kết macho.*;
nhập gói.biên dịch.bản địa.trình liên kết macho executable.*;
nhập gói.biên dịch.bản địa.liên kết macho runtime.*;
nhập gói.biên dịch.bản địa.định dạng elf 64.*;
nhập gói.biên dịch.bản địa.định dạng coff 64.*;
nhập gói.biên dịch.bản địa.trình liên kết pe.*;
nhập gói.biên dịch.bản địa.liên kết pe runtime.*;
nhập gói.biên dịch.bản địa.nạp mô đun.*;
nhập gói.biên dịch.bản địa.biên dịch mô đun.*;
nhập gói.biên dịch.bản địa.bộ nhớ đệm.*;
nhập gói.biên dịch.bản địa.assembler.*;
nhập gói.biên dịch.bản địa.trình xuất đối tượng.*;

hàm ghi mẫu(đường, dữ liệu) {
    biến tệp = thực thi tệp dữ liệu mở ghi(đường);
    nếu (tệp <= 0) { trả về -1; };
    biến n = thực thi tệp dữ liệu ghi khối(tệp, dữ liệu);
    nếu (thực thi tệp dữ liệu đóng(tệp) != 0) { trả về -1; };
    nếu (n != byte dài(dữ liệu)) { trả về -1; };
    trả về 0;
};

hàm cặp mẫu(bảng, vị trí, id) {
    nếu (đối tượng i32(bảng, vị trí) != 0) { trả về -1; };
    trả về đối tượng i32(bảng, id);
};

hàm chính() {
    biến mã = byte mới();
    biến đối tượng = byte mới();
    biến điểm = byte mới();
    biến sổ = byte mới();
    biến các phần nhập = byte mới();
    biến lõi = byte mới();
    nếu (mã <= 0 || đối tượng <= 0 || điểm <= 0 || sổ <= 0 || các phần nhập <= 0 || lõi <= 0) { trả về 1; };
    nếu (đối tượng đệm(mã, 32) != 0) { trả về 2; };
    nếu (đối tượng i32(điểm, 0) != 0 || đối tượng i32(điểm, 16) != 0) { trả về 3; };
    lặp (i = 0; i < 6; i++) {
        nếu (đối tượng i32(sổ, 1) != 0 || đối tượng i32(sổ, 0) != 0 || byte thêm(sổ, 97 + i) != 0) { trả về 4; };
    };
    nếu (cặp mẫu(các phần nhập, 0, 5) != 0 || cặp mẫu(các phần nhập, 4, 0) != 0 || cặp mẫu(các phần nhập, 8, 5) != 0) { trả về 5; };
    nếu (cặp mẫu(lõi, 12, 82) != 0 || cặp mẫu(lõi, 16, 0) != 0 || cặp mẫu(lõi, 20, 82) != 0) { trả về 6; };
    nếu (elf mô đun(mã, đối tượng, điểm, sổ, 2, 4, 2, các phần nhập, lõi) <= 0) { trả về 7; };
    nếu (ghi mẫu(đối số lấy(1), đối tượng) != 0) { trả về 8; };
    nếu (coff mô đun(mã, đối tượng, điểm, sổ, 2, 4, 2, các phần nhập, lõi) <= 0) { trả về 9; };
    nếu (ghi mẫu(đối số lấy(2), đối tượng) != 0) { trả về 10; };
    // Reject a relocation into the current module and an out-of-range ID.
    nếu (cặp mẫu(các phần nhập, 24, 2) != 0) { trả về 11; };
    nếu (elf mô đun(mã, đối tượng, điểm, sổ, 2, 4, 2, các phần nhập, lõi) >= 0 || byte dài(đối tượng) != 0) { trả về 12; };
    nếu (coff mô đun(mã, đối tượng, điểm, sổ, 2, 4, 2, các phần nhập, lõi) >= 0 || byte dài(đối tượng) != 0) { trả về 13; };
    nếu (byte làm rỗng(các phần nhập) != 0 || cặp mẫu(các phần nhập, 0, 6) != 0) { trả về 14; };
    nếu (elf mô đun(mã, đối tượng, điểm, sổ, 2, 4, 2, các phần nhập, lõi) >= 0 || byte dài(đối tượng) != 0) { trả về 15; };
    nếu (coff mô đun(mã, đối tượng, điểm, sổ, 2, 4, 2, các phần nhập, lõi) >= 0 || byte dài(đối tượng) != 0) { trả về 16; };
    nếu (byte làm rỗng(các phần nhập) != 0 || byte thêm(các phần nhập, 1) != 0) { trả về 17; };
    nếu (elf mô đun(mã, đối tượng, điểm, sổ, 2, 4, 2, các phần nhập, lõi) >= 0 || byte dài(đối tượng) != 0) { trả về 18; };
    nếu (coff mô đun(mã, đối tượng, điểm, sổ, 2, 4, 2, các phần nhập, lõi) >= 0 || byte dài(đối tượng) != 0) { trả về 19; };
    byte hủy(mã); byte hủy(đối tượng); byte hủy(điểm); byte hủy(sổ); byte hủy(các phần nhập); byte hủy(lõi);
    trả về 0;
};
