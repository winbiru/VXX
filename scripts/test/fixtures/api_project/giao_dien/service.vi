// Contract nghiệp vụ user mà tầng controller được phép gọi.

giao diện UserServiceContract {
    hàm getUsers(dbSession, từ tố);
    hàm createUser(dbSession, từ tố, payload);
    hàm updateUser(dbSession, từ tố, userId, payload);
    hàm deleteUser(dbSession, từ tố, userId);
    hàm searchUsers(dbSession, từ tố, keyword);
};
