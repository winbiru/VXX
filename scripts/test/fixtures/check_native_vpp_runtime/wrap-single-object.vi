hàm chính() {
    nếu (đối số đếm() != 3) { trả về 70; };
    biến source = đối số lấy(1);
    biến destination = đối số lấy(2);
    biến đối tượng = byte mới();
    biến fd = tệp mở đọc(source);
    nếu (fd <= 0) { trả về 71; };
    biến length = tệp đọc khối(fd, đối tượng);
    nếu (tệp đóng(fd) != 0) { trả về 72; };
    nếu (length < 232) { trả về 73; };
    nếu (thực thi liên kết kho lưu trữ đơn(-1) != -1) { trả về 1; };
    biến empty = byte mới();
    nếu (thực thi liên kết kho lưu trữ đơn(empty) != -1) { trả về 2; };
    biến short_object = byte cắt(đối tượng, 0, 231);
    nếu (thực thi liên kết kho lưu trữ đơn(short_object) != -1) { trả về 3; };
    byte hủy(short_object);
    biến stale = byte mới();
    byte hủy(stale);
    nếu (thực thi liên kết kho lưu trữ đơn(stale) != -1) { trả về 4; };
    biến archive = thực thi liên kết kho lưu trữ đơn(đối tượng);
    nếu (archive <= 0) { trả về 5; };
    nếu (byte dài(archive) != length + 4) { trả về 6; };
    nếu (thực thi đối tượng kho lưu trữ điểm vào(archive, 0) != length) { trả về 7; };
    biến body = byte cắt(archive, 4, length);
    nếu (byte bằng(body, đối tượng) != 1) { trả về 8; };
    byte hủy(body);
    biến summary = thực thi đối tượng kho lưu trữ bản tổng hợp(archive);
    nếu (summary != 2) {
        nếu (summary != 3) { trả về 9; };
    };
    biến bad = byte cắt(đối tượng, 0, length);
    thực thi các byte lưu i32(bad, 0, 0);
    biến bad_archive = thực thi liên kết kho lưu trữ đơn(bad);
    nếu (bad_archive <= 0) { trả về 10; };
    nếu (thực thi đối tượng kho lưu trữ bản tổng hợp(bad_archive) != -1) { trả về 11; };
    byte hủy(bad_archive);
    byte hủy(bad);
    fd = tệp mở ghi(destination);
    nếu (fd <= 0) { trả về 12; };
    nếu (tệp ghi khối(fd, archive) != length + 4) { trả về 13; };
    nếu (tệp đóng(fd) != 0) { trả về 14; };
    byte hủy(archive);
    byte hủy(đối tượng);
    trả về 50 + summary;
};
