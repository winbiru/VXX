hàm chính() {
    nếu (đối số đếm() != 4) { trả về 1; };
    biến output = đối số lấy(1);
    biến output2 = đối số lấy(2);
    biến sentinel = đối số lấy(3);
    biến temporary = byte mới();
    biến second = byte mới();
    biến malformed = "no-X-suffix";
    nếu (thực thi liên kết tạm mở(malformed) != -1) { trả về 2; };
    nếu (thực thi liên kết tạm mở(-1) != -1) { trả về 3; };
    biến empty = byte mới();
    byte hủy(empty);
    nếu (thực thi liên kết tạm mở(empty) != -1) { trả về 4; };
    nếu (thực thi liên kết công bố(empty, sentinel) != -1) { trả về 5; };
    nếu (thực thi liên kết công bố(sentinel, sentinel) != -1) { trả về 6; };
    biến missing = "no-such-rename-input";
    nếu (thực thi liên kết công bố(missing, sentinel) != -1) { trả về 7; };
    nếu (thực thi liên kết tạm thời đường tệp(output, temporary, -1) != 0) { trả về 8; };
    biến fd = thực thi liên kết tạm mở(temporary);
    nếu (fd < 0) { trả về 9; };
    nếu (thực thi liên kết tạm mở(temporary) != -1) { trả về 10; };
    nếu (thực thi liên kết tạm thời đường tệp(output, second, -1) != 0) { trả về 11; };
    biến fd2 = thực thi liên kết tạm mở(second);
    nếu (fd2 < 0) { trả về 12; };
    nếu (byte bằng(temporary, second) != 0) { trả về 13; };
    biến content1 = "V++ temp one";
    biến content2 = "V++ temp two";
    nếu (thực thi ghi tất cả(fd, thực thi nội dung đệm(thực thi các byte ô nhớ(content1)), byte dài(content1)) != byte dài(content1)) { trả về 14; };
    nếu (thực thi ghi tất cả(fd2, thực thi nội dung đệm(thực thi các byte ô nhớ(content2)), byte dài(content2)) != byte dài(content2)) { trả về 15; };
    nếu (máy đóng(fd) != 0) { trả về 16; };
    nếu (máy đóng(fd2) != 0) { trả về 17; };
    nếu (thực thi liên kết công bố(temporary, output) != 0) { trả về 18; };
    nếu (thực thi liên kết công bố(temporary, output) != -1) { trả về 19; };
    nếu (thực thi liên kết công bố(second, output2) != 0) { trả về 20; };
    trả về 52;
};
