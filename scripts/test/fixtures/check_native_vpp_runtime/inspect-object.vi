hàm chính() {
    nếu (đối số đếm() != 2) { trả về 70; };
    biến path = đối số lấy(1);
    biến data = byte mới();
    biến file = tệp mở đọc(path);
    nếu (file <= 0) { trả về 71; };
    biến length = tệp đọc khối(file, data);
    nếu (tệp đóng(file) != 0) { trả về 72; };
    nếu (length < 5) { trả về 73; };
    biến services = thực thi đối tượng các dịch vụ(data, 4, length - 36);
    nếu (services == -1) { trả về 60; };
    nếu (services == 0) { trả về 61; };
    nếu (services == 1) { trả về 62; };
    trả về 74;
};
