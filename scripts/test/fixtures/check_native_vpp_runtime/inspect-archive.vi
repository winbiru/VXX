hàm chính() {
    nếu (đối số đếm() != 2) { trả về 70; };
    biến path = đối số lấy(1);
    biến data = byte mới();
    biến file = tệp mở đọc(path);
    nếu (file <= 0) { trả về 71; };
    biến read = tệp đọc khối(file, data);
    nếu (tệp đóng(file) != 0) { trả về 72; };
    nếu (read < 0) { trả về 73; };
    biến summary = thực thi đối tượng kho lưu trữ bản tổng hợp(data);
    nếu (summary < 0) { trả về 60; };
    biến position = 0;
    biến count = máy chia số nguyên ba mươi hai bit(summary, 2);
    lặp (i = 0; i < count; i++) {
        biến length = thực thi đối tượng kho lưu trữ điểm vào(data, position);
        nếu (length < 232) { trả về 80; };
        position = position + 4 + length;
    };
    nếu (position != byte dài(data)) { trả về 81; };
    trả về 60 + summary;
};
