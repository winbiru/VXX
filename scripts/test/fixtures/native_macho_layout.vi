nhập gói.biên dịch.đọc macho.Đối Tượng MachO;
nhập gói.biên dịch.bố trí macho.*;
nhập gói.văn bản.chuỗi.tách hằng văn bản;
nhập gói.dữ liệu.json.json.json tạo;

hàm đối số văn bản(i) {
    h = đối số lấy(i);
    bytes = [];
    lặp(j = 0; j < byte dài(h); j++) { bỏ kết quả = máy ảo thêm cuối danh sách(bytes, byte lấy(h, j)); };
    bỏ kết quả = byte hủy(h);
    trả về chuỗi từ byte máy ảo(bytes);
};

hàm chính() {
    đối tượng = [];
    thử {
        cho phép = {};
        // Catalog supplied independently by test driver, never inferred from objects.
        tên = tách hằng văn bản(đối số văn bản(1), "|");
        lặp(i = 0; i < máy ảo lấy độ dài(tên); i++) { cho phép[tên[i]] = đúng; };
        lặp(i = 2; i < đối số đếm(); i++) { bỏ kết quả = máy ảo thêm cuối danh sách(đối tượng, Đối Tượng MachO(đối số văn bản(i))); };
        k = macho lập kế hoạch(đối tượng, cho phép);
        in k["sections"];
        in json tạo(k["imports"]);
        in [k["stub"], k["pointers"], k["data"], k["dataFileEnd"], k["imageEnd"], k["entry"]];
        in macho kế hoạch tái định vị(đối tượng, k);
        lặp(i = 0; i < máy ảo lấy độ dài(đối tượng); i++) { bỏ kết quả = đối tượng[i].đóng(); };
        in "Mach-O layout: PASS";
    } bắt lỗi(e) {
        lặp(i = 0; i < máy ảo lấy độ dài(đối tượng); i++) { bỏ kết quả = đối tượng[i].đóng(); };
        in e;
        trả về 1;
    };
};
