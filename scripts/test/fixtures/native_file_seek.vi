nhập gói.nhập xuất.tệp thô.*;
nhập gói.nhập xuất.tệp.thử khóa tệp;
nhập gói.nhập xuất.tệp.mở khóa tệp;
nhập gói.nhập xuất.tệp.thử liên kết cứng;
nhập gói.nhập xuất.bộ đệm tệp.Bộ Đệm Tệp;

hàm đối số văn bản(i) {
    h = đối số lấy(i);
    bytes = [];
    lặp(j = 0; j < byte dài(h); j++) {
        bỏ kết quả = máy ảo thêm cuối danh sách(bytes, byte lấy(h, j));
    };
    bỏ kết quả = byte hủy(h);
    trả về chuỗi từ byte máy ảo(bytes);
};

hàm chính() {
    lỗi tràn = 84;
    nếu (ten nền tảng máy ảo() == "linux") { lỗi tràn = 75; };
    nếu (ten nền tảng máy ảo() == "windows") { lỗi tràn = 132; };
    đường = đối số văn bản(1);
    t = tệp thô mở(đường, 1);
    nếu (tệp thô ghi(t, [0, 255, 65, 66, 67, 68, 69, 70], 8) != 8) { trả về 1; };
    nếu (tệp thô vị trí(t) != 8 || tệp thô dịch(t, -2, 1) != 6) { trả về 2; };
    nếu (tệp thô dịch(t, -1, 2) != 7 || tệp thô dịch(t, 0, 0) != 0) { trả về 3; };
    nếu (tệp thô dịch(t, -1, 0) != -1 || tệp thô mã lỗi() == 0) { trả về 4; };
    nếu (tệp thô vị trí(t) != 0 || tệp thô mã lỗi() != 0) { trả về 5; };
    // Exercise overflow without writing or allocating a large file.
    nếu (tệp thô dịch(t, 2147483647, 0) != 2147483647) { trả về 6; };
    nếu (tệp thô dịch(t, 1, 1) != -1 || tệp thô mã lỗi() != lỗi tràn) { trả về 7; };
    nếu (tệp thô vị trí(t) != -1 || tệp thô mã lỗi() != lỗi tràn) { trả về 8; };
    nếu (tệp thô dịch(t, 0, 0) != 0 || tệp thô đóng(t) != 0) { trả về 9; };

    đọc = Bộ Đệm Tệp(đường, "đọc", 4);
    nếu (đọc.đọc các byte(1)[0] != 0 || đọc.vị trí() != 1) { trả về 10; };
    nếu (!đọc.dịch(1, 1) || đọc.vị trí() != 2 || đọc.đọc các byte(1)[0] != 65) { trả về 11; };
    nếu (!đọc.dịch(-2, 1) || đọc.vị trí() != 1 || đọc.đọc các byte(1)[0] != 255) { trả về 12; };
    nếu (!đọc.dịch(-1, 2) || đọc.đọc các byte(4)[0] != 70 || độ dài(đọc.đọc các byte(1)) != 0) { trả về 13; };
    nếu (!đọc.dịch(0) || đọc.đọc các byte(1)[0] != 0) { trả về 14; };
    bỏ kết quả = đọc.đóng();
    ghi = Bộ Đệm Tệp(đường, "ghi", 4);
    bỏ kết quả = ghi.ghi các byte([0]);
    khối = [255, 65];
    bỏ kết quả = ghi.ghi khối trực tiếp(khối);
    khối[0] = 1;
    nếu (ghi.vị trí() != 3) { trả về 16; };
    lỗi byte = sai;
    thử { bỏ kết quả = ghi.ghi khối trực tiếp([66, 256]); }
    bắt lỗi(e) { lỗi byte = đúng; };
    nếu (!lỗi byte || ghi.vị trí() != 3) { trả về 17; };
    bỏ kết quả = ghi.ghi khối trực tiếp([]);
    bỏ kết quả = ghi.ghi các byte([66]);
    bỏ kết quả = ghi.đóng();
    đọc = Bộ Đệm Tệp(đường, "đọc", 4);
    khối = đọc.đọc các byte(8);
    nếu (độ dài(khối) != 4 || khối[0] != 0 || khối[1] != 255 || khối[2] != 65 || khối[3] != 66) { trả về 18; };
    bỏ kết quả = đọc.đóng();
    // Open for in-place updates without truncating the existing contents.
    t = tệp thô mở(đường, 3);
    nếu (tệp thô dịch(t, 3, 0) != 3) { trả về 19; };
    nếu (tệp thô ghi tại(t, [77, 78], 2, 1) != 2 || tệp thô mã lỗi() != 0) { trả về 20; };
    nếu (tệp thô vị trí(t) != 3 || tệp thô ghi tại(t, [79], 1, [2, 0]) != 1) { trả về 21; };
    nếu (tệp thô vị trí(t) != 3 || tệp thô đồng bộ(t) != 0 || tệp thô mã lỗi() != 0) { trả về 22; };
    nếu (tệp thô dịch(t, 0, 0) != 0) { trả về 23; };
    dữ liệu = [0, 0, 0, 0];
    nếu (tệp thô đọc(t, dữ liệu, 4) != 4 || dữ liệu[0] != 0 || dữ liệu[1] != 77 || dữ liệu[2] != 79 || dữ liệu[3] != 66) { trả về 24; };
    nếu (tệp thô ghi tại(t, [1], 1, -1) != -1 || tệp thô mã lỗi() == 0) { trả về 25; };
    nếu (tệp thô đồng bộ(t) != 0 || tệp thô mã lỗi() != 0) { trả về 26; };
    // Exercise an unsigned low word across the signed i32 boundary.
    nếu (ten nền tảng máy ảo() != "windows") {
        nếu (tệp thô ghi tại(t, [123], 1, [-2147483647 - 1, 0]) != 1 || tệp thô vị trí(t) != 4) { trả về 27; };
        nếu (tệp thô dịch(t, 2147483647, 0) != 2147483647) { trả về 28; };
        dữ liệu = [1, 0];
        nếu (tệp thô đọc(t, dữ liệu, 2) != 2 || dữ liệu[0] != 0 || dữ liệu[1] != 123) { trả về 29; };
        nếu (tệp thô đồng bộ(t) != 0) { trả về 30; };
    };
    nếu (tệp thô đóng(t) != 0 || tệp thô đồng bộ(t) != -1 || tệp thô mã lỗi() == 0) { trả về 31; };
    t = tệp thô mở(đường, 2);
    nếu (tệp thô ghi tại(t, [1], 1, 0) != -1 || tệp thô mã lỗi() == 0 || tệp thô đóng(t) != 0) { trả về 32; };
    nếu (ten nền tảng máy ảo() == "windows") {
        nếu (tệp thô đồng bộ thư mục(".") != -1 || tệp thô mã lỗi() != 129) { trả về 33; };
    }
    hoặc {
        nếu (tệp thô đồng bộ thư mục(đường) != -1 || tệp thô mã lỗi() == 0) { trả về 34; };
        nếu (tệp thô đồng bộ thư mục(".") != 0 || tệp thô mã lỗi() != 0) { trả về 35; };
    };
    nếu (tệp thô xóa(đường) != 0) { trả về 15; };
    nếu (ten nền tảng máy ảo() != "windows") {
        nếu (tệp thô đồng bộ thư mục(".") != 0) { trả về 36; };
    };
    đường khóa = đường + ".lock";
    khóa = thử khóa tệp(đường khóa);
    nếu (khóa == 0) { trả về 37; };
    nếu (thử khóa tệp(đường khóa) != 0) { trả về 38; };
    bỏ kết quả = mở khóa tệp(khóa);
    nếu (máy tệp khóa(khóa) != -1 || tệp thô mã lỗi() != 9) { trả về 39; };
    khóa = thử khóa tệp(đường khóa);
    nếu (khóa == 0) { trả về 40; };
    bỏ kết quả = mở khóa tệp(khóa);
    nếu (tệp thô xóa(đường khóa) != 0) { trả về 41; };

    đường liên kết = đường + ".link";
    t = tệp thô mở(đường, 1);
    nếu (tệp thô ghi(t, [65, 66], 2) != 2 || tệp thô đóng(t) != 0) { trả về 42; };
    nếu (!thử liên kết cứng(đường, đường liên kết) || tệp thô mã lỗi() != 0) { trả về 43; };
    nếu (thử liên kết cứng(đường, đường liên kết) || tệp thô mã lỗi() != 17) { trả về 44; };
    t = tệp thô mở(đường, 3);
    nếu (tệp thô ghi tại(t, [67], 1, 0) != 1 || tệp thô đồng bộ(t) != 0 || tệp thô đóng(t) != 0) { trả về 45; };
    nếu (tệp thô xóa(đường) != 0) { trả về 46; };
    t = tệp thô mở(đường liên kết, 0);
    dữ liệu = [0, 0];
    nếu (tệp thô đọc(t, dữ liệu, 2) != 2 || dữ liệu[0] != 67 || dữ liệu[1] != 66 || tệp thô đóng(t) != 0) { trả về 47; };
    nếu (thử liên kết cứng(đường, đường + ".missing") || tệp thô mã lỗi() != 2) { trả về 48; };
    nếu (tệp thô xóa(đường liên kết) != 0) { trả về 49; };
    in "Native file seek: PASS";
};
