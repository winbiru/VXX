// Kiểm tra hạ Machine IR: biên signed i32 và overflow trung gian.
hàm min_i32() { trả về -2147483648; }
hàm max_i32_const() { trả về 2147483647; }
hàm add_limit() { trả về 2147483646 + 1; }
hàm neg_limit() { trả về -(2147483648); }

