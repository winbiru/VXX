nhập gói.chuẩn.chính.*;

hàm chính() {
    s = bộ quét("  alpha 42 ff 3.5 nope");
    in có từ tố(s);
    in có từ tố(s);
    in từ tố(s);
    in xem i32(s);
    in i32(s);
    in i32(s, 16);
    in f64(s);

    thử {
        in i32(s);
    } bắt lỗi (e) {
        in e;
    };
    in từ tố(s);
    thử {
        in từ tố(s);
    } bắt lỗi (e) {
        in e;
    };

    custom = bộ quét("a,b;;c", ",;");
    lặp(i = 0; có từ tố(custom); i++) {
        in từ tố(custom);
    };

    phần = tách từ tố("a,b;;c", ",;", đúng);
    lặp(i = 0; i < độ dài(phần); i++) {
        in phần[i];
    };

    số = bộ quét("-2147483648 7fffffff 2147483648");
    in i32(số);
    in i32(số, 16);
    in xem i32(số);
    thử {
        in i32(số);
    } bắt lỗi (e) {
        in e;
    };
    in từ tố(số);

    skip_scan = bộ quét("prefix123", "");
    bộ quét bỏ hằng văn bản(skip_scan, "prefix");
    in từ tố(skip_scan);

    giới_hạn = bộ quét("abcd", " ", 3);
    thử {
        in có từ tố(giới_hạn);
    } bắt lỗi (e) {
        in e;
    };

    đóng = bộ quét("x");
    đóng bộ quét(đóng);
    thử {
        in có từ tố(đóng);
    } bắt lỗi (e) {
        in e;
    };

    regex_scan = bộ quét biểu thức chính quy("a   b\tc", "\\s+");
    in từ tố(regex_scan);
    in từ tố(regex_scan);
    in từ tố(regex_scan);

    regex_parts = tách từ tố biểu thức chính quy("a--b---c", "-+");
    lặp(i = 0; i < độ dài(regex_parts); i++) {
        in regex_parts[i];
    };

    regex_keep = tách từ tố biểu thức chính quy("a--b---c", "-+", đúng);
    lặp(i = 0; i < độ dài(regex_keep); i++) {
        in regex_keep[i];
    };

    regex_skip = bộ quét("abc123", "");
    bộ quét bỏ biểu thức chính quy(regex_skip, "[a-z]+");
    in từ tố(regex_skip);

    thử {
        bộ quét biểu thức chính quy("abc", "a*");
    } bắt lỗi (e) {
        in e;
    };

};
