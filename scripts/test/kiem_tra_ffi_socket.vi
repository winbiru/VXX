nhập gói.mạng.ổ cắm.*;

hàm chính() {
    tcp = đầu nối giao vận tin cậy mở("127.0.0.1", "18080", "1000");
    in tcp >= 536870912;
    in đầu nối đặt thời gian chờ(tcp, 1000);
    yêu_cầu = "GET /health HTTP/1.0\r\nHost: 127.0.0.1\r\nConnection: close\r\n\r\n";
    in đầu nối gửi(tcp, yêu_cầu) > 0;
    phản_hồi = đầu nối nhận(tcp, 4096);
    in độ dài(phản_hồi) > 0;
    in đầu nối đóng(tcp);
    bắt_được = sai;
    thử { đầu nối đóng(tcp); } bắt lỗi(e) { bắt_được = đúng; };
    in bắt_được;

    // Resolver có thể trả ::1 trước 127.0.0.1, trong khi fixture chỉ bind IPv4.
    // V++ phải thử địa chỉ kế tiếp khi adapter native kết nối thất bại.
    qua_dns = đầu nối giao vận tin cậy mở("localhost", 18080, 1000);
    in qua_dns >= 536870912;
    in đầu nối đóng(qua_dns);

    udp = đầu nối giao vận gói tin mở("127.0.0.1", 9, 1000);
    in udp >= 536870912;
    // Gửi UDP trả về số byte UTF-8, không phải số ký tự Unicode.
    in đầu nối gửi(udp, "kiểm tra kết nối") == 22;
    in đầu nối đóng(udp);
};
