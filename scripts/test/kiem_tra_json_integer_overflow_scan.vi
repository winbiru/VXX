nhập gói.chuẩn.chính.*;
nhập gói.dữ liệu.json.json.*;

hàm chính() {
    a = json phân tích("[0,-0,9,-9,10,-10,2147483647,-2147483648,2147483648,-2147483649,21474836470,-21474836480]");
    in a[0] == 0 && a[1] == 0 && a[2] == 9 && a[3] == -9;
    in a[4] == 10 && a[5] == -10;
    in a[6] == 2147483647 && loại của(a[6]) == loại của(0);
    in a[7] == -2147483648 && loại của(a[7]) == loại của(0);
    in a[8] == 2147483648.0 && loại của(a[8]) == loại của(0.0);
    in a[9] == -2147483649.0 && loại của(a[9]) == loại của(0.0);
    in a[10] == 21474836470.0 && a[11] == -21474836480.0;
    b = json phân tích("[2147483647.5,-2147483648.5,214748364800e-2,-214748364900E-2,1000000000000000000000000000000e-30,3]");
    in b[0] == 2147483647.5 && b[1] == -2147483648.5;
    in b[2] == 2147483648.0 && b[3] == -2147483649.0;
    in b[4] > 0.999999999999 && b[4] < 1.000000000001 && b[5] == 3;
    lỗi = 0;
    danh sách lỗi = ["01","-01","21474836480.","21474836480e","21474836480e+","[21474836480x]","-","[21474836480,]"];
    lặp(i = 0; i < máy ảo lấy độ dài(danh sách lỗi); i++) {
        thử {
            json phân tích(danh sách lỗi[i]);
        } bắt lỗi(e) { lỗi += 1; };
    };
    in lỗi == 8;
    // Hai chữ số ở gốc, trong object và trước từng delimiter hợp lệ.
    in json phân tích("10") == 10 && json phân tích("99") == 99;
    in json tạo(json phân tích("{\"a\":12,\"b\":99 }")) == "{\"a\":12,\"b\":99}";
    in json phân tích("12\t\r\n ") == 12;
    in json phân tích("12.5") == 12.5 && json phân tích("12e2") == 1200.0;
    lỗi = 0;
    danh sách lỗi = ["00","09","12x","12.","12e","12e+","12 3","[12,]","{\"x\":12x}"];
    lặp(i = 0; i < máy ảo lấy độ dài(danh sách lỗi); i++) {
        thử { json phân tích(danh sách lỗi[i]); } bắt lỗi(e) { lỗi += 1; };
    };
    in lỗi == 9;
};
