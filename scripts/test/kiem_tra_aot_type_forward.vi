nhập gói.chuẩn.chính.*;
lớp Hộp { hàm khởi tạo(n) { mình.n = n; }; };
hàm f() { trả về 1; };
hàm chuyển tiếp(v) { trả về máy ảo lấy loại(v); };
hàm kiểm(v, expected) {
    n = 0;
    nếu (chuyển tiếp(v) == "rỗng") { n += 1; };
    nếu (chuyển tiếp(v) == "số nguyên") { n += 2; };
    nếu (chuyển tiếp(v) == "số thực") { n += 4; };
    nếu (chuyển tiếp(v) == "chuỗi") { n += 8; };
    nếu (chuyển tiếp(v) == "danh sách") { n += 16; };
    nếu (chuyển tiếp(v) == "từ điển") { n += 32; };
    nếu (chuyển tiếp(v) == "tuple") { n += 64; };
    nếu (chuyển tiếp(v) == "hàm") { n += 128; };
    nếu (chuyển tiếp(v) == "lớp") { n += 256; };
    nếu (chuyển tiếp(v) == "đối tượng") { n += 512; };
    nếu (chuyển tiếp(v) != "invalid") { n += 1024; };
    nếu (chuyển tiếp(v) != "chuỗi") { n += 2048; };
    nếu (n != expected) { in n; in expected; ném "type branch"; };
};
hàm chính() {
    c = 5;
    đóng = hàm() { trả về c; };
    ds = [rỗng, 1, 1.5, "x", [], {}, bộ([1]), đóng, Hộp, Hộp(3), máy ảo xem byte chuỗi("a"), đúng, f];
    tên = ["rỗng", "số nguyên", "số thực", "chuỗi", "danh sách", "từ điển", "tuple", "hàm", "lớp", "đối tượng"];
    mã = [1,2,4,8,16,32,64,128,256,512];
    lặp(i=0; i < độ dài(ds); i++) {
        t = máy ảo lấy loại(ds[i]);
        expected = 1024;
        nếu (t != "chuỗi") { expected += 2048; };
        lặp(j=0; j<10; j++) { nếu (t == tên[j]) { expected += mã[j]; }; };
        kiểm(ds[i], expected);
    };
    lặp(i=0; i<1000; i++) { nếu (chuyển tiếp(i) != "số nguyên") { ném "raw slot"; }; };
    v = "x";
    nếu (loại của(v) != "chuỗi") { ném "string"; };
    v = 2;
    nếu (loại của(v) != "số nguyên") { ném "mutation"; };
    kiểm biên();
    in "type forwarding: PASS";
};

biến toàn cục = "gốc";
hàm khác(v) { trả về "chuỗi"; };
hàm mặc định(v = 7) { trả về máy ảo lấy loại(v); };
hàm tham số khác(v, w) { trả về máy ảo lấy loại(w); };
hàm tác dụng(v) { máy ảo thêm cuối danh sách(v, 9); trả về máy ảo lấy loại(v); };
hàm đọc ngoài(v) { trả về máy ảo lấy loại(toàn cục); };
hàm tạo kiểm(v) {
    trả về hàm(mới) {
        nếu (chuyển tiếp(v) == "chuỗi") { v = mới; trả về 1; };
        nếu (chuyển tiếp(v) == "tuple") { v = mới; trả về 2; };
        trả về 3;
    };
};
lớp Kiểu {
    hàm công khai chuyển tiếp(v) { trả về "chuỗi"; };
};
hàm kiểm che tên(chuyển tiếp, v) {
    nếu (chuyển tiếp(v) != "chuỗi") { ném "shadowed binding"; };
};
hàm kiểm biên() {
    v = 42;
    nếu (khác(v) != "chuỗi") { ném "same arity non-forward"; };
    nếu (mặc định(v) != "số nguyên") { ném "default explicit"; };
    nếu (mặc định() != "số nguyên") { ném "default omitted"; };
    w = "abc";
    nếu (tham số khác(v, w) != "chuỗi") { ném "wrong parameter"; };
    nếu (đọc ngoài(v) != "chuỗi") { ném "global read"; };
    nếu (chuyển tiếp(toàn cục) != "chuỗi") { ném "global argument"; };
    ds = [];
    nếu (tác dụng(ds) != "danh sách") { ném "side effect type"; };
    nếu (độ dài(ds) != 1) { ném "side effect missing"; };
    fn = chuyển tiếp;
    nếu (fn(v) != "số nguyên") { ném "indirect"; };
    fn = khác;
    nếu (fn(v) != "chuỗi") { ném "rebound indirect"; };
    kiểm che tên(khác, v);
    obj = Kiểu();
    nếu (obj.chuyển tiếp(v) != "chuỗi") { ném "receiver"; };
    nếu (chuyển tiếp(chưa) != "số nguyên") { ném "missing binding"; };
    nếu (chưa != 0) { ném "missing value"; };
    biến kiểm = tạo kiểm("Việt🌿");
    nếu (kiểm(máy ảo xem byte chuỗi("𠮷")) != 1) { ném "capture string"; };
    nếu (kiểm(42) != 2) { ném "capture view"; };
    lặp(i=0; i<30000; i++) {
        rác = "số:" + thành chuỗi(i);
        nếu (chuyển tiếp(rác) != "chuỗi") { ném "gc string"; };
        nếu (chuyển tiếp(i) != "số nguyên") { ném "gc int"; };
    };
    nếu (kiểm("x") != 3) { ném "capture after gc"; };
    bắt được = sai;
    thử {
        nếu (chuyển tiếp(v) == "số nguyên") { ném "expected"; };
    } bắt lỗi (lỗi) { bắt được = đúng; };
    nếu (!bắt được) { ném "catch"; };
    // Hai vế logic vẫn được đánh giá đầy đủ.
    ds = [];
    nếu (chuyển tiếp(v) == "số nguyên" || tác dụng(ds) == "danh sách") {};
    nếu (độ dài(ds) != 1) { ném "eager boolean"; };
};
