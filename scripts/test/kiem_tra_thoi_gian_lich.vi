nhập thời gian;
nhập gói.bộ sưu tập.từ điển.lấy từ điển;

hàm chính() {
    in thời gian là năm nhuận(2024);
    in thời gian là năm nhuận(1900);
    in thời gian là năm nhuận(2000);

    d = tạo ngày(2024, 2, 29);
    in định dạng ngày(d);
    in lấy từ điển(d, "ngày", 0);

    thử {
        tạo ngày(2023, 2, 29);
    } bắt lỗi (e) {
        in e;
    };

    parsed = phân tích ngày("2026-10-04");
    in định dạng ngày(parsed);
    thử {
        phân tích ngày("2026/10/04");
    } bắt lỗi (e) {
        in e;
    };

    t = tạo giờ(23, 59, 58, 123000000);
    in định dạng giờ(t);
    thử {
        tạo giờ(24, 0, 0);
    } bắt lỗi (e) {
        in e;
    };

    dt = phân tích ngày giờ("2026-10-04T09:08:07.123");
    in định dạng ngày giờ(dt);
    in lấy từ điển(lấy từ điển(dt, "giờ", {}), "nano", -1);

    thử {
        phân tích ngày giờ("2026-10-04T09:08:07Z");
    } bắt lỗi (e) {
        in e;
    };
};
