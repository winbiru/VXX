nhập đồng thời;

hàm chính() {
    nhanh = tác vụ sau("10", "xong");
    in chờ tác vụ(nhanh, 1000.0);
    in trạng thái tác vụ(nhanh);

    chậm = tác vụ sau("10000", "muộn");
    in hủy tác vụ(chậm);
    in trạng thái tác vụ(chậm);
    in chờ tác vụ(chậm, "0");
    dữ_liệu = [1, 2];
    kết_quả = chờ tác vụ(tác vụ sau(0, dữ_liệu), 1000);
    kết_quả[0] = 77;
    in kết_quả[0];
    in dữ_liệu[0];
};
