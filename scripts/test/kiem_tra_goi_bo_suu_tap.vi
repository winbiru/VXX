nhập bộ sưu tập;

hàm chính() {
    ds = [3, 1, 2];
    in tìm chỉ số(ds, 1);
    in tổng danh sách(ds);
    in nhỏ nhất danh sách(ds);
    in lớn nhất danh sách(ds);
    in có khóa({"tên": "V++"}, "tên");
    trực_tiếp = {"a": 1};
    in trực_tiếp["a"];
    trực_tiếp["b"] = 2;
    in lấy từ điển(trực_tiếp, "b", 0);
    in rời nhau([1, 2], [3, 4]);

    s = tập hợp([3, 1, 3, 2, 1]);
    in s;
    in tập chứa(s, 2);
    in hợp tập([1, 2], [2, 3]);
    in giao tập([1, 2, 3], [2, 3, 4]);
    in hiệu tập([1, 2, 3], [2, 4]);
    in hiệu đối xứng tập([1, 2, 3], [2, 3, 4]);
    in tập con([1, 1, 2], [2, 1, 3]);
    in tập con thực sự([1, 2], [2, 1, 3]);
    in tập cha([1, 2, 3], [1, 2]);
    in tập bằng([1, 2, 2], [2, 1]);

    mutable = tập hợp([1, 2]);
    in tập thêm(mutable, 3);
    in tập thêm(mutable, 3);
    in tập xóa(mutable, 2);
    in tập xóa(mutable, 9);
    in mutable;

    thử {
        tập hợp({});
    } bắt lỗi (e) {
        in e;
    };

    gốc = [1, [2]];
    bản_sao = thành danh sách(gốc);
    bản_sao[0] = 9;
    thêm(bản_sao, 3);
    in gốc[0] == 1 && độ dài(gốc) == 2 && độ dài(bản_sao) == 3;
    con = bản_sao[1];
    con[0] = 7;
    in gốc[1][0] == 7;

    bộ = thành bộ giá trị(gốc);
    từ_bộ = thành danh sách(bộ);
    từ_bộ[0] = 8;
    in bộ[0] == 1;
    con_bộ = từ_bộ[1];
    con_bộ[0] = 6;
    in bộ[1][0] == 6;
    in thành danh sách([]);
    in thành danh sách(thành bộ giá trị([]));
    in thành danh sách(bộ([8, 9]));
    in chuyển thành danh sách([4, 5]);
    thử { thành bộ giá trị("abc"); } bắt lỗi (e) { in e; };
    thử { thành danh sách("abc"); } bắt lỗi (e) { in e; };
    thử { thành danh sách({}); } bắt lỗi (e) { in e; };
    thử { thành danh sách(rỗng); } bắt lỗi (e) { in e; };
};
