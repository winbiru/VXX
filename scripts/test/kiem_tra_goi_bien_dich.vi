nhập biên dịch;
nhập bộ sưu tập;
nhập nhập xuất;

hàm chính() {
    nguồn = "hàm cộng(a, b) { trả về a + b; };";
    kiểm = biên dịch kiểm tra(nguồn);
    in lấy từ điển(kiểm, "hợp lệ", 0);

    kiểm_sai = biên dịch kiểm tra("hàm");
    in lấy từ điển(kiểm_sai, "hợp lệ", 1) == 0;
    in lấy từ điển(kiểm_sai, "lỗi", "") != "";

    phân tích = biên dịch phân tích(nguồn);
    in lấy từ điển(phân tích, "từ tố", 0) > 0 && lấy từ điển(phân tích, "từ tố", 0) == lấy từ điển(phân tích, "token", -1);
    in lấy từ điển(phân tích, "lệnh", 0) > 0;

    mã trung gian = biên dịch mã trung gian(nguồn);
    in độ dài(mã trung gian) > 0;
    in lấy từ điển(mã trung gian[0], "op", -1) >= 0;

    cây = biên dịch cây cú pháp(nguồn);
    in độ dài(cây) > 0;
    thống_kê = biên dịch thống kê(nguồn);
    in lấy từ điển(thống_kê, "từ tố", 0) > 0 && lấy từ điển(thống_kê, "từ tố", 0) == lấy từ điển(thống_kê, "token", -1);
    in lấy từ điển(thống_kê, "lệnh", 0) > 0;

    tệp = ".tmp_compiler_api.vi";
    ghi tệp(tệp, nguồn);
    từ tệp = biên dịch tệp(tệp);
    in lấy từ điển(từ tệp, "lệnh", 0) > 0;
    xóa đường dẫn(tệp);
};
