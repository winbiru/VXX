# CMake maintains the list of paths installed in this invocation.
set(root "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}")
set(entries "")
list(REMOVE_DUPLICATES CMAKE_INSTALL_MANIFEST_FILES)
foreach(path IN LISTS CMAKE_INSTALL_MANIFEST_FILES)
  file(RELATIVE_PATH relative "${CMAKE_INSTALL_PREFIX}" "${path}")
  if(relative MATCHES "^[.][.](/|$)" OR IS_ABSOLUTE "${relative}" OR relative MATCHES "[\t\r\n]" OR relative STREQUAL "vpp-install-manifest.tsv")
    message(FATAL_ERROR "Invalid V++ installation path: ${path}")
  endif()
  set(target "$ENV{DESTDIR}${path}")
  if(IS_SYMLINK "${target}" OR NOT EXISTS "${target}" OR IS_DIRECTORY "${target}")
    message(FATAL_ERROR "Invalid installed V++ file: ${target}")
  endif()
  file(SHA256 "${target}" digest)
  string(APPEND entries "${digest}\t${relative}\n")
endforeach()
if(entries STREQUAL "")
  message(FATAL_ERROR "Empty V++ installation manifest")
endif()
if(IS_SYMLINK "${root}/vpp-install-manifest.tsv")
  message(FATAL_ERROR "Refusing symbolic link installation manifest")
endif()
file(WRITE "${root}/vpp-install-manifest.tsv" "${entries}")
