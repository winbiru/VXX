# Compare ARM64 Mach-O __TEXT,__text across native compiler generations.
if (NOT DEFINED VPP_STAGE2 OR NOT DEFINED VPP_STAGE3 OR NOT DEFINED VPP_STAGE4)
    message(FATAL_ERROR "Native bootstrap: missing compiler stages")
endif()
function(vpp_native_text path out)
    file(READ "${path}" data HEX)
    # First load-command section descriptor: sectname[16] + segname[16].
    string(FIND "${data}" "5f5f74657874000000000000000000005f5f5445585400000000000000000000" section)
    if (section EQUAL -1)
        message(FATAL_ERROR "Mach-O missing __TEXT,__text: ${path}")
    endif()
    math(EXPR size_offset "${section} + 80")
    math(EXPR file_offset "${section} + 96")
    string(SUBSTRING "${data}" ${size_offset} 16 size_hex)
    string(SUBSTRING "${data}" ${file_offset} 8 offset_hex)
    string(REGEX MATCHALL ".." size_bytes "${size_hex}")
    string(REGEX MATCHALL ".." offset_bytes "${offset_hex}")
    list(REVERSE size_bytes)
    list(REVERSE offset_bytes)
    string(JOIN "" size_be ${size_bytes})
    string(JOIN "" offset_be ${offset_bytes})
    math(EXPR size "0x${size_be}")
    math(EXPR offset "0x${offset_be}")
    math(EXPR hex_offset "${offset} * 2")
    math(EXPR hex_length "${size} * 2")
    string(LENGTH "${data}" total)
    math(EXPR end "${hex_offset} + ${hex_length}")
    if (size LESS 1 OR end GREATER total)
        message(FATAL_ERROR "Invalid Mach-O section bounds: ${path}")
    endif()
    string(SUBSTRING "${data}" ${hex_offset} ${hex_length} bytes)
    set(${out} "${bytes}" PARENT_SCOPE)
endfunction()
vpp_native_text("${VPP_STAGE2}" baseline)
foreach(path IN ITEMS "${VPP_STAGE3}" "${VPP_STAGE4}")
    vpp_native_text("${path}" observed)
    if (NOT baseline STREQUAL observed)
        message(FATAL_ERROR "Native self-host machine code differs: ${path}")
    endif()
endforeach()
message(STATUS "V++ native self-host __TEXT,__text parity: PASS")
