# Check the CPack VDK deliverable and publish its SHA-256 without Python.
if (NOT DEFINED VPP_BUILD_DIR)
    message(FATAL_ERROR "VPP_BUILD_DIR is required")
endif()
get_filename_component(build_dir "${VPP_BUILD_DIR}" ABSOLUTE)
set(archive_dir "${build_dir}/vdk-artifacts")
file(GLOB archives "${archive_dir}/*.tar.gz" "${archive_dir}/*.tgz" "${archive_dir}/*.zip")
list(LENGTH archives archive_count)
if (NOT archive_count EQUAL 1)
    message(FATAL_ERROR "Expected one VDK archive in ${archive_dir}, got ${archive_count}")
endif()
list(GET archives 0 archive)
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar tf "${archive}"
    RESULT_VARIABLE status OUTPUT_VARIABLE listing ERROR_VARIABLE errors)
if (NOT status EQUAL 0)
    message(FATAL_ERROR "Cannot inspect VDK archive ${archive}: ${errors}")
endif()
foreach(required IN ITEMS "/bin/vdk" "/vdk-release.json" "/vpp-libraries.json")
    string(FIND "${listing}" "${required}" found)
    if (found EQUAL -1)
        message(FATAL_ERROR "VDK archive is missing ${required}: ${archive}")
    endif()
endforeach()
# macOS filesystem entries may be NFD, while Linux/Windows paths use NFC.
string(FIND "${listing}" "/gói/" stdlib_nfc)
string(FIND "${listing}" "/gói/" stdlib_nfd)
if (stdlib_nfc EQUAL -1 AND stdlib_nfd EQUAL -1)
    message(FATAL_ERROR "VDK archive is missing the V++ stdlib: ${archive}")
endif()
if (listing MATCHES "[.]vpp/")
    message(FATAL_ERROR "VDK archive contains a .vpp build cache: ${archive}")
endif()
get_filename_component(archive_name "${archive}" NAME)
file(SHA256 "${archive}" sha256)
set(checksum "${archive}.sha256")
file(WRITE "${checksum}" "${sha256}  ${archive_name}\n")
if (DEFINED ENV{GITHUB_OUTPUT} AND NOT "$ENV{GITHUB_OUTPUT}" STREQUAL "")
    file(APPEND "$ENV{GITHUB_OUTPUT}"
        "name=${archive_name}\narchive=${archive}\nchecksum=${checksum}\n")
endif()
message(STATUS "VDK archive verified: ${archive_name}, SHA-256 ${sha256}")
