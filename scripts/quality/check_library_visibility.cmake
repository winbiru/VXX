# Check explicit visibility of library type declarations in V++ source.
if (NOT DEFINED VPP_ROOT)
    message(FATAL_ERROR "VPP_ROOT is required")
endif()
file(GLOB_RECURSE modules "${VPP_ROOT}/gói/*.vi")
set(types 0)
foreach(module IN LISTS modules)
    file(STRINGS "${module}" lines ENCODING UTF-8)
    foreach(line IN LISTS lines)
        string(STRIP "${line}" declaration)
        string(REGEX REPLACE "[ \t]+" " " declaration "${declaration}")
        string(FIND "${declaration}" "lớp " is_class)
        string(FIND "${declaration}" "giao diện " is_interface)
        if (is_class EQUAL 0 OR is_interface EQUAL 0)
            string(FIND "${declaration}" "lớp công khai " public_class)
            string(FIND "${declaration}" "lớp riêng tư " private_class)
            string(FIND "${declaration}" "giao diện công khai " public_interface)
            string(FIND "${declaration}" "giao diện riêng tư " private_interface)
            if (NOT public_class EQUAL 0 AND NOT private_class EQUAL 0 AND
                NOT public_interface EQUAL 0 AND NOT private_interface EQUAL 0)
                message(FATAL_ERROR "Missing explicit visibility in ${module}: ${declaration}")
            endif()
            math(EXPR types "${types} + 1")
        endif()
    endforeach()
endforeach()
if (types EQUAL 0)
    message(FATAL_ERROR "No V++ library types found")
endif()
message(STATUS "V++ library: ${types} types with explicit visibility: PASS")
