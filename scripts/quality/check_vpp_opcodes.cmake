# Verify the Stage 0 C++ and self-hosted V++ opcode and intrinsic ABI in both
# directions. A new C++ entry must never silently lack a V++ implementation.
if (NOT DEFINED VPP_ROOT)
    message(FATAL_ERROR "VPP_ROOT is required")
endif()
file(READ "${VPP_ROOT}/src/include/vm/instruction.h" header)
# Strip C++ line comments before matching. Besides retired entries, the
# syntax token comments contain '[' and ']', which file(STRINGS) joins.
string(REGEX REPLACE "//[^\n]*" "" header "${header}")
string(REGEX MATCHALL "OP_[A-Za-z0-9_]+[ \t]*=[ \t]*[0-9]+" declarations "${header}")
set(enum_count 0)
foreach(line IN LISTS declarations)
    if (line MATCHES "^(OP_[A-Za-z0-9_]+)[ \t]*=[ \t]*([0-9]+)$")
        set(opcode "${CMAKE_MATCH_1}")
        set(number "${CMAKE_MATCH_2}")
        if (DEFINED "cpp_${opcode}")
            message(FATAL_ERROR "Duplicate C++ opcode: ${opcode}")
        endif()
        set("cpp_${opcode}" "${number}")
        list(APPEND cpp_opcodes "${opcode}")
        math(EXPR enum_count "${enum_count} + 1")
    endif()
endforeach()
if (enum_count LESS 50)
    message(FATAL_ERROR "Could not read opcode enum from C++ header")
endif()

file(STRINGS "${VPP_ROOT}/gói/biên dịch/mã thao tác.vi" source ENCODING UTF-8)
set(mapped_count 0)
foreach(line IN LISTS source)
    if (line MATCHES "^[ \t]*ca \"(OP_[A-Za-z0-9_]+)\"")
        set(opcode "${CMAKE_MATCH_1}")
        if (NOT DEFINED "cpp_${opcode}")
            message(FATAL_ERROR "V++ opcode not found in C++ enum: ${opcode}")
        endif()
        if (NOT line MATCHES "([0-9]+);")
            message(FATAL_ERROR "V++ opcode has no numeric mapping: ${opcode}")
        endif()
        set(actual "${CMAKE_MATCH_1}")
        if (NOT actual STREQUAL "${cpp_${opcode}}")
            message(FATAL_ERROR "ABI mismatch ${opcode}: V++=${actual}, C++=${cpp_${opcode}}")
        endif()
        if (DEFINED "vpp_${opcode}")
            message(FATAL_ERROR "Duplicate V++ opcode: ${opcode}")
        endif()
        set("vpp_${opcode}" "${actual}")
        math(EXPR mapped_count "${mapped_count} + 1")
    endif()
endforeach()
if (mapped_count LESS 50)
    message(FATAL_ERROR "Could not read V++ opcode mappings")
endif()
foreach(opcode IN LISTS cpp_opcodes)
    if (NOT DEFINED "vpp_${opcode}")
        message(FATAL_ERROR "C++ opcode missing in V++: ${opcode}=${cpp_${opcode}}")
    endif()
endforeach()
if (NOT mapped_count EQUAL enum_count)
    message(FATAL_ERROR "Opcode ABI count mismatch: V++=${mapped_count}, C++=${enum_count}")
endif()
message(STATUS "V++ opcode ABI: all ${mapped_count} entries agree with active C++ enum")

# Keep opcode, argument count and reservation status of every intrinsic in
# gói/biên dịch/nội tại.vi aligned with intrinsic.h. The C++ alias table is
# included because aliases are also recognized by the Stage 0 compiler.
file(READ "${VPP_ROOT}/src/include/vpp/bytecode/intrinsic.h" intrinsic_header)
string(REGEX REPLACE "//[^\n]*" "" intrinsic_header "${intrinsic_header}")
string(REGEX MATCHALL
    "\\{\"[^\"]+\",[ \t]*OP_[A-Za-z0-9_]+,[ \t]*[0-9]+(,[ \t]*(true|false))?\\}"
    cpp_intrinsic_rows "${intrinsic_header}")
set(cpp_intrinsic_count 0)
foreach(row IN LISTS cpp_intrinsic_rows)
    if (row MATCHES "^\\{\"([^\"]+)\",[ \t]*(OP_[A-Za-z0-9_]+),[ \t]*([0-9]+)(,[ \t]*(true|false))?\\}$")
        set(name "${CMAKE_MATCH_1}")
        set(opcode "${CMAKE_MATCH_2}")
        set(arity "${CMAKE_MATCH_3}")
        set(reserved "đúng")
        if (CMAKE_MATCH_5 STREQUAL "false")
            set(reserved "sai")
        endif()
        string(SHA256 key "${name}")
        if (DEFINED "cpp_intrinsic_${key}")
            message(FATAL_ERROR "Duplicate C++ intrinsic: ${name}")
        endif()
        set("cpp_intrinsic_${key}" "${opcode}|${arity}|${reserved}")
        set("cpp_intrinsic_name_${key}" "${name}")
        set("cpp_intrinsic_by_opcode_${opcode}" "${arity}|${reserved}")
        list(APPEND cpp_intrinsic_keys "${key}")
        math(EXPR cpp_intrinsic_count "${cpp_intrinsic_count} + 1")
    endif()
endforeach()
if (cpp_intrinsic_count LESS 40)
    message(FATAL_ERROR "Could not read C++ intrinsic descriptors")
endif()

# The aliases omit arity and reservation metadata; inherit it by opcode.
string(REGEX MATCHALL "\\{\"[^\"]+\",[ \t]*OP_[A-Za-z0-9_]+\\}"
    cpp_alias_rows "${intrinsic_header}")
foreach(row IN LISTS cpp_alias_rows)
    if (row MATCHES "^\\{\"([^\"]+)\",[ \t]*(OP_[A-Za-z0-9_]+)\\}$")
        set(name "${CMAKE_MATCH_1}")
        set(opcode "${CMAKE_MATCH_2}")
        string(SHA256 key "${name}")
        if (DEFINED "cpp_intrinsic_${key}" OR
            NOT DEFINED "cpp_intrinsic_by_opcode_${opcode}")
            message(FATAL_ERROR "Invalid C++ intrinsic alias: ${name}")
        endif()
        set("cpp_intrinsic_${key}" "${opcode}|${cpp_intrinsic_by_opcode_${opcode}}")
        set("cpp_intrinsic_name_${key}" "${name}")
        list(APPEND cpp_intrinsic_keys "${key}")
        math(EXPR cpp_intrinsic_count "${cpp_intrinsic_count} + 1")
    endif()
endforeach()

file(STRINGS "${VPP_ROOT}/gói/biên dịch/nội tại.vi" vpp_intrinsic_lines
    REGEX "^[ \t]*ca \"" ENCODING UTF-8)
set(vpp_intrinsic_count 0)
foreach(line IN LISTS vpp_intrinsic_lines)
    if (line MATCHES "^[ \t]*ca \"([^\"]+)\".*biên dịch mã thao tác\\(\"(OP_[A-Za-z0-9_]+)\"\\),[ \t]*([0-9]+),[ \t]*(đúng|sai)")
        set(name "${CMAKE_MATCH_1}")
        set(actual "${CMAKE_MATCH_2}|${CMAKE_MATCH_3}|${CMAKE_MATCH_4}")
        string(SHA256 key "${name}")
        if (NOT DEFINED "cpp_intrinsic_${key}")
            message(FATAL_ERROR "V++ intrinsic not found in C++ ABI: ${name}")
        endif()
        if (NOT actual STREQUAL "${cpp_intrinsic_${key}}")
            message(FATAL_ERROR "Intrinsic ABI mismatch ${name}: V++=${actual}, C++=${cpp_intrinsic_${key}}")
        endif()
        if (DEFINED "vpp_intrinsic_${key}")
            message(FATAL_ERROR "Duplicate V++ intrinsic: ${name}")
        endif()
        set("vpp_intrinsic_${key}" TRUE)
        math(EXPR vpp_intrinsic_count "${vpp_intrinsic_count} + 1")
    endif()
endforeach()
foreach(key IN LISTS cpp_intrinsic_keys)
    if (NOT DEFINED "vpp_intrinsic_${key}")
        message(FATAL_ERROR "C++ intrinsic missing in V++: ${cpp_intrinsic_name_${key}}")
    endif()
endforeach()
if (NOT vpp_intrinsic_count EQUAL cpp_intrinsic_count)
    message(FATAL_ERROR "Intrinsic count mismatch: V++=${vpp_intrinsic_count}, C++=${cpp_intrinsic_count}")
endif()
message(STATUS "V++ intrinsic ABI: all ${vpp_intrinsic_count} entries agree with C++")
