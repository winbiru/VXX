# Cross-check the compiler, artifact validator, AOT lowerer and standalone VM.
# The retired Stage 0 C++ headers are no longer an input to the V++/ASM build.
cmake_minimum_required(VERSION 3.20)
if(NOT DEFINED VPP_ROOT)
    message(FATAL_ERROR "VPP_ROOT is required")
endif()
file(STRINGS "${VPP_ROOT}/gói/biên dịch/mã thao tác.vi" opcode_rows ENCODING UTF-8)
set(opcodes)
set(numbers)
set(known_numbers)
foreach(row IN LISTS opcode_rows)
    if(row MATCHES "^[ \t]*ca \"(OP_[A-Za-z0-9_]+)\":.*trả về ([0-9]+);")
        set(opcode "${CMAKE_MATCH_1}")
        set(number "${CMAKE_MATCH_2}")
        if(DEFINED "vpp_${opcode}" OR number IN_LIST numbers)
            message(FATAL_ERROR "Duplicate opcode name or number: ${opcode}=${number}")
        endif()
        set("vpp_${opcode}" "${number}")
        list(APPEND opcodes "${opcode}")
        list(APPEND numbers "${number}")
    elseif(row MATCHES "^[ \t]*ca ([0-9]+):.*trả về đúng;")
        set(number "${CMAKE_MATCH_1}")
        if(number IN_LIST known_numbers)
            message(FATAL_ERROR "Duplicate artifact opcode: ${number}")
        endif()
        list(APPEND known_numbers "${number}")
    endif()
endforeach()
list(LENGTH opcodes opcode_count)
if(opcode_count LESS 50)
    message(FATAL_ERROR "Could not read V++ opcode mappings")
endif()
list(SORT numbers)
list(SORT known_numbers)
if(NOT numbers STREQUAL known_numbers)
    message(FATAL_ERROR "Artifact opcode allowlist differs from V++ opcode mappings")
endif()
message(STATUS "V++ opcode ABI: ${opcode_count} unique mappings match artifact validation")

# Aliases may share an opcode, but their arity and reservation must agree.
file(STRINGS "${VPP_ROOT}/gói/biên dịch/nội tại.vi" intrinsic_rows
    REGEX "^[ \t]*ca \"" ENCODING UTF-8)
set(intrinsic_opcodes)
set(intrinsic_count 0)
foreach(row IN LISTS intrinsic_rows)
    if(NOT row MATCHES "^[ \t]*ca \"([^\"]+)\".*biên dịch mã thao tác\\(\"(OP_[A-Za-z0-9_]+)\"\\),[ \t]*([0-9]+),[ \t]*(đúng|sai)")
        message(FATAL_ERROR "Malformed V++ intrinsic descriptor: ${row}")
    endif()
    set(name "${CMAKE_MATCH_1}")
    set(opcode "${CMAKE_MATCH_2}")
    set(metadata "${CMAKE_MATCH_3}|${CMAKE_MATCH_4}")
    string(SHA256 key "${name}")
    if(DEFINED "intrinsic_${key}" OR NOT DEFINED "vpp_${opcode}")
        message(FATAL_ERROR "Duplicate intrinsic or unknown opcode: ${name} (${opcode})")
    endif()
    if(DEFINED "intrinsic_by_opcode_${opcode}" AND
       NOT "${intrinsic_by_opcode_${opcode}}" STREQUAL metadata)
        message(FATAL_ERROR "Intrinsic aliases disagree on arity/reservation: ${opcode}")
    endif()
    set("intrinsic_${key}" TRUE)
    set("intrinsic_by_opcode_${opcode}" "${metadata}")
    list(APPEND intrinsic_opcodes "${opcode}")
    math(EXPR intrinsic_count "${intrinsic_count} + 1")
endforeach()
if(intrinsic_count LESS 40)
    message(FATAL_ERROR "Could not read V++ intrinsic descriptors")
endif()
list(REMOVE_DUPLICATES intrinsic_opcodes)
list(SORT intrinsic_opcodes)

file(READ "${VPP_ROOT}/gói/biên dịch/asm chương trình.vi" aot_source)
string(FIND "${aot_source}" "BEGIN native intrinsic opcodes" aot_begin)
string(FIND "${aot_source}" "END native intrinsic opcodes" aot_end)
if(aot_begin LESS 0 OR aot_end LESS aot_begin)
    message(FATAL_ERROR "V++ AOT intrinsic table markers missing")
endif()
math(EXPR aot_length "${aot_end} - ${aot_begin}")
string(SUBSTRING "${aot_source}" ${aot_begin} ${aot_length} aot_table)
string(REGEX MATCHALL "OP_[A-Za-z0-9_]+" aot_opcodes "${aot_table}")
list(SORT aot_opcodes)
if(NOT intrinsic_opcodes STREQUAL aot_opcodes)
    message(FATAL_ERROR "V++ native AOT intrinsic table differs from intrinsic descriptors")
endif()

# The VM has independent numeric IDs and arities; compare both, not only names.
file(STRINGS "${VPP_ROOT}/gói/máy ảo/host ABI.vi" host_rows
    REGEX "// OP_" ENCODING UTF-8)
set(host_opcodes)
foreach(row IN LISTS host_rows)
    if(NOT row MATCHES "op == ([0-9]+).*trả về ([0-9]+).*// (OP_[A-Za-z0-9_]+)")
        message(FATAL_ERROR "Malformed ASM VM host ABI row: ${row}")
    endif()
    set(number "${CMAKE_MATCH_1}")
    set(arity "${CMAKE_MATCH_2}")
    set(opcode "${CMAKE_MATCH_3}")
    if(opcode IN_LIST host_opcodes OR NOT DEFINED "intrinsic_by_opcode_${opcode}" OR
       NOT number STREQUAL "${vpp_${opcode}}" OR
       NOT "${intrinsic_by_opcode_${opcode}}" MATCHES "^${arity}[|]")
        message(FATAL_ERROR "ASM VM host ABI mismatch or duplicate: ${opcode}")
    endif()
    list(APPEND host_opcodes "${opcode}")
endforeach()
list(SORT host_opcodes)
if(NOT host_opcodes STREQUAL intrinsic_opcodes)
    message(FATAL_ERROR "ASM VM host ABI opcode set differs from intrinsic descriptors")
endif()
list(LENGTH host_opcodes host_count)
message(STATUS "V++ intrinsic ABI: ${intrinsic_count} names, ${host_count} opcodes agree across AOT and VM")
