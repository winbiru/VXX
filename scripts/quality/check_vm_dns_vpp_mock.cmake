cmake_minimum_required(VERSION 3.15)
set(server "${VPP_OUTPUT_DIR}/vm-dns-mock")
if(WIN32)
    string(APPEND server ".exe")
endif()
vpp_raw_build("${VPP_ROOT}/scripts/test/fixtures/native_dns_mock.vi" "${server}")
foreach(mode IN ITEMS 0 1 2 3 4 10 11 12)
    set(queries 1)
    if(mode LESS 4)
        set(queries 2)
    endif()
    # Full resolver asks both A and AAAA after the unreachable server.
    if(mode EQUAL 4)
        set(queries 2)
    endif()
    set(work "${VPP_OUTPUT_DIR}/vm-dns-mode-${mode}")
    if(WIN32)
        execute_process(COMMAND "${CMAKE_COMMAND}" -E env
            "VPP_VM_DNS_PROVIDER=${provider}"
            "${VPP_PYTHON}" "${VPP_ROOT}/scripts/quality/run_vm_dns_mock.py"
            "${server}" "${VPP_VM}" "${dns_image}" "${mode}" "${queries}" "${work}"
            RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 40)
    else()
        execute_process(COMMAND "${CMAKE_COMMAND}" -E env
            "VPP_VM_DNS_PROVIDER=${provider}"
            sh "${VPP_ROOT}/scripts/quality/run_dns_vpp_mock.sh"
            "${server}" "${VPP_VM}" "${dns_image}" "${mode}" "${queries}" "${work}" asm
            RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 30)
    endif()
    if(status STREQUAL "77")
        message(FATAL_ERROR "VM DNS mock: loopback bind denied (exit 77)")
    endif()
    if(NOT status STREQUAL "0")
        set(client_error "")
        foreach(log IN ITEMS client.err client.stderr server.err)
            if(EXISTS "${work}/${log}")
                file(READ "${work}/${log}" diagnostic)
                string(APPEND client_error "\n${diagnostic}")
            endif()
        endforeach()
        message(FATAL_ERROR "VM DNS mock mode=${mode}: ${status}\n${output}\n${errors}\n${client_error}")
    endif()
    if(mode GREATER_EQUAL 10)
        if(NOT output STREQUAL "VPP DNS VM REJECTED\n")
            message(FATAL_ERROR "VM accepted malformed DNS: ${output}")
        endif()
    else()
        string(REGEX MATCHALL "[^\r\n]+" lines "${output}")
        list(POP_BACK lines marker)
        list(LENGTH lines count)
        set(expected 2)
        if(mode EQUAL 2)
            set(expected 0)
        elseif(mode EQUAL 3)
            set(expected 1)
        endif()
        if(NOT marker STREQUAL "DNS VM VI OK" OR NOT count EQUAL expected)
            message(FATAL_ERROR "VM DNS addresses/count: ${output}")
        endif()
        if(count GREATER 0 AND NOT "203.0.113.47" IN_LIST lines)
            message(FATAL_ERROR "VM DNS lost IPv4 result: ${output}")
        endif()
        if(count EQUAL 2 AND NOT "2001:db8::1" IN_LIST lines AND
            NOT "2001:db8:0:0:0:0:0:1" IN_LIST lines AND
            NOT "2001:0db8:0000:0000:0000:0000:0000:0001" IN_LIST lines)
            message(FATAL_ERROR "VM DNS lost IPv6 result: ${output}")
        endif()
    endif()
endforeach()
message(STATUS "VM V++ DNS: UDP, fragmented TCP, NXDOMAIN, partial, failover and malformed packets PASS")
