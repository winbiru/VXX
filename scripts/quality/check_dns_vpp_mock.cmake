foreach(required IN ITEMS VPP_EXEC VPP_STAGE1 VPP_NATIVE_COMPILER VPP_ROOT VPP_OUTPUT_DIR)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "V++ DNS mock missing ${required}")
    endif()
endforeach()
file(MAKE_DIRECTORY "${VPP_OUTPUT_DIR}")
set(ENV{VPP_HOME} "${VPP_ROOT}")
set(server "${VPP_OUTPUT_DIR}/dns-mock")
set(client "${VPP_OUTPUT_DIR}/dns-client")
execute_process(COMMAND "${VPP_STAGE1}" build
    "${VPP_ROOT}/src/tests/fixtures/native_dns_mock.vi" -o "${server}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 180)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "V++/ASM DNS mock build: ${status}\n${output}\n${errors}")
endif()
set(source "${VPP_ROOT}/src/tests/kiem_tra_dns_vpp_mock.vi")
execute_process(COMMAND "${VPP_NATIVE_COMPILER}" build "${source}" -o "${client}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 240)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "V++ DNS mock client build: ${status}\n${output}\n${errors}")
endif()
foreach(backend IN ITEMS cpp jit native)
    set(jit 0)
    set(executable "${VPP_EXEC}")
    set(choice cpp)
    if(backend STREQUAL "jit")
        set(jit 1)
    elseif(backend STREQUAL "native")
        set(choice exe)
        set(executable "${client}")
    endif()
    foreach(mode IN ITEMS 0 1 2 3 4 10 11 12 13 14 15 16 17 20 21 30 31 32 33 34 35 36 37)
        set(queries 1)
        if(mode EQUAL 0 OR mode EQUAL 1 OR mode EQUAL 3 OR mode EQUAL 20 OR mode EQUAL 21)
            set(queries 2)
        endif()
        set(work "${VPP_OUTPUT_DIR}/${backend}-${mode}")
        execute_process(COMMAND "${CMAKE_COMMAND}" -E env "VPP_ENABLE_JIT=${jit}"
            sh "${VPP_ROOT}/scripts/quality/run_dns_vpp_mock.sh"
            "${server}" "${executable}" "${source}" "${mode}" "${queries}" "${work}" "${choice}"
            RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 20)
        if(status STREQUAL "77")
            message(STATUS "DNS MOCK SKIP: loopback bind denied")
            return()
        endif()
        if(NOT status STREQUAL "0" OR NOT output STREQUAL "VPP DNS MOCK OK\n")
            if(EXISTS "${work}/client.err")
                file(READ "${work}/client.err" client_error)
            endif()
            message(FATAL_ERROR "V++ DNS mock ${backend}/${mode}: ${status}\n${output}\n${errors}\n${client_error}")
        endif()
    endforeach()
endforeach()
message(STATUS "V++/ASM DNS mock: 23 modes x interpreter/JIT/native PASS")
