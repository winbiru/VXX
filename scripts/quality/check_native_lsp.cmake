cmake_minimum_required(VERSION 3.19)
foreach(required IN ITEMS VPP_CLI VPP_NATIVE_COMPILER VPP_ROOT VPP_OUTPUT_DIR VPP_LSP_MODE)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "LSP check missing ${required}")
    endif()
endforeach()
file(MAKE_DIRECTORY "${VPP_OUTPUT_DIR}")
set(wire "")
function(packet body)
    string(CONFIGURE "${body}" body @ONLY)
    # CMake counts bytes, matching LSP's UTF-8 Content-Length.
    string(LENGTH "${body}" size)
    set(wire "${wire}Content-Length: ${size}\r\n\r\n${body}" PARENT_SCOPE)
endfunction()
function(expect_json document expected)
    string(JSON actual ERROR_VARIABLE error GET "${document}" ${ARGN})
    if(error OR NOT actual STREQUAL expected)
        message(FATAL_ERROR "Unexpected LSP JSON at ${ARGN}: ${error}\n${document}\nExpected: ${expected}")
    endif()
endfunction()
function(file_uri path)
    string(HEX "${path}" bytes)
    string(LENGTH "${bytes}" size)
    set(encoded "")
    set(i 0)
    while(i LESS size)
        string(SUBSTRING "${bytes}" ${i} 2 byte)
        math(EXPR decimal "0x${byte}")
        string(ASCII ${decimal} character)
        if(character MATCHES "^[A-Za-z0-9/_.:~-]$")
            string(APPEND encoded "${character}")
        else()
            string(TOUPPER "${byte}" byte)
            string(APPEND encoded "%${byte}")
        endif()
        math(EXPR i "${i} + 2")
    endwhile()
    if(path MATCHES "^/")
        set(uri "file://${encoded}" PARENT_SCOPE)
    else()
        set(uri "file:///${encoded}" PARENT_SCOPE)
    endif()
endfunction()

packet([=[{"jsonrpc":"2.0","id":1,"method":"initialize","params":{}}]=])
if(VPP_LSP_MODE STREQUAL "format")
    set(uri "file:///private/tmp/vpp-lsp-unsaved-buffer.vi")
    packet([=[{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"@uri@","languageId":"vpp","version":1,"text":"hàm chính(){in \"chào 🌿\";};"}}}]=])
    packet([=[{"jsonrpc":"2.0","id":2,"method":"textDocument/formatting","params":{"textDocument":{"uri":"@uri@"},"options":{"tabSize":4,"insertSpaces":true}}}]=])
    packet([=[{"jsonrpc":"2.0","method":"textDocument/didChange","params":{"textDocument":{"uri":"@uri@","version":2},"contentChanges":[{"text":"in \"chưa đóng;"}]}}]=])
    packet([=[{"jsonrpc":"2.0","id":3,"method":"textDocument/formatting","params":{"textDocument":{"uri":"@uri@"},"options":{"tabSize":4,"insertSpaces":true}}}]=])
    packet([=[{"jsonrpc":"2.0","id":4,"method":"shutdown"}]=])
elseif(VPP_LSP_MODE STREQUAL "diagnostics")
    set(document "${VPP_OUTPUT_DIR}/mã thử.vi")
    file(WRITE "${document}" "hàm sai( {\n")
    file(WRITE "${VPP_OUTPUT_DIR}/phụ trợ.vi" "hàm hỗ trợ() { trả về 1; };\n")
    file_uri("${document}")
    packet([=[{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"@uri@","languageId":"vpp","version":1,"text":"nhập phụ trợ;\nhàm chính() { in 1; };\n"}}}]=])
    packet([=[{"jsonrpc":"2.0","method":"textDocument/didChange","params":{"textDocument":{"uri":"@uri@","version":2},"contentChanges":[{"text":"in \"🌿\"; hàm f() {}; hàm f() {};\n"}]}}]=])
    packet([=[{"jsonrpc":"2.0","method":"textDocument/didChange","params":{"textDocument":{"uri":"@uri@","version":3},"contentChanges":[{"text":"nhập chưa tồn tại;\n"}]}}]=])
    packet([=[{"jsonrpc":"2.0","method":"textDocument/didClose","params":{"textDocument":{"uri":"@uri@"}}}]=])
    packet([=[{"jsonrpc":"2.0","id":2,"method":"shutdown"}]=])
else()
    message(FATAL_ERROR "Unknown LSP check mode: ${VPP_LSP_MODE}")
endif()
packet([=[{"jsonrpc":"2.0","method":"exit"}]=])
set(input "${VPP_OUTPUT_DIR}/requests.lsp")
set(output "${VPP_OUTPUT_DIR}/responses.lsp")
file(WRITE "${input}" "${wire}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E env "VPP_HOME=${VPP_ROOT}"
    "VPP_NATIVE_COMPILER=${VPP_NATIVE_COMPILER}" "${VPP_CLI}" --lsp
    INPUT_FILE "${input}" OUTPUT_FILE "${output}"
    RESULT_VARIABLE status ERROR_VARIABLE errors TIMEOUT 120)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "LSP exited ${status}: ${errors}")
endif()
# Both normal file(READ) and OUTPUT_VARIABLE normalize CRLF. Decode HEX so
# framing and Content-Length are checked against the actual wire bytes.
file(READ "${output}" bytes HEX)
string(LENGTH "${bytes}" size)
set(data "")
set(i 0)
while(i LESS size)
    string(SUBSTRING "${bytes}" ${i} 2 byte)
    math(EXPR decimal "0x${byte}")
    if(decimal EQUAL 0)
        message(FATAL_ERROR "NUL byte in LSP stream")
    endif()
    string(ASCII ${decimal} character)
    string(APPEND data "${character}")
    math(EXPR i "${i} + 2")
endwhile()
set(published 0)
set(formatted FALSE)
set(format_error FALSE)
set(shutdown FALSE)
while(NOT data STREQUAL "")
    string(FIND "${data}" "\r\n\r\n" separator)
    if(separator LESS 0)
        message(FATAL_ERROR "Missing LSP CRLF header separator")
    endif()
    string(SUBSTRING "${data}" 0 ${separator} header)
    if(NOT header MATCHES "^Content-Length: ([0-9]+)$")
        message(FATAL_ERROR "Invalid LSP header: ${header}")
    endif()
    set(size "${CMAKE_MATCH_1}")
    math(EXPR start "${separator} + 4")
    string(LENGTH "${data}" available)
    math(EXPR end "${start} + ${size}")
    if(end GREATER available)
        message(FATAL_ERROR "Truncated LSP payload")
    endif()
    string(SUBSTRING "${data}" ${start} ${size} body)
    string(SUBSTRING "${data}" ${end} -1 data)
    string(JSON kind ERROR_VARIABLE error TYPE "${body}")
    if(error OR NOT kind STREQUAL "OBJECT")
        message(FATAL_ERROR "Invalid LSP JSON: ${error}\n${body}")
    endif()
    string(JSON id ERROR_VARIABLE no_id GET "${body}" id)
    if(NOT no_id)
        if(VPP_LSP_MODE STREQUAL "format")
            if(id EQUAL 2)
                string(JSON count LENGTH "${body}" result)
                if(NOT count EQUAL 1)
                    message(FATAL_ERROR "Expected one formatting edit")
                endif()
                expect_json("${body}" "hàm chính() {\n    in \"chào 🌿\";\n}\n;\n" result 0 newText)
                set(formatted TRUE)
            elseif(id EQUAL 3)
                expect_json("${body}" "-32603" error code)
                set(format_error TRUE)
            elseif(id EQUAL 4)
                string(JSON kind TYPE "${body}" result)
                if(NOT kind STREQUAL "NULL")
                    message(FATAL_ERROR "LSP shutdown failed")
                endif()
                set(shutdown TRUE)
            endif()
        elseif(id EQUAL 2)
            string(JSON kind TYPE "${body}" result)
            if(NOT kind STREQUAL "NULL")
                message(FATAL_ERROR "LSP shutdown failed")
            endif()
            set(shutdown TRUE)
        endif()
    else()
        string(JSON method ERROR_VARIABLE no_method GET "${body}" method)
        if(NOT no_method AND method STREQUAL "textDocument/publishDiagnostics")
            if(VPP_LSP_MODE STREQUAL "diagnostics")
                expect_json("${body}" "${uri}" params uri)
                string(JSON count LENGTH "${body}" params diagnostics)
                if(published EQUAL 0 OR published EQUAL 3)
                    if(NOT count EQUAL 0)
                        message(FATAL_ERROR "Unsaved valid source/didClose produced diagnostics")
                    endif()
                elseif(published EQUAL 1 OR published EQUAL 2)
                    if(NOT count EQUAL 1)
                        message(FATAL_ERROR "Expected one native diagnostic")
                    endif()
                    string(JSON message GET "${body}" params diagnostics 0 message)
                    if(published EQUAL 1)
                        if(NOT message MATCHES "trùng khai báo hàm")
                            message(FATAL_ERROR "Missing semantic diagnostic: ${message}")
                        endif()
                        # The second hàm starts at UTF-16 unit 21, including 🌿.
                        expect_json("${body}" "0" params diagnostics 0 range start line)
                        expect_json("${body}" "21" params diagnostics 0 range start character)
                    elseif(NOT message MATCHES "không tìm thấy import")
                        message(FATAL_ERROR "Missing import diagnostic: ${message}")
                    endif()
                else()
                    message(FATAL_ERROR "Unexpected extra diagnostic notification")
                endif()
            endif()
            math(EXPR published "${published} + 1")
        endif()
    endif()
endwhile()
if(VPP_LSP_MODE STREQUAL "format")
    if(NOT formatted OR NOT format_error OR NOT shutdown)
        message(FATAL_ERROR "Missing formatting/error/shutdown response")
    endif()
else()
    file(READ "${document}" disk_source)
    if(NOT published EQUAL 4 OR NOT shutdown OR NOT disk_source STREQUAL "hàm sai( {\n")
        message(FATAL_ERROR "LSP diagnostics count, shutdown or read-only check failed")
    endif()
endif()
message(STATUS "Native LSP ${VPP_LSP_MODE}: raw framing, Unicode, unsaved buffers and shutdown PASS")
