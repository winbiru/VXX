foreach(required IN ITEMS VPP_EXEC VPP_ROOT VPP_REPORT VPP_OUTPUT_DIR)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Benchmark comparator missing ${required}")
    endif()
endforeach()
get_filename_component(VPP_REPORT "${VPP_REPORT}" ABSOLUTE)
file(MAKE_DIRECTORY "${VPP_OUTPUT_DIR}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E env "VPP_HOME=${VPP_ROOT}"
    "VPP_BENCHMARK_REPORT=${VPP_REPORT}"
    "${VPP_EXEC}" run "${VPP_ROOT}/scripts/quality/compare_benchmarks.vi"
    RESULT_VARIABLE status OUTPUT_VARIABLE result ERROR_VARIABLE errors TIMEOUT 240)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "V++ comparator execution: ${status}\n${result}\n${errors}")
endif()
string(JSON decision ERROR_VARIABLE error GET "${result}" status)
if(error)
    message(FATAL_ERROR "V++ comparator returned invalid JSON: ${error}")
endif()
set(code 3)
if(decision STREQUAL "PASS")
    set(code 0)
elseif(decision STREQUAL "FAIL")
    set(code 1)
elseif(decision STREQUAL "INCONCLUSIVE")
    set(code 2)
elseif(NOT decision STREQUAL "INVALID")
    message(FATAL_ERROR "Unknown benchmark decision: ${decision}")
endif()
file(WRITE "${VPP_OUTPUT_DIR}/status" "${code}\n")
file(WRITE "${VPP_OUTPUT_DIR}/comparison.json" "${result}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E cat "${VPP_OUTPUT_DIR}/comparison.json")
