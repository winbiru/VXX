foreach(required IN ITEMS VPP_EXEC VPP_NATIVE_COMPILER VPP_ROOT VPP_OUTPUT_DIR VPP_FIXTURE VPP_EXPECTED)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "V++ quality tool missing ${required}")
    endif()
endforeach()
file(MAKE_DIRECTORY "${VPP_OUTPUT_DIR}")
set(ENV{VPP_HOME} "${VPP_ROOT}")
if(VPP_FIXTURE STREQUAL "scripts/quality/test_benchmark_gate.vi")
    file(MAKE_DIRECTORY "${VPP_OUTPUT_DIR}/reports")
    set(ENV{VPP_BENCHMARK_FIXTURES} "${VPP_OUTPUT_DIR}/reports")
endif()
set(source "${VPP_ROOT}/${VPP_FIXTURE}")
execute_process(COMMAND "${VPP_EXEC}" run --compiler=cpp "${source}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 120)
if(NOT status STREQUAL "0" OR NOT output STREQUAL "${VPP_EXPECTED}\n")
    message(FATAL_ERROR "V++ quality tool interpreter: ${status}\n${output}\n${errors}")
endif()
set(program "${VPP_OUTPUT_DIR}/quality-tool${VPP_EXECUTABLE_SUFFIX}")
execute_process(COMMAND "${VPP_NATIVE_COMPILER}" build "${source}" -o "${program}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 240)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "V++ quality tool native build: ${status}\n${output}\n${errors}")
endif()
execute_process(COMMAND "${program}" RESULT_VARIABLE status
    OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 120)
if(NOT status STREQUAL "0" OR NOT output STREQUAL "${VPP_EXPECTED}\n")
    message(FATAL_ERROR "V++ quality tool native execution: ${status}\n${output}\n${errors}")
endif()
message(STATUS "${VPP_EXPECTED}: interpreter and standalone native PASS")
if(VPP_FIXTURE STREQUAL "scripts/quality/test_benchmark_gate.vi" AND UNIX)
    set(code 0)
    foreach(decision IN ITEMS pass fail inconclusive invalid)
        execute_process(COMMAND "${CMAKE_COMMAND}" -E env "VPP_EXEC=${VPP_EXEC}"
            sh "${VPP_ROOT}/scripts/quality/compare_benchmarks.sh"
            "${VPP_OUTPUT_DIR}/reports/${decision}.json"
            RESULT_VARIABLE status OUTPUT_VARIABLE result ERROR_VARIABLE errors TIMEOUT 240)
        if(NOT status STREQUAL "${code}")
            message(FATAL_ERROR "V++ comparator CLI ${decision}: ${status}, expected ${code}\n${result}\n${errors}")
        endif()
        math(EXPR code "${code} + 1")
    endforeach()
    message(STATUS "V++ comparator CLI exit statuses 0/1/2/3 PASS")
endif()
