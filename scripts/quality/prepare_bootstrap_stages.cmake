# Package the V++ bootstrap module graph without a Python dependency.
# Inputs: VPP_ROOT, VPP_STAGE1_SOURCE, VPP_STAGE2_SOURCE.
foreach(required IN ITEMS VPP_ROOT VPP_STAGE1_SOURCE VPP_STAGE2_SOURCE)
    if (NOT DEFINED ${required})
        message(FATAL_ERROR "bootstrap graph: missing ${required}")
    endif()
endforeach()

function(vpp_imports source out)
    string(REGEX MATCHALL "(^|\n)[ \t]*(công[ \t]+khai[ \t]+)?nhập[ \t]+[^;\n]+" matches "${source}")
    set(imports)
    foreach(declaration IN LISTS matches)
        string(REGEX MATCH "nhập[ \t]+[^;\n]+" match "${declaration}")
        if (NOT match)
            message(FATAL_ERROR "bootstrap graph: cannot parse import ${declaration}")
        endif()
        string(REGEX REPLACE "^nhập[ \t]+" "" spec "${match}")
        string(REGEX REPLACE "[ \t]+như[ \t]+.*$" "" spec "${spec}")
        string(STRIP "${spec}" spec)
        list(APPEND imports "${spec}")
    endforeach()
    set(${out} "${imports}" PARENT_SCOPE)
endfunction()

function(vpp_visit module)
    get_property(visited GLOBAL PROPERTY VPP_GRAPH_MODULES)
    list(FIND visited "${module}" found)
    if (NOT found EQUAL -1)
        return()
    endif()
    get_property(active GLOBAL PROPERTY VPP_GRAPH_ACTIVE)
    list(FIND active "${module}" in_progress)
    if (NOT in_progress EQUAL -1)
        message(FATAL_ERROR "circular bootstrap import: ${module}")
    endif()
    list(APPEND active "${module}")
    set_property(GLOBAL PROPERTY VPP_GRAPH_ACTIVE "${active}")

    set(path "${VPP_ROOT}/${module}.vi")
    if (NOT EXISTS "${path}")
        message(FATAL_ERROR "bootstrap import missing: ${module}")
    endif()
    file(READ "${path}" content)
    if (content MATCHES "(^|\n)[ \t]*ngoại[ \t]+(hàm|thư[ \t]+viện)")
        message(FATAL_ERROR "Stage 2 cannot compile foreign declarations: ${module}")
    endif()

    get_filename_component(module_dir "${module}" DIRECTORY)
    vpp_imports("${content}" imported)
    foreach(spec IN LISTS imported)
        if (spec MATCHES "^\\.")
            get_filename_component(full "${VPP_ROOT}/${module_dir}/${spec}" ABSOLUTE)
            file(RELATIVE_PATH target "${VPP_ROOT}" "${full}")
        else()
            set(target "${spec}")
        endif()
        vpp_visit("${target}")
        if (spec MATCHES "^gói/")
            file(RELATIVE_PATH relative "${VPP_ROOT}/${module_dir}" "${VPP_ROOT}/${spec}")
            string(REPLACE "nhập ${spec}" "nhập ${relative}" content "${content}")
        endif()
    endforeach()

    string(SHA256 id "${module}")
    set_property(GLOBAL PROPERTY "VPP_GRAPH_CODE_${id}" "${content}")
    get_property(visited GLOBAL PROPERTY VPP_GRAPH_MODULES)
    list(APPEND visited "${module}")
    set_property(GLOBAL PROPERTY VPP_GRAPH_MODULES "${visited}")
    get_property(active GLOBAL PROPERTY VPP_GRAPH_ACTIVE)
    list(REMOVE_ITEM active "${module}")
    set_property(GLOBAL PROPERTY VPP_GRAPH_ACTIVE "${active}")
endfunction()

file(READ "${VPP_STAGE2_SOURCE}" stage2_code)
vpp_imports("${stage2_code}" imported)
foreach(spec IN LISTS imported)
    vpp_visit("${spec}")
endforeach()
set_property(GLOBAL PROPERTY "VPP_GRAPH_CODE_stage2" "${stage2_code}")
get_property(modules GLOBAL PROPERTY VPP_GRAPH_MODULES)
list(APPEND modules stage2)
list(SORT modules)

get_filename_component(out_dir "${VPP_STAGE1_SOURCE}" DIRECTORY)
file(MAKE_DIRECTORY "${out_dir}")
file(WRITE "${VPP_STAGE1_SOURCE}" "// Bootstrap: source graph prepared by CMake, compiled in V++.\nnhập gói/biên dịch/sản phẩm biên dịch;\nnhập gói/biên dịch/liên kết;\n\n")
set(assignments "    nguồn = {};\n")
set(index 0)
foreach(module IN LISTS modules)
    if (module STREQUAL "stage2")
        set(id stage2)
    else()
        string(SHA256 id "${module}")
    endif()
    get_property(content GLOBAL PROPERTY "VPP_GRAPH_CODE_${id}")
    file(APPEND "${VPP_STAGE1_SOURCE}" "hàm __bootstrap_nguon_${index}() {\n    nội_dung = \"\";\n")
    string(LENGTH "${content}" size)
    string(HEX "${content}" code_hex)
    set(start 0)
    while (start LESS size)
        math(EXPR finish "${start} + 512")
        if (finish GREATER size)
            set(finish ${size})
        else()
            # Never divide a UTF-8 code point between two V++ string tokens.
            math(EXPR byte_pos "${finish} * 2")
            string(SUBSTRING "${code_hex}" ${byte_pos} 2 next_byte)
            while (next_byte MATCHES "^[89aAbB]")
                math(EXPR finish "${finish} - 1")
                math(EXPR byte_pos "${finish} * 2")
                string(SUBSTRING "${code_hex}" ${byte_pos} 2 next_byte)
            endwhile()
        endif()
        math(EXPR length "${finish} - ${start}")
        string(SUBSTRING "${content}" ${start} ${length} chunk)
        string(REPLACE "\\" "\\\\" chunk "${chunk}")
        string(REPLACE "\"" "\\\"" chunk "${chunk}")
        string(REPLACE "\n" "\\n" chunk "${chunk}")
        string(REPLACE "\r" "\\r" chunk "${chunk}")
        string(REPLACE "\t" "\\t" chunk "${chunk}")
        file(APPEND "${VPP_STAGE1_SOURCE}" "    nội_dung += \"${chunk}\";\n")
        set(start ${finish})
    endwhile()
    file(APPEND "${VPP_STAGE1_SOURCE}" "    trả về nội_dung;\n};\n\n")
    string(REPLACE "\\" "\\\\" key "${module}")
    string(REPLACE "\"" "\\\"" key "${key}")
    string(APPEND assignments "    nguồn[\"${key}\"] = __bootstrap_nguon_${index}();\n")
    math(EXPR index "${index} + 1")
endforeach()
file(APPEND "${VPP_STAGE1_SOURCE}" "hàm chính() {\n${assignments}    in biên dịch sản phẩm biên dịch tuần tự(\n        biên dịch chương trình mô đun tự chủ(\"stage2\", nguồn));\n};\n")
message(STATUS "Stage 1 graph: ${index} V++ modules -> ${VPP_STAGE1_SOURCE}")
