#!/usr/bin/env sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
ROOT_DIR=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
MANIFEST="$ROOT_DIR/vpp-language.json"

NAME="vpp-language"
DISPLAY_NAME="V++ Language"
VERSION="0.0.1"
PUBLISHER="vpp"
LANGUAGE_ID="vpp"
EXTENSION_ID="$PUBLISHER.$NAME-$VERSION"

usage() {
  cat <<EOF
V++ language installer

Usage:
  vpp-lang install [--editor vscode|cursor|vscodium|all]
  vpp-lang uninstall [--editor vscode|cursor|vscodium|all]
  vpp-lang list
  vpp-lang pack
  vpp-lang self-install [--prefix DIR]
  vpp-lang self-uninstall [--prefix DIR]
  vpp-lang help

Examples:
  ./scripts/vpp-lang self-install
  vpp-lang install
  vpp-lang install --editor vscode
  vpp-lang uninstall --editor cursor
  vpp-lang pack
EOF
}

parse_prefix() {
  prefix="$HOME/.local/bin"
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --prefix)
        [ "$#" -ge 2 ] || {
          echo "Missing value after --prefix" >&2
          exit 2
        }
        prefix="$2"
        shift 2
        ;;
      --prefix=*)
        prefix=${1#--prefix=}
        shift
        ;;
      *)
        echo "Unknown argument: $1" >&2
        exit 2
        ;;
    esac
  done
}

editor_dir() {
  case "$1" in
    vscode) printf '%s\n' "$HOME/.vscode/extensions/$EXTENSION_ID" ;;
    cursor) printf '%s\n' "$HOME/.cursor/extensions/$EXTENSION_ID" ;;
    vscodium) printf '%s\n' "$HOME/.vscode-oss/extensions/$EXTENSION_ID" ;;
    *) return 1 ;;
  esac
}

all_editors() {
  printf '%s\n' vscode cursor vscodium
}

parse_editor() {
  editor="all"
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --editor)
        [ "$#" -ge 2 ] || {
          echo "Missing value after --editor" >&2
          exit 2
        }
        editor="$2"
        shift 2
        ;;
      --editor=*)
        editor=${1#--editor=}
        shift
        ;;
      *)
        echo "Unknown argument: $1" >&2
        exit 2
        ;;
    esac
  done

  case "$editor" in
    vscode|cursor|vscodium|all) ;;
    *)
      echo "Unknown editor: $editor" >&2
      exit 2
      ;;
  esac
}

write_vscode_package_json() {
  package_json_dest="$1/package.json"
  cat > "$package_json_dest" <<EOF
{
  "name": "$NAME",
  "displayName": "$DISPLAY_NAME",
  "description": "Syntax highlighting for V++",
  "version": "$VERSION",
  "publisher": "$PUBLISHER",
  "icon": "assets/icons/vpp-file.png",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "$LANGUAGE_ID",
        "aliases": ["V++", "vpp", "vietvm"],
        "extensions": [".vvm", ".vi"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./assets/icons/vpp-file.png",
          "dark": "./assets/icons/vpp-file.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "$LANGUAGE_ID",
        "scopeName": "source.vietvm",
        "path": "./syntaxes/vpp.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "label": "V++ Bright",
        "uiTheme": "vs-dark",
        "path": "./themes/vpp-bright-color-theme.json"
      }
    ]
  }
}
EOF
}

sync_workspace_settings() {
  action="$1"
  settings_path="$ROOT_DIR/.vscode/settings.json"
  theme_path="$ROOT_DIR/themes/vpp-bright-color-theme.json"

  mkdir -p "$ROOT_DIR/.vscode"

  ACTION="$action" SETTINGS_PATH="$settings_path" THEME_PATH="$theme_path" node <<'NODE'
const fs = require('fs');

const action = process.env.ACTION;
const settingsPath = process.env.SETTINGS_PATH;
const themePath = process.env.THEME_PATH;

const CLASS_SCOPE = 'storage.type.class.vietvm';
const ACCESS_SCOPE = 'storage.modifier.access.vietvm';
const VPP_SCOPES = new Set([CLASS_SCOPE, ACCESS_SCOPE]);

function readJson(path, fallback) {
  try {
    return JSON.parse(fs.readFileSync(path, 'utf8'));
  } catch {
    return fallback;
  }
}

function isVppRule(rule) {
  if (!rule || typeof rule !== 'object') {
    return false;
  }

  const scope = rule.scope;
  if (typeof scope === 'string') {
    return VPP_SCOPES.has(scope);
  }
  if (Array.isArray(scope)) {
    return scope.some((item) => typeof item === 'string' && VPP_SCOPES.has(item));
  }
  return false;
}

const settings = readJson(settingsPath, {});
const theme = readJson(themePath, { tokenColors: [] });

const tokenColorByScope = new Map();
for (const token of theme.tokenColors || []) {
  if (!token || typeof token !== 'object') {
    continue;
  }
  if (typeof token.scope !== 'string') {
    continue;
  }
  const color = token.settings && token.settings.foreground;
  if (typeof color === 'string' && color.length > 0) {
    tokenColorByScope.set(token.scope, color);
  }
}

if (action === 'install') {
  if (!settings['files.associations'] || typeof settings['files.associations'] !== 'object') {
    settings['files.associations'] = {};
  }
  settings['files.associations']['*.vi'] = 'vpp';
  settings['files.associations']['*.vvm'] = 'vpp';

  const customizations = settings['editor.tokenColorCustomizations'] || {};
  let rules = Array.isArray(customizations.textMateRules) ? customizations.textMateRules : [];
  rules = rules.filter((rule) => !isVppRule(rule));

  const classColor = tokenColorByScope.get(CLASS_SCOPE) || '#CC7832';
  const accessColor = tokenColorByScope.get(ACCESS_SCOPE) || classColor;

  rules.push({
    scope: CLASS_SCOPE,
    settings: {
      foreground: classColor,
      fontStyle: ''
    }
  });
  rules.push({
    scope: ACCESS_SCOPE,
    settings: {
      foreground: accessColor,
      fontStyle: ''
    }
  });

  customizations.textMateRules = rules;
  settings['editor.tokenColorCustomizations'] = customizations;
} else {
  if (settings['files.associations'] && typeof settings['files.associations'] === 'object') {
    delete settings['files.associations']['*.vi'];
    delete settings['files.associations']['*.vvm'];
    if (Object.keys(settings['files.associations']).length === 0) {
      delete settings['files.associations'];
    }
  }

  const customizations = settings['editor.tokenColorCustomizations'];
  if (customizations && typeof customizations === 'object' && Array.isArray(customizations.textMateRules)) {
    customizations.textMateRules = customizations.textMateRules.filter((rule) => !isVppRule(rule));

    if (customizations.textMateRules.length === 0) {
      delete customizations.textMateRules;
    }
    if (Object.keys(customizations).length === 0) {
      delete settings['editor.tokenColorCustomizations'];
    }
  }
}

fs.writeFileSync(settingsPath, `${JSON.stringify(settings, null, 2)}\n`);
console.log(`synced: ${settingsPath} (${action})`);
NODE
}

install_one() {
  editor_name="$1"
  dest=$(editor_dir "$editor_name")
  parent=$(dirname "$dest")

  if [ ! -d "$parent" ]; then
    echo "skip $editor_name: extension folder not found: $parent"
    return 1
  fi

  echo "install $NAME@$VERSION -> $editor_name"
  rm -rf "$dest"
  mkdir -p "$dest/syntaxes" "$dest/themes" "$dest/assets/icons"

  cp "$ROOT_DIR/syntaxes/vpp.tmLanguage.json" "$dest/syntaxes/vpp.tmLanguage.json"
  cp "$ROOT_DIR/themes/vpp-bright-color-theme.json" "$dest/themes/vpp-bright-color-theme.json"
  cp "$ROOT_DIR/assets/icons/vpp-file.png" "$dest/assets/icons/vpp-file.png"
  cp "$ROOT_DIR/language-configuration.json" "$dest/language-configuration.json"
  cp "$ROOT_DIR/INSTALL_EDITOR_HIGHLIGHT.md" "$dest/README.md"
  cp "$MANIFEST" "$dest/vpp-language.json"
  write_vscode_package_json "$dest"

  echo "installed: $dest"
  return 0
}

install_cmd() {
  parse_editor "$@"
  installed=0

  if [ "$editor" = "all" ]; then
    for e in $(all_editors); do
      if install_one "$e"; then
        installed=$((installed + 1))
      fi
    done
  else
    if install_one "$editor"; then
      installed=$((installed + 1))
    fi
  fi

  if [ "$installed" -eq 0 ]; then
    echo "No supported editor profile was found." >&2
    exit 1
  fi

  sync_workspace_settings install

  echo "Reload your editor window to activate V++ highlighting."
}

uninstall_one() {
  editor_name="$1"
  dest=$(editor_dir "$editor_name")
  if [ -d "$dest" ]; then
    rm -rf "$dest"
    echo "removed: $dest"
    return 0
  fi
  echo "not installed for $editor_name"
  return 1
}

uninstall_cmd() {
  parse_editor "$@"
  removed=0

  if [ "$editor" = "all" ]; then
    for e in $(all_editors); do
      if uninstall_one "$e"; then
        removed=$((removed + 1))
      fi
    done
  else
    if uninstall_one "$editor"; then
      removed=$((removed + 1))
    fi
  fi

  if [ "$removed" -gt 0 ]; then
    sync_workspace_settings uninstall
  fi

  [ "$removed" -gt 0 ] || exit 1
}

list_cmd() {
  for e in $(all_editors); do
    dest=$(editor_dir "$e")
    if [ -d "$dest" ]; then
      echo "$e: installed at $dest"
    else
      echo "$e: not installed"
    fi
  done
}

pack_cmd() {
  dist="$ROOT_DIR/dist"
  package="$dist/$NAME-$VERSION.vlang"
  mkdir -p "$dist"
  rm -f "$package"

  tar -czf "$package" \
    -C "$ROOT_DIR" \
    vpp-language.json \
    language-configuration.json \
    INSTALL_EDITOR_HIGHLIGHT.md \
    assets/icons/vpp-file.png \
    themes/vpp-bright-color-theme.json \
    syntaxes/vpp.tmLanguage.json

  echo "packed: $package"
}

self_install_cmd() {
  parse_prefix "$@"
  mkdir -p "$prefix"
  wrapper="$prefix/vpp-lang"
  cat > "$wrapper" <<EOF
#!/usr/bin/env sh
exec "$ROOT_DIR/scripts/vpp-lang" "\$@"
EOF
  chmod +x "$wrapper"
  echo "installed command: $wrapper"
  echo "Make sure this directory is in PATH: $prefix"
}

self_uninstall_cmd() {
  parse_prefix "$@"
  wrapper="$prefix/vpp-lang"
  if [ -f "$wrapper" ]; then
    rm -f "$wrapper"
    echo "removed command: $wrapper"
  else
    echo "not installed: $wrapper"
  fi
}

cmd=${1:-help}
if [ "$#" -gt 0 ]; then
  shift
fi

case "$cmd" in
  install) install_cmd "$@" ;;
  uninstall) uninstall_cmd "$@" ;;
  list) list_cmd "$@" ;;
  pack) pack_cmd "$@" ;;
  self-install) self_install_cmd "$@" ;;
  self-uninstall) self_uninstall_cmd "$@" ;;
  help|-h|--help) usage ;;
  *)
    echo "Unknown command: $cmd" >&2
    usage >&2
    exit 2
    ;;
esac
