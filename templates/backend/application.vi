nhập config;
nhập controller;
nhập router;
nhập server;

// Đại diện cho ứng dụng API đã được ghép đủ dependency và sở hữu vòng đời server.
lớp ApiApplication {
    // Nhận server hoàn chỉnh qua constructor để ứng dụng không tự tạo dependency.
    hàm khởi tạo(server) {
        mình.server = server;
    }

    // Khởi động server HTTP của instance ứng dụng hiện tại.
    hàm chạy() {
        server = mình.server;
        server.chạy();
    }
};

// Composition root của project sinh mới: dựng object graph và inject dependency.
hàm main() {
    config = tạo cấu hình api("application.properties");
    healthController = tạo health controller();
    notFoundController = tạo not found controller();
    router = tạo bộ định tuyến(healthController, notFoundController);
    port = config.cổng();
    server = tạo máy chủ api(port, router);
    application = ApiApplication(server);
    application.chạy();
};
