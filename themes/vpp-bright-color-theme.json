{
  "name": "V++ Bright",
  "type": "dark",
  "colors": {
    "editor.background": "#2B2B2B",
    "editor.foreground": "#A9B7C6"
  },
  "tokenColors": [
    {
      "scope": "comment.line.vietvm",
      "settings": {
        "foreground": "#808080",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "comment.block.vietvm",
      "settings": {
        "foreground": "#808080",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "keyword.control.vietvm",
      "settings": {
        "foreground": "#CC7832"
      }
    },
    {
      "scope": "storage.type.class.vietvm",
      "settings": {
        "foreground": "#A9B7C6",
        "fontStyle": ""
      }
    },
    {
      "scope": "storage.modifier.access.vietvm",
      "settings": {
        "foreground": "#CC7832",
        "fontStyle": ""
      }
    },
    {
      "scope": "storage.type.function.vietvm",
      "settings": {
        "foreground": "#CC7832"
      }
    },
    {
      "scope": "entity.name.type.class.vietvm",
      "settings": {
        "foreground": "#A9B7C6"
      }
    },
    {
      "scope": "entity.name.function.vietvm",
      "settings": {
        "foreground": "#FFC66D"
      }
    },
    {
      "scope": "support.function.builtin.vietvm",
      "settings": {
        "foreground": "#A9B7C6"
      }
    },
    {
      "scope": "constant.language.boolean.vietvm",
      "settings": {
        "foreground": "#CC7832"
      }
    },
    {
      "scope": "constant.numeric.vietvm",
      "settings": {
        "foreground": "#6897BB"
      }
    },
    {
      "scope": "string.quoted.double.vietvm",
      "settings": {
        "foreground": "#6A8759"
      }
    },
    {
      "scope": "string.quoted.single.vietvm",
      "settings": {
        "foreground": "#6A8759"
      }
    },
    {
      "scope": "keyword.operator.vietvm",
      "settings": {
        "foreground": "#A9B7C6"
      }
    },
    {
      "scope": "punctuation.separator.vietvm",
      "settings": {
        "foreground": "#A9B7C6"
      }
    },
    {
      "scope": "variable.vietvm",
      "settings": {
        "foreground": "#A9B7C6"
      }
    }
  ]
}
