nhập phân giải dns;
nhập gói/mạng/ổ cắm;

hàm chính() {
    kết_quả = phân giải tên miền phân giải("localhost");
    in độ dài(kết_quả) > 0;
    in độ dài(kết_quả) == độ dài(phân giải tên miền phân giải("localhost"));
    địa_chỉ = đầu nối bộ phân giải danh sách("127.0.0.1", 8080, sai);
    in độ dài(địa_chỉ) > 0;
    in địa_chỉ[0][0] == "127.0.0.1";
    in địa_chỉ[0][1] == 8080;
    in độ dài(đầu nối bộ phân giải danh sách("::1", 8080, đúng)) > 0;
    in độ dài(đầu nối bộ phân giải danh sách("127.0.0.1", 0, sai)) > 0;
};
