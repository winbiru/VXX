nhập gói/nhập xuất/chính;

hàm chính() {
    đường = ".tmp_oop_file_stream.txt";
    ghi = Luồng Tệp(đường, "ghi");
    in ghi.đang mở();
    in ghi.ghi("abc") == 1;
    in ghi.ghi("-def") == 1;
    in ghi.đóng();
    in !ghi.đang mở();
    sau_đóng = sai;
    thử { ghi.ghi("x"); } bắt lỗi(e) { sau_đóng = đúng; };
    in sau_đóng;
    đọc = Luồng Tệp(đường, "đọc");
    in đọc.đọc hết() == "abc-def";
    chỉ_đọc = sai;
    thử { đọc.ghi("x"); } bắt lỗi(e) { chỉ_đọc = đúng; };
    in chỉ_đọc;
    đọc.đóng();
    nối = Luồng Tệp(đường, "nối");
    in nối.ghi("-xyz") == 1;
    nối.đóng();
    kiểm = Luồng Tệp(đường, "đọc");
    in kiểm.đọc hết() == "abc-def-xyz";
    kiểm.đóng();
    sai_chế_độ = sai;
    thử { Luồng Tệp(đường, "sai"); } bắt lỗi(e) { sai_chế_độ = đúng; };
    in sai_chế_độ;
    ghi_mới = Luồng Tệp(đường, "ghi");
    in ghi_mới.vị trí() == 0;
    ghi_mới.ghi("abcdef");
    in ghi_mới.vị trí() == 6;
    in ghi_mới.dịch(2);
    ghi_mới.ghi("XY");
    in ghi_mới.đẩy đệm();
    // Tệp khác đọc được sau flush khi writer vẫn giữ handle mở.
    độc_lập = Luồng Tệp(đường, "đọc");
    in độc_lập.đọc hết() == "abXYef";
    in độc_lập.đọc hết() == "";
    độc_lập.dịch(-2, 2);
    bytes = độc_lập.đọc bytes(2);
    in bytes[0] == 101 && bytes[1] == 102;
    in độc_lập.dịch(0) && độc_lập.vị trí() == 0;
    in do_dai(độc_lập.đọc bytes(0)) == 0;
    độc_lập.đóng(); ghi_mới.đóng();
    in ghi_mới.đóng();
    chặn_đóng = sai;
    thử { ghi_mới.dịch(0); } bắt lỗi(e) { chặn_đóng = đúng; };
    in chặn_đóng;
    chặn_thiếu = sai;
    thử { Luồng Tệp(".tmp_oop_khong_ton_tai/tep", "đọc"); } bắt lỗi(e) { chặn_thiếu = đúng; };
    in chặn_thiếu;
};
