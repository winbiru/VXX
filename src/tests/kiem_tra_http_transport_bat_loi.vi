nhập gói/chuẩn/chính;

hàm chính() {
    // Use the configured loopback address. 127.0.0.2 may time out on macOS
    // instead of refusing immediately, costing five HTTP connect timeouts.
    bắtĐược = 0;

    thử {
        mạng lấy("http://127.0.0.1:1/health");
    } bắt lỗi (e) {
        nếu (chứa chuỗi(e, "socket_tcp_mo")) { bắtĐược = bắtĐược + 1; };
    };

    thử {
        mạng gửi("http://127.0.0.1:1/health", "{}");
    } bắt lỗi (e) {
        nếu (chứa chuỗi(e, "socket_tcp_mo")) { bắtĐược = bắtĐược + 1; };
    };

    thử {
        mạng cập nhật("http://127.0.0.1:1/health", "{}");
    } bắt lỗi (e) {
        nếu (chứa chuỗi(e, "socket_tcp_mo")) { bắtĐược = bắtĐược + 1; };
    };

    thử {
        mạng xóa("http://127.0.0.1:1/health");
    } bắt lỗi (e) {
        nếu (chứa chuỗi(e, "socket_tcp_mo")) { bắtĐược = bắtĐược + 1; };
    };

    thử {
        mạng lấy("https://127.0.0.1:1/health");
    } bắt lỗi (e) {
        nếu (chứa chuỗi(e, "socket_tls_mo")) { bắtĐược = bắtĐược + 1; };
    };

    in bắtĐược;
};
