nhập gói/thư viện/dữ liệu/kết nối cơ sở dữ liệu.vi;

// Ghi chú hàm: đường dẫn application.properties của test API project.
hàm db đường dẫn cấu hình() {
    trả về "src/tests/api_project/application.properties";
};

// Ghi chú hàm: JDBC URL mặc định theo cấu hình V++ datasource.
hàm db mặc định url() {
    trả về "jdbc:sqlite:api_project.db";
};

// Ghi chú hàm: username mặc định cho datasource.
hàm db mặc định username() {
    trả về "";
};

// Ghi chú hàm: password mặc định cho datasource.
hàm db mặc định password() {
    trả về "";
};

// Ghi chú hàm: driver class mặc định cho datasource.
hàm db mặc định driver() {
    trả về "org.sqlite.JDBC";
};

// Ghi chú hàm: lấy URL từ properties, có fallback mặc định.
hàm db url từ cấu hình() {
    value = đọc cấu hình khóa(
        db đường dẫn cấu hình(),
        "url",
        ""
    );
    nếu (value != "") {
        trả về value;
    };

    value = đọc cấu hình khóa(
        db đường dẫn cấu hình(),
        "vpp.datasource.url",
        ""
    );
    nếu (value != "") {
        trả về value;
    };

    trả về db mặc định url();
};

