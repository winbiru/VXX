nhập gói.mạng.bảng tên máy.*;
nhập gói.mạng.phân giải tên miền.*;
nhập gói.nhập xuất.bộ đệm tệp.*;
nhập gói.nhập xuất.tệp thô.*;

hàm hosts phát sinh lỗi(bộ, nội_dung, tên) {
    thử { bộ.phân giải tên miền phân tích bảng tên máy(nội_dung, tên); }
    bắt lỗi(e) { trả về đúng; };
    trả về sai;
};

hàm chính() {
    bộ = Bộ Bảng Tên Máy DNS();
    in độ dài(bộ.phân giải tên miền phân tích bảng tên máy("", "localhost")) == 0;
    in độ dài(phân giải tên miền phân tích bảng tên máy("# empty\n", "localhost")) == 0;

    nội_dung = "127.0.0.1 localhost LocalHost.Alias # comment\r\n" +
        "::1 localhost other.alias\n" +
        "192.0.2.10 Example.COM example.alias# inline comment\n" +
        "256.1.1.1 invalid.test\n" +
        "127.0.0.1 localhost\n" +
        "0:0:0:0:0:0:0:1 localhost\n" +
        "198.51.100.1 other.test";
    địa_chỉ = bộ.phân giải tên miền phân tích bảng tên máy(nội_dung, "LOCALHOST.");
    in độ dài(địa_chỉ) == 2 && địa_chỉ[0] == "127.0.0.1" && địa_chỉ[1] == "::1";
    địa_chỉ = bộ.phân giải tên miền phân tích bảng tên máy(nội_dung, "localhost.alias");
    in độ dài(địa_chỉ) == 1 && địa_chỉ[0] == "127.0.0.1";
    địa_chỉ = bộ.phân giải tên miền phân tích bảng tên máy(nội_dung, "example.com.");
    in độ dài(địa_chỉ) == 1 && địa_chỉ[0] == "192.0.2.10";
    in độ dài(bộ.phân giải tên miền phân tích bảng tên máy(nội_dung, "invalid.test")) == 0;
    in độ dài(bộ.phân giải tên miền phân tích bảng tên máy(nội_dung, "missing.test")) == 0;
    địa_chỉ = bộ.phân giải tên miền phân tích bảng tên máy(nội_dung, "other.test");
    in độ dài(địa_chỉ) == 1 && địa_chỉ[0] == "198.51.100.1";
    in độ dài(bộ.phân giải tên miền phân tích bảng tên máy("127.0.0.1 foo#bar\n", "foo")) == 1;
    in độ dài(bộ.phân giải tên miền phân tích bảng tên máy("127.0.0.1 foo#bar\n", "bar")) == 0;
    nhiều = "127.0.0.1 edge.test ";
    lặp(i = 0; i < 254; i++) { nhiều = nhiều + "x "; };
    in độ dài(bộ.phân giải tên miền phân tích bảng tên máy(nhiều + "# comment", "edge.test")) == 1;
    in độ dài(bộ.phân giải tên miền phân tích bảng tên máy(nhiều + "x # comment", "edge.test")) == 0;

    in hosts phát sinh lỗi(bộ, "127.0.0.1 ok", "a..b");
    in hosts phát sinh lỗi(bộ, "127.0.0.1 ok", "tên.vn");
    in hosts phát sinh lỗi(bộ, 123, "localhost");
    in hosts phát sinh lỗi(bộ, "127.0.0.1 ok", "");

    // Dòng đúng 4096 các byte được đọc, dòng dài hơn bị bỏ qua hoàn toàn.
    dòng = "127.0.0.1 edge.test ";
    lặp(i = độ dài(dòng); i < 4096; i++) { dòng = dòng + " "; };
    in độ dài(bộ.phân giải tên miền phân tích bảng tên máy(dòng, "edge.test")) == 1;
    in độ dài(bộ.phân giải tên miền phân tích bảng tên máy(dòng + "x", "edge.test")) == 0;

    // Giới hạn tệp: 65536 các byte hợp lệ, 65537 các byte phải báo lỗi.
    lớn = " ";
    lặp(i = 0; i < 16; i++) { lớn = lớn + lớn; };
    in độ dài(lớn) == 65536 && độ dài(bộ.phân giải tên miền phân tích bảng tên máy(lớn, "edge.test")) == 0;
    in hosts phát sinh lỗi(bộ, lớn + "x", "edge.test");

    đường = ".tmp_vpp_dns_hosts_test";
    tệp = Bộ Đệm Tệp(đường, "ghi");
    tệp.ghi("203.0.113.12 fixture.test\n::1 fixture.test\n");
    tệp.đóng();
    địa_chỉ = bộ.phân giải tên miền đọc bảng tên máy("FiXtUrE.TeSt", đường);
    in độ dài(địa_chỉ) == 2 && địa_chỉ[0] == "203.0.113.12" && địa_chỉ[1] == "::1";
    in độ dài(phân giải tên miền đọc bảng tên máy("fixture.test", đường)) == 2;
    tệp thô xóa(đường);

    tệp = Bộ Đệm Tệp(đường, "ghi");
    tệp.đóng();
    in độ dài(bộ.phân giải tên miền đọc bảng tên máy("fixture.test", đường)) == 0;
    tệp thô xóa(đường);

    tệp = Bộ Đệm Tệp(đường, "ghi");
    tệp.ghi(lớn);
    tệp.đóng();
    in độ dài(bộ.phân giải tên miền đọc bảng tên máy("fixture.test", đường)) == 0;
    tệp thô xóa(đường);

    lỗi = sai;
    thử { bộ.phân giải tên miền đọc bảng tên máy("fixture.test", đường); } bắt lỗi(e) { lỗi = đúng; };
    in lỗi;
    lỗi = sai;
    thử { bộ.phân giải tên miền đọc bảng tên máy("fixture.test", ""); } bắt lỗi(e) { lỗi = đúng; };
    in lỗi;
    lỗi = sai;
    thử { bộ.phân giải tên miền đọc bảng tên máy("fixture.test", "x" + chuỗi từ byte máy ảo([0]) + "y"); }
    bắt lỗi(e) { lỗi = đúng; };
    in lỗi;

    // Đọc tệp vượt 64 KiB phải đóng handle kể cả khi ném lỗi.
    tệp = Bộ Đệm Tệp(đường, "ghi");
    tệp.ghi(lớn + "x");
    tệp.đóng();
    lỗi = sai;
    thử { bộ.phân giải tên miền đọc bảng tên máy("edge.test", đường); } bắt lỗi(e) { lỗi = đúng; };
    in lỗi;
    tệp thô xóa(đường);
};
