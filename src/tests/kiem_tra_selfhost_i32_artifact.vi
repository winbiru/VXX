// No C++ compiler oracle: compile sources, validate and execute artifacts in V++.
nhập gói/biên dịch/sản phẩm biên dịch;
nhập gói/biên dịch/bộ nạp;
nhập gói/biên dịch/liên kết;
nhập gói/biên dịch/mã thao tác;
nhập gói/dữ liệu/json/json;

hàm yêu cầu selfhost(điều_kiện, tên) {
    nếu (!điều_kiện) { ném "selfhost artifact: " + tên; };
};

hàm yêu cầu từ chối artifact(gói, tên) {
    văn_bản = json tạo(gói);
    cũ = sai;
    dây = sai;
    chạy = sai;
    thử { biên dịch sản phẩm biên dịch giải mã(văn_bản); } bắt lỗi(e) { cũ = đúng; };
    thử { biên dịch sản phẩm biên dịch giải mã dây(văn_bản); } bắt lỗi(e) { dây = đúng; };
    thử { biên dịch chạy sản phẩm biên dịch văn bản(văn_bản); } bắt lỗi(e) { chạy = đúng; };
    yêu cầu selfhost(cũ && dây && chạy, "phải từ chối " + tên);
};

hàm chính() {
    mã = "hàm tính(a, b) { in a + b; in a - b; in a * b; }; " +
        "hàm mặc định i32(a = -2147483648) { trả về a; }; " +
        "hàm chính() { in 2147483647 + 1; in -2147483648 - 1; " +
        "in 2147483647 * 2147483647; tính(-2147483648, -1); " +
        "a = 2147483647; a += 1; in a; a -= 1; in a; " +
        "a *= 2147483647; in a; in -(-2147483648); in mặc định i32(); };";
    mong_đợi = "-2147483648\n2147483647\n1\n2147483647\n-2147483647\n" +
        "-2147483648\n-2147483648\n2147483647\n1\n-2147483648\n-2147483648\n";
    artifact = biên dịch chương trình tự chủ(mã);
    văn_bản = biên dịch sản phẩm biên dịch tuần tự(artifact);
    yêu cầu selfhost(biên dịch chạy sản phẩm biên dịch(artifact) == mong_đợi, "i32 từ source");
    yêu cầu selfhost(biên dịch chạy sản phẩm biên dịch văn bản(văn_bản) == mong_đợi, "i32 từ wire");
    yêu cầu selfhost(biên dịch chạy sản phẩm biên dịch(biên dịch sản phẩm biên dịch giải mã(văn_bản)) == mong_đợi,
                    "i32 từ API map");
    dây = biên dịch sản phẩm biên dịch giải mã dây(văn_bản);
    yêu cầu selfhost(mã trung gian chạy máy ảo(dây[0], dây[1], dây[2], dây[3]) == mong_đợi,
                    "ABI trực tiếp");
    cũ = json tạo({"định dạng": "VPP bytecode", "phiên bản": 1,
                   "ABI": "Instruction 4*i32", "artifact": artifact});
    yêu cầu selfhost(biên dịch chạy sản phẩm biên dịch văn bản(cũ) == mong_đợi, "định dạng map cũ");

    lỗi = sai;
    thử { biên dịch chương trình tự chủ("in 2147483648;"); } bắt lỗi(e) { lỗi = đúng; };
    yêu cầu selfhost(lỗi, "literal dương vượt i32");
    lỗi = sai;
    thử { biên dịch chương trình tự chủ("in -2147483649;"); } bắt lỗi(e) { lỗi = đúng; };
    yêu cầu selfhost(lỗi, "literal âm vượt i32");

    // A fresh decode per mutation keeps every rejection independent.
    gói = json phân tích(văn_bản);
    gói["phiên bản"] = 1.0;
    yêu cầu từ chối artifact(gói, "phiên bản số thực");
    gói = json phân tích(văn_bản);
    gói["loại"] = "không hỗ trợ";
    yêu cầu từ chối artifact(gói, "loại artifact");
    gói = json phân tích(văn_bản);
    gói["dây"] = [];
    yêu cầu từ chối artifact(gói, "thiếu vùng ABI");
    gói = json phân tích(văn_bản);
    gói["dây"][1][0] = 1;
    yêu cầu từ chối artifact(gói, "StringPool không phải chuỗi");
    gói = json phân tích(văn_bản);
    gói["dây"][0][0] = [1, 2, 3];
    yêu cầu từ chối artifact(gói, "lệnh thiếu trường");
    gói = json phân tích(văn_bản);
    gói["dây"][0][0][1] = 1.0;
    yêu cầu từ chối artifact(gói, "trường lệnh không phải i32");
    gói = json phân tích(văn_bản);
    gói["dây"][0][0][0] = 42;
    yêu cầu từ chối artifact(gói, "opcode không tồn tại");
    gói = json phân tích(văn_bản);
    gói["dây"][2][0][0] = 0.0;
    yêu cầu từ chối artifact(gói, "function ID số thực");
    gói = json phân tích(văn_bản);
    gói["dây"][2][0][0] = 9;
    yêu cầu từ chối artifact(gói, "function ID không liên tiếp");
    gói = json phân tích(văn_bản);
    gói["dây"][2][0][1] = "0";
    yêu cầu từ chối artifact(gói, "name index dạng chuỗi");
    gói = json phân tích(văn_bản);
    gói["dây"][2][0][1] = độ dài(gói["dây"][1]);
    yêu cầu từ chối artifact(gói, "name index vượt StringPool");
    gói = json phân tích(văn_bản);
    gói["dây"][2][1][1] = gói["dây"][2][0][1];
    yêu cầu từ chối artifact(gói, "name index trùng");
    gói = json phân tích(văn_bản);
    gói["dây"][3] = [["m", []]];
    yêu cầu từ chối artifact(gói, "initializer trong artifact đơn");
    gói = json phân tích(văn_bản);
    gói["loại"] = "bytecode V++ đồ thị đã liên kết";
    gói["dây"][3] = [["m", []], ["m", []]];
    yêu cầu từ chối artifact(gói, "initializer trùng");
    gói = json phân tích(văn_bản);
    gói["loại"] = "bytecode V++ đồ thị đã liên kết";
    gói["dây"][3] = [[1, []]];
    yêu cầu từ chối artifact(gói, "định danh initializer không phải chuỗi");

    // Serialization must observe mutations, rather than reuse a stale ABI.
    nhỏ = biên dịch chương trình tự chủ("in 7;");
    codec = Bộ Mã Hóa Sản Phẩm Biên Dịch(nhỏ);
    trước = codec.tuần tự();
    lặp(i = 0; i < độ dài(nhỏ["bytecode"]); i++) {
        nếu (nhỏ["bytecode"][i]["op"] == biên dịch mã thao tác("OP_BIEN_SO")) {
            nhỏ["bytecode"][i]["toán hạng"] = 8;
        };
    };
    sau = codec.tuần tự();
    yêu cầu selfhost(trước != sau && biên dịch chạy sản phẩm biên dịch văn bản(sau) == "8\n",
                    "codec không giữ cache cũ");
    in "selfhost_i32_artifact_ok";
};
