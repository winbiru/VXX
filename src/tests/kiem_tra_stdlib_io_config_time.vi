nhập gói/thư viện/main.vi;

hàm main() {
    ghi tệp(".tmp_stdlib_io.txt", "xin chao io");
    in đọc tệp(".tmp_stdlib_io.txt");

    ghi tệp(".tmp_stdlib_cfg.ini", "port=8080\nname=vietvm\nbat=đúng\nhe_so=2.5\n");
    cfg = đọc cấu hình(".tmp_stdlib_cfg.ini");
    in cfg;

    now = lấy thời gian hiện tại();
    in now != "";
};
