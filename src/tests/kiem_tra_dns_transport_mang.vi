nhập gói/mạng/phân giải tên miền;
nhập gói/bộ sưu tập/từ điển;
nhập gói/hệ thống/môi trường;

// Được chạy cùng mock DNS loopback; kiểm tra schema và adapter công khai.
hàm chính() {
    bộ = Bộ Phân Giải DNS();
    mode = đọc biến môi trường("VPP_DNS_TEST_MODE", "");
    cổng = đọc biến môi trường("VPP_DNS_VI_PORT", "53");
    nếu (mode == "failover") {
        chi_tiết = bộ.phân giải tên miền hỏi dự phòng đầy đủ(
            "example.com", ["127.0.0.1", "::1"], cổng, 1, 2000
        );
        địa_chỉ = lấy từ điển(chi_tiết, "addresses", []);
        in lấy từ điển(chi_tiết, "status", "") == "NOERROR" &&
            lấy từ điển(chi_tiết, "rcode", -1) == 0 &&
            lấy từ điển(chi_tiết, "ttl", -1) == 41 &&
            độ dài(địa_chỉ) == 1 && địa_chỉ[0] == "203.0.113.47";
    } hoặc nếu (mode == "cache_hit" || mode == "cache_zero" || mode == "cache_separate") {
        máy_chủ = ["127.0.0.1"];
        lần_đầu = bộ.phân giải tên miền hỏi dự phòng đầy đủ("example.com", máy_chủ, cổng, 1);
        nếu (mode == "cache_separate") { bộ = Bộ Phân Giải DNS(); };
        lần_hai = bộ.phân giải tên miền hỏi dự phòng đầy đủ("example.com", máy_chủ, cổng, 1);
        đầu = lấy từ điển(lần_đầu, "addresses", []);
        sau = lấy từ điển(lần_hai, "addresses", []);
        hợp_lệ = độ dài(đầu) == 1 && độ dài(sau) == 1 &&
                 đầu[0] == "203.0.113.47" && sau[0] == đầu[0];
        nếu (mode == "cache_zero") {
            hợp_lệ = hợp_lệ && lấy từ điển(lần_đầu, "ttl", -1) == 0 &&
                       lấy từ điển(lần_hai, "ttl", -1) == 0;
        } hoặc {
            hợp_lệ = hợp_lệ && lấy từ điển(lần_đầu, "ttl", -1) == 60 &&
                       lấy từ điển(lần_hai, "ttl", -1) <= 60;
        };
        in hợp_lệ;
    } hoặc nếu (mode == "nxdomain") {
        chi_tiết = bộ.phân giải tên miền hỏi máy chủ đầy đủ("example.com", "127.0.0.1", cổng, 1);
        in lấy từ điển(chi_tiết, "status", "") == "NXDOMAIN" &&
            lấy từ điển(chi_tiết, "rcode", -1) == 3 &&
            lấy từ điển(chi_tiết, "ttl", -1) == 0 &&
            độ dài(lấy từ điển(chi_tiết, "addresses", [])) == 0;
        // NXDOMAIN là kết quả hợp lệ; không được thử nameserver dự phòng.
        chi_tiết = bộ.phân giải tên miền hỏi dự phòng đầy đủ(
            "example.com", ["127.0.0.1", "127.0.0.2"], cổng, 1
        );
        in lấy từ điển(chi_tiết, "status", "") == "NXDOMAIN";
    } hoặc nếu (mode == "nodata") {
        chi_tiết = bộ.phân giải tên miền hỏi máy chủ đầy đủ("example.com", "127.0.0.1", cổng, 1);
        in lấy từ điển(chi_tiết, "status", "") == "NODATA" &&
            lấy từ điển(chi_tiết, "rcode", -1) == 0 &&
            lấy từ điển(chi_tiết, "ttl", -1) == 0 &&
            độ dài(lấy từ điển(chi_tiết, "addresses", [])) == 0;
        in độ dài(bộ.phân giải tên miền hỏi máy chủ("example.com", "127.0.0.1", cổng, 1)) == 0;
    } hoặc {
        loại = 1;
        nếu (mode == "aaaa") { loại = 28; };
        chi_tiết = bộ.phân giải tên miền hỏi máy chủ đầy đủ("example.com", "127.0.0.1", cổng, loại);
        địa_chỉ = lấy từ điển(chi_tiết, "addresses", []);
        ttl = 60;
        nếu (mode == "zero") { ttl = 0; };
        nếu (mode == "max") { ttl = 4294967295.0; };
        ip = "203.0.113.47";
        nếu (mode == "aaaa") { ip = "2001:0db8:0000:0000:0000:0000:0000:0001"; };
        in lấy từ điển(chi_tiết, "status", "") == "NOERROR" &&
            lấy từ điển(chi_tiết, "rcode", -1) == 0 &&
            lấy từ điển(chi_tiết, "ttl", -1) == ttl &&
            độ dài(địa_chỉ) == 1 && địa_chỉ[0] == ip;
        nếu (mode == "a" || mode == "tcp") {
            cũ = bộ.phân giải tên miền hỏi máy chủ("example.com", "127.0.0.1", cổng, loại);
            in độ dài(cũ) == 1 && cũ[0] == ip;
        };
        nếu (mode == "a") {
            chi_tiết = bộ.phân giải tên miền hỏi dự phòng đầy đủ(
                "example.com", ["127.0.0.1"], cổng, loại
            );
            in lấy từ điển(chi_tiết, "ttl", -1) == 60 &&
                lấy từ điển(chi_tiết, "addresses", [])[0] == ip;
            cũ = bộ.phân giải tên miền hỏi dự phòng("example.com", ["127.0.0.1"], cổng, loại);
            in độ dài(cũ) == 1 && cũ[0] == ip;
        };
    };
};
