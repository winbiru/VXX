// Kiểm tra package mạng thống nhất: HTTP helpers, JSON, REST và helper request.
nhập mạng;
nhập gói/mạng/kiểm thử/giao diện lập trình;

hàm chính() {
    in nối đường dẫn địa chỉ tài nguyên("https://example.test", "/health");
    in json đối tượng hai chuỗi("dịch vụ", "V++", "trạng thái", "sẵn sàng");

    dataJson = json đối tượng một chuỗi("id", "req-42");
    in dịch vụ tài nguyên json thành công an toàn("ok", dataJson);

    in giao diện lập trình lấy có truy vấn("/users", "page=2");
    in giao diện lập trình post json("/users", "");
};
