// Kiểm tra package mạng thống nhất: HTTP helpers, JSON, REST và helper request.
nhập mạng;
nhập gói/mạng/kiểm thử/api;

hàm main() {
    in nối đường dẫn url("https://example.test", "/health");
    in json đối tượng hai chuỗi("dịch vụ", "V++", "trạng thái", "sẵn sàng");

    dataJson = json đối tượng một chuỗi("id", "req-42");
    in rest json thành công an toàn("ok", dataJson);

    in api get có query("/users", "page=2");
    in api post json("/users", "");
};
