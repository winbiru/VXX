// Binary-safe block I/O for native executables, including UTF-8 and NUL.
// The CTest harness validates file size and SHA-256 independently.
hàm chính() {
    biến seed = "V++:\n";
    biến payload = byte_mới();
    nếu (payload <= 0) { trả về 10; };
    nếu (byte_nối(payload, seed) != 0) { trả về 10; };
    biến value = 0;
    lặp (i = 0; i < 5001; i++) {
        nếu (byte_thêm(payload, value) != 0) { trả về 11; };
        value += 1;
        nếu (value == 256) { value = 0; };
    };
    nếu (byte_dài(payload) != 5006) { trả về 12; };
    nếu (byte_nối(payload, payload) != 0) { trả về 13; };
    nếu (byte_dài(payload) != 10012) { trả về 13; };
    nếu (byte_nối(payload, 99999) != -1) { trả về 14; };
    nếu (byte_dài(payload) != 10012) { trả về 14; };
    nếu (byte_bằng(seed, seed) != 1) { trả về 15; };
    nếu (byte_bằng(seed, payload) != 0) { trả về 15; };

    biến path = "native-block.bin";
    biến writer = tệp_mở_ghi(path);
    nếu (writer <= 0) { trả về 16; };
    nếu (tệp_ghi_khối(writer, payload) != 10012) { trả về 17; };
    nếu (tệp_đóng(writer) != 0) { trả về 18; };
    nếu (tệp_ghi_khối(writer, payload) != -1) { trả về 19; };

    biến result = byte_mới();
    biến reader = tệp_mở_đọc(path);
    nếu (reader <= 0) { trả về 20; };
    biến first = tệp_đọc_khối(reader, result);
    biến second = tệp_đọc_khối(reader, result);
    biến third = tệp_đọc_khối(reader, result);
    biến eof = tệp_đọc_khối(reader, result);
    in first;
    in second;
    in third;
    in eof;
    nếu (first != 4096) { trả về 21; };
    nếu (second != 4096) { trả về 21; };
    nếu (third != 1820) { trả về 21; };
    nếu (eof != 0) { trả về 21; };
    nếu (byte_dài(result) != 10012) { trả về 22; };
    nếu (byte_bằng(payload, result) != 1) { trả về 22; };
    nếu (tệp_đóng(reader) != 0) { trả về 23; };
    nếu (tệp_đọc_khối(reader, result) != -1) { trả về 23; };
    nếu (tệp_đọc_khối(99999, result) != -1) { trả về 24; };
    nếu (tệp_ghi_khối(99999, result) != -1) { trả về 24; };
    nếu (byte_bằng(result, 99999) != -1) { trả về 25; };
    nếu (byte_in(99999) != -1) { trả về 25; };

    biến label = "Native UTF-8: Việt Nam\n";
    nếu (byte_in(label) != byte_dài(label)) { trả về 26; };
    nếu (byte_hủy(label) != 0) { trả về 27; };
    nếu (byte_hủy(result) != 0) { trả về 27; };
    nếu (byte_hủy(payload) != 0) { trả về 28; };
    nếu (byte_hủy(path) != 0) { trả về 28; };
    nếu (byte_hủy(seed) != 0) { trả về 28; };
    trả về 0;
};
