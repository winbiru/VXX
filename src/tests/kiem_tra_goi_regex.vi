nhập biểu thức chính quy;

hàm chính() {
    in biểu thức chính quy khớp("abc123", "[a-z]+[0-9]+");
    in biểu thức chính quy tìm("xx-123-yy", "[0-9]+");
    in biểu thức chính quy thay("a1b2", "[0-9]", "#");
    in biểu thức chính quy tách("a,b;c", "[,;]");

    // Capture, escape và số nhóm một/hai chữ số theo std::regex ECMAScript.
    in biểu thức chính quy thay("a1b22c", "([a-z])([0-9]+)", "$2:$1");
    in biểu thức chính quy thay("ab", "(a)(b)", "$$/$&/$0/$00/$1/$2/$3/$12/$01/$99");
    in biểu thức chính quy thay("abcdefghij", "(a)(b)(c)(d)(e)(f)(g)(h)(i)(j)", "$10$09$1");
    in biểu thức chính quy thay("b", "(a)?b", "<$1>");
    in biểu thức chính quy thay("aba", "a", "[$`][$']");
    in biểu thức chính quy thay("a", "a", "$q/$");
    in biểu thức chính quy thay("abc", "z", "$&");

    // Khớp rỗng vẫn tiến lên đúng theo engine, kể cả anchor và lookahead.
    in biểu thức chính quy thay("ab", "", "#");
    in biểu thức chính quy thay("aa", "a*?", "#");
    in biểu thức chính quy thay("aba", "(?=a)", "#");
    in biểu thức chính quy thay("ab", "^|$", "#");
    in biểu thức chính quy tách("a,,", ",");
    in biểu thức chính quy tách(",a", ",");
    in biểu thức chính quy tách("ab", "");
    in biểu thức chính quy tách("", "x");
    in biểu thức chính quy tách("", "");
    in biểu thức chính quy tách("abc", "x");

    // Engine V++ khớp theo Unicode code point, đồng nhất với indexing chuỗi.
    in biểu thức chính quy thay("é", ".", "#");
    in biểu thức chính quy thay("Tiếng Việt", "(.)", "$&") == "Tiếng Việt";
    in biểu thức chính quy thay("Việt", "Việt", "xin chào $&");
    in biểu thức chính quy tách("một,hai,ba", ",");
    in độ dài(biểu thức chính quy tách("", "x")) == 1;
    in độ dài(biểu thức chính quy tách("", "")) == 1;
    in độ dài(biểu thức chính quy tách("a,,", ",")) == 2;

    // match/search là wrapper V++ trên primitive scan duy nhất.
    in biểu thức chính quy khớp("aa", "a|aa");
    in biểu thức chính quy khớp("aaa", "a*");
    in biểu thức chính quy khớp("", "");
    in !biểu thức chính quy khớp("a\n", "a$");
    in biểu thức chính quy khớp("ab", "a(?=b)b");
    in biểu thức chính quy tìm("xx-123-yy", "[0-9]+") == "123";
};
