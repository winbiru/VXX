// Kiểm tra tokenizer, parser, semantic/IR và thực thi IR thuần native V++.
hàm test_int_buffer() {
    biến b = byte_mới();
    nếu (b <= 0) { trả về 10; };
    nếu (byte_đẩy_i32(b, -2147483647) != 0) { trả về 11; };
    nếu (byte_đẩy_i32(b, 2147483647) != 0) { trả về 12; };
    nếu (byte_dài(b) != 8) { trả về 13; };
    nếu (byte_lấy(b, 0) != 1) { trả về 14; };
    nếu (byte_lấy(b, 3) != 128) { trả về 15; };
    nếu (byte_đọc_i32(b, 0) != -2147483647) { trả về 16; };
    nếu (byte_đọc_i32(b, 4) != 2147483647) { trả về 17; };
    nếu (byte_ghi_i32(b, 4, -1234567) != 0) { trả về 18; };
    nếu (byte_đọc_i32(b, 4) != -1234567) { trả về 19; };
    nếu (byte_ghi_i32(b, 5, 0) != -1) { trả về 20; };
    nếu (byte_đọc_i32(b, 5) != -1) { trả về 21; };
    nếu (byte_ghi_i32(b, -1, 0) != -1) { trả về 22; };
    nếu (byte_đọc_i32(b, -1) != -1) { trả về 23; };
    nếu (byte_dài(b) != 8) { trả về 24; };
    nếu (byte_hủy(b) != 0) { trả về 25; };
    nếu (byte_đẩy_i32(b, 1) != -1) { trả về 26; };
    biến full = "x";
    lặp (i = 0; i < 20; i++) {
        nếu (byte_nối(full, full) != 0) { trả về 27; };
    };
    nếu (byte_dài(full) != 1048576) { trả về 28; };
    nếu (byte_đẩy_i32(full, 9) != -1) { trả về 29; };
    nếu (byte_ghi_i32(full, 1048573, 9) != -1) { trả về 29; };
    nếu (byte_ghi_i32(full, 1048572, -1) != 0) { trả về 29; };
    nếu (byte_đọc_i32(full, 1048572) != -1) { trả về 29; };
    nếu (byte_dài(full) != 1048576) { trả về 29; };
    nếu (byte_hủy(full) != 0) { trả về 29; };
    trả về 0;
};

hàm test_parser_program() {
    biến source = "// V++\n hàm chính() { /* UTF-8 */ biến số = 2 + 3 * 4; biến kết_quả = (số - 5) * 2; trả về kết_quả + -1; };";
    biến tokens = byte_mới();
    biến ir = byte_mới();
    nếu (lex_tokenize(source, tokens) != 34) { trả về 31; };
    nếu (tok_count(tokens) != 34) { trả về 32; };
    nếu (tok_field(tokens, 0, 0) != 8) { trả về 33; };
    nếu (tok_field(tokens, 0, 1) != 12) { trả về 34; };
    nếu (tok_field(tokens, 0, 2) != 1) { trả về 35; };
    nếu (tok_equals(source, tokens, 0, "hàm") != 1) { trả về 36; };
    nếu (tok_equals(source, tokens, 1, "hàm") != 0) { trả về 37; };
    nếu (tok_field(tokens, -1, 0) != -1) { trả về 38; };
    nếu (tok_field(tokens, 34, 0) != -1) { trả về 39; };
    nếu (p_compile(source, tokens, ir) <= 0) { trả về 40; };
    nếu (ir_run(ir) != 17) { trả về 41; };
    nếu (byte_hủy(source) != 0) { trả về 42; };
    nếu (byte_hủy(tokens) != 0) { trả về 43; };
    nếu (byte_hủy(ir) != 0) { trả về 44; };
    trả về 0;
};

// Every parser error must clear a previously populated IR buffer.
hàm expect_reject(source) {
    biến tokens = byte_mới();
    biến ir = byte_mới();
    biến status = 0;
    byte_đẩy_i32(ir, 123);
    nếu (lex_tokenize(source, tokens) < 0) { status = 5; }
    hoặc {
        nếu (p_compile(source, tokens, ir) >= 0) { status = 1; };
        nếu (byte_dài(ir) != 0) { status = 2; };
    };
    nếu (byte_hủy(tokens) != 0) { status = 3; };
    nếu (byte_hủy(ir) != 0) { status = 4; };
    nếu (byte_hủy(source) != 0) { status = 6; };
    trả về status;
};

hàm test_parser_invalid() {
    nếu (expect_reject("hàm chính() { trả về biến_chưa_khai; };") != 0) { trả về 51; };
    nếu (expect_reject("hàm chính() { biến a = a + 1; trả về a; };") != 0) { trả về 52; };
    nếu (expect_reject("hàm chính() { biến a = 1; biến a = 2; trả về a; };") != 0) { trả về 53; };
    nếu (expect_reject("hàm chính() { biến a = 1; };") != 0) { trả về 54; };
    nếu (expect_reject("hàm chính() { trả về 1; biến a = 2; };") != 0) { trả về 55; };
    nếu (expect_reject("hàm chính() { trả về 1.5; };") != 0) { trả về 56; };
    nếu (expect_reject("hàm chính() { trả về 2147483648; };") != 0) { trả về 57; };
    nếu (expect_reject("hàm chính() { trả về 2 + ; };") != 0) { trả về 58; };
    nếu (expect_reject("hàm chính(x) { trả về 4; };") != 0) { trả về 59; };
    nếu (expect_reject("hàm khác() { trả về 4; };") != 0) { trả về 60; };
    nếu (expect_reject("hàm chính() { trả về 4; }; hàm khác() { trả về 2; };") != 0) { trả về 61; };
    nếu (expect_reject("hàm chính() { trả về 42; } garbage") != 0) { trả về 62; };
    nếu (expect_reject("hàm chính() { trả về 42; ") != 0) { trả về 63; };
    nếu (expect_reject("hàm chính() { biến hàm = 4; trả về hàm; };") != 0) { trả về 64; };
    nếu (expect_reject("hàm chính() { biến a.b = 4; trả về a.b; };") != 0) { trả về 65; };
    nếu (expect_reject("hàm chính() { biến 1bad = 4; trả về 1bad; };") != 0) { trả về 66; };
    nếu (expect_reject("hàm chính() { x = 4; trả về 1; };") != 0) { trả về 67; };
    nếu (expect_reject("hàm chính() { biến x = 4; x /= ; trả về x; };") != 0) { trả về 68; };
    nếu (expect_reject("hàm chính() { biến x = 4; x = x + 1; trả về x + 0; }; xyz") != 0) { trả về 69; };
    nếu (expect_reject("hàm chính() { biến x = 0; nếu (x) { biến y = 1; }; trả về y; };") != 0) { trả về 70; };
    nếu (expect_reject("hàm chính() { biến x = 0; nếu (1) { trả về 52; } hoặc { trả về 51; }; trả về x; };") != 0) { trả về 71; };
    nếu (expect_reject("hàm chính() { lặp (i = 0; i < 3; i++) { }; trả về i; };") != 0) { trả về 72; };
    trả về 0;
};

hàm run_case(source, expected) {
    biến tokens = byte_mới();
    biến ir = byte_mới();
    biến status = 0;
    nếu (lex_tokenize(source, tokens) < 0) { status = 1; }
    hoặc {
        nếu (p_compile(source, tokens, ir) < 1) { status = 2; }
        hoặc { nếu (ir_run(ir) != expected) { status = 3; }; };
    };
    nếu (byte_hủy(source) != 0) { status = 4; };
    nếu (byte_hủy(tokens) != 0) { status = 5; };
    nếu (byte_hủy(ir) != 0) { status = 6; };
    trả về status;
};

hàm test_division_by_zero_ir() {
    biến ir = byte_mới();
    nếu (ir <= 0) { trả về 120; };
    lặp (op = 26; op <= 27; op++) {
        byte_làm_rỗng(ir);
        byte_đẩy_i32(ir, 1); byte_đẩy_i32(ir, 7);
        byte_đẩy_i32(ir, 1); byte_đẩy_i32(ir, 0);
        byte_đẩy_i32(ir, op); byte_đẩy_i32(ir, 0);
        byte_đẩy_i32(ir, 7); byte_đẩy_i32(ir, 0);
        nếu (ir_run(ir) != -2147483647) { trả về 121; };
    };
    nếu (byte_hủy(ir) != 0) { trả về 122; };
    trả về 0;
};

hàm test_parser_precedence() {
    nếu (run_case("hàm chính() { trả về 2 + 3 * 4; };", 14) != 0) { trả về 81; };
    nếu (run_case("hàm chính() { trả về (2 + 3) * 4; };", 20) != 0) { trả về 82; };
    nếu (run_case("hàm chính() { trả về 3 * -2 + 9; };", 3) != 0) { trả về 83; };
    nếu (run_case("hàm chính() { biến đèn = 0; trả về đèn; };", 0) != 0) { trả về 84; };
    nếu (run_case("hàm chính() { trả về 2147483647; };", 2147483647) != 0) { trả về 85; };
    nếu (run_case("hàm chính() { trả về 7 - 2 - 1; };", 4) != 0) { trả về 86; };
    nếu (run_case("hàm chính() { biến a = 2; a = (a + 3) * 4; trả về a; };", 20) != 0) { trả về 87; };
    nếu (run_case("hàm chính() { biến a = 2; biến b = 3; a = a * b; b = a - b; trả về b; };", 3) != 0) { trả về 88; };
    nếu (run_case("hàm chính() { biến a = 2; nếu (a >= 2) { a = a + 50; } hoặc { a = 1; }; trả về a; };", 52) != 0) { trả về 89; };
    nếu (run_case("hàm chính() { biến a = 2; nếu (a < 0) { a = 1; } hoặc { a = a * 26; }; trả về a; };", 52) != 0) { trả về 90; };
    nếu (run_case("hàm chính() { biến a = 2; lặp (i = 0; i < 5; i = i + 1) { a = a + 10; }; trả về a; };", 52) != 0) { trả về 91; };
    nếu (run_case("hàm chính() { biến a = 2; lặp (i = 0; i < 0; i = i + 1) { a = 99; }; trả về a + 50; };", 52) != 0) { trả về 92; };
    nếu (run_case("hàm chính() { biến a = -4; nếu (a > -3) { a = 0; } hoặc { a = 52; }; trả về a; };", 52) != 0) { trả về 93; };
    nếu (run_case("hàm chính() { biến a = 0; nếu (1) { biến local = 52; a = local; }; trả về a; };", 52) != 0) { trả về 94; };
    nếu (run_case("hàm chính() { biến a = 0; nếu (0) { biến same = 1; a = same; } hoặc { biến same = 52; a = same; }; trả về a; };", 52) != 0) { trả về 95; };
    nếu (run_case("hàm chính() { biến a = 0; lặp (i = 0; i < 52; i++) { a = a + 1; }; trả về a; };", 52) != 0) { trả về 96; };
    nếu (run_case("hàm chính() { biến a = 0; lặp (i = 52; i > 0; i--) { a = a + 1; }; trả về a; };", 52) != 0) { trả về 97; };
    nếu (run_case("hàm chính() { biến a = 0; lặp (i = 0; i < 26; i++) { a = a + 1; }; lặp (i = 0; i < 26; i++) { a = a + 1; }; trả về a; };", 52) != 0) { trả về 98; };
    nếu (run_case("hàm chính() { nếu (0) { trả về 1; } hoặc nếu (0) { trả về 2; } hoặc nếu (1) { trả về 52; } hoặc { trả về 3; }; };", 52) != 0) { trả về 99; };
    nếu (run_case("hàm chính() { trả về !0 + !1 + !!7 + !(-3) + 50; };", 52) != 0) { trả về 100; };
    nếu (run_case("hàm chính() { trả về +(+52); };", 52) != 0) { trả về 101; };
    nếu (run_case("hàm chính() { trả về đúng * 50 + !sai + đúng; };", 52) != 0) { trả về 102; };
    nếu (run_case("hàm chính() { biến x = 4; x += 10; x *= 4; x -= 4; x++; x--; trả về x; };", 52) != 0) { trả về 103; };
    nếu (run_case("hàm chính() { biến x = 0; lặp (i = 0; i < 26; i += 1) { x += 2; }; trả về x; };", 52) != 0) { trả về 104; };
    nếu (run_case("hàm chính() { biến x = 0; lặp (i = 52; i > 0; i -= 1) { x++; }; trả về x; };", 52) != 0) { trả về 105; };
    nếu (run_case("hàm chính() { biến x = 2; lặp (i = 1; i < 16; i *= 2) { x += 10; }; trả về x + 10; };", 52) != 0) { trả về 106; };
    nếu (run_case("hàm chính() { trả về 104 / 2; };", 52) != 0) { trả về 107; };
    nếu (run_case("hàm chính() { trả về 157 % 105; };", 52) != 0) { trả về 108; };
    nếu (run_case("hàm chính() { trả về -159 / -3; };", 53) != 0) { trả về 109; };
    nếu (run_case("hàm chính() { trả về -159 % 52; };", -3) != 0) { trả về 110; };
    nếu (run_case("hàm chính() { trả về -7 / 3; };", -2) != 0) { trả về 111; };
    nếu (run_case("hàm chính() { trả về -7 % 3; };", -1) != 0) { trả về 112; };
    nếu (run_case("hàm chính() { trả về 7 % -3; };", 1) != 0) { trả về 113; };
    nếu (run_case("hàm chính() { trả về -2147483648 / -1; };", -2147483648) != 0) { trả về 114; };
    nếu (run_case("hàm chính() { trả về -2147483648 % -1; };", 0) != 0) { trả về 115; };
    nếu (run_case("hàm chính() { biến x = -159; x /= -3; x %= 52; x += 51; trả về x; };", 52) != 0) { trả về 116; };
    nếu (run_case("hàm chính() { biến x = 0; lặp (i = 208; i > 0; i /= 2) { x += 13; }; trả về x; };", 104) != 0) { trả về 117; };
    nếu (run_case("hàm chính() { biến x = 0; lặp (i = 52; i > 0; i %= 13) { x += 52; }; trả về x; };", 52) != 0) { trả về 118; };
    nếu (run_case("hàm chính() { trả về 14 + 76 / 2 * 2 % 55; };", 35) != 0) { trả về 119; };
    trả về 0;
};

hàm test_token_errors() {
    biến src = byte_mới();
    biến tokens = byte_mới();
    byte_thêm(src, 65);
    byte_thêm(src, 32);
    byte_thêm(src, 192);
    byte_thêm(src, 128);
    nếu (lex_tokenize(src, tokens) != -1) { trả về 91; };
    nếu (byte_dài(tokens) != 0) { trả về 92; };
    byte_làm_rỗng(src);
    byte_thêm(src, 65);
    nếu (lex_tokenize(src, tokens) != 1) { trả về 93; };
    nếu (tok_count(tokens) != 1) { trả về 94; };
    nếu (tok_field(tokens, 0, 1) != 1) { trả về 95; };
    nếu (lex_tokenize(src, tokens) != 1) { trả về 96; };
    nếu (byte_dài(tokens) != 16) { trả về 97; };
    nếu (byte_ghi_i32(tokens, 0, 2) != 0) { trả về 98; };
    nếu (tok_count(tokens) != -1) { trả về 99; };
    nếu (tok_field(tokens, 0, 0) != -1) { trả về 100; };
    biến ir = byte_mới();
    nếu (ir <= 0) { trả về 103; };
    nếu (byte_đẩy_i32(ir, 17) != 0) { trả về 104; };
    nếu (p_compile(src, tokens, ir) != -1) { trả về 105; };
    nếu (byte_dài(ir) != 0) { trả về 106; };
    nếu (lex_tokenize(src, tokens) != 1) { trả về 107; };
    nếu (tok_validate(src, tokens) != 1) { trả về 108; };
    nếu (byte_ghi_i32(tokens, 4, 1) != 0) { trả về 109; };
    nếu (tok_validate(src, tokens) != -1) { trả về 110; };
    nếu (lex_tokenize(src, tokens) != 1) { trả về 111; };
    nếu (byte_ghi_i32(tokens, 12, 2) != 0) { trả về 112; };
    nếu (tok_validate(src, tokens) != -1) { trả về 113; };
    nếu (byte_hủy(ir) != 0) { trả về 114; };
    nếu (byte_hủy(src) != 0) { trả về 101; };
    nếu (byte_hủy(tokens) != 0) { trả về 102; };
    trả về 0;
};

hàm test_parser_file() {
    biến path = "native-parser-input.vi";
    biến file = tệp_mở_đọc(path);
    nếu (file <= 0) { trả về 71; };
    biến source = byte_mới();
    biến tokens = byte_mới();
    biến ir = byte_mới();
    nếu (tệp_đọc_khối(file, source) <= 0) { trả về 72; };
    nếu (tệp_đóng(file) != 0) { trả về 73; };
    nếu (lex_tokenize(source, tokens) < 1) { trả về 74; };
    nếu (p_compile(source, tokens, ir) < 1) { trả về 75; };
    nếu (ir_run(ir) != 52) { trả về 76; };
    biến path_ir = "native-parser-output.ir";
    biến output = tệp_mở_ghi(path_ir);
    nếu (output <= 0) { trả về 115; };
    nếu (tệp_ghi_khối(output, ir) != byte_dài(ir)) { trả về 116; };
    nếu (tệp_đóng(output) != 0) { trả về 117; };
    biến input = tệp_mở_đọc(path_ir);
    nếu (input <= 0) { trả về 118; };
    biến restored = byte_mới();
    nếu (tệp_đọc_khối(input, restored) != byte_dài(ir)) { trả về 119; };
    nếu (tệp_đóng(input) != 0) { trả về 120; };
    nếu (byte_bằng(ir, restored) != 1) { trả về 121; };
    nếu (ir_run(restored) != 52) { trả về 122; };
    nếu (byte_hủy(restored) != 0) { trả về 123; };
    nếu (byte_hủy(path_ir) != 0) { trả về 124; };
    nếu (byte_hủy(path) != 0) { trả về 77; };
    nếu (byte_hủy(source) != 0) { trả về 78; };
    nếu (byte_hủy(tokens) != 0) { trả về 79; };
    nếu (byte_hủy(ir) != 0) { trả về 80; };
    trả về 0;
};

hàm chính() {
    biến code = test_int_buffer();
    nếu (code != 0) { in_số(code); trả về code; };
    code = test_parser_program();
    nếu (code != 0) { in_số(code); trả về code; };
    code = test_parser_invalid();
    nếu (code != 0) { in_số(code); trả về code; };
    code = test_parser_precedence();
    nếu (code != 0) { in_số(code); trả về code; };
    code = test_division_by_zero_ir();
    nếu (code != 0) { in_số(code); trả về code; };
    code = test_token_errors();
    nếu (code != 0) { in_số(code); trả về code; };
    code = test_parser_file();
    nếu (code != 0) { in_số(code); trả về code; };
    in_số(20261017);
    trả về 0;
};
