// Native owned UTF-8/binary substrings, searching and 1 MiB capacity boundary.
hàm chính() {
    biến src = "A\0BéAB";
    biến nul = "\0B";
    biến utf = "é";
    biến missing = "Q";
    biến empty = "";
    nếu (byte_dài(src) != 7) { trả về 10; };
    nếu (byte_tìm(src, nul) != 1) { trả về 11; };
    nếu (byte_tìm(src, utf) != 3) { trả về 11; };
    nếu (byte_tìm(src, missing) != -1) { trả về 11; };
    nếu (byte_tìm(src, empty) != 0) { trả về 11; };
    nếu (byte_tìm(99999, empty) != -2) { trả về 11; };
    nếu (byte_tìm(src, 99999) != -2) { trả về 11; };

    biến part = byte_cắt(src, 3, 2);
    nếu (part <= 0) { trả về 12; };
    nếu (byte_bằng(part, utf) != 1) { trả về 12; };
    biến middle = byte_cắt(src, 1, 4);
    nếu (byte_dài(middle) != 4) { trả về 13; };
    nếu (byte_lấy(middle, 0) != 0) { trả về 13; };
    nếu (byte_lấy(middle, 1) != 66) { trả về 13; };
    nếu (byte_lấy(middle, 2) != 195) { trả về 13; };
    nếu (byte_lấy(middle, 3) != 169) { trả về 13; };
    biến end = byte_cắt(src, 7, 0);
    nếu (byte_dài(end) != 0) { trả về 14; };
    nếu (byte_cắt(src, -1, 1) != -1) { trả về 15; };
    nếu (byte_cắt(src, 0, -1) != -1) { trả về 15; };
    nếu (byte_cắt(src, 7, 1) != -1) { trả về 15; };
    nếu (byte_cắt(src, 8, 0) != -1) { trả về 15; };
    nếu (byte_cắt(99999, 0, 0) != -1) { trả về 15; };
    nếu (byte_dài(src) != 7) { trả về 15; };

    // A slice must own its bytes after the original is cleared and reused.
    nếu (byte_làm_rỗng(src) != 0) { trả về 16; };
    nếu (byte_dài(src) != 0) { trả về 16; };
    nếu (byte_bằng(part, utf) != 1) { trả về 16; };
    nếu (byte_thêm(src, 88) != 0) { trả về 16; };
    nếu (byte_làm_rỗng(99999) != -1) { trả về 16; };

    // Double a 1-byte buffer twenty times to reach the exact 1 MiB limit.
    biến full = "x";
    lặp (i = 0; i < 20; i++) {
        nếu (byte_nối(full, full) != 0) { trả về 17; };
    };
    nếu (byte_dài(full) != 1048576) { trả về 17; };
    nếu (byte_nối(full, src) != -1) { trả về 18; };
    nếu (byte_thêm(full, 0) != -1) { trả về 18; };
    nếu (byte_dài(full) != 1048576) { trả về 18; };
    biến full_copy = byte_cắt(full, 0, 1048576);
    nếu (full_copy <= 0) { trả về 19; };
    nếu (byte_bằng(full, full_copy) != 1) { trả về 19; };
    nếu (byte_cắt(full, 0, 1048577) != -1) { trả về 19; };

    // Full destination rejects buffered reads before consuming the stream.
    biến path = "native-slice-cap.bin";
    biến writer = tệp_mở_ghi(path);
    nếu (writer <= 0) { trả về 20; };
    nếu (tệp_ghi_byte(writer, 65) != 0) { trả về 20; };
    nếu (tệp_đóng(writer) != 0) { trả về 20; };
    biến reader = tệp_mở_đọc(path);
    nếu (reader <= 0) { trả về 21; };
    nếu (tệp_đọc_khối(reader, full) != -1) { trả về 21; };
    nếu (tệp_đọc_byte(reader) != 65) { trả về 21; };
    nếu (tệp_đóng(reader) != 0) { trả về 21; };
    nếu (byte_làm_rỗng(full) != 0) { trả về 22; };
    nếu (byte_dài(full) != 0) { trả về 22; };
    nếu (byte_thêm(full, 90) != 0) { trả về 22; };

    in byte_dài(full_copy);
    in byte_lấy(full, 0);
    nếu (byte_hủy(full_copy) != 0) { trả về 23; };
    nếu (byte_hủy(full) != 0) { trả về 23; };
    nếu (byte_hủy(path) != 0) { trả về 23; };
    nếu (byte_hủy(src) != 0) { trả về 23; };
    nếu (byte_hủy(nul) != 0) { trả về 23; };
    nếu (byte_hủy(utf) != 0) { trả về 23; };
    nếu (byte_hủy(missing) != 0) { trả về 23; };
    nếu (byte_hủy(empty) != 0) { trả về 23; };
    nếu (byte_hủy(part) != 0) { trả về 23; };
    nếu (byte_hủy(middle) != 0) { trả về 23; };
    nếu (byte_hủy(end) != 0) { trả về 23; };
    trả về 0;
};
