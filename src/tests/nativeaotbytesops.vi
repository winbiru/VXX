// Native owned UTF-8/binary substrings, searching and 1 MiB capacity boundary.
hàm chính() {
    biến src = "A\0BéAB";
    biến nul = "\0B";
    biến utf = "é";
    biến missing = "Q";
    biến empty = "";
    nếu (byte dài(src) != 7) { trả về 10; };
    nếu (byte tìm(src, nul) != 1) { trả về 11; };
    nếu (byte tìm(src, utf) != 3) { trả về 11; };
    nếu (byte tìm(src, missing) != -1) { trả về 11; };
    nếu (byte tìm(src, empty) != 0) { trả về 11; };
    nếu (byte tìm(99999, empty) != -2) { trả về 11; };
    nếu (byte tìm(src, 99999) != -2) { trả về 11; };

    biến part = byte cắt(src, 3, 2);
    nếu (part <= 0) { trả về 12; };
    nếu (byte bằng(part, utf) != 1) { trả về 12; };
    biến middle = byte cắt(src, 1, 4);
    nếu (byte dài(middle) != 4) { trả về 13; };
    nếu (byte lấy(middle, 0) != 0) { trả về 13; };
    nếu (byte lấy(middle, 1) != 66) { trả về 13; };
    nếu (byte lấy(middle, 2) != 195) { trả về 13; };
    nếu (byte lấy(middle, 3) != 169) { trả về 13; };
    biến end = byte cắt(src, 7, 0);
    nếu (byte dài(end) != 0) { trả về 14; };
    nếu (byte cắt(src, -1, 1) != -1) { trả về 15; };
    nếu (byte cắt(src, 0, -1) != -1) { trả về 15; };
    nếu (byte cắt(src, 7, 1) != -1) { trả về 15; };
    nếu (byte cắt(src, 8, 0) != -1) { trả về 15; };
    nếu (byte cắt(99999, 0, 0) != -1) { trả về 15; };
    nếu (byte dài(src) != 7) { trả về 15; };

    // A slice must own its các byte after the original is cleared and reused.
    nếu (byte làm rỗng(src) != 0) { trả về 16; };
    nếu (byte dài(src) != 0) { trả về 16; };
    nếu (byte bằng(part, utf) != 1) { trả về 16; };
    nếu (byte thêm(src, 88) != 0) { trả về 16; };
    nếu (byte làm rỗng(99999) != -1) { trả về 16; };

    // Double a 1-byte buffer twenty times to reach the exact 1 MiB limit.
    biến full = "x";
    lặp (i = 0; i < 20; i++) {
        nếu (byte nối(full, full) != 0) { trả về 17; };
    };
    nếu (byte dài(full) != 1048576) { trả về 17; };
    nếu (byte nối(full, src) != -1) { trả về 18; };
    nếu (byte thêm(full, 0) != -1) { trả về 18; };
    nếu (byte dài(full) != 1048576) { trả về 18; };
    biến full_copy = byte cắt(full, 0, 1048576);
    nếu (full_copy <= 0) { trả về 19; };
    nếu (byte bằng(full, full_copy) != 1) { trả về 19; };
    nếu (byte cắt(full, 0, 1048577) != -1) { trả về 19; };

    // Full destination rejects buffered reads before consuming the stream.
    biến path = "native-slice-cap.bin";
    biến writer = tệp mở ghi(path);
    nếu (writer <= 0) { trả về 20; };
    nếu (tệp ghi byte(writer, 65) != 0) { trả về 20; };
    nếu (tệp đóng(writer) != 0) { trả về 20; };
    biến reader = tệp mở đọc(path);
    nếu (reader <= 0) { trả về 21; };
    nếu (tệp đọc khối(reader, full) != -1) { trả về 21; };
    nếu (tệp đọc byte(reader) != 65) { trả về 21; };
    nếu (tệp đóng(reader) != 0) { trả về 21; };
    nếu (byte làm rỗng(full) != 0) { trả về 22; };
    nếu (byte dài(full) != 0) { trả về 22; };
    nếu (byte thêm(full, 90) != 0) { trả về 22; };

    in byte dài(full_copy);
    in byte lấy(full, 0);
    nếu (byte hủy(full_copy) != 0) { trả về 23; };
    nếu (byte hủy(full) != 0) { trả về 23; };
    nếu (byte hủy(path) != 0) { trả về 23; };
    nếu (byte hủy(src) != 0) { trả về 23; };
    nếu (byte hủy(nul) != 0) { trả về 23; };
    nếu (byte hủy(utf) != 0) { trả về 23; };
    nếu (byte hủy(missing) != 0) { trả về 23; };
    nếu (byte hủy(empty) != 0) { trả về 23; };
    nếu (byte hủy(part) != 0) { trả về 23; };
    nếu (byte hủy(middle) != 0) { trả về 23; };
    nếu (byte hủy(end) != 0) { trả về 23; };
    trả về 0;
};
