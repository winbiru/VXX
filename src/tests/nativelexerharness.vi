// Ghép sau gói/biên dịch/native/lexer.vi để kiểm thử executable native.
hàm test_lex_tokens() {
    biến src = "  //x\r\n/*é*/nếu==12.5;";
    nếu (byte_dài(src) != 25) { trả về 11; };
    nếu (lex_skip(src, 0) != 13) { trả về 12; };
    nếu (lex_end(src, 13) != 18) { trả về 13; };
    nếu (lex_kind(src, 13, 18) != 1) { trả về 14; };
    nếu (lex_end(src, 18) != 20) { trả về 15; };
    nếu (lex_kind(src, 18, 20) != 5) { trả về 16; };
    nếu (lex_end(src, 20) != 24) { trả về 17; };
    nếu (lex_kind(src, 20, 24) != 3) { trả về 18; };
    nếu (lex_kind(src, 24, 25) != 6) { trả về 19; };
    nếu (lex_skip(src, 25) != 25) { trả về 20; };
    nếu (lex_kind(src, 13, 19) != -1) { trả về 21; };
    nếu (lex_skip(src, -1) != -1) { trả về 22; };
    nếu (lex_skip(src, 26) != -1) { trả về 23; };
    nếu (lex_end(src, 25) != -1) { trả về 24; };
    nếu (byte_hủy(src) != 0) { trả về 25; };
    trả về 0;
};

hàm test_lex_strings() {
    biến quoted = "\"x\\\"é\"";
    nếu (byte_dài(quoted) != 7) { trả về 31; };
    nếu (lex_end(quoted, 0) != 7) { trả về 32; };
    nếu (lex_kind(quoted, 0, 7) != 4) { trả về 33; };
    biến single = "'x'";
    nếu (lex_end(single, 0) != 3) { trả về 34; };
    nếu (lex_kind(single, 0, 3) != 4) { trả về 35; };
    biến unterminated = "\"unclosed";
    nếu (lex_end(unterminated, 0) != -1) { trả về 36; };
    biến escaped_end = "\"unfinished\\";
    nếu (lex_end(escaped_end, 0) != -1) { trả về 37; };
    biến newline = "\"oops\nend\"";
    nếu (lex_end(newline, 0) != -1) { trả về 38; };
    biến block = "/* nested?";
    nếu (lex_skip(block, 0) != -1) { trả về 39; };
    biến only_comment = "// chú thích";
    nếu (lex_skip(only_comment, 0) != byte_dài(only_comment)) { trả về 40; };
    nếu (byte_hủy(quoted) != 0) { trả về 41; };
    nếu (byte_hủy(single) != 0) { trả về 41; };
    nếu (byte_hủy(unterminated) != 0) { trả về 41; };
    nếu (byte_hủy(escaped_end) != 0) { trả về 41; };
    nếu (byte_hủy(newline) != 0) { trả về 41; };
    nếu (byte_hủy(block) != 0) { trả về 41; };
    nếu (byte_hủy(only_comment) != 0) { trả về 41; };
    trả về 0;
};

hàm test_lex_invalid_bytes() {
    biến bytes = byte_mới();
    nếu (bytes <= 0) { trả về 51; };
    nếu (byte_thêm(bytes, 192) != 0) { trả về 51; };
    nếu (byte_thêm(bytes, 128) != 0) { trả về 51; };
    nếu (lex_utf8_step(bytes, 0) != -1) { trả về 52; };
    nếu (byte_làm_rỗng(bytes) != 0) { trả về 53; };
    nếu (byte_thêm(bytes, 224) != 0) { trả về 53; };
    nếu (byte_thêm(bytes, 128) != 0) { trả về 53; };
    nếu (byte_thêm(bytes, 128) != 0) { trả về 53; };
    nếu (lex_utf8_step(bytes, 0) != -1) { trả về 54; };
    nếu (byte_làm_rỗng(bytes) != 0) { trả về 55; };
    nếu (byte_thêm(bytes, 237) != 0) { trả về 55; };
    nếu (byte_thêm(bytes, 160) != 0) { trả về 55; };
    nếu (byte_thêm(bytes, 128) != 0) { trả về 55; };
    nếu (lex_utf8_step(bytes, 0) != -1) { trả về 56; };
    nếu (byte_làm_rỗng(bytes) != 0) { trả về 57; };
    nếu (byte_thêm(bytes, 240) != 0) { trả về 57; };
    nếu (byte_thêm(bytes, 128) != 0) { trả về 57; };
    nếu (byte_thêm(bytes, 128) != 0) { trả về 57; };
    nếu (byte_thêm(bytes, 128) != 0) { trả về 57; };
    nếu (lex_utf8_step(bytes, 0) != -1) { trả về 58; };
    nếu (byte_làm_rỗng(bytes) != 0) { trả về 59; };
    nếu (byte_thêm(bytes, 244) != 0) { trả về 59; };
    nếu (byte_thêm(bytes, 144) != 0) { trả về 59; };
    nếu (byte_thêm(bytes, 128) != 0) { trả về 59; };
    nếu (byte_thêm(bytes, 128) != 0) { trả về 59; };
    nếu (lex_utf8_step(bytes, 0) != -1) { trả về 60; };
    nếu (byte_làm_rỗng(bytes) != 0) { trả về 61; };
    nếu (byte_thêm(bytes, 240) != 0) { trả về 61; };
    nếu (byte_thêm(bytes, 159) != 0) { trả về 61; };
    nếu (lex_utf8_step(bytes, 0) != -1) { trả về 62; };
    nếu (byte_làm_rỗng(bytes) != 0) { trả về 63; };
    nếu (byte_thêm(bytes, 195) != 0) { trả về 63; };
    nếu (byte_thêm(bytes, 65) != 0) { trả về 63; };
    nếu (lex_end(bytes, 0) != -1) { trả về 64; };
    nếu (byte_làm_rỗng(bytes) != 0) { trả về 65; };
    nếu (byte_thêm(bytes, 128) != 0) { trả về 65; };
    nếu (lex_skip(bytes, 0) != -1) { trả về 66; };
    nếu (byte_làm_rỗng(bytes) != 0) { trả về 67; };
    nếu (byte_thêm(bytes, 0) != 0) { trả về 67; };
    nếu (lex_utf8_step(bytes, 0) != -1) { trả về 68; };
    nếu (byte_làm_rỗng(bytes) != 0) { trả về 69; };
    nếu (byte_thêm(bytes, 240) != 0) { trả về 69; };
    nếu (byte_thêm(bytes, 159) != 0) { trả về 69; };
    nếu (byte_thêm(bytes, 146) != 0) { trả về 69; };
    nếu (byte_thêm(bytes, 169) != 0) { trả về 69; };
    nếu (lex_utf8_step(bytes, 0) != 4) { trả về 70; };
    nếu (lex_end(bytes, 0) != 4) { trả về 71; };
    nếu (lex_kind(bytes, 0, 4) != 1) { trả về 72; };
    nếu (byte_hủy(bytes) != 0) { trả về 73; };
    trả về 0;
};

hàm test_lex_operators() {
    biến src = "a++b&&c||d!=e<=f>=g+=h-=i*=j/=k%=l";
    biến i = 1;
    lặp (i = 1; i < byte_dài(src) - 1; i = i) {
        nếu (lex_two(byte_lấy(src, i), byte_lấy(src, i + 1)) != 1) { trả về 81; };
        i = i + 3;
    };
    nếu (lex_kind(src, 1, 3) != 5) { trả về 82; };
    nếu (lex_kind(src, 0, 1) != 1) { trả về 83; };
    biến ints = "0 42 12.5 1.2.3";
    nếu (lex_kind(ints, 0, 1) != 2) { trả về 84; };
    nếu (lex_kind(ints, 2, 4) != 2) { trả về 85; };
    nếu (lex_kind(ints, 5, 9) != 3) { trả về 86; };
    nếu (lex_kind(ints, 10, 15) != 1) { trả về 87; };
    nếu (byte_hủy(src) != 0) { trả về 88; };
    nếu (byte_hủy(ints) != 0) { trả về 88; };
    trả về 0;
};

// Nạp và token hóa mã nguồn thực từ tệp bằng runtime C ABI native.
hàm test_lex_file() {
    biến path = "native-lexer-input.vi";
    biến file = tệp_mở_đọc(path);
    nếu (file <= 0) { trả về 91; };
    biến src = byte_mới();
    nếu (src <= 0) { trả về 92; };
    biến count_bytes = 0;
    lặp (loop = 0; loop < 100; loop++) {
        biến copied = tệp_đọc_khối(file, src);
        nếu (copied < 0) { trả về 93; };
        nếu (copied == 0) { thoát; };
        count_bytes = count_bytes + copied;
    };
    nếu (tệp_đóng(file) != 0) { trả về 94; };
    nếu (count_bytes != byte_dài(src)) { trả về 95; };
    biến cursor = 0;
    biến count = 0;
    lặp (loop = 0; loop < 100; loop++) {
        cursor = lex_skip(src, cursor);
        nếu (cursor < 0) { trả về 96; };
        nếu (cursor == byte_dài(src)) { thoát; };
        biến end = lex_end(src, cursor);
        nếu (end <= cursor) { trả về 97; };
        biến kind = lex_kind(src, cursor, end);
        nếu (kind <= 0) { trả về 98; };
        nếu (count == 0) {
            nếu (cursor != 11) { trả về 99; };
            nếu (end != 15) { trả về 99; };
        };
        nếu (count == 12) { nếu (kind != 4) { trả về 100; }; };
        cursor = end;
        count = count + 1;
    };
    nếu (count != 20) { trả về 101; };
    nếu (cursor != byte_dài(src)) { trả về 102; };
    nếu (byte_hủy(src) != 0) { trả về 103; };
    nếu (byte_hủy(path) != 0) { trả về 104; };
    trả về 0;
};

hàm chính() {
    biến a = test_lex_tokens();
    nếu (a != 0) { in_số(a); trả về a; };
    a = test_lex_strings();
    nếu (a != 0) { in_số(a); trả về a; };
    a = test_lex_invalid_bytes();
    nếu (a != 0) { in_số(a); trả về a; };
    a = test_lex_operators();
    nếu (a != 0) { in_số(a); trả về a; };
    a = test_lex_file();
    nếu (a != 0) { in_số(a); trả về a; };
    in_số(20261017);
    trả về 0;
};
