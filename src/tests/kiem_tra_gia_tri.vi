nhập gói.chuẩn.chính.*;

hàm chính() {
    in bằng giá trị(1, 1.0);
    in bằng giá trị("abc", "abc");
    in bằng giá trị(rỗng, rỗng);
    in bằng giá trị("1", 1);

    in băm giá trị(1) == băm giá trị(1.0);
    in băm giá trị(0.0) == băm giá trị(-0.0);
    in băm giá trị("abc") == băm giá trị("abc");
    in băm giá trị(rỗng);
    ds = [1, 2];
    alias = ds;
    in băm giá trị(ds) == băm giá trị(alias);

    in yêu cầu có giá trị(7);
    thử {
        yêu cầu có giá trị(rỗng);
    } bắt lỗi (e) {
        in e;
    };

    in chỉ mục hợp lệ(2, 3);
    thử {
        chỉ mục hợp lệ(3, 3);
    } bắt lỗi (e) {
        in e;
    };

    in khoảng chỉ mục hợp lệ(1, 3, 3);
    thử {
        khoảng chỉ mục hợp lệ(2, 1, 3);
    } bắt lỗi (e) {
        in e;
    };

    in vùng chỉ mục hợp lệ(1, 2, 3);
    thử {
        vùng chỉ mục hợp lệ(2, 2, 3);
    } bắt lỗi (e) {
        in e;
    };
};
