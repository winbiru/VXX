nhập gói.chuẩn.chính.*;

hàm chính() {
    vi = vùng ngôn ngữ("VI-vn");
    zh = vùng ngôn ngữ("ZH-hant-tw-x-PRIVATE");
    in nhãn vùng ngôn ngữ(vi);
    in nhãn vùng ngôn ngữ(zh);

    nguồn = {
        "zh-Hant-TW": {"xin chào": "繁體"},
        "zh": {"xin chào": "中文"},
        "": {"xin chào": "root"}
    };
    bundle = gói tài nguyên("messages", zh, nguồn);
    in lấy từ điển(bundle, "vùng ngôn ngữ đã chọn", "?");
    in lấy tài nguyên(bundle, "xin chào");
    root_bundle = gói tài nguyên("messages", vùng ngôn ngữ("fr-CA"), nguồn);
    in lấy từ điển(root_bundle, "vùng ngôn ngữ đã chọn", "?") == "";
    in lấy tài nguyên(root_bundle, "xin chào");

    mặc_định = các thuộc tính("host=localhost\nport=8080\n");
    nội_dung = "# comment\n" +
        "name=V++\n" +
        "message=hello\\\n  world\n" +
        "escaped\\ key:value\\:x\n" +
        "unicode=Vi\\u1EC7t Nam\n" +
        "dup=first\n" +
        "dup=last\n";
    p = các thuộc tính(nội_dung, mặc_định);
    in lấy thuộc tính(p, "name");
    in lấy thuộc tính(p, "message");
    in lấy thuộc tính(p, "escaped key");
    in lấy thuộc tính(p, "unicode");
    in lấy thuộc tính(p, "dup");
    in lấy thuộc tính(p, "host");
    in lấy thuộc tính(p, "missing", "fallback");

    thử {
        vùng ngôn ngữ("en--US");
    } bắt lỗi (e) {
        in e;
    };
    thử {
        lấy tài nguyên(bundle, "missing");
    } bắt lỗi (e) {
        in e;
    };
    thử {
        các thuộc tính("a=1\nb=2\n", rỗng, 1, 100);
    } bắt lỗi (e) {
        in e;
    };
};
