// Kiểm chứng lớp mới và hàm cũ cùng hoạt động với một định dạng dữ liệu.
nhập gói/biên dịch/phụ thuộc;
nhập gói/biên dịch/đồ thị mô đun;
nhập gói/biên dịch/sản phẩm biên dịch;
nhập gói/biên dịch/liên kết;
nhập gói/mạng/rest;

hàm chính() {
    mã = "nhập bộ sưu tập; hàm chính() {};";
    bộ_phụ_thuộc = Bộ Phân Tích Phụ Thuộc(mã, ".");
    mục = bộ_phụ_thuộc.danh sách();
    in bộ_phụ_thuộc.kiểm tra()["hợp lệ"] == 1;
    in độ dài(mục) == 1 && mục[0]["tên"] == "bộ sưu tập";
    mục_cũ = phụ thuộc danh sách(mã);
    in độ dài(mục) == độ dài(mục_cũ) && mục[0]["tên"] == mục_cũ[0]["tên"];
    bộ_lỗi = Bộ Phân Tích Phụ Thuộc("hàm", ".");
    in bộ_lỗi.kiểm tra()["hợp lệ"] == 0;
    bắt_lỗi = sai;
    thử { bộ_lỗi.danh sách(); } bắt lỗi(e) { bắt_lỗi = đúng; };
    in bắt_lỗi;

    nguồn = {"main": "nhập phụ;", "phụ": "hàm tiện() {};"};
    bộ_đồ_thị = Bộ Dựng Đồ Thị Mô Đun({"nguồn": nguồn});
    đồ_thị = bộ_đồ_thị.dựng("main");
    in độ dài(đồ_thị["cạnh"]) == 1;
    in đồ_thị["thứ tự khởi tạo"][0] == "phụ";
    cạnh_cũ = biên dịch dựng đồ thị nguồn thuần("main", nguồn)["cạnh"];
    in độ dài(cạnh_cũ) == 1 && đồ_thị["cạnh"][0]["đích"] == cạnh_cũ[0]["đích"];
    in độ dài(bộ_đồ_thị.dựng("main")["cạnh"]) == 1;

    artifact = biên dịch chương trình tự chủ("hàm chính() { in 7; };");
    codec = Bộ Mã Hóa Sản Phẩm Biên Dịch(artifact);
    văn_bản = codec.tuần tự();
    in codec.kiểm tra()["loại"] == artifact["loại"];
    in văn_bản == biên dịch sản phẩm biên dịch tuần tự(artifact);
    codec_đọc = Bộ Mã Hóa Sản Phẩm Biên Dịch(rỗng);
    bản_đọc = codec_đọc.giải mã(văn_bản);
    in biên dịch chạy sản phẩm biên dịch(bản_đọc) == "7\n";
    in codec_đọc.tuần tự() == văn_bản;
    bắt_lỗi = sai;
    thử { codec_đọc.đọc lệnh([[1, 2, 3]]); }
    bắt lỗi(e) { bắt_lỗi = đúng; };
    in bắt_lỗi;
    bắt_lỗi = sai;
    thử {
        codec_đọc.giải mã("{\"định dạng\":\"VPP mã trung gian\",\"phiên bản\":2,\"ABI\":\"Instruction 4*i32\"}");
    } bắt lỗi(e) { bắt_lỗi = đúng; };
    in bắt_lỗi;

    phản_hồi = Bộ Dựng Phản Hồi REST(đúng, "ok");
    in phản_hồi.đối tượng("{\"n\":1}") == dịch vụ tài nguyên json thành công đối tượng("ok", "{\"n\":1}");
    in phản_hồi.dữ liệu("r1", "n", "2") == dịch vụ tài nguyên json thành công dữ liệu("ok", "r1", "n", "2");
    in phản_hồi.jwt("a", "b") == dịch vụ tài nguyên json thành công jwt("ok", "a", "b");
    in phản_hồi.an toàn("null") == dịch vụ tài nguyên json thành công an toàn("ok", "null");
    phản_hồi_lỗi = Bộ Dựng Phản Hồi REST(sai, "lỗi");
    in phản_hồi_lỗi.đối tượng("null") == dịch vụ tài nguyên json lỗi đối tượng("lỗi", "null");
    in phản_hồi_lỗi.an toàn("null") == dịch vụ tài nguyên json lỗi an toàn("lỗi", "null");
};
