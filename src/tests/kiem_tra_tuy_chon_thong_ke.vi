nhập gói/chuẩn/chính;

hàm chính() {
    in có giá trị(7);
    in có giá trị(rỗng);
    in hoặc giá trị(7, 99);
    in hoặc giá trị(rỗng, 99);

    gọi_supplier = 0;
    supplier = hàm() {
        gọi_supplier += 1;
        trả về 42;
    };
    in hoặc tạo(5, supplier);
    in gọi_supplier;
    in hoặc tạo(rỗng, supplier);
    in gọi_supplier;

    nhân_đôi = hàm(x) { trả về x * 2; };
    lớn_hơn_5 = hàm(x) { trả về x > 5; };
    in ánh xạ tùy chọn(3, nhân_đôi);
    in ánh xạ tùy chọn(rỗng, nhân_đôi) == rỗng;
    in lọc tùy chọn(8, lớn_hơn_5);
    in lọc tùy chọn(2, lớn_hơn_5) == rỗng;

    s = thống kê số nguyên([1, 2, 3, 4]);
    in lấy từ điển(s, "đếm", -1);
    in lấy từ điển(s, "tổng", -1);
    in lấy từ điển(s, "nhỏ nhất", -1);
    in lấy từ điển(s, "lớn nhất", -1);
    in lấy từ điển(s, "trung bình", -1);

    r = thống kê số thực([1, 2.5, 4]);
    in lấy từ điển(r, "đếm", -1);
    in lấy từ điển(r, "tổng", -1);
    in lấy từ điển(r, "nhỏ nhất", -1);
    in lấy từ điển(r, "lớn nhất", -1);
    in lấy từ điển(r, "trung bình", -1);

    trống = thống kê số nguyên([]);
    in lấy từ điển(trống, "đếm", -1);
    in lấy từ điển(trống, "nhỏ nhất", 123) == rỗng;

    a = thống kê số nguyên([1, 2]);
    b = thống kê số nguyên([3, 4]);
    g = gộp thống kê(a, b);
    in lấy từ điển(g, "đếm", -1);
    in lấy từ điển(g, "tổng", -1);
    in lấy từ điển(g, "nhỏ nhất", -1);
    in lấy từ điển(g, "lớn nhất", -1);
    in lấy từ điển(g, "trung bình", -1);

    nan = thành số thực("nan");
    n = thống kê số thực([1.0, nan, 3.0]);
    in thống kê là không phải số(lấy từ điển(n, "tổng", 0.0));
    in thống kê là không phải số(lấy từ điển(n, "nhỏ nhất", 0.0));
    in thống kê là không phải số(lấy từ điển(n, "lớn nhất", 0.0));
    in thống kê là không phải số(lấy từ điển(n, "trung bình", 0.0));

    n2 = thống kê số thực([4.0, 5.0]);
    gn = gộp thống kê(n, n2);
    in lấy từ điển(gn, "đếm", -1);
    in thống kê là không phải số(lấy từ điển(gn, "nhỏ nhất", 0.0));

    thử {
        gộp thống kê(a, n2);
    } bắt lỗi (e) {
        in e;
    };
};
