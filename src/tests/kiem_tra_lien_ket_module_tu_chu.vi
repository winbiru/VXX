// Kiểm tra emitter/linker đồ thị: function ID, StringPool, initializer,
// namespace và cả bốn trường opcode phải giữ đúng hợp đồng C++.
nhập gói/biên dịch/liên kết;
nhập gói/văn bản/chuỗi;

hàm chính() {
    nguồn = {
        "app/main": "nhập ../lib/feature như api; nhập ../lib/math như toán; " +
                    "hàm chính() { in api.tính(); in toán.cộng(); in api.số.cộng(); };",
        "lib/feature": "công khai nhập math như số; " +
                       "hàm tính() { trả về số.cộng(); };",
        "lib/math": "hàm cộng() { trả về 41 + 1; }; " +
                    "in 99;"
    };
    kết = biên dịch chương trình mô đun tự chủ("app/main", nguồn);
    in kết["loại"] == "bytecode V++ đồ thị đã liên kết";
    in độ dài(kết["mô đun khởi tạo"]) == 2;
    in kết["mô đun khởi tạo"][0]["định danh"] == "lib/math";
    in kết["mô đun khởi tạo"][1]["định danh"] == "lib/feature";
    in độ dài(kết["hàm"]) == 3;
    in kết["hàm"][0]["tên"] == "chính";
    in kết["hàm"][0]["id"] == 0;
    in kết["hàm"][1]["tên"] == "tính";
    in kết["hàm"][1]["id"] == 1;
    in kết["hàm"][2]["tên"] == "cộng";
    in kết["hàm"][2]["id"] == 2;
    in kết["điểm vào"] == 0;
    in kết["slots"][0] == "chính";
    in độ dài(kết["hàm"][0]["bytecode"]) > 3;
    in độ dài(kết["hàm"][1]["bytecode"]) > 3;
    in độ dài(kết["hàm"][2]["bytecode"]) > 3;

    a = kết["mô đun khởi tạo"][0];
    b = kết["mô đun khởi tạo"][1];
    in a["slots"][2] == "cộng";
    in b["slots"][1] == "tính";
    in độ dài(a["bytecode"]) == 3;
    in a["bytecode"][0]["op"] == biên dịch mã opcode("OP_HAM");
    in a["bytecode"][0]["toán hạng"] == kết["hàm"][2]["tên index"];
    in a["bytecode"][0]["chỉ số"] == 2;
    in a["bytecode"][0]["giá trị"] == 0;
    in a["bytecode"][1]["op"] == biên dịch mã opcode("OP_BIEN_SO");
    in a["bytecode"][1]["toán hạng"] == 99;
    in a["bytecode"][2]["op"] == biên dịch mã opcode("OP_IN");
    in độ dài(b["bytecode"]) == 1;
    in b["bytecode"][0]["chỉ số"] == 1;
    in b["bytecode"][0]["toán hạng"] == kết["hàm"][1]["tên index"];

    thân = kết["hàm"][1]["bytecode"];
    in thân[0]["op"] == biên dịch mã opcode("OP_MO_KHOI");
    in thân[1]["op"] == biên dịch mã opcode("OP_GOI");
    in thân[1]["toán hạng"] == 0;
    in thân[1]["chỉ số"] == 2;
    in thân[1]["giá trị"] == 0;
    in thân[2]["op"] == biên dịch mã opcode("OP_TRA_VE");
    in thân[độ dài(thân) - 1]["op"] == biên dịch mã opcode("OP_DONG_KHOI");

    thân_gốc = kết["hàm"][0]["bytecode"];
    in thân_gốc[1]["op"] == biên dịch mã opcode("OP_GOI");
    in thân_gốc[1]["chỉ số"] == 1;
    in thân_gốc[1]["toán hạng"] == 0;
    in thân_gốc[3]["chỉ số"] == 2;
    in thân_gốc[3]["op"] == biên dịch mã opcode("OP_GOI");
    in thân_gốc[5]["op"] == biên dịch mã opcode("OP_GOI");
    in thân_gốc[5]["chỉ số"] == 2;
    in độ dài(kết["bytecode"]) == 3;
    in kết["bytecode"][0]["op"] == biên dịch mã opcode("OP_HAM");
    in kết["bytecode"][0]["chỉ số"] == 0;
    in kết["bytecode"][1]["op"] == biên dịch mã opcode("OP_GOI");
    in kết["bytecode"][1]["chỉ số"] == 0;
    in kết["bytecode"][1]["toán hạng"] == 0;
    in kết["bytecode"][1]["giá trị"] == 0;
    in kết["bytecode"][2]["op"] == biên dịch mã opcode("OP_DUNG_CHUONG_TRINH");
    in kết["bytecode"][2]["toán hạng"] == 0;
    in kết["bytecode"][2]["chỉ số"] == 0;
    in kết["bytecode"][2]["giá trị"] == 0;

    // Hai module trùng tên hàm phải có ID khác và không dùng lẫn slot.
    hai = biên dịch chương trình mô đun tự chủ("main", {
        "main": "nhập a như x; nhập b như y; hàm chính() { in x.f(); in y.f(); };",
        "a": "hàm f() { trả về 1; };",
        "b": "hàm f() { trả về 2; };"
    });
    in hai["hàm"][0]["id"] == 0;
    in hai["hàm"][1]["id"] == 1;
    in hai["hàm"][1]["tên index"] == hai["hàm"][2]["tên index"];
    in hai["hàm"][0]["bytecode"][1]["chỉ số"] == 1;
    in hai["hàm"][0]["bytecode"][3]["chỉ số"] == 2;
    in hai["mô đun khởi tạo"][1]["slots"][2] == "f";
    in hai["điểm vào"] == 0;

    // Import lặp không phát lại initializer hoặc OP_HAM.
    lặp_lại = biên dịch chương trình mô đun tự chủ("main", {
        "main": "nhập dep như a; nhập dep như b; hàm chính() { in a.f(); in b.f(); };",
        "dep": "hàm f() { trả về 7; }; in 5;"
    });
    in độ dài(lặp_lại["mô đun khởi tạo"]) == 1;
    in độ dài(lặp_lại["hàm"]) == 2;
    in lặp_lại["hàm"][0]["bytecode"][1]["chỉ số"] == 1;
    in lặp_lại["hàm"][0]["bytecode"][3]["chỉ số"] == 1;
    in độ dài(lặp_lại["mô đun khởi tạo"][0]["bytecode"]) == 3;

    // Chỉ root quyết định entrypoint; mô-đun phụ có `chính` không được gọi.
    không_gọi = biên dịch chương trình mô đun tự chủ("main", {
        "main": "nhập dep như d; in 1;",
        "dep": "hàm chính() { in 2; };"
    });
    in không_gọi["điểm vào"] == -1;
    in độ dài(không_gọi["bytecode"]) == 3;
    in không_gọi["bytecode"][2]["op"] == biên dịch mã opcode("OP_DUNG_CHUONG_TRINH");

    lỗi = sai;
    thử {
        biên dịch chương trình mô đun tự chủ("main", {
            "main": "nhập dep như d; hàm chính() { in d.không_có(); };",
            "dep": "hàm f() {};"
        });
    } bắt lỗi(e) {
        lỗi = chứa chuỗi(thành chuỗi(e), "lời gọi chưa phân giải");
    };
    in lỗi;
    lỗi = sai;
    thử { biên dịch liên kết đồ thị thuần({"loại": "sai"}); }
    bắt lỗi(e) { lỗi = chứa chuỗi(thành chuỗi(e), "cần đồ thị"); };
    in lỗi;
};
