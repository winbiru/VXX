nhập gói.hệ thống.tiến trình.*;

hàm chính() {
    nếu (ten nền tảng máy ảo() == "windows") {
        pid = mã tiến trình();
        in pid > 0;
        in mã tiến trình() == pid;
        in loại của(pid) == "số nguyên";
        ppid = mã tiến trình cha();
        in ppid > 0;
        in ppid != pid;
        in loại của(ppid) == "số nguyên";
        thử { mã người dùng(); } bắt lỗi (e) { in 1; };
        thử { mã người dùng hiệu lực(); } bắt lỗi (e) { in 1; };
        thử { mã nhóm(); } bắt lỗi (e) { in 1; };
        thử { mã nhóm hiệu lực(); } bắt lỗi (e) { in 1; };
    } hoặc {
        pid = mã tiến trình();
        in pid > 0;
        in mã tiến trình() == pid;
        in loại của(pid) == "số nguyên";
        ppid = mã tiến trình cha();
        in ppid > 0;
        in ppid != pid;
        in loại của(ppid) == "số nguyên";
        in mã người dùng() >= 0;
        in loại của(mã người dùng hiệu lực()) == "số nguyên";
        in mã nhóm() >= 0;
        in loại của(mã nhóm hiệu lực()) == "số nguyên";
    };
};
