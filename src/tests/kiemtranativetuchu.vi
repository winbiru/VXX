// Kiểm tra pipeline native nguồn -> AST/IR V++ -> ISA -> đối tượng.
nhập gói.biên dịch.chính.*;

hàm xác nhận(điều_kiện, thông_báo) {
    nếu (!điều_kiện) { ném "native self-host: " + thông_báo; };
}

hàm từ chối(nguồn, tên_hàm) {
    lỗi = sai;
    thử { sinh mã hàm(nguồn, tên_hàm, "aarch64", "macos"); }
    bắt lỗi(e) { lỗi = đúng; };
    xác nhận(lỗi, "phải chặn nguồn không hỗ trợ: " + nguồn);
}

hàm chính() {
    nguồn = "hàm twice(a) { trả về a + a; }; " +
        "hàm sum(n) { biến total = 0; " +
        "lặp (i = 0; i < n; i++) { " +
        "nếu (i == 2) { bỏ qua; }; " +
        "nếu (i == 7) { thoát; }; " +
        "total += twice(i); }; trả về total; };";
    ir = tạo IR(nguồn);
    xác nhận(độ dài(ir["functions"]) == 2, "tạo IR cho hai hàm");
    xác nhận(độ dài(ir["values"]) > 10, "phân tích biểu thức native");
    mac = tạo đối tượng hàm(nguồn, "sum", "aarch64", "macos", "darwin");
    xác nhận(độ dài(mac["bytes"]) > 20, "phát mã AArch64");
    xác nhận(độ dài(mac["relocations"]) == 1, "relocation AArch64");
    xác nhận(mac["relocations"][0]["symbol"] == "twice", "đích gọi AArch64");
    xác nhận(độ dài(mac["object"]) > độ dài(mac["bytes"]), "Mach-O đối tượng");
    linux = tạo đối tượng hàm(nguồn, "sum", "x86_64", "linux", "gnu");
    xác nhận(độ dài(linux["bytes"]) > 20, "phát mã x86_64");
    xác nhận(độ dài(linux["relocations"]) == 1, "relocation x86_64");
    xác nhận(độ dài(linux["object"]) > độ dài(linux["bytes"]), "ELF đối tượng");
    win = tạo đối tượng hàm(nguồn, "sum", "x86_64", "windows", "msvc");
    xác nhận(độ dài(win["object"]) > độ dài(win["bytes"]), "COFF đối tượng");

    // Parameter/local có tên trùng function ID phải có namespace riêng.
    che = "hàm item(x) { trả về x + 1; }; " +
          "hàm other(item) { trả về item * 2; };";
    máy = sinh mã hàm(che, "other", "aarch64", "macos");
    xác nhận(máy["machine"]["slotCount"] == 1, "tham số che tên hàm");
    // Hai phép logic cần nhánh ngắn và giá trị bool 0/1 cho cả hai ABI.
    logic = "hàm f(a, b) { trả về (a && b) || !a; };";
    mã logic = sinh mã hàm(logic, "f", "aarch64", "macos");
    lệnh logic = mã logic["machine"]["instructions"];
    nhánh = 0;
    nhảy = 0;
    lặp (i = 0; i < độ dài(lệnh logic); i++) {
        nếu (lệnh logic[i]["opcode"] == "BranchZero") { nhánh += 1; };
        nếu (lệnh logic[i]["opcode"] == "Jump") { nhảy += 1; };
    };
    xác nhận(nhánh == 2 && nhảy == 2, "toán tử && và || tạo nhánh ngắn");
    xác nhận(độ dài(tạo đối tượng hàm(logic, "f", "x86_64", "linux", "gnu")["object"]) > 0,
        "toán tử logic phát ELF x86_64");
    xác nhận(độ dài(tạo đối tượng hàm(logic, "f", "x86_64", "windows", "msvc")["object"]) > 0,
        "toán tử logic phát COFF x86_64");
    từ chối("hàm f(a) { trả về unknown + a; };", "f");
    từ chối("hàm f(a) { trả về a(1); };", "f");
    từ chối("hàm f(a = 7) { trả về a; };", "f");
    // In i32 đã được native hỗ trợ; in literal chuỗi vẫn phải bị từ chối.
    từ chối("hàm f() { in \"chuỗi\"; trả về 1; };", "f");
    từ chối("hàm f() { trả về 2147483648; };", "f");
    in "native-selfhost-ok";
}
