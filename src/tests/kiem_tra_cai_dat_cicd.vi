// Chạy bằng compiler đã cài đặt để kiểm tra tìm kiếm thư viện chuẩn qua VPP_HOME.
// Chỉ nhập các API cần thiết: nhập toàn bộ gói.chuẩn.chính tải hàng trăm
// mô đun không liên quan, gây timeout không ổn định trên runner macOS.
nhập gói.văn bản.chuỗi.độ dài;
nhập gói.lõi.chuyển kiểu.thành số nguyên;

hàm chính() {
    nếu (độ dài("V++") != 3) {
        ném "Lỗi thư viện chuẩn: độ dài chuỗi";
    };
    nếu (thành số nguyên("42") != 42) {
        ném "Lỗi thư viện chuẩn: chuyển số nguyên";
    };
    in "vpp_installed_stdlib_ok";
};
