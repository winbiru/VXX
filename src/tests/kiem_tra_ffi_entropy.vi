nhập gói/lõi/nguồn ngẫu nhiên;
nhập mật mã;
nhập ngẫu nhiên;

hàm chính() {
    một = nguồn ngẫu nhiên bảo mật các byte(1);
    in độ dài(một) == 1;
    in loại của(một[0]) == "số nguyên" && một[0] >= 0 && một[0] <= 255;
    // Một lệnh getentropy nhận tối đa 256 byte; 257 và 4096 cần nhiều đợt.
    in độ dài(nguồn ngẫu nhiên bảo mật các byte(256)) == 256;
    in độ dài(nguồn ngẫu nhiên bảo mật các byte(257)) == 257;
    in độ dài(nguồn ngẫu nhiên bảo mật các byte(4096)) == 4096;
    in độ dài(ngẫu nhiên bảo mật(257)) == 514;
    in độ dài(ngẫu nhiên bảo mật(4096)) == 8192;
    x = ngẫu nhiên nguyên(0, 100);
    in x >= 0 && x <= 100;

    thử { nguồn ngẫu nhiên bảo mật các byte(0); } bắt lỗi(e) { in "chặn 0"; };
    thử { nguồn ngẫu nhiên bảo mật các byte(4097); } bắt lỗi(e) { in "chặn 4097"; };
    thử { nguồn ngẫu nhiên bảo mật các byte(2.5); } bắt lỗi(e) { in "chặn phân số"; };
};
