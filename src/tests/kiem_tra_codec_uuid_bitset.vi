nhập gói/chuẩn/chính;

hàm chính() {
    in base64 mã([77, 97, 110]);
    in base64 mã([77, 97]);
    in base64 mã([77]);
    in base64 mã([251, 255], "URL_AN_TOÀN");
    in base64 giải("TWFu");
    in base64 giải("TWE=");
    in base64 giải("TQ==");
    in base64 giải("-_8=", "URL_AN_TOÀN");
    in base64 mã([77], "CHUẨN", sai);
    in base64 giải("TQ");
    thử {
        base64 giải("TQ=");
    } bắt lỗi (e) {
        in e;
    };
    in base64 giải(" T W F u \n", "CHUẨN", đúng);
    in base64 giải("T W@Fu\r\n", "MIME");

    roundtrip = đúng;
    lặp(i = 0; i < 256; i++) {
        encoded = base64 mã([i]);
        decoded = base64 giải(encoded);
        nếu (độ dài(decoded) != 1) {
            roundtrip = sai;
        } nếu không {
            nếu (decoded[0] != i) {
                roundtrip = sai;
            };
        };
    };
    in roundtrip;

    in hex mã([0, 15, 16, 255]);
    in hex mã([0, 15, 16, 255], đúng, ":");
    in hex giải("000f10ff");
    in hex giải("00:0F:10:FF", ":");
    hex_roundtrip = đúng;
    lặp(i = 0; i < 256; i++) {
        encoded = hex mã([i], i % 2 == 0);
        decoded = hex giải(encoded);
        nếu (độ dài(decoded) != 1) {
            hex_roundtrip = sai;
        } nếu không {
            nếu (decoded[0] != i) {
                hex_roundtrip = sai;
            };
        };
    };
    in hex_roundtrip;
    thử {
        hex giải("00-0f:10", ":");
    } bắt lỗi (e) {
        in e;
    };

    id = uuid ngẫu nhiên();
    in độ dài(id) == 36;
    in id[14] == "4";
    in chứa chuỗi("89ab", id[19]);
    in uuid text(uuid parse("550E8400-E29B-41D4-A716-446655440000"));

    a = tập bit();
    bit đặt(a, 1);
    bit đặt(a, 5);
    bit đặt(a, 9);
    in bit có(a, 5);
    in bit có(a, 6);
    in bit tiếp đặt(a, 2);
    in bit độ dài(a);
    in bit số bit(a);
    bit lật(a, 5);
    in bit có(a, 5);

    b = tập bit();
    bit đặt(b, 1);
    bit đặt(b, 2);
    bit đặt(b, 9);
    in bit số bit(bit và(a, b));
    in bit số bit(bit hoặc(a, b));
    in bit số bit(bit xor(a, b));

    a_copy = bit sao chép(a);
    in bit bằng(a, a_copy);
    bit đặt(a_copy, 100);
    in bit bằng(a, a_copy);
    bit xóa(a_copy, 100);
    in bit bằng(a, a_copy);

    thử {
        bit có(a, "1");
    } bắt lỗi (e) {
        in e;
    };
};
