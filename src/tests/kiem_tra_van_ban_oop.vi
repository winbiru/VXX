nhập gói/văn bản/chính;
nhập gói/lõi/định dạng;
nhập gói/lõi/biểu thức chính quy;
nhập gói/kiểm thử/chính;

hàm chính() {
    a = Bộ Quét("12 3.5 Việt");
    b = Bộ Quét("7");
    khẳng định đúng(a.xem số nguyên());
    khẳng định bằng(a.vị trí(), 0);
    khẳng định bằng(a.đọc số nguyên(), 12);
    khẳng định bằng(b.đọc số nguyên(), 7);
    khẳng định đúng(a.xem số thực());
    khẳng định bằng(a.đọc số thực(), 3.5);
    khẳng định bằng(a.đọc từ tố(), "Việt");
    khẳng định sai(a.còn từ tố());
    hành_động_1 = hàm() { a.đọc từ tố(); };
    khẳng định ném lỗi(hành_động_1, "SCAN_END");
    khẳng định đúng(a.đóng());
    khẳng định sai(a.đóng());
    hành_động_2 = hàm() { a.còn từ tố(); };
    khẳng định ném lỗi(hành_động_2, "SCAN_CLOSED");
    c = Bộ Quét("a,,b", ",+", đúng);
    khẳng định bằng(c.đọc từ tố(), "a");
    khẳng định bằng(c.đọc từ tố(), "b");
    d = Bộ Quét("x 42");
    hành_động_3 = hàm() { d.đọc số nguyên(); };
    khẳng định ném lỗi(hành_động_3);
    khẳng định bằng(d.đọc từ tố(), "x");
    khẳng định bằng(d.đọc số nguyên(), 42);
    in "bộ quét OOP: đạt";

    mẫu = Biểu Thức Chính Quy("([a-z]+)([0-9]+)");
    khẳng định đúng(mẫu.khớp("abc12"));
    khẳng định sai(mẫu.khớp("abc"));
    khẳng định bằng(mẫu.tìm("!x2?"), "x2");
    khẳng định bằng(mẫu.thay("x2 y3", "$2:$1"), "2:x 3:y");
    khẳng định bằng(mẫu.tìm("!x2?"), biểu thức chính quy tìm("!x2?", "([a-z]+)([0-9]+)"));
    phân_cách = Biểu Thức Chính Quy(",");
    tách = phân_cách.tách(",a,,b,");
    khẳng định bằng(độ dài(tách), 4);
    khẳng định bằng(tách[0], "");
    khẳng định bằng(tách[2], "");
    rỗng_khớp = Biểu Thức Chính Quy("a*");
    khẳng định bằng(rỗng_khớp.thay("b", "x"), biểu thức chính quy thay("b", "a*", "x"));
    hành_động_4 = hàm() { Biểu Thức Chính Quy("["); };
    khẳng định ném lỗi(hành_động_4);
    in "regex OOP: đạt";

    định_dạng = Bộ Định Dạng();
    khác = Bộ Định Dạng();
    khẳng định bằng(định_dạng.thêm("%s:%04d", ["V++", 7]), định_dạng);
    khẳng định bằng(định_dạng.kết quả(), "V++:0007");
    hành_động_5 = hàm() { định_dạng.thêm("%q", [1]); };
    khẳng định ném lỗi(hành_động_5);
    khẳng định bằng(định_dạng.kết quả(), "V++:0007");
    khẳng định bằng(khác.kết quả(), "");
    khẳng định bằng(định_dạng.đặt lại().kết quả(), "");
    in "formatter OOP: đạt";
};
