// Parser câu lệnh và semantic pass chạy hoàn toàn trong thư viện V++.
nhập gói/biên dịch/chính;
nhập gói/bộ sưu tập/từ điển;

hàm chính() {
    nguồn = "nhập gói/bộ sưu tập/từ điển; " +
        "hàm tính tổng(a, b) { biến kết_quả = a + b * 2; " +
        "nếu (kết_quả > 0) { in kết_quả; } hoặc { in 0; }; " +
        "trả về kết_quả; }; " +
        "hàm chính() { tính_tổng(1, 2); };";
    cây = biên dịch phân tích chương trình tự chủ(nguồn);
    in lấy từ điển(cây, "loại", "") == "chương trình";
    câu_lệnh = lấy từ điển(cây, "câu lệnh", []);
    in độ dài(câu_lệnh) == 3;
    in lấy từ điển(câu_lệnh[0], "loại", "") == "nhập";
    in lấy từ điển(câu_lệnh[0], "đích", "") == "gói/bộ sưu tập/từ điển";
    khai_báo = câu_lệnh[1];
    in lấy từ điển(khai_báo, "tên", "") == "tính tổng";
    in độ dài(lấy từ điển(khai_báo, "tham số", [])) == 2;
    thân = lấy từ điển(khai_báo, "thân", {});
    các_lệnh = lấy từ điển(thân, "câu lệnh", []);
    in độ dài(các_lệnh) == 3;
    in lấy từ điển(các_lệnh[0], "loại", "") == "biến";
    biểu_thức = lấy từ điển(các_lệnh[0], "giá trị", {});
    in lấy từ điển(biểu_thức, "toán tử", "") == "+";
    in lấy từ điển(lấy từ điển(biểu_thức, "phải", {}), "toán tử", "") == "*";
    nhánh = các_lệnh[1];
    in lấy từ điển(nhánh, "loại", "") == "nếu";
    in lấy từ điển(lấy từ điển(nhánh, "điều kiện", {}), "toán tử", "") == ">";
    in lấy từ điển(lấy từ điển(nhánh, "nhánh khác", {}), "loại", "") == "khối";
    in lấy từ điển(các_lệnh[2], "loại", "") == "trả về";
    in lấy từ điển(lấy từ điển(các_lệnh[2], "biểu thức", {}), "giá trị", "") == "kết_quả";

    // Không bắt buộc khai báo trước khi gọi; biểu thức được phân tích độc lập.
    in độ dài(lấy từ điển(lấy từ điển(câu_lệnh[2], "thân", {}), "câu lệnh", [])) == 1;
    in lấy từ điển(biên dịch phân tích chương trình thuần(""), "loại", "") == "chương trình";
    in độ dài(lấy từ điển(biên dịch phân tích chương trình thuần(";;"), "câu lệnh", [])) == 2;

    // Từ khóa có thể nằm giữa hoặc cuối định danh tham số nhiều từ.
    // Bao gồm chữ ký phương thức và tham số mặc định của compiler self-hosted.
    cây_tham_số = biên dịch phân tích chương trình thuần(
        "hàm riêng tư biên dịch nguồn đích(mô đun nhập, đích, thư viện) { trả về đích; }; " +
        "hàm công khai biên dịch đồ thị chu trình(ngăn, lặp lại) { trả về lặp lại; }; " +
        "lớp công khai Bộ Tách { " +
        "hàm công khai khởi tạo(mã nguồn = \"\") { trả về mã nguồn; }; " +
        "hàm công khai làm mới(giá trị mặc định, mô đun nhập) { trả về mô đun nhập; }; " +
        "};"
    );
    các_khai_báo = lấy từ điển(cây_tham_số, "câu lệnh", []);
    các_tham_số = lấy từ điển(các_khai_báo[0], "tham số", []);
    nếu (độ dài(các_tham_số) != 3 || các_tham_số[0] != "mô đun nhập" ||
        các_tham_số[1] != "đích" || các_tham_số[2] != "thư viện") {
        ném "parser tham số hàm nhiều từ không chính xác";
    };
    nếu (lấy từ điển(các_khai_báo[1], "tham số", [])[1] != "lặp lại") {
        ném "parser tham số bắt đầu bằng từ khóa không chính xác";
    };
    các_phương_thức = lấy từ điển(các_khai_báo[2], "phương thức", []);
    nếu (lấy từ điển(các_phương_thức[0], "tham số", [])[0] != "mã nguồn" ||
        lấy từ điển(các_phương_thức[1], "tham số", [])[0] != "giá trị mặc định" ||
        lấy từ điển(các_phương_thức[1], "tham số", [])[1] != "mô đun nhập" ||
        lấy từ điển(các_phương_thức[0], "mặc định tham số", [])[0] == rỗng) {
        ném "parser tham số phương thức nhiều từ không chính xác";
    };
    cây_tên_từ_khóa = biên dịch phân tích chương trình thuần(
        "nhập gói/nhập xuất/đường dẫn như đường giao diện lập trình; " +
        "thử {} bắt lỗi(số mục bỏ qua) {};"
    );
    các_lệnh_tên = lấy từ điển(cây_tên_từ_khóa, "câu lệnh", []);
    nếu (lấy từ điển(các_lệnh_tên[0], "bí danh", "") != "đường giao diện lập trình" ||
        lấy từ điển(các_lệnh_tên[1], "biến lỗi", "") != "số mục bỏ qua") {
        ném "parser bí danh và biến bắt lỗi nhiều từ không chính xác";
    };

    cây_nếu = biên dịch phân tích ngữ nghĩa thuần(
        "hàm f(x) { nếu (x) { trả về 1; } hoặc nếu (x == 0) { trả về 0; }; };" );
    in độ dài(lấy từ điển(cây_nếu, "câu lệnh", [])) == 1;
    chuỗi_nhánh = biên dịch phân tích chương trình thuần(
        "nếu (sai) { in 1; } hoặc nếu (đúng) { in 2; } hoặc { in 3; };"
    );
    nhánh_đầu = lấy từ điển(chuỗi_nhánh, "câu lệnh", [])[0];
    in lấy từ điển(nhánh_đầu, "loại", "") == "nếu";
    nhánh_giữa = lấy từ điển(nhánh_đầu, "nhánh khác", {});
    in lấy từ điển(nhánh_giữa, "loại", "") == "nếu";
    in lấy từ điển(lấy từ điển(nhánh_giữa, "nhánh khác", {}), "loại", "") == "khối";
    lỗi_cũ = sai;
    thử { biên dịch phân tích chương trình thuần("nếu (đúng) {} nếu không {};"); }
    bắt lỗi (e) { lỗi_cũ = đúng; };
    in lỗi_cũ;
    lỗi_cũ = sai;
    thử { biên dịch phân tích("hàm chính() { nếu (đúng) {} nếu không {}; };"); }
    bắt lỗi (e) { lỗi_cũ = đúng; };
    in lỗi_cũ;

    // Parser C++ và parser self-host cùng loại bỏ các chuỗi nhánh sai ngữ pháp.
    mã_sai = [
        "hàm chính() { nếu (đúng) {} hoặc {} hoặc {}; };",
        "hàm chính() { hoặc {}; };",
        "hàm chính() { nếu (đúng) {} hoặc nếu {}; };",
        "hàm chính() { nếu (đúng) {} hoặc nếu (sai) in 1; };",
        "hàm chính() { nếu (đúng) {} hoặc sai {}; };"
    ];
    lặp(i = 0; i < độ dài(mã_sai); i++) {
        lỗi_vpp = sai;
        thử { biên dịch phân tích chương trình thuần(mã_sai[i]); }
        bắt lỗi (e) { lỗi_vpp = đúng; };
        in lỗi_vpp;
        lỗi_cpp = sai;
        thử { biên dịch phân tích(mã_sai[i]); }
        bắt lỗi (e) { lỗi_cpp = đúng; };
        in lỗi_cpp;
    };

    vòng = biên dịch phân tích ngữ nghĩa thuần(
        "hàm f() { lặp(i = 0; i < 3; i++) { " +
        "nếu (i == 2) { thoát; }; bỏ qua; }; };" );
    khai_báo_vòng = lấy từ điển(vòng, "câu lệnh", []);
    hàm_vòng = khai_báo_vòng[0];
    thân_vòng = lấy từ điển(hàm_vòng, "thân", {});
    vòng_lặp = lấy từ điển(thân_vòng, "câu lệnh", [])[0];
    in lấy từ điển(vòng_lặp, "loại", "") == "lặp";
    in lấy từ điển(lấy từ điển(vòng_lặp, "khởi tạo", {}), "toán tử", "") == "=";
    in lấy từ điển(lấy từ điển(vòng_lặp, "điều kiện", {}), "toán tử", "") == "<";
    in lấy từ điển(lấy từ điển(vòng_lặp, "cập nhật", {}), "loại", "") == "cập nhật";
    in lấy từ điển(lấy từ điển(vòng_lặp, "cập nhật", {}), "toán tử", "") == "++";
    in độ dài(lấy từ điển(lấy từ điển(vòng_lặp, "thân", {}), "câu lệnh", [])) == 2;

    trống = biên dịch phân tích ngữ nghĩa thuần("lặp(;;) { thoát; };");
    danh_sách_trống = lấy từ điển(trống, "câu lệnh", []);
    in lấy từ điển(danh_sách_trống[0], "điều kiện", 1) == rỗng;

    lỗi = sai;
    thử { biên dịch phân tích chương trình thuần("hàm f(a) { trả về a;"); }
    bắt lỗi (e) { lỗi = đúng; };
    in lỗi;
    lỗi = sai;
    thử { biên dịch phân tích chương trình thuần("hàm f(,) {}"); }
    bắt lỗi (e) { lỗi = đúng; };
    in lỗi;
    lỗi = sai;
    thử { biên dịch phân tích chương trình thuần("hàm f() { in 1 }"); }
    bắt lỗi (e) { lỗi = đúng; };
    in lỗi;
    lỗi = sai;
    thử { biên dịch phân tích chương trình thuần("lặp(i = 0; i < 3; i++ {}"); }
    bắt lỗi (e) { lỗi = đúng; };
    in lỗi;
    lỗi = sai;
    thử { biên dịch phân tích ngữ nghĩa thuần("trả về 2;"); }
    bắt lỗi (e) { lỗi = đúng; };
    in lỗi;
    lỗi = sai;
    thử { biên dịch phân tích ngữ nghĩa thuần("hàm f() {}; hàm f() {};"); }
    bắt lỗi (e) { lỗi = đúng; };
    in lỗi;
    lỗi = sai;
    thử { biên dịch phân tích ngữ nghĩa thuần("hàm f(a, a) {};"); }
    bắt lỗi (e) { lỗi = đúng; };
    in lỗi;
    lỗi = sai;
    thử { biên dịch phân tích ngữ nghĩa thuần("hàm f() { 1 = 2; };"); }
    bắt lỗi (e) { lỗi = đúng; };
    in lỗi;
    lỗi = sai;
    thử { biên dịch phân tích ngữ nghĩa thuần("hàm f() { hàm g() {}; };"); }
    bắt lỗi (e) { lỗi = đúng; };
    in lỗi;
    lỗi = sai;
    thử { biên dịch phân tích ngữ nghĩa thuần("thoát;"); }
    bắt lỗi (e) { lỗi = đúng; };
    in lỗi;
    lỗi = sai;
    thử { biên dịch phân tích ngữ nghĩa thuần("bỏ qua;"); }
    bắt lỗi (e) { lỗi = đúng; };
    in lỗi;
    lỗi = sai;
    thử { biên dịch phân tích ngữ nghĩa thuần("hàm f() { (1)++; };"); }
    bắt lỗi (e) { lỗi = đúng; };
    in lỗi;

    // Bí danh `như` được khai báo theo lexical scope và namespace module C++.
    // So hai trường hợp top-level với oracle C++.
    mã_trùng_bí_danh = "nhập gói/bộ sưu tập/từ điển như trợ_lý; " +
        "nhập gói/biên dịch/chính như trợ_lý;";
    lỗi_vpp = sai;
    thử { biên dịch phân tích ngữ nghĩa thuần(mã_trùng_bí_danh); }
    bắt lỗi (e) { lỗi_vpp = đúng; };
    in lỗi_vpp;
    lỗi_cpp = sai;
    thử { biên dịch phân tích(mã_trùng_bí_danh); }
    bắt lỗi (e) { lỗi_cpp = đúng; };
    in lỗi_cpp;

    mã_bí_danh_riêng = "nhập gói/bộ sưu tập/từ điển như trợ_lý; " +
        "nhập gói/biên dịch/chính như trình_dịch;";
    lỗi_vpp = sai;
    thử { biên dịch phân tích ngữ nghĩa thuần(mã_bí_danh_riêng); }
    bắt lỗi (e) { lỗi_vpp = đúng; };
    in !lỗi_vpp;
    lỗi_cpp = sai;
    thử { biên dịch phân tích(mã_bí_danh_riêng); }
    bắt lỗi (e) { lỗi_cpp = đúng; };
    in !lỗi_cpp;

    lỗi = sai;
    thử { biên dịch phân tích ngữ nghĩa thuần(
        "hàm f() { nhập a như x; nhập b như x; };" ); }
    bắt lỗi (e) { lỗi = đúng; };
    in lỗi;
    lỗi = sai;
    thử { biên dịch phân tích ngữ nghĩa thuần(
        "hàm f() { nếu (đúng) { nhập a như x; } hoặc { nhập b như x; }; };" ); }
    bắt lỗi (e) { lỗi = đúng; };
    in !lỗi;
    lỗi = sai;
    thử { biên dịch phân tích ngữ nghĩa thuần(
        "hàm f() { nhập a như x; }; hàm g() { nhập b như x; };" ); }
    bắt lỗi (e) { lỗi = đúng; };
    in !lỗi;
    lỗi = sai;
    thử { biên dịch phân tích ngữ nghĩa thuần(
        "hàm x() {}; biến y = 1; nhập a như x; nhập b như y;" ); }
    bắt lỗi (e) { lỗi = đúng; };
    in !lỗi;
    lỗi = sai;
    thử { biên dịch phân tích ngữ nghĩa thuần("nhập a; nhập a;"); }
    bắt lỗi (e) { lỗi = đúng; };
    in !lỗi;

    // C++ Semantic::declareAssignmentTarget cấm ghi vào function ID.
    // Tham số/biến cục bộ có thể che tên hàm, kể cả khai báo biến ở sau.
    các_ca_gán_hàm = [
        {"nguồn": "đích = 2; hàm đích() {}; hàm chính() {};", "hợp lệ": sai},
        {"nguồn": "hàm đích() {}; hàm chính() { đích = 3; };", "hợp lệ": sai},
        {"nguồn": "hàm đích() {}; hàm chính() { đích += 1; };", "hợp lệ": sai},
        {"nguồn": "hàm đích() {}; hàm chính() { đích++; };", "hợp lệ": sai},
        {"nguồn": "hàm đích() {}; hàm chính() { biến đích = 0; đích = 1; };",
         "hợp lệ": đúng},
        {"nguồn": "hàm đích() {}; hàm chính() { đích = 1; biến đích = 0; };",
         "hợp lệ": đúng},
        {"nguồn": "hàm đích() {}; hàm phụ(đích) { đích++; }; hàm chính() {};",
         "hợp lệ": đúng},
        {"nguồn": "hàm đích() { trả về 2; }; hàm chính() { in đích(); };",
         "hợp lệ": đúng}
    ];
    lặp(i = 0; i < độ dài(các_ca_gán_hàm); i++) {
        ca = các_ca_gán_hàm[i];
        lỗi_vpp = sai;
        thử { biên dịch phân tích ngữ nghĩa thuần(ca["nguồn"]); }
        bắt lỗi (e) { lỗi_vpp = đúng; };
        lỗi_cpp = sai;
        thử { biên dịch phân tích(ca["nguồn"]); }
        bắt lỗi (e) { lỗi_cpp = đúng; };
        in lỗi_vpp == !ca["hợp lệ"];
        in lỗi_vpp == lỗi_cpp;
    };
};
