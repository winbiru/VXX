// Khóa contract exception 1.0: ném đi xuyên function boundary, bắt gần nhất và rethrow.

hàm nem_sau() {
    nếu (đúng) {
        ném "loi-sau";
    };
}

hàm goi_giua() {
    nem_sau();
    in "khong-duoc-in";
}

hàm bat_va_nem_lai() {
    thử {
        goi_giua();
    } bắt lỗi (e) {
        in "bat-trong:" + e;
        ném e + "-lai";
    }
}

hàm bat_vao_closure() {
    doc_loi = rỗng;
    thử {
        ném "loi-closure";
    } bắt lỗi (e) {
        doc_loi = hàm() {
            trả về e;
        };
    }
    trả về doc_loi;
}

hàm main() {
    thử {
        bat_va_nem_lai();
    } bắt lỗi (e) {
        in "bat-ngoai:" + e;
    }
    doc_loi = bat_vao_closure();
    in "bat-closure:" + doc_loi();
    in "sau-bat";
}
