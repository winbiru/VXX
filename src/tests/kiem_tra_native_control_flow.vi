// Hàm i32 tổng quát dùng để so sánh VM với mã máy native x86_64/AArch64.
hàm tinh(a, b) {
    biến result = a * b;
    nếu (a < b) { result = result + b; }
    hoặc { result = result - b; };
    trả về result;
}

hàm tong(n) {
    biến total = 0;
    lặp (i = 0; i < n; i = i + 1) {
        total = total + i;
    };
    trả về total;
}

hàm tong_khi(n) {
    biến total = 0;
    biến i = 0;
    khi (i < n) {
        total = total + i;
        i = i + 1;
    };
    trả về total;
}

hàm dieu_khien_khi(n) {
    biến total = 0;
    biến i = 0;
    khi (i < n) {
        i = i + 1;
        nếu (i == 2) { bỏ qua; };
        nếu (i == 6) { thoát; };
        total = total + i;
    };
    trả về total;
}

hàm max_i32(a, b) {
    nếu (a >= b) { trả về a; }
    hoặc { trả về b; };
}

hàm tong_bon(a, b, c, d) {
    trả về (a + b) - c * d;
}

hàm tru_dao(a, b) {
    trả về b - a;
}

// Biên dịch phép chia i32 thành lệnh máy trực tiếp, không gọi runtime C++.
hàm chia_i32(a, b) {
    trả về a / b;
}

// Thử đường stack/call ngoài đường ARM64 tối ưu hoàn toàn trong thanh ghi.
hàm chia_qua_ham(a, b) {
    biến trung_gian = chia_i32(a, b);
    trả về trung_gian / 1;
}

hàm phu_dinh(n) {
    nếu (!(n == 0)) { trả về 1; }
    hoặc { trả về 0; };
}

hàm phan_loai(a, b) {
    nếu (a < 0) {
        nếu (b < 0) { trả về -2; }
        hoặc { trả về -1; };
    }
    hoặc {
        nếu (b == 0) { trả về 0; }
        hoặc { trả về a + b; };
    };
}

hàm tim_dau(n) {
    biến total = 0;
    lặp (i = 0; i < n; i = i + 1) {
        nếu (i == 4) { trả về total + 100; };
        total = total + i;
    };
    trả về total;
}

hàm dieu_kien(n) {
    nếu (n != 0) { trả về 12; };
    trả về -12;
}

// CMP immediate nhỏ và CMP với scratch register cho hằng lớn/âm.
hàm so_sanh_nho(n) {
    nếu (n < 4095) { trả về 12; };
    trả về -12;
}

hàm so_sanh_lon(n) {
    nếu (n >= 65521) { trả về 12; };
    trả về -12;
}

hàm so_sanh_am(n) {
    nếu (n == -1) { trả về 12; };
    trả về -12;
}

// Cùng hằng lớn dùng cho CMP và SUB trong vòng lặp: W10 được tải một lần.
hàm hoist_vong(seed, n) {
    biến x = seed;
    lặp (i = 0; i < n; i = i + 1) {
        x = x + 251;
        nếu (x >= 65521) { x = x - 65521; };
    };
    trả về x;
}

// Hai vòng tách biệt có hằng âm và hằng dương ngoài imm12.
// Một hằng dùng W10; hằng còn lại dùng W9 mà không phá hủy W10.
hàm hoist_hai_vong(seed, n) {
    biến x = seed;
    lặp (i = 0; i < n; i = i + 1) {
        x = x + (-17);
        x = x - (-17);
    };
    lặp (j = 0; j < n; j = j + 1) {
        x = x + 8193;
        x = x - 8193;
    };
    trả về x;
}

// Nhánh bỏ qua trong vòng lặp lồng nhau không được làm sai trạng thái slot.
hàm hoist_long_nhau(seed, n) {
    biến x = seed;
    lặp (i = 0; i < n; i = i + 1) {
        lặp (j = 0; j < 3; j = j + 1) {
            nếu (j == 1) { bỏ qua; };
            x = x + 65521;
            x = x - 65521;
        };
    };
    trả về x;
}

// Hàm có CALL phải dùng frame/stack fallback thay vì W10 hoisting.
hàm hoist_goi(seed, n) {
    biến x = seed;
    lặp (i = 0; i < n; i = i + 1) {
        x = x + 65521;
        x = x - 65521;
        x = chia_i32(x, 1);
    };
    trả về x;
}

hàm bo_qua(n) {
    biến total = 0;
    lặp (i = 0; i < n; i = i + 1) {
        nếu (i == 2) { bỏ qua; };
        nếu (i == 6) { thoát; };
        total = total + i;
    };
    trả về total;
}

// 14 local/parameter slots + 2 evaluation slots: last register is W17.
hàm register_limit(a, b, c, d) {
    biến v0 = a + b;
    biến v1 = c - d;
    biến v2 = v0 + v1;
    biến v3 = v2 + 3;
    biến v4 = v3 - 4;
    biến v5 = v4 + 5;
    biến v6 = v5 - 6;
    biến v7 = v6 + 7;
    biến v8 = v7 - 8;
    biến v9 = v8 + 9;
    trả về v0 + v1 + v2 + v3 + v4 + v5 + v6 + v7 + v8 + v9;
}

// One slot beyond the register budget must retain the stack-based path.
hàm register_overflow(a, b, c, d) {
    biến v0 = a + b;
    biến v1 = c - d;
    biến v2 = v0 + v1;
    biến v3 = v2 + 3;
    biến v4 = v3 - 4;
    biến v5 = v4 + 5;
    biến v6 = v5 - 6;
    biến v7 = v6 + 7;
    biến v8 = v7 - 8;
    biến v9 = v8 + 9;
    biến v10 = v9 + 10;
    trả về v0 + v1 + v2 + v3 + v4 + v5 + v6 + v7 + v8 + v9 + v10;
}

hàm chính() {
    in tinh(2, 5);
    in tinh(5, 2);
    in tong(8);
    in max_i32(-7, -3);
    in tong_bon(3, 5, 2, 4);
    in tru_dao(2, 5);
    in phu_dinh(0);
    in phu_dinh(-1);
    in phan_loai(-1, -2);
    in tim_dau(5);
    in dieu_kien(0);
    in bo_qua(9);
}
