nhập đầu nối mạng;

hàm chính() {
    tcp = đầu nối giao vận tin cậy mở("127.0.0.1", "18080", 1000.0);
    yêu_cầu = "GET /health HTTP/1.0\r\nHost: 127.0.0.1\r\nConnection: close\r\n\r\n";
    in đầu nối gửi(tcp, yêu_cầu) > 0;
    phản_hồi = đầu nối nhận(tcp, "4096");
    in độ dài(phản_hồi) > 0;
    in đầu nối đặt thời gian chờ(tcp, "1000");
    in đầu nối đóng(tcp);

    udp = đầu nối giao vận gói tin mở("127.0.0.1", "9", 1000.0);
    in đầu nối gửi(udp, "kiểm tra kết nối") == 4;
    in đầu nối đóng(udp);
};
