// Compiler Stage 2: compilation happens inside V++ mã trung gian.
nhập gói.biên dịch.sản phẩm biên dịch.*;
nhập gói.biên dịch.liên kết.*;

hàm chính() {
    nguồn = "hàm tổng(n, b = 7) { s = b; lặp(i = 0; i < n; i++) { s += i; }; trả về s; }; " +
            "hàm chính() { in tổng(10); };";
    in biên dịch sản phẩm biên dịch tuần tự(biên dịch chương trình tự chủ(nguồn));
};
