nhập gói/bộ sưu tập/chính;
nhập gói/lõi/tập bản ghi;
nhập gói/dữ liệu/json/chính;
nhập gói/dữ liệu/xml/dom;
nhập gói/kiểm thử/chính;

hàm chính() {
    nguồn = [1, 2];
    ds = Danh Sách(nguồn);
    thêm(nguồn, 3);
    khẳng định bằng(ds.số lượng(), 2);
    khẳng định sai(ds.trống());
    khẳng định bằng(ds.thêm(4).đặt(0, 7), ds);
    khẳng định bằng(ds.tại(0), 7);
    khẳng định bằng(ds.xóa(1), 2);
    bản_sao = ds.danh sách();
    thêm(bản_sao, 9);
    khẳng định bằng(ds.số lượng(), 2);
    hành_động = hàm() { ds.tại(-1); };
    khẳng định ném lỗi(hành_động);
    khẳng định đúng(Danh Sách().trống());

    nguồn_hàng = [{"id": 1, "nhóm": "a"}, {"id": 2, "nhóm": "b"}];
    rows = Tập Bản Ghi(nguồn_hàng);
    thêm(nguồn_hàng, {"id": 3});
    khẳng định bằng(rows.số lượng(), 2);
    lọc = rows.lọc bằng("nhóm", "a");
    khẳng định bằng(lọc.số lượng(), 1);
    khẳng định bằng(lọc.tại(0)["id"], 1);
    cột_id = rows.cột("id");
    khẳng định bằng(cột_id[1], 2);
    bản_sao_hàng = rows.danh sách();
    thêm(bản_sao_hàng, {});
    khẳng định bằng(rows.số lượng(), 2);
    hành_động = hàm() { rows.tại(2); };
    khẳng định ném lỗi(hành_động);
    in "collections và rowset OOP: đạt";

    tài_liệu = Tài Liệu JSON("{\"x\":42}");
    khẳng định bằng(tài_liệu.lấy("x"), 42);
    khẳng định bằng(tài_liệu.lấy("thiếu", 7), 7);
    hành_động = hàm() { tài_liệu.nạp("{"); };
    khẳng định ném lỗi(hành_động);
    khẳng định bằng(tài_liệu.lấy("x"), 42);
    khẳng định bằng(tài_liệu.văn bản(), "{\"x\":42}");
    khẳng định bằng(tài_liệu.nạp("null").giá trị(), rỗng);
    hành_động = hàm() { tài_liệu.lấy("x"); };
    khẳng định ném lỗi(hành_động, "json: tài liệu không phải đối tượng");
    in "JSON OOP: đạt";

    phần_tử_gốc = Phần Tử DOM("gốc");
    con = Phần Tử DOM("con");
    con.đặt nội dung("V++ & Việt");
    khẳng định bằng(phần_tử_gốc.đặt thuộc tính("id", "1").thêm con(con), phần_tử_gốc);
    khẳng định bằng(phần_tử_gốc.số con(), 1);
    khẳng định bằng(phần_tử_gốc.con(0).nội dung(), "V++ & Việt");
    khẳng định bằng(phần_tử_gốc.thuộc tính("id"), "1");
    khẳng định đúng(độ dài(phần_tử_gốc.văn bản()) > 0);
    phần_tử_gốc.con(0).đặt nội dung("mới");
    khẳng định bằng(dom nội dung(dom con(phần_tử_gốc.cây())[0]), "mới");
    phần_tử_gốc.phân tích("<a>42</a>");
    khẳng định bằng(phần_tử_gốc.tên(), "a");
    hành_động = hàm() { phần_tử_gốc.phân tích("<a>"); };
    khẳng định ném lỗi(hành_động);
    khẳng định bằng(phần_tử_gốc.nội dung(), "42");
    hành_động = hàm() { phần_tử_gốc.con(0); };
    khẳng định ném lỗi(hành_động);
    in "DOM OOP: đạt";
};
