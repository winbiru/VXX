nhập gói/lõi/hệ tệp zip;
nhập gói/lõi/lưu trữ;
nhập gói/lõi/tùy chọn bền vững;
nhập gói/lõi/quản lý gói;
nhập gói/nhập xuất/tệp;
nhập gói/nhập xuất/đường dẫn;
nhập gói/kiểm thử/chính;

hàm chính() {
    a = Kho Tùy Chọn("oop-tuy-chon-a");
    b = Kho Tùy Chọn("oop-tuy-chon-b");
    cùng = Kho Tùy Chọn("oop-tuy-chon-a");
    a.xóa tất cả();
    b.xóa tất cả();
    khẳng định đúng(a.lưu("tên", "V++"));
    khẳng định bằng(cùng.đọc("tên"), "V++");
    cùng.lưu("khác", "42");
    a.lưu("tên", "Việt");
    khẳng định bằng(cùng.đọc("khác"), "42");
    khẳng định bằng(b.đọc("tên", "thiếu"), "thiếu");
    khẳng định bằng(độ dài(a.các khóa()), 2);
    khẳng định đúng(a.xóa("tên"));
    khẳng định sai(a.xóa("tên"));
    a.xóa tất cả();
    b.xóa tất cả();
    in "preferences OOP: đạt";

    nguồn = "src/tests/.tmp_oop_zip.txt";
    zip = "src/tests/.tmp_oop_zip.zip";
    ghi tệp(nguồn, "OOP");
    lưu trữ tạo zip(zip, [nguồn]);
    kho = Hệ Tệp ZIP(zip);
    danh_mục = kho.liệt kê();
    khẳng định bằng(độ dài(danh_mục), 1);
    khẳng định đúng(kho.đóng());
    khẳng định sai(kho.đóng());
    hành_động = hàm() { kho.liệt kê(); };
    khẳng định ném lỗi(hành_động, "zipfs: kho đã đóng");
    xóa đường dẫn(nguồn);
    xóa đường dẫn(zip);
    in "ZIP OOP: đạt";

    bản kê = {"schema": 1, "name": "oop-project", "version": "1.0.0", "dependencies": []};
    dự_án = Dự Án Gói(bản kê);
    mục = dự_án.thêm("a", "^1.0.0", "path", "../a");
    đặt từ điển(mục, "version", "sai");
    khẳng định bằng(dự_án.phụ thuộc("a")["version"], "^1.0.0");
    khẳng định bằng(độ dài(bản kê["dependencies"]), 0);
    hành_động = hàm() { dự_án.thêm("b", "không hợp lệ", "path", "../b"); };
    khẳng định ném lỗi(hành_động);
    khẳng định bằng(độ dài(dự_án.bản kê()["dependencies"]), 1);
    khẳng định bằng(dự_án.phụ thuộc("b"), rỗng);
    snapshot = dự_án.bản kê();
    đặt từ điển(snapshot, "name", "khác");
    khẳng định bằng(dự_án.bản kê()["name"], "oop-project");
    khẳng định bằng(độ dài(dự_án.giải đồ thị({"a": {"version": "1.2.0", "dependencies": []}})), 1);
    đường_manifest = "src/tests/.tmp_oop_manifest.json";
    dự_án.lưu(đường_manifest);
    dự_án.xóa("a");
    khẳng định bằng(dự_án.phụ thuộc("a"), rỗng);
    dự_án.tải lại(đường_manifest);
    khẳng định bằng(dự_án.phụ thuộc("a")["version"], "^1.0.0");
    xóa đường dẫn(đường_manifest);
    in "package project OOP: đạt";
};
