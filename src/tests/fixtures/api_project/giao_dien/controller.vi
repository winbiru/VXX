// Các contract của tầng HTTP controller trong api_project.

giao diện UserCrudControllerContract {
    hàm getUsers(dbSession, token, requestId);
    hàm createUser(dbSession, token, requestBody, requestId);
    hàm updateUser(dbSession, token, userId, requestBody, requestId);
    hàm deleteUser(dbSession, token, userId, requestId);
    hàm searchUsers(dbSession, token, keyword, requestId);
};

giao diện HealthControllerContract {
    hàm health(requestId);
};

giao diện AuthControllerContract {
    hàm login(usernameBody, passwordBody, requestId);
};
