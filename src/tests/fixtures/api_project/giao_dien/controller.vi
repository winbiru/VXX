// Các contract của tầng HTTP controller trong api_project.

giao diện UserCrudControllerContract {
    hàm getUsers(dbSession, từ tố, requestId);
    hàm createUser(dbSession, từ tố, requestBody, requestId);
    hàm updateUser(dbSession, từ tố, userId, requestBody, requestId);
    hàm deleteUser(dbSession, từ tố, userId, requestId);
    hàm searchUsers(dbSession, từ tố, keyword, requestId);
};

giao diện HealthControllerContract {
    hàm health(requestId);
};

giao diện AuthControllerContract {
    hàm login(usernameBody, passwordBody, requestId);
};
