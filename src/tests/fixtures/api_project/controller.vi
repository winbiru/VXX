nhập mạng;
nhập gói/mạng/kiểm thử/api;
nhập src/tests/fixtures/api_project/service;
nhập src/tests/fixtures/api_project/giao_dien/controller;

// Ghi chú lớp: gom route chuẩn của API project theo kiểu cấu hình tập trung.
lớp công khai ApiProjectRoutes {
    hàm công khai health() {
        trả về "/actuator/health";
    };

    hàm công khai login() {
        trả về "/api/v1/auth/login";
    };

    hàm công khai adminUsers() {
        trả về "/api/v1/admin/users";
    };

    hàm công khai adminUsersSearch() {
        trả về "/api/v1/admin/users/search";
    };

    // Ghi chú hàm: route user theo id (áp dụng cho PUT/DELETE).
    hàm công khai adminUserById(userId) {
        trả về ApiProjectRoutes.adminUsers() + "/" + userId;
    };
};

// Ghi chú hàm: route health chuẩn API project.
hàm công khai api project path health() {
    trả về ApiProjectRoutes.health();
};

// Ghi chú hàm: route login chuẩn API project.
hàm công khai api project path login() {
    trả về ApiProjectRoutes.login();
};

// Ghi chú hàm: route users chuẩn API project.
hàm công khai api project path admin users() {
    trả về ApiProjectRoutes.adminUsers();
};

// Ghi chú hàm: route search users chuẩn API project.
hàm công khai api project path admin users search() {
    trả về ApiProjectRoutes.adminUsersSearch();
};

// Ghi chú hàm: JSON lỗi chuẩn có requestId.
hàm app json error(message, requestId) {
    trả về rest json lỗi(message, requestId);
};

// Ghi chú hàm: JSON thành công với value chuỗi.
hàm app json value(message, requestId, value) {
    dataJson = "{\"requestId\":\"" + requestId + "\",\"value\":\"" + value + "\"}";
    trả về rest json thành công object(message, dataJson);
};

// Ghi chú hàm: JSON tạo user thành công.
hàm app json created user(requestId) {
    trả về app json value("Tạo mới thành công", requestId, "created-user");
};

// Ghi chú hàm: JSON lỗi thiếu keyword.
hàm app json missing keyword(requestId) {
    trả về rest json lỗi("missing-keyword", requestId);
};

// Ghi chú hàm: JSON lỗi thiếu username.
hàm app json missing username(requestId) {
    trả về rest json lỗi("missing-username", requestId);
};

// Ghi chú hàm: JSON lỗi thiếu token.
hàm app json missing token(requestId) {
    trả về rest json lỗi("missing-token", requestId);
};

// Ghi chú hàm: JSON lỗi token không hợp lệ.
hàm app json invalid token(requestId) {
    trả về rest json lỗi("invalid-token", requestId);
};

// Ghi chú hàm: JSON lỗi user không tồn tại.
hàm app json user not found(requestId) {
    trả về rest json lỗi("user-not-found", requestId);
};

// Ghi chú hàm: JSON lỗi database chưa kết nối.
hàm app json db not connected(requestId) {
    trả về rest json lỗi("db-not-connected", requestId);
};

// Ghi chú hàm: JSON lỗi resource không tồn tại.
hàm app json not found(requestId) {
    trả về rest json lỗi("not-found", requestId);
};

// Ghi chú hàm: JSON xóa user thành công.
hàm app json deleted user(requestId) {
    trả về app json value("Xóa thành công", requestId, "deleted");
};

lớp công khai ResponseEntity {
    hàm công khai ok(body, requestId) {
        in app json value("Thành công", requestId, body);
        trả về 0;
    };

    hàm công khai created(body, requestId) {
        nếu (body == "created-user") {
            in app json created user(requestId);
            trả về 0;
        };
        in app json value("Tạo mới thành công", requestId, body);
        trả về 0;
    };

    hàm công khai badRequest(message, requestId) {
        nếu (message == "missing-keyword") {
            in app json missing keyword(requestId);
            trả về 0;
        };
        nếu (message == "missing-username") {
            in app json missing username(requestId);
            trả về 0;
        };
        in app json error(message, requestId);
        trả về 0;
    };

    hàm công khai unauthorized(message, requestId) {
        nếu (message == "missing-token") {
            in app json missing token(requestId);
            trả về 0;
        };
        in app json invalid token(requestId);
        trả về 0;
    };

    hàm công khai notFound(message, requestId) {
        nếu (message == "user-not-found") {
            in app json user not found(requestId);
            trả về 0;
        };
        in app json not found(requestId);
        trả về 0;
    };

    hàm công khai serverError(message, requestId) {
        nếu (message == "db-not-connected") {
            in app json db not connected(requestId);
            trả về 0;
        };
        in app json error(message, requestId);
        trả về 0;
    };

    hàm công khai noContent(requestId) {
        in app json deleted user(requestId);
        trả về 0;
    };
};

lớp công khai UserRestController triển khai UserCrudControllerContract {
    // Controller chỉ điều phối HTTP; service và response helper được inject từ ngoài.
    hàm khởi tạo(service, responseEntity) {
        mình.service = service;
        mình.responseEntity = responseEntity;
    };

    hàm riêng tư mapResult(result, requestId) {
        responseEntity = mình.responseEntity;
        nếu (result == "200|users=[an,binh,chi]") {
            trả về responseEntity.ok("users=[an,binh,chi]", requestId);
        };
        nếu (result == "DB_OK|users=[an]") {
            trả về responseEntity.ok("users=[an]", requestId);
        };
        nếu (result == "DB_OK|users=[binh]") {
            trả về responseEntity.ok("users=[binh]", requestId);
        };
        nếu (result == "DB_OK|users=[chi]") {
            trả về responseEntity.ok("users=[chi]", requestId);
        };
        nếu (result == "DB_OK|users=[an-nguyen]") {
            trả về responseEntity.ok("users=[an-nguyen]", requestId);
        };
        nếu (result == "DB_OK|users=[]") {
            trả về responseEntity.ok("users=[]", requestId);
        };
        nếu (result == "201|created-user") {
            trả về responseEntity.created("created-user", requestId);
        };
        nếu (result == "200|updated-user") {
            trả về responseEntity.ok("updated-user", requestId);
        };
        nếu (result == "204|deleted") {
            trả về responseEntity.noContent(requestId);
        };
        nếu (result == "400|missing-body") {
            trả về responseEntity.badRequest("missing-body", requestId);
        };
        nếu (result == "400|missing-user-id") {
            trả về responseEntity.badRequest("missing-user-id", requestId);
        };
        nếu (result == "400|missing-keyword") {
            trả về responseEntity.badRequest("missing-keyword", requestId);
        };
        nếu (result == "401|missing-token") {
            trả về responseEntity.unauthorized("missing-token", requestId);
        };
        nếu (result == "401|invalid-token") {
            trả về responseEntity.unauthorized("invalid-token", requestId);
        };
        nếu (result == "404|user-not-found") {
            trả về responseEntity.notFound("user-not-found", requestId);
        };
        nếu (result == "500|db-not-connected") {
            trả về responseEntity.serverError("db-not-connected", requestId);
        };
        trả về responseEntity.serverError("unknown-error", requestId);
    };

    hàm công khai getUsers(dbSession, token, requestId) {
        req = api get(ApiProjectRoutes.adminUsers());
        nếu (req == "ERR|missing-url") {
            responseEntity = mình.responseEntity;
            trả về responseEntity.badRequest("invalid-url", requestId);
        };
        service = mình.service;
        serviceRes = service.getUsers(dbSession, token);
        trả về mình.mapResult(serviceRes, requestId);
    };

    hàm công khai createUser(dbSession, token, requestBody, requestId) {
        req = api post json(ApiProjectRoutes.adminUsers(), requestBody);
        nếu (req == "ERR|missing-url") {
            responseEntity = mình.responseEntity;
            trả về responseEntity.badRequest("invalid-url", requestId);
        };
        service = mình.service;
        serviceRes = service.createUser(dbSession, token, requestBody);
        trả về mình.mapResult(serviceRes, requestId);
    };

    hàm công khai updateUser(dbSession, token, userId, requestBody, requestId) {
        req = api put json(ApiProjectRoutes.adminUserById(userId), requestBody);
        nếu (req == "ERR|missing-url") {
            responseEntity = mình.responseEntity;
            trả về responseEntity.badRequest("invalid-url", requestId);
        };
        service = mình.service;
        serviceRes = service.updateUser(dbSession, token, userId, requestBody);
        trả về mình.mapResult(serviceRes, requestId);
    };

    hàm công khai deleteUser(dbSession, token, userId, requestId) {
        req = api delete(ApiProjectRoutes.adminUserById(userId));
        nếu (req == "ERR|missing-url") {
            responseEntity = mình.responseEntity;
            trả về responseEntity.badRequest("invalid-url", requestId);
        };
        service = mình.service;
        serviceRes = service.deleteUser(dbSession, token, userId);
        trả về mình.mapResult(serviceRes, requestId);
    };

    hàm công khai searchUsers(dbSession, token, keyword, requestId) {
        req = api get có query(ApiProjectRoutes.adminUsersSearch(), "keyword=" + keyword);
        nếu (req == "ERR|missing-url") {
            responseEntity = mình.responseEntity;
            trả về responseEntity.badRequest("invalid-url", requestId);
        };
        service = mình.service;
        serviceRes = service.searchUsers(dbSession, token, keyword);
        trả về mình.mapResult(serviceRes, requestId);
    };
};

// Ghi chú lớp: controller tách riêng endpoint health.
lớp công khai HealthRestController triển khai HealthControllerContract {
    hàm khởi tạo(responseEntity) {
        mình.responseEntity = responseEntity;
    };

    hàm công khai health(requestId) {
        responseEntity = mình.responseEntity;
        trả về responseEntity.ok("UP", requestId);
    };
};

// Ghi chú lớp: controller tách riêng endpoint auth.
lớp công khai AuthRestController triển khai AuthControllerContract {
    hàm khởi tạo(responseEntity) {
        mình.responseEntity = responseEntity;
    };

    hàm công khai login(usernameBody, passwordBody, requestId) {
        responseEntity = mình.responseEntity;
        thiếu = sai;
        nếu (usernameBody == "") {
            thiếu = đúng;
        };
        nếu (passwordBody == "") {
            thiếu = đúng;
        };
        nếu (thiếu) {
            trả về responseEntity.badRequest("missing-credentials", requestId);
        };
        trả về responseEntity.ok("login-success", requestId);
    };
};

// Admin controller kế thừa toàn bộ CRUD từ UserRestController và chỉ nối constructor
// sang lớp cha; runtime phải dispatch các method được kế thừa trên instance thật.
lớp công khai AdminRestController kế thừa UserRestController {
    hàm khởi tạo(service, responseEntity) {
        gốc.khởi tạo(service, responseEntity);
    };
};
