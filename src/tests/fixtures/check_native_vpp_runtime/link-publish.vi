hàm chính() {
    nếu (đối_số_đếm() != 4) { trả về 1; };
    biến output = đối_số_lấy(1);
    biến output2 = đối_số_lấy(2);
    biến sentinel = đối_số_lấy(3);
    biến temporary = byte_mới();
    biến second = byte_mới();
    biến malformed = "no-X-suffix";
    nếu (rt_link_temp_open(malformed) != -1) { trả về 2; };
    nếu (rt_link_temp_open(-1) != -1) { trả về 3; };
    biến empty = byte_mới();
    byte_hủy(empty);
    nếu (rt_link_temp_open(empty) != -1) { trả về 4; };
    nếu (rt_link_publish(empty, sentinel) != -1) { trả về 5; };
    nếu (rt_link_publish(sentinel, sentinel) != -1) { trả về 6; };
    biến missing = "no-such-rename-input";
    nếu (rt_link_publish(missing, sentinel) != -1) { trả về 7; };
    nếu (rt_link_temporary_path(output, temporary, -1) != 0) { trả về 8; };
    biến fd = rt_link_temp_open(temporary);
    nếu (fd < 0) { trả về 9; };
    nếu (rt_link_temp_open(temporary) != -1) { trả về 10; };
    nếu (rt_link_temporary_path(output, second, -1) != 0) { trả về 11; };
    biến fd2 = rt_link_temp_open(second);
    nếu (fd2 < 0) { trả về 12; };
    nếu (byte_bằng(temporary, second) != 0) { trả về 13; };
    biến content1 = "V++ temp one";
    biến content2 = "V++ temp two";
    nếu (rt_write_all(fd, rt_payload(rt_bytes_slot(content1)), byte_dài(content1)) != byte_dài(content1)) { trả về 14; };
    nếu (rt_write_all(fd2, rt_payload(rt_bytes_slot(content2)), byte_dài(content2)) != byte_dài(content2)) { trả về 15; };
    nếu (máy_đóng(fd) != 0) { trả về 16; };
    nếu (máy_đóng(fd2) != 0) { trả về 17; };
    nếu (rt_link_publish(temporary, output) != 0) { trả về 18; };
    nếu (rt_link_publish(temporary, output) != -1) { trả về 19; };
    nếu (rt_link_publish(second, output2) != 0) { trả về 20; };
    trả về 52;
};
