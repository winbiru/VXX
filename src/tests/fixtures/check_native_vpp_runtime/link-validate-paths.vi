hàm chính() {
    biến output = "-Tiếng Việt";
    biến source = "mã nguồn.vi";
    nếu (rt_link_validate_paths(output, source) != 0) { trả về 1; };
    nếu (rt_link_validate_paths(-1, source) != -1) { trả về 2; };
    nếu (rt_link_validate_paths(output, -1) != -1) { trả về 3; };
    biến empty = byte_mới();
    nếu (rt_link_validate_paths(empty, source) != -1) { trả về 4; };
    nếu (rt_link_validate_paths(output, empty) != -1) { trả về 5; };
    biến nul = byte_mới();
    byte_thêm(nul, 97);
    byte_thêm(nul, 0);
    byte_thêm(nul, 98);
    nếu (rt_link_validate_paths(nul, source) != -1) { trả về 6; };
    nếu (rt_link_validate_paths(output, nul) != -1) { trả về 7; };
    biến long_output = byte_mới();
    lặp (i = 0; i < 4048; i++) { byte_thêm(long_output, 97); };
    nếu (rt_link_validate_paths(long_output, source) != 0) { trả về 8; };
    byte_thêm(long_output, 97);
    nếu (rt_link_validate_paths(long_output, source) != -1) { trả về 9; };
    biến long_source = byte_mới();
    lặp (i = 0; i < 4096; i++) { byte_thêm(long_source, 98); };
    nếu (rt_link_validate_paths(output, long_source) != 0) { trả về 10; };
    byte_thêm(long_source, 98);
    nếu (rt_link_validate_paths(output, long_source) != -1) { trả về 11; };
    biến stale = byte_mới();
    byte_hủy(stale);
    nếu (rt_link_validate_paths(stale, source) != -1) { trả về 12; };
    nếu (rt_link_validate_paths(output, source) != 0) { trả về 13; };
    trả về 52;
};
