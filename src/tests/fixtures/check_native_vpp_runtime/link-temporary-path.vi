hàm chính() {
    biến output = "-Tiếng Việt";
    biến target = byte_mới();
    biến expected = "./-Tiếng Việt.vpp-module-0-XXXXXX";
    nếu (rt_link_temporary_path(output, target, 0) != 0) { trả về 1; };
    nếu (byte_bằng(target, expected) != 1) { trả về 2; };
    byte_hủy(expected);
    expected = "./-Tiếng Việt.vpp-module-1234-XXXXXX";
    nếu (rt_link_temporary_path(output, target, 1234) != 0) { trả về 3; };
    nếu (byte_bằng(target, expected) != 1) { trả về 4; };
    byte_hủy(expected);
    expected = "./-Tiếng Việt.vpp-exe-XXXXXX";
    nếu (rt_link_temporary_path(output, target, -1) != 0) { trả về 5; };
    nếu (byte_bằng(target, expected) != 1) { trả về 6; };
    nếu (rt_link_temporary_path(output, output, 0) != -1) { trả về 7; };
    nếu (rt_link_temporary_path(output, target, -2) != -1) { trả về 8; };
    nếu (byte_bằng(target, expected) != 1) { trả về 9; };
    biến empty = byte_mới();
    nếu (rt_link_temporary_path(empty, target, 1) != -1) { trả về 10; };
    byte_thêm(empty, 0);
    nếu (rt_link_temporary_path(empty, target, 1) != -1) { trả về 11; };
    nếu (byte_bằng(target, expected) != 1) { trả về 12; };
    biến long_path = byte_mới();
    lặp (i = 0; i < 4049; i++) { byte_thêm(long_path, 97); };
    nếu (rt_link_temporary_path(long_path, target, 1) != -1) { trả về 13; };
    nếu (byte_bằng(target, expected) != 1) { trả về 14; };
    biến ordinary = "program";
    biến ordinary_expected = "program.vpp-module-10-XXXXXX";
    nếu (rt_link_temporary_path(ordinary, target, 10) != 0) { trả về 15; };
    nếu (byte_bằng(target, ordinary_expected) != 1) { trả về 16; };
    trả về 52;
};
