hàm chính() {
    biến output = "-Tiếng Việt";
    biến target = byte mới();
    biến expected = "./-Tiếng Việt.vpp-module-0-XXXXXX";
    nếu (thực thi liên kết tạm thời đường tệp(output, target, 0) != 0) { trả về 1; };
    nếu (byte bằng(target, expected) != 1) { trả về 2; };
    byte hủy(expected);
    expected = "./-Tiếng Việt.vpp-module-1234-XXXXXX";
    nếu (thực thi liên kết tạm thời đường tệp(output, target, 1234) != 0) { trả về 3; };
    nếu (byte bằng(target, expected) != 1) { trả về 4; };
    byte hủy(expected);
    expected = "./-Tiếng Việt.vpp-exe-XXXXXX";
    nếu (thực thi liên kết tạm thời đường tệp(output, target, -1) != 0) { trả về 5; };
    nếu (byte bằng(target, expected) != 1) { trả về 6; };
    nếu (thực thi liên kết tạm thời đường tệp(output, output, 0) != -1) { trả về 7; };
    nếu (thực thi liên kết tạm thời đường tệp(output, target, -2) != -1) { trả về 8; };
    nếu (byte bằng(target, expected) != 1) { trả về 9; };
    biến empty = byte mới();
    nếu (thực thi liên kết tạm thời đường tệp(empty, target, 1) != -1) { trả về 10; };
    byte thêm(empty, 0);
    nếu (thực thi liên kết tạm thời đường tệp(empty, target, 1) != -1) { trả về 11; };
    nếu (byte bằng(target, expected) != 1) { trả về 12; };
    biến long_path = byte mới();
    lặp (i = 0; i < 4049; i++) { byte thêm(long_path, 97); };
    nếu (thực thi liên kết tạm thời đường tệp(long_path, target, 1) != -1) { trả về 13; };
    nếu (byte bằng(target, expected) != 1) { trả về 14; };
    biến ordinary = "program";
    biến ordinary_expected = "program.vpp-module-10-XXXXXX";
    nếu (thực thi liên kết tạm thời đường tệp(ordinary, target, 10) != 0) { trả về 15; };
    nếu (byte bằng(target, ordinary_expected) != 1) { trả về 16; };
    trả về 52;
};
