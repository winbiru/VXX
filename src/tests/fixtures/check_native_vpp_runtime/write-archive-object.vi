hàm chính() {
    nếu (đối số đếm() != 3) { trả về 70; };
    biến input = đối số lấy(1);
    biến output = đối số lấy(2);
    biến archive = byte mới();
    biến file = tệp mở đọc(input);
    nếu (file <= 0) { trả về 71; };
    biến total = tệp đọc khối(file, archive);
    nếu (tệp đóng(file) != 0) { trả về 72; };
    nếu (total <= 4) { trả về 73; };
    biến fd = máy mở(thực thi nội dung đệm(thực thi các byte ô nhớ(output)), 1537);
    nếu (fd < 0) { trả về 74; };
    nếu (thực thi liên kết ghi đối tượng(-1, archive, 0) != -1) { trả về 75; };
    nếu (thực thi liên kết ghi đối tượng(fd, archive, total) != -1) { trả về 76; };
    biến written = thực thi liên kết ghi đối tượng(fd, archive, 0);
    nếu (máy đóng(fd) != 0) { trả về 77; };
    nếu (written != total - 4) { trả về 78; };
    trả về 52;
};
