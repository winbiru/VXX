hàm chính() {
    nếu (đối_số_đếm() != 3) { trả về 70; };
    biến input = đối_số_lấy(1);
    biến output = đối_số_lấy(2);
    biến archive = byte_mới();
    biến file = tệp_mở_đọc(input);
    nếu (file <= 0) { trả về 71; };
    biến total = tệp_đọc_khối(file, archive);
    nếu (tệp_đóng(file) != 0) { trả về 72; };
    nếu (total <= 4) { trả về 73; };
    biến fd = máy_mở(rt_payload(rt_bytes_slot(output)), 1537);
    nếu (fd < 0) { trả về 74; };
    nếu (rt_link_write_object(-1, archive, 0) != -1) { trả về 75; };
    nếu (rt_link_write_object(fd, archive, total) != -1) { trả về 76; };
    biến written = rt_link_write_object(fd, archive, 0);
    nếu (máy_đóng(fd) != 0) { trả về 77; };
    nếu (written != total - 4) { trả về 78; };
    trả về 52;
};
