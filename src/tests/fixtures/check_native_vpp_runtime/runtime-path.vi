hàm chính() {
    biến path = môi trường thực thi nguồn();
    nếu (path <= 0) { trả về 1; };
    biến file = tệp mở đọc(path);
    nếu (file <= 0) { byte hủy(path); trả về 2; };
    biến first = tệp đọc byte(file);
    biến closed = tệp đóng(file);
    byte hủy(path);
    nếu (first < 0) { trả về 3; };
    nếu (closed != 0) { trả về 3; };
    nếu (thực thi môi trường thực thi tệp dữ liệu đường tệp(-1) != -1) { trả về 4; };
    nếu (thực thi môi trường thực thi tệp dữ liệu đường tệp(3) != -1) { trả về 5; };
    biến assembly = thực thi môi trường thực thi tệp dữ liệu đường tệp(1);
    nếu (assembly <= 0) { trả về 6; };
    biến assembly_name = "vpp_aot_primitives_aarch64.S";
    nếu (byte tìm(assembly, assembly_name) < 0) { trả về 7; };
    byte hủy(assembly_name);
    file = tệp mở đọc(assembly);
    nếu (file <= 0) { trả về 8; };
    first = tệp đọc byte(file);
    closed = tệp đóng(file);
    byte hủy(assembly);
    nếu (first < 0) { trả về 9; };
    nếu (closed != 0) { trả về 10; };
    nếu (thực thi môi trường thực thi tệp dữ liệu đường tệp(2) != -1) { trả về 11; };
    trả về 52;
};
