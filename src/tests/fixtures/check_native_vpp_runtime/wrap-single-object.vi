hàm chính() {
    nếu (đối_số_đếm() != 3) { trả về 70; };
    biến source = đối_số_lấy(1);
    biến destination = đối_số_lấy(2);
    biến object = byte_mới();
    biến fd = tệp_mở_đọc(source);
    nếu (fd <= 0) { trả về 71; };
    biến length = tệp_đọc_khối(fd, object);
    nếu (tệp_đóng(fd) != 0) { trả về 72; };
    nếu (length < 232) { trả về 73; };
    nếu (rt_link_archive_single(-1) != -1) { trả về 1; };
    biến empty = byte_mới();
    nếu (rt_link_archive_single(empty) != -1) { trả về 2; };
    biến short_object = byte_cắt(object, 0, 231);
    nếu (rt_link_archive_single(short_object) != -1) { trả về 3; };
    byte_hủy(short_object);
    biến stale = byte_mới();
    byte_hủy(stale);
    nếu (rt_link_archive_single(stale) != -1) { trả về 4; };
    biến archive = rt_link_archive_single(object);
    nếu (archive <= 0) { trả về 5; };
    nếu (byte_dài(archive) != length + 4) { trả về 6; };
    nếu (rt_object_archive_entry(archive, 0) != length) { trả về 7; };
    biến body = byte_cắt(archive, 4, length);
    nếu (byte_bằng(body, object) != 1) { trả về 8; };
    byte_hủy(body);
    biến summary = rt_object_archive_summary(archive);
    nếu (summary != 2) {
        nếu (summary != 3) { trả về 9; };
    };
    biến bad = byte_cắt(object, 0, length);
    rt_bytes_store_i32(bad, 0, 0);
    biến bad_archive = rt_link_archive_single(bad);
    nếu (bad_archive <= 0) { trả về 10; };
    nếu (rt_object_archive_summary(bad_archive) != -1) { trả về 11; };
    byte_hủy(bad_archive);
    byte_hủy(bad);
    fd = tệp_mở_ghi(destination);
    nếu (fd <= 0) { trả về 12; };
    nếu (tệp_ghi_khối(fd, archive) != length + 4) { trả về 13; };
    nếu (tệp_đóng(fd) != 0) { trả về 14; };
    byte_hủy(archive);
    byte_hủy(object);
    trả về 50 + summary;
};
