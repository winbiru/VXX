hàm chính() {
            biến các byte = byte mới();
            byte thêm(các byte, 0); byte thêm(các byte, 255); byte thêm(các byte, 52);
            biến part = byte cắt(các byte, 1, 2);
            nếu (byte tìm(các byte, part) != 1) { trả về 1; };
            nếu (byte cắt(các byte, 3, 1) != -1) { trả về 2; };
            nếu (byte in(-1) != -1) { trả về 7; };
            biến path = "native-các byte.bin";
            biến file = tệp mở ghi(path);
            nếu (tệp ghi khối(file, các byte) != 3) { trả về 3; };
            nếu (tệp đóng(file) != 0) { trả về 4; };
            biến loaded = byte mới(); file = tệp mở đọc(path);
            nếu (tệp đọc khối(file, loaded) != 3) { trả về 5; };
            nếu (byte bằng(các byte, loaded) != 1) { trả về 6; };
            tệp đóng(file); byte hủy(các byte); byte hủy(loaded); byte hủy(path);
            biến result = byte lấy(part, 1); byte hủy(part);
            trả về result;
        };
