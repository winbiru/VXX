hàm chính() {
            biến bytes = byte_mới();
            byte_thêm(bytes, 0); byte_thêm(bytes, 255); byte_thêm(bytes, 52);
            biến part = byte_cắt(bytes, 1, 2);
            nếu (byte_tìm(bytes, part) != 1) { trả về 1; };
            nếu (byte_cắt(bytes, 3, 1) != -1) { trả về 2; };
            nếu (byte_in(-1) != -1) { trả về 7; };
            biến path = "native-bytes.bin";
            biến file = tệp_mở_ghi(path);
            nếu (tệp_ghi_khối(file, bytes) != 3) { trả về 3; };
            nếu (tệp_đóng(file) != 0) { trả về 4; };
            biến loaded = byte_mới(); file = tệp_mở_đọc(path);
            nếu (tệp_đọc_khối(file, loaded) != 3) { trả về 5; };
            nếu (byte_bằng(bytes, loaded) != 1) { trả về 6; };
            tệp_đóng(file); byte_hủy(bytes); byte_hủy(loaded); byte_hủy(path);
            biến result = byte_lấy(part, 1); byte_hủy(part);
            trả về result;
        };
