hàm chính() {
            biến key = "runtime-test-key"; biến data = byte mới();
            byte thêm(data, 0); byte thêm(data, 255); byte thêm(data, 52);
            nếu (bộ nhớ đệm ghi(key, data) != 0) { trả về 1; };
            biến loaded = byte mới(); byte thêm(loaded, 99);
            nếu (bộ nhớ đệm đọc(key, loaded) != 1) { trả về 2; };
            nếu (byte bằng(data, loaded) != 1) { trả về 3; };
            nếu (bộ nhớ đệm đọc(key, key) != -1) { trả về 4; };
            biến missing = "missing-cache-key";
            nếu (bộ nhớ đệm đọc(missing, loaded) != 0) { trả về 5; };
            nếu (byte dài(loaded) != 0) { trả về 6; };
            byte hủy(key);
            nếu (bộ nhớ đệm đọc(key, loaded) != -1) { trả về 7; };
            byte hủy(data); byte hủy(loaded); byte hủy(missing);
            trả về 52;
        };
