// Kiểm thử parser biểu thức self-host: không gọi compilerAnalyzePrimitive.
nhập gói.biên dịch.biểu thức.*;
nhập gói.bộ sưu tập.từ điển.*;

hàm chính() {
    cây = biên dịch phân tích biểu thức("1 + 2 * 3");
    in lấy từ điển(cây, "loại", "") == "hai ngôi";
    in lấy từ điển(cây, "toán tử", "") == "+";
    in lấy từ điển(lấy từ điển(cây, "trái", {}), "giá trị", "") == "1";
    nhánh_nhân = lấy từ điển(cây, "phải", {});
    in lấy từ điển(nhánh_nhân, "toán tử", "") == "*";
    in lấy từ điển(lấy từ điển(nhánh_nhân, "phải", {}), "giá trị", "") == "3";

    ngoặc = biên dịch phân tích biểu thức("(1 + 2) * 3");
    in lấy từ điển(ngoặc, "toán tử", "") == "*";
    in lấy từ điển(lấy từ điển(ngoặc, "trái", {}), "toán tử", "") == "+";

    gán = biên dịch phân tích biểu thức("a = b = c");
    in lấy từ điển(gán, "toán tử", "") == "=";
    in lấy từ điển(lấy từ điển(gán, "trái", {}), "giá trị", "") == "a";
    in lấy từ điển(lấy từ điển(gán, "phải", {}), "toán tử", "") == "=";
    in lấy từ điển(lấy từ điển(lấy từ điển(gán, "phải", {}), "phải", {}), "giá trị", "") == "c";

    phép = biên dịch phân tích biểu thức("a || b && c == d");
    in lấy từ điển(phép, "toán tử", "") == "||";
    in lấy từ điển(lấy từ điển(phép, "phải", {}), "toán tử", "") == "&&";
    in lấy từ điển(lấy từ điển(lấy từ điển(phép, "phải", {}), "phải", {}), "toán tử", "") == "==";

    dấu = biên dịch phân tích biểu thức("-a * !b");
    in lấy từ điển(dấu, "toán tử", "") == "*";
    in lấy từ điển(lấy từ điển(dấu, "trái", {}), "toán tử", "") == "-";
    in lấy từ điển(lấy từ điển(dấu, "phải", {}), "toán tử", "") == "!";

    kết_quả_gọi = biên dịch phân tích biểu thức("cộng(1, nhân(2, 3))");
    in lấy từ điển(kết_quả_gọi, "loại", "") == "gọi";
    in lấy từ điển(lấy từ điển(kết_quả_gọi, "hàm", {}), "giá trị", "") == "cộng";
    in độ dài(lấy từ điển(kết_quả_gọi, "đối số", [])) == 2;
    đối_số_gọi = lấy từ điển(kết_quả_gọi, "đối số", []);
    in lấy từ điển(đối_số_gọi[1], "loại", "") == "gọi";

    gọi_rỗng = biên dịch phân tích biểu thức("f()");
    in độ dài(lấy từ điển(gọi_rỗng, "đối số", [1])) == 0;
    mảng = biên dịch phân tích biểu thức("mảng[1 + 2] * 4");
    in lấy từ điển(lấy từ điển(mảng, "trái", {}), "loại", "") == "chỉ số";
    in lấy từ điển(lấy từ điển(lấy từ điển(mảng, "trái", {}), "chỉ số", {}), "toán tử", "") == "+";

    tiếng_việt = biên dịch phân tích biểu thức("đếm + 1");
    in lấy từ điển(lấy từ điển(tiếng_việt, "trái", {}), "giá trị", "") == "đếm";
    in lấy từ điển(lấy từ điển(tiếng_việt, "trái", {}), "vị trí", -1) == 0;
    chuỗi = biên dịch phân tích biểu thức("\"Việt Nam\"");
    in lấy từ điển(chuỗi, "kiểu", "") == "chuỗi";
    in lấy từ điển(chuỗi, "giá trị", "") == "\"Việt Nam\"";

    lỗi = sai;
    thử { biên dịch phân tích biểu thức("1 +"); } bắt lỗi (e) { lỗi = đúng; };
    in lỗi;
    lỗi = sai;
    thử { biên dịch phân tích biểu thức("(1 + 2"); } bắt lỗi (e) { lỗi = đúng; };
    in lỗi;
    lỗi = sai;
    thử { biên dịch phân tích biểu thức("a b"); } bắt lỗi (e) { lỗi = đúng; };
    in lỗi;
    lỗi = sai;
    thử { biên dịch phân tích biểu thức("f(1,)"); } bắt lỗi (e) { lỗi = đúng; };
    in lỗi;
    lỗi = sai;
    thử { biên dịch phân tích biểu thức("a[1 + ]"); } bắt lỗi (e) { lỗi = đúng; };
    in lỗi;
    lỗi = sai;
    thử { biên dịch phân tích biểu thức("hàm x"); } bắt lỗi (e) { lỗi = đúng; };
    in lỗi;
    lỗi = sai;
    thử { biên dịch phân tích biểu thức(""); } bắt lỗi (e) { lỗi = đúng; };
    in lỗi;
};
