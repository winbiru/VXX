nhập gói/chuẩn/main.vi;

hàm main() {
    in nối chuỗi("xin", " chao");
    in nối ba("a", "b", "c");

    in là chuỗi rỗng("");
    in là chuỗi rỗng("x");

    in tất cả(đúng, đúng);
    in tất cả(đúng, sai);
    in một trong hai(đúng, sai);

    ghi thông tin("ok");
    ghi cảnh báo("warn");
    ghi lỗi("err");

    in ghi thông tin("Tiếng Việt 𠀀") == 0;
    in ghi cảnh báo(42) == 0;
    in ghi lỗi(đúng) == 0;
};
