nhập cây tài liệu xml;
nhập bộ sưu tập;

hàm chính() {
    root = cây tài liệu phần tử("gốc");
    cây tài liệu đặt thuộc tính(root, "id", "1");
    child = cây tài liệu phần tử("con");
    cây tài liệu đặt nội dung(child, "V++ & Việt");
    cây tài liệu thêm con(root, child);
    in cây tài liệu tên(root);
    in cây tài liệu thuộc tính(root, "id", "");
    in độ dài(cây tài liệu con(root));
    in xml tạo(root);
};
