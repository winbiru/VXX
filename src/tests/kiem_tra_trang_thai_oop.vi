nhập gói.lõi.ngẫu nhiên.*;
nhập gói.lõi.thực thi tương tác.*;
nhập gói.lõi.đồng thời.*;
nhập gói.lõi.quốc tế hóa.*;
nhập gói.kiểm thử.chính.*;

hàm chính() {
    a = Bộ Sinh Ngẫu Nhiên(12345);
    b = tạo bộ sinh ngẫu nhiên(12345);
    khẳng định bằng(a.nguyên(-100, 100), ngẫu nhiên i64(b, -100, 100));
    khẳng định bằng(a.thực(), ngẫu nhiên f64(b));
    khẳng định bằng(a.luận lý(), ngẫu nhiên luận lý(b));
    snapshot = a.trạng thái();
    tiếp = a.nguyên(0, 100000);
    khẳng định bằng(a.khôi phục(snapshot), a);
    khẳng định bằng(a.nguyên(0, 100000), tiếp);
    snapshot = a.trạng thái();
    hành_động_1 = hàm() { a.khôi phục({"thuật toán": "sai"}); };
    khẳng định ném lỗi(hành_động_1, "RANDOM_STATE");
    khẳng định bằng(a.trạng thái()["trạng thái"], snapshot["trạng thái"]);
    các byte = a.các byte(5);
    khẳng định bằng(độ dài(các byte), 5);
    khẳng định đúng(a.đóng());
    khẳng định sai(a.đóng());
    hành_động_2 = hàm() { a.thực(); };
    khẳng định ném lỗi(hành_động_2);
    hành_động_3 = hàm() { a.khôi phục(snapshot); };
    khẳng định ném lỗi(hành_động_3);
    in "PRNG OOP: đạt";

    phiên = Phiên Tương Tác();
    khác = Phiên Tương Tác();
    khẳng định bằng(phiên.chạy("x = 4;"), "");
    khẳng định bằng(phiên.chạy("in x + 1;"), "5\n");
    nguồn_cũ = phiên.nguồn();
    hành_động_4 = hàm() { phiên.chạy("in ;"); };
    khẳng định ném lỗi(hành_động_4);
    khẳng định bằng(phiên.nguồn(), nguồn_cũ);
    khẳng định bằng(khác.nguồn(), "");
    khẳng định bằng(phiên.đặt lại().nguồn(), "");
    khẳng định đúng(phiên.đóng());
    khẳng định sai(phiên.đóng());
    hành_động_5 = hàm() { phiên.chạy("in 1;"); };
    khẳng định ném lỗi(hành_động_5);
    in "REPL OOP: đạt";

    công_việc = hàm(x) { trả về x + 1; };
    worker = Luồng Công Việc(công_việc, [41]);
    khẳng định bằng(worker.chờ(), 42);
    khẳng định bằng(worker.trạng thái(), "hoàn tất");
    khẳng định bằng(worker.chờ(), 42);
    khẳng định đúng(worker.đóng());
    khẳng định sai(worker.đóng());
    hành_động_6 = hàm() { worker.chờ(); };
    khẳng định ném lỗi(hành_động_6, "luồng công việc: đã đóng");
    công_việc_lỗi = hàm() { ném "worker lỗi"; };
    lỗi_worker = Luồng Công Việc(công_việc_lỗi);
    hành_động_7 = hàm() { lỗi_worker.chờ(); };
    khẳng định ném lỗi(hành_động_7, "worker lỗi");
    khẳng định đúng(lỗi_worker.đóng());
    công_việc_chậm = hàm() { luồng máy ảo nghỉ(60000); trả về 1; };
    chậm = Luồng Công Việc(công_việc_chậm);
    khẳng định bằng(chậm.chờ(0), rỗng);
    khẳng định đúng(chậm.hủy());
    khẳng định đúng(chậm.đóng());
    khẳng định sai(chậm.đóng());
    in "worker OOP: đạt";

    nguồn = {"vi": {"chào": "xin chào"}, "": {"chào": "hello"}};
    bundle = Gói Tài Nguyên("messages", "vi-VN", nguồn);
    khẳng định bằng(bundle.vùng đã chọn(), "vi");
    khẳng định bằng(bundle.lấy("chào"), "xin chào");
    hành_động_8 = hàm() { bundle.chọn vùng("en--US"); };
    khẳng định ném lỗi(hành_động_8, "LOCALE_INVALID");
    khẳng định bằng(bundle.lấy("chào"), "xin chào");
    khẳng định bằng(bundle.chọn vùng("en-US").lấy("chào"), "hello");
    in "resource bundle OOP: đạt";
};
