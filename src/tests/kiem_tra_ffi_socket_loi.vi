nhập gói/mạng/ổ cắm;

// Các đường lỗi này không bind/kết nối localhost: chạy được cả khi sandbox
// cấm tạo socket. Chúng xác nhận policy V++ và kiểm tra từ tố tại FFI.
hàm chính() {
    lỗi = sai;
    thử { đầu nối giao vận tin cậy mở("", 80); } bắt lỗi(e) { lỗi = đúng; };
    in lỗi;

    lỗi = sai;
    thử { đầu nối giao vận tin cậy mở("127.0.0.1", 0); } bắt lỗi(e) { lỗi = đúng; };
    in lỗi;

    lỗi = sai;
    thử { đầu nối giao vận gói tin mở("", 9); } bắt lỗi(e) { lỗi = đúng; };
    in lỗi;

    lỗi = sai;
    thử { đầu nối giao vận tin cậy lắng nghe(0, 64); } bắt lỗi(e) { lỗi = đúng; };
    in lỗi;

    // Token thuộc miền FFI nhưng chưa được cấp phát trong VM này.
    mã_giả = 536870912;
    lỗi = sai;
    thử { đầu nối giao vận tin cậy lắng nghe(8080, 0); } bắt lỗi(e) { lỗi = đúng; };
    in lỗi;

    lỗi = sai;
    thử { đầu nối chấp nhận(mã_giả); } bắt lỗi(e) { lỗi = đúng; };
    in lỗi;

    lỗi = sai;
    thử { đầu nối gửi(mã_giả, "x"); } bắt lỗi(e) { lỗi = đúng; };
    in lỗi;

    lỗi = sai;
    thử { đầu nối nhận(mã_giả, 1); } bắt lỗi(e) { lỗi = đúng; };
    in lỗi;

    lỗi = sai;
    thử { đầu nối đặt thời gian chờ(mã_giả, 1000); } bắt lỗi(e) { lỗi = đúng; };
    in lỗi;

    lỗi = sai;
    thử { đầu nối đóng(mã_giả); } bắt lỗi(e) { lỗi = đúng; };
    in lỗi;
};
