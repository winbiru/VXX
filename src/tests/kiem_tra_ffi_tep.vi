nhập nhập xuất;

hàm chính() {
    đường = ".tmp_ffi_file_chunk.bin";
    các byte = [];
    lặp(i = 0; i < 8201; i++) { thêm(các byte, i % 256); };
    in ghi các byte tệp(đường, các byte) == 1;
    nhận = đọc các byte tệp(đường);
    in độ dài(nhận) == 8201;
    in nhận[0] == 0 && nhận[255] == 255 && nhận[4096] == 0 && nhận[8200] == 8;

    nội_dung = "cà phê" + chuỗi từ byte máy ảo([0, 255, 10]);
    in ghi tệp(đường, nội_dung) == 1;
    in đọc tệp(đường) == nội_dung;
    in ghi nối tệp(đường, "-đuôi") == 1;
    in đọc tệp(đường) == nội_dung + "-đuôi";
    in ghi các byte tệp(đường, []) == 1;
    in độ dài(đọc các byte tệp(đường)) == 0;
    in ghi nối tệp(đường, "A") == 1;
    in đọc tệp(đường) == "A";
    in xóa đường dẫn(đường) == 1;

    // Windows must open the UTF-8 public path through the Win32 wide adapter.
    đường_unicode = ".tmp_ffi_tệp_cà_phê.bin";
    in ghi các byte tệp(đường_unicode, [0, 10, 127, 255]) == 1;
    bytes_unicode = đọc các byte tệp(đường_unicode);
    in độ dài(bytes_unicode) == 4 && bytes_unicode[0] == 0 &&
        bytes_unicode[1] == 10 && bytes_unicode[2] == 127 && bytes_unicode[3] == 255;
    in xóa đường dẫn(đường_unicode) == 1;

    thử { đọc tệp(".tmp_ffi_file_does_not_exist"); }
    bắt lỗi(e) { in "chặn tệp thiếu"; };
    thử { ghi tệp(".tmp_ffi_file_bad" + chuỗi từ byte máy ảo([0]), "X"); }
    bắt lỗi(e) { in "chặn NUL"; };
    thử { ghi các byte tệp(".tmp_ffi_file_invalid", [256]); }
    bắt lỗi(e) { in "chặn byte sai"; };
};
