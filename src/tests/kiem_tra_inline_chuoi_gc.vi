// Ép GC chạy giữa các phép nối chuỗi, giữ chuỗi ngắn và bảng UTF-8 còn sống.
nhập gói.chuẩn.chính.*;

hàm chính() {
    giữ = [];
    lặp(n = 0; n <= 33; n++) {
        văn bản = "";
        lặp(i = 0; i < n; i++) { văn bản = văn bản + "x"; };
        thêm(giữ, văn bản);
    };
    có nul = chuỗi từ byte máy ảo([65, 0, 66]);
    unicode = "a𠮷Việt🌿";
    thêm(giữ, có nul);
    thêm(giữ, unicode);

    // Chạm ngưỡng GC nhiều lần; các chuỗi trong danh sách vẫn phải nguyên vẹn.
    lặp(i = 0; i < 30000; i++) {
        rác = "số:" + thành chuỗi(i);
        nếu (i % 100 == 0) { tạm = [rác, i]; };
    };

    hợp lệ = đúng;
    lặp(n = 0; n <= 33; n++) {
        các byte = chuỗi thành byte máy ảo(giữ[n]);
        nếu (máy ảo lấy độ dài(các byte) != n) { hợp lệ = sai; };
        lặp(i = 0; i < máy ảo lấy độ dài(các byte); i++) {
            nếu (các byte[i] != 120) { hợp lệ = sai; };
        };
    };
    các byte nul = chuỗi thành byte máy ảo(giữ[34]);
    nếu (máy ảo lấy độ dài(các byte nul) != 3 || các byte nul[0] != 65 ||
        các byte nul[1] != 0 || các byte nul[2] != 66) { hợp lệ = sai; };
    nếu (giữ[35] != "a𠮷Việt🌿") { hợp lệ = sai; };
    in hợp lệ;
};
