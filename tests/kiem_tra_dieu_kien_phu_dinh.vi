lặp(x = 1; x <= 3; x = x + 1) {
    lặp(y = 1; y <= 3; y = y + 1) {
        lặp(z = 1; z <= 3; z = z + 1) {
            nếu((x + y + z) % 2 != 0) {
                nếu((x * y * z) % 3 == 0) {
                    nếu(x != y && y != z && x != z) {
                        nếu(!(x == 2 || z == 2)) {
                            in "Tọa độ hợp lệ: (" + x + ", " + y + ", " + z + ")";
                        }
                    }
                }
            }
        }
    }
};
