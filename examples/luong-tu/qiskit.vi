nhập lượng tử;
nhập gói / lượng tử / qiskit;
nhập gói / hệ thống / môi trường;
hàm chính() {
    trình chạy = đọc biến môi trường("VPP_QUANTUM_RUNNER", "");
    cầu nối = đọc biến môi trường("VPP_QUANTUM_BRIDGE", "");
    sdk = Cầu Nối Qiskit();
    nếu (trình chạy != "" || cầu nối != "") {
        sdk = Cầu Nối Qiskit(trình chạy, cầu nối);
    };
    mạch = Mạch Lượng Tử(2);
    mạch.h(0) .cx(0, 1) .đo tất cả();
    kết quả = sdk.mô phỏng(mạch, 1024, 42);
    in kết quả["đếm"];
}
;
