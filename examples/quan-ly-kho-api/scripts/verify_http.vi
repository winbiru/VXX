nhập gói.chuẩn.chính.*;

hàm yêuCầu(điềuKiện, nhãn) {
    nếu (!điềuKiện) {
        ném "verify-http thất bại: " + nhãn;
    };
    trả về đúng;
};

hàm nốiUrlKiểmThử(gốc, đườngDẫn) {
    trả về gốc + đườngDẫn;
};

hàm lấyJson(gốc, đườngDẫn) {
    trả về json phân tích(mạng lấy(nốiUrlKiểmThử(gốc, đườngDẫn)));
};

hàm gửiJson(gốc, đườngDẫn, dữLiệu) {
    trả về json phân tích(mạng gửi(nốiUrlKiểmThử(gốc, đườngDẫn), json tạo(dữLiệu)));
};

hàm cậpNhậtJson(gốc, đườngDẫn, dữLiệu) {
    trả về json phân tích(mạng cập nhật(nốiUrlKiểmThử(gốc, đườngDẫn), json tạo(dữLiệu)));
};

hàm chờMáyChủ(gốc) {
    lặp(i = 0; i < 50; i++) {
        thử {
            health = lấyJson(gốc, "/health");
            nếu (lấy từ điển(health, "trangThai", "") == "UP") {
                trả về đúng;
            };
        } bắt lỗi (e) {
        };
        ngủ mili giây(100);
    };
    ném "verify-http thất bại: máy chủ không sẵn sàng";
};

hàm chính() {
    cổng = đọc biến môi trường("VPP_WAREHOUSE_PORT", "18932");
    gốc = "http://127.0.0.1:" + cổng;
    chờMáyChủ(gốc);

    features = lấy từ điển(lấyJson(gốc, "/features"), "duLieu", {});
    yêuCầu(lấy từ điển(features, "http_server_routing", sai), "feature gate");

    sảnPhẩm = lấy từ điển(
        gửiJson(gốc, "/san-pham", {
            "id": "SP-VERIFY",
            "ten": "Cà phê \"Đậm\" ☕",
            "gia": 180000,
            "tonKho": 10
        }),
        "duLieu",
        {}
    );
    yêuCầu(lấy từ điển(sảnPhẩm, "id", "") == "SP-VERIFY", "tạo sản phẩm");
    yêuCầu(lấy từ điển(sảnPhẩm, "ten", "") == "Cà phê \"Đậm\" ☕", "Unicode JSON");

    chiTiết = lấy từ điển(
        gửiJson(gốc, "/san-pham/chi-tiet", {"id": "SP-VERIFY"}),
        "duLieu",
        {}
    );
    yêuCầu(lấy từ điển(chiTiết, "ten", "") == "Cà phê \"Đậm\" ☕", "đọc chi tiết");

    tìmKiếm = lấy từ điển(
        gửiJson(gốc, "/san-pham/tim-kiem", {
            "tuKhoa": "Đậm",
            "trang": 1,
            "kichThuoc": 10
        }),
        "duLieu",
        {}
    );
    yêuCầu(lấy từ điển(tìmKiếm, "tong", 0) >= 1, "tìm kiếm");

    cậpNhật = lấy từ điển(
        cậpNhậtJson(gốc, "/san-pham", {
            "id": "SP-VERIFY",
            "ten": "Cà phê kiểm thử",
            "gia": 190000,
            "tonKho": 12
        }),
        "duLieu",
        {}
    );
    yêuCầu(lấy từ điển(cậpNhật, "gia", 0) == 190000, "cập nhật sản phẩm");
    yêuCầu(lấy từ điển(cậpNhật, "tonKho", 0) == 12, "cập nhật tồn kho");

    đơn = lấy từ điển(
        gửiJson(gốc, "/don-hang", {
            "khachHang": "Kiểm thử V++",
            "sanPham": [
                {"maSanPham": "SP-VERIFY", "soLuong": 2}
            ]
        }),
        "duLieu",
        {}
    );
    mãĐơn = lấy từ điển(đơn, "id", "");
    yêuCầu(mãĐơn != "", "tạo đơn hàng");
    yêuCầu(lấy từ điển(đơn, "tongTien", 0) == 380000, "tính tổng tiền");

    đãHủy = lấy từ điển(
        gửiJson(gốc, "/don-hang/huy", {"id": mãĐơn}),
        "duLieu",
        {}
    );
    yêuCầu(lấy từ điển(đãHủy, "trangThai", "") == "DA_HUY", "hủy đơn hàng");

    báoCáo = lấy từ điển(lấyJson(gốc, "/bao-cao"), "duLieu", {});
    yêuCầu(lấy từ điển(báoCáo, "soDonHang", 0) >= 1, "báo cáo");

    in "PASS: V++ .vi HTTP release verification";
};
