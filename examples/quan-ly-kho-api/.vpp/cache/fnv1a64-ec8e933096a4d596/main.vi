// Package phụ thuộc dùng bởi ví dụ quản lý kho.
// Cố ý tách thành package độc lập để project chính đi qua package resolver/lockfile thật.

hàm công khai tạo mã đơn(tiềnTố, sốThứTự) {
    nếu (tiềnTố == "") {
        ném "ma-don-hang: tiền tố không được rỗng";
    };
    nếu (sốThứTự < 1) {
        ném "ma-don-hang: số thứ tự phải lớn hơn 0";
    };
    trả về tiềnTố + "-" + sốThứTự;
};

hàm công khai tạo mã sản phẩm(sốThứTự) {
    trả về tạo mã đơn("SP", sốThứTự);
};

hàm công khai tạo mã hóa đơn(sốThứTự) {
    trả về tạo mã đơn("DH", sốThứTự);
};
