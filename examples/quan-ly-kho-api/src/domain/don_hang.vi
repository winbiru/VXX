nhập hằng.trường dữ liệu.*;
nhập hằng.đơn hàng.*;
nhập lõi;

lớp công khai DòngĐơnHàng {
    hàm khởi tạo(mãSảnPhẩm, tênSảnPhẩm, đơnGiá, sốLượng) {
        mình.mãSảnPhẩm = mãSảnPhẩm;
        mình.tênSảnPhẩm = tênSảnPhẩm;
        mình.đơnGiá = đơnGiá;
        mình.sốLượng = sốLượng;
    }

    hàm kiểmTraHợpLệ() {
        nếu (mình.mãSảnPhẩm == "") {
            ném "Dòng đơn hàng: mã sản phẩm không được rỗng";
        };
        nếu (mình.sốLượng <= 0) {
            ném "Dòng đơn hàng: số lượng phải lớn hơn 0";
        };
        nếu (mình.đơnGiá < 0) {
            ném "Dòng đơn hàng: đơn giá không được âm";
        };
        trả về đúng;
    }

    hàm thànhTiền() {
        trả về mình.đơnGiá * mình.sốLượng;
    }

    hàm thànhMap() {
        trả về {
            KHÓA_MÃ_SẢN_PHẨM: mình.mãSảnPhẩm,
            KHÓA_TÊN_SẢN_PHẨM: mình.tênSảnPhẩm,
            KHÓA_ĐƠN_GIÁ: mình.đơnGiá,
            KHÓA_SỐ_LƯỢNG: mình.sốLượng,
            "thanhTien": mình.thànhTiền()
        };
    }
};

hàm công khai dòng đơn hàng từ map(dữLiệu) {
    dòng = DòngĐơnHàng(
        lấy từ điển(dữLiệu, KHÓA_MÃ_SẢN_PHẨM, ""),
        lấy từ điển(dữLiệu, KHÓA_TÊN_SẢN_PHẨM, ""),
        lấy từ điển(dữLiệu, KHÓA_ĐƠN_GIÁ, 0),
        lấy từ điển(dữLiệu, KHÓA_SỐ_LƯỢNG, 0)
    );
    dòng.kiểmTraHợpLệ();
    trả về dòng;
};

lớp công khai ĐơnHàng {
    hàm khởi tạo(id, kháchHàng, cácDòng, trạngThái = ĐƠN_MỚI) {
        mình.id = id;
        mình.kháchHàng = kháchHàng;
        mình.cácDòng = cácDòng;
        mình.trạngThái = trạngThái;
    }

    hàm kiểmTraHợpLệ() {
        nếu (mình.id == "") {
            ném "Đơn hàng: id không được rỗng";
        };
        nếu (mình.kháchHàng == "") {
            ném "Đơn hàng: khách hàng không được rỗng";
        };
        nếu (độ dài(mình.cácDòng) == 0) {
            ném "Đơn hàng: phải có ít nhất một sản phẩm";
        };
        trả về đúng;
    }

    hàm tổngTiền() {
        tổng = 0;
        cácDòng = mình.cácDòng;
        lặp(i = 0; i < độ dài(cácDòng); i = i + 1) {
            dòng = cácDòng[i];
            tổng = tổng + dòng.thànhTiền();
        };
        trả về tổng;
    }

    hàm hủy() {
        nếu (mình.trạngThái == ĐƠN_ĐÃ_HỦY) {
            ném "Đơn hàng " + mình.id + ": đã hủy trước đó";
        };
        mình.trạngThái = ĐƠN_ĐÃ_HỦY;
        trả về mình.trạngThái;
    }

    hàm xácNhận() {
        nếu (mình.trạngThái != ĐƠN_MỚI) {
            ném "Đơn hàng " + mình.id + ": trạng thái không cho phép xác nhận";
        };
        mình.trạngThái = ĐƠN_ĐÃ_XÁC_NHẬN;
        trả về mình.trạngThái;
    }

    hàm thànhMap() {
        cácDòngMap = [];
        cácDòng = mình.cácDòng;
        lặp(i = 0; i < độ dài(cácDòng); i = i + 1) {
            dòng = cácDòng[i];
            thêm(cácDòngMap, dòng.thànhMap());
        };
        trả về {
            KHÓA_ID: mình.id,
            KHÓA_KHÁCH_HÀNG: mình.kháchHàng,
            KHÓA_TRẠNG_THÁI: mình.trạngThái,
            "tongTien": mình.tổngTiền(),
            "cacDong": cácDòngMap
        };
    }
};

hàm công khai đơn hàng từ map(dữLiệu) {
    cácDòngMap = lấy từ điển(dữLiệu, "cacDong", []);
    cácDòng = [];
    lặp(i = 0; i < độ dài(cácDòngMap); i = i + 1) {
        thêm(cácDòng, dòng đơn hàng từ map(cácDòngMap[i]));
    };
    đơn = ĐơnHàng(
        lấy từ điển(dữLiệu, KHÓA_ID, ""),
        lấy từ điển(dữLiệu, KHÓA_KHÁCH_HÀNG, ""),
        cácDòng,
        lấy từ điển(dữLiệu, KHÓA_TRẠNG_THÁI, ĐƠN_MỚI)
    );
    đơn.kiểmTraHợpLệ();
    trả về đơn;
};
