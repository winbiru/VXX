nhập hằng.cấu hình.*;
nhập gói.chuẩn.chính.*;
nhập diagnostics.language_features.*;
nhập app.bootstrap.*;

hàm chính() {
    chạy kiểm tra tính năng();

    ứngDụng = tạo ngữ cảnh ứng dụng(TỆP_DEMO_SẢN_PHẨM, TỆP_DEMO_ĐƠN_HÀNG);
    yêuCầu(lấy từ điển(ứngDụng, "dichVuKho", rỗng) != rỗng, "warehouse service graph");
    yêuCầu(lấy từ điển(ứngDụng, "router", rỗng) != rỗng, "warehouse router graph");

    in json tạo(báo cáo tính năng());
};
