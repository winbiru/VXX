// Các interface repository tách domain/service khỏi cách lưu trữ.

giao diện công khai KhoSảnPhẩm {
    hàm tấtCả();
    hàm tìmTheoId(id);
    hàm lưu(sảnPhẩm);
    hàm tạoMới(sảnPhẩm);
};

giao diện công khai KhoĐơnHàng {
    hàm tấtCả();
    hàm tìmTheoId(id);
    hàm lưu(đơnHàng);
    hàm tạoMới(đơnHàng);
    hàm sốLượng();
};
