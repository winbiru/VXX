nhập lõi;
nhập "ma-don-hang";
nhập "../domain/san_pham.vi";

lớp công khai DịchVụKho {
    // Warehouse Showcase 1.0 service surface.
    hàm khởi tạo(khoSảnPhẩm) {
        mình.khoSảnPhẩm = khoSảnPhẩm;
    }

    hàm tấtCả() {
        kho = mình.khoSảnPhẩm;
        danhSách = kho.tấtCả();
        kếtQuả = [];
        lặp(i = 0; i < độ dài(danhSách); i = i + 1) {
            sảnPhẩm = danhSách[i];
            thêm(kếtQuả, sảnPhẩm.thànhMap());
        };
        trả về kếtQuả;
    }

    hàm tìmTheoId(id) {
        kho = mình.khoSảnPhẩm;
        sảnPhẩm = kho.tìmTheoId(id);
        nếu (sảnPhẩm == rỗng) {
            ném "Dịch vụ kho: không tìm thấy sản phẩm " + id;
        };
        trả về sảnPhẩm;
    }

    hàm chiTiết(id) {
        sảnPhẩm = mình.tìmTheoId(id);
        trả về sảnPhẩm.thànhMap();
    }

    hàm tạo(id, tên, giá, tồnKho) {
        kho = mình.khoSảnPhẩm;
        mã = id;
        nếu (mã == "") {
            mã = tạo mã sản phẩm(độ dài(kho.tấtCả()) + 1);
        };
        sảnPhẩm = SảnPhẩm(mã, tên, giá, tồnKho, 0, 1);
        sảnPhẩm.kiểmTraHợpLệ();
        kho.tạoMới(sảnPhẩm);
        trả về sảnPhẩm;
    }

    hàm nhậpKho(id, sốLượng) {
        sảnPhẩm = mình.tìmTheoId(id);
        sảnPhẩm.nhậpKho(sốLượng);
        kho = mình.khoSảnPhẩm;
        kho.lưu(sảnPhẩm);
        trả về sảnPhẩm;
    }

    hàm cậpNhật(id, tên, giá, tồnKho) {
        sảnPhẩm = mình.tìmTheoId(id);
        nếu (tên != "") {
            sảnPhẩm.tên = tên;
        };
        nếu (giá >= 0) {
            sảnPhẩm.giá = giá;
        };
        nếu (tồnKho >= 0) {
            sảnPhẩm.tồnKho = tồnKho;
        };
        sảnPhẩm.phiênBản = sảnPhẩm.phiênBản + 1;
        sảnPhẩm.kiểmTraHợpLệ();
        kho = mình.khoSảnPhẩm;
        kho.lưu(sảnPhẩm);
        trả về sảnPhẩm;
    }

    hàm loạiBỏ(id) {
        sảnPhẩm = mình.tìmTheoId(id);
        kho = mình.khoSảnPhẩm;
        kho.loạiBỏ(id);
        trả về sảnPhẩm;
    }

    hàm tìmKiếm(từKhóa, trang, kíchThước) {
        nếu (trang < 1) {
            trang = 1;
        };
        nếu (kíchThước < 1) {
            kíchThước = 10;
        };
        nếu (kíchThước > 100) {
            kíchThước = 100;
        };

        kho = mình.khoSảnPhẩm;
        danhSách = kho.tấtCả();
        đãLọc = [];
        từKhóaChuẩn = chuỗi thường(từKhóa);
        lặp(i = 0; i < độ dài(danhSách); i = i + 1) {
            sảnPhẩm = danhSách[i];
            tênChuẩn = chuỗi thường(sảnPhẩm.tên);
            idChuẩn = chuỗi thường(sảnPhẩm.id);
            nếu (từKhóaChuẩn == "" || chứa chuỗi(tênChuẩn, từKhóaChuẩn) || chứa chuỗi(idChuẩn, từKhóaChuẩn)) {
                thêm(đãLọc, sảnPhẩm.thànhMap());
            };
        };

        bắtĐầu = (trang - 1) * kíchThước;
        kếtThúc = bắtĐầu + kíchThước;
        nếu (kếtThúc > độ dài(đãLọc)) {
            kếtThúc = độ dài(đãLọc);
        };
        kếtQuả = [];
        nếu (bắtĐầu < độ dài(đãLọc)) {
            lặp(i = bắtĐầu; i < kếtThúc; i = i + 1) {
                thêm(kếtQuả, đãLọc[i]);
            };
        };

        trả về {
            "duLieu": kếtQuả,
            "tong": độ dài(đãLọc),
            "trang": trang,
            "kichThuoc": kíchThước
        };
    }

    hàm thốngKê() {
        kho = mình.khoSảnPhẩm;
        danhSách = kho.tấtCả();
        tổngMặtHàng = độ dài(danhSách);
        tổngSốLượng = 0;
        tổngGiáTrị = 0;
        tổngĐãBán = 0;
        sắpHết = [];

        lặp(i = 0; i < độ dài(danhSách); i = i + 1) {
            sảnPhẩm = danhSách[i];
            tổngSốLượng = tổngSốLượng + sảnPhẩm.tồnKho;
            tổngGiáTrị = tổngGiáTrị + sảnPhẩm.giáTrịTồnKho();
            tổngĐãBán = tổngĐãBán + sảnPhẩm.đãBán;
            nếu (sảnPhẩm.tồnKho <= 5) {
                thêm(sắpHết, sảnPhẩm.thànhMap());
            };
        };

        trả về {
            "tongMatHang": tổngMặtHàng,
            "tongSoLuongTon": tổngSốLượng,
            "tongGiaTriTon": tổngGiáTrị,
            "tongDaBan": tổngĐãBán,
            "sapHetHang": sắpHết
        };
    }
};

hàm công khai tạo dịch vụ kho(khoSảnPhẩm) {
    trả về DịchVụKho(khoSảnPhẩm);
};
