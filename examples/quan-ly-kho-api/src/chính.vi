nhập hằng.cấu hình.*;
nhập lõi;
nhập hệ thống;
nhập app.bootstrap.*;
nhập diagnostics.language_features.*;
nhập http.server.*;

hàm chính() {
    chạy kiểm tra tính năng();
    ứngDụng = tạo ứng dụng("data");
    router = lấy từ điển(ứngDụng, "router", rỗng);
    nếu (router == rỗng) {
        ném "Không khởi tạo được router";
    };
    cổng = thành số nguyên(đọc biến môi trường(BIẾN_CỔNG_KHO, CỔNG_KHO_MẶC_ĐỊNH));
    máyChủ = tạo máy chủ kho(cổng, router);
    máyChủ.chạy();
};
