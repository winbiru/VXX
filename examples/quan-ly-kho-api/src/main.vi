nhập lõi;
nhập "app/bootstrap.vi";
nhập "diagnostics/language_features.vi";
nhập "http/server.vi";

hàm main() {
    chạy kiểm tra tính năng();
    ứngDụng = tạo ứng dụng("data");
    router = lấy map(ứngDụng, "router", rỗng);
    nếu (router == rỗng) {
        ném "Không khởi tạo được router";
    };
    máyChủ = tạo máy chủ kho(8088, router);
    máyChủ.chạy();
};
