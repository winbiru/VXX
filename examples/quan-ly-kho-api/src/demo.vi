nhập hằng.trường dữ liệu.*;
nhập hằng.cấu hình.*;
nhập lõi;
nhập mạng;
nhập nhập xuất;
nhập app.bootstrap.*;
nhập diagnostics.language_features.*;

hàm ghi dữ liệu demo() {
    nếu (!đường dẫn tồn tại("data")) {
        tạo thư mục("data");
    };

    sảnPhẩm = [
        {KHÓA_ID: "SP-1", KHÓA_TÊN: "Ca phe hat", KHÓA_GIÁ: 180000, KHÓA_TỒN_KHO: 10, KHÓA_ĐÃ_BÁN: 0, KHÓA_PHIÊN_BẢN: 1},
        {KHÓA_ID: "SP-2", KHÓA_TÊN: "Tra o long", KHÓA_GIÁ: 120000, KHÓA_TỒN_KHO: 8, KHÓA_ĐÃ_BÁN: 0, KHÓA_PHIÊN_BẢN: 1},
        {KHÓA_ID: "SP-3", KHÓA_TÊN: "Banh quy bo", KHÓA_GIÁ: 65000, KHÓA_TỒN_KHO: 20, KHÓA_ĐÃ_BÁN: 0, KHÓA_PHIÊN_BẢN: 1}
    ];

    ghi tệp(TỆP_DEMO_SẢN_PHẨM, json tạo(sảnPhẩm));
    ghi tệp(TỆP_DEMO_ĐƠN_HÀNG, "[]");
};

hàm chính() {
    in "=== KIEM TRA TINH NANG NGON NGU ===";
    in json tạo(báo cáo tính năng());

    ghi dữ liệu demo();
    ứngDụng = tạo ngữ cảnh ứng dụng(TỆP_DEMO_SẢN_PHẨM, TỆP_DEMO_ĐƠN_HÀNG);
    dịchVụKho = lấy từ điển(ứngDụng, "dichVuKho", rỗng);
    dịchVụĐơnHàng = lấy từ điển(ứngDụng, "dichVuDonHang", rỗng);
    dịchVụBáoCáo = lấy từ điển(ứngDụng, "dichVuBaoCao", rỗng);

    in "=== DANH SACH SAN PHAM BAN DAU ===";
    in json tạo(dịchVụKho.tấtCả());

    in "=== NHAP KHO SP-2 ===";
    sp = dịchVụKho.nhậpKho("SP-2", 5);
    in json tạo(sp.thànhMap());

    in "=== TAO DON HANG ===";
    mục = [
        {KHÓA_MÃ_SẢN_PHẨM: "SP-1", KHÓA_SỐ_LƯỢNG: 2},
        {KHÓA_MÃ_SẢN_PHẨM: "SP-2", KHÓA_SỐ_LƯỢNG: 3},
        {KHÓA_MÃ_SẢN_PHẨM: "SP-1", KHÓA_SỐ_LƯỢNG: 1}
    ];
    đơn = dịchVụĐơnHàng.đặtHàng("Cong ty Minh Anh", mục);
    in json tạo(đơn.thànhMap());

    in "=== THU DAT QUA TON KHO, BAT EXCEPTION NGHIEP VU ===";
    thử {
        dịchVụĐơnHàng.đặtHàng("Khach loi", [
            {KHÓA_MÃ_SẢN_PHẨM: "SP-3", KHÓA_SỐ_LƯỢNG: 9999}
        ]);
        in "LOI: nhanh nay khong duoc chay";
    } bắt lỗi (e) {
        in "Da bat loi: " + e;
    }

    in "=== BAO CAO SAU KHI BAN ===";
    in json tạo(dịchVụBáoCáo.tổngQuan());

    in "=== HUY DON VA HOAN KHO ===";
    đãHủy = dịchVụĐơnHàng.hủy(đơn.id);
    in json tạo(đãHủy.thànhMap());

    in "=== BAO CAO CUOI ===";
    in json tạo(dịchVụBáoCáo.tổngQuan());

    in "=== FILE JSON DA GHI ===";
    in đọc tệp(TỆP_DEMO_SẢN_PHẨM);
    in đọc tệp(TỆP_DEMO_ĐƠN_HÀNG);
};
