nhập config;
nhập controller;
nhập router;
nhập server;

// Đại diện cho ứng dụng API đã được ghép đủ dependency. Lớp chỉ sở hữu vòng đời
// ứng dụng và khởi động server đã được truyền vào qua constructor.
lớp ApiApplication {
    // Nhận server hoàn chỉnh từ composition root để lớp không tự tạo dependency.
    hàm khởi tạo(server) {
        mình.server = server;
    }

    // Khởi động vòng lặp HTTP của server thuộc ứng dụng hiện tại.
    hàm chạy() {
        server = mình.server;
        server.chạy();
    }
};

// Composition root: tạo object graph một lần, nối dependency từ ngoài vào trong
// rồi trao server hoàn chỉnh cho ApiApplication quản lý vòng đời.
hàm main() {
    config = tạo cấu hình api("application.properties");
    healthController = tạo health controller();
    notFoundController = tạo not found controller();
    router = tạo bộ định tuyến(healthController, notFoundController);
    port = config.cổng();
    server = tạo máy chủ api(port, router);
    application = ApiApplication(server);
    application.chạy();
};
