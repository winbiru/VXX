{
  "scopeName": "source.vietvm",
  "name": "V++",
  "patterns": [
    {
      "begin": "/\\*",
      "end": "\\*/",
      "name": "comment.block.vietvm"
    },
    {
      "match": "//.*$",
      "name": "comment.line.vietvm"
    },
    {
      "match": "(hàm)\\s+((?:công[ \\t]+khai|riêng[ \\t]+tư|bảo[ \\t]+vệ)[ \\t]+)?([\\p{L}_][\\p{L}\\p{N}_.]*)",
      "name": "meta.function.definition.vietvm",
      "captures": {
        "1": {
          "name": "storage.type.function.vietvm"
        },
        "2": {
          "name": "storage.modifier.access.vietvm"
        },
        "3": {
          "name": "entity.name.function.vietvm"
        }
      }
    },
    {
      "match": "(lớp)\\s+((?:công[ \\t]+khai|riêng[ \\t]+tư|bảo[ \\t]+vệ)[ \\t]+)?([\\p{L}_][\\p{L}\\p{N}_]*)",
      "name": "meta.class.definition.vietvm",
      "captures": {
        "1": {
          "name": "storage.type.class.vietvm"
        },
        "2": {
          "name": "storage.modifier.access.vietvm"
        },
        "3": {
          "name": "entity.name.type.class.vietvm"
        }
      }
    },
    {
      "match": "(?<![\\p{L}\\p{N}_])(công[ \\t]+khai|riêng[ \\t]+tư|bảo[ \\t]+vệ)(?![\\p{L}\\p{N}_])",
      "name": "storage.modifier.access.vietvm"
    },
    {
      "match": "(?<![\\p{L}\\p{N}_])(công\\s+khai|riêng\\s+tư|bảo\\s+vệ)(?![\\p{L}\\p{N}_])",
      "name": "storage.modifier.access.vietvm"
    },
    {
      "match": "(gọi)\\s+([\\p{L}_][\\p{L}\\p{N}_]*)",
      "name": "meta.function.call.vietvm",
      "captures": {
        "1": {
          "name": "keyword.control.call.vietvm"
        },
        "2": {
          "name": "entity.name.function.vietvm"
        }
      }
    },
    {
      "match": "(?<![\\p{L}\\p{N}_])(nếu không|trả về|mặc định|bỏ qua|bắt lỗi|khởi tạo|điều kiện|cập nhật|kiểm tra sau|trường hợp|lớp|hàm|nếu|hoặc|lặp|chọn|ca|thoát|nhập|thử|ném|chuyển|gọi|dừng)(?![\\p{L}\\p{N}_])",
      "name": "keyword.control.vietvm"
    },
    {
      "match": "(?<![\\p{L}\\p{N}_])(đúng|sai)(?![\\p{L}\\p{N}_])",
      "name": "constant.language.boolean.vietvm"
    },
    {
      "match": "(?<![\\p{L}\\p{N}_])(biến)(?![\\p{L}\\p{N}_])",
      "name": "storage.type.variable.vietvm"
    },
    {
      "match": "(?<![\\p{L}\\p{N}_])(in)(?![\\p{L}\\p{N}_])",
      "name": "support.function.builtin.vietvm"
    },
    {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.vietvm"
    },
    {
      "begin": "'",
      "end": "'",
      "name": "string.quoted.single.vietvm"
    },
    {
      "match": "(?<![\\p{L}\\p{N}_])([0-9]+\\.[0-9]+|[0-9]+)(?![\\p{L}\\p{N}_])",
      "name": "constant.numeric.vietvm"
    },
    {
      "match": "(\\+\\+|--|\\+=|-=|\\*=|/=|%=|==|!=|<=|>=|&&|\\|\\||[+\\-*/%=!<>])",
      "name": "keyword.operator.vietvm"
    },
    {
      "match": "[{}()\\[\\];,:]",
      "name": "punctuation.separator.vietvm"
    },
    {
      "match": "(?<![\\p{L}\\p{N}_])[\\p{L}_][\\p{L}\\p{N}_]*(?![\\p{L}\\p{N}_])",
      "name": "variable.vietvm"
    }
  ]
}
