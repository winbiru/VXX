cmake_minimum_required(VERSION 3.19)
foreach(required IN ITEMS VPP_ROOT VPP_EXEC VPP_BENCH_BUILD)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Missing ${required}")
    endif()
endforeach()
file(MAKE_DIRECTORY "${VPP_BENCH_BUILD}")
set(ENV{VPP_HOME} "${VPP_ROOT}")
set(source "${VPP_ROOT}/benchmark/languages")
function(run)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE status
        OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 600)
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "Benchmark build failed: ${ARGV}\n${status}\n${output}\n${errors}")
    endif()
endfunction()
function(quote value output)
    string(REPLACE "\\" "\\\\" value "${value}")
    string(REPLACE "\"" "\\\"" value "${value}")
    string(REPLACE "\n" "\\n" value "${value}")
    string(REPLACE "\r" "\\r" value "${value}")
    string(REPLACE "\t" "\\t" value "${value}")
    set(${output} "\"${value}\"" PARENT_SCOPE)
endfunction()
set(runtimes "[]")
function(runtime name executable arguments cases)
    set(item "{}")
    quote("${name}" q)
    string(JSON item SET "${item}" name "${q}")
    quote("${executable}" q)
    string(JSON item SET "${item}" executable "${q}")
    string(JSON item SET "${item}" arguments "${arguments}")
    string(JSON item SET "${item}" cases "${cases}")
    file(SHA256 "${executable}" binary_hash)
    quote("${binary_hash}" q)
    string(JSON item SET "${item}" binary_sha256 "${q}")
    string(JSON index LENGTH "${runtimes}")
    string(JSON runtimes SET "${runtimes}" ${index} "${item}")
    set(runtimes "${runtimes}" PARENT_SCOPE)
endfunction()
set(all_cases "[\"arithmetic\",\"branch_loop\",\"fibonacci\",\"list_128\",\"unicode_replace\",\"json_parse\"]")
set(five_cases "[\"arithmetic\",\"branch_loop\",\"fibonacci\",\"list_128\",\"unicode_replace\"]")
set(numeric_cases "[\"arithmetic\",\"branch_loop\",\"fibonacci\"]")
find_program(CXX NAMES clang++ REQUIRED)
find_program(NODE NAMES node)
find_program(JAVA NAMES java)
find_program(JAVAC NAMES javac)
find_program(PYTHON NAMES python3)
find_program(RUBY NAMES ruby)
set(native "${VPP_BENCH_BUILD}/native-compiler/vpp-native")
run("${CMAKE_COMMAND}" "-DVPP_CLI=${VPP_EXEC}" "-DVPP_ROOT=${VPP_ROOT}"
    "-DVPP_OUTPUT_DIR=${VPP_BENCH_BUILD}/native-compiler" "-DVPP_EXECUTABLE_SUFFIX="
    -P "${VPP_ROOT}/scripts/quality/prepare_native_compiler.cmake")
set(app "${VPP_BENCH_BUILD}/vpp-application")
run("${native}" build "${source}/workloads.vi" -o "${app}")
quote("${source}/workloads.vi" q)
runtime(vpp-vm "${VPP_EXEC}" "[\"run\",\"--compiler=cpp\",${q}]" "${all_cases}")
runtime(vpp-aot "${app}" "[]" "${all_cases}")
if(DEFINED VPP_I32_COMPILER AND EXISTS "${VPP_I32_COMPILER}")
    set(vm "${VPP_BENCH_BUILD}/vpp-vm")
    set(image "${VPP_BENCH_BUILD}/workloads.vmb")
    run("${VPP_I32_COMPILER}" build "${VPP_ROOT}/gói/máy ảo/chính.vi" -o "${vm}")
    run("${native}" vm-build "${source}/workloads.vi" -o "${image}")
    quote("${image}" q)
    runtime(vpp-vm-asm "${vm}" "[${q}]" "${all_cases}")
endif()
execute_process(COMMAND uname -m OUTPUT_VARIABLE cpu OUTPUT_STRIP_TRAILING_WHITESPACE)
set(triple x86_64-linux-gnu)
if(cpu MATCHES "^(arm64|aarch64)$")
    set(triple aarch64-linux-gnu)
endif()
if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Darwin")
    set(triple x86_64-apple-darwin)
    if(cpu MATCHES "^(arm64|aarch64)$")
        set(triple aarch64-apple-darwin)
    endif()
endif()
set(objects "")
foreach(kernel IN ITEMS arithmetic branch_loop fibonacci)
    set(object "${VPP_BENCH_BUILD}/${kernel}.o")
    run("${native}" build --target "${triple}" --emit-obj-selfhost "vpp_${kernel}"
        "${source}/kernels.vi" "${object}")
    list(APPEND objects "${object}")
endforeach()
run("${CXX}" -std=c++17 -O3 -DNDEBUG -DVPP_I32_KERNELS
    "${source}/driver.cpp" ${objects} -o "${VPP_BENCH_BUILD}/vpp-i32")
runtime(vpp-i32 "${VPP_BENCH_BUILD}/vpp-i32" "[]" "${numeric_cases}")
# Separate translation units and no LTO prevent folding kernels into the timer.
run("${CXX}" -std=c++17 -O3 -DNDEBUG -c "${source}/driver.cpp" -o "${VPP_BENCH_BUILD}/driver.o")
run("${CXX}" -std=c++17 -O3 -DNDEBUG -c "${source}/workloads.cpp" -o "${VPP_BENCH_BUILD}/workloads.o")
run("${CXX}" "${VPP_BENCH_BUILD}/driver.o" "${VPP_BENCH_BUILD}/workloads.o" -o "${VPP_BENCH_BUILD}/cpp")
runtime(cpp "${VPP_BENCH_BUILD}/cpp" "[]" "${five_cases}")
if(NODE)
    quote("${source}/workloads.js" q)
    runtime(node "${NODE}" "[${q}]" "${all_cases}")
endif()
if(JAVA AND JAVAC)
    run("${JAVAC}" -encoding UTF-8 -d "${VPP_BENCH_BUILD}/java" "${source}/Bench.java")
    quote("${VPP_BENCH_BUILD}/java" q)
    runtime(java "${JAVA}" "[\"-cp\",${q},\"Bench\"]" "${five_cases}")
endif()
if(PYTHON)
    file(READ "${source}/python-inline.txt" code)
    quote("${code}" q)
    runtime(python "${PYTHON}" "[\"-B\",\"-c\",${q}]" "${all_cases}")
endif()
if(RUBY)
    quote("${source}/workloads.rb" q)
    runtime(ruby "${RUBY}" "[${q}]" "${all_cases}")
endif()
set(manifest "{\"schema\":1,\"seed\":17,\"input_cycle\":16,\"warmup_batches\":3,\"samples\":10,\"target_ms\":100}")
string(JSON manifest SET "${manifest}" runtimes "${runtimes}")
quote("${VPP_ROOT}" q)
string(JSON manifest SET "${manifest}" root "${q}")
string(TIMESTAMP created "%Y-%m-%dT%H:%M:%SZ" UTC)
quote("${created}" q)
string(JSON manifest SET "${manifest}" created_utc "${q}")
execute_process(COMMAND git -C "${VPP_ROOT}" rev-parse HEAD OUTPUT_VARIABLE revision OUTPUT_STRIP_TRAILING_WHITESPACE)
quote("${revision}" q)
string(JSON manifest SET "${manifest}" revision "${q}")
execute_process(COMMAND git -C "${VPP_ROOT}" status --porcelain
    OUTPUT_VARIABLE changes OUTPUT_STRIP_TRAILING_WHITESPACE)
set(dirty false)
if(NOT changes STREQUAL "")
    set(dirty true)
endif()
string(JSON manifest SET "${manifest}" dirty "${dirty}")
set(versions "{}")
foreach(tool IN ITEMS CXX NODE JAVA PYTHON RUBY)
    if(${tool})
        set(option --version)
        if(tool STREQUAL "JAVA")
            set(option -version)
        endif()
        execute_process(COMMAND "${${tool}}" "${option}" OUTPUT_VARIABLE version ERROR_VARIABLE errors)
        quote("${version}${errors}" q)
        string(JSON versions SET "${versions}" "${tool}" "${q}")
    endif()
endforeach()
string(JSON manifest SET "${manifest}" versions "${versions}")
if(RUBY)
    execute_process(COMMAND "${RUBY}" -rjson -e "puts JSON::VERSION"
        OUTPUT_VARIABLE json_version OUTPUT_STRIP_TRAILING_WHITESPACE)
    quote("${json_version}" q)
    string(JSON manifest SET "${manifest}" ruby_json_version "${q}")
endif()
if(NODE)
    execute_process(COMMAND "${NODE}" -p "process.versions.v8"
        OUTPUT_VARIABLE v8_version OUTPUT_STRIP_TRAILING_WHITESPACE)
    quote("${v8_version}" q)
    string(JSON manifest SET "${manifest}" v8_version "${q}")
endif()
set(machine "{}")
foreach(key IN ITEMS machdep.cpu.brand_string hw.memsize hw.ncpu)
    execute_process(COMMAND /usr/sbin/sysctl -n "${key}" OUTPUT_VARIABLE value ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
    quote("${value}" q)
    string(JSON machine SET "${machine}" "${key}" "${q}")
endforeach()
execute_process(COMMAND uname -sm OUTPUT_VARIABLE value OUTPUT_STRIP_TRAILING_WHITESPACE)
quote("${value}" q)
string(JSON machine SET "${machine}" os_arch "${q}")
execute_process(COMMAND sw_vers OUTPUT_VARIABLE value ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
quote("${value}" q)
string(JSON machine SET "${machine}" os_version "${q}")
string(JSON manifest SET "${manifest}" machine "${machine}")
set(fingerprints "{}")
file(GLOB files "${source}/*")
foreach(path IN LISTS files)
    if(NOT IS_DIRECTORY "${path}")
        file(SHA256 "${path}" digest)
        get_filename_component(name "${path}" NAME)
        quote("${digest}" q)
        string(JSON fingerprints SET "${fingerprints}" "${name}" "${q}")
    endif()
endforeach()
string(JSON manifest SET "${manifest}" source_sha256 "${fingerprints}")
set(artifacts "{}")
file(GLOB artifact_files "${VPP_BENCH_BUILD}/*.o" "${VPP_BENCH_BUILD}/*.vmb"
    "${VPP_BENCH_BUILD}/java/*.class")
list(APPEND artifact_files "${native}")
foreach(path IN LISTS artifact_files)
    file(SHA256 "${path}" digest)
    file(RELATIVE_PATH name "${VPP_BENCH_BUILD}" "${path}")
    quote("${digest}" q)
    string(JSON artifacts SET "${artifacts}" "${name}" "${q}")
endforeach()
string(JSON manifest SET "${manifest}" artifact_sha256 "${artifacts}")
quote("Release -O3 -DNDEBUG; separate C++ units; no LTO; interpreter JIT disabled" q)
string(JSON manifest SET "${manifest}" build_policy "${q}")
file(WRITE "${VPP_BENCH_BUILD}/manifest.json" "${manifest}\n")
message(STATUS "Language benchmark manifest ready: ${VPP_BENCH_BUILD}/manifest.json")
