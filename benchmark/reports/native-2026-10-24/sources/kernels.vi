// Các hàm i32 độc lập, xuất thành đối tượng và gọi bằng ABI C thông thường.
// Miền đầu vào được harness giới hạn để không xảy ra tràn số có dấu.
hàm vpp_arithmetic(a, b, c, d) {
    trả về (a + b) - c * d;
};

hàm vpp_cycle(seed, n, unused_a, unused_b) {
    biến x = seed;
    lặp (i = 0; i < n; i = i + 1) {
        x = x + 251;
        nếu (x >= 65521) { x = x - 65521; };
    };
    trả về x;
};

hàm vpp_fibonacci(n, unused_a, unused_b, unused_c) {
    biến a = 0;
    biến b = 1;
    lặp (i = 0; i < n; i = i + 1) {
        biến next = a + b;
        a = b;
        b = next;
    };
    trả về a;
};
